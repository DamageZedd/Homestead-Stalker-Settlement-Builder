-- homestead_lock.script
-- Placed Hideout Furniture should not move. HF freezes every piece when it comes online, and in the
-- modded exes physics_shell:freeze() fixes every physics element, but a fixed piece is still a dynamic
-- body: once a bump wakes it, the pieces it touches or overlaps (walls on foundations, wall corners,
-- roofs on walls) push it away, and NPCs shove it. Scripts can't turn a piece into level geometry, so
-- this puts every frozen piece in the engine's door mode (set_door_ignore_dynamics, what vanilla doors
-- use): it then only collides with the player, grenades and the level, none of which can move a fixed
-- body, so it stays where it was placed. NPCs, dropped items and bodies pass through such pieces.
--
-- Foundations and floors have to hold NPCs, items and bodies up. Square ones go in door mode like every
-- other piece, on top of an invisible collider: a breakable_object is only a box with no physics body,
-- so nothing can wake or move it. A triangle is not a box: it gets one collider per stepped strip
-- (homestead_collider_1..N in its section, each "section, x, y, z" with the offset of the box centre in
-- the piece's frame). Walls, doorways and posts get theirs the same way: door mode lets NPCs and mutants
-- walk through a piece, so without a collider a mutant passes through every wall. Their boxes are listed
-- per piece section in [hs_colliders_<section>] blocks (items_homestead_building.ltx), the Hideout
-- Furniture walls included, and leave a doorway's opening free. The ones with no collider (the spiral
-- stair landing) stay solid: their collision is inset 5 mm so snapped neighbours don't overlap, and their
-- models ignore ragdolls ([collide] ignore_ragdoll), so bodies fall through them instead of waking them.
-- Stairs and ramps (tilted slabs, which an upright box can't follow) just stay in door mode.
-- See tools/model_pipeline/build_floor_collision.py.
--
-- Saving moves pieces too: the engine stores an online physics object's rotation with 8 bits per
-- quaternion component, so every save and load turns each piece by up to about a degree (a few cm at
-- the end of a wall). So the spot a piece is frozen at is kept at full precision (se_save_var, dropped
-- when the piece is released) and the piece is put back on it each time it comes online.
--
-- Door mode lives on the physics shell, so it is set again every time a piece comes online. A piece the
-- player unfreezes through HF's radial menu collides normally until it is frozen again, and its spot is
-- taken again where it is frozen. Pieces that are not physics objects (HF lamps and stash boxes) only
-- get their spot back. The lock is always on (it used to have an MCM toggle).

local VAR = "hs_spot"          -- x, y, z, heading, pitch, bank the piece was frozen at
local HINT = "hs_place"        -- x, y, z a building piece was placed at (homestead_snap): its first spot
local OLD_VAR = "hs_lock"      -- spot saved by an earlier version of this script, no longer used
local COLLIDER = "hs_collider"        -- on a piece: id of its collider (a list of ids for a piece with several)
local COLLIDER_OF = "hs_collider_of"  -- on a collider: id of its piece
local COLLIDER_PREFIX = "hs_collider_"   -- sections of the invisible colliders
local MAX_PARTS = 16                   -- homestead_collider_<n> lines read per section
local COLLIDER_HEALTH = 1000000000     -- a breakable starts at 1, and any blast near it takes health off (collisions: see the ltx)
local SOLID = { foundation = true, floor = true, foundation_tri = true, floor_tri = true }   -- homestead_snap types that stay solid

local PLACE_REACH = 3.0        -- metres a piece may have been lifted from where it was placed (further: the hint is ignored)
local MOVE_TOL = 0.001         -- metres a piece may be off its spot
local TURN_TOL = 0.0005        -- radians a piece may be turned off its spot
local GIMBAL = math.pi / 2 - 0.001  -- beyond this pitch obj:angle() is too coarse to rebuild the rotation

local SWEEP_MS = 2000          -- how often pieces that HF's freeze hook missed are looked for
local SWEEP_RADIUS = 80        -- metres around the player
local HEAL_MS = 500            -- how often a slice of frozen pieces is checked against their spot
local HEAL_BUDGET = 10         -- pieces per slice: 20 a second, the rate of the old 40 per 2 s sweep
local SOLID_MS = 100           -- how often solid pieces (foundations, floors) are checked against their spot
local FIGHT_MS = 2000          -- a solid piece put back FIGHT_LIMIT times in this long is fighting a neighbour
local FIGHT_LIMIT = 5
local BURST_MS = 20000         -- after a death the heal runs fast for this long (see on_death)
local BURST_HEAL_MS = 100      -- slice interval in a burst
local BURST_BUDGET = 40        -- pieces per slice in a burst: 400 a second

local next_sweep = 0
local next_heal = 0
local burst_until = 0
local online = {}              -- id of an online frozen piece -> true
local solid_online = {}        -- the same for pieces that stay solid (foundations and floors)
local next_solid = 0
local next_fight_reset = 0
local fight_count = {}         -- id -> put-backs of a solid piece since next_fight_reset was set
local put_back_count = 0

-- Per-section answers read from the configs once (they can't change while the game runs); one
-- entry per section seen, so they stay small.
local solid_sec = {}           -- section -> stays solid (homestead_snap foundation / floor)
local hf_sec = {}              -- section -> bound by a Hideout Furniture binder
local collider_sec = {}        -- section -> list of { sec, x, y, z } (its colliders), or false

local function report(err)
    printf("homestead_lock: %s", tostring(err))
end

-- The invisible colliders can be switched off in MCM (qol_debug/building_colliders, on by default).
-- Switching them off removes every collider (online ones at once, the rest as they come online) and puts
-- the pieces back as they were before them.
local MCM_COLLIDERS = "stalker_camp_builder/qol_debug/building_colliders"
local MAX_BREAKS = 3           -- colliders of one piece that may break before it gets no more
local colliders_on = nil       -- nil until first read
local collider_breaks = {}     -- piece id -> colliders of it found broken

local function read_colliders_setting()
    if not (ui_mcm and ui_mcm.get) then return true end
    local v = ui_mcm.get(MCM_COLLIDERS)
    return v == nil or v == true or v == 1
end

local function is_solid(sec)
    local v = solid_sec[sec]
    if v == nil then
        v = SOLID[ini_sys:r_string_ex(sec, "homestead_snap") or ""] or false
        solid_sec[sec] = v
    end
    return v
end

local function is_hf_bound(sec)
    local v = hf_sec[sec]
    if v == nil then
        local bind = ini_sys:r_string_ex(sec, "script_binding") or ""
        v = string.find(bind, "bind_hf", 1, true) ~= nil
        hf_sec[sec] = v
    end
    return v
end

local function is_collider_sec(sec)
    return type(sec) == "string" and string.sub(sec, 1, #COLLIDER_PREFIX) == COLLIDER_PREFIX
end

local function collider_parts(sec)
    local v = collider_sec[sec]
    if v == nil then
        v = {}
        local name = ini_sys:r_string_ex(sec, "homestead_collider")
        if name then
            v[1] = { sec = name, x = 0, y = ini_sys:r_float_ex(sec, "homestead_collider_y") or 0, z = 0 }
        else
            local from = ini_sys:r_string_ex(sec, "homestead_collider_1") and sec or "hs_colliders_" .. sec
            for i = 1, MAX_PARTS do
                local line = ini_sys:r_string_ex(from, "homestead_collider_" .. i)
                if not line then break end
                local name_i, x, y, z = string.match(line,
                    "^%s*([%w_]+)%s*,%s*([%-%d%.]+)%s*,%s*([%-%d%.]+)%s*,%s*([%-%d%.]+)")
                x, y, z = tonumber(x), tonumber(y), tonumber(z)
                if not (name_i and x and y and z) then break end
                v[#v + 1] = { sec = name_i, x = x, y = y, z = z }
            end
        end
        if #v == 0 then v = false end
        collider_sec[sec] = v
    end
    return v
end

-- The colliders a piece's section calls for, or false (none, or the option is off).
local function collider_of(sec)
    if colliders_on == nil then colliders_on = read_colliders_setting() end
    if not colliders_on then return false end
    return collider_parts(sec)
end

-- The collider ids saved on a piece: one number (the squares, and every earlier save) or a list.
local function collider_ids(id)
    local v = se_load_var(id, nil, COLLIDER)
    if type(v) == "table" then return v end
    if v then return { v } end
    return {}
end

local function save_collider_ids(id, ids)
    se_save_var(id, nil, COLLIDER, #ids > 1 and ids or ids[1])
end

local function release_collider_se(cid)
    local se = alife_object(cid)
    if se and is_collider_sec(se:section_name()) then
        alife_release(se)
    end
end

-- Forward: the rows of the rotation are needed for where a collider goes.
local hpb_axes

local function release_collider(id)
    local ids = collider_ids(id)
    if #ids == 0 then return end
    se_save_var(id, nil, COLLIDER, nil)
    for _, cid in ipairs(ids) do release_collider_se(cid) end
end

-- Health is the last float of a breakable's state (CSE_ALifeObjectBreakable::STATE_Write) and no script
-- field reaches it, so the state is copied into a new packet with that float changed and read back.
-- Health stops blasts and bullets only; a collision breaks it through collision_break_threthhold (see the ltx).
local function harden_collider(se)
    local p = net_packet()
    p:w_begin(0)
    se:STATE_Write(p)
    local size = p:w_tell()
    p:r_seek(0)
    local bytes = {}
    for i = 1, size do bytes[i] = p:r_u8() end
    local q = net_packet()
    q:w_begin(0)
    for i = 3, size - 4 do q:w_u8(bytes[i]) end
    q:w_float(COLLIDER_HEALTH)
    local qsize = q:w_tell()
    assert(qsize == size, "collider state changed size")
    q:r_seek(2)
    se:STATE_Read(q, qsize)
end

-- Whether a piece has working colliders, making the missing ones. A new one only comes online on a later
-- update, and the piece must not go in door mode before that or what stands on it falls: this answers
-- false until all of them are online. A broken one is replaced. A model's box is centred on its object,
-- hence the offset of each collider in the piece's frame (x, y up, z), turned by the piece's rotation.
-- Spawn angles are x = pitch, y = heading, z = bank (CGameObject::net_Spawn: setXYZ, which is setHPB(y, x, z)).
local function ensure_collider(obj, id, rec)
    if (collider_breaks[id] or 0) >= MAX_BREAKS then return false end
    local ids = collider_ids(id)
    local ready = true
    local changed = false
    local spot
    for i, part in ipairs(rec) do
        local cid = ids[i]
        local se = cid and alife_object(cid)
        local keep = false
        if se and se:section_name() == part.sec then
            local placed = level.object_by_id(cid)
            if not placed then
                keep, ready = true, false
            elseif not placed:get_physics_shell() then
                keep = true
            else
                collider_breaks[id] = (collider_breaks[id] or 0) + 1
                report("collider " .. cid .. " of piece " .. id .. " broke (" .. collider_breaks[id] .. ")")
                alife_release(se)
            end
        elseif se and is_collider_sec(se:section_name()) then
            alife_release(se)
        end
        if not keep then
            spot = spot or se_load_var(id, nil, VAR)
            if not spot then
                ready = false
                break
            end
            local ix, iy, iz, jx, jy, jz, kx, ky, kz = hpb_axes(spot[4], spot[5], spot[6])
            local pos = vector():set(spot[1] + ix * part.x + jx * part.y + kx * part.z,
                spot[2] + iy * part.x + jy * part.y + ky * part.z,
                spot[3] + iz * part.x + jz * part.y + kz * part.z)
            local new_se = alife_create(part.sec, pos, obj:level_vertex_id(), obj:game_vertex_id())
            ready = false
            if new_se then
                new_se.angle = vector():set(spot[5], spot[4], spot[6])
                local hardened, err = pcall(harden_collider, new_se)
                if not hardened then report(err) end
                ids[i] = new_se.id
                changed = true
                se_save_var(new_se.id, nil, COLLIDER_OF, id)
            end
        end
    end
    for i = #rec + 1, #ids do          -- left over from a layout with more parts
        release_collider_se(ids[i])
        ids[i] = nil
        changed = true
    end
    if changed then save_collider_ids(id, ids) end
    return ready
end

-- Returns true when the piece is now in door mode.
local function set_static(obj, static)
    local sec = obj:section()
    local rec = collider_of(sec)
    if not rec and collider_parts(sec) then
        -- colliders are off: drop the piece's own, and a slab leaves door mode (it was solid before them)
        release_collider(obj:id())
        if is_solid(sec) then
            local po0 = obj:get_physics_object()
            if po0 then po0:unset_door_ignore_dynamics() end
            return false
        end
    end
    if rec or is_solid(sec) then
        if not rec then return false end
        if static then
            if not ensure_collider(obj, obj:id(), rec) then return false end
        else
            release_collider(obj:id())
        end
    end
    local po = obj:get_physics_object()
    if not (po and obj:get_physics_shell()) then return false end
    if static then
        po:set_door_ignore_dynamics()
        return true
    end
    po:unset_door_ignore_dynamics()
    return false
end

local function save_spot(id, obj)
    local p, a = obj:position(), obj:angle()
    se_save_var(id, nil, VAR, { p.x, p.y, p.z, a.x, a.y, a.z })
end

local function clear_spot(id)
    if se_load_var(id, nil, VAR) then
        se_save_var(id, nil, VAR, nil)
    end
    if se_load_var(id, nil, HINT) then
        se_save_var(id, nil, HINT, nil)
    end
end

-- A released piece's id goes to a later object, which would inherit its spot: placeables are physic
-- objects, which have no Lua server class, so axr_main never clears their se vars.
local function forget_piece(se_obj)
    local id = se_obj and se_obj.id
    if not id then return end
    online[id] = nil
    solid_online[id] = nil
    clear_spot(id)
    if se_load_var(id, nil, COLLIDER_OF) then
        se_save_var(id, nil, COLLIDER_OF, nil)
    end
    -- released a moment later: this runs while the engine is unregistering the piece
    local ids = collider_ids(id)
    if #ids > 0 then
        se_save_var(id, nil, COLLIDER, nil)
        CreateTimeEvent("homestead_lock_collider", tostring(ids[1]), 0, function()
            for _, cid in ipairs(ids) do release_collider_se(cid) end
            return true
        end)
    end
end

-- Rows i, j, k of the engine's Fmatrix:setHPB. Spots are compared as rotations, because the same
-- rotation can have a different heading/pitch/bank (heading +-pi, a piece tipped onto its side).
function hpb_axes(h, p, b)
    local sh, ch, sp, cp, sb, cb = math.sin(h), math.cos(h), math.sin(p), math.cos(p), math.sin(b), math.cos(b)
    local cc, cs, sc, ss = ch * cb, ch * sb, sh * cb, sh * sb
    return cc - sp * ss, -cp * sb, sp * cs + sc,
        sp * sc + cs, cp * cb, ss - sp * cc,
        -cp * sh, sp, cp * ch
end

-- Angle of the rotation from one heading/pitch/bank to the other: trace(A^T B) = 1 + 2 cos(angle).
local function turn_between(h1, p1, b1, h2, p2, b2)
    local u1, u2, u3, u4, u5, u6, u7, u8, u9 = hpb_axes(h1, p1, b1)
    local v1, v2, v3, v4, v5, v6, v7, v8, v9 = hpb_axes(h2, p2, b2)
    local trace = u1 * v1 + u2 * v2 + u3 * v3 + u4 * v4 + u5 * v5 + u6 * v6 + u7 * v7 + u8 * v8 + u9 * v9
    return math.acos(math.max(-1, math.min(1, (trace - 1) / 2)))
end

-- A spot at pitch +-90 (a piece hung on a wall) only keeps its position: there obj:angle() changes a
-- lot for a tiny change of the rotation, so its rotation can't be rebuilt from it.
local function keeps_rotation(spot)
    return math.abs(spot[5]) < GIMBAL
end

-- Whether a piece at heading/pitch/bank h, p, b is turned more than TURN_TOL off its spot. The turn
-- between two heading/pitch/bank triples is at most |dh| + |dp| + |db| (each is a turn about one
-- axis), so a piece whose angles are all within half the tolerance can't be turned past it and the
-- trigonometry is skipped; every other piece gets the exact check. Same answer, cheaper for the
-- pieces that sit still (nearly all of them).
local NEAR_TURN = TURN_TOL * 0.5
local function turned_off(h, p, b, spot)
    local sh, sp, sb = spot[4], spot[5], spot[6]
    local dh, dp, db = h - sh, p - sp, b - sb
    if dh < 0 then dh = -dh end
    if dp < 0 then dp = -dp end
    if db < 0 then db = -db end
    if dh + dp + db <= NEAR_TURN then return false end
    return turn_between(h, p, b, sh, sp, sb) > TURN_TOL
end
spot_turned = turned_off       -- for tools/tests/test_furniture_perf.lua

local function report_put_back()
    printf("homestead_lock: put %s piece(s) back on their spots", put_back_count)
    put_back_count = 0
    return true
end

-- force_set_* move the physics shell without waking it.
local function put_back(obj, spot)
    local p = obj:position()
    local dx, dy, dz = p.x - spot[1], p.y - spot[2], p.z - spot[3]
    local moved = dx * dx + dy * dy + dz * dz > MOVE_TOL * MOVE_TOL
    local turned = false
    if keeps_rotation(spot) then
        local a = obj:angle()
        turned = turned_off(a.x, a.y, a.z, spot)
    end
    if not (moved or turned) then return end
    if turned then
        obj:force_set_angle(vector():set(spot[4], spot[5], spot[6]), false)
    end
    obj:force_set_position(vector():set(spot[1], spot[2], spot[3]), false)
    -- A fixed body has no gravity and keeps any speed it was given, so it would drift off again.
    -- set_linear_vel ignores fixed bodies; freeze() runs FixBody, which zeroes speed, spin and forces.
    local shell = obj:get_physics_shell()
    if shell then shell:freeze() end
    put_back_count = put_back_count + 1
    CreateTimeEvent("homestead_lock", "put_back", 1, report_put_back)
    return true
end

-- The radial menu's Freeze / Unfreeze: an unfrozen piece falls and collides like any other object, and
-- is kept wherever it is frozen again. Wrapped on each piece's own wrapper: a binder class that
-- subclasses hf_binder_wrapper (stations, flags, the stall, gadgets) got its own copy of set_frozen
-- when it was declared, before on_game_start could replace hf_binder_wrapper's.
local function hook_set_frozen(id)
    local wrapper = bind_hf_base.get_wrapper(id)
    local set_frozen = wrapper and wrapper.set_frozen
    if not set_frozen or wrapper.hs_lock_hooked then return end
    wrapper.hs_lock_hooked = true
    wrapper.set_frozen = function(self, frozen)
        set_frozen(self, frozen)
        local obj = self.object
        if obj then
            local ok, err = pcall(function()
                if self.is_frozen then save_spot(obj:id(), obj) else clear_spot(obj:id()) end
                set_static(obj, self.is_frozen)
            end)
            if not ok then report(err) end
        end
    end
end

-- Runs after HF has frozen a piece that just came online.
local function on_piece_frozen(id)
    local obj = level.object_by_id(id)
    if not obj then return end
    online[id] = true
    local sec = obj:section()
    solid_online[id] = (is_solid(sec) or collider_of(sec)) and true or nil
    hook_set_frozen(id)
    if se_load_var(id, nil, OLD_VAR) then
        se_save_var(id, nil, OLD_VAR, nil)
    end
    local spot = se_load_var(id, nil, VAR)
    if spot then
        put_back(obj, spot)
    else
        -- First freeze: a slab placed with its skirt below the terrain spawns inside the level geometry and
        -- the engine lifts it out before this runs, so its spot is where it was placed, not where it is.
        local hint = se_load_var(id, nil, HINT)
        if hint then
            se_save_var(id, nil, HINT, nil)
            local p = obj:position()
            local dx, dy, dz = p.x - hint[1], p.y - hint[2], p.z - hint[3]
            if dx * dx + dy * dy + dz * dz < PLACE_REACH * PLACE_REACH then
                obj:force_set_position(vector():set(hint[1], hint[2], hint[3]), false)
            end
        end
        save_spot(id, obj)
    end
    if set_static(obj, true) then solid_online[id] = nil end
end

-- A piece HF's freeze hook never reported (freeze_obj returned false while the shell was not ready,
-- a rival camp piece, a piece frozen before this script loaded) would stay a plain dynamic body that
-- NPCs shove into floors. Look for such pieces around the player: any HF-bound piece whose wrapper says
-- it is frozen is fixed and put in door mode like the rest. A piece the player unfroze through HF's
-- radial menu is left alone.
local function sweep_piece(o)
    local id = o:id()
    if online[id] then return end
    local sec = o:section()
    if is_collider_sec(sec) then
        -- left behind by a piece that is gone (nothing can reach it any other way)
        local owner = se_load_var(id, nil, COLLIDER_OF)
        local owned = false
        if owner and alife_object(owner) then
            for _, cid in ipairs(collider_ids(owner)) do
                if cid == id then owned = true end
            end
        end
        if not owned or not colliders_on then
            local se = alife_object(id)
            if se then alife_release(se) end
        end
        return
    end
    if not is_hf_bound(sec) then return end
    local wrapper = bind_hf_base.get_wrapper(id)
    if not wrapper or wrapper.is_frozen == false then return end
    local ps = o:get_physics_shell()
    if not ps then return end
    ps:freeze()
    on_piece_frozen(id)
end

-- A piece is put back on its spot once, when it comes online. Pieces that spawn in the same load are free
-- bodies until their own freeze runs, so a neighbour that was not frozen yet (a wall or doorway whose
-- door mode is not set, a slab it overlaps after the save's rotation rounding) can shove a piece that was
-- already frozen and put back. Fixed bodies hang on a soft joint, so the shove stays: a foundation or
-- floor slab ends up floating above its spot. Every frozen piece is therefore checked against its spot
-- again, a few at a time (HEAL_BUDGET every HEAL_MS), and put back if it has drifted. A piece the
-- player unfroze is left alone.
local heal_queue = {}

local function heal_pieces()
    if #heal_queue == 0 then
        for id in pairs(online) do heal_queue[#heal_queue + 1] = id end
    end
    local budget = time_global() < burst_until and BURST_BUDGET or HEAL_BUDGET
    for _ = 1, budget do
        local id = table.remove(heal_queue)
        if not id then return end
        if online[id] then
            local obj = level.object_by_id(id)
            if not obj then
                online[id] = nil   -- went offline
                solid_online[id] = nil
            else
                local wrapper = bind_hf_base.get_wrapper(id)
                local spot = not (wrapper and wrapper.is_frozen == false) and se_load_var(id, nil, VAR)
                if spot then
                    put_back(obj, spot)
                    if collider_of(obj:section()) then set_static(obj, true) end  -- a broken collider, a failed spawn
                end
            end
        end
    end
end

-- Foundations and floors that are not in door mode (no collider, or waiting for theirs to come online)
-- can still be shoved by items and neighbours. There are few of them, so each is checked against its spot every
-- SOLID_MS and put back at once, long before a shove is visible. A put-back also restarts the body's
-- sleep countdown, so a piece that overlaps a neighbour would be pushed and put back for ever: one that
-- keeps coming back leaves this pass until it next comes online, and the slower heal looks after it.
local function heal_solid()
    local now = time_global()
    if now >= next_fight_reset then
        next_fight_reset = now + FIGHT_MS
        fight_count = {}
    end
    for id in pairs(solid_online) do
        local obj = level.object_by_id(id)
        if not obj then
            online[id] = nil
            solid_online[id] = nil
        else
            local wrapper = bind_hf_base.get_wrapper(id)
            local spot = not (wrapper and wrapper.is_frozen == false) and se_load_var(id, nil, VAR)
            if spot and put_back(obj, spot) then
                local n = (fight_count[id] or 0) + 1
                fight_count[id] = n
                if n >= FIGHT_LIMIT then
                    solid_online[id] = nil
                    report("piece " .. id .. " keeps being pushed off its spot, it overlaps a neighbour")
                end
            end
            if spot and collider_of(obj:section()) and set_static(obj, true) then
                solid_online[id] = nil
            end
        end
    end
end

-- one object of the sweep (one function for every sweep, no closure each time)
local function sweep_visit(o)
    local ok, err = pcall(sweep_piece, o)
    if not ok then report(err) end
end

-- The option changed: every online piece is set up again (colliders made or removed).
local function apply_collider_setting()
    printf("homestead_lock: building colliders %s", colliders_on and "ON" or "OFF")
    for id in pairs(online) do
        local obj = level.object_by_id(id)
        if not obj then
            online[id] = nil
            solid_online[id] = nil
        else
            local wrapper = bind_hf_base.get_wrapper(id)
            if not (wrapper and wrapper.is_frozen == false) then
                if colliders_on and collider_of(obj:section()) then solid_online[id] = true end
                local ok, err = pcall(set_static, obj, true)
                if not ok then report(err) end
            end
        end
    end
end

-- Runs every frame, so it only compares times until a sweep or a heal slice is due. A frame never
-- does both: a heal slice due on a sweep frame waits for the next frame.
local function sweep_update()
    local now = time_global()
    if not db.actor then return end
    if now >= next_sweep then
        next_sweep = now + SWEEP_MS
        local want = read_colliders_setting()
        if colliders_on ~= want then
            local first = colliders_on == nil
            colliders_on = want
            if not first then
                local ok, err = pcall(apply_collider_setting)
                if not ok then report(err) end
            end
        end
        level.iterate_nearest(db.actor:position(), SWEEP_RADIUS, sweep_visit)
        return
    end
    if now >= next_solid then
        next_solid = now + SOLID_MS
        local ok, err = pcall(heal_solid)
        if not ok then report(err) end
    end
    if now >= next_heal then
        next_heal = now + (now < burst_until and BURST_HEAL_MS or HEAL_MS)
        local ok, err = pcall(heal_pieces)
        if not ok then report(err) end
    end
end

-- A kill (a body dropping onto a slab, loot spawning, a blast) can knock fixed pieces off their spots,
-- and they then swing on their soft joint. Not confirmed as the cause of reported drifting bases, so
-- this only makes the existing put-back quicker for a while after any death: same check, same spots.
local function on_death()
    burst_until = time_global() + BURST_MS
    if next_heal > burst_until - BURST_MS + BURST_HEAL_MS then
        next_heal = burst_until - BURST_MS + BURST_HEAL_MS
    end
end

-- HF's net_spawn looks freeze_obj up when it runs, so replacing it here covers every piece.
local function hook_freeze(module)
    local freeze_obj = module.freeze_obj
    if not freeze_obj then return end
    module.freeze_obj = function(id)
        local done = freeze_obj(id)
        if done then
            local ok, err = pcall(on_piece_frozen, id)
            if not ok then report(err) end
        end
        return done
    end
end

-- homestead_snap calls this with the position it placed a building piece at
function note_placed(id, pos)
    if id and pos then
        se_save_var(id, nil, HINT, { pos.x, pos.y, pos.z })
    end
end

function on_game_start()
    local fs = getFS()
    if not fs:exist("$game_scripts$", "bind_hf_base.script") then return end
    hook_freeze(bind_hf_base)
    if fs:exist("$game_scripts$", "bind_hf_static.script") then
        hook_freeze(bind_hf_static)
    end
    RegisterScriptCallback("actor_on_update", sweep_update)
    RegisterScriptCallback("server_object_on_unregister", forget_piece)
    RegisterScriptCallback("npc_on_death_callback", on_death)
    RegisterScriptCallback("monster_on_death_callback", on_death)
end
