-- homestead_lock.script
-- Placed Hideout Furniture should not move. HF freezes every piece when it comes online, and in the
-- modded exes physics_shell:freeze() fixes every physics element, but a fixed piece is still a dynamic
-- body: once a bump wakes it, the pieces it touches or overlaps (walls on foundations, wall corners,
-- roofs on walls) push it away, and NPCs shove it. Scripts can't turn a piece into level geometry, so
-- this puts every frozen piece in the engine's door mode (set_door_ignore_dynamics, what vanilla doors
-- use): it then only collides with the player, grenades and the level, none of which can move a fixed
-- body, so it stays where it was placed. NPCs, dropped items and bodies pass through such pieces.
--
-- Pieces people and things stand on (Homestead foundations and floors) stay solid, so NPCs, items
-- and bodies don't fall through them: door mode on the walls, roofs and furniture around them already
-- stops those from pushing them, and their collision is inset 5 mm so snapped neighbours don't overlap.
--
-- Saving moves pieces too: the engine stores an online physics object's rotation with 8 bits per
-- quaternion component, so every save and load turns each piece by up to about a degree (a few cm at
-- the end of a wall). So the spot a piece is frozen at is kept at full precision (se_save_var, dropped
-- when the piece is released) and the piece is put back on it each time it comes online.
--
-- Door mode lives on the physics shell, so it is set again every time a piece comes online. A piece the
-- player unfreezes through HF's radial menu collides normally until it is frozen again, and its spot is
-- taken again where it is frozen. Pieces that are not physics objects (HF lamps and stash boxes) only
-- get their spot back. The lock is always on (it used to have an MCM toggle).

local VAR = "hs_spot"          -- x, y, z, heading, pitch, bank the piece was frozen at
local OLD_VAR = "hs_lock"      -- spot saved by an earlier version of this script, no longer used
local SOLID = { foundation = true, floor = true, foundation_tri = true, floor_tri = true }   -- homestead_snap types that stay solid

local MOVE_TOL = 0.001         -- metres a piece may be off its spot
local TURN_TOL = 0.0005        -- radians a piece may be turned off its spot
local GIMBAL = math.pi / 2 - 0.001  -- beyond this pitch obj:angle() is too coarse to rebuild the rotation

local SWEEP_MS = 2000          -- how often pieces that HF's freeze hook missed are looked for
local SWEEP_RADIUS = 80        -- metres around the player
local HEAL_MS = 500            -- how often a slice of frozen pieces is checked against their spot
local HEAL_BUDGET = 10         -- pieces per slice: 20 a second, the rate of the old 40 per 2 s sweep

local next_sweep = 0
local next_heal = 0
local online = {}              -- id of an online frozen piece -> true
local put_back_count = 0

-- Per-section answers read from the configs once (they can't change while the game runs); one
-- entry per section seen, so they stay small.
local solid_sec = {}           -- section -> stays solid (homestead_snap foundation / floor)
local hf_sec = {}              -- section -> bound by a Hideout Furniture binder

local function report(err)
    printf("homestead_lock: %s", tostring(err))
end

local function is_solid(sec)
    local v = solid_sec[sec]
    if v == nil then
        v = SOLID[ini_sys:r_string_ex(sec, "homestead_snap") or ""] or false
        solid_sec[sec] = v
    end
    return v
end

local function is_hf_bound(sec)
    local v = hf_sec[sec]
    if v == nil then
        local bind = ini_sys:r_string_ex(sec, "script_binding") or ""
        v = string.find(bind, "bind_hf", 1, true) ~= nil
        hf_sec[sec] = v
    end
    return v
end

local function set_static(obj, static)
    if is_solid(obj:section()) then return end
    local po = obj:get_physics_object()
    if not (po and obj:get_physics_shell()) then return end
    if static then
        po:set_door_ignore_dynamics()
    else
        po:unset_door_ignore_dynamics()
    end
end

local function save_spot(id, obj)
    local p, a = obj:position(), obj:angle()
    se_save_var(id, nil, VAR, { p.x, p.y, p.z, a.x, a.y, a.z })
end

local function clear_spot(id)
    if se_load_var(id, nil, VAR) then
        se_save_var(id, nil, VAR, nil)
    end
end

-- A released piece's id goes to a later object, which would inherit its spot: placeables are physic
-- objects, which have no Lua server class, so axr_main never clears their se vars.
local function forget_piece(se_obj)
    local id = se_obj and se_obj.id
    if not id then return end
    online[id] = nil
    clear_spot(id)
end

-- Rows i, j, k of the engine's Fmatrix:setHPB. Spots are compared as rotations, because the same
-- rotation can have a different heading/pitch/bank (heading +-pi, a piece tipped onto its side).
local function hpb_axes(h, p, b)
    local sh, ch, sp, cp, sb, cb = math.sin(h), math.cos(h), math.sin(p), math.cos(p), math.sin(b), math.cos(b)
    local cc, cs, sc, ss = ch * cb, ch * sb, sh * cb, sh * sb
    return cc - sp * ss, -cp * sb, sp * cs + sc,
        sp * sc + cs, cp * cb, ss - sp * cc,
        -cp * sh, sp, cp * ch
end

-- Angle of the rotation from one heading/pitch/bank to the other: trace(A^T B) = 1 + 2 cos(angle).
local function turn_between(h1, p1, b1, h2, p2, b2)
    local u1, u2, u3, u4, u5, u6, u7, u8, u9 = hpb_axes(h1, p1, b1)
    local v1, v2, v3, v4, v5, v6, v7, v8, v9 = hpb_axes(h2, p2, b2)
    local trace = u1 * v1 + u2 * v2 + u3 * v3 + u4 * v4 + u5 * v5 + u6 * v6 + u7 * v7 + u8 * v8 + u9 * v9
    return math.acos(math.max(-1, math.min(1, (trace - 1) / 2)))
end

-- A spot at pitch +-90 (a piece hung on a wall) only keeps its position: there obj:angle() changes a
-- lot for a tiny change of the rotation, so its rotation can't be rebuilt from it.
local function keeps_rotation(spot)
    return math.abs(spot[5]) < GIMBAL
end

-- Whether a piece at heading/pitch/bank h, p, b is turned more than TURN_TOL off its spot. The turn
-- between two heading/pitch/bank triples is at most |dh| + |dp| + |db| (each is a turn about one
-- axis), so a piece whose angles are all within half the tolerance can't be turned past it and the
-- trigonometry is skipped; every other piece gets the exact check. Same answer, cheaper for the
-- pieces that sit still (nearly all of them).
local NEAR_TURN = TURN_TOL * 0.5
local function turned_off(h, p, b, spot)
    local sh, sp, sb = spot[4], spot[5], spot[6]
    local dh, dp, db = h - sh, p - sp, b - sb
    if dh < 0 then dh = -dh end
    if dp < 0 then dp = -dp end
    if db < 0 then db = -db end
    if dh + dp + db <= NEAR_TURN then return false end
    return turn_between(h, p, b, sh, sp, sb) > TURN_TOL
end
spot_turned = turned_off       -- for tools/tests/test_furniture_perf.lua

local function report_put_back()
    printf("homestead_lock: put %s piece(s) back on their spots", put_back_count)
    put_back_count = 0
    return true
end

-- force_set_* move the physics shell without waking it.
local function put_back(obj, spot)
    local p = obj:position()
    local dx, dy, dz = p.x - spot[1], p.y - spot[2], p.z - spot[3]
    local moved = dx * dx + dy * dy + dz * dz > MOVE_TOL * MOVE_TOL
    local turned = false
    if keeps_rotation(spot) then
        local a = obj:angle()
        turned = turned_off(a.x, a.y, a.z, spot)
    end
    if not (moved or turned) then return end
    if turned then
        obj:force_set_angle(vector():set(spot[4], spot[5], spot[6]), false)
    end
    obj:force_set_position(vector():set(spot[1], spot[2], spot[3]), false)
    put_back_count = put_back_count + 1
    CreateTimeEvent("homestead_lock", "put_back", 1, report_put_back)
end

-- The radial menu's Freeze / Unfreeze: an unfrozen piece falls and collides like any other object, and
-- is kept wherever it is frozen again. Wrapped on each piece's own wrapper: a binder class that
-- subclasses hf_binder_wrapper (stations, flags, the stall, gadgets) got its own copy of set_frozen
-- when it was declared, before on_game_start could replace hf_binder_wrapper's.
local function hook_set_frozen(id)
    local wrapper = bind_hf_base.get_wrapper(id)
    local set_frozen = wrapper and wrapper.set_frozen
    if not set_frozen or wrapper.hs_lock_hooked then return end
    wrapper.hs_lock_hooked = true
    wrapper.set_frozen = function(self, frozen)
        set_frozen(self, frozen)
        local obj = self.object
        if obj then
            local ok, err = pcall(function()
                if self.is_frozen then save_spot(obj:id(), obj) else clear_spot(obj:id()) end
                set_static(obj, self.is_frozen)
            end)
            if not ok then report(err) end
        end
    end
end

-- Runs after HF has frozen a piece that just came online.
local function on_piece_frozen(id)
    local obj = level.object_by_id(id)
    if not obj then return end
    online[id] = true
    hook_set_frozen(id)
    if se_load_var(id, nil, OLD_VAR) then
        se_save_var(id, nil, OLD_VAR, nil)
    end
    local spot = se_load_var(id, nil, VAR)
    if spot then
        put_back(obj, spot)
    else
        save_spot(id, obj)
    end
    set_static(obj, true)
end

-- A piece HF's freeze hook never reported (freeze_obj returned false while the shell was not ready,
-- a rival camp piece, a piece frozen before this script loaded) would stay a plain dynamic body that
-- NPCs shove into floors. Look for such pieces around the player: any HF-bound piece whose wrapper says
-- it is frozen is fixed and put in door mode like the rest. A piece the player unfroze through HF's
-- radial menu is left alone.
local function sweep_piece(o)
    local id = o:id()
    if online[id] then return end
    if not is_hf_bound(o:section()) then return end
    local wrapper = bind_hf_base.get_wrapper(id)
    if not wrapper or wrapper.is_frozen == false then return end
    local ps = o:get_physics_shell()
    if not ps then return end
    ps:freeze()
    on_piece_frozen(id)
end

-- A piece is put back on its spot once, when it comes online. Pieces that spawn in the same load are free
-- bodies until their own freeze runs, so a neighbour that was not frozen yet (a wall or doorway whose
-- door mode is not set, a slab it overlaps after the save's rotation rounding) can shove a piece that was
-- already frozen and put back. Fixed bodies hang on a soft joint, so the shove stays: a foundation or
-- floor slab ends up floating above its spot. Every frozen piece is therefore checked against its spot
-- again, a few at a time (HEAL_BUDGET every HEAL_MS), and put back if it has drifted. A piece the
-- player unfroze is left alone.
local heal_queue = {}

local function heal_pieces()
    if #heal_queue == 0 then
        for id in pairs(online) do heal_queue[#heal_queue + 1] = id end
    end
    for _ = 1, HEAL_BUDGET do
        local id = table.remove(heal_queue)
        if not id then return end
        if online[id] then
            local obj = level.object_by_id(id)
            if not obj then
                online[id] = nil   -- went offline: the freeze hook adds it again when it comes back
            else
                local wrapper = bind_hf_base.get_wrapper(id)
                local spot = not (wrapper and wrapper.is_frozen == false) and se_load_var(id, nil, VAR)
                if spot then put_back(obj, spot) end
            end
        end
    end
end

-- one object of the sweep (one function for every sweep, no closure each time)
local function sweep_visit(o)
    local ok, err = pcall(sweep_piece, o)
    if not ok then report(err) end
end

-- Runs every frame, so it only compares times until a sweep or a heal slice is due. A frame never
-- does both: a heal slice due on a sweep frame waits for the next frame.
local function sweep_update()
    local now = time_global()
    if not db.actor then return end
    if now >= next_sweep then
        next_sweep = now + SWEEP_MS
        level.iterate_nearest(db.actor:position(), SWEEP_RADIUS, sweep_visit)
        return
    end
    if now >= next_heal then
        next_heal = now + HEAL_MS
        local ok, err = pcall(heal_pieces)
        if not ok then report(err) end
    end
end

-- HF's net_spawn looks freeze_obj up when it runs, so replacing it here covers every piece.
local function hook_freeze(module)
    local freeze_obj = module.freeze_obj
    if not freeze_obj then return end
    module.freeze_obj = function(id)
        local done = freeze_obj(id)
        if done then
            local ok, err = pcall(on_piece_frozen, id)
            if not ok then report(err) end
        end
        return done
    end
end

function on_game_start()
    local fs = getFS()
    if not fs:exist("$game_scripts$", "bind_hf_base.script") then return end
    hook_freeze(bind_hf_base)
    if fs:exist("$game_scripts$", "bind_hf_static.script") then
        hook_freeze(bind_hf_static)
    end
    RegisterScriptCallback("actor_on_update", sweep_update)
    RegisterScriptCallback("server_object_on_unregister", forget_piece)
end
