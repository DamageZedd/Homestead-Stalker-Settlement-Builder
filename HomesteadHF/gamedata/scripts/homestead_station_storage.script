-- homestead_station_storage.script
-- Every Homestead work station holds 300 kg: a hidden station_stash under the station (like the
-- Market Stall's goods and the Hideout Furniture workshop stash), opened by using the station.
-- The stash is settlement storage: settlers fill and draw from it, and the sorter sends it what
-- the station's homestead_storage_buckets name. stash ids live in alife_storage_manager state:
-- station_stashes[station_id] = stash_id.

local function state()
    local m = alife_storage_manager.get_state()
    m.station_stashes = m.station_stashes or {}
    return m.station_stashes
end

-- the camps cache their containers: a new or removed stash must show up at once
local function forget_camp_containers()
    local sb = stalker_camp_builder
    for _, camp in pairs(sb and sb.active_camps or {}) do
        if type(camp) == "table" then
            camp._cached_containers = nil
            camp._cached_categorized_boxes = nil
        end
    end
end

-- id of the station's stash, creating it when there is none yet
function get_stash(station_id)
    local stashes = state()
    local se_box = stashes[station_id] and alife_object(stashes[station_id])
    if se_box and se_box:section_name() ~= "station_stash" then se_box = nil end -- a reused id
    if not se_box then
        local obj = get_object_by_id(station_id)
        local se_station = alife_object(station_id)
        local src_pos = (obj and obj:position()) or (se_station and se_station.position)
        local lvid = (obj and obj:level_vertex_id()) or (se_station and se_station.m_level_vertex_id)
        local gvid = (obj and obj:game_vertex_id()) or (se_station and se_station.m_game_vertex_id)
        if not (src_pos and lvid and gvid) then return nil end
        local pos = vector():set(src_pos)
        pos.y = pos.y - 50
        se_box = alife_create("station_stash", pos, lvid, gvid)
        if not se_box then return nil end
        stashes[station_id] = se_box.id
        forget_camp_containers()
    end
    return se_box.id
end

-- the stash id if it already exists (no creation)
function find_stash(station_id)
    local id = state()[station_id]
    local se_box = id and alife_object(id)
    if se_box and se_box:section_name() == "station_stash" then return id end
    return nil
end

local OPEN_TIMEOUT_MS = 5000

local function is_teardown_grace()
    local sb = stalker_camp_builder
    if not sb then return false end
    if sb.homestead_is_disconnecting then return true end
    local grace = sb.homestead_teardown_grace_until
    return type(grace) == "number" and time_global and time_global() < grace
end

local function is_stash_empty(box_id, se_box)
    local box = level and level.object_by_id and level.object_by_id(box_id)
    if box and box.iterate_inventory_box then
        local found = false
        box:iterate_inventory_box(function(_, item)
            if item then found = true end
        end, box)
        return not found
    end
    local sim = alife and alife()
    if sim and sim.get_children then
        local empty = true
        local ok = pcall(function()
            for child_id in sim:get_children(se_box) do
                local child = child_id and sim:object(child_id)
                if child and child.parent_id == box_id then
                    empty = false
                    break
                end
            end
        end)
        return ok and empty
    end
    if _G.server_objects_registry then
        for _, child in pairs(_G.server_objects_registry) do
            if child and child.parent_id == box_id then
                return false
            end
        end
        return true
    end
    return false
end

local function release_empty_stash(box_id)
    local se_box = box_id and alife_object and alife_object(box_id)
    if not (se_box and se_box:section_name() == "station_stash") then
        return true
    end
    if is_stash_empty(box_id, se_box) then
        alife_release(se_box)
    end
    return true
end

local function on_unregister(se_obj)
    local obj_id = se_obj and se_obj.id
    if not obj_id or is_teardown_grace() then return end
    local m = alife_storage_manager and alife_storage_manager.get_state and alife_storage_manager.get_state()
    local stashes = m and m.station_stashes
    if not stashes then return end

    local box_id = stashes[obj_id]
    if box_id then
        stashes[obj_id] = nil
        forget_camp_containers()
        if RemoveTimeEvent then
            RemoveTimeEvent("homestead_station", "stash_" .. obj_id)
            RemoveTimeEvent("homestead_station", "open_" .. obj_id)
            RemoveTimeEvent("homestead_station", "retire_" .. obj_id)
        end
        local se_box = alife_object and alife_object(box_id)
        if se_box and se_box:section_name() == "station_stash" and is_stash_empty(box_id, se_box) then
            if CreateTimeEvent then
                CreateTimeEvent("homestead_station", "release_" .. box_id, 0, release_empty_stash, box_id)
            else
                alife_release(se_box)
            end
        end
        return
    end

    if se_obj.section_name and se_obj:section_name() == "station_stash" then
        local changed = false
        for owner_id, sid in pairs(stashes) do
            if sid == obj_id then
                stashes[owner_id] = nil
                changed = true
            end
        end
        if changed then forget_camp_containers() end
    end
end

local function open_stash(box_id, deadline)
    local se_box = box_id and alife_object and alife_object(box_id)
    if not (se_box and se_box:section_name() == "station_stash") then
        return true
    end
    local box = level.object_by_id(box_id)
    if not box then
        if deadline and time_global and time_global() >= deadline then
            return true
        end
        return false -- not online yet: the time event repeats
    end
    hide_hud_inventory()
    box:use(db.actor)
    return true
end

-- ui_on_simple_interaction: a quick use opens the station's storage; hold-use keeps the standard
-- Hideout Furniture menu (with Pick Up)
function use_station(station_id)
    local box_id = get_stash(station_id)
    if not box_id then return end
    -- the box must be online to be opened
    local sim = alife and alife()
    if sim then
        sim:set_switch_online(box_id, true)
        sim:set_switch_offline(box_id, false)
    end
    local deadline = (time_global and time_global() or 0) + OPEN_TIMEOUT_MS
    CreateTimeEvent("homestead_station", "open_" .. station_id, 0, open_stash, box_id, deadline)
end

local function make_stash(station_id)
    get_stash(station_id)
    return true
end

function init(obj)
    obj:bind_object(station_wrapper(obj).binder)
end

class "station_wrapper" (bind_hf_base.hf_binder_wrapper)

function station_wrapper:__init(obj)
    super(obj)
end

-- the stash is made as soon as the station is placed (or first comes online in an older save),
-- so settlers can store in it before the player ever opens it
function station_wrapper:net_spawn()
    bind_hf_base.hf_binder_wrapper.net_spawn(self)
    local id = self.object:id()
    CreateTimeEvent("homestead_station", "stash_" .. id, 1, make_stash, id)
end

function station_wrapper:net_destroy()
    if self.object then
        local id = self.object:id()
        RemoveTimeEvent("homestead_station", "stash_" .. id)
        RemoveTimeEvent("homestead_station", "open_" .. id)
    end
    bind_hf_base.hf_binder_wrapper.net_destroy(self)
end

-- picking the station up hands its storage back first
function station_wrapper:pickup()
    local id = self.object and self.object:id()
    local stashes = state()
    local box_id = id and stashes[id]
    local se_box = box_id and alife_object(box_id)
    if se_box and se_box:section_name() == "station_stash" then
        local box = level.object_by_id(box_id)
        if not box then
            -- releasing an offline box would release what is in it: bring it online and let the
            -- player pick the station up again in a moment
            alife():set_switch_online(box_id, true)
            alife():set_switch_offline(box_id, false)
            actor_menu.set_msg(1, game.translate_string("st_homestead_station_stash_busy"), 3)
            return false
        end
        box:iterate_inventory_box(function(temp, item)
            box:transfer_item(item, db.actor)
        end, box)
        alife_release(se_box)
    end
    if box_id then
        stashes[id] = nil
        forget_camp_containers()
    end
    return bind_hf_base.hf_binder_wrapper.pickup(self)
end

-- The Water Purifier has no storage any more. One placed in an older save still has its station_stash:
-- the first time it comes online the stash is emptied into the player's inventory (the same hand-back
-- as picking a station up, so nothing is lost or dropped where it can fall through the map), released,
-- and forgotten, so camp storage, the sorter and the settlers stop seeing it.
local function retire_stash(station_id)
    local ok, done = pcall(function()
        local stashes = state()
        local box_id = stashes[station_id]
        if not box_id then return true end
        local se_box = alife_object(box_id)
        if se_box and se_box:section_name() == "station_stash" then
            local box = level.object_by_id(box_id)
            if not box then
                -- an offline box would release what is in it: bring it online and try again
                alife():set_switch_online(box_id, true)
                alife():set_switch_offline(box_id, false)
                return false
            end
            local moved = 0
            box:iterate_inventory_box(function(temp, item)
                box:transfer_item(item, db.actor)
                moved = moved + 1
            end, box)
            alife_release(se_box)
            if moved > 0 then
                actor_menu.set_msg(1, game.translate_string("st_homestead_purifier_storage_moved"), 6)
            end
        end
        stashes[station_id] = nil
        forget_camp_containers()
        return true
    end)
    if not ok then
        printf("homestead_station_storage: retire_stash failed: %s", tostring(done))
        return true
    end
    return done
end

class "purifier_wrapper" (station_wrapper)

function purifier_wrapper:__init(obj)
    super(obj)
end

function purifier_wrapper:net_spawn()
    bind_hf_base.hf_binder_wrapper.net_spawn(self)
    local id = self.object:id()
    if state()[id] then
        CreateTimeEvent("homestead_station", "retire_" .. id, 1, retire_stash, id)
    end
end

function purifier_wrapper:net_destroy()
    if self.object then
        local id = self.object:id()
        RemoveTimeEvent("homestead_station", "retire_" .. id)
        RemoveTimeEvent("homestead_station", "open_" .. id)
    end
    station_wrapper.net_destroy(self)
end

function init_purifier(obj)
    obj:bind_object(purifier_wrapper(obj).binder)
end

function on_game_start()
    RegisterScriptCallback("server_object_on_unregister", on_unregister)
end
