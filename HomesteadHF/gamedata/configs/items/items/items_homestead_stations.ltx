;--------------------------------------------------------------------------------------------------
; HomesteadHF: work stations for the jobs that had none (cook, medic, guard, scavenger)
; Like the other HomesteadHF stations: a solid physic_object with 300 kg of settlement storage in a
; hidden station_stash (homestead_station_storage.script); homestead_storage_buckets says what the
; sorter sends that storage.
; The Field Kitchen has its own model (meshes\dynamics\HomesteadHF). STAND-IN VISUALS AND ICONS for
; the rest: their meshes (with their fixed_bones) and icons come from the required Hideout Furniture
; packs until each station's own model is made and approved.
;--------------------------------------------------------------------------------------------------

;--------------------------
;--- Field Kitchen (Полевая кухня): the Cook's station; a real stove for the cook job
;--- (the section name holds "stove", which is what the cook job checks for)
;--------------------------

[homestead_field_kitchen]:tch_junk
class                                   = II_ATTCH
kind                                    = i_tool
visual                                  = dynamics\HomesteadHF\field_kitchen.ogf
description                             = st_homestead_field_kitchen_descr
inv_name                                = st_homestead_field_kitchen
inv_name_short                          = st_homestead_field_kitchen
icons_texture                           = ui\ui_icon_homestead_workstations
inv_grid_x                              = 3
inv_grid_y                              = 15
inv_grid_width                          = 3
inv_grid_height                         = 3
cost                                    = 9000
inv_weight                              = 30.0

use1_functor                            = placeable_furniture.place_item
use1_action_functor                     = placeable_furniture.func_place_item

placeable_type                          = prop
placeable_section                       = placeable_field_kitchen_stove

[placeable_field_kitchen_stove]:physic_object
visual                                  = dynamics\HomesteadHF\field_kitchen.ogf
inv_weight                              = 70.0
placeable_type                          = prop
base_rotation                           = 0
script_binding                          = homestead_station_storage.init
ui_on_simple_interaction                = homestead_station_storage.use_station
; its 300 kg stash: which camp storage the sorter treats it as
homestead_storage_buckets               = pantry
item_section                            = homestead_field_kitchen

; width, depth, height / origin x, y (up), z: measured from the mesh bounds (chimney, prep shelf and fuel can included), 3 cm inset per side, 10 cm lifted
bounding_box_size                       = 1.881000, 0.621000, 1.950000
bounding_box_origin                     = 0.064500, 1.075000, -0.000500

