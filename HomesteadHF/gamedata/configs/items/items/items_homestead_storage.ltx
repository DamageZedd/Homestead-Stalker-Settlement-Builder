;--------------------------------------------------------------------------------------------------
; HomesteadHF: Settlement storage boxes
; Only boxes with homestead_storage (and work-station stashes, workbench stashes and fridges) are
; camp storage; every other Hideout Furniture box is the player's own. homestead_storage_buckets
; says what the sorter sends each box (stalker_camp_builder_storage.script).
; STAND-IN VISUALS AND ICONS: boxes still marked "stand-in" use meshes and icons from the required
; Hideout Furniture packs until their own model is made and approved.
;--------------------------------------------------------------------------------------------------

;--------------------------
;--- Armory Crate (Оружейный ящик): weapons, ammo, grenades
;--- An open Soviet rifle crate with an AK-74, 5.45 packs and F-1s inside (vanilla meshes baked in),
;--- one atlas (homestead_hf\atlas_armory_crate), a link box for the crate and a rigid box for the lid
;--------------------------

[homestead_armory_crate]:tch_junk
class                                   = II_ATTCH
kind                                    = i_tool
visual                                  = dynamics\HomesteadHF\armory_crate.ogf
description                             = st_homestead_armory_crate_descr
