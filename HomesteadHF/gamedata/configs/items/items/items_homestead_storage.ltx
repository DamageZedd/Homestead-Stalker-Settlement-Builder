inv_name_short                          = st_homestead_armory_crate
icons_texture                           = ui\ui_icon_homestead_workstations
inv_grid_x                              = 4
inv_grid_y                              = 9
inv_grid_width                          = 3
inv_grid_height                         = 2
cost                                    = 6000
inv_weight                              = 14.0

use1_functor                            = placeable_furniture.place_item
use1_action_functor                     = placeable_furniture.func_place_item

placeable_type                          = stash
placeable_section                       = placeable_homestead_armory

