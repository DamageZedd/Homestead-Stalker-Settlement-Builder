;--------------------------------------------------------------------------------------------------
; HomesteadHF: Settlement Flag, a camp hub that flies the player's faction colours
; The crafted homestead_settlement_flag turns into the player's faction's flag as soon as it is
; in their inventory (homestead_settlement_flag.script). Placing a flag founds a settlement like
; the Hideout Furniture Workshop does (homestead_hub), and the flag holds 300 kg as the camp's main
; storage (a station_stash, homestead_station_storage.script). Picking it up dismantles the camp.
; One placeable section per faction so each can carry its own emblem.
; Model: custom Settlement Flag with welded mast, guy wires, outriggers, weathered crate chest, kerosene lantern, and embroidered faction banner.
;--------------------------------------------------------------------------------------------------

; the crafted flag: becomes the player's faction's flag once it is in their inventory
[homestead_settlement_flag]:tch_junk
class                                   = II_ATTCH
kind                                    = i_tool
visual                                  = dynamics\HomesteadHF\settlement_flag.ogf
description                             = st_homestead_settlement_flag_descr
inv_name                                = st_homestead_settlement_flag
inv_name_short                          = st_homestead_settlement_flag
icons_texture                           = ui\ui_icon_homestead_workstations
inv_grid_x                              = 6
inv_grid_y                              = 15
inv_grid_width                          = 1
inv_grid_height                         = 2
cost                                    = 5000
inv_weight                              = 6.0

use1_functor                            = placeable_furniture.place_item
use1_action_functor                     = placeable_furniture.func_place_item

placeable_type                          = prop
placeable_section                       = placeable_settlement_flag_stalker

