class "RivalListItem" (CUIListBoxItem)
function RivalListItem:__init(smart, name, badge_text, location_text, is_hostile, xml, level_key)
    local type_ = type
    super()
    self.smart = smart
    self.total_item_height = 88
    self:SetWndRect(Frect():set(0, 0, 162, 88))
    self:SetWndSize(vector2():set(162, 88))
    if xml then
        self.card_bg = xml:InitStatic("rival_card_bg", self)
        self.thumb = xml:InitStatic("rival_card_thumb", self)

        local lvl = level_key or "default"
        if (not lvl or lvl == "default") and smart then
            local rcamp = stalker_camp_builder.rival_camps and stalker_camp_builder.rival_camps[smart]
            if rcamp and rcamp.level then
                lvl = rcamp.level
            elseif type_(smart) == "table" and smart.level then
                lvl = smart.level
            elseif type_(smart) == "string" then
                local sm = SIMBOARD and SIMBOARD.smarts_by_names and SIMBOARD.smarts_by_names[smart]
                if sm and sm.level_name then
                    lvl = sm:level_name()
                end
            elseif type_(smart) == "userdata" or (type_(smart) == "table" and smart.id) then
                local se_obj = alife_object(smart.id or smart)
                if se_obj and se_obj.level_name then
                    lvl = se_obj:level_name()
                end
            end
        end
        if (not lvl or lvl == "default") and location_text then
            local loc_lower = location_text:lower()
            for l_key, _ in pairs(VALID_HOMESTEAD_LEVELS) do
                if loc_lower:find(l_key) then
                    lvl = l_key
                    break
                end
            end
        end
        local tex_id = VALID_HOMESTEAD_LEVELS[lvl] and ("ui_homestead_thumb_" .. lvl) or "ui_homestead_thumb_default"
        if self.thumb then
            self.thumb:InitTexture(tex_id)
        end

        self.name_wnd = xml:InitTextWnd("rival_row_name", self)
        if self.name_wnd then
            self.name_wnd:SetText(name or "")
        end
    else
        self.text_item = self:GetTextItem()
        self.text_item:SetText(name or "")
        self.text_item:SetFont(GetFontLetterica18Russian())
        self.text_item:SetTextColor(GetARGB(255, 238, 196, 112))
    end
end

function RivalListItem:SetSelected(is_sel)
    if self.card_bg and self.card_bg.InitTexture then
        if is_sel then
            self.card_bg:InitTexture("ui_homestead_card_selected")
            if self.name_wnd then
                self.name_wnd:SetTextColor(GetARGB(255, 255, 230, 150))
            end
        else
            self.card_bg:InitTexture("ui_homestead_card_bg")
            if self.name_wnd then
                self.name_wnd:SetTextColor(GetARGB(255, 238, 196, 112))
            end
        end
    end
end

class "SettlementManagerPDA" (CUIScriptWnd)
function SettlementManagerPDA:__init() super()
    self:InitControls()
end

function SettlementManagerPDA:__finalize()
    -- Mark the singleton as no-longer-active so the actor_on_update callback
    -- can short-circuit cleanly if the engine fires another tick before the
    -- Lua side is fully torn down.
    if SINGLETON then
        SINGLETON._closing = true
        -- printf("[Homestead PDA] __finalize: dialog torn down, singleton marked as closing")
    end
    SINGLETON = nil
end

function SettlementManagerPDA:OnKeyboard(dik, keyboard_action)
    local res = CUIScriptWnd.OnKeyboard(self, dik, keyboard_action)
    if res then return res end
    if keyboard_action == ui_events.WINDOW_KEY_PRESSED then
        if dik == DIK_keys.DIK_ESCAPE then
            if self:IsShown() then
                self:HideDialog()
                return true
            end
        end
    end
    return false
end

function SettlementManagerPDA:InitControls()
    self:SetWndRect(Frect():set(0, 0, 1024, 768))

    local xml = CScriptXmlInit()
    xml:ParseFile("ui_stalker_camp_builder_pda.xml")
    self.xml = xml

    xml:InitFrame("background", self)
    xml:InitFrameLine("vertical_line", self)

    self.left_container = xml:InitStatic("left_container", self)
    self.btn_tab_overview = xml:Init3tButton("left_container:btn_tab_overview", self.left_container)
    self.btn_tab_survivors = xml:Init3tButton("left_container:btn_tab_survivors", self.left_container)
    self.btn_tab_rivals = xml:Init3tButton("left_container:btn_tab_rivals", self.left_container)
    self.btn_tab_radio = xml:Init3tButton("left_container:btn_tab_radio", self.left_container)
    self.btn_tab_guide = xml:Init3tButton("left_container:btn_tab_guide", self.left_container)

    self:Register(self.btn_tab_overview, "btn_tab_overview")
    self:Register(self.btn_tab_survivors, "btn_tab_survivors")
    self:Register(self.btn_tab_rivals, "btn_tab_rivals")
    self:Register(self.btn_tab_radio, "btn_tab_radio")
    self:Register(self.btn_tab_guide, "btn_tab_guide")

    self:AddCallback("btn_tab_overview", ui_events.BUTTON_CLICKED, function() self:SetTab("overview") end, self)
    self:AddCallback("btn_tab_survivors", ui_events.BUTTON_CLICKED, function() self:SetTab("survivors") end, self)
    self:AddCallback("btn_tab_rivals", ui_events.BUTTON_CLICKED, function() self:SetTab("rivals") end, self)
    self:AddCallback("btn_tab_radio", ui_events.BUTTON_CLICKED, function() self:SetTab("radio") end, self)
    self:AddCallback("btn_tab_guide", ui_events.BUTTON_CLICKED, function() self:SetTab("guide") end, self)

    self.list_header_bg = xml:InitFrame("list_header_bg", self)
    self.settlement_header = xml:InitTextWnd("settlement_header", self)

    self.settlement_list = xml:InitListBox("settlement_list", self)
    self:Register(self.settlement_list, "settlement_list")
    self:AddCallback("settlement_list", ui_events.LIST_ITEM_CLICKED, self.OnSettlementSelected, self)

    -- Tab 3 panel (Rivals) with ScrollView
    self.rivals_panel = xml:InitStatic("rivals_panel", self)
    self.rival_scroll = xml:InitScrollView("rivals_panel:rival_scroll", self.rivals_panel)
    self.rival_content = xml:InitStatic("rival_content", nil)
    self.rival_scroll:AddWindow(self.rival_content, true)

    self.rival_camp_name = xml:InitTextWnd("rival_content:rival_camp_name", self.rival_content)
    self.rival_camp_spec = xml:InitTextWnd("rival_content:rival_camp_spec", self.rival_content)
    self.rival_banner_bg = xml:InitStatic("rival_content:rival_banner_bg", self.rival_content)
    self.rival_banner_lbl = xml:InitTextWnd("rival_content:rival_banner_lbl", self.rival_content)

    -- the rival panel's module backgrounds, then their header bars, then the section headings:
    -- a window draws its children in the order they are attached
    self.rival_faction_bg = xml:InitStatic("rival_content:rival_faction_bg", self.rival_content)
    self.rival_loc_gar_bg = xml:InitStatic("rival_content:rival_loc_gar_bg", self.rival_content)
    self.rival_intel_bg = xml:InitStatic("rival_content:rival_intel_bg", self.rival_content)
    for _, name in ipairs({"rival_faction_header_bg", "rival_loc_gar_header_bg", "rival_intel_header_bg"}) do
        xml:InitStatic("rival_content:" .. name, self.rival_content)
    end
    for _, name in ipairs({"rival_faction_lbl", "rival_loc_gar_lbl", "rival_intel_lbl"}) do
        xml:InitTextWnd("rival_content:" .. name, self.rival_content)
    end
    self.rival_camp_status = xml:InitTextWnd("rival_content:rival_camp_status", self.rival_content)
    self.rival_camp_faction = xml:InitTextWnd("rival_content:rival_camp_faction", self.rival_content)
    self.rival_camp_location = xml:InitTextWnd("rival_content:rival_camp_location", self.rival_content)
    self.rival_camp_garrison = xml:InitTextWnd("rival_content:rival_camp_garrison", self.rival_content)
    self.rival_camp_intel = xml:InitTextWnd("rival_content:rival_camp_intel", self.rival_content)

    self.btn_rival_locate = xml:Init3tButton("rival_content:btn_rival_locate", self.rival_content)
    self:Register(self.btn_rival_locate, "btn_rival_locate")
    self:AddCallback("btn_rival_locate", ui_events.BUTTON_CLICKED, self.OnLocateRivalMapClicked, self)
    self.btn_refresh = xml:Init3tButton("rival_content:btn_refresh", self.rival_content)
    self:Register(self.btn_refresh, "btn_refresh")
    self:AddCallback("btn_refresh", ui_events.BUTTON_CLICKED, self.OnRefreshClicked, self)

    self.rival_list = xml:InitListBox("rival_list", self)
    self:Register(self.rival_list, "rival_list")
    self:AddCallback("rival_list", ui_events.LIST_ITEM_CLICKED, self.OnRivalSelected, self)

    self.no_settlements_label = xml:InitStatic("no_settlements_label", self)

    -- Tab 1 details panel (overview_panel) with ScrollView
    self.overview_panel = xml:InitStatic("overview_panel", self)
    self.overview_scroll = xml:InitScrollView("overview_panel:overview_scroll", self.overview_panel)
    self.overview_content = xml:InitStatic("overview_content", nil)
    self.overview_scroll:AddWindow(self.overview_content, true)

    self.camp_header_bg = xml:InitStatic("overview_content:camp_header_bg", self.overview_content)
    self.camp_name = xml:InitTextWnd("overview_content:camp_name", self.overview_content)
    self.camp_spec_badge = xml:InitTextWnd("overview_content:camp_spec_badge", self.overview_content)
    self.raid_banner_bg = xml:InitStatic("overview_content:raid_banner_bg", self.overview_content)
    self.raid_banner_lbl = xml:InitTextWnd("overview_content:raid_banner_lbl", self.overview_content)

    -- Module A: Personnel & Habitation
    self.pop_card_bg = xml:InitStatic("overview_content:pop_card_bg", self.overview_content)
    self.pop_header_bg = xml:InitStatic("overview_content:pop_header_bg", self.overview_content)
    self.pop_card_lbl = xml:InitTextWnd("overview_content:pop_card_lbl", self.overview_content)
    self.camp_pop = xml:InitTextWnd("overview_content:camp_pop", self.overview_content)
    self.camp_pop_gauge = xml:InitTextWnd("overview_content:camp_pop_gauge", self.overview_content)

    -- Module B: Defense & Perimeter Security
    self.def_card_bg = xml:InitStatic("overview_content:def_card_bg", self.overview_content)
    self.def_header_bg = xml:InitStatic("overview_content:def_header_bg", self.overview_content)
    self.def_card_lbl = xml:InitTextWnd("overview_content:def_card_lbl", self.overview_content)
    self.camp_def = xml:InitTextWnd("overview_content:camp_def", self.overview_content)
    self.camp_def_breakdown = xml:InitTextWnd("overview_content:camp_def_breakdown", self.overview_content)
    self.camp_threat_lvl = xml:InitTextWnd("overview_content:camp_threat_lvl", self.overview_content)

    -- Module C: Logistics, Life Support & Morale
    self.logistics_card_bg = xml:InitStatic("overview_content:logistics_card_bg", self.overview_content)
    self.logistics_header_bg = xml:InitStatic("overview_content:logistics_header_bg", self.overview_content)
    self.logistics_card_lbl = xml:InitTextWnd("overview_content:logistics_card_lbl", self.overview_content)
