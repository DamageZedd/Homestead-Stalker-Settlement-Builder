local sformat = string.format
local colorize_pda_text   -- defined below; the radio rows above it call it

local function make_gauge_bar(current, max_val, length, fill_char, empty_char)
    local len = length or 8
    local f_char = fill_char or "|"
    local e_char = empty_char or "."
    local pct = 0
    if max_val and max_val > 0 then
        pct = math.min(100, math.max(0, math.floor((current / max_val) * 100)))
    end
    local filled = math.floor((pct / 100) * len)
    local empty = len - filled
    return string.format("[%s%s] %d%%", string.rep(f_char, filled), string.rep(e_char, empty), pct)
end
class "RadioLogItem" (CUIListBoxItem)
function RadioLogItem:__init(time_str, cat_str, text_str, xml)
    super()
    self:SetWndRect(Frect():set(0, 0, 544, 48))
    if xml then
        self.card_bg = xml:InitStatic("radio_card_bg", self)
        self.time_wnd = xml:InitTextWnd("radio_row_time", self)
        self.time_wnd:SetText(string.format("[%s] [%s]", time_str or "--:--", cat_str:upper()))
        
        if cat_str == "combat" then
            self.time_wnd:SetTextColor(GetARGB(255, 255, 100, 100))
        elseif cat_str == "expedition" then
            self.time_wnd:SetTextColor(GetARGB(255, 100, 200, 255))
        elseif cat_str == "work" then
            self.time_wnd:SetTextColor(GetARGB(255, 144, 238, 144))
        else
            self.time_wnd:SetTextColor(GetARGB(255, 238, 196, 112))
        end

        self.text_wnd = xml:InitTextWnd("radio_row_text", self)
        self.text_wnd:SetText(colorize_pda_text(text_str or ""))
    end
end


-- =========================================================================
-- PDA AUTOMATED KEYWORD COLORIZER & GAUGES (iTheon Tactical Engine)
-- =========================================================================
local function make_gauge(pct, total_blocks, fill_char, empty_char)
    local mmax = math.max
    local blocks = total_blocks or 10
    local p = mmax(0, math.min(100, pct or 0))
    local filled = mmax(0, math.min(blocks, math.floor((p / 100) * blocks + 0.5)))
    local empty = mmax(0, blocks - filled)
    return string.rep(fill_char or "|", filled) .. string.rep(empty_char or ".", empty)
end
local function escape_pda_pattern(str)
    return (str:gsub("([%(%)%.%%%+%-%*%?%[%]%^%$])", "%%%1"))
end

function colorize_pda_text(text)
    if not text or text == "" then return "" end

    local faction_colors = {
        dolg = "255,255,80,80", duty = "255,255,80,80",
        freedom = "255,80,255,80", svoboda = "255,80,255,80",
        killer = "255,80,180,255", mercenary = "255,80,180,255",
        stalker = "255,238,196,112", loner = "255,238,196,112",
        csky = "255,80,220,220", clear_sky = "255,80,220,220",
        ecolog = "255,80,255,255", monolith = "255,180,100,255",
        bandit = "255,220,220,220", renegade = "255,220,180,100",
        army = "255,160,200,80", military = "255,160,200,80"
    }

    for comm, clr in pairs(faction_colors) do
        local comm_str = game.translate_string(comm)
        if comm_str and comm_str ~= comm and comm_str ~= "" then
            text = text:gsub(escape_pda_pattern(comm_str), function()
                return string.format("%%c[%s]%s%%c[255,220,220,220]", clr, comm_str)
            end)
        end
    end

    -- Highlights for keywords
    text = text:gsub("Ambushed", function() return "%c[255,255,100,100]Ambushed%c[255,220,220,220]" end)
    text = text:gsub("Defeated", function() return "%c[255,144,238,144]Defeated%c[255,220,220,220]" end)
    text = text:gsub("Recovered", function() return "%c[255,100,200,255]Recovered%c[255,220,220,220]" end)
    text = text:gsub("Deposited", function() return "%c[255,238,196,112]Deposited%c[255,220,220,220]" end)

    return text
end

local function play_pda_ui_sound(snd_path)
    -- PDA audio disabled per user request
end

-- closes the PDA the way its key does (actor_effects). The page is the PDA's subdialog, attached
-- by CUIPdaWnd::SetActiveSubdialog without a dialog holder, so its own HideDialog does nothing.
local function close_pda()
    if get_console_cmd(1, "g_3d_pda") then
        db.actor:activate_slot(0)
    else
        local pda_menu = ActorMenu.get_pda_menu()
        if pda_menu and pda_menu:IsShown() then
            pda_menu:HideDialog()
        end
    end
end

-- Homestead PDA Settlement Manager Tab UI
-- Version: v1.2.5

local SINGLETON = nil

-- Exposed so actor_on_update in stalker_camp_builder can drive live refresh
function get_singleton() return SINGLETON end

-- Named global so RegisterScriptCallback can find it by reference across the engine boundary.
-- local functions are not visible to the X-Ray callback dispatcher.
function homestead_pda_actor_on_update()
    if not stalker_camp_builder then return end
    -- the window outlives a closed PDA; Update() refreshes it while it is on screen
    if not SINGLETON or SINGLETON._closing or not SINGLETON:IsShown() then
        return
    end
    -- v1.1.7: also refresh the overview tab (previously survivors-only, so
    -- timers on the default Overview view were a frozen snapshot).
    if SINGLETON.current_tab ~= "survivors" and SINGLETON.current_tab ~= "overview" then
        return
    end
    local now = time_global()
    local last = SINGLETON._last_refresh or 0
    if (now - last) < 1000 and (now >= last) then return end
    SINGLETON._last_refresh = now
    if SINGLETON.UpdateSurvivorsProgress then
        SINGLETON:UpdateSurvivorsProgress()
    end
end

function get_ui()
    SINGLETON = SINGLETON or SettlementManagerPDA()
    SINGLETON:Reset()
    if not _G["homestead_pda_actor_on_update_registered"] then
        -- printf("[Homestead PDA] registering actor_on_update callback")
        _G["homestead_pda_actor_on_update"] = homestead_pda_actor_on_update
        RegisterScriptCallback("actor_on_update", homestead_pda_actor_on_update)
        _G["homestead_pda_actor_on_update_registered"] = true
        -- printf("[Homestead PDA] callback registered")
    else
        -- printf("[Homestead PDA] callback already registered")
    end
    return SINGLETON
end

local VALID_HOMESTEAD_LEVELS = {
    ["l01_escape"] = true, ["l02_garbage"] = true, ["l03_agroprom"] = true,
    ["l04_darkvalley"] = true, ["l05_bar"] = true, ["l06_rostok"] = true,
    ["l07_military"] = true, ["l08_yantar"] = true, ["l09_deadcity"] = true,
    ["l10_limansk"] = true, ["l10_radar"] = true, ["l10_red_forest"] = true,
    ["l11_hospital"] = true, ["l11_pripyat"] = true, ["pripyat"] = true,
    ["jupiter"] = true, ["zaton"] = true, ["k00_marsh"] = true,
    ["k01_darkscape"] = true, ["k02_trucks_cemetery"] = true, ["y04_pole"] = true,
}

class "SettlementListItem" (CUIListBoxItem)
function SettlementListItem:__init(hub_id, name, badge_str, is_raid, details_str, xml)
    super()
    self.hub_id = hub_id
    self.total_item_height = 88
    self:SetWndRect(Frect():set(0, 0, 162, 88))
    self:SetWndSize(vector2():set(162, 88))
    if xml then
        self.card_bg = xml:InitStatic("settlement_card_bg", self)
        self.thumb = xml:InitStatic("settlement_card_thumb", self)
        
        local camp_data = stalker_camp_builder and stalker_camp_builder.active_camps and stalker_camp_builder.active_camps[hub_id]
        local lvl = camp_data and camp_data.level or (level and level.name and level.name() or "default")
        local tex_id = VALID_HOMESTEAD_LEVELS[lvl] and ("ui_homestead_thumb_" .. lvl) or "ui_homestead_thumb_default"
        if self.thumb then
            self.thumb:InitTexture(tex_id)
        end

        self.name_wnd = xml:InitTextWnd("settlement_row_name", self)
        if self.name_wnd then
            self.name_wnd:SetText(name or "")
        end
    else
        self.text_item = self:GetTextItem()
        self.text_item:SetText(name or "")
        self.text_item:SetFont(GetFontLetterica18Russian())
        self.text_item:SetTextColor(GetARGB(255, 238, 196, 112))
    end
end

function SettlementListItem:SetSelected(is_sel)
    if self.card_bg and self.card_bg.InitTexture then
        if is_sel then
            self.card_bg:InitTexture("ui_homestead_card_selected")
            if self.name_wnd then
                self.name_wnd:SetTextColor(GetARGB(255, 255, 230, 150))
            end
        else
            self.card_bg:InitTexture("ui_homestead_card_bg")
            if self.name_wnd then
                self.name_wnd:SetTextColor(GetARGB(255, 200, 200, 200))
            end
        end
    end
end

class "SurvivorListItem" (CUIListBoxItem)
function SurvivorListItem:__init(survivor_id, name, status_str, icon_sec, rank_str, xml)
    local mmax = math.max
    super()
    self.survivor_id = survivor_id
    if xml then
        self.card_bg = xml:InitStatic("survivor_card_bg", self)
        self.icon_bg = xml:InitStatic("survivor_card_icon_bg", self)
        self.icon = xml:InitStatic("survivor_card_icon", self)
        
        if icon_sec and icon_sec ~= "" then
            pcall(function() self.icon:InitTexture(icon_sec) end)
        else
            self.icon:InitTexture("ui\\ui_noise")
        end

        self.name_wnd = xml:InitTextWnd("survivor_row_name", self)
        self.name_wnd:SetWndPos(vector2():set(50, 4))
        self.name_wnd:SetText(name)
        self.name_wnd:AdjustHeightToText()
        local nh = mmax(16, self.name_wnd:GetHeight())

        local status_y = 4 + nh + 3
        self.status_wnd = xml:InitTextWnd("survivor_row_status", self)
        self.status_wnd:SetWndPos(vector2():set(50, status_y))
        self.status_wnd:SetText(status_str or "")
        self.status_wnd:AdjustHeightToText()
        local sh = mmax(14, self.status_wnd:GetHeight())
        self.status_h = sh

        local rank_y = status_y + sh + 3
        self.rank_wnd = xml:InitTextWnd("survivor_row_rank", self)
        self.rank_wnd:SetWndPos(vector2():set(50, rank_y))
        self.rank_wnd:SetText(rank_str or "")
        self.rank_wnd:AdjustHeightToText()
        local rh = mmax(14, self.rank_wnd:GetHeight())

        local card_h = mmax(72, rank_y + rh + 4)
        self.total_item_height = card_h + 2
        self.card_bg:SetWndSize(vector2():set(158, card_h))
        self:SetWndRect(Frect():set(0, 0, 158, self.total_item_height))
        self:SetWndSize(vector2():set(158, self.total_item_height))
    else
        self.total_item_height = 72
        self.text_item = self:GetTextItem()
        self.text_item:SetText(name)
        self.text_item:SetFont(GetFontLetterica18Russian())
        self.text_item:SetTextColor(GetARGB(255, 238, 196, 112))
        self:SetWndRect(Frect():set(0, 0, 158, 72))
        self:SetWndSize(vector2():set(158, 72))
    end
end

function SurvivorListItem:SetSelected(is_sel)
    if self.card_bg and self.card_bg.InitTexture then
        if is_sel then
            self.card_bg:InitTexture("ui_homestead_card_selected")
            if self.name_wnd then
                self.name_wnd:SetTextColor(GetARGB(255, 255, 230, 150))
            end
        else
            self.card_bg:InitTexture("ui_homestead_card_bg")
            if self.name_wnd then
                self.name_wnd:SetTextColor(GetARGB(255, 238, 196, 112))
            end
        end
    end
end

-- returns true when the new status needs more lines than the card was laid out for (it would
-- run over the rank line under it)
function SurvivorListItem:UpdateStatus(status_str, color)
    if self.status_wnd then
        self.status_wnd:SetText(status_str or "")
        if color then
            self.status_wnd:SetTextColor(color)
        end
        self.status_wnd:AdjustHeightToText()
        return self.status_h ~= nil and self.status_wnd:GetHeight() > self.status_h
    end
end

