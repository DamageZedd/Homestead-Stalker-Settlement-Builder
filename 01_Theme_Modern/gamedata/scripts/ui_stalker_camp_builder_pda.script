    self.telemetry_lbl = xml:InitTextWnd("job_content:telemetry_lbl", self.job_content)
    self.telemetry_bg = xml:InitStatic("job_content:telemetry_bg", self.job_content)
    self.survivor_job_txt = xml:InitTextWnd("job_content:survivor_job", self.job_content)

    self.job_header_bg = xml:InitStatic("job_content:job_header_bg", self.job_content)
    self.job_header_lbl = xml:InitTextWnd("job_content:job_header_lbl", self.job_content)

    self.pos_header_bg = xml:InitStatic("job_content:pos_header_bg", self.job_content)
    self.pos_header_lbl = xml:InitTextWnd("job_content:pos_header_lbl", self.job_content)
    self.pos_bg = xml:InitStatic("job_content:pos_bg", self.job_content)

    self.transfer_header_bg = xml:InitStatic("job_content:transfer_header_bg", self.job_content)
    self.transfer_lbl = xml:InitTextWnd("job_content:transfer_lbl", self.job_content)
    self.transfer_bg = xml:InitStatic("job_content:transfer_bg", self.job_content)

    -- Job reassignment buttons (2 Columns x 5 Rows) with crash-proof programmatic fallback
    local function init_safe_job_btn(tag_name, job_name, fallback_ref)
        local has_node = false
        pcall(function()
            xml:NavigateToRoot()
            if xml:NavigateToNode("job_content", 0) then
                if xml:NavigateToNode(tag_name, 0) then
                    has_node = true
                end
            end
            xml:NavigateToRoot()
        end)

        local btn = nil
        if has_node then
            local ok, res = pcall(function() return xml:Init3tButton("job_content:" .. tag_name, self.job_content) end)
            if ok and res then btn = res end
        end

        if not btn then
            -- Failsafe programmatic instantiation: guarantees engine never CTDs on missing XML tags
            btn = CUI3tButton()
            btn:SetAutoDelete(true)
            self.job_content:AttachChild(btn)
            btn:SetWndSize(vector2():set(80, 28))
            if fallback_ref and fallback_ref.GetWndPos then
                btn:SetWndPos(fallback_ref:GetWndPos())
            end
            btn:InitTexture("ui_homestead_btn_tactical")
            if btn.TextControl and btn:TextControl() then
                btn:TextControl():SetFont(GetFontLetterica16Russian())
                local raw_lbl = game.translate_string("st_job_" .. job_name .. "_btn")
                btn:TextControl():SetText(raw_lbl)
                btn:TextControl():SetTextColor(GetARGB(255, 220, 220, 220))
            end
        end

        self:Register(btn, tag_name)
        self:AddCallback(tag_name, ui_events.BUTTON_CLICKED, function() self:AssignJob(job_name) end, self)
        return btn
    end

    self.btn_job_idle = init_safe_job_btn("btn_job_idle", "idle", nil)
    self.btn_job_guard = init_safe_job_btn("btn_job_guard", "guard", self.btn_job_idle)
    self.btn_job_scavenge = init_safe_job_btn("btn_job_scavenge", "scavenge", self.btn_job_idle)
    self.btn_job_hunter = init_safe_job_btn("btn_job_hunter", "hunter", self.btn_job_guard)
    self.btn_job_craft = init_safe_job_btn("btn_job_craft", "craft", self.btn_job_idle)
    self.btn_job_repair = init_safe_job_btn("btn_job_repair", "repair", self.btn_job_guard)
    self.btn_job_cook = init_safe_job_btn("btn_job_cook", "cook", self.btn_job_idle)
    self.btn_job_medic = init_safe_job_btn("btn_job_medic", "medic", self.btn_job_guard)
    self.btn_job_electrician = init_safe_job_btn("btn_job_electrician", "electrician", self.btn_job_idle)
    self.btn_job_woodcutter = init_safe_job_btn("btn_job_woodcutter", "woodcutter", self.btn_job_guard)
    self.btn_job_brewer = init_safe_job_btn("btn_job_brewer", "brewer", self.btn_job_idle)
    self.btn_job_scrapper = init_safe_job_btn("btn_job_scrapper", "scrapper", self.btn_job_guard)

    -- Banish button
    self.btn_banish = xml:Init3tButton("job_content:btn_banish", self.job_content)
    self:Register(self.btn_banish, "btn_banish")
    self:AddCallback("btn_banish", ui_events.BUTTON_CLICKED, self.OnBanishClicked, self)

    -- Rename survivor button
    self.btn_rename_survivor = xml:Init3tButton("job_content:btn_rename_survivor", self.job_content)
    self:Register(self.btn_rename_survivor, "btn_rename_survivor")
    self:AddCallback("btn_rename_survivor", ui_events.BUTTON_CLICKED, self.OnRenameSurvivorClicked, self)

    -- Manual Refresh button on the left rail
    self.btn_refresh_survivors = xml:Init3tButton("left_container:btn_refresh_survivors", self.left_container)
    self:Register(self.btn_refresh_survivors, "btn_refresh_survivors")
    self:AddCallback("btn_refresh_survivors", ui_events.BUTTON_CLICKED, self.OnManualRefresh, self)

    -- Position sub-panel
    self.survivor_pos_txt = xml:InitTextWnd("job_content:survivor_pos", self.job_content)

    self.btn_position_here = xml:Init3tButton("job_content:btn_position_here", self.job_content)
    self:Register(self.btn_position_here, "btn_position_here")
    self:AddCallback("btn_position_here", ui_events.BUTTON_CLICKED, self.OnPositionHereClicked, self)

    self.btn_position_recall = xml:Init3tButton("job_content:btn_position_recall", self.job_content)
    self:Register(self.btn_position_recall, "btn_position_recall")
    self:AddCallback("btn_position_recall", ui_events.BUTTON_CLICKED, self.OnPositionRecallClicked, self)

    self.btn_job_directive = xml:Init3tButton("job_content:btn_job_directive", self.job_content)
    if self.btn_job_directive then
        self:Register(self.btn_job_directive, "btn_job_directive")
        self:AddCallback("btn_job_directive", ui_events.BUTTON_CLICKED, self.OnJobDirectiveClicked, self)
    end

    -- Transfer sub-panel
    self.transfer_list = xml:InitListBox("job_content:transfer_list", self.job_content)
    self:Register(self.transfer_list, "transfer_list")

    self.btn_transfer = xml:Init3tButton("job_content:btn_transfer", self.job_content)
    self:Register(self.btn_transfer, "btn_transfer")
    self:AddCallback("btn_transfer", ui_events.BUTTON_CLICKED, self.OnTransferClicked, self)

    self.close_btn = xml:Init3tButton("close_button", self)
    self:Register(self.close_btn, "close_btn")
    self:AddCallback("close_btn", ui_events.BUTTON_CLICKED, close_pda, self)

    -- Tab 4 panel (Radio Feed & Activity Log)
    self.radio_panel = xml:InitStatic("radio_panel", self)
    xml:InitStatic("radio_panel:radio_header_bg", self.radio_panel)
    xml:InitTextWnd("radio_panel:radio_header_lbl", self.radio_panel)
    self.radio_scroll = xml:InitScrollView("radio_panel:radio_scroll", self.radio_panel)

    self.btn_radio_filter_all = xml:Init3tButton("radio_panel:btn_radio_filter_all", self.radio_panel)
    self:Register(self.btn_radio_filter_all, "btn_radio_filter_all")
    self:AddCallback("btn_radio_filter_all", ui_events.BUTTON_CLICKED, self.OnRadioFilterAllClicked, self)

    self.btn_radio_filter_exp = xml:Init3tButton("radio_panel:btn_radio_filter_exp", self.radio_panel)
    self:Register(self.btn_radio_filter_exp, "btn_radio_filter_exp")
    self:AddCallback("btn_radio_filter_exp", ui_events.BUTTON_CLICKED, self.OnRadioFilterExpClicked, self)

    self.btn_radio_filter_work = xml:Init3tButton("radio_panel:btn_radio_filter_work", self.radio_panel)
    self:Register(self.btn_radio_filter_work, "btn_radio_filter_work")
    self:AddCallback("btn_radio_filter_work", ui_events.BUTTON_CLICKED, self.OnRadioFilterWorkClicked, self)

    self.btn_radio_filter_combat = xml:Init3tButton("radio_panel:btn_radio_filter_combat", self.radio_panel)
    self:Register(self.btn_radio_filter_combat, "btn_radio_filter_combat")
    self:AddCallback("btn_radio_filter_combat", ui_events.BUTTON_CLICKED, self.OnRadioFilterCombatClicked, self)

    self.btn_radio_scan = xml:Init3tButton("radio_panel:btn_radio_scan", self.radio_panel)
    self:Register(self.btn_radio_scan, "btn_radio_scan")
    self:AddCallback("btn_radio_scan", ui_events.BUTTON_CLICKED, self.OnRadioScanClicked, self)

    self.btn_radio_clear = xml:Init3tButton("radio_panel:btn_radio_clear", self.radio_panel)
    self:Register(self.btn_radio_clear, "btn_radio_clear")
    self:AddCallback("btn_radio_clear", ui_events.BUTTON_CLICKED, self.OnRadioClearClicked, self)

    -- Tab 4 panel (How to Play / Guide)
    self.guide_panel = xml:InitStatic("guide_panel", self)
    self.guide_scroll = xml:InitScrollView("guide_panel:guide_scroll", self.guide_panel)
    xml:InitStatic("guide_panel:guide_header_bg", self.guide_panel)
    xml:InitTextWnd("guide_panel:guide_header_lbl", self.guide_panel)

    -- Build the guide as structured sections: header bar + body + separator.
    -- Each section is a separate translation key for cleaner layout and easier
    -- localization than one giant wall-of-text string.
    local guide_sections = {
        { header = "st_guide_s1_header",        body = "st_guide_s1_body"        },  -- 1. Establishing & Hubs
        { header = "st_guide_s2_header",        body = "st_guide_s2_body"        },  -- 2. Recruitment & Housing
        { header = "st_guide_s3_header",        body = "st_guide_s3_body"        },  -- 3. Professions Overview
        { header = "st_guide_s3a_header",       body = "st_guide_s3a_body",       is_job = true },  -- Job: Idle & Recreation
        { header = "st_guide_s3b_header",       body = "st_guide_s3b_body",       is_job = true },  -- Job: Guard & Defense
        { header = "st_guide_s3c_header",       body = "st_guide_s3c_body",       is_job = true },  -- Job: Scavenger & Expeditions
        { header = "st_guide_s3_hunter_header", body = "st_guide_s3_hunter_body", is_job = true },  -- Job: Hunter & Mutant Harvesting
        { header = "st_guide_s3d_header",       body = "st_guide_s3d_body",       is_job = true },  -- Job: Crafter & Ammunition
        { header = "st_guide_s3e_header",       body = "st_guide_s3e_body",       is_job = true },  -- Job: Technician & Repairs
        { header = "st_guide_s3f_header",       body = "st_guide_s3f_body",       is_job = true },  -- Job: Cook & Hospitality
        { header = "st_guide_s3g_header",       body = "st_guide_s3g_body",       is_job = true },  -- Job: Medic & Triage
        { header = "st_guide_s3h_header",       body = "st_guide_s3h_body",       is_job = true },  -- Job: Electrician & Power
        { header = "st_guide_s3i_header",       body = "st_guide_s3i_body",       is_job = true },  -- Job: Woodcutter & Timber / Charcoal
        { header = "st_guide_s3j_header",       body = "st_guide_s3j_body",       is_job = true },  -- Job: Brewer & Distillery
        { header = "st_guide_s3k_header",       body = "st_guide_s3k_body",       is_job = true },  -- Job: Scrapper & Metal Salvage
        { header = "st_guide_s4_header",        body = "st_guide_s4_body"        },  -- 4. Smart Storage Routing, Auto-Sort & Water/Fridges
        { header = "st_guide_s5_header",        body = "st_guide_s5_body"        },  -- 5. Base Defense & Raids
        { header = "st_guide_s6_header",        body = "st_guide_s6_body"        },  -- 6. Rival Wilderness Camps
        { header = "st_guide_s7_header",        body = "st_guide_s7_body"        },  -- 7. Settlement Radio Feed
        { header = "st_guide_s8_header",        body = "st_guide_s8_body"        },  -- 8. Specializations & Morale
        { header = "st_guide_s9_header",        body = "st_guide_s9_body"        },  -- 9. MCM Configuration
        { header = "st_guide_s10_header",       body = "st_guide_s10_body"       },  -- 10. Quick Start Guide
    }

    for i, sec in ipairs(guide_sections) do
        local is_job = (sec.is_job == true)
        local hdr_cont_name = is_job and "guide_job_header_container" or "guide_section_header_container"
        local hdr_bg_name   = is_job and "guide_job_header_bg" or "guide_section_header_bg"
        local hdr_lbl_name  = is_job and "guide_job_header_lbl" or "guide_section_header_lbl"

        -- Section header bar (Gold banner for major topics, sleek card for professions)
        local hdr_cont = xml:InitStatic(hdr_cont_name, nil)
        local hdr_bg   = xml:InitStatic(hdr_bg_name, hdr_cont)
        local hdr_lbl  = xml:InitTextWnd(hdr_lbl_name, hdr_cont)
        hdr_lbl:SetText(game.translate_string(sec.header))
        self.guide_scroll:AddWindow(hdr_cont, true)

        -- Section body text (indented, lighter color, multi-line complex mode)
        local body_cont = xml:InitStatic("guide_section_body_container", nil)
        local body_text = xml:InitTextWnd("guide_section_body_text", body_cont)

        -- CRITICAL X-RAY ENGINE FIX:
        -- CUITextWnd defaults to single-line mode (m_bComplexMode = false) in C++.
        -- Without SetTextComplexMode(true), CUILines ignores all newlines and collapses
        -- text into a single run-on block. SetTextComplexMode(true) enables multiline formatting.
        body_text:SetTextComplexMode(true)
        body_text:SetWndPos(vector2():set(10, 4))
        body_text:SetWndSize(vector2():set(524, 20))

        local b_text = game.translate_string(sec.body)
        if not b_text:find("\\n") and b_text:find("\n") then
            b_text = b_text:gsub("\n", "\\n")
        end
        body_text:SetText(b_text)
        body_text:AdjustHeightToText()
        local bh = body_text:GetHeight()
        body_text:SetWndSize(vector2():set(524, bh))
        body_cont:SetWndSize(vector2():set(544, bh + 14))
        self.guide_scroll:AddWindow(body_cont, true)

        -- Separator line between sections (skip after last)
        if i < #guide_sections then
            local sep_cont = xml:InitStatic("guide_separator_container", nil)
            xml:InitFrameLine("guide_separator_line", sep_cont)
            self.guide_scroll:AddWindow(sep_cont, true)
        end
    end

    -- CRITICAL: Initialize all panels to hidden except overview.
    -- Without this, all 4 panels (overview/survivors/rivals/guide) sit at the
    -- same screen coords and render overlapping until SetTab runs. SetTab runs
    -- from Reset(), but if anything delays Reset (e.g. a stalker_camp_builder
    -- nil guard firing) the user sees all 4 pages overlayed. Hiding them here
    -- guarantees a clean first paint.
    self.overview_panel:Show(true)
    self.survivors_panel:Show(false)
    self.rivals_panel:Show(false)
    self.guide_panel:Show(false)
    self.no_settlements_label:Show(false)
    self.list_header_bg:Show(false)
    self.settlement_header:Show(false)
    self.settlement_list:Show(false)
    self.rival_list:Show(false)
    self.current_tab = "overview"
end



function SettlementManagerPDA:SetTab(tab_name)
    play_pda_ui_sound([[interface\inv_open]])
    -- Defensive: do NOT bail entirely when stalker_camp_builder is nil.
    -- Bailing leaves all 4 panels (which default to visible) overlayed on
    -- the same screen coordinates. Instead, hide all detail panels and
    -- show only the guide panel as a safe fallback.
    local has_sb = (stalker_camp_builder ~= nil)
    self.current_tab = tab_name or "overview"

    -- Keep tab navigation buttons enabled
    self.btn_tab_overview:Enable(true)
    self.btn_tab_survivors:Enable(true)
    self.btn_tab_rivals:Enable(true)
    if self.btn_tab_radio then self.btn_tab_radio:Enable(true) end
    self.btn_tab_guide:Enable(true)

    -- Visually highlight the active tab button with distinct tactical theme accents
    local c_dim   = GetARGB(255, 160, 160, 160)
    local c_gold  = GetARGB(255, 238, 196, 112)
    local c_mint  = GetARGB(255, 144, 238, 144)
    local c_red   = GetARGB(255, 255, 100, 100)
    local c_blue  = GetARGB(255, 100, 200, 255)
    local c_cyan  = GetARGB(255, 128, 222, 234)

    if self.btn_tab_overview and self.btn_tab_overview:TextControl() then
        self.btn_tab_overview:TextControl():SetTextColor(self.current_tab == "overview" and c_gold or c_dim)
        self.btn_tab_overview:TextControl():SetText(self.current_tab == "overview" and "[ " .. game.translate_string("st_pda_tab_overview") .. " ]" or game.translate_string("st_pda_tab_overview"))
    end
    if self.btn_tab_survivors and self.btn_tab_survivors:TextControl() then
        self.btn_tab_survivors:TextControl():SetTextColor(self.current_tab == "survivors" and c_mint or c_dim)
        self.btn_tab_survivors:TextControl():SetText(self.current_tab == "survivors" and "[ " .. game.translate_string("st_pda_tab_survivors") .. " ]" or game.translate_string("st_pda_tab_survivors"))
    end
    if self.btn_tab_rivals and self.btn_tab_rivals:TextControl() then
        self.btn_tab_rivals:TextControl():SetTextColor(self.current_tab == "rivals" and c_red or c_dim)
        self.btn_tab_rivals:TextControl():SetText(self.current_tab == "rivals" and "[ " .. game.translate_string("st_pda_tab_rivals") .. " ]" or game.translate_string("st_pda_tab_rivals"))
    end
    if self.btn_tab_radio and self.btn_tab_radio:TextControl() then
        self.btn_tab_radio:TextControl():SetTextColor(self.current_tab == "radio" and c_blue or c_dim)
        self.btn_tab_radio:TextControl():SetText(self.current_tab == "radio" and "[ " .. game.translate_string("st_pda_tab_radio") .. " ]" or game.translate_string("st_pda_tab_radio"))
    end
        -- Dynamic tab textures
    if self.btn_tab_overview and self.btn_tab_overview.InitTexture then
        self.btn_tab_overview:InitTexture(self.current_tab == "overview" and "ui_homestead_tab_active" or "ui_homestead_tab_inactive")
    end
    if self.btn_tab_survivors and self.btn_tab_survivors.InitTexture then
        self.btn_tab_survivors:InitTexture(self.current_tab == "survivors" and "ui_homestead_tab_active" or "ui_homestead_tab_inactive")
    end
    if self.btn_tab_rivals and self.btn_tab_rivals.InitTexture then
        self.btn_tab_rivals:InitTexture(self.current_tab == "rivals" and "ui_homestead_tab_active" or "ui_homestead_tab_inactive")
    end
    if self.btn_tab_radio and self.btn_tab_radio.InitTexture then
        self.btn_tab_radio:InitTexture(self.current_tab == "radio" and "ui_homestead_tab_active" or "ui_homestead_tab_inactive")
    end
    if self.btn_tab_guide and self.btn_tab_guide.InitTexture then
        self.btn_tab_guide:InitTexture(self.current_tab == "guide" and "ui_homestead_tab_active" or "ui_homestead_tab_inactive")
    end

    if self.btn_tab_guide and self.btn_tab_guide:TextControl() then
        self.btn_tab_guide:TextControl():SetTextColor(self.current_tab == "guide" and c_cyan or c_dim)
        self.btn_tab_guide:TextControl():SetText(self.current_tab == "guide" and "[ " .. game.translate_string("st_pda_tab_guide") .. " ]" or game.translate_string("st_pda_tab_guide"))
    end

    -- STEP 1: Hide ALL panels unconditionally.
    self.overview_panel:Show(false)
    self.survivors_panel:Show(false)
    self.rivals_panel:Show(false)
    if self.radio_panel then self.radio_panel:Show(false) end
    self.guide_panel:Show(false)
    self.no_settlements_label:Show(false)
    self.list_header_bg:Show(false)
    self.settlement_header:Show(false)
    self.settlement_list:Show(false)
    self.rival_list:Show(false)

    -- STEP 2: Fallback if stalker_camp_builder is unavailable
    if not has_sb then
        self.guide_panel:Show(self.current_tab == "guide" or self.current_tab == "overview")
        return
    end

    -- Check active camps count
    local active_camps = stalker_camp_builder.active_camps or {}
    local count = 0
    for _, _ in pairs(active_camps) do
        count = count + 1
    end

    local show_list_header = false
    local show_settlement_list = false
    local show_rival_list = false

    if count == 0 then
        if self.no_settlements_label and self.no_settlements_label.SetText then
            self.no_settlements_label:SetText(game.translate_string("st_pda_no_settlements"))
        end
        self.no_settlements_label:Show(self.current_tab == "overview" or self.current_tab == "survivors")

        show_list_header = (self.current_tab == "rivals")
        show_rival_list = (self.current_tab == "rivals")

        self.rivals_panel:Show(self.current_tab == "rivals")
        if self.radio_panel then self.radio_panel:Show(self.current_tab == "radio") end
        self.guide_panel:Show(self.current_tab == "guide")
    else
        self.no_settlements_label:Show(false)

        show_list_header = (self.current_tab == "overview" or self.current_tab == "survivors" or self.current_tab == "rivals")
        show_settlement_list = (self.current_tab == "overview" or self.current_tab == "survivors")
        show_rival_list = (self.current_tab == "rivals")

        self.overview_panel:Show(self.current_tab == "overview")
        self.survivors_panel:Show(self.current_tab == "survivors")
        self.rivals_panel:Show(self.current_tab == "rivals")
        if self.radio_panel then self.radio_panel:Show(self.current_tab == "radio") end
        self.guide_panel:Show(self.current_tab == "guide")
    end

    if self.current_tab == "radio" then
        self:PopulateRadioFeed()
    end

    self.list_header_bg:Show(show_list_header)
    self.settlement_header:Show(show_list_header)
    self.settlement_list:Show(show_settlement_list)
    self.rival_list:Show(show_rival_list)

    if show_list_header then
        if self.current_tab == "rivals" then
            self.settlement_header:SetText(game.translate_string("st_pda_rivals_title"))
        else
            self.settlement_header:SetText(game.translate_string("st_pda_settlements_title"))
        end
    end
end

function SettlementManagerPDA:UpdateTopStatusBar()
    local sformat = string.format
    local h = level and level.get_time_hours and level.get_time_hours() or 8
    local m = level and level.get_time_minutes and level.get_time_minutes() or 0
    if self.status_clock then self.status_clock:SetText(sformat("TIME: %02d:%02d", h, m)) end

    local s_item = self.settlement_list and self.settlement_list:GetSelectedItem()
    local camp = s_item and stalker_camp_builder.active_camps[s_item.hub_id]
    if self.status_camp then
        if camp then
            self.status_camp:SetText(sformat("HUB: %s", camp.name or "Settlement"))
            self.status_camp:SetTextColor(GetARGB(255, 238, 196, 112))
        else
            self.status_camp:SetText("HUB: NONE")
            self.status_camp:SetTextColor(GetARGB(255, 170, 170, 170))
        end
    end

    if self.status_signal then
        if camp and db.actor then
            local hub_obj = alife_object(s_item.hub_id)
            if hub_obj then
                -- a camp on another level has a position in that level's coordinates: it reads
                -- the relay's floor (25%)
                local dist = camp.level == level.name() and db.actor:position():distance_to(hub_obj.position) or math.huge
                if dist <= 100 then
                    self.status_signal:SetText("SIGNAL: 100% (LOCAL)")
                    self.status_signal:SetTextColor(GetARGB(255, 144, 238, 144))
                else
                    local sig_pct = math.max(25, math.floor(100 - (dist / 20)))
                    self.status_signal:SetText(sformat("SIGNAL: %d%% (RELAY)", sig_pct))
                    self.status_signal:SetTextColor(GetARGB(255, 100, 200, 255))
                end
            end
        else
            self.status_signal:SetText("SIGNAL: STANDBY")
            self.status_signal:SetTextColor(GetARGB(255, 170, 170, 170))
        end
    end

    if self.status_weather and level_weathers then
        local mgr = level_weathers.get_weather_manager and level_weathers.get_weather_manager()
        local w_name = (mgr and mgr.get_weather_cycle and mgr:get_weather_cycle()) or "clear"
        local w_upper = tostring(w_name):upper()
        self.status_weather:SetText(sformat("ATMOS: %s", w_upper))
        if w_name:find("psy") or w_name:find("surge") or w_name:find("emission") or w_name:find("storm") then
            self.status_weather:SetTextColor(GetARGB(255, 255, 100, 100))
        elseif w_name:find("rain") or w_name:find("fog") or w_name:find("cloud") then
            self.status_weather:SetTextColor(GetARGB(255, 100, 200, 255))
        else
            self.status_weather:SetTextColor(GetARGB(255, 144, 238, 144))
        end
    end
end
function SettlementManagerPDA:Update()
    CUIScriptWnd.Update(self)
    -- the survivor detail changed size: re-add it so its scroll view measures it again
    -- (CUIScrollView recalculates only on AddWindow, RemoveWindow and Clear)
    if self.job_resized and self.job_scroll and self.job_content then
        self.job_resized = nil
        self.job_content:SetAutoDelete(false)
        self.job_scroll:RemoveWindow(self.job_content)
        self.job_scroll:AddWindow(self.job_content, true)
    end
    local pda_menu = ActorMenu.get_pda_menu()
    if pda_menu and pda_menu:GetTabControl() and not pda_menu:GetTabControl():IsShown() then
        pda_menu:GetTabControl():Show(true)
    end
    -- v1.1.7: live-refresh on BOTH the survivors and overview tabs -- the
    -- overview tab previously had no periodic refresh at all, so job timers
    -- froze at their last rendered value until a map change re-rendered them.
    if self.current_tab == "survivors" or self.current_tab == "overview" then
        local tg = time_global()
        if not self._last_survivors_tick or (tg - self._last_survivors_tick) >= 500 or (tg < self._last_survivors_tick) then
            self._last_survivors_tick = tg
            self:UpdateSurvivorsProgress()
        end
        if self.current_tab == "overview" then
            -- Re-render the Overview stat panels every 5 seconds.
            if not self._last_overview_tick or (tg - self._last_overview_tick) >= 5000 or (tg < self._last_overview_tick) then
                self._last_overview_tick = tg
                self:RefreshOverviewLive()
            end
        end
    end
end

-- list rebuilds select the row that was selected before (by an item field), else the first
local function selected_value(list, field)
    local it = list:GetSelectedItem()
    return it and it[field]
end

local function row_of(list, field, value)
    if value ~= nil then
        for i = 0, list:GetSize() - 1 do
            local it = list:GetItemByIndex(i)
            if it and it[field] == value then
                return i
            end
        end
    end
    return 0
end

function SettlementManagerPDA:Reset(tab_name)
    self._last_survivors_tick = 0
    self._last_overview_tick = 0
    local pda_menu = ActorMenu.get_pda_menu()
    if pda_menu and pda_menu:GetTabControl() then
        pda_menu:GetTabControl():Show(true)
    end
    local sformat = string.format
    self:UpdateTopStatusBar()
    local pairs_ = pairs
    tab_name = tab_name or "overview"
    local keep_hub = selected_value(self.settlement_list, "hub_id")
    local keep_survivor = selected_value(self.survivor_list, "survivor_id")
    local keep_rival = selected_value(self.rival_list, "smart")
    -- RemoveAll (CUIScrollView::Clear) scrolls a list back to the top: keep each list's place
    local camps_scroll = self.settlement_list:GetCurrentScrollPos()
    local rivals_scroll = self.rival_list:GetCurrentScrollPos()
    self.roster_scroll = self.survivor_list:GetCurrentScrollPos()
    -- Always clear the list boxes first -- these are safe even without
    -- stalker_camp_builder (they just stay empty).
    self.settlement_list:RemoveAll()
    self.survivor_list:RemoveAll()
    self.rival_list:RemoveAll()
    self:ClearDetails()
    self:ClearRivalDetails()

    -- If stalker_camp_builder is unavailable, skip the population logic but
    -- still call SetTab so panel visibility is properly managed (prevents
    -- the all-panels-overlayed bug).
    if not stalker_camp_builder then
        -- printf("[Homestead PDA] Reset: stalker_camp_builder is nil -- skipping population, calling SetTab only")
        self:SetTab(tab_name)
        return
    end

    -- Populate Settlements
    local active_camps = stalker_camp_builder.active_camps or {}
    local count = 0
    for hub_id, camp in pairs_(active_camps) do
        count = count + 1
        local name = camp.name
        if not name or name == "" then
            local level_name = game.translate_string(camp.level or "unknown")
            name = level_name .. " #" .. tostring(count)
        end
        local num_survivors = 0
        if camp.survivors then
            for _ in pairs_(camp.survivors) do
                num_survivors = num_survivors + 1
            end
        end
        local level_name = game.translate_string(camp.level or "unknown")
        local hub_obj = alife_object(hub_id)
        local stats = hub_obj and stalker_camp_builder.get_camp_stats(camp, hub_obj) or { population = num_survivors, beds = 0, defense = 0 }
        -- spawn_camp_raid records a raid in camp.active_raid until check_completed_raids ends it
        local is_raid = camp.active_raid ~= nil
        local spec = camp.specialization or "none"

        local badge_str
        if spec ~= "none" then
            badge_str = (is_raid and "[! ATTACK !] | " or "[SECURE] | ") .. game.translate_string("st_pda_spec_" .. spec)
        else
            badge_str = is_raid and "[! ATTACK !]" or "[SECURE]"
        end

        local details_str = sformat("%s  |  Pop: %d/%d  |  Def: %d", level_name, stats.population, stats.beds, stats.defense)
        local item = SettlementListItem(hub_id, name, badge_str, is_raid, details_str, self.xml)
        local h = item.total_item_height or 88
        self.settlement_list:SetItemHeight(h)
        self.settlement_list:AddExistingItem(item)
        item:SetWndSize(vector2():set(162, h))
        item:SetHeight(h)
    end

    -- Populate Rival Camps
    local rival_camps = stalker_camp_builder.rival_camps or {}
    local rival_count = 0
    for smart, rcamp in pairs_(rival_camps) do
        if type(rcamp) == "table" and rcamp.name then
            rival_count = rival_count + 1
            
            local faction_key = rcamp.faction
            if not faction_key then
                local squad = rcamp.squad_id and alife_object(rcamp.squad_id)
                if squad then
                    faction_key = squad.get_squad_community and squad:get_squad_community() or squad.player_id
                end
            end

            local is_hostile = false
            if rcamp.status == "unoccupied" then
                is_hostile = "unoccupied"
            elseif rcamp.status == "mutant_nest" or faction_key == "monster" then
                local actor_comm = db.actor and db.actor:character_community() or "stalker"
                is_hostile = (actor_comm ~= "greh") and "hostile" or "friendly"
            elseif not rcamp.cleared and faction_key then
                local actor_comm = db.actor and db.actor:character_community() or "stalker"
                local rel = relation_registry.community_relation(faction_key, actor_comm)
                if rel <= -1000 then
                    is_hostile = "hostile"
                end
            end

            local location_text = rcamp.level and game.translate_string(rcamp.level) or game.translate_string("unknown")
            local r_tier = rcamp.tier or 1
            local tier_names = { [1] = "Tier 1 Scout", [2] = "Tier 2 Outpost", [3] = "Tier 3 Stronghold" }
            local tier_str = tier_names[r_tier] or sformat("Tier %d", r_tier)
            local fact_name = (rcamp.status == "mutant_nest" or faction_key == "monster") and "Mutants" or (faction_key and game.translate_string(faction_key) or "Unknown")

            local badge_str = ""
            if rcamp.status == "mutant_nest" or faction_key == "monster" then
                if is_hostile == "hostile" then
                    badge_str = "[! MUTANT NEST // DANGER !]"
                else
                    badge_str = "[MUTANT SANCTUARY]"
                end
            elseif is_hostile == "hostile" then
                badge_str = sformat("[! HOSTILE // %s !]", fact_name:upper())
            elseif is_hostile == "unoccupied" then
                badge_str = "[ABANDONED CAMP]"
            else
                badge_str = sformat("[FRIENDLY // %s]", fact_name:upper())
            end

            local det_str = sformat("%s  |  %s", location_text, tier_str)
            local item = RivalListItem(smart, rcamp.name, badge_str, det_str, is_hostile, self.xml, rcamp.level)
            local h = item.total_item_height or 88
            self.rival_list:SetItemHeight(h)
            self.rival_list:AddExistingItem(item)
            item:SetWndSize(vector2():set(162, h))
            item:SetHeight(h)
        end
    end

    -- Default Selection
    if count > 0 then
        self.settlement_list:SetSelectedIndex(row_of(self.settlement_list, "hub_id", keep_hub))
        self.settlement_list:SetScrollPos(camps_scroll)
        self:OnSettlementSelected(keep_survivor)
    else
        if tab_name == "overview" then
            tab_name = "guide"
        end
    end
    if rival_count > 0 then
        self.rival_list:SetSelectedIndex(row_of(self.rival_list, "smart", keep_rival))
        self.rival_list:SetScrollPos(rivals_scroll)
        self:OnRivalSelected()
    end
    self:SetTab(tab_name)
end

function SettlementManagerPDA:ClearDetails()
    if self.overview_content then self.overview_content:Show(false) end
    self.camp_name:SetText("")
    self.camp_spec_badge:SetText("")
    if self.raid_banner_lbl then self.raid_banner_lbl:SetText("") end
    self.camp_pop:SetText("")
    if self.camp_pop_gauge then self.camp_pop_gauge:SetText("") end
    self.camp_def:SetText("")
    self.camp_def_breakdown:SetText("")
    if self.camp_threat_lvl then self.camp_threat_lvl:SetText("") end
    self.camp_water:SetText("")
    self.camp_morale:SetText("")
    self.camp_supplies:SetText("")
    self.survivor_name_txt:SetText("")
    self.survivor_rank_badge:SetText("")
    self.survivor_xp_bar:SetText("")
    self.survivor_job_txt:SetText("")
    self.survivor_pos_txt:SetText("")
    self.transfer_list:RemoveAll()
    self.job_panel:Show(false)
end

function SettlementManagerPDA:ClearRivalDetails()
    self.rival_camp_name:SetText("")
    if self.rival_camp_spec then self.rival_camp_spec:SetText("") end
    if self.rival_banner_lbl then self.rival_banner_lbl:SetText("") end
    self.rival_camp_status:SetText("")
    self.rival_camp_faction:SetText("")
    self.rival_camp_location:SetText("")
    self.rival_camp_garrison:SetText("")
    self.rival_camp_intel:SetText("")
end

function SettlementManagerPDA:OnRivalSelected()
    local sformat = string.format
    local item = self.rival_list:GetSelectedItem()
    if not item then
        self:ClearRivalDetails()
        return
    end

    local smart = item.smart
    local rcamp = stalker_camp_builder.rival_camps[smart]
    if not rcamp then
        self:ClearRivalDetails()
        return
    end

    self.rival_camp_name:SetText(rcamp.name or "")

    -- Faction Occupying and Status
    local faction_name = game.translate_string("unknown")
    local garrison_count = 0
    local faction_key = rcamp.faction
    local actor_comm = db.actor and db.actor:character_community() or "stalker"

    local is_hostile = false
    if rcamp.status == "mutant_nest" or faction_key == "monster" then
        is_hostile = (actor_comm ~= "greh")
    elseif rcamp.status == "unoccupied" then
        is_hostile = false
    elseif not rcamp.cleared then
        is_hostile = true
        if faction_key then
            local rel = relation_registry.community_relation(faction_key, actor_comm)
            is_hostile = (rel <= -1000)
        end
    end

    if rcamp.status == "unoccupied" then
        self.rival_camp_status:SetText(game.translate_string("st_pda_rival_status_unoccupied"))
        self.rival_camp_status:SetTextColor(GetARGB(255, 238, 196, 112))
        faction_name = game.translate_string("st_pda_rival_garrison_none")
        garrison_count = 0
    elseif rcamp.status == "mutant_nest" or faction_key == "monster" then
        faction_name = "Mutants"
        local squad = alife_object(rcamp.squad_id)
        if squad then
            garrison_count = pcall(function() return squad:npc_count() end) and squad:npc_count() or 0
        end
        if is_hostile then
            self.rival_camp_status:SetText("[ MUTANT INFESTATION ]")
            self.rival_camp_status:SetTextColor(GetARGB(255, 255, 100, 100))
        else
            self.rival_camp_status:SetText("[ MUTANT SANCTUARY ]")
            self.rival_camp_status:SetTextColor(GetARGB(255, 100, 255, 100))
        end
    elseif not rcamp.cleared then
        local squad = alife_object(rcamp.squad_id)
        if squad then
            garrison_count = pcall(function() return squad:npc_count() end) and squad:npc_count() or 0
            local comm = squad.get_squad_community and squad:get_squad_community() or squad.player_id
            if comm and comm ~= "" then
                faction_name = game.translate_string(comm)
                faction_key = comm
            end
        else
            faction_name = game.translate_string("unknown")
        end

        if is_hostile then
            self.rival_camp_status:SetText(game.translate_string("st_pda_settlement_rival_status_active"))
            self.rival_camp_status:SetTextColor(GetARGB(255, 255, 100, 100))
        else
            self.rival_camp_status:SetText(game.translate_string("st_pda_settlement_rival_status_friendly"))
            self.rival_camp_status:SetTextColor(GetARGB(255, 100, 255, 100))
        end
    else
        -- Cleared/Secured
        local friendly_faction = nil
        local squad = alife_object(rcamp.squad_id)
        if squad then
            garrison_count = pcall(function() return squad:npc_count() end) and squad:npc_count() or 0
            local comm = squad.get_squad_community and squad:get_squad_community() or squad.player_id
            if comm and comm ~= "" then
                friendly_faction = game.translate_string(comm)
            end
        end

        if friendly_faction then
            faction_name = friendly_faction
            self.rival_camp_status:SetText(game.translate_string("st_pda_settlement_rival_status_friendly"))
            self.rival_camp_status:SetTextColor(GetARGB(255, 100, 255, 100))
        else
            faction_name = game.translate_string("st_pda_rival_garrison_none")
            self.rival_camp_status:SetText(game.translate_string("st_pda_rival_dismantled"))
            self.rival_camp_status:SetTextColor(GetARGB(255, 170, 170, 170))
        end
    end

    self.rival_camp_faction:SetText(faction_name)
    local faction_colors = {
        dolg = GetARGB(255, 255, 80, 80), duty = GetARGB(255, 255, 80, 80),
        freedom = GetARGB(255, 80, 255, 80), svoboda = GetARGB(255, 80, 255, 80),
        killer = GetARGB(255, 80, 180, 255), mercenary = GetARGB(255, 80, 180, 255),
        stalker = GetARGB(255, 238, 196, 112), loner = GetARGB(255, 238, 196, 112),
        csky = GetARGB(255, 80, 220, 220), clear_sky = GetARGB(255, 80, 220, 220),
        ecolog = GetARGB(255, 80, 255, 255), monolith = GetARGB(255, 180, 100, 255),
        bandit = GetARGB(255, 220, 220, 220), renegade = GetARGB(255, 220, 180, 100),
        army = GetARGB(255, 160, 200, 80), military = GetARGB(255, 160, 200, 80)
    }
    local f_color = faction_key and faction_colors[faction_key:lower()] or GetARGB(255, 220, 220, 220)
    self.rival_camp_faction:SetTextColor(f_color)

    -- Location text with distance telemetry
    local location_text = rcamp.level and game.translate_string(rcamp.level) or game.translate_string("unknown")
    -- an outpost on another level has a position in that level's coordinates
    if db.actor and rcamp.squad_id and rcamp.level == level.name() then
        local squad = alife_object(rcamp.squad_id)
        if squad and squad.position then
            local dist = math.floor(db.actor:position():distance_to(squad.position))
            location_text = sformat("%s (%dm)", location_text, dist)
        end
    end
    self.rival_camp_location:SetText(location_text)

    -- Garrison strength
    if garrison_count > 0 then
        self.rival_camp_garrison:SetText(sformat(game.translate_string("st_pda_rival_garrison_count"), garrison_count))
    else
        self.rival_camp_garrison:SetText(game.translate_string("st_pda_rival_garrison_none"))
    end

    -- Intel text (Auto-Extending Card)
    local intel_key = "st_pda_rival_intel_" .. (rcamp.smart_name or smart)
    local intel_text = game.translate_string(intel_key)
    if intel_text == intel_key then
        intel_text = game.translate_string("st_pda_rival_intel_fallback")
    end
    self.rival_camp_intel:SetText(colorize_pda_text(intel_text))
    self.rival_camp_intel:AdjustHeightToText()
    local ih = math.max(114, self.rival_camp_intel:GetHeight() + 10)
    if self.rival_intel_bg then
        self.rival_intel_bg:SetWndSize(vector2():set(350, ih + 26))
    end

    -- Tactical Banner Styling & Threat Level
    local r_tier = rcamp.tier or 1
    local tier_names = { [1] = "Tier 1 Scout Camp", [2] = "Tier 2 Outpost", [3] = "Tier 3 Stronghold" }
    if self.rival_camp_spec then
        self.rival_camp_spec:SetText(tier_names[r_tier] or sformat("Tier %d Fortification", r_tier))
    end

    if rcamp.status == "unoccupied" then
        if self.rival_banner_bg then self.rival_banner_bg:InitTexture("ui_homestead_banner_neutral") end
        if self.rival_banner_lbl then
            self.rival_banner_lbl:SetText("[ ABANDONED OUTPOST // UNCLAIMED ]")
            self.rival_banner_lbl:SetTextColor(GetARGB(255, 238, 196, 112))
        end
    elseif is_hostile then
        if self.rival_banner_bg then self.rival_banner_bg:InitTexture("ui_homestead_banner_threat") end
        if self.rival_banner_lbl then
            if rcamp.status == "mutant_nest" or faction_key == "monster" then
                self.rival_banner_lbl:SetText("[ MUTANT INFESTATION // HOSTILE ]")
            else
                self.rival_banner_lbl:SetText("[ THREAT IDENTIFIED // HOSTILE ]")
            end
            self.rival_banner_lbl:SetTextColor(GetARGB(255, 255, 100, 100))
        end
    else
        if self.rival_banner_bg then self.rival_banner_bg:InitTexture("ui_homestead_banner_secure") end
        if self.rival_banner_lbl then
            if rcamp.status == "mutant_nest" or faction_key == "monster" then
                self.rival_banner_lbl:SetText("[ MUTANT SANCTUARY // PACIFIED ]")
            else
                self.rival_banner_lbl:SetText("[ ALLIED CONTROL // SECURED ]")
            end
            self.rival_banner_lbl:SetTextColor(GetARGB(255, 144, 238, 144))
        end
    end

    -- Selection highlight across rival cards
    local sel_smart = item and item.smart
    local total_rivals = self.rival_list:GetSize()
    for i = 0, total_rivals - 1 do
        local it = self.rival_list:GetItemByIndex(i)
        if it and it.SetSelected then
            it:SetSelected(sel_smart ~= nil and it.smart == sel_smart)
        end
    end

    if self.btn_rival_locate and self.btn_refresh then
        local btn_y = 212 + ih + 36
        self.btn_rival_locate:SetWndPos(vector2():set(0, btn_y))
        self.btn_refresh:SetWndPos(vector2():set(180, btn_y))
        if self.rival_content then
            self.rival_content:SetWndSize(vector2():set(350, btn_y + 40))
        end
    end
end

function SettlementManagerPDA:OnRefreshClicked()
    -- only reloads the list: update_rival_camps is the outposts' 10-second tick, and each extra
    -- call would advance their heat and event rolls
    self:Reset("rivals")
end

-- v1.1.7: renders the Overview tab's live stat panels (threat banner +
-- Modules A-D). Split out of OnSettlementSelected so the PDA can re-render
-- them periodically -- the Overview was previously a static snapshot drawn
-- once on selection, so job stats and timers appeared frozen until the
-- player changed maps/levels.
function SettlementManagerPDA:RenderOverviewStats(hub_id, camp, hub_obj)
    local mmin = math.min
    local sformat = string.format
    local stats = stalker_camp_builder.get_camp_stats(camp, hub_obj)
    local name = camp.name
    local level_name = game.translate_string(camp.level or "unknown")
    if not name or name == "" then
        name = level_name .. " Settlement"
    end

    -- 1. Tactical Header Banner
    self.camp_name:SetText(name)

    local spec = camp.specialization or "none"
    local spec_str = game.translate_string("st_pda_spec_" .. spec)
    -- region and specialization on lines of their own: on one line they overflowed 350 wide
    -- and the wrap climbed into the camp name. The defense line goes under however many
    -- lines they take.
    self.camp_spec_badge:SetText(sformat("[ REGION: %s ]\\n[ SPEC: %s ]", level_name:upper(), spec_str:upper()))
    self.camp_spec_badge:AdjustHeightToText()

    local banner_y = 22 + math.max(30, self.camp_spec_badge:GetHeight()) + 2
    local smart_hazard, smart_dist = camp.near_smart, camp.near_smart_dist
    if not smart_hazard and stalker_camp_builder.get_nearby_smart_terrain_hazard and hub_obj and hub_obj.position then
        smart_hazard, smart_dist = stalker_camp_builder.get_nearby_smart_terrain_hazard(hub_obj.position)
    end

    if self.raid_banner_bg then
        self.raid_banner_bg:SetWndPos(vector2():set(0, banner_y))
        if camp.active_raid then
            self.raid_banner_bg:InitTexture("ui_homestead_banner_threat")
        elseif smart_hazard then
            self.raid_banner_bg:InitTexture("ui_homestead_banner_threat")
        else
            self.raid_banner_bg:InitTexture("ui_homestead_banner_secure")
        end
    end

    -- Perimeter Security Status Banner
    if self.raid_banner_lbl then
        self.raid_banner_lbl:SetWndPos(vector2():set(0, banner_y + 3))
        if camp.active_raid then
            self.raid_banner_lbl:SetText("[! THREAT ALERT: SETTLEMENT UNDER ACTIVE HOSTILE ASSAULT !]")
            self.raid_banner_lbl:SetTextColor(GetARGB(255, 255, 100, 100))
        elseif smart_hazard then
            local s_disp = game.translate_string(smart_hazard)
            if not s_disp or s_disp == "" or s_disp == smart_hazard then s_disp = smart_hazard end
            self.raid_banner_lbl:SetText(sformat("[! SPAWN HAZARD: NATURAL SPAWN POINT IN PERIMETER (%s - %dm) !]", s_disp, math.floor(smart_dist or 0)))
            self.raid_banner_lbl:SetTextColor(GetARGB(255, 255, 180, 50))
        else
            self.raid_banner_lbl:SetText("[ DEFENSE STATUS: SECURE // PERIMETER INTACT ]")
            self.raid_banner_lbl:SetTextColor(GetARGB(255, 144, 238, 144))
        end
    end

    if self.btn_specialization and self.btn_specialization.TextControl and self.btn_specialization:TextControl() then
        self.btn_specialization:TextControl():SetText(sformat("Spec: %s", (tostring(spec_str):gsub("%s*%b()", ""))))
    end

    -- 2. Module A: Personnel & Habitation
    local pop_pct = math.floor(mmin(100, (stats.population / math.max(1, stats.beds)) * 100))
    local pop_gauge = make_gauge(pop_pct, 10)
    self.camp_pop:SetText(sformat("Resident Settlers: %d Stalkers   /   %d Available Bunks", stats.population, stats.beds))
    if self.camp_pop_gauge then
        local avail_beds = math.max(0, stats.beds - stats.population)
        local cap_str = avail_beds > 0 and sformat("(%d Bunks Available)", avail_beds) or "(Full Capacity)"
        self.camp_pop_gauge:SetText(sformat("Occupancy Rate: %d%%   [%s]   %s", pop_pct, pop_gauge, cap_str))
    end

    -- 3. Module B: Defense & Security Grid
    local def_cap = stalker_camp_builder.cfg and stalker_camp_builder.cfg.defense_cap or 150
    local def_pct = math.floor(mmin(100, (stats.defense / def_cap) * 100))
    local def_gauge = make_gauge(def_pct, 10)
    local def_rating_str = def_pct >= 66 and "High Defense" or (def_pct >= 33 and "Defended" or "Vulnerable")
    self.camp_def:SetText(sformat("Security Rating: %d / %d   [%s]   %d%%  (%s)", stats.defense, def_cap, def_gauge, def_pct, def_rating_str))
    self.camp_def_breakdown:SetText(sformat("Perimeter Grid: %d Barricades   |   %d Guards   |   %d Turrets", stats.barricades, stats.guards, stats.gadgets))
    if self.camp_threat_lvl then
        -- against the defense cap, as the rating above: 40% is the old 60 of the default 150
        local threat_str = camp.active_raid and "CRITICAL (Active Raid)"
            or (smart_hazard and sformat("ELEVATED (Natural Spawn Point %s inside perimeter)", tostring(smart_hazard))
            or (def_pct >= 40 and "LOW (Sector Fortified)" or "MODERATE (Standard Patrols)"))
        self.camp_threat_lvl:SetText(sformat("Threat Level: %s", threat_str))
    end

    -- 4. Module C: Logistics, Life Support & Morale
    local water_pumps_str = stats.water_pumps > 0 and sformat("%d Active Pumps (Supply: OK)", stats.water_pumps) or "0 Pumps (Water Supply LOW)"
    self.camp_water:SetText(sformat("Water Infrastructure: %s", water_pumps_str))

    local has_food, has_water = stalker_camp_builder.check_camp_chest_supplies(camp, hub_obj)
    local food_status = has_food and "Food: OK" or "Food: LOW"
    local storage_str = "Storage: N/A"
    if stalker_camp_builder.get_camp_storage_metrics then
        local u_w, m_w, t_items, pct = stalker_camp_builder.get_camp_storage_metrics(camp, hub_obj)
        storage_str = sformat("Storage: %d / %d kg (%d%% Cap)", u_w, m_w, pct)
    end
    self.camp_supplies:SetText(sformat("Provisions: %s   |   %s", food_status, storage_str))

    -- the camp's morale as get_camp_stats scores it (camp.happiness): settlers leave below 20,
    -- and the map marker warns below 40
    local morale_val = math.floor(stats.happiness or 50)
    local morale_gauge = make_gauge(morale_val, 10)
    local morale_desc = morale_val >= 75 and "High Comfort" or (morale_val >= 40 and "Standard" or "Poor Conditions")
    self.camp_morale:SetText(sformat("Settlement Morale: %d%%   [%s]   Comfort: %s", morale_val, morale_gauge, morale_desc))

    -- Clean fixed content bounds
    if self.overview_content then
        self.overview_content:Show(true)
        self.overview_content:SetWndSize(vector2():set(350, 510))
    end
end

function SettlementManagerPDA:OnSettlementSelected(keep_survivor)
    local sformat = string.format
    local item = self.settlement_list:GetSelectedItem()
    if not item then
        self:ClearDetails()
        return
    end

    local hub_id = item.hub_id
    local camp = stalker_camp_builder.active_camps[hub_id]
    if not camp then
        self:ClearDetails()
        return
    end

    local hub_obj = alife_object(hub_id)
    if not hub_obj then
        self:ClearDetails()
        return
    end

    -- Highlight selected card outline
    local sel_hub_id = item and item.hub_id
    local total_items = self.settlement_list:GetSize()
    for i = 0, total_items - 1 do
        local it = self.settlement_list:GetItemByIndex(i)
        if it and it.SetSelected then
            it:SetSelected(sel_hub_id ~= nil and it.hub_id == sel_hub_id)
        end
    end

    -- v1.1.7: live stat render (see RenderOverviewStats) -- previously the
    -- Overview was drawn once per selection and never refreshed.
    self:RenderOverviewStats(hub_id, camp, hub_obj)

    -- Update survivors list for Tab 2
    keep_survivor = keep_survivor or selected_value(self.survivor_list, "survivor_id")
    -- the same camp's roster keeps its scroll place (Reset saved it before clearing the list)
    local roster_scroll = self.roster_scroll or self.survivor_list:GetCurrentScrollPos()
    self.roster_scroll = nil
    self.survivor_list:RemoveAll()
    self.survivor_name_txt:SetText("")
    self.survivor_job_txt:SetText("")
    self.survivor_pos_txt:SetText("")
    self.transfer_list:RemoveAll()
    self.job_panel:Show(false)

    local scount = 0
    local f = self.survivor_filter or "all"

    for survivor_id, survivor in pairs(camp.survivors) do
        local is_scav = (survivor.job == "scavenge" or survivor.job == "scavenger")
        local is_exp = (is_scav and (survivor.on_expedition or (stalker_camp_builder and stalker_camp_builder.get_scavenger_expedition_for_survivor and stalker_camp_builder.get_scavenger_expedition_for_survivor(survivor, survivor_id))))
        local is_work = (survivor.job and survivor.job ~= "idle" and not is_exp)
        local is_idle = (not survivor.job or survivor.job == "idle")

        local include = (f == "all") or (f == "exp" and is_exp) or (f == "work" and is_work) or (f == "idle" and is_idle)

        if include then
            scount = scount + 1
            local sname = survivor.name or ("Survivor #" .. tostring(scount))
            local status_str, status_color = self:FormatSurvivorStatus(survivor, camp, hub_id)
            local npc_obj = level.object_by_id(survivor_id)
            if npc_obj and npc_obj.character_icon then
                survivor.icon = npc_obj:character_icon()
            end
            local icon_sec = survivor.icon or (npc_obj and npc_obj.character_icon and npc_obj:character_icon()) or "ui\\ui_noise"
            local cur_tier = survivor.tier or 0
            local tier_names = { [0] = "Novice", [1] = "Skilled", [2] = "Expert", [3] = "Master" }
            local rank_str = sformat("Tier %d (%s)", cur_tier, tier_names[cur_tier] or "Novice")
            local s_item = SurvivorListItem(survivor_id, sname, status_str, icon_sec, rank_str, self.xml)
            if status_color and s_item.status_wnd then
                s_item.status_wnd:SetTextColor(status_color)
            end
            local h = s_item.total_item_height or 80
            self.survivor_list:SetItemHeight(h)
            self.survivor_list:AddExistingItem(s_item)
            s_item:SetWndSize(vector2():set(158, h))
            s_item:SetHeight(h)
        end
    end

    if scount > 0 then
        self.survivor_list:SetSelectedIndex(row_of(self.survivor_list, "survivor_id", keep_survivor))
        if self.roster_hub == hub_id then
            self.survivor_list:SetScrollPos(roster_scroll)
        end
        self:OnSurvivorSelected()
    end
    self.roster_hub = hub_id
end

-- v1.1.7: lightweight periodic Overview re-render. Re-renders the stat
-- panels for the selected settlement WITHOUT rebuilding the survivor list,
-- so gauges, threat banner and job stats stay live on the Overview tab.
function SettlementManagerPDA:RefreshOverviewLive()
    local item = self.settlement_list and self.settlement_list:GetSelectedItem()
    local hub_id = item and item.hub_id
    local camp = hub_id and stalker_camp_builder.active_camps and stalker_camp_builder.active_camps[hub_id]
    if not camp then return end
    local hub_obj = alife_object(hub_id)
    if not hub_obj then return end
    self:RenderOverviewStats(hub_id, camp, hub_obj)
end

function SettlementManagerPDA:OnSurvivorSelected()
    local mmax = math.max
    local mfloor = math.floor
    local sformat = string.format
    local item = self.survivor_list:GetSelectedItem()
    if not item then
        self.job_panel:Show(false)
        return
    end

    local survivor_id = item.survivor_id
    local s_item = self:GetSurvivorInfo(survivor_id)
    if not s_item then
        self.job_panel:Show(false)
        return
    end

    self.job_panel:Show(true)

    -- Update Dossier Portrait with cached or live character icon
    if self.dossier_portrait then
        local npc_obj = level.object_by_id(survivor_id)
        if npc_obj and npc_obj.character_icon then
            s_item.icon = npc_obj:character_icon()
        end
        local icon_sec = s_item.icon or (npc_obj and npc_obj.character_icon and npc_obj:character_icon()) or "ui\\ui_noise"
        if icon_sec and icon_sec ~= "" then
            pcall(function() self.dossier_portrait:InitTexture(icon_sec) end)
        else
            self.dossier_portrait:InitTexture("ui\\ui_noise")
        end
    end

    local cur_tier = s_item.tier or 0
    local xp = s_item.xp or 0
    -- the ranks award_survivor_xp promotes to: one XP per completed work cycle, tiers at 10, 25
    -- and 50. Expedition XP goes into the same count and can run past the next threshold until
    -- the next cycle promotes.
    local tier_names = { [0] = "Novice", [1] = "Skilled", [2] = "Expert", [3] = "Master" }
    local tier_caps = { [0] = 10, [1] = 25, [2] = 50, [3] = 50 }
    local cur_cap = tier_caps[cur_tier] or 50
    local prev_cap = (cur_tier > 0) and (tier_caps[cur_tier - 1] or 0) or 0
    local progress_pct = (cur_tier >= 3) and 100 or mmax(0, math.min(100, math.floor(((xp - prev_cap) / mmax(1, cur_cap - prev_cap)) * 100)))

    -- 1. Survivor Name (Line 1)
    self.survivor_name_txt:SetWndPos(vector2():set(52, 4))
    self.survivor_name_txt:SetText(s_item.name or "Survivor")
    self.survivor_name_txt:AdjustHeightToText()
    local name_h = mmax(18, self.survivor_name_txt:GetHeight())

    -- 2. Survivor Level & Rank (Dedicated Line 2)
    local rank_y = 4 + name_h + 4
    self.survivor_rank_badge:SetWndPos(vector2():set(52, rank_y))
    self.survivor_rank_badge:SetText(string.format("Rank: %s (Tier %d)", tier_names[cur_tier] or "Novice", cur_tier))
    self.survivor_rank_badge:AdjustHeightToText()
    local rank_h = mmax(14, self.survivor_rank_badge:GetHeight())

    -- 3. Survivor Experience (Dedicated Line 3)
    local xp_y = rank_y + rank_h + 4
    self.survivor_xp_bar:SetWndPos(vector2():set(52, xp_y))
    local xp_gauge = make_gauge(progress_pct, 8)
    self.survivor_xp_bar:SetText(string.format("XP: %d / %d [%s] %d%%", xp, cur_cap, xp_gauge, progress_pct))
    self.survivor_xp_bar:AdjustHeightToText()
    local xp_h = mmax(14, self.survivor_xp_bar:GetHeight())

    -- Auto-scale Dossier Portrait Card Frame with generous padding
    local dossier_header_h = mmax(54, xp_y + xp_h + 8)
    if self.dossier_portrait_bg then
        self.dossier_portrait_bg:SetWndSize(vector2():set(162, dossier_header_h))
    end

    -- Job Assignment & Telemetry String
    local job = s_item.job or "idle"
    local job_lbl = game.translate_string("st_pda_settlement_job_" .. job)
    if job_lbl == "st_pda_settlement_job_" .. job then
        job_lbl = job:sub(1,1):upper() .. job:sub(2)
    end

    local si = self.settlement_list and self.settlement_list:GetSelectedItem()
    s_item.npc_id = s_item.npc_id or tonumber(survivor_id) or survivor_id
    s_item.hub_id = s_item.hub_id or (si and si.hub_id)

    local is_paused, reason_short, reason_detail = false, nil, nil
    local camp = si and stalker_camp_builder and stalker_camp_builder.active_camps and stalker_camp_builder.active_camps[si.hub_id]
    if stalker_camp_builder and stalker_camp_builder.get_job_paused_status then
        is_paused, reason_short, reason_detail = stalker_camp_builder.get_job_paused_status(s_item, camp, si and si.hub_id)
    end

    local progress = stalker_camp_builder.get_job_progress
        and stalker_camp_builder.get_job_progress(s_item, camp, si and si.hub_id) or 0
    local pct = mfloor(progress * 100)

    local job_str = game.translate_string("st_pda_settlement_assign_job") .. " " .. job_lbl
    if is_paused then
        job_str = sformat("%s: %%c[255,255,100,100][PAUSED - %s]%%c[220,220,220]", job_lbl, reason_short or "Blocked")
        self.survivor_pos_txt:SetText(sformat("Status: %s", reason_detail or "Job paused"))
    elseif job == "scavenge" then
        local exp = stalker_camp_builder.get_scavenger_expedition_for_survivor and stalker_camp_builder.get_scavenger_expedition_for_survivor(s_item, survivor_id)
        if exp then
            local current_sec = stalker_camp_builder.game_sec()
            local game_elapsed = current_sec - exp.start_sec
            local effective_elapsed = mmax(0, game_elapsed)
            local sc_pct = mfloor(math.min(100, (effective_elapsed / exp.duration) * 100))
            local rem_sec = mmax(0, exp.duration - effective_elapsed)
            local time_str = stalker_camp_builder.format_expedition_time and stalker_camp_builder.format_expedition_time(rem_sec) or sformat("%dm", mfloor(rem_sec / 60))
            local target_lvl = game.translate_string(exp.target_level or "unknown")

            if exp.is_sweep and exp.all_stashes and #exp.all_stashes > 1 then
                job_str = sformat("%s: Regional Sweep (%d Stashes in %s) - %d%% (%s remaining)", job_lbl, #exp.all_stashes, target_lvl, sc_pct, time_str)
                self.survivor_pos_txt:SetText(sformat("Status: Sweeping %d Stashes in %s", #exp.all_stashes, target_lvl))
            else
                job_str = sformat("%s: Expedition to %s (%d%% - %s remaining)", job_lbl, target_lvl, sc_pct, time_str)
                self.survivor_pos_txt:SetText(sformat("Status: En Route to Stash in %s", target_lvl))
            end
        else
            local rem_sec = stalker_camp_builder.get_job_time_remaining
                and stalker_camp_builder.get_job_time_remaining(s_item, camp, si and si.hub_id)
            if rem_sec and rem_sec > 0 then
                local mins = mfloor(rem_sec / 60)
                local secs = mfloor(rem_sec % 60)
                local time_str = mins > 0 and sformat("%dm %02ds", mins, secs) or sformat("%ds", secs)
                job_str = sformat("%s: Patrolling Camp (%d%% - %s remaining)", job_lbl, pct, time_str)
                self.survivor_pos_txt:SetText("Status: Local Area Scavenging & Perimeter Patrol")
            else
                job_str = sformat("%s (Available for Expedition)", job_lbl)
                self.survivor_pos_txt:SetText("Status: Waiting at Camp for Expedition Orders")
            end
        end
    elseif job == "hunter" then
        local rem_sec = stalker_camp_builder.get_job_time_remaining
            and stalker_camp_builder.get_job_time_remaining(s_item, camp, si and si.hub_id)

        if rem_sec and rem_sec > 0 and pct < 100 then
            local mins = mfloor(rem_sec / 60)
            local secs = mfloor(rem_sec % 60)
            local time_str = mins > 0 and sformat("%dm %02ds", mins, secs) or sformat("%ds", secs)
            job_str = sformat("%s: Tracking Mutants (%d%% - %s remaining)", job_lbl, pct, time_str)
            self.survivor_pos_txt:SetText("Status: Tracking & Field Dressing Mutants")
        elseif pct >= 100 then
            job_str = sformat("%s (%d%% - Harvest Ready)", job_lbl, pct)
            self.survivor_pos_txt:SetText("Status: Returning with Harvested Meat")
        else
            job_str = sformat("%s (%d%%)", job_lbl, pct)
            self.survivor_pos_txt:SetText("Status: Hunting Out in the Zone")
        end
    elseif job ~= "idle" then
        local rem_sec = stalker_camp_builder.get_job_time_remaining
            and stalker_camp_builder.get_job_time_remaining(s_item, camp, si and si.hub_id)

        local time_str = ""
        if rem_sec and rem_sec > 0 and pct < 100 then
            local mins = mfloor(rem_sec / 60)
            local secs = mfloor(rem_sec % 60)
            time_str = mins > 0 and sformat("%dm %02ds", mins, secs) or sformat("%ds", secs)
        end

        local boost_str = ""
        if job == "woodcutter" and s_item.has_axe then
            boost_str = " [Axe: 2x Boost]"
        elseif job == "brewer" and (s_item.has_drugkit or (camp and camp.has_drugkit)) then
            boost_str = " [Distillery Kit: 2x Boost]"
        elseif job == "scrapper" and s_item.has_tools then
            boost_str = " [Demolition Tools: 2x Boost]"
        end

        if job == "medic" then
            local order_labels = {
                auto = "Auto-Balanced",
                bandage = "Bandages",
                medkit = "AI-2 Medkits",
                kalium = "Potassium Iodide",
                akvatab = "Ibuprofen",
            }
            local ord = order_labels[s_item.medic_order or "auto"] or "Auto"
            if s_item.shortfall_reason then
                job_str = sformat("%s: [%s] (Waiting: %s)", job_lbl, ord, s_item.shortfall_reason)
                self.survivor_pos_txt:SetText(sformat("Status: Waiting for supplies (%s)", s_item.shortfall_reason))
            elseif time_str ~= "" then
                job_str = sformat("%s: [%s] (%d%% - %s remaining)", job_lbl, ord, pct, time_str)
            elseif pct >= 100 then
                job_str = sformat("%s: [%s] (%d%% - Ready)", job_lbl, ord, pct)
            else
                job_str = sformat("%s: [%s] (%d%%)", job_lbl, ord, pct)
            end
            if not s_item.shortfall_reason then
                self.survivor_pos_txt:SetText("Status: Synthesizing Pharmaceutical Supplies")
            end
        elseif job == "woodcutter" then
            local mode_labels = {
                auto = "Auto-Rotate",
                timber = "Timber Focus",
                charcoal = "Charcoal Focus",
            }
            local wm = mode_labels[s_item.woodcutter_mode or "auto"] or "Timber"
            if s_item.shortfall_reason then
                job_str = sformat("%s: [%s]%s (Waiting: %s)", job_lbl, wm, boost_str, s_item.shortfall_reason)
                self.survivor_pos_txt:SetText(sformat("Status: Waiting for supplies (%s)", s_item.shortfall_reason))
            elseif time_str ~= "" then
                job_str = sformat("%s: [%s]%s (%d%% - %s remaining)", job_lbl, wm, boost_str, pct, time_str)
            elseif pct >= 100 then
                job_str = sformat("%s: [%s]%s (%d%% - Harvest Ready)", job_lbl, wm, boost_str, pct)
            else
                job_str = sformat("%s: [%s]%s (%d%%)", job_lbl, wm, boost_str, pct)
            end
            if not s_item.shortfall_reason then
                self.survivor_pos_txt:SetText("Status: Logging & Processing Camp Fuel")
            end
        elseif job == "brewer" then
            if s_item.shortfall_reason then
                job_str = sformat("%s: Distilling Vodka%s (Waiting: %s)", job_lbl, boost_str, s_item.shortfall_reason)
                self.survivor_pos_txt:SetText(sformat("Status: Waiting for supplies (%s)", s_item.shortfall_reason))
            elseif time_str ~= "" then
                job_str = sformat("%s: Distilling Vodka%s (%d%% - %s remaining)", job_lbl, boost_str, pct, time_str)
            elseif pct >= 100 then
                job_str = sformat("%s: Distilling Vodka%s (%d%% - Ready)", job_lbl, boost_str, pct)
            else
                job_str = sformat("%s: Distilling Vodka%s (%d%%)", job_lbl, boost_str, pct)
            end
            if not s_item.shortfall_reason then
                self.survivor_pos_txt:SetText("Status: Fermenting & Distilling Spirits")
            end
        elseif job == "craft" then
            local craft_labels = {
                auto = "Auto-Balanced",
                pistol = "Handgun Ammo",
                shotgun = "Shotgun Shells",
                rifle_soviet = "Soviet 5.45x39",
                rifle_nato = "NATO 5.56x45",
                rifle_heavy = "Assault 7.62x39",
                sniper = "Sniper Calibers",
                turret = "Turret Rounds",
            }
            local ord = craft_labels[s_item.craft_order or "auto"] or "Auto"
            if s_item.shortfall_reason then
                job_str = sformat("%s: [%s]%s (Waiting: %s)", job_lbl, ord, boost_str, s_item.shortfall_reason)
                self.survivor_pos_txt:SetText(sformat("Status: Waiting for supplies (%s)", s_item.shortfall_reason))
            elseif time_str ~= "" then
                job_str = sformat("%s: [%s]%s (%d%% - %s remaining)", job_lbl, ord, boost_str, pct, time_str)
            elseif pct >= 100 then
                job_str = sformat("%s: [%s]%s (%d%% - Ready)", job_lbl, ord, boost_str, pct)
            else
                job_str = sformat("%s: [%s]%s (%d%%)", job_lbl, ord, boost_str, pct)
            end
            if not s_item.shortfall_reason then
                self.survivor_pos_txt:SetText("Status: Crafting Ammunition & Loading Shells")
            end
        elseif job == "scrapper" then
            if time_str ~= "" then
                job_str = sformat("%s: Salvaging Scrap%s (%d%% - %s remaining)", job_lbl, boost_str, pct, time_str)
            elseif pct >= 100 then
                job_str = sformat("%s: Salvaging Scrap%s (%d%% - Ready)", job_lbl, boost_str, pct)
            else
                job_str = sformat("%s: Salvaging Scrap%s (%d%%)", job_lbl, boost_str, pct)
            end
            self.survivor_pos_txt:SetText("Status: Stripping Metal & Hardware from Debris")
        elseif job == "electrician" then
            if time_str ~= "" then
                job_str = sformat("%s: Grid & Batteries (%d%% - %s remaining)", job_lbl, pct, time_str)
            elseif pct >= 100 then
                job_str = sformat("%s: Grid & Batteries (%d%% - Ready)", job_lbl, pct)
            else
                job_str = sformat("%s: Grid & Batteries (%d%%)", job_lbl, pct)
            end
            self.survivor_pos_txt:SetText("Status: Maintaining Lights & Recharging Batteries")
        else
            if time_str ~= "" then
                job_str = sformat("%s%s (%d%% - %s)", job_str, boost_str, pct, time_str)
            elseif pct >= 100 then
                job_str = sformat("%s%s (%d%% - Ready)", job_str, boost_str, pct)
            else
                job_str = sformat("%s%s (%d%%)", job_str, boost_str, pct)
            end
            if s_item.assigned_pos then
                self.survivor_pos_txt:SetText(game.translate_string("st_pda_position_status_custom"))
            else
                self.survivor_pos_txt:SetText(game.translate_string("st_pda_position_status_default"))
            end
        end
    else
        if s_item.assigned_pos then
            self.survivor_pos_txt:SetText(game.translate_string("st_pda_position_status_custom"))
        else
            self.survivor_pos_txt:SetText(game.translate_string("st_pda_position_status_default"))
        end
    end

    -- 4. Dynamic Auto-Extension of Telemetry Card below Dossier Header with generous breathing room
    local tele_y = dossier_header_h + 12
    if self.telemetry_header_bg then self.telemetry_header_bg:SetWndPos(vector2():set(0, tele_y)) end
    if self.telemetry_lbl then self.telemetry_lbl:SetWndPos(vector2():set(8, tele_y + 2)) end

    self.survivor_job_txt:SetWndPos(vector2():set(8, tele_y + 24))
    self.survivor_job_txt:SetText(colorize_pda_text(job_str))
    self.survivor_job_txt:AdjustHeightToText()
    local jh = mmax(34, self.survivor_job_txt:GetHeight())
    local tele_box_h = jh + 10
    if self.telemetry_bg then
        self.telemetry_bg:SetWndPos(vector2():set(0, tele_y + 18))
        self.telemetry_bg:SetWndSize(vector2():set(164, tele_box_h))
    end

    -- 5. Profession Matrix Section with Distinct Header Bar
    local job_y = tele_y + 18 + tele_box_h + 14
    if self.job_header_bg then self.job_header_bg:SetWndPos(vector2():set(0, job_y)) end
    if self.job_header_lbl then self.job_header_lbl:SetWndPos(vector2():set(8, job_y + 2)) end

    local c_active = GetARGB(255, 238, 196, 112) -- Gold active highlight
    local c_normal = GetARGB(255, 220, 220, 220) -- Slate neutral

    local job_btns = {
        idle = self.btn_job_idle,
        guard = self.btn_job_guard,
        scavenge = self.btn_job_scavenge,
        hunter = self.btn_job_hunter,
        craft = self.btn_job_craft,
        repair = self.btn_job_repair,
        cook = self.btn_job_cook,
        medic = self.btn_job_medic,
        electrician = self.btn_job_electrician,
        woodcutter = self.btn_job_woodcutter,
        brewer = self.btn_job_brewer,
        scrapper = self.btn_job_scrapper,
    }

    for jname, btn in pairs(job_btns) do
        if btn and btn.TextControl and btn:TextControl() then
            local is_active = (job == jname)
            btn:TextControl():SetTextColor(is_active and c_active or c_normal)
            local raw_lbl = game.translate_string("st_job_" .. jname .. "_btn")
            btn:TextControl():SetText(is_active and ("[ " .. raw_lbl .. " ]") or raw_lbl)
            if btn.InitTexture then
                btn:InitTexture(is_active and "ui_homestead_btn_primary" or "ui_homestead_btn_tactical")
            end
        end
    end

    local btn_start_y = job_y + 24
    if self.btn_job_idle and self.btn_job_guard then
        self.btn_job_idle:SetWndPos(vector2():set(0, btn_start_y))
        self.btn_job_guard:SetWndPos(vector2():set(84, btn_start_y))
        self.btn_job_scavenge:SetWndPos(vector2():set(0, btn_start_y + 32))
        if self.btn_job_hunter then self.btn_job_hunter:SetWndPos(vector2():set(84, btn_start_y + 32)) end
        self.btn_job_craft:SetWndPos(vector2():set(0, btn_start_y + 64))
        self.btn_job_repair:SetWndPos(vector2():set(84, btn_start_y + 64))
        self.btn_job_cook:SetWndPos(vector2():set(0, btn_start_y + 96))
        self.btn_job_medic:SetWndPos(vector2():set(84, btn_start_y + 96))
        self.btn_job_electrician:SetWndPos(vector2():set(0, btn_start_y + 128))
        if self.btn_job_woodcutter then self.btn_job_woodcutter:SetWndPos(vector2():set(84, btn_start_y + 128)) end
        if self.btn_job_brewer then self.btn_job_brewer:SetWndPos(vector2():set(0, btn_start_y + 160)) end
        if self.btn_job_scrapper then self.btn_job_scrapper:SetWndPos(vector2():set(84, btn_start_y + 160)) end
    end

    -- 6. Field Station & Tactical Orders Module
    local pos_y = btn_start_y + 196
    local has_dir = (job == "medic" or job == "woodcutter" or job == "craft")
    -- the status above the buttons can run to several lines (a paused job says why in a
    -- sentence): the buttons and everything under them go below its last line
    local st_extra = 0
    if self.survivor_pos_txt then
        self.survivor_pos_txt:AdjustHeightToText()
        st_extra = mmax(0, self.survivor_pos_txt:GetHeight() - 16)
    end
    local mod4_h = (has_dir and 144 or 118) + st_extra
    if self.pos_header_bg then self.pos_header_bg:SetWndPos(vector2():set(0, pos_y)) end
    if self.pos_header_lbl then self.pos_header_lbl:SetWndPos(vector2():set(8, pos_y + 2)) end
    if self.pos_bg then
        self.pos_bg:SetWndPos(vector2():set(0, pos_y + 18))
        self.pos_bg:SetWndSize(vector2():set(164, mod4_h))
    end
    if self.survivor_pos_txt then self.survivor_pos_txt:SetWndPos(vector2():set(4, pos_y + 22)) end
    if self.btn_position_here then
        self.btn_position_here:SetWndPos(vector2():set(6, pos_y + 42 + st_extra))
        self.btn_position_here:SetWndSize(vector2():set(152, 24))
    end
    if self.btn_position_recall then
        self.btn_position_recall:SetWndPos(vector2():set(6, pos_y + 68 + st_extra))
        self.btn_position_recall:SetWndSize(vector2():set(152, 24))
    end
    if self.btn_job_directive then
        if has_dir then
            self.btn_job_directive:Show(true)
            self.btn_job_directive:SetWndPos(vector2():set(6, pos_y + 94 + st_extra))
            self.btn_job_directive:SetWndSize(vector2():set(152, 24))
            if job == "medic" then
                local m_order = s_item.medic_order or "auto"
                local order_label = game.translate_string("st_directive_medic_" .. m_order)
                if self.btn_job_directive.TextControl and self.btn_job_directive:TextControl() then
                    self.btn_job_directive:TextControl():SetText("[ " .. order_label .. " ]")
                    self.btn_job_directive:TextControl():SetTextColor(GetARGB(255, 100, 200, 255))
                end
            elseif job == "woodcutter" then
                local w_mode = s_item.woodcutter_mode or "auto"
                -- a button's label never wraps: without its "(...)" detail, as the other themes'
                -- hs_theme.short has it
                local mode_label = (game.translate_string("st_directive_woodcutter_" .. w_mode):gsub("%s*%b()%s*$", ""))
                if self.btn_job_directive.TextControl and self.btn_job_directive:TextControl() then
                    self.btn_job_directive:TextControl():SetText("[ " .. mode_label .. " ]")
                    self.btn_job_directive:TextControl():SetTextColor(GetARGB(255, 238, 196, 112))
                end
            elseif job == "craft" then
                local c_order = s_item.craft_order or "auto"
                local order_label = (game.translate_string("st_directive_craft_" .. c_order):gsub("%s*%b()%s*$", ""))
                if self.btn_job_directive.TextControl and self.btn_job_directive:TextControl() then
                    self.btn_job_directive:TextControl():SetText("[ " .. order_label .. " ]")
                    self.btn_job_directive:TextControl():SetTextColor(GetARGB(255, 255, 180, 100))
                end
            end
        else
            self.btn_job_directive:Show(false)
        end
    end
    if self.btn_rename_survivor then
        local rename_y = (has_dir and (pos_y + 120) or (pos_y + 94)) + st_extra
        self.btn_rename_survivor:SetWndPos(vector2():set(6, rename_y))
        self.btn_rename_survivor:SetWndSize(vector2():set(152, 24))
    end

    -- 7. Remote Outpost Transfer Module
    local tr_y = pos_y + mod4_h + 30
    if self.transfer_header_bg then self.transfer_header_bg:SetWndPos(vector2():set(0, tr_y)) end
    if self.transfer_lbl then self.transfer_lbl:SetWndPos(vector2():set(8, tr_y + 2)) end
    if self.transfer_bg then
        self.transfer_bg:SetWndPos(vector2():set(0, tr_y + 18))
        self.transfer_bg:SetWndSize(vector2():set(164, 114))
    end
    if self.transfer_list then self.transfer_list:SetWndPos(vector2():set(6, tr_y + 24)) end
    if self.btn_transfer then self.btn_transfer:SetWndPos(vector2():set(6, tr_y + 98)) end

    -- 8. Banishment Emergency Directive
    local banish_y = tr_y + 140
    if self.btn_banish then self.btn_banish:SetWndPos(vector2():set(0, banish_y)) end

    -- Total Scroll View Content Bounds
    local total_h = banish_y + 40
    if self.job_content then
        self.job_content:SetWndSize(vector2():set(164, total_h))
    end
    -- what the layout made room for; RefreshJobProgress rewrites both texts later
    -- (RefitSurvivorDetail)
    self.lay_jh = jh
    self.lay_st = self.survivor_pos_txt and mmax(16, self.survivor_pos_txt:GetHeight()) or 16
    self.job_resized = true

    -- Populate transfer list with all other active camps
    self.transfer_list:RemoveAll()
    local current_hub_id = nil
    local s_list_item = self.settlement_list:GetSelectedItem()
    if s_list_item then
        current_hub_id = s_list_item.hub_id
    end

    local camp_ids = {}
    for hub_id, camp in pairs(stalker_camp_builder.active_camps) do
        camp_ids[#camp_ids+1] = hub_id
    end
    table.sort(camp_ids)

    for _, hub_id in ipairs(camp_ids) do
        if hub_id ~= current_hub_id then
            local camp = stalker_camp_builder.active_camps[hub_id]
            local label = stalker_camp_builder.get_camp_label(camp)
            local list_item = TransferCampListItem(hub_id, label)
            self.transfer_list:AddExistingItem(list_item)
        end
    end
end

function SettlementManagerPDA:GetSurvivorInfo(survivor_id)
    local s_item = self.settlement_list:GetSelectedItem()
    if not s_item then return nil end

    local camp = stalker_camp_builder.active_camps[s_item.hub_id]
    if not camp or not camp.survivors then return nil end

    return camp.survivors[survivor_id] or camp.survivors[tonumber(survivor_id)] or camp.survivors[tostring(survivor_id)]
end

function SettlementManagerPDA:AssignJob(job)
    play_pda_ui_sound([[interface\inv_slot]])
    local item = self.survivor_list:GetSelectedItem()
    if not item then return end

    local survivor_id = item.survivor_id
    stalker_camp_builder.set_survivor_job(survivor_id, job)

    -- Refresh details
    self:OnSettlementSelected()
end

function SettlementManagerPDA:OnPositionHereClicked()
    local item = self.survivor_list:GetSelectedItem()
    if not item then return end

    local survivor_id = item.survivor_id
    local ok, reason = stalker_camp_builder.set_survivor_position_to_actor(survivor_id)
    if ok then
        actor_menu.set_msg(1, game.translate_string("st_pda_position_set"), 3)
    elseif reason == "too_far" then
        actor_menu.set_msg(1, game.translate_string("st_pda_position_too_far"), 3)
    end

    -- Refresh details
    self:OnSettlementSelected()
end

function SettlementManagerPDA:OnPositionRecallClicked()
    local item = self.survivor_list:GetSelectedItem()
    if not item then return end

    local survivor_id = item.survivor_id
    local s_item = self.settlement_list:GetSelectedItem()
    local hub_id = s_item and s_item.hub_id

    stalker_camp_builder.clear_survivor_position(survivor_id)

    -- If survivor was on an expedition, cleanly cancel it and recall
    if stalker_camp_builder.recall_scavenger_expedition_by_npc then
        stalker_camp_builder.recall_scavenger_expedition_by_npc(survivor_id)
    end

    if hub_id then
        local se_npc = alife_object(survivor_id)
        if not se_npc then
            local camp = stalker_camp_builder.active_camps[hub_id]
            local surv = camp and camp.survivors and camp.survivors[survivor_id]
            if surv and stalker_camp_builder.restore_missing_settler then
                survivor_id = stalker_camp_builder.restore_missing_settler(hub_id, survivor_id, surv) or survivor_id
            end
        end
        local ok, reason = stalker_camp_builder.teleport_settler_to_camp_level(survivor_id, hub_id, true)
        if ok then
            actor_menu.set_msg(1, game.translate_string("st_pda_settler_recalled"), 3)
        else
            actor_menu.set_msg(1, string.format(game.translate_string("st_pda_recall_reason"), tostring(reason or "completed")), 3)
        end
    else
        actor_menu.set_msg(1, game.translate_string("st_pda_position_cleared"), 3)
    end

    -- Refresh details
    self:OnSettlementSelected()
end

function SettlementManagerPDA:OnJobDirectiveClicked()
    play_pda_ui_sound([[interface\inv_slot]])
    local item = self.survivor_list:GetSelectedItem()
    if not item then return end
    local survivor_id = item.survivor_id
    local s_item = self:GetSurvivorInfo(survivor_id)
    if not s_item then return end

    local job = s_item.job or "idle"
    if job == "medic" then
        local cur = s_item.medic_order or "auto"
        local cycle = { auto = "bandage", bandage = "medkit", medkit = "kalium", kalium = "akvatab", akvatab = "auto" }
        local next_order = cycle[cur] or "auto"
        s_item.medic_order = next_order
        local order_label = game.translate_string("st_directive_medic_" .. next_order)
        actor_menu.set_msg(1, string.format(game.translate_string("st_pda_medic_directive"), order_label), 3)
    elseif job == "woodcutter" then
        local cur = s_item.woodcutter_mode or "auto"
        local cycle = { auto = "timber", timber = "charcoal", charcoal = "auto" }
        local next_mode = cycle[cur] or "auto"
        s_item.woodcutter_mode = next_mode
        local mode_label = game.translate_string("st_directive_woodcutter_" .. next_mode)
        actor_menu.set_msg(1, string.format(game.translate_string("st_pda_woodcutter_mode"), mode_label), 3)
    elseif job == "craft" then
        local cur = s_item.craft_order or "auto"
        local cycle = {
            auto = "pistol",
            pistol = "shotgun",
            shotgun = "rifle_soviet",
            rifle_soviet = "rifle_nato",
            rifle_nato = "rifle_heavy",
            rifle_heavy = "sniper",
            sniper = "turret",
            turret = "auto"
        }
        local next_order = cycle[cur] or "auto"
        s_item.craft_order = next_order
        local order_label = game.translate_string("st_directive_craft_" .. next_order)
        actor_menu.set_msg(1, string.format(game.translate_string("st_pda_crafter_directive"), order_label), 3)
    end
    self:OnSurvivorSelected()
end

function SettlementManagerPDA:OnTransferClicked()
    local survivor_item = self.survivor_list:GetSelectedItem()
    if not survivor_item then return end

    local target_item = self.transfer_list:GetSelectedItem()
    if not target_item then return end

    local survivor_id = survivor_item.survivor_id
    local target_hub_id = target_item.hub_id

    local ok, reason = stalker_camp_builder.transfer_survivor_to_camp(survivor_id, target_hub_id)
    if not ok and reason == "full" then
        actor_menu.set_msg(1, game.translate_string("st_pda_transfer_full"), 3)
    end

    -- Refresh details
    self:OnSettlementSelected()
end

local RENAME_CAMP_GUI = nil
function SettlementManagerPDA:OnRenameClicked()
    local item = self.settlement_list:GetSelectedItem()
    if not item then return end

    local hub_id = item.hub_id
    local camp = stalker_camp_builder.active_camps[hub_id]
    if not camp then return end

    local name = camp.name
    if not name or name == "" then
        local level_name = game.translate_string(camp.level or "unknown")
        name = level_name .. " Settlement"
    end

    RENAME_CAMP_GUI = UIRenameCamp(self, hub_id, name)
    RENAME_CAMP_GUI:ShowDialog(true)
end

-- Cycle through camp specialization types: none -> outpost -> farm -> workshop -> hideout -> clinic -> none
function SettlementManagerPDA:OnCycleSpecialization()
    if not stalker_camp_builder or not stalker_camp_builder.cycle_specialization then return end
    local item = self.settlement_list:GetSelectedItem()
    if not item then return end
    stalker_camp_builder.cycle_specialization(item.hub_id)
    self:OnSettlementSelected()  -- refresh detail panel
end

-- Fast-travel to the selected camp. Deducts RU cost (configurable via MCM).
function SettlementManagerPDA:OnFastTravelClicked()
    if not stalker_camp_builder or not stalker_camp_builder.fast_travel_to_camp then return end
    local item = self.settlement_list:GetSelectedItem()
    if not item then return end
    local cost = stalker_camp_builder.cfg and stalker_camp_builder.cfg.fast_travel_cost or 2000
    local ok, reason = stalker_camp_builder.fast_travel_to_camp(item.hub_id, cost)
    if not ok then
        if reason == "insufficient_funds" then
            actor_menu.set_msg(1, string.format(game.translate_string("st_fast_travel_need_ru"), cost), 3)
        elseif reason == "same_level" then
            actor_menu.set_msg(1, game.translate_string("st_fast_travel_same_level"), 3)
        elseif reason == "in_combat" then
            actor_menu.set_msg(1, game.translate_string("st_fast_travel_in_combat"), 3)
        elseif reason == "no_hub" then
            actor_menu.set_msg(1, game.translate_string("st_fast_travel_no_hub"), 3)
        elseif reason == "cross_level_unsupported" then
            actor_menu.set_msg(1, game.translate_string("st_fast_travel_cross_level"), 3)
        else
            actor_menu.set_msg(1, string.format(game.translate_string("st_pda_fast_travel_failed"), tostring(reason)), 3)
        end
    else
        close_pda()
    end
end

-- Summon a trade caravan to the selected camp. Costs nothing but has a cooldown.
function SettlementManagerPDA:OnSummonCaravanClicked()
    if not stalker_camp_builder or not stalker_camp_builder.summon_caravan then return end
    local item = self.settlement_list:GetSelectedItem()
    if not item then return end
    local ok, reason = stalker_camp_builder.summon_caravan(item.hub_id)
    if not ok then
        if reason == "cooldown" then
            actor_menu.set_msg(1, game.translate_string("st_caravan_cooldown"), 3)
        elseif reason == "trader_present" then
            actor_menu.set_msg(1, game.translate_string("st_caravan_present"), 3)
        elseif reason == "spawn_failed" then
            actor_menu.set_msg(1, game.translate_string("st_caravan_spawn_failed"), 3)
        else
            actor_menu.set_msg(1, string.format(game.translate_string("st_pda_caravan_failed"), tostring(reason)), 3)
        end
    else
        actor_menu.set_msg(1, game.translate_string("st_caravan_summoned"), 3)
    end
end

-- Dismantle the selected camp. Releases hub, furniture, and dismisses survivors.
function SettlementManagerPDA:OnDismantleClicked()
    if not stalker_camp_builder or not stalker_camp_builder.dismantle_camp then return end
    local item = self.settlement_list:GetSelectedItem()
    if not item then return end
    -- the list selects its first camp after a dismantle, and a double-click is two clicks
    -- (CUIButton): a second click this soon would dismantle that camp too
    local now = time_global()
    if self.dismantle_tg and now - self.dismantle_tg < 1000 then return end
    self.dismantle_tg = now
    local ok, reason = stalker_camp_builder.dismantle_camp(item.hub_id)
    if ok then
        self:Reset("overview")
    else
        actor_menu.set_msg(1, string.format(game.translate_string("st_pda_dismantle_failed"), tostring(reason)), 3)
    end
end

-- Recall all settlers to their camps. Teleports any settler whose camp is on
-- the current level to that camp. Manual fallback for cross-level travel.
function SettlementManagerPDA:OnRecallSettlersClicked()
    if not stalker_camp_builder or not stalker_camp_builder.recall_all_settlers then return end
    local s_item = self.settlement_list:GetSelectedItem()
    local hub_id = s_item and s_item.hub_id
    local count = stalker_camp_builder.recall_all_settlers(hub_id)
    if count > 0 then
        actor_menu.set_msg(1, string.format(game.translate_string("st_pda_recalled_count"), count), 4)
    else
        actor_menu.set_msg(1, game.translate_string("st_pda_all_stationed"), 4)
    end
    self:OnSettlementSelected()
end

-- Banish the selected survivor from the camp. Works whether the NPC is online or offline.
function SettlementManagerPDA:OnBanishClicked()
    local item = self.survivor_list:GetSelectedItem()
    if not item then return end
    -- as for Dismantle: the roster selects its first settler after a banish
    local now = time_global()
    if self.banish_tg and now - self.banish_tg < 1000 then return end
    self.banish_tg = now
    local npc_id = item.survivor_id
    -- Find the live client object to call banish_npc
    local npc = level.object_by_id(npc_id)
    if stalker_camp_builder and stalker_camp_builder.banish_npc then
        stalker_camp_builder.banish_npc(db.actor, npc or npc_id)
    end
    -- Refresh the survivor list
    self:OnSettlementSelected()
end

local RENAME_SURVIVOR_GUI = nil
-- Rename the selected survivor. Opens a text input dialog.
function SettlementManagerPDA:OnRenameSurvivorClicked()
    local item = self.survivor_list:GetSelectedItem()
    if not item then return end
    local survivor_id = item.survivor_id
    local s_item = self:GetSurvivorInfo(survivor_id)
    if not s_item then return end

    local name = s_item.name or "Survivor"
    RENAME_SURVIVOR_GUI = UIRenameSurvivor(self, survivor_id, name)
    RENAME_SURVIVOR_GUI:ShowDialog(true)
end

function SettlementManagerPDA:FormatSurvivorStatus(survivor, camp, hub_id)
    local mmax = math.max
    local sformat = string.format
    local mfloor = math.floor
    local c_dim    = GetARGB(255, 180, 180, 180)
    local c_gold   = GetARGB(255, 238, 196, 112)
    local c_mint   = GetARGB(255, 144, 238, 144)
    local c_red    = GetARGB(255, 255, 100, 100)
    local c_blue   = GetARGB(255, 100, 200, 255)
    local c_orange = GetARGB(255, 255, 160, 60)

    if not survivor then
        return "Unknown", c_dim
    end

    local job = survivor.job or "idle"
    if job == "companion" or survivor.is_companion then
        return "[PAUSED: Companion]", c_orange
    end

    if job == "idle" then
        return "Resting", c_dim
    end

    local job_lbl = game.translate_string("st_pda_settlement_job_" .. job)
    if job_lbl == "st_pda_settlement_job_" .. job then
        job_lbl = job:sub(1,1):upper() .. job:sub(2)
    end

    local directive_tag = ""
    if job == "craft" then
        local c_order = survivor.craft_order or "auto"
        local short_labels = {
            auto = "Auto",
            pistol = "9mm/.45",
            shotgun = "12ga",
            rifle_soviet = "5.45",
            rifle_nato = "5.56",
            rifle_heavy = "7.62x39",
            sniper = "Marksman",
            turret = "Turret",
        }
        directive_tag = sformat(" [%s]", short_labels[c_order] or "Auto")
    elseif job == "medic" then
        local m_order = survivor.medic_order or "auto"
        local short_labels = {
            auto = "Auto",
            bandage = "Bandages",
            medkit = "AI-2",
            kalium = "Rad-X",
            akvatab = "Ibuprofen",
        }
        directive_tag = sformat(" [%s]", short_labels[m_order] or "Auto")
    elseif job == "woodcutter" then
        local w_mode = survivor.woodcutter_mode or "auto"
        local short_labels = {
            auto = "Auto",
            timber = "Timber",
            charcoal = "Charcoal",
        }
        directive_tag = sformat(" [%s]", short_labels[w_mode] or "Auto")
    end
    job_lbl = job_lbl .. directive_tag

    if job == "guard" then
        return sformat("%s (+Defense)", job_lbl), c_blue
    end

    -- Check paused status
    local is_paused, reason_short, reason_detail = false, nil, nil
    if stalker_camp_builder and stalker_camp_builder.get_job_paused_status then
        is_paused, reason_short, reason_detail = stalker_camp_builder.get_job_paused_status(survivor, camp, hub_id)
    end

    if is_paused then
        return sformat("%s [PAUSED: %s]", job_lbl, reason_short or "Paused"), c_red
    end

    if survivor and survivor.shortfall_reason then
        -- v1.1.7 hotfix #6: shortfall states show their reason AND the live
        -- retry countdown, so a waiting job never reads as a frozen "(Ready)".
        local wait_rem = stalker_camp_builder.get_job_time_remaining and stalker_camp_builder.get_job_time_remaining(survivor, camp, hub_id)
        if wait_rem and wait_rem > 0 then
            return sformat("%s [WAITING: %s] (%ds)", job_lbl, survivor.shortfall_reason, wait_rem), c_gold
        end
        return sformat("%s [WAITING: %s]", job_lbl, survivor.shortfall_reason), c_gold
    end

    if job == "scavenge" or job == "scavenger" then
        local exp = stalker_camp_builder and stalker_camp_builder.get_scavenger_expedition_for_survivor and stalker_camp_builder.get_scavenger_expedition_for_survivor(survivor, survivor.npc_id or survivor.id)
        if exp then
            local current_sec = stalker_camp_builder.game_sec()
            local game_elapsed = current_sec - (exp.start_sec or current_sec)
            local tf = (level and level.get_time_factor and level.get_time_factor()) or 10
            if tf <= 0 then tf = 10 end
            local effective_elapsed = mmax(0, game_elapsed)
            local dur = mmax(1, exp.duration or 1)
            local prog = mfloor(math.min(100, (effective_elapsed / dur) * 100))
            local rem_game_sec = mmax(0, dur - effective_elapsed)
            local rem_sec = mmax(0, math.floor(rem_game_sec / tf))
            local mins = mfloor(rem_sec / 60)
            local secs = mfloor(rem_sec % 60)
            if mins > 0 then
                return sformat("Expedition: %d%% (%dm %02ds)", prog, mins, secs), c_blue
            else
                return sformat("Expedition: %d%% (%ds)", prog, secs), c_blue
            end
        else
            survivor.on_expedition = nil
            local rem_sec = stalker_camp_builder and stalker_camp_builder.get_job_time_remaining and stalker_camp_builder.get_job_time_remaining(survivor, camp, hub_id)
            if rem_sec and rem_sec > 0 then
                local mins = mfloor(rem_sec / 60)
                local secs = mfloor(rem_sec % 60)
                local time_str = mins > 0 and sformat("%dm %02ds", mins, secs) or sformat("%ds", secs)
                return sformat("%s: Patrolling (%s remaining)", job_lbl, time_str), c_mint
            end
            return sformat("%s (Available for Expedition)", job_lbl), c_gold
        end
    end

    if job == "hunter" then
        local progress = 0
        local rem_sec = nil
        if stalker_camp_builder then
            if stalker_camp_builder.get_job_progress then
                progress = stalker_camp_builder.get_job_progress(survivor, camp, hub_id) or 0
            end
            if stalker_camp_builder.get_job_time_remaining then
                rem_sec = stalker_camp_builder.get_job_time_remaining(survivor, camp, hub_id)
            end
        end
        local pct = mfloor(progress * 100)
        if pct >= 100 and rem_sec ~= nil then
            return sformat("%s (Ready)", job_lbl), c_gold
        end
        if rem_sec and rem_sec > 0 then
            local mins = mfloor(rem_sec / 60)
            local secs = mfloor(rem_sec % 60)
            local time_str = mins > 0 and sformat("%dm %02ds", mins, secs) or sformat("%ds", secs)
            return sformat("%s: Tracking (%d%% - %s remaining)", job_lbl, pct, time_str), c_mint
        end
        return sformat("%s: Tracking (%d%%)", job_lbl, pct), c_mint
    end

    -- Active working job: show live countdown
    local progress = 0
    local rem_sec = nil
    if stalker_camp_builder then
        if stalker_camp_builder.get_job_progress then
            progress = stalker_camp_builder.get_job_progress(survivor, camp, hub_id) or 0
        end
        if stalker_camp_builder.get_job_time_remaining then
            rem_sec = stalker_camp_builder.get_job_time_remaining(survivor, camp, hub_id)
        end
    end

    local pct = mfloor(progress * 100)
    if pct >= 100 and rem_sec ~= nil then
        return sformat("%s (Ready)", job_lbl), c_gold
    end

    if rem_sec and rem_sec > 0 then
        local mins = mfloor(rem_sec / 60)
        local secs = mfloor(rem_sec % 60)
        if mins > 0 then
            return sformat("%s (%dm %02ds)", job_lbl, mins, secs), c_mint
        else
            return sformat("%s (%ds)", job_lbl, secs), c_mint
        end
    end

    return sformat("%s (%d%%)", job_lbl, pct), c_mint
end

function SettlementManagerPDA:UpdateSurvivorsProgress()
    local tonum = tonumber
    if not self.survivor_list or not stalker_camp_builder then return end
    local si = self.settlement_list and self.settlement_list:GetSelectedItem()
    local hub_id = si and si.hub_id
    local camp = nil
    if hub_id then
        camp = stalker_camp_builder.active_camps and stalker_camp_builder.active_camps[hub_id]
    end
    -- v1.1.7: never silently freeze. If the settlement selection was lost
    -- (or its camp vanished), resolve the camp that actually owns the
    -- visible survivor rows so the job timers keep ticking instead of
    -- sticking at their last rendered value.
    if not camp then
        local row_count = self.survivor_list and self.survivor_list:GetSize() or 0
        if row_count > 0 then
            local first = self.survivor_list:GetItemByIndex(0)
            local sid = first and first.survivor_id
            if sid then
                for hid, c in pairs(stalker_camp_builder.active_camps or {}) do
                    if c.survivors and (c.survivors[sid] or c.survivors[tonum(sid)] or c.survivors[tostring(sid)]) then
                        hub_id = hid
                        camp = c
                        break
                    end
                end
            end
        end
    end
    if not camp or not camp.survivors then return end

    local count = self.survivor_list:GetSize()
    local outgrown = false
    for i = 0, count - 1 do
        pcall(function()
            local item = self.survivor_list:GetItemByIndex(i)
            if item and item.survivor_id then
                local surv = camp.survivors[item.survivor_id] or camp.survivors[tonum(item.survivor_id)] or camp.survivors[tostring(item.survivor_id)]
                if surv then
                    surv.npc_id = surv.npc_id or tonum(item.survivor_id) or item.survivor_id
                    surv.hub_id = surv.hub_id or hub_id
                    local str, clr = self:FormatSurvivorStatus(surv, camp, hub_id)
                    if item.UpdateStatus then
                        outgrown = item:UpdateStatus(str, clr) or outgrown
                    elseif item.status_wnd then
                        item.status_wnd:SetText(str)
                        if clr then item.status_wnd:SetTextColor(clr) end
                    end
                end
            end
        end)
    end
    -- a status that outgrew its card: lay the roster out again
    if outgrown then
        self:OnSettlementSelected()
    end

    -- Also update right detail panel live
    local s_item = self.survivor_list:GetSelectedItem()
    if s_item and self.job_panel and self.job_panel:IsShown() then
        pcall(function()
            self:RefreshJobProgress(false, hub_id)
        end)
    end
end

-- Manual Refresh: forces update_camp_jobs + immediate synchronous UI update
function SettlementManagerPDA:OnManualRefresh()
    actor_menu.set_msg(1, "REFRESHING JOB PROGRESS...", 2)

    if stalker_camp_builder and stalker_camp_builder.update_camp_jobs then
        pcall(stalker_camp_builder.update_camp_jobs)
    end

    local si = self.settlement_list and self.settlement_list:GetSelectedItem()
    local hid = si and si.hub_id

    self:UpdateSurvivorsProgress()
    self:OnSurvivorSelected()
    self._last_survivors_tick = time_global()
    self._last_refresh = time_global()

    actor_menu.set_msg(1, "JOB PROGRESS UPDATED", 2)
end

-- v1.1.7: the right detail panel is measured dynamically on survivor selection;
-- when the telemetry text or custom-location note grows/shrinks during live
-- refresh, its child widgets (and its CUIScrollView content rect) must follow.
-- Runs purely off the heights the last layout saved in self.lay_jh and self.lay_st;
-- moves by the difference. Positions only: the texts stay as the refresh wrote them.
function SettlementManagerPDA:RefitSurvivorDetail()
    if not (self.lay_jh and self.lay_st and self.job_content and self.survivor_job_txt) then
        return
    end
    local under = {
        self.job_header_bg, self.job_header_lbl,
        self.btn_job_idle, self.btn_job_guard, self.btn_job_scavenge, self.btn_job_hunter,
        self.btn_job_craft, self.btn_job_repair, self.btn_job_cook, self.btn_job_medic,
        self.btn_job_electrician, self.btn_job_woodcutter, self.btn_job_brewer, self.btn_job_scrapper,
        self.pos_header_bg, self.pos_header_lbl, self.pos_bg, self.survivor_pos_txt,
        self.btn_position_here, self.btn_position_recall, self.btn_job_directive, self.btn_rename_survivor,
        self.transfer_header_bg, self.transfer_lbl, self.transfer_bg, self.transfer_list,
        self.btn_transfer, self.btn_banish,
    }
    local function shift(dy, below)
        for _, w in pairs(under) do
            if w then
                local p = w:GetWndPos()
                if p.y > below then
                    w:SetWndPos(vector2():set(p.x, p.y + dy))
                end
            end
        end
    end
    local function grow(w, dy)
        if w then
            w:SetWndSize(vector2():set(w:GetWidth(), w:GetHeight() + dy))
        end
    end
    local total = 0
    self.survivor_job_txt:AdjustHeightToText()
    local jh = math.max(34, self.survivor_job_txt:GetHeight())
    if jh ~= self.lay_jh then
        local dy = jh - self.lay_jh
        shift(dy, self.survivor_job_txt:GetWndPos().y)
        grow(self.telemetry_bg, dy)
        self.lay_jh, total = jh, total + dy
    end
    if self.survivor_pos_txt then
        self.survivor_pos_txt:AdjustHeightToText()
        local sh = math.max(16, self.survivor_pos_txt:GetHeight())
        if sh ~= self.lay_st then
            local dy = sh - self.lay_st
            shift(dy, self.survivor_pos_txt:GetWndPos().y)
            grow(self.pos_bg, dy)
            self.lay_st, total = sh, total + dy
        end
    end
    if total ~= 0 then
        grow(self.job_content, total)
        self.job_resized = true
    end
end

function SettlementManagerPDA:RefreshJobProgress(force, hub_id_override)
    local mmax = math.max
    local mfloor = math.floor
    local sformat = string.format
    if not stalker_camp_builder then return end

    if force then
        self:OnSurvivorSelected()
        return
    end

    -- Lightweight update: refresh the job text on the right panel
    local s_item = self.survivor_list and self.survivor_list:GetSelectedItem()
    if s_item and s_item.survivor_id and self.survivor_job_txt then
        local survivor_id = s_item.survivor_id
        local hub_id = hub_id_override
        if not hub_id then
            local si = self.settlement_list and self.settlement_list:GetSelectedItem()
            hub_id = si and si.hub_id
        end
        if hub_id then
            local camp = stalker_camp_builder.active_camps and stalker_camp_builder.active_camps[hub_id]
            if camp and camp.survivors then
                local survivor = camp.survivors[survivor_id] or camp.survivors[tonumber(survivor_id)] or camp.survivors[tostring(survivor_id)]
                if survivor then
                    survivor.npc_id = survivor.npc_id or tonumber(survivor_id) or survivor_id
                    survivor.hub_id = survivor.hub_id or hub_id
                    local job = survivor.job or "idle"
                    local job_label = game.translate_string("st_pda_settlement_job_" .. job)
                    if job_label == "st_pda_settlement_job_" .. job then
                        job_label = job:sub(1,1):upper() .. job:sub(2)
                    end

                    local is_paused, reason_short, reason_detail = false, nil, nil
                    if stalker_camp_builder.get_job_paused_status then
                        is_paused, reason_short, reason_detail = stalker_camp_builder.get_job_paused_status(survivor, camp, hub_id)
                    end

                    local display = ""
                    if is_paused then
                        display = sformat("%s %%c[255,255,100,100][PAUSED - %s]%%c[255,220,220,220]", job_label, reason_short or "Blocked")
                        if self.survivor_pos_txt and reason_detail then
                            self.survivor_pos_txt:SetText(sformat("Status: %s", reason_detail))
                        end
                    elseif job == "idle" then
                        display = sformat("%s", job_label)
                        if self.survivor_pos_txt then self.survivor_pos_txt:SetText("Status: Resting at Settlement Base") end
                    elseif job == "guard" then
                        display = sformat("%s (+Defense)", job_label)
                        if self.survivor_pos_txt then self.survivor_pos_txt:SetText("Status: Guarding Camp Perimeter") end
                    elseif job == "scavenge" then
                        local exp = stalker_camp_builder.get_scavenger_expedition_for_survivor and stalker_camp_builder.get_scavenger_expedition_for_survivor(survivor, survivor_id)
                        if exp then
                            local current_sec = stalker_camp_builder.game_sec()
                            local game_elapsed = current_sec - (exp.start_sec or current_sec)
                            local tf = (level and level.get_time_factor and level.get_time_factor()) or 10
                            if tf <= 0 then tf = 10 end
                            local effective_elapsed = mmax(0, game_elapsed)
                            local dur = mmax(1, exp.duration or 1)
                            local sc_pct = math.floor(math.min(100, (effective_elapsed / dur) * 100))
                            local rem_sec = mmax(0, math.floor(dur - effective_elapsed))
                            local time_str = stalker_camp_builder.format_expedition_time and stalker_camp_builder.format_expedition_time(rem_sec) or sformat("%dm", math.floor(rem_sec / (tf * 60)))
                            local target_lvl = game.translate_string(exp.target_level or "unknown")

                            if exp.is_sweep and exp.all_stashes and #exp.all_stashes > 1 then
                                display = sformat("%s: Regional Sweep (%d Stashes in %s) - %d%% (%s remaining)", job_label, #exp.all_stashes, target_lvl, sc_pct, time_str)
                                if self.survivor_pos_txt then self.survivor_pos_txt:SetText(sformat("Status: Sweeping %d Stashes in %s", #exp.all_stashes, target_lvl)) end
                            else
                                display = sformat("%s: Expedition to %s (%d%% - %s remaining)", job_label, target_lvl, sc_pct, time_str)
                                if self.survivor_pos_txt then self.survivor_pos_txt:SetText(sformat("Status: En Route to Stash in %s", target_lvl)) end
                            end
                        else
                            -- at camp the scavenger patrols on the job's cycle, as the roster row shows
                            local progress = stalker_camp_builder.get_job_progress and stalker_camp_builder.get_job_progress(survivor, camp, hub_id) or 0
                            local time_remaining = stalker_camp_builder.get_job_time_remaining and stalker_camp_builder.get_job_time_remaining(survivor, camp, hub_id) or 0
                            if time_remaining > 0 then
                                local mins = math.floor(time_remaining / 60)
                                local secs = math.floor(time_remaining % 60)
                                local time_str = mins > 0 and sformat("%dm %02ds", mins, secs) or sformat("%ds", secs)
                                display = sformat("%s: Patrolling Camp (%d%% - %s remaining)", job_label, math.floor(progress * 100), time_str)
                                if self.survivor_pos_txt then self.survivor_pos_txt:SetText("Status: Local Area Scavenging & Perimeter Patrol") end
                            else
                                display = sformat("%s (Available for Expedition)", job_label)
                                if self.survivor_pos_txt then self.survivor_pos_txt:SetText("Status: Waiting at Camp for Expedition Orders") end
                            end
                        end
                    elseif job == "hunter" then
                        local progress = stalker_camp_builder.get_job_progress and stalker_camp_builder.get_job_progress(survivor, camp, hub_id) or 0
                        local time_remaining = stalker_camp_builder.get_job_time_remaining and stalker_camp_builder.get_job_time_remaining(survivor, camp, hub_id) or 0
                        local pct = math.floor((progress or 0) * 100)
                        if time_remaining and time_remaining > 0 and pct < 100 then
                            local mins = math.floor(time_remaining / 60)
                            local secs = math.floor(time_remaining % 60)
                            local time_str = mins > 0 and sformat("%dm %02ds", mins, secs) or sformat("%ds", secs)
                            display = sformat("%s: Tracking Mutants (%d%% - %s remaining)", job_label, pct, time_str)
                            if self.survivor_pos_txt then self.survivor_pos_txt:SetText("Status: Tracking & Field Dressing Mutants") end
                        elseif pct >= 100 then
                            display = sformat("%s (%d%% - Harvest Ready)", job_label, pct)
                            if self.survivor_pos_txt then self.survivor_pos_txt:SetText("Status: Returning with Harvested Meat") end
                        else
                            display = sformat("%s (%d%%)", job_label, pct)
                            if self.survivor_pos_txt then self.survivor_pos_txt:SetText("Status: Hunting Out in the Zone") end
                        end
                    else
                        local progress = stalker_camp_builder.get_job_progress
                            and stalker_camp_builder.get_job_progress(survivor, camp, hub_id) or 0
                        local time_remaining = stalker_camp_builder.get_job_time_remaining
                            and stalker_camp_builder.get_job_time_remaining(survivor, camp, hub_id) or 0
                        local pct = math.floor((progress or 0) * 100)
                        local time_str = ""
                        if time_remaining and time_remaining > 0 and pct < 100 then
                            local mins = math.floor(time_remaining / 60)
                            local secs = math.floor(time_remaining % 60)
                            time_str = sformat(" - %dm %02ds remaining", mins, secs)
                        elseif pct >= 100 then
                            time_str = " - Ready"
                        end

                        local boost_str = ""
                        if job == "woodcutter" and survivor.has_axe then
                            boost_str = " [Axe: 2x Boost]"
                        elseif job == "brewer" and (survivor.has_drugkit or (camp and camp.has_drugkit)) then
                            boost_str = " [Distillery Kit: 2x Boost]"
                        elseif job == "scrapper" and survivor.has_tools then
                            boost_str = " [Demolition Tools: 2x Boost]"
                        end

                        if job == "medic" then
                            local order_labels = {
                                auto = "Auto-Balanced",
                                bandage = "Bandages",
                                medkit = "AI-2 Medkits",
                                kalium = "Potassium Iodide",
                                akvatab = "Ibuprofen",
                            }
                            local ord = order_labels[survivor.medic_order or "auto"] or "Auto"
                            if survivor.shortfall_reason then
                                display = sformat("%s: [%s] (Waiting: %s)", job_label, ord, survivor.shortfall_reason)
                            else
                                display = sformat("%s: [%s] (%d%%%s)", job_label, ord, pct, time_str)
                            end
                        elseif job == "woodcutter" then
                            local mode_labels = {
                                auto = "Auto-Rotate",
                                timber = "Timber Focus",
                                charcoal = "Charcoal Focus",
                            }
                            local wm = mode_labels[survivor.woodcutter_mode or "auto"] or "Timber"
                            display = sformat("%s: [%s]%s (%d%%%s)", job_label, wm, boost_str, pct, time_str)
                        elseif job == "brewer" then
                            display = sformat("%s: Distilling Vodka%s (%d%%%s)", job_label, boost_str, pct, time_str)
                        elseif job == "scrapper" then
                            display = sformat("%s: Salvaging Scrap%s (%d%%%s)", job_label, boost_str, pct, time_str)
                        elseif job == "electrician" then
                            display = sformat("%s: Grid & Batteries (%d%%%s)", job_label, pct, time_str)
                        else
                            display = sformat("%s%s (%d%%%s)", job_label, boost_str, pct, time_str)
                        end
                    end
                    self.survivor_job_txt:SetText(colorize_pda_text(display))
                end
            end
        end
    end
    self:RefitSurvivorDetail()
end

class "UIRenameCamp" (CUIScriptWnd)

function UIRenameCamp:__init(owner, hub_id, current_name) super()
    self.owner = owner
    self.hub_id = hub_id
    self.current_name = current_name
    self:InitControls()
    self:InitCallBacks()
end

function UIRenameCamp:__finalize()
end

function UIRenameCamp:InitControls()
    self:SetWndRect(Frect():set(0,0,1024,768))
    self:SetAutoDelete(true)

    local xml = CScriptXmlInit()
    xml:ParseFile("ui_stalker_camp_builder_pda.xml")

    self.dialog = xml:InitStatic("backpack", self)
    xml:InitStatic("backpack:background", self.dialog)
    self.header = xml:InitTextWnd("backpack:header", self.dialog)
    if self.header then
        self.header:SetText(game.translate_string("st_rename_settlement_title"))
    end

    self.input = xml:InitEditBox("backpack:input", self.dialog)
    if not self.input then
        return
    end
    self:Register(self.input, "fld_input")
    self.input:SetText(self.current_name or "")

    local btn = xml:Init3tButton("backpack:btn_cancel", self.dialog)
    self:Register(btn, "btn_cancel")

    btn = xml:Init3tButton("backpack:btn_ok", self.dialog)
    self:Register(btn, "btn_ok")
end

function UIRenameCamp:InitCallBacks()
    self:AddCallback("btn_ok", ui_events.BUTTON_CLICKED, self.OnAccept, self)
    self:AddCallback("btn_cancel", ui_events.BUTTON_CLICKED, self.Close, self)
end

function UIRenameCamp:OnAccept()
    if not self.input then self:Close() return end
    local name = self.input:GetText()
    if name and name ~= "" then
        pcall(function()
            stalker_camp_builder.rename_camp(self.hub_id, name)
            if self.owner and self.owner.Reset then
                self.owner:Reset()
            end
        end)
    end
    self:Close()
end

function UIRenameCamp:OnKeyboard(dik, keyboard_action)
    CUIScriptWnd.OnKeyboard(self, dik, keyboard_action)
    if keyboard_action == ui_events.WINDOW_KEY_PRESSED then
        if dik == DIK_keys.DIK_ESCAPE then
            self:Close()
        elseif dik == DIK_keys.DIK_RETURN or dik == DIK_keys.DIK_NUMPADENTER then
            self:OnAccept()
        end
    end
    return true
end

function UIRenameCamp:Close()
    if self:IsShown() then
        self:HideDialog()
    end
end

-- -- UIRenameSurvivor: text-input dialog for renaming a survivor ------------
class "UIRenameSurvivor" (CUIScriptWnd)

function UIRenameSurvivor:__init(owner, survivor_id, current_name) super()
    self.owner = owner
    self.survivor_id = survivor_id
    self.current_name = current_name
    self:InitControls()
    self:InitCallBacks()
end

function UIRenameSurvivor:__finalize()
end

function UIRenameSurvivor:InitControls()
    self:SetWndRect(Frect():set(0,0,1024,768))
    self:SetAutoDelete(true)

    local xml = CScriptXmlInit()
    xml:ParseFile("ui_stalker_camp_builder_pda.xml")

    self.dialog = xml:InitStatic("backpack", self)
    xml:InitStatic("backpack:background", self.dialog)
    self.header = xml:InitTextWnd("backpack:header", self.dialog)
    if self.header then
        self.header:SetText(game.translate_string("st_rename_survivor"))
    end

    self.input = xml:InitEditBox("backpack:input", self.dialog)
    if not self.input then
        return
    end
    self:Register(self.input, "fld_input")
    self.input:SetText(self.current_name or "")

    local btn = xml:Init3tButton("backpack:btn_cancel", self.dialog)
    self:Register(btn, "btn_cancel")

    btn = xml:Init3tButton("backpack:btn_ok", self.dialog)
    self:Register(btn, "btn_ok")
end

function UIRenameSurvivor:InitCallBacks()
    self:AddCallback("btn_ok", ui_events.BUTTON_CLICKED, self.OnAccept, self)
    self:AddCallback("btn_cancel", ui_events.BUTTON_CLICKED, self.Close, self)
end

function UIRenameSurvivor:OnAccept()
    if not self.input then self:Close() return end
    local name = self.input:GetText()
    if name and name ~= "" then
        pcall(function()
            if stalker_camp_builder and stalker_camp_builder.rename_survivor then
                stalker_camp_builder.rename_survivor(self.survivor_id, name)
            end
            if self.owner then
                if self.owner.OnSurvivorSelected then
                    self.owner:OnSurvivorSelected()
                end
                if self.owner.Reset then
                    self.owner:Reset("survivors")
                end
            end
        end)
    end
    self:Close()
end

function UIRenameSurvivor:OnKeyboard(dik, keyboard_action)
    CUIScriptWnd.OnKeyboard(self, dik, keyboard_action)
    if keyboard_action == ui_events.WINDOW_KEY_PRESSED then
        if dik == DIK_keys.DIK_ESCAPE then
            self:Close()
        elseif dik == DIK_keys.DIK_RETURN or dik == DIK_keys.DIK_NUMPADENTER then
            self:OnAccept()
        end
    end
    return true
end

function UIRenameSurvivor:Close()
    if self:IsShown() then
        self:HideDialog()
    end
end

function SettlementManagerPDA:OnAutoSortClicked()
    play_pda_ui_sound([[interface\inv_properties_2]])
    local si = self.settlement_list and self.settlement_list:GetSelectedItem()
    local hub_id = si and si.hub_id
    if not hub_id then return end
    local res, count = stalker_camp_builder.smart_dump_to_camp_storage(hub_id)
    if res then
        self:OnSettlementSelected()
        self:Reset("overview")
    end
end

function SettlementManagerPDA:PopulateSurvivorsForCamp()
    self:OnSettlementSelected()
end


-- =========================================================================
-- ROSTER FILTER & MAP LOCATE HANDLERS
-- =========================================================================
function SettlementManagerPDA:SetSurvivorFilter(filter)
    self.survivor_filter = filter or "all"
    play_pda_ui_sound([[interface\inv_slot]])

    local c_dim   = GetARGB(255, 140, 140, 140)
    local c_gold  = GetARGB(255, 238, 196, 112)
    local c_blue  = GetARGB(255, 100, 200, 255)
    local c_mint  = GetARGB(255, 144, 238, 144)
    local c_slate = GetARGB(255, 220, 220, 220)

    if self.btn_filter_all and self.btn_filter_all.TextControl and self.btn_filter_all:TextControl() then 
        self.btn_filter_all:TextControl():SetTextColor(self.survivor_filter == "all" and c_gold or c_dim) 
    end
    if self.btn_filter_exp and self.btn_filter_exp.TextControl and self.btn_filter_exp:TextControl() then 
        self.btn_filter_exp:TextControl():SetTextColor(self.survivor_filter == "exp" and c_blue or c_dim) 
    end
    if self.btn_filter_work and self.btn_filter_work.TextControl and self.btn_filter_work:TextControl() then 
        self.btn_filter_work:TextControl():SetTextColor(self.survivor_filter == "work" and c_mint or c_dim) 
    end
    if self.btn_filter_idle and self.btn_filter_idle.TextControl and self.btn_filter_idle:TextControl() then 
        self.btn_filter_idle:TextControl():SetTextColor(self.survivor_filter == "idle" and c_slate or c_dim) 
    end

    if self.btn_filter_all and self.btn_filter_all.InitTexture then
        self.btn_filter_all:InitTexture(self.survivor_filter == "all" and "ui_homestead_btn_primary" or "ui_homestead_btn_tactical")
    end
    if self.btn_filter_exp and self.btn_filter_exp.InitTexture then
        self.btn_filter_exp:InitTexture(self.survivor_filter == "exp" and "ui_homestead_btn_primary" or "ui_homestead_btn_tactical")
    end
    if self.btn_filter_work and self.btn_filter_work.InitTexture then
        self.btn_filter_work:InitTexture(self.survivor_filter == "work" and "ui_homestead_btn_primary" or "ui_homestead_btn_tactical")
    end
    if self.btn_filter_idle and self.btn_filter_idle.InitTexture then
        self.btn_filter_idle:InitTexture(self.survivor_filter == "idle" and "ui_homestead_btn_primary" or "ui_homestead_btn_tactical")
    end

    self:OnSettlementSelected()
end

function SettlementManagerPDA:OnFilterAllClicked()
    self:SetSurvivorFilter("all")
end

function SettlementManagerPDA:OnFilterExpClicked()
    self:SetSurvivorFilter("exp")
end

function SettlementManagerPDA:OnFilterWorkClicked()
    self:SetSurvivorFilter("work")
end

function SettlementManagerPDA:OnFilterIdleClicked()
    self:SetSurvivorFilter("idle")
end

function SettlementManagerPDA:OnLocateSettlementMapClicked()
    local s_item = self.settlement_list and self.settlement_list:GetSelectedItem()
    if not s_item then return end
    local hub_id = s_item.hub_id
    local camp = stalker_camp_builder.active_camps[hub_id]
    if not camp then return end

    play_pda_ui_sound([[device\pda\route_opened]])
    local pda_menu = ActorMenu and ActorMenu.get_pda_menu and ActorMenu.get_pda_menu()
    if pda_menu and pda_menu.SetActiveSubdialog then
        pda_menu:SetActiveSubdialog("eptTasks")
    end
    news_manager.send_tip(db.actor, string.format("%s: %s (%s)", game.translate_string("st_pda_located_map"), camp.name or "Settlement", game.translate_string(camp.level or "unknown")), nil, "general_stalker", 4000)
end

function SettlementManagerPDA:OnLocateRivalMapClicked()
    local item = self.rival_list and self.rival_list:GetSelectedItem()
    if not item then return end
    local smart = item.smart
    local rcamp = stalker_camp_builder.rival_camps and stalker_camp_builder.rival_camps[smart]
    if not rcamp then return end

    -- Rebuild/refresh the physical map spot from the rival camp's actual chest
    -- before switching to the Area Map.
    pcall(function()
        if stalker_camp_builder.sync_all_camp_map_spots then
            stalker_camp_builder.sync_all_camp_map_spots(true)
        end
    end)

    play_pda_ui_sound([[device\pda\route_opened]])
    local pda_menu = ActorMenu and ActorMenu.get_pda_menu and ActorMenu.get_pda_menu()
    if pda_menu and pda_menu.SetActiveSubdialog then
        pda_menu:SetActiveSubdialog("eptTasks")
    end
    news_manager.send_tip(db.actor, string.format("%s: %s (%s)", game.translate_string("st_pda_located_map"), rcamp.name or smart, game.translate_string(rcamp.level or "unknown")), nil, "general_stalker", 4000)
end


-- =========================================================================
-- =========================================================================
-- RADIO FEED HANDLERS (v1.0.3 Rebuild)
-- =========================================================================
function SettlementManagerPDA:SetRadioFilter(filter)
    self.radio_filter = filter or "all"

    local c_dim  = GetARGB(255, 140, 140, 140)
    local c_gold = GetARGB(255, 238, 196, 112)
    local c_blue = GetARGB(255, 100, 200, 255)
    local c_mint = GetARGB(255, 144, 238, 144)
    local c_red  = GetARGB(255, 255, 100, 100)

    if self.btn_radio_filter_all and self.btn_radio_filter_all:TextControl() then self.btn_radio_filter_all:TextControl():SetTextColor(self.radio_filter == "all" and c_gold or c_dim) end
    if self.btn_radio_filter_exp and self.btn_radio_filter_exp:TextControl() then self.btn_radio_filter_exp:TextControl():SetTextColor(self.radio_filter == "exp" and c_blue or c_dim) end
    if self.btn_radio_filter_work and self.btn_radio_filter_work:TextControl() then self.btn_radio_filter_work:TextControl():SetTextColor(self.radio_filter == "work" and c_mint or c_dim) end
    if self.btn_radio_filter_combat and self.btn_radio_filter_combat:TextControl() then self.btn_radio_filter_combat:TextControl():SetTextColor(self.radio_filter == "combat" and c_red or c_dim) end

    if self.btn_radio_filter_all and self.btn_radio_filter_all.InitTexture then
        self.btn_radio_filter_all:InitTexture(self.radio_filter == "all" and "ui_homestead_btn_primary" or "ui_homestead_btn_tactical")
    end
    if self.btn_radio_filter_exp and self.btn_radio_filter_exp.InitTexture then
        self.btn_radio_filter_exp:InitTexture(self.radio_filter == "exp" and "ui_homestead_btn_primary" or "ui_homestead_btn_tactical")
    end
    if self.btn_radio_filter_work and self.btn_radio_filter_work.InitTexture then
        self.btn_radio_filter_work:InitTexture(self.radio_filter == "work" and "ui_homestead_btn_primary" or "ui_homestead_btn_tactical")
    end
    if self.btn_radio_filter_combat and self.btn_radio_filter_combat.InitTexture then
        self.btn_radio_filter_combat:InitTexture(self.radio_filter == "combat" and "ui_homestead_btn_primary" or "ui_homestead_btn_tactical")
    end

    self:PopulateRadioFeed()
end

function SettlementManagerPDA:OnRadioFilterAllClicked()
    self:SetRadioFilter("all")
end

function SettlementManagerPDA:OnRadioFilterExpClicked()
    self:SetRadioFilter("exp")
end

function SettlementManagerPDA:OnRadioFilterWorkClicked()
    self:SetRadioFilter("work")
end

function SettlementManagerPDA:OnRadioFilterCombatClicked()
    self:SetRadioFilter("combat")
end

function SettlementManagerPDA:OnRadioScanClicked()
    if stalker_camp_builder and stalker_camp_builder.seed_initial_settlement_telemetry then
        stalker_camp_builder.seed_initial_settlement_telemetry(true)
    end
    self:PopulateRadioFeed()
end

function SettlementManagerPDA:OnRadioClearClicked()
    if stalker_camp_builder and stalker_camp_builder.clear_camp_radio_logs then
        stalker_camp_builder.clear_camp_radio_logs()
    end
    -- the feed seeds any log with fewer than two entries; after Clear only new reports
    -- and Scan fill it again
    self.radio_cleared = true
    self:PopulateRadioFeed()
end

function SettlementManagerPDA:PopulateRadioFeed()
    if not self.radio_scroll then return end
    self.radio_scroll:Clear()

    if stalker_camp_builder and stalker_camp_builder.seed_initial_settlement_telemetry and not self.radio_cleared then
        pcall(stalker_camp_builder.seed_initial_settlement_telemetry, false)
    end

    local logs = (stalker_camp_builder and stalker_camp_builder.radio_logs and stalker_camp_builder.radio_logs["all"]) or {}
    local f = self.radio_filter or "all"

    local shown_count = 0
    for _, log_entry in ipairs(logs) do
        if type(log_entry) == "table" then
            local cat = log_entry.category or "general"
            local include = (f == "all") or (f == "exp" and cat == "expedition") or (f == "work" and cat == "work") or (f == "combat" and cat == "combat")
            if include then
                shown_count = shown_count + 1
                
                local card_cont = self.xml:InitStatic("radio_card_container", nil)
                if card_cont then
                    local card_bg   = self.xml:InitStatic("radio_card_bg", card_cont)
                    local badge_wnd = self.xml:InitTextWnd("radio_row_badge", card_cont)
                    local time_wnd  = self.xml:InitTextWnd("radio_row_time", card_cont)
                    local text_wnd  = self.xml:InitTextWnd("radio_row_text", card_cont)
                    
                    local time_str = log_entry.time_str or "--:--"
                    if time_wnd then time_wnd:SetText(time_str) end
                    
                    local badge_txt = "[COMMUNICATION]"
                    if cat == "combat" then
                        badge_txt = "[COMBAT ALERT // DEFENSE]"
                        if badge_wnd then badge_wnd:SetTextColor(GetARGB(255, 255, 100, 100)) end
                    elseif cat == "expedition" then
                        badge_txt = "[SCAVENGER // EXPEDITION]"
                        if badge_wnd then badge_wnd:SetTextColor(GetARGB(255, 100, 200, 255)) end
                    elseif cat == "work" then
                        badge_txt = "[SETTLEMENT // LOGISTICS]"
                        if badge_wnd then badge_wnd:SetTextColor(GetARGB(255, 144, 238, 144)) end
                    else
                        badge_txt = "[RADIO TRANSCEIVER // 148.500 MHz]"
                        if badge_wnd then badge_wnd:SetTextColor(GetARGB(255, 238, 196, 112)) end
                    end
                    if badge_wnd then badge_wnd:SetText(badge_txt) end

                    if text_wnd then
                        text_wnd:SetText(colorize_pda_text(log_entry.text or ""))
                        text_wnd:AdjustHeightToText()
                        local th = text_wnd:GetHeight()
                        local card_h = math.max(44, th + 26)
                        if card_bg then card_bg:SetWndSize(vector2():set(544, card_h)) end
                        card_cont:SetWndSize(vector2():set(544, card_h + 4))
                    end
                    
                    self.radio_scroll:AddWindow(card_cont, true)
                end
            end
        end
    end

    if shown_count == 0 then
        local empty_container = self.xml:InitStatic("guide_text_container", nil)
        if empty_container then
            local empty_lbl = self.xml:InitTextWnd("guide_text_template", empty_container)
            if empty_lbl then
                empty_lbl:SetText(game.translate_string("st_pda_radio_no_logs"))
                empty_lbl:SetTextColor(GetARGB(255, 170, 170, 170))
            end
            self.radio_scroll:AddWindow(empty_container, true)
        end
    end
end
