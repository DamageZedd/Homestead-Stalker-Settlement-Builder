-- stalker_camp_builder_storage.script
-- Homestead camp storage: stash capacity and weight queries, auto-sort target selection,
-- pending item-condition restore, and deposit / smart-dump into camp storage
-- (split out of stalker_camp_builder.script).
-- Exposed on the main table: get_box_capacity, get_box_current_weight, box_has_room_for,
-- camp_has_storage_room, get_auto_sort_target_box, save_pending_cond, load_pending_cond,
-- queue_item_cond, apply_pending_cond, pending_cond_tick, start_pending_cond_timer,
-- deposit_item_to_camp, smart_dump_to_camp_storage.

local pairs_ = pairs
local ipairs_ = ipairs
local type_ = type
local mrandom = math.random

local function get_camp_containers(...) return stalker_camp_builder.get_camp_containers(...) end

-- STASH CAPACITY & WEIGHT QUERY UTILITIES (v1.2.4)
function stalker_camp_builder.get_box_capacity(box_id)
    if not box_id then return nil end
    local se = stalker_camp_builder.safe_alife_object(box_id)
    if not se then return nil end
    local sec = se:section_name()
    if not sec then return nil end
    local ini = ini_sys or sys_ini or system_ini()
    if not (ini and ini:section_exist(sec)) then return nil end
    local cap = ini:r_float_ex(sec, "capacity")
    if cap and cap > 0 then
        return cap
    end
    return nil
end

function stalker_camp_builder.get_box_current_weight(box_id)
    if not box_id then return 0 end
    local cl_box = level and level.object_by_id and level.object_by_id(box_id)
    local weight = 0
    if cl_box and cl_box.iterate_inventory_box then
        local ok = pcall(function()
            cl_box:iterate_inventory_box(function(owner, item)
                if item then
                    local w = (item.weight and item:weight()) or 0
                    weight = weight + w
                end
            end)
        end)
        if ok then return weight end
    end

    local se_box = alife_object(box_id)
    if se_box then
        local ini = ini_sys or sys_ini or system_ini()
        local camp = nil
        local sb = stalker_camp_builder
        if sb and sb.active_camps then
            for hid, c in pairs(sb.active_camps) do
                if type(c) == "table" then
                    local containers = sb.get_camp_containers and sb.get_camp_containers(hid, c)
                    if containers then
                        for _, cid in ipairs(containers) do
                            if cid == box_id then
                                camp = c
                                break
                            end
                        end
                        if camp then break end
                    elseif c.primary_chest_id == box_id or (c.structures and c.structures[box_id]) then
                        camp = c
                        break
                    end
                end
            end
        end

        sb.iterate_server_container(se_box, function(child_id, se_item)
            if se_item then
                local sec = se_item:section_name()
                local it = camp and camp.stored_items and camp.stored_items[child_id]
                if it and it.sec ~= sec then
                    it = nil
                end

                local w = nil
                if it and it.weight and it.weight > 0 then
                    w = it.weight
                else
                    local inv_w = (ini and ini:section_exist(sec) and ini:r_float_ex(sec, "inv_weight")) or 0.05
                    if it and it.uses and ini and ini:section_exist(sec) and ini:r_bool_ex(sec, "use_condition", false) then
                        local max_u = it.max_uses or ini:r_float_ex(sec, "max_uses")
                        local empty_w = ini:r_float_ex(sec, "empty_weight") or 0.0
                        if max_u and max_u > 0 and inv_w > empty_w and it.uses < max_u then
                            w = empty_w + (inv_w - empty_w) * (it.uses / max_u)
                            if it.verified then it.weight = w end
                        else
                            w = inv_w
                        end
                    else
                        w = inv_w
                    end
                end
                weight = weight + (w or 0.05)
            end
        end)
    end
    return weight
end

function stalker_camp_builder.box_has_room_for(box_id, add_weight, weight_cache)
    if not box_id then return false end
    local cap = stalker_camp_builder.get_box_capacity(box_id)
    if not cap then return true end
    local cur_w
    if weight_cache and weight_cache[box_id] ~= nil then
        cur_w = weight_cache[box_id]
    else
        cur_w = stalker_camp_builder.get_box_current_weight(box_id)
        if weight_cache then
            weight_cache[box_id] = cur_w
        end
    end
    return (cur_w + (add_weight or 0)) <= (cap + 0.001)
end

function stalker_camp_builder.camp_has_storage_room(camp, hub_id, weight)
    local sb = stalker_camp_builder
    if not camp and not hub_id then return false end
    if type(camp) ~= "table" and type(hub_id) == "table" then
        local tmp = camp
        camp = hub_id
        hub_id = tmp
    end
    if not hub_id and camp and camp.hub_id then
        hub_id = camp.hub_id
    end
    if not camp and hub_id and sb.active_camps then
        camp = sb.active_camps[hub_id]
    end
    if not camp then return false end

    local needed_w = weight or 0.1
    local checked = {}
    local weight_cache = camp._cached_box_weights

    -- Check primary chest
    if camp.primary_chest_id and stalker_camp_builder.is_valid_camp_box(camp.primary_chest_id, hub_id, camp) then
        checked[camp.primary_chest_id] = true
        if sb.box_has_room_for(camp.primary_chest_id, needed_w, weight_cache) then
            return true
        end
    end

    -- Check workshop stash
    local ws_id = hub_id and sb.linked_stash_id(hub_id)
    if ws_id then
        if not checked[ws_id] and stalker_camp_builder.is_valid_camp_box(ws_id, hub_id, camp) then
            checked[ws_id] = true
            if sb.box_has_room_for(ws_id, needed_w, weight_cache) then
                return true
            end
        end
    end

    -- Check all camp structures that are valid containers (a work station's stash for the station)
    if camp.structures then
        for struct_id, _ in pairs(camp.structures) do
            local target_id = sb.linked_stash_id(struct_id) or struct_id
            if not checked[target_id] and stalker_camp_builder.is_valid_camp_box(target_id, hub_id, camp) then
                checked[target_id] = true
                if sb.box_has_room_for(target_id, needed_w, weight_cache) then
                    return true
                end
            end
        end
    end

    return false
end

-- AUTO-SORT TARGET ROUTING & CENTRALIZED DEPOSIT SYSTEM (v1.3.0)
local function get_camp_categorized_boxes(camp, hub_id)
    local sb = stalker_camp_builder
    if camp and camp._cached_categorized_boxes and camp._cached_categorized_boxes.boxes_by_bucket then
        return camp._cached_categorized_boxes
    end

    local fridge_boxes, stove_boxes, crafter_boxes, tech_boxes, medic_boxes, weapon_boxes, armor_boxes = {}, {}, {}, {}, {}, {}, {}
    local chest_boxes, other_boxes, pantry_boxes, station_boxes = {}, {}, {}, {}
    local bucket_lists = {
        fridge = fridge_boxes, stove = stove_boxes, crafter = crafter_boxes, tech = tech_boxes,
        medic = medic_boxes, weapon = weapon_boxes, armor = armor_boxes, chest = chest_boxes,
        other = other_boxes, pantry = pantry_boxes,
    }
    local all_boxes = {}
    local seen_boxes = {}
    local any_box = nil

    local function make_box_meta(bid, sec_name)
        local sec = sec_name
        if not sec then
            local se_b = stalker_camp_builder.safe_alife_object(bid)
            sec = se_b and se_b:section_name()
        end
        local is_showcase = false
        if sec and weapon_showcase and weapon_showcase.valid_stash and weapon_showcase.valid_stash[sec] then
            is_showcase = true
        end
        local kind = sec and ini_sys and ini_sys:r_string_ex(sec, "specialized_storage")
        return { id = bid, sec = sec or "", is_showcase = is_showcase, spec_storage = kind }
    end

    local hub_obj = hub_id and stalker_camp_builder.safe_alife_object(hub_id)
    local hub_pos = hub_obj and hub_obj.position

    sb.sanitize_primary_chest(camp)
    if camp.primary_chest_id then
        if stalker_camp_builder.is_valid_camp_box(camp.primary_chest_id, hub_id, camp) then
            local meta = make_box_meta(camp.primary_chest_id)
            seen_boxes[camp.primary_chest_id] = true
            table.insert(chest_boxes, meta)
            table.insert(all_boxes, meta)
            any_box = any_box or camp.primary_chest_id
        else
            camp.primary_chest_id = nil
        end
    end

    local ws_id = hub_id and sb.linked_stash_id(hub_id)
    if ws_id then
        if not seen_boxes[ws_id] and stalker_camp_builder.is_valid_camp_box(ws_id, hub_id, camp) then
            local meta = make_box_meta(ws_id)
            seen_boxes[ws_id] = true
            table.insert(tech_boxes, meta)
            table.insert(chest_boxes, meta)
            table.insert(all_boxes, meta)
            any_box = any_box or ws_id
        end
    end

    for id, stype in pairs(camp.structures or {}) do
        local target_id = sb.linked_stash_id(id) or id
        if target_id and not seen_boxes[target_id] and stalker_camp_builder.is_valid_camp_box(target_id, hub_id, camp) then
            seen_boxes[target_id] = true
            local se = stalker_camp_builder.safe_alife_object(target_id)
            local ssec_raw = se and se:section_name() or ""
            local ssec = ssec_raw:lower()
            local meta = make_box_meta(target_id, ssec_raw)
            any_box = any_box or target_id
            table.insert(all_boxes, meta)

            -- Homestead storage names its buckets: a themed box on its own section, a work
            -- station's stash on the station's section. Station stashes also take overflow.
            local named = ini_sys and ini_sys:r_string_ex(ssec_raw, "homestead_storage_buckets")
            if not named and target_id ~= id then
                local se_station = stalker_camp_builder.safe_alife_object(id)
                named = se_station and ini_sys and ini_sys:r_string_ex(se_station:section_name(), "homestead_storage_buckets")
            end
            if ssec_raw == "station_stash" then
                table.insert(station_boxes, meta)
            end
            if named then
                local placed = false
                for bucket in string.gmatch(named, "[%w_]+") do
                    if bucket_lists[bucket] then
                        table.insert(bucket_lists[bucket], meta)
                        placed = true
                    end
                end
                if not placed and ssec_raw ~= "station_stash" then
                    table.insert(other_boxes, meta)
                end
            elseif ssec_raw == "station_stash" then
                -- a station without buckets: overflow only
            elseif ssec:find("fridge") or ssec:find("refrigerator") or ssec:find("cooler") then
                table.insert(fridge_boxes, meta)
            elseif ssec:find("stove") or ssec:find("fireplace") or ssec:find("wood_stove") or ssec:find("barrel_metal") then
                table.insert(stove_boxes, meta)
            elseif ssec:find("clinic") or ssec:find("med") then
                table.insert(medic_boxes, meta)
            elseif ssec:find("repair") or ssec:find("tool") or ssec:find("tech") or ssec:find("workshop") then
                table.insert(tech_boxes, meta)
            elseif ssec:find("gun") or ssec:find("weapon") or ssec:find("rifle") or ssec:find("armory") then
                table.insert(weapon_boxes, meta)
            elseif ssec:find("wardrobe") or ssec:find("locker") or ssec:find("armor") or ssec:find("suit") then
                table.insert(armor_boxes, meta)
            elseif (ssec:find("case") and not ssec:find("gun") and not ssec:find("weapon")) or ssec:find("sumka") or ssec:find("ammo") then
                table.insert(crafter_boxes, meta)
            elseif ssec:find("stash") or ssec:find("chest") or ssec:find("safe") or ssec:find("box_wood") or ssec:find("inv_box") or ssec:find("blue_box") then
                table.insert(chest_boxes, meta)
            else
                table.insert(other_boxes, meta)
            end
        end
    end

    if not any_box and hub_pos then
        local registry = _G.server_objects_registry
        if registry then
            for i, _ in pairs(registry) do
                if stalker_camp_builder.is_valid_camp_box(i, hub_id, camp) then
                    any_box = i
                    local meta = make_box_meta(i)
                    table.insert(chest_boxes, meta)
                    table.insert(all_boxes, meta)
                    camp.primary_chest_id = i
                    camp.structures = camp.structures or {}
                    camp.structures[i] = "stash"
                    break
                end
            end
        else
            for i = 1, 65534 do
                if stalker_camp_builder.is_valid_camp_box(i, hub_id, camp) then
                    any_box = i
                    local meta = make_box_meta(i)
                    table.insert(chest_boxes, meta)
                    table.insert(all_boxes, meta)
                    camp.primary_chest_id = i
                    camp.structures = camp.structures or {}
                    camp.structures[i] = "stash"
                    break
                end
            end
        end
    end

    if not any_box and hub_id and hub_obj and alife() then
        local new_box = alife():create("inventory_box", hub_obj.position, hub_obj.m_level_vertex_id, hub_obj.m_game_vertex_id)
        if new_box then
            camp.structures = camp.structures or {}
            camp.structures[new_box.id] = "stash"
            camp.primary_chest_id = new_box.id
            camp.camp_stash_id = new_box.id -- the camp's own box: settlement storage (is_valid_camp_box)
            any_box = new_box.id
            local meta = make_box_meta(new_box.id, "inventory_box")
            table.insert(chest_boxes, meta)
            table.insert(all_boxes, meta)
        end
    end

    local res = {
        boxes_by_bucket = {
            fridge = fridge_boxes,
            stove = stove_boxes,
            crafter = crafter_boxes,
            tech = tech_boxes,
            medic = medic_boxes,
            weapon = weapon_boxes,
            armor = armor_boxes,
            chest = chest_boxes,
            other = other_boxes,
            pantry = pantry_boxes,
            station = station_boxes,
        },
        all_boxes = all_boxes,
    }
    camp._cached_categorized_boxes = res
    return res
end
stalker_camp_builder.get_camp_categorized_boxes = get_camp_categorized_boxes

-- AUTO-SORT TARGET ROUTING & CENTRALIZED DEPOSIT SYSTEM (v1.3.0)
function stalker_camp_builder.get_auto_sort_target_box(camp, hub_id, sec_or_item, is_player_dump, item_weight, weight_cache)
    local pairs_ = pairs
    local ipairs_ = ipairs
    local type_ = type
    local sb = stalker_camp_builder
    if type_(camp) ~= "table" and type_(hub_id) == "table" then
        local tmp = camp
        camp = hub_id
        hub_id = tmp
    end
    if not camp and not hub_id then return nil end

    if not hub_id and camp and camp.hub_id then
        hub_id = camp.hub_id
    end
    if not camp and hub_id and sb.active_camps then
        camp = sb.active_camps[hub_id]
    end
    if not hub_id and camp and sb.active_camps then
        for hid, c in pairs_(sb.active_camps) do
            if c == camp then
                hub_id = hid
                camp.hub_id = hid
                break
            end
        end
    end
    if not camp then return nil end

    local sec = type_(sec_or_item) == "string" and sec_or_item or (sec_or_item and sec_or_item.section and sec_or_item:section()) or ""
    local sec_l = string.lower(sec)

    local cat = get_camp_categorized_boxes(camp, hub_id)
    if not cat then return nil end

    local function takes_item_meta(meta)
        if meta.is_showcase then return false end
        local kind = meta.spec_storage
        if not kind then return true end
        if kind == "ammo" then
            return IsItem ~= nil and IsItem("ammo", sec) ~= nil
        elseif kind == "meds" then
            return ini_sys and ini_sys:r_string_ex(sec, "kind") == "i_medical"
        elseif kind == "canned_food" then
            local canned = haru_specialized_storage_boxes and haru_specialized_storage_boxes.canned_food
            return (canned and canned[sec]) == true
        end
        return true
    end

    local function pick_box(priority_lists)
        for _, list in ipairs_(priority_lists) do
            for _, meta in ipairs_(list) do
                if takes_item_meta(meta) and sb.box_has_room_for(meta.id, item_weight, weight_cache) then
                    return meta.id
                end
            end
        end
        return nil
    end

    local b = cat.boxes_by_bucket
    local is_mutant_part = sec_l:find("mutant_part_") ~= nil
    local is_edible_mutant_meat = is_mutant_part and (sec_l:find("_meat") or sec_l:find("boar_chop") or sec_l:find("snork_hand"))

    local target_priority = nil

    if is_edible_mutant_meat or (not is_mutant_part and (sec_l:find("meat_") or sec_l:find("tushonka") or sec_l:find("conserva")
       or sec_l:find("bread") or sec_l:find("kolbasa") or sec_l:find("cheese") or sec_l:find("nuts") or sec_l:find("chocolate")
       or sec_l:find("salmon") or sec_l:find("sardina") or sec_l:find("beans") or sec_l:find("chili") or sec_l:find("snack")
       or sec_l:find("water") or sec_l:find("mineral_water") or sec_l:find("flask") or sec_l:find("vodka") or sec_l:find("beer")
       or sec_l:find("energy_drink") or sec_l:find("tea") or sec_l:find("drink_") or sec_l:find("bottle_") or sec_l:find("ration")
       or sec_l:find("mre") or sec_l:find("cereal") or sec_l:find("tomato") or sec_l:find("corn") or sec_l:find("sausage"))) then
        target_priority = { b.fridge, b.pantry, b.chest, b.other }
    elseif sec_l:find("charcoal") or sec_l:find("firewood") or sec_l:find("matches") or sec_l:find("kerosene")
       or sec_l:find("fuel") or sec_l:find("diesel") or sec_l:find("coal") or sec_l:find("igniter") or sec_l:find("prt_i_wood") then
        target_priority = { b.stove, b.chest, b.other }
    elseif sec_l:find("medkit") or sec_l:find("bandage") or sec_l:find("antirad") or sec_l:find("drug_")
       or sec_l:find("stimpack") or sec_l:find("salve") or sec_l:find("morphine") or sec_l:find("jgut")
       or sec_l:find("e_syringe") or sec_l:find("glucose") or sec_l:find("analgetic") or sec_l:find("tetanus")
       or sec_l:find("yad") or sec_l:find("antibio") or sec_l:find("splint") or sec_l:find("iod")
       or sec_l == "akvatab" or sec_l:find("ibuprofen") then
        target_priority = { b.medic, b.chest, b.other }
    elseif ((ini_sys and ini_sys:r_string_ex(sec, "ammo_class") ~= nil and not sec_l:find("knife")) or (sec_l:find("wpn_") ~= nil)) then
        target_priority = { b.weapon, b.chest, b.other }
    elseif ((ini_sys and ini_sys:r_string_ex(sec, "burn_protection") ~= nil) or sec_l:find("outfit") or sec_l:find("helmet") or sec_l:find("helm_") or sec_l:find("exo_") or sec_l:find("trenchcoat")) then
        target_priority = { b.armor, b.chest, b.other }
    elseif sec_l:find("ammo_") or sec_l:find("grenade_") or sec_l:find("gl_") or sec_l:find("vog_") then
        -- the Armory Crate first, then where ammo went before
        target_priority = { b.weapon, b.crafter, b.tech, b.chest, b.other }
    elseif sec_l:find("powder") or sec_l:find("scrap") or sec_l:find("casing") or sec_l:find("bullet")
       or sec_l:find("primer") or sec_l:find("prt_i_copper") or sec_l:find("prt_i_paper") or sec_l:find("prt_i_plastic")
       or sec_l:find("prt_i_resistor") or sec_l:find("prt_i_transist") or sec_l:find("prt_i_cond") or sec_l:find("prt_i_capacit") or sec_l:find("prt_i_microchip")
       or (is_mutant_part and not is_edible_mutant_meat) then
        target_priority = { b.crafter, b.tech, b.chest, b.other }
    elseif sec_l:find("toolkit") or sec_l:find("glue") or sec_l:find("sewing") or sec_l:find("oil") or sec_l:find("solvent")
       or sec_l:find("rasp") or sec_l:find("ramrod") or sec_l:find("prt_w_") or sec_l:find("prt_o_")
       or sec_l:find("cleaning_kit") or sec_l:find("repair_kit") or sec_l:find("upg_") or sec_l:find("lead_box") or sec_l:find("leatherman") then
        target_priority = { b.tech, b.crafter, b.chest, b.other }
    else
        target_priority = { b.chest, b.other }
    end

    local chosen = pick_box(target_priority)
    if chosen then return chosen end

    if is_player_dump then
        return nil
    end

    -- Job deposits fallback: check any remaining container with room
    -- not fridges, stoves, med cases or the armory and quartermaster boxes: they hold their own kind
    -- (see sanitize_primary_chest)
    local general_fallback = pick_box({ b.chest, b.other, b.tech, b.crafter, b.station })
    if general_fallback then return general_fallback end

    -- no box that takes the item has room: deposit_item_to_camp drops it at the hub
    return nil
end


-- DANZY EDIT: worn-condition guarantee for scavenged/crafted gear.
-- Writing condition into an offline item doesn't always stick (armour came back 100%),
-- so remember the wanted condition (saved with the game) and force it onto the
-- real item as soon as it exists: every 2s while near it, on spawn, and on pickup.
function stalker_camp_builder.save_pending_cond()
    pcall(se_save_var, 0, nil, "hs_pend_items", stalker_camp_builder.pending_item_cond)
end

function stalker_camp_builder.load_pending_cond()
    local sb = stalker_camp_builder
    local t = se_load_var(0, nil, "hs_pend_items")
    sb.pending_item_cond = (type(t) == "table") and t or {}
    if next(sb.pending_item_cond) then sb.start_pending_cond_timer() end
end

function stalker_camp_builder.queue_item_cond(id, sec, cond, parts)
    local sb = stalker_camp_builder
    sb.pending_item_cond = sb.pending_item_cond or {}
    local cur_sec = 0
    if game and game.get_game_time then
        pcall(function()
            cur_sec = stalker_camp_builder.game_sec()
        end)
    end
    sb.pending_item_cond[id] = { c = cond, s = sec, p = parts, t = cur_sec }
    sb.save_pending_cond()
    sb.start_pending_cond_timer()
end

function stalker_camp_builder.apply_pending_cond(obj)
    local sb = stalker_camp_builder
    local pend = sb.pending_item_cond
    if not (pend and obj) then return end
    local ok, id = pcall(obj.id, obj)
    if not ok or not id then return end
    local e = pend[id]
    if not e then return end
    pend[id] = nil
    sb.save_pending_cond()
    if type(e) ~= "table" then e = { c = e } end
    if e.s and obj:section() ~= e.s then return end
    pcall(function()
        if e.c and obj:condition() > e.c + 0.02 then
            obj:set_condition(e.c)
        end
        if e.p and item_parts and item_parts.set_parts_con then
            local p_data = dup_table and dup_table(e.p) or e.p
            item_parts.set_parts_con(id, p_data)
            se_save_var(id, nil, "parts", p_data)
            se_save_var(id, obj:name(), "parts", p_data)
        end
    end)
    -- uses the camp spent while the item was offline (consume_one_use); if the record
    -- overstated what was left, the rest stays
    if e.u then
        pcall(function()
            local left = obj:get_remaining_uses() - e.u
            if left >= 1 then
                obj:set_remaining_uses(left)
            end
        end)
    end
end

function stalker_camp_builder.pending_cond_tick()
    local sb = stalker_camp_builder
    pcall(function()
        local pend = sb.pending_item_cond
        if not pend then return end
        for id, data in pairs(pend) do
            local o = level.object_by_id(id)
            if o then
                sb.apply_pending_cond(o)
            else
                -- an item can wait offline in a camp box for weeks: keep its record until it comes
                -- online, unless the id no longer names it (released, or passed to another object)
                local se_obj = alife_object(id)
                if not se_obj or (type(data) == "table" and data.s and se_obj:section_name() ~= data.s) then
                    pend[id] = nil
                end
            end
        end
    end)
    if sb.pending_item_cond and next(sb.pending_item_cond) then
        ResetTimeEvent("homestead_pend_cond", "tick", 2)
        return false
    end
    sb.save_pending_cond()
    sb._pend_timer = nil
    return true
end

function stalker_camp_builder.start_pending_cond_timer()
    local sb = stalker_camp_builder
    if sb._pend_timer then return end
    sb._pend_timer = true
    CreateTimeEvent("homestead_pend_cond", "tick", 2, sb.pending_cond_tick)
end

function stalker_camp_builder.deposit_item_to_camp(hub_id, camp, sec, is_yellow, map_tier, custom_cond, custom_parts, uses)
      local sim = alife()
    local mrandom = math.random
    local type_ = type
    local sb = stalker_camp_builder
    if type_(hub_id) == "table" and type_(camp) ~= "table" then
        local tmp = hub_id
        hub_id = camp
        camp = tmp
    end

    local ini = ini_sys or sys_ini or system_ini()
    if not sec or not ini or not ini:section_exist(sec) then return nil end
    -- a section that is not an object (a postprocess or settings block) would be a fatal spawn
    if not ini:line_exist(sec, "class") then return nil end
    local item_w = (ini and ini:r_float_ex(sec, "inv_weight")) or 0.1
    -- one frame's deposits share box weights: an online box lists a new item only once the client
    -- has processed its spawn, so weighing it again would miss the items created before this one
    local tg = time_global()
    if sb._deposit_weights_tg ~= tg then
        sb._deposit_weights_tg = tg
        sb._deposit_weights = {}
    end
    local weights = sb._deposit_weights
    local target_box_id = sb.get_auto_sort_target_box(camp, hub_id, sec, false, item_w, weights)
    local box_se = target_box_id and alife_object(target_box_id)

    local drop_on_ground = false
    local ground_pos, ground_lvid, ground_gvid
    if not box_se then
        local hub_se = (hub_id and stalker_camp_builder.safe_alife_object(hub_id)) or (camp and camp.hub_id and stalker_camp_builder.safe_alife_object(camp.hub_id))
        if hub_se then
            ground_pos = hub_se.position
            ground_lvid = hub_se.m_level_vertex_id
            ground_gvid = hub_se.m_game_vertex_id
            drop_on_ground = true
        elseif camp and camp.position and camp.level_vertex_id and camp.game_vertex_id then
            ground_pos = vector():set(camp.position.x, camp.position.y, camp.position.z)
            ground_lvid = camp.level_vertex_id
            ground_gvid = camp.game_vertex_id
            drop_on_ground = true
        else
            return nil
        end
    end

    local is_wpn = false
    local is_outfit = false
    local cond = 1.0

    local has_ammo_cls = (ini:r_string_ex(sec, "ammo_class") ~= nil)
    local has_burn = (ini:r_string_ex(sec, "burn_protection") ~= nil)
    local is_knife = (sec:find("knife") ~= nil)

    if has_ammo_cls and not is_knife then
        is_wpn = true
    elseif has_burn or (sec:find("outfit") ~= nil) or (sec:find("helmet") ~= nil) or (sec:find("helm_") ~= nil) or (sec:find("exo") ~= nil) or (sec:find("trenchcoat") ~= nil) then
        is_outfit = true
    end
    if not is_outfit and IsItem then
        is_outfit = (IsItem("outfit", sec) ~= nil) or (IsItem("helmet", sec) ~= nil)
    end
    if not is_outfit then
        local kind = ini:r_string_ex(sec, "kind")
        if kind and (kind == "o_light" or kind == "o_medium" or kind == "o_heavy" or kind == "o_sci" or kind == "o_helmet") then
            is_outfit = true
        end
    end
    if not is_outfit then
        local cls = ini:r_string_ex(sec, "class")
        if cls and (cls:find("EQU_") or cls:find("E_ST") or cls:find("E_HLMET")) then
            is_outfit = true
        end
    end

    if custom_cond and type_(custom_cond) == "number" and custom_cond > 0 and custom_cond < 0.99 then
        cond = custom_cond
    else
        if is_wpn then
            if is_yellow then
                cond = (mrandom(20, 45) / 100)
            else
                cond = (mrandom(10, 35) / 100)
            end
        elseif is_outfit then
            if is_yellow then
                cond = (mrandom(15, 40) / 100)
            else
                cond = (mrandom(8, 30) / 100)
            end
        elseif (utils_item and utils_item.is_degradable and utils_item.is_degradable(nil, sec)) then
            cond = (mrandom(25, 55) / 100)
        end
    end

    local se_item = nil
    local is_degradable = is_wpn or is_outfit or (utils_item and utils_item.is_degradable and utils_item.is_degradable(nil, sec))

    if drop_on_ground then
        if alife_create then
            se_item = alife_create(sec, ground_pos, ground_lvid, ground_gvid)
        else
            se_item = sim:create(sec, ground_pos, ground_lvid, ground_gvid)
        end
    else
        -- DANZY FIX PRESERVATION & ENGINE HARDENING:
        -- Pre-registration packet condition for degradable gear:
        --   alife_create(sec, box_se.position, box_se.m_level_vertex_id, box_se.m_game_vertex_id, target_box_id, false)
        -- In X-Ray Monolith MT, creating unregistered items inside containers leaves uninitialized vtables
        -- that trigger fatal pure virtual function calls (xrDebugNew.cpp:1048) on se_item:name() and container corruption.
        -- We spawn registered items safely directly inside target_box_id and rely on queue_item_cond + item_parts.
        if alife_create_item and box_se then
            pcall(function()
                se_item = alife_create_item(sec, box_se, { cond = cond })
            end)
        end

        if not se_item or not (se_item.id and alife_object(se_item.id)) then
            pcall(function()
                if alife_create then
                    se_item = alife_create(sec, box_se.position, box_se.m_level_vertex_id, box_se.m_game_vertex_id, target_box_id)
                else
                    se_item = sim:create(sec, box_se.position, box_se.m_level_vertex_id, box_se.m_game_vertex_id, target_box_id)
                end
            end)
        end
    end

    if not (se_item and se_item.id and alife_object(se_item.id)) then return nil end

    if box_se and se_item and (box_se:section_name():find("fridge") or (camp and camp.structures and camp.structures[target_box_id] == "fridge")) then
        -- Ensure pristine condition and frozen freshness for food deposited into settlement fridges
        if sec:find("^meat_") or sec:find("mutant_part") or sec == "kolbasa" or sec == "tushonka" or sec == "bread" or sec == "conserva" then
            cond = 1.0
            pcall(function() se_item.condition = 1.0 end)
        end
    end

    local final_parts = nil
    if custom_parts and item_parts and item_parts.set_parts_con then
        -- se_save_var keeps the table it is given: a haul item deposited twice would give both
        -- items one parts table, and the save keeps it shared
        if type_(custom_parts) == "table" then custom_parts = dup_table(custom_parts) end
        -- DANZY EDIT: the item's own entry in the parts table is its condition; keep it
        -- in line with the condition picked above instead of whatever was copied.
        if type_(custom_parts) == "table" and cond < 0.99 then
            local psec = ini:r_string_ex(sec, "parent_section") or sec
            custom_parts[psec] = math.floor(cond * 100)
        end
        local sname = (se_item.section_name and se_item:section_name() .. "_" .. tostring(se_item.id)) or (sec .. "_" .. tostring(se_item.id))
        pcall(item_parts.set_parts_con, se_item.id, custom_parts)
        pcall(function()
            se_save_var(se_item.id, nil, "parts", custom_parts)
            se_save_var(se_item.id, sname, "parts", custom_parts)
        end)
        if type_(custom_parts) == "table" then final_parts = custom_parts end
    end

    -- DANZY EDIT: GAMMA tracks gun/armour wear in PARTS (gun condition itself is
    -- pinned by "Guns Have No Condition"). New items got pristine parts, so roll
    -- worn parts here the same way WPO does for dropped gear, based on the condition.
    if (is_wpn or is_outfit) and cond < 0.99 and not custom_parts and item_parts and item_parts.set_parts_con then
        local ip = itms_manager and itms_manager.ini_parts
        local psec = ini:r_string_ex(sec, "parent_section") or sec
        local plist = ip and ip:r_string_ex("con_parts_list", psec)
        if plist and str_explode then
            local parts = {}
            parts[psec] = math.floor(cond * 100)
            local good_chance = math.ceil(50 * cond)
            for _, part in ipairs(str_explode(plist, ",")) do
                if part and part ~= "" then
                    if mrandom(100) < good_chance then
                        parts[part] = mrandom(60, 99)
                    else
                        parts[part] = mrandom(1, 52)
                    end
                end
            end
            local sname = (se_item.section_name and se_item:section_name() .. "_" .. tostring(se_item.id)) or (sec .. "_" .. tostring(se_item.id))
            pcall(item_parts.set_parts_con, se_item.id, parts)
            pcall(function()
                se_save_var(se_item.id, nil, "parts", parts)
                se_save_var(se_item.id, sname, "parts", parts)
            end)
            final_parts = parts
        end
    end

    -- DANZY EDIT: if the item spawns straight into a loaded box, the condition written
    -- above can be lost; re-apply it when the item appears in the world.
    if cond < 0.99 and (is_wpn or is_outfit or (utils_item and utils_item.is_degradable and utils_item.is_degradable(nil, sec))) then
        sb.queue_item_cond(se_item.id, sec, cond, final_parts)
    end

    if sec == "itm_basickit" and db.actor and has_alife_info and not has_alife_info("actor_find_basic_kit") then
        db.actor:give_info_portion("actor_find_basic_kit")
    elseif sec == "itm_advancedkit" and db.actor and has_alife_info and not has_alife_info("actor_find_advanced_kit") then
        db.actor:give_info_portion("actor_find_advanced_kit")
    elseif sec == "itm_expertkit" and db.actor and has_alife_info and not has_alife_info("actor_find_expert_kit") then
        db.actor:give_info_portion("actor_find_expert_kit")
    end

    -- a new item has all its uses; a stash entry's partly used item owes the rest, as
    -- consume_one_use owes uses spent offline, until apply_pending_cond reaches it online
    local max_uses = (ini and ini:r_float_ex(sec, "max_uses")) or 1
    if uses and uses >= 1 and uses < max_uses then
        sb.pending_item_cond = sb.pending_item_cond or {}
        local pend = sb.pending_item_cond[se_item.id]
        if pend and type(pend) == "table" then
            pend.u = max_uses - uses
            pend.s = pend.s or sec
        else
            sb.pending_item_cond[se_item.id] = { s = sec, u = max_uses - uses }
        end
        sb.save_pending_cond()
        sb.start_pending_cond_timer()
    else
        uses = max_uses
    end

    if camp and se_item then
        camp.stored_items = camp.stored_items or {}
        camp.stored_items[se_item.id] = {
            sec = sec,
            cond = cond or 1.0,
            uses = uses,
            max_uses = max_uses,
            box_id = target_box_id,
            weight = item_w,
            verified = true
        }
        if camp._cached_box_weights and target_box_id then
            camp._cached_box_weights[target_box_id] = (camp._cached_box_weights[target_box_id] or 0) + item_w
        end
        if camp._inv_snapshot then
            local snap = camp._inv_snapshot
            snap.total_items = (snap.total_items or 0) + 1
            snap.total_weight = (snap.total_weight or 0) + item_w
            snap.has_storage_room = (snap.total_weight + 0.5) <= snap.max_weight
            if camp._cached_box_weights and target_box_id then
                snap.box_weights = camp._cached_box_weights
            end
            if sec == "charcoal" or sec:find("charcoal") then
                snap.charcoal_count = (snap.charcoal_count or 0) + uses
            elseif sb.is_wood_part and sb.is_wood_part(sec) then
                snap.wood_count = (snap.wood_count or 0) + uses
            end
        end
        camp._inv_snapshot_dirty = true
        camp._cached_storage_metrics_tg = nil
        camp._cached_chest_supplies_tg = nil
    end

    if target_box_id and weights and weights[target_box_id] ~= nil then
        weights[target_box_id] = weights[target_box_id] + item_w
    end

    return target_box_id or (se_item and se_item.id)
end

function stalker_camp_builder.smart_dump_to_camp_storage(target_hub_id)
    local sb = stalker_camp_builder
    local actor = db.actor
    if not actor then return false, 0 end

    local hub_id, camp
    if target_hub_id and sb.active_camps[target_hub_id] then
        hub_id = target_hub_id
        camp = sb.active_camps[target_hub_id]
    else
        hub_id, camp = sb.get_active_camp_near(actor:position())
    end

    if not camp or not hub_id then
        news_manager.send_tip(actor, game.translate_string("st_camp_status_not_near"), nil, "general_stalker", 6000)
        return false, 0
    end

    local hub_obj = alife_object(hub_id)
    if not hub_obj then return false, 0 end

    if (camp.level and camp.level ~= "unknown" and camp.level ~= level.name()) or actor:position():distance_to_sqr(hub_obj.position) > 2025 then
        news_manager.send_tip(actor, game.translate_string("st_camp_status_not_near"), nil, "general_stalker", 6000)
        return false, 0
    end

    local count_transferred = 0
    local count_skipped = 0
    local weight_cache = {}

    local function is_item_equipped(act, itm)
        if not itm or not act then return false end
        if act.is_on_belt and act:is_on_belt(itm) then
            return true
        end
        local itm_id = itm:id()
        for s = 1, 14 do
            local slot_obj = act:item_in_slot(s)
            if slot_obj and slot_obj:id() == itm_id then
                return true
            end
        end
        return false
    end

    local function sort_inventory(npc, item)
        if not item then return end
        local sec = item:section()

        if is_item_equipped(actor, item) then return end

        -- most quest items have kind = i_quest and no quest_item key; IsItem("quest") lists both
        local is_quest = ini_sys:r_bool_ex(sec, "quest_item", false) or (IsItem and IsItem("quest", sec) ~= nil)
        if is_quest then return end

        local cls = item:clsid()
        if (IsWeapon and IsWeapon(item, cls)) or (IsOutfit and IsOutfit(item, cls))
           or (IsHeadgear and IsHeadgear(item, cls)) or (IsArtefact and IsArtefact(item, cls))
           or (IsItem and (IsItem("device", sec) or IsItem("artefact", sec))) then
            return
        end

        local item_w = (item.weight and item:weight()) or 0.05
        local target_box_id = sb.get_auto_sort_target_box(camp, hub_id, sec, true, item_w, weight_cache)
        if target_box_id then
            local box_obj = level.object_by_id(target_box_id)
            if box_obj then
                actor:transfer_item(item, box_obj)
                count_transferred = count_transferred + 1
                if weight_cache[target_box_id] ~= nil then
                    weight_cache[target_box_id] = weight_cache[target_box_id] + item_w
                end
            end
        else
            -- no box for its kind has room, or the camp has none: it stays in the backpack
            count_skipped = count_skipped + 1
        end
    end

    actor:iterate_inventory(sort_inventory, actor)

    if count_transferred > 0 then
        local snd = sound_object([[interface\inv_drop]])
        if snd then snd:play(actor, 0, sound_object.s2d) end
        local msg = string.format(game.translate_string("st_auto_sort_success"), count_transferred)
        if count_skipped > 0 then
            msg = msg .. " " .. string.format(game.translate_string("st_auto_sort_skipped"), count_skipped)
        end
        news_manager.send_tip(actor, msg, nil, "general_stalker", 6000)
        stalker_camp_builder.add_camp_radio_log(hub_id, "work", string.format(game.translate_string("st_radio_autosort_deposited"), count_transferred))
        if camp then
            camp._cached_storage_metrics_tg = nil
        end
        return true, count_transferred
    elseif count_skipped > 0 then
        news_manager.send_tip(actor, string.format(game.translate_string("st_auto_sort_none_fit"), count_skipped), nil, "general_stalker", 6000)
        return false, 0
    else
        news_manager.send_tip(actor, game.translate_string("st_auto_sort_empty"), nil, "general_stalker", 5000)
        return false, 0
    end
end
