local dialogues = [[
<dialog id="recruit_to_camp_dialog">
    <precondition>stalker_camp_builder.can_recruit</precondition>
    <phrase_list>
        <phrase id="0">
            <text>st_recruit_to_camp_ask</text>
            <next>10</next>
            <next>20</next>
            <next>30</next>
            <next>40</next>
            <next>50</next>
        </phrase>
        <phrase id="10">
            <text>st_recruit_to_camp_accept</text>
