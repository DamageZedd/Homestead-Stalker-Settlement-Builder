<dialog id="camp_medic_dialog">
    <precondition>stalker_camp_builder.is_camp_medic</precondition>
    <phrase_list>
        <!-- 0: Actor initiates: "Doc, I need some medical assistance." -->
        <phrase id="0">
            <text>st_camp_medic_need_help</text>
            <next>1</next>
        </phrase>

        <!-- 1: NPC replies: "Sure thing. What's hurting you, Stalker?" -->
        <phrase id="1">
            <text>st_camp_medic_need_treat_reply</text>
            <next>2</next>
            <next>3</next>
            <next>4</next>
            <next>5</next>
            <next>6</next>
            <next>60</next>
            <next>62</next>
            <next>7</next>
        </phrase>

        <!-- 2: Actor selects: "Patch wounds & stop bleeding (1,850 RU)" -->
        <phrase id="2">
            <precondition>stalker_camp_builder.can_pay_medic_wounds</precondition>
            <text>st_camp_medic_heal_wounds_text</text>
            <action>stalker_camp_builder.medic_heal_wounds</action>
            <next>20</next>
        </phrase>

        <!-- 3: Actor selects: "Cure radiation poisoning (1,480 RU)" -->
        <phrase id="3">
            <precondition>stalker_camp_builder.can_pay_medic_rad</precondition>
            <text>st_camp_medic_cure_rad_text</text>
            <action>stalker_camp_builder.medic_cure_rad</action>
            <next>20</next>
        </phrase>

        <!-- 4: Actor selects: "Full medical treatment (3,350 RU)" -->
        <phrase id="4">
            <precondition>stalker_camp_builder.can_pay_medic_full</precondition>
            <text>st_camp_medic_full_treat_text</text>
            <action>stalker_camp_builder.medic_full_treat</action>
            <next>20</next>
        </phrase>

        <!-- 5: Actor selects: "Do you have medical supplies for trade?" -->
        <phrase id="5">
            <text>st_camp_medic_trade_ask</text>
            <action>stalker_camp_builder.start_camp_medic_trade</action>
        </phrase>

        <!-- 6: Actor selects: "I brought a Drug-Making Kit" (if has drugkit) -->
        <phrase id="6">
            <precondition>stalker_camp_builder.actor_has_drugkit</precondition>
            <text>st_camp_medic_drugkit_ask</text>
            <action>stalker_camp_builder.give_medic_drugkit</action>
            <next>21</next>
        </phrase>

        <!-- 60: Actor selects: "Hold this position / Work right here" -->
        <phrase id="60">
            <text>st_dialog_hold_position_ask</text>
            <action>stalker_camp_builder.dialog_set_survivor_position_to_actor</action>
            <next>61</next>
        </phrase>
        <phrase id="61">
            <text>st_dialog_hold_position_done</text>
            <action>dialogs.break_dialog</action>
        </phrase>

        <!-- 62: Actor selects: "Clear station position" -->
        <phrase id="62">
            <precondition>stalker_camp_builder.survivor_has_custom_position</precondition>
            <text>st_dialog_clear_position_ask</text>
            <action>stalker_camp_builder.dialog_clear_survivor_position</action>
            <next>63</next>
        </phrase>
        <phrase id="63">
            <text>st_dialog_clear_position_done</text>
            <action>dialogs.break_dialog</action>
        </phrase>

        <!-- 7: Actor selects: "Never mind." -->
        <phrase id="7">
            <text>st_camp_medic_treat_back</text>
            <next>22</next>
        </phrase>

        <!-- 20: NPC replies after treatment -->
        <phrase id="20">
            <text>st_camp_medic_heal_done</text>
        </phrase>

        <!-- 21: NPC replies after receiving drugkit -->
        <phrase id="21">
            <text>st_camp_medic_drugkit_done</text>
            <action>dialogs.break_dialog</action>
        </phrase>

        <!-- 22: NPC replies on goodbye -->
        <phrase id="22">
            <text>st_manage_camp_close_reply</text>
            <action>dialogs.break_dialog</action>
        </phrase>
    </phrase_list>
</dialog>

<dialog id="camp_technician_dialog">
    <precondition>stalker_camp_builder.is_camp_repairer</precondition>
    <phrase_list>
        <!-- 0: Actor initiates: "Can you help me with my gear?" -->
        <phrase id="0">
            <text>st_camp_tech_ask</text>
            <next>1</next>
        </phrase>

        <!-- 1: NPC replies: "Sure thing. What do you need done?" (Second Screen) -->
        <phrase id="1">
            <text>st_camp_tech_reply</text>
            <next>10</next>
            <next>12</next>
            <next>15</next>
            <next>20</next>
            <next>30</next>
            <next>31</next>
            <next>32</next>
            <next>99</next>
        </phrase>

        <!-- 10: Actor selects: "Can you modify or repair my equipment?" -->
        <phrase id="10">
            <text>st_camp_tech_upgrade_ask</text>
            <action>stalker_camp_builder.open_technician_upgrade_ui</action>
        </phrase>

        <!-- 12: Actor selects: "Overhaul equipped weapon and parts..." -->
        <phrase id="12">
            <script_text>stalker_camp_builder.get_tech_overhaul_ask_text</script_text>
            <action>stalker_camp_builder.repair_equipped_weapon_and_parts</action>
            <next>100</next>
        </phrase>

        <!-- 15: Actor selects: "Open Workshop / Workbench" -->
        <phrase id="15">
            <text>st_camp_tech_use_workbench</text>
            <action>stalker_camp_builder.open_technician_workbench</action>
            <next>100</next>
        </phrase>

        <!-- 20: Actor selects: "Do you have spare parts or tools for trade?" -->
        <phrase id="20">
            <text>st_camp_tech_trade_ask</text>
            <action>stalker_camp_builder.start_camp_tech_trade</action>
        </phrase>

        <!-- 30: Actor selects: Deliver Basic Tools -->
        <phrase id="30">
            <precondition>stalker_camp_builder.actor_has_toolkit1</precondition>
            <text>st_camp_tech_tools1_ask</text>
            <action>stalker_camp_builder.give_tech_toolkit1</action>
            <next>33</next>
        </phrase>

        <!-- 31: Actor selects: Deliver Advanced Tools -->
        <phrase id="31">
            <precondition>stalker_camp_builder.actor_has_toolkit2</precondition>
            <text>st_camp_tech_tools2_ask</text>
            <action>stalker_camp_builder.give_tech_toolkit2</action>
            <next>33</next>
        </phrase>

        <!-- 32: Actor selects: Deliver Expert Tools -->
        <phrase id="32">
            <precondition>stalker_camp_builder.actor_has_toolkit3</precondition>
            <text>st_camp_tech_tools3_ask</text>
            <action>stalker_camp_builder.give_tech_toolkit3</action>
            <next>33</next>
        </phrase>

        <!-- 33: NPC replies after toolkit delivery -->
        <phrase id="33">
            <text>st_camp_tech_tools_done</text>
            <action>dialogs.break_dialog</action>
        </phrase>

        <!-- 99: Actor selects: "Never mind." -->
        <phrase id="99">
            <text>st_manage_camp_close</text>
            <next>100</next>
        </phrase>

        <!-- 100: NPC replies on goodbye -->
        <phrase id="100">
            <text>st_manage_camp_close_reply</text>
            <action>dialogs.break_dialog</action>
        </phrase>
    </phrase_list>
</dialog>
]]

