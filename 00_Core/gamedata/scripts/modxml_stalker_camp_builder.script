local function has_catspaw_skull()
    local fs_ok, fs_found = pcall(function()
        local fs = getFS()
        if not fs then return false end
        return (fs:exist("$game_config$", "ui\\textures_descr\\ui_catsy_milpda.xml") ~= nil)
            or (fs:exist("$game_config$", "ui\\textures_descr\\ui_catsy_paw_texd.xml") ~= nil)
    end)
    return fs_ok and (fs_found == true)
end

local function get_homestead_mapspots()
    local mutant_spot_xml
    if has_catspaw_skull() then
        mutant_spot_xml = [[
<homestead_outpost_mutant>
    <level_map spot="homestead_outpost_mutant_spot"/>
    <mini_map spot="homestead_outpost_mutant_mini_spot"/>
</homestead_outpost_mutant>
<homestead_outpost_mutant_spot width="32" height="36" alignment="c" stretch="0" scale="1" scale_min="1.0" scale_max="1.4" location_level="5">
    <texture>ui_mapspot_skull_large</texture>
</homestead_outpost_mutant_spot>
<homestead_outpost_mutant_mini_spot width="18" height="21" alignment="c" stretch="0" scale="1" scale_min="1.0" scale_max="1.4" location_level="5">
    <texture>ui_mapspot_skull_small</texture>
</homestead_outpost_mutant_mini_spot>
]]
    else
        -- Standard installs without Catspaw's skull textures fall back to a base-game hazard marker
        mutant_spot_xml = [[
<homestead_outpost_mutant>
    <level_map spot="homestead_outpost_mutant_spot"/>
    <mini_map spot="homestead_outpost_mutant_mini_spot"/>
</homestead_outpost_mutant>
<homestead_outpost_mutant_spot width="36" height="36" alignment="c" stretch="1" scale="1" scale_min="1.0" scale_max="1.4" location_level="5">
    <texture r="255" g="100" b="0">ui_pda2_base</texture>
</homestead_outpost_mutant_spot>
<homestead_outpost_mutant_mini_spot width="15" height="15" alignment="c" stretch="1" scale="1" scale_min="1.0" scale_max="1.4" location_level="5">
    <texture r="255" g="100" b="0">ui_mmap_base</texture>
</homestead_outpost_mutant_mini_spot>
]]
    end
    return homestead_mapspots .. mutant_spot_xml
end

-- v1.2.2: Homestead-owned 2x-size wrappers around PAW's pin/badge textures. PAW's own
-- spot definitions (18-20px) live in a third-party mod and are never edited; instead
-- Homestead registers its own spots that reuse PAW's textures at double size.
local PAW_BADGE_FACTIONS = {
    "bandit", "monolith", "killer", "army", "stalker", "dolg",
    "freedom", "csky", "ecolog", "greh", "isg", "renegade",
}

local function build_paw_spot_xml(name, texture, level_size, mini_size, stretch)
    return string.format(
        "<%s>\n    <level_map spot=\"%s_spot\"/>\n    <mini_map spot=\"%s_spot_mini\"/>\n</%s>\n" ..
        "<%s_spot width=\"%d\" height=\"%d\" alignment=\"c\" stretch=\"%d\" scale=\"1\" scale_min=\"1.0\" scale_max=\"1.2\">\n    <texture>%s</texture>\n</%s_spot>\n" ..
        "<%s_spot_mini width=\"%d\" height=\"%d\" alignment=\"c\" stretch=\"%d\" scale=\"1\" scale_min=\"1.0\" scale_max=\"1.2\">\n    <texture>%s</texture>\n</%s_spot_mini>\n",
        name, name, name, name,
        name, level_size, level_size, stretch, texture, name,
        name, mini_size, mini_size, stretch, texture, name)
end

local function build_paw_mapspots()
    local parts = {
        build_paw_spot_xml("homestead_paw_pin_skull",     "ui_icons_paw_pin_redskull",    24, 18, 1),
        build_paw_spot_xml("homestead_paw_pin_abandoned", "ui_icons_paw_pin_whtsimple32", 40, 30, 0),
        build_paw_spot_xml("homestead_paw_pin_hostile",   "ui_icons_paw_pin_redpush32",   40, 30, 0),
        build_paw_spot_xml("homestead_paw_pin_friendly",  "ui_icons_paw_pin_yelpush32",   40, 30, 0),
        build_paw_spot_xml("homestead_paw_pin_stalker",   "ui_icons_paw_pin_stalker64",   40, 30, 0),
    }
    for _, fac in ipairs(PAW_BADGE_FACTIONS) do
        parts[#parts + 1] = build_paw_spot_xml("homestead_paw_badge_" .. fac, "ui_icons_paw_badge_hr_" .. fac, 36, 27, 0)
    end
    return table.concat(parts)
end

local homestead_paw_mapspots = nil
local function get_paw_mapspots()
    if homestead_paw_mapspots == nil then
        homestead_paw_mapspots = build_paw_mapspots()
    end
    return homestead_paw_mapspots
end

function on_xml_read()
    local ipairs_ = ipairs
    local sfind = string.find
    RegisterScriptCallback("on_xml_read", function(xml_file_name, xml_obj)
        if (xml_file_name == [[gameplay\dialogs.xml]]) or (xml_file_name == [[gameplay/dialogs.xml]]) or sfind(xml_file_name, "gameplay[\\/]dialogs%.xml") then
            xml_obj:insertFromXMLString(dialogues)
        end
        if (xml_file_name == [[ui\map_spots.xml]]) or (xml_file_name == [[ui\map_spots_16.xml]]) or (xml_file_name == [[ui\map_spots_21.xml]]) or
           (xml_file_name == [[ui/map_spots.xml]]) or (xml_file_name == [[ui/map_spots_16.xml]]) or (xml_file_name == [[ui/map_spots_21.xml]]) or
           sfind(xml_file_name, "ui[\\/]map_spots.*%.xml") then
            xml_obj:insertFromXMLString(get_homestead_mapspots())
            local paw_present = true
            local fs_ok, fs_found = pcall(function()
                return getFS():exist("$game_config$", "ui\\map_spots_paw_pins.xml")
            end)
            if fs_ok and not fs_found then
                paw_present = false
            end
            if paw_present then
                xml_obj:insertFromXMLString(get_paw_mapspots())
            end
        end
        if sfind(xml_file_name, "ui[\\/]pda.*%.xml") and not sfind(xml_file_name, "pda_apps", 1, true) and not sfind(xml_file_name, "pda_xcvb", 1, true) then
            local tabs = xml_obj:query("tab")
            if tabs then
                for _, tab_el in ipairs_(tabs) do
                    -- Only process the main navigation tab bar (identified by containing eptTasks)
                    local is_main_tab_bar = false
                    local buttons = {}
                    local exists = false
                    if tab_el.kids then
                        for _, child in ipairs_(tab_el.kids) do
                            local el_data = xml_obj:getElement(child)
                            if el_data and el_data.name == "button" and el_data.attr then
                                if el_data.attr.id == "eptTasks" then
                                    is_main_tab_bar = true
                                end
                                if el_data.attr.id == "eptSettlement" then
                                    exists = true
                                end
                                -- Ignore off-screen dummy/placeholder buttons (e.g. MAC's or other
                                -- PDA-tab addons' x=1000 width=0 invisible buttons) so they don't get
                                -- counted in total_buttons/step or repositioned into the visible bar.
                                local btn_x = tonumber(el_data.attr.x) or 0
                                if btn_x < 800 then
                                    buttons[#buttons+1] = child
                                end
                            end
                        end
                    end

                    if is_main_tab_bar and not exists then
                        -- Calculate responsive button widths and positions so all tabs fit cleanly within 550px header
                        local total_buttons = #buttons + 1
                        local max_tab_width = 548
                        local btn_width = math.min(69, math.floor(max_tab_width / total_buttons) + 10)
                        local step = math.floor((max_tab_width - btn_width) / math.max(1, total_buttons - 1))
                        if step > 78 then step = 78 end

                        -- Reposition and rescale existing tabs seamlessly with authentic texture overlap
                        for idx, btn in ipairs_(buttons) do
                            local cur_x = (idx - 1) * step
                            xml_obj:setElementAttr(btn, { x = tostring(cur_x), width = tostring(btn_width) })
                        end

                        local next_x = #buttons * step

                        -- Inject visible Settlement tab button cleanly inside 550px bounds
                        local button_xml = string.format([[
                            <button x="%d" y="0" width="%d" height="27" id="eptSettlement" frame_mode="0">
                                <text align="c" vert_align="c" x="0" y="0" font="letterica16">pda_btn_settlement</text>
                                <texture>ui_inGame2_pda_button</texture>
                                <text_color>
                                    <t r="255" g="255" b="255"/>
                                    <d r="255" g="255" b="255"/>
                                    <e r="200" g="200" b="200"/>
                                    <h r="170" g="170" b="170"/>
                                </text_color>
                            </button>
                        ]], next_x, btn_width)

                        xml_obj:insertFromXMLString(button_xml, tab_el, #tab_el.kids + 1)
                    end
                end
            end
        elseif sfind(xml_file_name, "ui[\\/]pda_xcvb.*%.xml") then
            local left_cont = xml_obj:query("left_container")
            if left_cont and left_cont[1] then
                xml_obj:setElementAttr(left_cont[1], { height = "370" })
                local btn_xml = [[
                    <menu_btn_8 x="0" y="330" width="130" height="35" check_mode="0">
                        <text complex_mode="1" align="c" vert_align="c" font="letterica18">pda_btn_settlement</text>
                        <texture>ui_inter_pda_btn</texture>
                    </menu_btn_8>
                ]]
                xml_obj:insertFromXMLString(btn_xml, left_cont[1])
            end
        end
    end)
end

function on_game_start()
    RegisterScriptCallback("on_specific_character_dialog_list", function(character_id, dialog_list)
        if not dialog_list then return end
        if not dialog_list:has("recruit_to_camp_dialog") then
            dialog_list:add("recruit_to_camp_dialog")
        end
        if not dialog_list:has("manage_camp_dialog") then
            dialog_list:add("manage_camp_dialog")
        end
        if not dialog_list:has("camp_trader_dialog") then
            dialog_list:add("camp_trader_dialog")
        end
        if not dialog_list:has("camp_medic_dialog") then
            dialog_list:add("camp_medic_dialog")
        end
        if not dialog_list:has("camp_technician_dialog") then
            dialog_list:add("camp_technician_dialog")
        end
        if not dialog_list:has("camp_woodcutter_dialog") then
            dialog_list:add("camp_woodcutter_dialog")
        end
        if not dialog_list:has("return_to_settlement_dialog") then
            dialog_list:add("return_to_settlement_dialog")
        end
    end)
end
