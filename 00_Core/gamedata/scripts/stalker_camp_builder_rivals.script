-- v1.1.8: rival camp furniture is now an MCM toggle (default ON). Danzy's
-- edit hard-coded RIVAL_DECOR_ENABLED = false; this replaces it with
-- "Rival Camp Furniture" in MCM -> Rivals. OFF clears decor already placed
-- at existing camps and stops new camps/tier upgrades from spawning more.
local function rival_decor_enabled()
    local sb = stalker_camp_builder
    if sb and sb.cfg then return sb.cfg.rival_camp_furniture ~= false end
    return true
end

local sformat = string.format
local pairs_ = pairs
local ipairs_ = ipairs
local tostr = tostring
local type_ = type
local mmin = math.min
local mmax = math.max
local mfloor = math.floor
local mabs = math.abs
local mrandom = math.random
local mcos = math.cos
local msin = math.sin
local msqrt = math.sqrt

-- Safe switch distance threshold: Anomaly's alife.ltx sets a switch distance of 750m,
-- G.A.M.M.A.'s 450m. An object that came online goes offline only beyond
-- switch_distance * (1 + switch_factor), so squads and events do not spawn, transform, or
-- despawn within that radius. The engine doesn't export the factor; it is in alife.ltx.
local function get_safe_switch_distance()
    local sim = alife()
    local sd = sim and sim.switch_distance and sim:switch_distance()
    local factor = ini_sys and ini_sys.r_float_ex and ini_sys:r_float_ex("alife", "switch_factor") or 0.1
    return mmax(150, sd or 150) * (1 + factor)
end

local function get_safe_switch_distance_sqr()
    local d = get_safe_switch_distance()
    return d * d
end

-- whether the player is on level lvl within online switch distance of pos, close enough to see a squad appear or vanish
local function is_player_near(lvl, pos)
    local actor = db.actor
    if not (actor and pos and level and level.name and lvl == level.name()) then return false end
    local ap = actor:position()
    local dx, dy, dz = ap.x - pos.x, ap.y - pos.y, ap.z - pos.z
    return (dx * dx + dy * dy + dz * dz) <= get_safe_switch_distance_sqr()
end
stalker_camp_builder.get_safe_switch_distance = get_safe_switch_distance
stalker_camp_builder.get_safe_switch_distance_sqr = get_safe_switch_distance_sqr
stalker_camp_builder.is_player_near = is_player_near

-- whether pos on level lvl lies in one of the player's settlements, or within the 15 m that new
-- outposts keep clear of them (spawn_single_rival_camp)
local function in_player_settlement(lvl, pos)
    local sb = stalker_camp_builder
    if not (pos and sb.active_camps) then return false end
    local clear = ((sb.cfg and sb.cfg.boundary_dist) or 50) + 15
    for hub_id, pcamp in pairs(sb.active_camps) do
        local on_level = not pcamp.level or pcamp.level == "unknown" or pcamp.level == lvl
        local hub = on_level and alife_object(hub_id)
        local hp = hub and hub.position
        if hp then
            local dx, dy, dz = hp.x - pos.x, hp.y - pos.y, hp.z - pos.z
            if dx * dx + dy * dy + dz * dz < clear * clear then return true end
        end
    end
    return false
end


-- whether the player has taken this squad as companions (axr_companions keeps them by squad id)
local function is_companion_squad(id)
    local cs = id and axr_companions and axr_companions.companion_squads
    return cs ~= nil and cs[id] ~= nil
end

-- stop holding a squad at an outpost: drop the pin and the members' rival lookups
local function release_rival_hold(sb, squad)
    if not squad then return end
    squad.get_script_target = nil
    -- the pin left the squad aimed at itself: a squad read from a save (current_action 0) would
    -- "reach" that and stay for its idle_time, 2 to 8 game hours, before moving on
    squad.assigned_target_id = nil
    squad.current_target_id = nil
    squad.current_action = nil
    for k in sb.safe_squad_members(squad) do
        if k.id then
            if sb.camp_npc_released then sb.camp_npc_released[k.id] = nil end
            if sb.settler_lookup then sb.settler_lookup[k.id] = nil end
        end
    end
end
stalker_camp_builder.release_rival_hold = release_rival_hold

local function is_valid_camp_squad(camp, squad)
    if not (squad and squad.squad_members) then return false end
    if is_companion_squad and is_companion_squad(squad.id) then return false end
    if camp and camp.faction then
        local squad_comm = squad.get_squad_community and squad:get_squad_community() or squad.player_id
        if squad_comm then
            if camp.faction == "monster" then
                if squad_comm ~= "monster" then return false end
            elseif squad_comm ~= camp.faction then
                return false
            end
        end
    end
    return true
end
stalker_camp_builder.is_valid_camp_squad = is_valid_camp_squad

local function is_squad_alive(squad)
    if not squad then return false end
    if squad.npc_count then
        local ok, count = pcall(squad.npc_count, squad)
        if ok and count then
            return count > 0
        end
    end
    if squad.squad_members then
        local ok_mem, members = pcall(squad.squad_members, squad)
        if ok_mem and members then
            for _ in members do
                return true
            end
        end
    end
    return false
end

-- enforce_rival_camp_survivor_cap -- trim garrison members exceeding max_survivors_rival_camp
local function enforce_rival_camp_survivor_cap(camp, force)
    if not camp then return end
    local sb = stalker_camp_builder
    local cap = tonumber(sb.cfg and sb.cfg.max_survivors_rival_camp) or 5
    if cap < 1 then cap = 1 end

    local sim = alife()
    if not sim then return end

    if not force and is_player_near(camp.level or (level and level.name and level.name()), camp.position) then
        return
    end

    local squads = {}
    if camp.squad_id then
        local sq = sim:object(camp.squad_id)
        if sq and is_valid_camp_squad(camp, sq) then
            squads[#squads + 1] = sq
        end
    end
    if camp.extra_squad_ids then
        for _, ex_id in ipairs(camp.extra_squad_ids) do
            local ex_sq = sim:object(ex_id)
            if ex_sq and is_valid_camp_squad(camp, ex_sq) then
                squads[#squads + 1] = ex_sq
            end
        end
    end
    if #squads == 0 then return end

    local all_members = {}
    for _, sq in ipairs(squads) do
        for k in sb.safe_squad_members(sq) do
            if k.id then
                local se_npc = sim:object(k.id)
                if se_npc and se_npc:alive() then
                    all_members[#all_members + 1] = { squad = sq, id = k.id, se = se_npc }
                end
            end
        end
    end

    if #all_members > cap then
        for i = cap + 1, #all_members do
            local item = all_members[i]
            local m_id = item.id
            local sq = item.squad
            local se_npc = item.se
            pcall(function()
                if sb.camp_npc_released then sb.camp_npc_released[m_id] = nil end
                if sb.settler_lookup then sb.settler_lookup[m_id] = nil end
                if sq and sq.remove_npc then
                    sq:remove_npc(m_id, true)
                end
                if se_npc then
                    alife_release(se_npc)
                end
            end)
        end

        -- Clean up any extra squads that were emptied
        if camp.extra_squad_ids then
            for i = #camp.extra_squad_ids, 1, -1 do
                local ex_id = camp.extra_squad_ids[i]
                local ex_sq = sim:object(ex_id)
                if not (ex_sq and is_valid_camp_squad(camp, ex_sq) and is_squad_alive(ex_sq)) then
                    if ex_sq then
                        pcall(alife_release, ex_sq)
                    end
                    table.remove(camp.extra_squad_ids, i)
                end
            end
        end
    end
end
stalker_camp_builder.enforce_rival_camp_survivor_cap = enforce_rival_camp_survivor_cap

-- whether a convoy entry's squad id names something other than its courier by now (a released
-- squad's id goes to a later object)
local function courier_id_reused(sim, id, conv)
    local sq = sim:object(id)
    return sq ~= nil and not (sq.squad_members and (not conv.section or sq:section_name() == conv.section))
end

local function cleanup_camp_convoys(chest_id)
    local sb = stalker_camp_builder
    local sim = alife()
    if not (sb and chest_id and sim) then return end
    if sb.active_convoys then
        for c_sq_id, conv in pairs(sb.active_convoys) do
            if conv and conv.target_camp_chest == chest_id and courier_id_reused(sim, c_sq_id, conv) then
                sb.active_convoys[c_sq_id] = nil
            elseif conv and conv.target_camp_chest == chest_id then
                local c_sq = sim:object(c_sq_id)
                if c_sq and is_companion_squad(c_sq_id) then
                    -- recruited by the player: theirs now, handed back rather than released
                    c_sq.get_script_target = nil
                elseif c_sq then
                    c_sq.get_script_target = nil
                    for k in sb.safe_squad_members(c_sq) do
                        if k.id then
                            local se_npc = sim:object(k.id)
                            if se_npc then alife_release(se_npc) end
                        end
                    end
                    alife_release(c_sq)
                end
                sb.active_convoys[c_sq_id] = nil
            end
        end
    end
    if sb.rival_camps then
        for _, c in pairs(sb.rival_camps) do
            if type(c) == "table" and c.chest_id == chest_id and c.heat_mutant_squad_id then
                local m_sq = sim:object(c.heat_mutant_squad_id)
                -- only while the id still names a mutant squad
                if m_sq and m_sq.squad_members and is_squad_monster[m_sq.player_id] then
                    m_sq.get_script_target = nil
                    for k in sb.safe_squad_members(m_sq) do
                        if k.id then
                            local se_npc = sim:object(k.id)
                            if se_npc then alife_release(se_npc) end
                        end
                    end
                    alife_release(m_sq)
                end
                c.heat_mutant_squad_id = nil
                break
            end
        end
    end
end
stalker_camp_builder.cleanup_camp_convoys = cleanup_camp_convoys

local function safe_teleport_object(id, gvid, lvid, pos, sim_override)
    if not id or not gvid or not lvid or not pos then return end
    local s = sim_override or sim or alife()
    if not s then return end
    local se_obj = s:object(id)
    if not se_obj then return end
    local cls = se_obj.clsid and se_obj:clsid()
    local is_creature = cls and (IsStalker(nil, cls) or IsMonster(nil, cls))
    if is_creature then
        local online_obj = level.object_by_id(id)
        if online_obj then
            pcall(function()
                if online_obj.set_npc_position then
                    online_obj:set_npc_position(pos)
                end
            end)
            se_obj.position = pos
            se_obj.m_level_vertex_id = lvid
            se_obj.m_game_vertex_id = gvid
            return
        end
        -- Offline creature: only invoke engine teleport if moving across game graph vertices
        if se_obj.m_game_vertex_id == gvid then
            se_obj.position = pos
            se_obj.m_level_vertex_id = lvid
            return
        end
        pcall(function()
            if db.offline_objects and db.offline_objects[id] then
                db.offline_objects[id].level_vertex_id = nil
            end
            if db.spawned_vertex_by_id then
                db.spawned_vertex_by_id[id] = nil
            end
            if TeleportObject then
                TeleportObject(id, pos, lvid, gvid)
            elseif s.teleport_object then
                s:teleport_object(id, gvid, lvid, pos)
            end
        end)
    else
        se_obj.position = pos
        se_obj.m_level_vertex_id = lvid
        se_obj.m_game_vertex_id = gvid
    end
end

-- stalker_camp_builder_rivals.script

local last_rival_spawn_scan_tg = 0
local RIVAL_SPAWN_SCAN_INTERVAL_MS = 60000  -- 60 real seconds

-- restrain_rival_squads -- pin rival camp squads in place via script_target
local find_ground_anchor

-- setup_rival_squad_positions -- Spawns/teleports squad members to tactical guard posts away from the blue box
function stalker_camp_builder.setup_rival_squad_positions(squad, camp, sim_override)
    if not squad or not camp or not camp.position then return end
    local sb = stalker_camp_builder
    local s = sim_override or sim or alife()
    if not s then return end

    local camp_pos = vector():set(camp.position.x, camp.position.y, camp.position.z)
    local camp_rot = camp.rotation or 0
    local gvid = camp.game_vertex_id or (squad.m_game_vertex_id)
    local lvid = camp.level_vertex_id or (squad.m_level_vertex_id)

    -- Guard / sentry stations (local offsets relative to camp orientation)
    -- All stations are at least 2.5m - 4.5m away from the central chest so NPCs NEVER stack on the blue box
    local stations = {
        { lx = 0.0,  lz = 3.6,  dir_yaw = 0.0 },              -- Station 1: Front barricade gate
        { lx = -2.8, lz = 1.0,  dir_yaw = -math.pi * 0.35 },   -- Station 2: Left flank wall
        { lx = 2.8,  lz = 1.0,  dir_yaw = math.pi * 0.35 },    -- Station 3: Right flank wall
        { lx = 0.8,  lz = -1.6, dir_yaw = math.pi * 0.75 },    -- Station 4: Camp hearth / bivouac
        { lx = -1.8, lz = 2.6,  dir_yaw = -0.2 },             -- Station 5: Left perimeter cover
        { lx = 1.8,  lz = 2.6,  dir_yaw = 0.2 },              -- Station 6: Right perimeter cover
    }

    local cos_r = math.cos(camp_rot)
    local sin_r = math.sin(camp_rot)
    local member_idx = 0
    local target_pos = vector()
    local dir_v = vector()

    for k in sb.safe_squad_members(squad) do
        if k.id then
            member_idx = member_idx + 1
            local st = stations[((member_idx - 1) % #stations) + 1]
            local wx = camp_pos.x + st.lx * cos_r - st.lz * sin_r
            local wz = camp_pos.z + st.lx * sin_r + st.lz * cos_r

            local target_lvid = lvid
            target_pos:set(wx, camp_pos.y, wz)
            if level and level.name() == camp.level then
                local found_lvid, dvpos, d_surface_y
                if find_ground_anchor then
                    found_lvid, dvpos, d_surface_y = find_ground_anchor(wx, wz, camp_pos.y, camp_pos.y)
                end
                if found_lvid and (d_surface_y or (dvpos and dvpos.y)) then
                    target_lvid = found_lvid
                    target_pos:set(wx, (d_surface_y or dvpos.y) + 0.05, wz)
                end
            end

            local se_npc = s:object(k.id)
            if se_npc then
                safe_teleport_object(k.id, gvid, target_lvid, target_pos, s)
                se_npc.position = target_pos
                se_npc.m_level_vertex_id = target_lvid
                se_npc.m_game_vertex_id = gvid
                -- a member just created near the player comes online on the vertex it was created
                -- with (db.spawned_vertex_by_id, read at net_spawn), the chest's: make it the station's
                if db.spawned_vertex_by_id and db.spawned_vertex_by_id[k.id] then
                    db.spawned_vertex_by_id[k.id] = target_lvid
                end

                local online_npc = level.object_by_id(k.id)
                if online_npc and IsStalker(online_npc) and (not IsMonster(online_npc)) then
                    pcall(function()
                        if online_npc.set_npc_position then
                            online_npc:set_npc_position(target_pos)
                        end
                        local dir_yaw = camp_rot + st.dir_yaw
                        dir_v:set(math.sin(dir_yaw), 0, math.cos(dir_yaw))
                        if online_npc.set_desired_direction then
                            online_npc:set_desired_direction(dir_v)
                        end
                    end)
                end
            end

            -- Immediately register into settler_lookup as rival
            sb.settler_lookup[k.id] = {
                hub_id = nil,
                camp = nil,
                survivor = nil,
                is_rival = true,
                rival_camp = camp,
            }
            if sb.non_settler_cache then
                sb.non_settler_cache[k.id] = nil
            end
        end
    end

    squad.get_script_target = function(self) return self.id end
end

-- restrain_rival_squads -- pin rival camp squads in place via script_target and dislodge anyone stuck on the blue box
function stalker_camp_builder.restrain_rival_squads()
    local sb = stalker_camp_builder
    local sim = alife()
    if not sim then return end
    for key, camp in pairs(sb.rival_camps) do
        if type(camp) == "table" then
            if camp.squad_id then
                local squad = sim:object(camp.squad_id)
                if squad and is_valid_camp_squad(camp, squad) then
                    squad.get_script_target = function(self)
                        return self.id
                    end

                    -- Auto-dislodge NPCs in existing saves that are stuck on the blue box
                    if level and level.name() == camp.level and camp.position then
                        local cp = camp.position
                        local needs_dislodge = false
                        for k in sb.safe_squad_members(squad) do
                            if k.id then
                                local online_npc = level.object_by_id(k.id)
                                if online_npc and online_npc.position and online_npc.alive and online_npc:alive() then
                                    local np = online_npc:position()
                                    local dx = np.x - cp.x
                                    local dz = np.z - cp.z
                                    if (dx * dx + dz * dz) < 1.0 and (np.y - cp.y) > 0.25 then
                                        needs_dislodge = true
                                        break
                                    end
                                end
                            end
                        end
                        if needs_dislodge then
                            sb.setup_rival_squad_positions(squad, camp, sim)
                        end
                    end
                end
            end
            if camp.extra_squad_ids then
                for _, ex_id in ipairs(camp.extra_squad_ids) do
                    local ex_sq = sim:object(ex_id)
                    if ex_sq and is_valid_camp_squad(camp, ex_sq) then
                        ex_sq.get_script_target = function(self) return self.id end
                    end
                end
            end
        end
    end
end

-- create_squad_at_pos -- spawn a squad at the given position
function stalker_camp_builder.create_squad_at_pos(section, pos, lvid, gvid, no_pin)
    local sb = stalker_camp_builder
    local squad = alife():create(section, pos, lvid, gvid)
    if squad then
        squad:create_npc(nil, pos, lvid, gvid)
        if not no_pin then
            squad.get_script_target = function(self)
                return self.id
            end
        end
        local sim = alife()
        for k in sb.safe_squad_members(squad) do
            local se_obj = k.object or (k.id and sim:object(k.id))
            if se_obj and SIMBOARD and SIMBOARD.setup_squad_and_group then
                SIMBOARD:setup_squad_and_group(se_obj)
            end
        end
        return squad
    end
    return nil
end

-- release_camp_decorations -- alife_release all decoration ids on a camp
function stalker_camp_builder.release_camp_decorations(camp)
    if camp and camp.decorations then
        -- off the camp first: a release can run server_entity_on_unregister, which removes the id
        -- from camp.decorations and would make this loop skip the next piece
        local list = camp.decorations
        camp.decorations = {}
        for _, id in ipairs(list) do
            local ok, se_decor = pcall(alife_object, id)
            -- a freed id may name another object by now: release only outpost furniture
            if ok and se_decor then
                local is_decor = stalker_camp_builder.is_camp_decor(camp, id, se_decor)
                if is_decor then
                    pcall(alife_release, se_decor)
                end
            end
        end
        camp.decor_sections = {}
    end
end

-- find_nearby_squad_for_repopulation -- find a non-assigned squad near a camp
function stalker_camp_builder.find_nearby_squad_for_repopulation(camp)
    local sb = stalker_camp_builder
    local camp_pos = vector():set(camp.position.x, camp.position.y, camp.position.z)
    local sim = alife()
    if not (SIMBOARD and SIMBOARD.squads) then return nil end
    for id, squad in pairs(SIMBOARD.squads) do
        if squad and type(squad) == "table" and squad.position then
            local dist_ok, dist = pcall(function() return squad.position:distance_to(camp_pos) end)
            if dist_ok and dist <= 35 then
                if squad.id ~= 0 and not (axr_companions and axr_companions.companion_squads and axr_companions.companion_squads[squad.id]) then
                    local already_used = false
                    for other_key, other_camp in pairs(sb.rival_camps) do
                        if other_camp.squad_id == squad.id then
                            already_used = true
                            break
                        end
                    end
                    if not already_used then
                        return squad
                    end
                end
            end
        end
    end
    return nil
end

local underground_levels = {
    ["jupiter_underground"]   = true,
    ["l03u_agr_underground"]  = true,
    ["l04u_labx18"]           = true,
    ["l08u_brainlab"]         = true,
    ["l10u_bunker"]           = true,
    ["l12u_control_monolith"] = true,
    ["l12u_sarcofag"]         = true,
    ["l13u_warlab"]           = true,
    ["labx8"]                 = true,
    ["fake_start"]            = true,
    ["l11_hospital"]          = true,
}

local underground_smart_terrains = {
    ["cit_kanaliz1"] = true,
    ["cit_kanaliz2"] = true,
    ["bar_dolg_bunker"] = true,
    ["katacomb_smart_terrain"] = true,
    ["gen_smart_terrain_lab_entrance"] = true,
    ["gen_smart_terrain_lab_entrance_2"] = true,
    ["pas_b400_tunnel"] = true,
    ["warlab_common_consciousness_smart_terrain"] = true,
    ["lx8_smart_terrain"] = true,
    ["x162_st_burer"] = true,
    ["x162_st_gigant"] = true,
    ["x162_st_poltergeist"] = true,
    ["x162_st_snork"] = true,
}

function stalker_camp_builder.is_underground_smart(name)
    local sfind = string.find
    if not name or name == "" then return true end
    if underground_smart_terrains[name] then return true end
    local s = string.lower(name)
    if sfind(s, "kanaliz", 1, true)
        or sfind(s, "catacomb", 1, true)
        or sfind(s, "katacomb", 1, true)
        or sfind(s, "bunker", 1, true)
        or sfind(s, "tunnel", 1, true)
        or sfind(s, "underground", 1, true)
        or sfind(s, "podval", 1, true)
        or sfind(s, "basement", 1, true)
        or sfind(s, "collector", 1, true)
        or sfind(s, "subway", 1, true)
        or sfind(s, "metro", 1, true)
        or sfind(s, "peshera", 1, true)
        or sfind(s, "dolg_bunker", 1, true)
        or sfind(s, "lab_entrance", 1, true)
    then
        return true
    end
    return false
end

function stalker_camp_builder.is_underground_level(lvl)
    local sfind = string.find
    if not lvl or lvl == "" then return true end
    if underground_levels[lvl] then return true end
    local lower_lvl = string.lower(lvl)
    if sfind(lower_lvl, "underground", 1, true) or sfind(lower_lvl, "lab", 1, true) or sfind(lower_lvl, "bunker", 1, true) or sfind(lower_lvl, "sarcofag", 1, true) or sfind(lower_lvl, "warlab", 1, true) or sfind(lower_lvl, "hospital", 1, true) or sfind(lower_lvl, "^l%d%du_") then
        return true
    end
    return false
end

-- get_smart_terrains_on_level -- list smart terrains whose game vertex is on
-- DANZY EDIT: smart terrains never change during a session, so work out which
-- map each one is on ONCE and reuse it. This used to re-scan every smart in the
-- game (with string checks) for every map tried on each camp spawn -> stutter.
local _smart_cache = nil      -- level_name -> { {obj=, name=}, ... }
local _smart_levels = nil     -- list of surface level names
local _smart_cache_count = -1

local function build_smart_cache()
    if not (SIMBOARD and SIMBOARD.smarts_by_names) then return false end
    local count = 0
    for _ in pairs(SIMBOARD.smarts_by_names) do count = count + 1 end
    if _smart_cache and count == _smart_cache_count then return true end
    local sim = alife()
    local gg = game_graph()
    if not (sim and gg) or count == 0 then return false end
    local cache, levels = {}, {}
    for name, smart in pairs(SIMBOARD.smarts_by_names) do
        if smart and smart.m_game_vertex_id and not stalker_camp_builder.is_underground_smart(name) then
            local ok, s_level = pcall(function()
                return sim:level_name(gg:vertex(smart.m_game_vertex_id):level_id())
            end)
            if ok and s_level and s_level ~= "" and not stalker_camp_builder.is_underground_level(s_level) then
                if not cache[s_level] then
                    cache[s_level] = {}
                    levels[#levels+1] = s_level
                end
                local t = cache[s_level]
                t[#t+1] = { obj = smart, name = name }
            end
        end
    end
    _smart_cache, _smart_levels, _smart_cache_count = cache, levels, count
    return true
end

function stalker_camp_builder.get_smart_terrains_on_level(level_name)
    local smarts = {}
    if stalker_camp_builder.is_underground_level(level_name) then return smarts end
    if not build_smart_cache() then return smarts end
    local list = _smart_cache[level_name]
    if not list then return smarts end
    local avail_tbl = simulation_objects and simulation_objects.available_by_id
    for _, e in ipairs(list) do
        local is_available = true
        if avail_tbl then
            local avail = avail_tbl[e.obj.id]
            is_available = (avail == true) or (avail == nil)  -- nil = treat as available
        end
        if is_available then
            smarts[#smarts+1] = { obj = e.obj, name = e.name }
        end
    end
    return smarts
end

-- get_all_levels_with_smarts -- list level names that have at least one smart (surface only)
function stalker_camp_builder.get_all_levels_with_smarts()
    if not build_smart_cache() then return {} end
    local list = {}
    for i, lvl in ipairs(_smart_levels) do list[i] = lvl end
    return list
end

-- get_enemy_faction_for -- pick a random enemy faction for the given faction
function stalker_camp_builder.get_enemy_faction_for(faction, level_name)
    local allowed_factions = level_name and stalker_camp_builder.get_level_factions(level_name) or {"stalker", "bandit", "csky", "army", "freedom", "dolg", "ecolog", "killer"}
    local enemies = {}
    for _, f in ipairs(allowed_factions) do
        if f ~= faction then
            local rel = relation_registry.community_relation(faction, f)
            if rel and rel <= -1000 then
                enemies[#enemies+1] = f
            end
        end
    end
    if #enemies > 0 then
        return enemies[math.random(#enemies)]
    end
    local all_hostile_candidates = {"bandit", "killer", "monolith", "renegade", "freedom", "dolg", "army"}
    for _, f in ipairs(all_hostile_candidates) do
        if f ~= faction then
            local rel = relation_registry.community_relation(faction, f)
            if rel and rel <= -500 then
                enemies[#enemies+1] = f
            end
        end
    end
    if #enemies > 0 then
        return enemies[math.random(#enemies)]
    end

    if faction == "bandit" or faction == "renegade" then
        return "stalker"
    end
    return "bandit"
end

-- find_wiping_squad -- find a hostile squad within 45m of the camp
function stalker_camp_builder.find_wiping_squad(camp)
    local sb = stalker_camp_builder
    local camp_pos = vector():set(camp.position.x, camp.position.y, camp.position.z)
    local sim = alife()
    if not (SIMBOARD and SIMBOARD.squads) then return nil end
    for id, squad in pairs(SIMBOARD.squads) do
        if squad and type(squad) == "table" and squad.position and squad.id ~= 0 and squad.id ~= camp.squad_id then
            local dist_ok, dist = pcall(function() return squad.position:distance_to(camp_pos) end)
            if dist_ok and dist <= 45 then
                if not (axr_companions and axr_companions.companion_squads and axr_companions.companion_squads[squad.id]) then
                    local squad_comm = squad.get_squad_community and squad:get_squad_community() or squad.player_id
                    if squad_comm and squad_comm ~= "" then
                        local rel = relation_registry.community_relation(squad_comm, camp.faction)
                        if rel and rel <= -1000 then
                            return squad
                        end
                    end
                end
            end
        end
    end
    return nil
end

-- squad_has_story_npc -- true if any squad member has a story_id (skip these
function stalker_camp_builder.squad_has_story_npc(squad)
    local sb = stalker_camp_builder
    if not story_objects or not story_objects.story_id_by_object_id then return false end
    for k in sb.safe_squad_members(squad) do
        if story_objects.story_id_by_object_id[k.id] then
            return true
        end
    end
    return false
end

-- get_level_factions -- returns the list of factions appropriate for a level
function stalker_camp_builder.get_level_factions(level_name)
    local scorcher_off = has_alife_info("bar_deactivate_radar_done") or (warfare and warfare.has_warfare and warfare.has_warfare())

    local level_faction_map = {
        k00_marsh = {"csky", "bandit", "stalker", "army"},
        l01_escape = {"stalker", "bandit", "army"},
        l02_garbage = {"bandit", "stalker", "dolg", "freedom"},
        l03_agroprom = {"army", "stalker", "bandit", "dolg"},
        k01_darkscape = {"stalker", "bandit", "killer"},
        k02_trucks_cemetery = {"bandit", "stalker", "dolg", "killer", "freedom"},
        y04_pole = {"stalker", "bandit"},
        l04_darkvalley = {"bandit", "freedom", "killer"},
        l05_bar = {"dolg", "stalker"},
        l06_rostok = {"killer", "dolg", "freedom", "stalker", "ecolog"},
        l08_yantar = {"ecolog", "stalker", "killer"},
        l09_deadcity = {"killer", "bandit", "stalker", "freedom"},

        l07_military = scorcher_off and {"freedom", "dolg", "killer", "monolith", "stalker"} or {"freedom", "dolg", "killer", "stalker"},
        jupiter = scorcher_off and {"stalker", "freedom", "dolg", "killer", "bandit", "ecolog", "monolith"} or {"stalker", "freedom", "dolg", "killer", "bandit", "ecolog"},
        zaton = scorcher_off and {"stalker", "bandit", "killer", "dolg", "freedom", "monolith"} or {"stalker", "bandit", "killer", "dolg", "freedom"},

        l10_radar = {"monolith", "freedom", "dolg", "stalker"},
        l10_red_forest = {"monolith", "stalker", "freedom", "dolg", "killer"},
        l10_limansk = {"monolith", "killer", "csky", "freedom"},
        l11_hospital = {"monolith", "csky", "killer"},
        l11_pripyat = {"monolith", "killer", "army", "stalker", "dolg", "freedom"},
        pripyat = {"monolith", "killer", "army", "stalker", "dolg", "freedom"},
        jupiter_underground = {"monolith", "killer", "zombied"},
        l12_stancia = {"monolith", "army"},
        l12_stancia_2 = {"monolith"},
        l12u_sarcofag = {"monolith"},
        l12u_control_monolith = {"monolith"},
        l13_generators = {"monolith"},
        l13u_warlab = {"monolith"}
    }
    local facs = level_name and level_faction_map[level_name]
    local base_list = facs and #facs > 0 and facs or (scorcher_off and {"stalker", "bandit", "csky", "army", "freedom", "dolg", "ecolog", "killer", "monolith"} or {"stalker", "bandit", "csky", "army", "freedom", "dolg", "ecolog", "killer"})

    local hour = level.get_time_hours()
    local is_day = (hour >= 6 and hour < 20)
    local weighted_facs = {}

    for _, f in ipairs(base_list) do
        weighted_facs[#weighted_facs+1] = f
        if is_day then
            if f == "dolg" or f == "army" or f == "ecolog" or f == "csky" then
                weighted_facs[#weighted_facs+1] = f
            end
        else
            if f == "bandit" or f == "killer" or f == "monolith" then
                weighted_facs[#weighted_facs+1] = f
            end
        end
    end

    return weighted_facs
end

-- get_dynamic_squad_section_for_faction -- returns a valid sim squad section
local FACTION_SQUAD_PREFIX = {
    ["killer"] = "merc",
    ["mercenary"] = "merc",
    ["dolg"] = "duty",
    ["duty"] = "duty",
    ["military"] = "army",
    ["army"] = "army",
}

function stalker_camp_builder.get_dynamic_squad_section_for_faction(faction, force_tier)
    local fac_prefix = FACTION_SQUAD_PREFIX[faction] or faction
    local tier = force_tier
    if not tier then
        local rank = (db.actor and db.actor.character_rank and db.actor:character_rank()) or 0
        local roll = math.random(100)
        if rank >= 6000 then
            -- High rank actor: 15% novice, 50% advanced, 35% veteran
            if roll <= 15 then
                tier = "_novice"
            elseif roll <= 65 then
                tier = "_advanced"
            else
                tier = "_veteran"
            end
        elseif rank >= 2500 then
            -- Mid rank actor: 30% novice, 50% advanced, 20% veteran
            if roll <= 30 then
                tier = "_novice"
            elseif roll <= 80 then
                tier = "_advanced"
            else
                tier = "_veteran"
            end
        else
            -- Early game: 55% novice, 35% advanced, 10% veteran
            if roll <= 55 then
                tier = "_novice"
            elseif roll <= 90 then
                tier = "_advanced"
            else
                tier = "_veteran"
            end
        end
    end

    local sec = fac_prefix .. "_sim_squad" .. tier
    if ini_sys:section_exist(sec) then
        return sec
    end
    if tier == "_veteran" and ini_sys:section_exist(fac_prefix .. "_sim_squad_advanced") then
        return fac_prefix .. "_sim_squad_advanced"
    end
    if ini_sys:section_exist(fac_prefix .. "_sim_squad_novice") then
        return fac_prefix .. "_sim_squad_novice"
    end
    if faction ~= fac_prefix then
        if ini_sys:section_exist(faction .. "_sim_squad" .. tier) then
            return faction .. "_sim_squad" .. tier
        end
        if tier == "_veteran" and ini_sys:section_exist(faction .. "_sim_squad_advanced") then
            return faction .. "_sim_squad_advanced"
        end
        if ini_sys:section_exist(faction .. "_sim_squad_novice") then
            return faction .. "_sim_squad_novice"
        end
    end
    if ini_sys:section_exist("stalker_sim_squad_novice") then
        return "stalker_sim_squad_novice"
    end
    return "bandit_sim_squad_novice"
end

-- the squad upgrade_rival_camp_tier adds at tier 3. An outpost that changes hands keeps its tier and
-- its furniture, so its new owner gets this squad too; nothing is built.
local function reinforce_stronghold(sb, camp, sim)
    if (camp.tier or 1) < 3 or not camp.position then return end
    local pos = vector():set(camp.position.x, camp.position.y, camp.position.z)
    local squad_sec = sb.get_dynamic_squad_section_for_faction(camp.faction or "stalker")
    local squad = sb.create_squad_at_pos(squad_sec, pos, camp.level_vertex_id, camp.game_vertex_id)
    if squad then
        sb.setup_rival_squad_positions(squad, camp, sim)
        camp.extra_squad_ids = camp.extra_squad_ids or {}
        table.insert(camp.extra_squad_ids, squad.id)
        enforce_rival_camp_survivor_cap(camp, true)
    end
end

local function process_single_rival_camp(key, camp, level_name, actor, current_sec, sb, v_scratch_pos)
    if type(camp) ~= "table" or not camp.chest_id then return end

    local se_chest = alife_object(camp.chest_id)
    if se_chest then
        if not camp.position then
            camp.position = {x = se_chest.position.x, y = se_chest.position.y, z = se_chest.position.z}
        end
        if not camp.level_vertex_id then
            camp.level_vertex_id = se_chest.m_level_vertex_id
        end
        if not camp.game_vertex_id then
            camp.game_vertex_id = se_chest.m_game_vertex_id
        end
        local sim = alife()
        if not camp.level and sim then
            local gg = game_graph()
            camp.level = sim:level_name(gg:vertex(se_chest.m_game_vertex_id):level_id())
        end
        local same_level = (camp.level == level_name)

        if (camp.level and sb.is_underground_level(camp.level)) or (camp.smart_name and sb.is_underground_smart(camp.smart_name)) then
            sb.remove_all_rival_map_spots(camp.chest_id)
            sb.release_camp_decorations(camp)
            cleanup_camp_convoys(camp.chest_id)
            if camp.squad_id and sim then
                local squad = sim:object(camp.squad_id)
                if squad and is_valid_camp_squad(camp, squad) then alife_release(squad) end
            end
            if camp.extra_squad_ids and sim then
                for _, ex_id in ipairs_(camp.extra_squad_ids) do
                    local ex_sq = sim:object(ex_id)
                    if ex_sq and is_valid_camp_squad(camp, ex_sq) then alife_release(ex_sq) end
                end
                camp.extra_squad_ids = nil
            end
            if m_data and m_data.player_created_stashes then
                m_data.player_created_stashes[camp.chest_id] = nil
            end
            alife_release(se_chest)
            sb.rival_camps[key] = nil
            return
        end

        -- also with no garrison id left (server_entity_on_unregister drops a released squad's id):
        -- an outpost not yet marked unoccupied still has to go through "garrison eliminated" below
        if camp.squad_id or (camp.extra_squad_ids and #camp.extra_squad_ids > 0) or camp.status ~= "unoccupied" then
            local squad = camp.squad_id and alife_object(camp.squad_id)
            -- a squad the player recruited as companions is no longer the garrison (before the
            -- check below, which rejects companion squads, here and for the extra squads)
            if squad and is_companion_squad(camp.squad_id) then
                release_rival_hold(sb, squad)
                squad, camp.squad_id = nil, nil
            end
            -- a dead squad is released and its id handed to a later object: forget an id that
            -- no longer names a squad (here and for the extra squads below)
            if not (squad and is_valid_camp_squad(camp, squad)) then
                squad, camp.squad_id = nil, nil
            end
            if camp.extra_squad_ids then
                for i = #camp.extra_squad_ids, 1, -1 do
                    local ex_id = camp.extra_squad_ids[i]
                    local ex_sq = alife_object(ex_id)
                    if ex_sq and is_companion_squad(ex_id) then
                        release_rival_hold(sb, ex_sq)
                        table.remove(camp.extra_squad_ids, i)
                    elseif not (ex_sq and is_valid_camp_squad(camp, ex_sq)) then
                        table.remove(camp.extra_squad_ids, i)
                    end
                end
                -- with the main squad gone, a surviving extra squad becomes the garrison
                if not camp.squad_id and #camp.extra_squad_ids > 0 then
                    camp.squad_id = table.remove(camp.extra_squad_ids, 1)
                    squad = alife_object(camp.squad_id)
                end
            end
            local has_alive = false
            if squad then
                for k in sb.safe_squad_members(squad) do
                    local is_alive = false
                    local online_obj = level.object_by_id(k.id)
                    if online_obj then
                        is_alive = online_obj:alive()
                    else
                        local se_obj = k.object or (k.id and sim and sim:object(k.id))
                        if se_obj and se_obj:alive() then
                            is_alive = true
                        end
                    end
                    if is_alive then
                        has_alive = true
                        break
                    end
                end
            end
            if not has_alive and camp.extra_squad_ids then
                for _, ex_id in ipairs_(camp.extra_squad_ids) do
                    local ex_sq = alife_object(ex_id)
                    if ex_sq and is_valid_camp_squad(camp, ex_sq) then
                        for k in sb.safe_squad_members(ex_sq) do
                            local is_alive = false
                            local online_obj = level.object_by_id(k.id)
                            if online_obj then
                                is_alive = online_obj:alive()
                            else
                                local se_obj = k.object or (k.id and sim and sim:object(k.id))
                                if se_obj and se_obj:alive() then
                                    is_alive = true
                                end
                            end
                            if is_alive then
                                has_alive = true
                                break
                            end
                        end
                    end
                    if has_alive then break end
                end
            end
            if has_alive then
                enforce_rival_camp_survivor_cap(camp, false)
                local lifespan = camp.setup_duration or (sb.cfg.rival_camp_setup_duration or 43200)
                -- an upgrade builds furniture, and at tier 3 a squad, at the chest: not in the player's
                -- sight. A camp that can still upgrade waits with its time-up roll too.
                local in_view = is_player_near(camp.level or level_name, camp.position)
                local may_upgrade = (camp.tier or 1) < 3 and sb.cfg.rival_camp_progression ~= false
                    and camp.status ~= "mutant_nest" and camp.faction ~= "zombied"
                if camp.setup_sec and (current_sec - camp.setup_sec >= lifespan) and not (in_view and may_upgrade) then
                    camp.tier = camp.tier or 1
                    local roll = mrandom(100)
                    local did_upgrade = false
                    local did_hold = false

                    if camp.status == "mutant_nest" then
                        -- a mutant pack doesn't fortify or resupply; when its time is up it moves on
                    elseif camp.faction == "zombied" then
                        -- nor do zombified stalkers; they hold until someone clears them out
                        camp.setup_sec = current_sec
                        did_hold = true
                    elseif camp.tier == 1 then
                        if roll <= 70 and sb.cfg.rival_camp_progression ~= false then
                            sb.upgrade_rival_camp_tier(camp, 2)
                            camp.setup_sec = current_sec
                            camp.setup_duration = mrandom(21600, 64800) -- 6 to 18 in-game hours
                            did_upgrade = true
                        end
                    elseif camp.tier == 2 then
                        if roll <= 85 and sb.cfg.rival_camp_progression ~= false then
                            sb.upgrade_rival_camp_tier(camp, 3)
                            camp.setup_sec = current_sec
                            camp.setup_duration = mrandom(28800, 86400) -- 8 to 24 in-game hours
                            did_upgrade = true
                        end
                    elseif camp.tier >= 3 then
                        if roll <= 90 then
                            camp.setup_sec = current_sec
                            camp.setup_duration = mrandom(28800, 86400) -- 8 to 24 in-game hours
                            did_hold = true
                            -- offline too: the supplies go into the chest's server object
                            local box_obj = level.object_by_id(camp.chest_id) or alife_object(camp.chest_id)
                            if box_obj then
                                local resupply_loot = {"ammo_5.45x39_fmj", "ammo_5.56x45_fmj", "ammo_7.62x39_fmj", "medkit_army", "bandage", "antirad", "conserva"}
                                for _ = 1, mrandom(2, 4) do
                                    local itm = resupply_loot[mrandom(#resupply_loot)]
                                    if ini_sys:section_exist(itm) then
                                        pcall(alife_create_item, itm, box_obj)
                                    end
                                end
                            end
                            if actor and same_level then
                                local fac_name = camp.faction and game.translate_string(camp.faction) or "Forces"
                                stalker_camp_builder.camp_send_tip(actor, sformat(game.translate_string("st_recon_camp_reinforced_stronghold"), fac_name, camp.name), nil, "general_stalker", 8000, nil, "general")
                            end
                        end
                    end

                    if not did_upgrade and not did_hold then
                        release_rival_hold(sb, squad)
                        for _, ex_id in ipairs_(camp.extra_squad_ids or {}) do
                            release_rival_hold(sb, alife_object(ex_id))
                        end

                        local best_base = nil
                        local min_base_dist = math.huge
                        local cx = camp.position and camp.position.x or 0
                        local cy = camp.position and camp.position.y or 0
                        local cz = camp.position and camp.position.z or 0
                        if SIMBOARD and SIMBOARD.smarts_by_names and sim then
                            for sname, smart in pairs_(SIMBOARD.smarts_by_names) do
                                if smart and smart.m_game_vertex_id and smart.position then
                                    local s_level = sim:level_name(game_graph():vertex(smart.m_game_vertex_id):level_id())
                                    if s_level == camp.level and not sb.is_underground_level(s_level) then
                                        local dx = smart.position.x - cx
                                        local dy = smart.position.y - cy
                                        local dz = smart.position.z - cz
                                        local d = msqrt(dx*dx + dy*dy + dz*dz)
                                        if d < min_base_dist and d > 20 then
                                            min_base_dist = d
                                            best_base = smart
                                        end
                                    end
                                end
                            end
                        end
                        if best_base and SIMBOARD and SIMBOARD.assign_squad_to_smart then
                            if squad then
                                pcall(function() SIMBOARD:assign_squad_to_smart(squad, best_base.id) end)
                            end
                            if camp.extra_squad_ids and sim then
                                for _, ex_id in ipairs_(camp.extra_squad_ids) do
                                    local ex_sq = sim:object(ex_id)
                                    if ex_sq then
                                        pcall(function() SIMBOARD:assign_squad_to_smart(ex_sq, best_base.id) end)
                                    end
                                end
                            end
                        end

                        camp.status = "unoccupied"
                        camp.unoccupied_time = current_sec
                        camp.ruins_decay_time = mrandom(7200, 18000) -- 2 to 5 game hours
                        local old_faction = camp.faction
                        camp.faction = nil
                        camp.squad_id = nil
                        camp.extra_squad_ids = nil
                        camp.cleared = true
                        camp.despawn_chest_when_empty = true
                        camp.pending_skirmish = nil
                        camp.pending_skirmish_resolve_time = nil

                        sb.sync_rival_camp_map_spot(camp)

                        if actor then
                            stalker_camp_builder.camp_send_tip(actor, sformat(game.translate_string("st_recon_camp_moved_on"), camp.name), nil, "general_stalker", 10000, nil, "general")
                        end
                    end
                else
                    if squad then
                        squad.get_script_target = function(self)
                            return self.id
                        end
                    end

                    if camp.status ~= "mutant_nest" and camp.faction ~= "monster" and camp.squad_id then
                        camp.heat = (camp.heat or 0) + 1
                        if camp.heat >= 25 then
                            camp.heat = 5
                            local has_active_heat_mutants = false
                            -- a pack stays at the outpost's smart terrain: none for one inside a settlement
                            local heat_smart = camp.smart_name and SIMBOARD and SIMBOARD.smarts_by_names
                                and SIMBOARD.smarts_by_names[camp.smart_name]
                            local smart_in_settlement = heat_smart and in_player_settlement(camp.level or level_name, heat_smart.position)
                            if camp.heat_mutant_squad_id then
                                local existing_m = sim:object(camp.heat_mutant_squad_id)
                                if existing_m and is_squad_alive(existing_m) and is_squad_monster[existing_m.player_id] then
                                    has_active_heat_mutants = true
                                    -- packs saved before this were sent at a squad id, which moves them nowhere;
                                    -- one parked in a settlement goes back to the simulation
                                    existing_m.scripted_target = (not smart_in_settlement) and camp.smart_name or nil
                                else
                                    camp.heat_mutant_squad_id = nil
                                end
                            end

                            local player_near = is_player_near(camp.level or level_name, camp.position)
                            -- off the player's level too: on most levels no spot lies beyond the switch
                            -- distance from an outpost
                            if not has_active_heat_mutants and not player_near and not smart_in_settlement
                                and mrandom(100) <= 20 then
                                local mutant_types = {"simulation_dog", "simulation_flesh", "simulation_boar", "simulation_snork", "simulation_bloodsucker"}
                                local msec = mutant_types[mrandom(#mutant_types)]
                                local mlvid, mgpos, mgvid
                                if same_level then
                                    local m_dist = mrandom(45, 80)
                                    local m_ang = mrandom() * math.pi * 2
                                    v_scratch_pos:set(camp.position.x + m_dist * mcos(m_ang), camp.position.y, camp.position.z + m_dist * msin(m_ang))
                                    mlvid, mgpos = sb.get_ground_vertex_and_pos(v_scratch_pos, camp.position.y, 3.0)
                                    mgvid = camp.game_vertex_id
                                else
                                    -- the ground can be probed only on the loaded level: elsewhere the pack starts,
                                    -- offline, at the outpost's smart terrain, which it heads for anyway
                                    local smart = camp.smart_name and SIMBOARD and SIMBOARD.smarts_by_names
                                        and SIMBOARD.smarts_by_names[camp.smart_name]
                                    if smart then
                                        mlvid, mgpos, mgvid = smart.m_level_vertex_id, smart.position, smart.m_game_vertex_id
                                    end
                                end
                                if mlvid and mgpos and not is_player_near(camp.level or level_name, mgpos)
                                    and not in_player_settlement(camp.level or level_name, mgpos) then
                                    local m_squad = sb.create_squad_at_pos(msec, mgpos, mlvid, mgvid, true)
                                    if m_squad and camp.squad_id then
                                        camp.heat_mutant_squad_id = m_squad.id
                                        -- the outpost's smart terrain, kept in the squad's save: the simulation moves a
                                        -- squad toward a smart terrain or the player, never toward another squad
                                        m_squad.scripted_target = camp.smart_name
                                    end
                                end
                            end
                        end
                    end

                    if sb.cfg.rival_camp_progression ~= false and camp.status ~= "mutant_nest" and camp.faction ~= "zombied"
                        and not in_view then
                        camp.tier = camp.tier or 1
                        camp.setup_sec = camp.setup_sec or current_sec
                        local age_hours = (current_sec - camp.setup_sec) / 3600

                        local t2_hours = sb.cfg.rival_camp_tier2_hours or 4
                        local t3_hours = sb.cfg.rival_camp_tier3_hours or 8

                        if camp.tier == 1 and age_hours >= t2_hours then
                            sb.upgrade_rival_camp_tier(camp, 2)
                        elseif camp.tier == 2 and age_hours >= t3_hours then
                            sb.upgrade_rival_camp_tier(camp, 3)
                        end
                    end

                    if sb.cfg.rival_camp_convoys ~= false and (camp.tier or 1) >= 2 and camp.status ~= "mutant_nest"
                        and camp.faction ~= "zombied" then
                        local convoy_interval = (sb.cfg.rival_camp_convoy_interval_hours or 6) * 3600
                        camp.last_convoy_time = camp.last_convoy_time or current_sec
                        if (current_sec - camp.last_convoy_time) >= convoy_interval then
                            camp.last_convoy_time = current_sec
                            sb.dispatch_rival_camp_convoy(camp)
                        end
                    end

                    local skirmish_cooldown_sec = 21600 -- 6 game hours
                    local is_on_cooldown = (camp.skirmish_cooldown_until and current_sec < camp.skirmish_cooldown_until)
                        or (camp.setup_sec and (current_sec - camp.setup_sec < skirmish_cooldown_sec))

                    local actor_dist = 999
                    if actor and camp.position then
                        local act_p = actor:position()
                        local dx = act_p.x - camp.position.x
                        local dy = act_p.y - camp.position.y
                        local dz = act_p.z - camp.position.z
                        actor_dist = msqrt(dx*dx + dy*dy + dz*dz)
                    end

                    -- 1. Trigger SOS distress encounter with a 3-minute response window
                    if not is_on_cooldown and not camp.pending_skirmish and mrandom(1000) <= 5 then -- 0.5% roll every 10s tick
                        local tf = (level and level.get_time_factor and level.get_time_factor()) or 10
                        if tf <= 0 then tf = 10 end
                        camp.skirmish_cooldown_until = current_sec + skirmish_cooldown_sec
                        camp.pending_skirmish = true
                        camp.pending_skirmish_resolve_time = current_sec + (180 * tf) -- 3 real minutes (180s) response countdown

                        if sb.cfg.rival_camp_distress_calls ~= false and not camp.sos_broadcasted and camp.status ~= "mutant_nest" then
                            local actor_comm = (actor and actor.character_community) and actor:character_community() or "stalker"
                            local rel = relation_registry.community_relation(camp.faction or "stalker", actor_comm)
                            if rel > -1000 then
                                camp.sos_broadcasted = true
                                camp.sos_active = true
                                camp.sos_time = current_sec
                                camp.sos_faction = camp.faction
                                local faction_name = game.translate_string(camp.faction or "stalker")
                                local lvl_name = game.translate_string(camp.level or level_name)
                                local mayday_text = sformat(game.translate_string("st_mayday_forces_taking_fire"), faction_name, camp.name, lvl_name)
                                if same_level or in_player_settlement(camp.level or level_name, camp.position) then
                                    if actor then
                                        stalker_camp_builder.camp_send_tip(actor, mayday_text, nil, "red_danger", 14000, nil, "combat", true)
                                    end
                                else
                                    stalker_camp_builder.add_camp_radio_log(nil, "combat", mayday_text)
                                end
                            end
                        end

                        if camp.status ~= "mutant_nest" then
                            sb.trigger_allied_reinforcement(camp)
                        end
                    end

                    -- 2. Resolve skirmish after the 3-minute countdown expires if player hasn't intervened
                    if camp.pending_skirmish and current_sec >= (camp.pending_skirmish_resolve_time or current_sec) then
                        camp.pending_skirmish = nil
                        camp.pending_skirmish_resolve_time = nil

                        local safe_dist = get_safe_switch_distance()
                        if not same_level or actor_dist > safe_dist then
                            local is_mutant_attack = (mrandom(100) <= 20)
                            if is_mutant_attack and camp.status ~= "mutant_nest" then
                                -- the Emission Effects & Mutant Nests option: off, the outpost holds
                                if sb.cfg.rival_camp_surge_effects ~= false then
                                    sb.transform_to_mutant_nest(camp, "simulation_bloodsucker")
                                end
                            else
                                local enemy_fac = nil
                                if camp.status == "mutant_nest" then
                                    local level_facs = sb.get_level_factions(camp.level or level_name)
                                    if level_facs and #level_facs > 0 then
                                        enemy_fac = level_facs[mrandom(#level_facs)]
                                    end
                                else
                                    enemy_fac = sb.get_enemy_faction_for(camp.faction or "stalker", camp.level or level_name)
                                end

                                if enemy_fac and mrandom(100) <= 45 then
                                    local old_fac_name = (camp.status == "mutant_nest") and "a mutant pack" or game.translate_string(camp.faction or "stalker")
                                    local new_fac_name = game.translate_string(enemy_fac)
                                    camp.status = nil -- Cleared mutant nest, back to active outpost!
                                    camp.faction = enemy_fac
                                    camp.setup_sec = current_sec
                                    camp.setup_duration = mrandom(21600, 64800)
                                    camp.skirmish_cooldown_until = current_sec + 21600

                                    local squad_pos = v_scratch_pos:set(camp.position.x, camp.position.y, camp.position.z)
                                    local squad_sec = sb.get_dynamic_squad_section_for_faction(enemy_fac)

                                    -- Clean up old garrison squad and members cleanly via alife_release
                                    local old_sq = camp.squad_id and sim:object(camp.squad_id)
                                    if old_sq then
                                        release_rival_hold(sb, old_sq)
                                        for k in sb.safe_squad_members(old_sq) do
                                            if k.id then
                                                if sb.camp_npc_released then sb.camp_npc_released[k.id] = nil end
                                                if sb.settler_lookup then sb.settler_lookup[k.id] = nil end
                                                local se_npc = sim:object(k.id)
                                                if se_npc then alife_release(se_npc) end
                                            end
                                        end
                                        alife_release(old_sq)
                                    end
                                    for _, ex_id in ipairs_(camp.extra_squad_ids or {}) do
                                        local ex_sq = sim:object(ex_id)
                                        if ex_sq then
                                            release_rival_hold(sb, ex_sq)
                                            for k in sb.safe_squad_members(ex_sq) do
                                                if k.id then
                                                    if sb.camp_npc_released then sb.camp_npc_released[k.id] = nil end
                                                    if sb.settler_lookup then sb.settler_lookup[k.id] = nil end
                                                    local se_npc = sim:object(k.id)
                                                    if se_npc then alife_release(se_npc) end
                                                end
                                            end
                                            alife_release(ex_sq)
                                        end
                                    end
                                    camp.extra_squad_ids = nil

                                    local new_squad = sb.create_squad_at_pos(squad_sec, squad_pos, camp.level_vertex_id, camp.game_vertex_id)
                                    if new_squad then
                                        camp.squad_id = new_squad.id
                                        sb.setup_rival_squad_positions(new_squad, camp, sim)
                                        reinforce_stronghold(sb, camp, sim)
                                        enforce_rival_camp_survivor_cap(camp, true)
                                    end

                                    local actor_comm = (actor and actor.character_community) and actor:character_community() or "stalker"
                                    local rel = relation_registry.community_relation(camp.faction, actor_comm)
                                    local is_hostile = (rel <= -1000)
                                    camp.cleared = not is_hostile
                                    sb.sync_rival_camp_map_spot(camp)
                                    local skirmish_text = sformat(game.translate_string("st_zone_skirmish_cleansed"), new_fac_name, camp.name, old_fac_name)
                                    if same_level or in_player_settlement(camp.level or level_name, camp.position) then
                                        if actor then
                                            stalker_camp_builder.camp_send_tip(actor, skirmish_text, nil, is_hostile and "red_danger" or "general_stalker", 12000, nil, "combat")
                                        end
                                    else
                                        stalker_camp_builder.add_camp_radio_log(nil, "combat", skirmish_text)
                                    end
                                end
                            end
                        end
                    end
                end
            else
                camp.status = "unoccupied"
                camp.unoccupied_time = current_sec
                camp.ruins_decay_time = mrandom(7200, 18000) -- 2 to 5 game hours
                local old_faction = camp.faction
                camp.faction = nil
                camp.squad_id = nil
                camp.extra_squad_ids = nil
                camp.cleared = true
                camp.despawn_chest_when_empty = true
                camp.pending_skirmish = nil
                camp.pending_skirmish_resolve_time = nil

                sb.sync_rival_camp_map_spot(camp)

                if actor then
                    local faction_name = old_faction and game.translate_string(old_faction) or "occupying"
                    stalker_camp_builder.camp_send_tip(actor, sformat(game.translate_string("st_recon_garrison_eliminated"), camp.name, faction_name), nil, "general_stalker", 10000, nil, "general")
                end

                if sb.cfg.rival_camp_retaliation_raids ~= false and old_faction and old_faction ~= "monster" and old_faction ~= "zombied" then
                    local actor_comm = (actor and actor.character_community) and actor:character_community() or "stalker"
                    local rel = relation_registry.community_relation(old_faction, actor_comm)
                    if rel <= -1000 then
                        sb.faction_retaliation_timers = sb.faction_retaliation_timers or {}
                        if not sb.faction_retaliation_timers[old_faction] then
                            sb.faction_retaliation_timers[old_faction] = current_sec + mrandom(7200, 14400) -- 2 to 4 game hours
                        end
                    end
                end
            end
        elseif camp.status == "unoccupied" then
            local occupant_squad = nil
            local occupant_faction = nil
            -- one takeover roll per abandonment; a won roll brings the new garrison 1 to 3 game
            -- hours later, and not while the player is within online switch distance
            if camp.takeover_at == nil then
                camp.takeover_at = false
                if mrandom(100) <= (sb.cfg.rival_friendly_takeover or 25) then
                    camp.takeover_at = current_sec + mrandom(3600, 10800)
                end
            end
            local player_near = is_player_near(camp.level or level_name, camp.position)
            if camp.takeover_at and current_sec >= camp.takeover_at and not player_near then
                local level_facs = sb.get_level_factions(camp.level or level_name)
                occupant_faction = level_facs[mrandom(#level_facs)]
                local camp_pos = v_scratch_pos:set(camp.position.x, camp.position.y, camp.position.z)
                local squad_sec = sb.get_dynamic_squad_section_for_faction(occupant_faction)
                occupant_squad = sb.create_squad_at_pos(squad_sec, camp_pos, camp.level_vertex_id, camp.game_vertex_id)
            end

            if occupant_squad then
                camp.status = nil
                camp.unoccupied_time = nil
                camp.takeover_at = nil
                camp.squad_id = occupant_squad.id
                sb.setup_rival_squad_positions(occupant_squad, camp, sim)
                camp.faction = occupant_faction
                reinforce_stronghold(sb, camp, sim)
                enforce_rival_camp_survivor_cap(camp, true)
                camp.cleared = false
                camp.despawn_chest_when_empty = nil
                camp.pending_skirmish = nil
                camp.pending_skirmish_resolve_time = nil
                camp.setup_sec = current_sec
                camp.setup_duration = mrandom(21600, 64800) -- 6 to 18 game hours
                camp.skirmish_cooldown_until = current_sec + 21600

                local actor_comm = (actor and actor.character_community) and actor:character_community() or "stalker"
                local rel = relation_registry.community_relation(camp.faction, actor_comm)
                local is_hostile = (rel <= -1000)
                camp.cleared = not is_hostile
                local faction_name = game.translate_string(camp.faction)

                sb.sync_rival_camp_map_spot(camp)

                if actor then
                    if is_hostile then
                        stalker_camp_builder.camp_send_tip(actor, sformat(game.translate_string("st_recon_camp_occupied_hostile"), camp.name, faction_name), nil, "red_danger", 12000, nil, "general")
                    else
                        stalker_camp_builder.camp_send_tip(actor, sformat(game.translate_string("st_recon_camp_claimed_friendly"), camp.name, faction_name), nil, "general_stalker", 10000, nil, "general")
                    end
                end
            elseif not camp.takeover_at then
                -- no takeover coming: the abandoned camp decays
                local is_empty = true
                local box_obj = level.object_by_id(camp.chest_id)
                if box_obj then
                    local function check_empty(temp, item)
                        is_empty = false
                    end
                    sb.safe_iterate_inventory_box(box_obj, check_empty)
                end

                -- the chest and furniture go in one update: not while the player can see them
                local player_far = not is_player_near(camp.level or level_name, camp.position)

                local decay_duration = camp.ruins_decay_time or 10800
                local time_expired = camp.unoccupied_time and (current_sec - camp.unoccupied_time >= decay_duration)

                if player_far and ((box_obj and is_empty) or time_expired) then
                    sb.remove_all_rival_map_spots(camp.chest_id)
                    sb.release_camp_decorations(camp)
                    cleanup_camp_convoys(camp.chest_id)
                    local lvl = camp.level or level_name
                    local cooldown_hours = mrandom(2, 4)
                    sb.dismantled_levels[lvl] = current_sec + cooldown_hours * 3600
                    release_rival_hold(sb, camp.squad_id and alife_object(camp.squad_id))
                    for _, ex_id in ipairs_(camp.extra_squad_ids or {}) do
                        release_rival_hold(sb, alife_object(ex_id))
                    end
                    if m_data and m_data.player_created_stashes then
                        m_data.player_created_stashes[camp.chest_id] = nil
                    end
                    local se_chest_to_del = alife_object(camp.chest_id)
                    if se_chest_to_del then
                        alife_release(se_chest_to_del)
                    end
                    sb.rival_camps[key] = nil
                    return
                end
            end
        end

    else
        sb.remove_all_rival_map_spots(camp.chest_id)
        sb.release_camp_decorations(camp)
        cleanup_camp_convoys(camp.chest_id)

        local lvl = camp.level or level_name

        -- no new camp on this level for 2 to 4 game hours
        local cooldown_hours = mrandom(2, 4)
        sb.dismantled_levels[lvl] = current_sec + cooldown_hours * 3600

        release_rival_hold(sb, camp.squad_id and alife_object(camp.squad_id))
        for _, ex_id in ipairs_(camp.extra_squad_ids or {}) do
            release_rival_hold(sb, alife_object(ex_id))
        end

        if m_data and m_data.player_created_stashes then
            m_data.player_created_stashes[camp.chest_id] = nil
        end

        if actor then
            stalker_camp_builder.camp_send_tip(actor, sformat(game.translate_string("st_recon_camp_destroyed"), camp.name), nil, "general_stalker", 10000, nil, "general")
        end

        sb.rival_camps[key] = nil
    end
end

-- update_rival_camps -- master rival-camp lifecycle manager.
function stalker_camp_builder.update_rival_camps()
    local actor = db.actor
    local sb = stalker_camp_builder
    local level_name = level.name()
    if not level_name or level_name == "" then return end

    local total_rival_camps = 0
    for key, camp in pairs_(sb.rival_camps) do
        if type(camp) == "table" and camp.chest_id then
            total_rival_camps = total_rival_camps + 1
        end
    end

    local current_sec = sb.game_sec()

    if sb.update_active_convoys then sb.update_active_convoys() end
    if sb.check_sos_rescue_reward then sb.check_sos_rescue_reward(actor) end

    -- v1.1.8: rival furniture MCM toggle -- when OFF, clear decor already
    -- placed at existing camps (release_camp_decorations is a no-op on
    -- camps that have none, so this is cheap per tick).
    if not rival_decor_enabled() then
        for key, c in pairs_(sb.rival_camps) do
            if type(c) == "table" and c.decorations and #c.decorations > 0 then
                sb.release_camp_decorations(c)
            end
        end
    end

    local v_scratch_pos = vector()
    for key, camp in pairs_(sb.rival_camps) do
        process_single_rival_camp(key, camp, level_name, actor, current_sec, sb, v_scratch_pos)
    end

    local now_tg_spawn = time_global()

    local is_surge = (surge_manager and surge_manager.is_started and surge_manager.is_started()) or false
    local is_psi = (psi_storm_manager and psi_storm_manager.is_started and psi_storm_manager.is_started()) or false
    local surge_active_now = is_surge or is_psi

    if sb.surge_was_active and not surge_active_now then
        if mrandom(100) <= 65 and total_rival_camps < sb.cfg.max_rival_camps then
            local levels_list = sb.get_all_levels_with_smarts()
            if #levels_list > 0 then
                local shuffled = {}
                for _, lvl in ipairs_(levels_list) do shuffled[#shuffled+1] = lvl end
                for i = #shuffled, 2, -1 do local j = mrandom(i); shuffled[i], shuffled[j] = shuffled[j], shuffled[i] end
                for _, target_lvl in ipairs_(shuffled) do
                    if sb.spawn_single_rival_camp(target_lvl) then
                        if actor then
                            stalker_camp_builder.camp_send_tip(actor, game.translate_string("st_recon_post_emission_expedition"), nil, "general_stalker", 10000, nil, "general")
                        end
                        break
                    end
                end
            end
        end
    end
    sb.surge_was_active = surge_active_now

    sb.faction_retaliation_timers = sb.faction_retaliation_timers or {}
    for retal_faction, target_retal_sec in pairs_(sb.faction_retaliation_timers) do
        if current_sec >= target_retal_sec then
            sb.faction_retaliation_timers[retal_faction] = nil
            if total_rival_camps < sb.cfg.max_rival_camps then
                local levels_list = sb.get_all_levels_with_smarts()
                if #levels_list > 0 then
                    local shuffled = {}
                    for _, lvl in ipairs_(levels_list) do shuffled[#shuffled+1] = lvl end
                    for i = #shuffled, 2, -1 do local j = mrandom(i); shuffled[i], shuffled[j] = shuffled[j], shuffled[i] end
                    for _, target_lvl in ipairs_(shuffled) do
                        if sb.spawn_single_rival_camp(target_lvl, retal_faction) then
                            if actor then
                                local fac_name = game.translate_string(retal_faction)
                                stalker_camp_builder.camp_send_tip(actor, sformat(game.translate_string("st_recon_retaliatory_expedition"), fac_name), nil, "red_danger", 10000, nil, "general")
                            end
                            break
                        end
                    end
                end
            end
        end
    end

    local base_interval_hours = sb.cfg.rival_camp_spawn_interval_hours or 3
    local spawn_interval_game_sec = sb.next_rival_spawn_interval_sec
    -- picked with the interval below and kept for the attempt it belongs to
    local spawn_chance = sb.next_rival_spawn_chance or sb.cfg.rival_camp_spawn_chance or 33

    if not spawn_interval_game_sec then
        if total_rival_camps == 0 then
            -- Guarantee one initial wilderness outpost attempt on fresh games.
            -- Previously a fresh game could lose the first 50% roll and then
            -- appear to have no rival-camp system for several in-game hours.
            spawn_interval_game_sec = 1
            spawn_chance = 100
        elseif total_rival_camps <= 3 then
            spawn_interval_game_sec = mrandom(5400, 7200)
            spawn_chance = 50
        elseif total_rival_camps >= 8 then
            spawn_interval_game_sec = mrandom(14400, 21600)
            spawn_chance = 25
        else
            local min_s = mfloor(base_interval_hours * 2400)
            local max_s = mfloor(base_interval_hours * 5400)
            spawn_interval_game_sec = mrandom(min_s, max_s)
        end

        if actor and actor.character_rank then
            local rank = actor:character_rank() or 0
            if rank >= 5000 then
                spawn_interval_game_sec = mfloor(spawn_interval_game_sec * 0.85)
            elseif rank < 1500 then
                spawn_interval_game_sec = mfloor(spawn_interval_game_sec * 1.25)
            end
        end
        sb.next_rival_spawn_interval_sec = spawn_interval_game_sec
        sb.next_rival_spawn_chance = spawn_chance
    end

    local last_attempt_sec = sb.last_rival_spawn_attempt_sec or 0
    local game_time_elapsed = current_sec - last_attempt_sec

    if total_rival_camps < sb.cfg.max_rival_camps
        and (now_tg_spawn - last_rival_spawn_scan_tg) >= RIVAL_SPAWN_SCAN_INTERVAL_MS
        and (game_time_elapsed >= spawn_interval_game_sec or last_attempt_sec == 0)
    then
        last_rival_spawn_scan_tg = now_tg_spawn
        sb.last_rival_spawn_attempt_sec = current_sec
        sb.next_rival_spawn_interval_sec = nil
        sb.next_rival_spawn_chance = nil

        local roll = mrandom(100)
        if sb.cfg.debug_logging then
            printf("[Homestead] Rival spawn attempt: camps=%d chance=%d roll=%d", total_rival_camps, spawn_chance, roll)
        end

        if roll <= spawn_chance then
            local levels_list = sb.get_all_levels_with_smarts()
            if #levels_list > 0 then
                local shuffled_levels = {}
                for i, lvl in ipairs_(levels_list) do
                    shuffled_levels[#shuffled_levels+1] = lvl
                end
                for i = #shuffled_levels, 2, -1 do
                    local j = mrandom(i)
                    shuffled_levels[i], shuffled_levels[j] = shuffled_levels[j], shuffled_levels[i]
                end

                local spawned = false
                for _, target_level in ipairs_(shuffled_levels) do
                    if total_rival_camps >= sb.cfg.max_rival_camps then break end
                    if sb.spawn_single_rival_camp(target_level) then
                        spawned = true
                        if sb.cfg.debug_logging then
                            printf("[Homestead] Rival camp spawned on %s", tostring(target_level))
                        end
                        break
                    end
                end
                if (not spawned) and sb.cfg.debug_logging then
                    printf("[Homestead] Rival spawn attempt found no valid off-level site")
                end
            end
        end
    end

    sb.restrain_rival_squads()
end

-- find_ground_anchor -- high-precision visual and AI grid surface detection.
find_ground_anchor = function(x, z, ref_y, smart_y)
    local sb = stalker_camp_builder
    local base_y = ref_y or smart_y or 0
    local target_lvid = nil
    local target_vpos = nil
    local surface_y = nil

    if sb.get_surface_y then
        surface_y = sb.get_surface_y(x, z, base_y, 4.0, 8.0)
    end

    if not surface_y and sb.get_surface_y then
        local probe_base = smart_y or base_y
        surface_y = sb.get_surface_y(x, z, probe_base, 15.0, 25.0)
    end

    if not surface_y and sb.get_surface_y then
        local high_y = math.max(base_y, smart_y or base_y) + 10.0
        surface_y = sb.get_surface_y(x, z, high_y, 5.0, 45.0)
    end

    if level and level.vertex_id then
        local pos_check = vector():set(x, surface_y or base_y, z)
        local lvid = level.vertex_id(pos_check)
        if lvid and lvid < 4294967295 and lvid ~= -1 then
            local vpos = level.vertex_position(lvid)
            if vpos then
                local dx = x - vpos.x
                local dz = z - vpos.z
                if (dx * dx + dz * dz) <= 25.0 then
                    target_lvid = lvid
                    target_vpos = vpos
                    if not surface_y and sb.get_surface_y then
                        surface_y = sb.get_surface_y(x, z, vpos.y, 2.5, 5.0)
                    end
                end
            end
        end

        if not target_lvid and sb.get_ground_vertex_and_pos then
            local vlvid, vgpos = sb.get_ground_vertex_and_pos(pos_check, surface_y or base_y, 6.0)
            if vlvid and vlvid < 4294967295 and vlvid ~= -1 then
                target_lvid = vlvid
                target_vpos = vgpos
                if not surface_y and vgpos and sb.get_surface_y then
                    surface_y = sb.get_surface_y(x, z, vgpos.y, 2.5, 5.0)
                end
            end
        end
    end

    -- The downward ray can hit a tree, rock overhang or roof above the spot.
    -- If it disagrees with the walkable ground height right here, trust the ground.
    if surface_y and target_vpos then
        local hdx = x - target_vpos.x
        local hdz = z - target_vpos.z
        if (hdx * hdx + hdz * hdz) <= 2.25 and math.abs(surface_y - target_vpos.y) > 0.5 then
            surface_y = target_vpos.y
        end
    end

    local final_y = surface_y or (target_vpos and target_vpos.y) or base_y
    return target_lvid, target_vpos, final_y, surface_y
end

-- snap_rival_camps_to_ground -- precision surface anchoring for chests,
function stalker_camp_builder.snap_rival_camps_to_ground()
    local sb = stalker_camp_builder
    if not sb or not sb.rival_camps then return end
    local level_name = level.name()
    if not level_name or level_name == "" then return end

    local sim = alife()
    if not sim then return end

    -- DANZY EDIT (v1.1.8: now MCM-gated): clear furniture already placed at existing rival camps (all maps).
    if not rival_decor_enabled() then
        for _, c in pairs(sb.rival_camps) do
            if type(c) == "table" and c.decorations and #c.decorations > 0 then
                sb.release_camp_decorations(c)
            end
        end
    end

    local has_work = false
    for _, c in pairs(sb.rival_camps) do
        if type(c) == "table" and c.level == level_name and c.chest_id then
            if (not c.ground_snapped_v4) or (not c.snapped)
                or (c.smart_name and sb.is_underground_smart(c.smart_name))
                or (c.level and sb.is_underground_level(c.level))
            then
                has_work = true
                break
            end
        end
    end
    if not has_work then return end

    local purged_any = false
    local v_target_chest = vector()
    local v_new_decor = vector()
    local v_probe = vector()
    local v_decor_angle = vector()

    for key, camp in pairs(sb.rival_camps) do
        if type(camp) == "table" and camp.level == level_name and camp.chest_id then
            if not rival_decor_enabled() and camp.decorations and #camp.decorations > 0 then
                sb.release_camp_decorations(camp)
            end
            if (camp.level and sb.is_underground_level(camp.level))
                or (camp.smart_name and sb.is_underground_smart(camp.smart_name))
            then
                sb.remove_all_rival_map_spots(camp.chest_id)
                sb.release_camp_decorations(camp)
                cleanup_camp_convoys(camp.chest_id)
                if camp.squad_id then
                    local squad = sim:object(camp.squad_id)
                    if squad and is_valid_camp_squad(camp, squad) then alife_release(squad) end
                end
                for _, ex_id in ipairs_(camp.extra_squad_ids or {}) do
                    local ex_sq = sim:object(ex_id)
                    if ex_sq and is_valid_camp_squad(camp, ex_sq) then alife_release(ex_sq) end
                end
                local se_c = sim:object(camp.chest_id)
                if se_c then alife_release(se_c) end
                if m_data and m_data.player_created_stashes then
                    m_data.player_created_stashes[camp.chest_id] = nil
                end
                sb.rival_camps[key] = nil
                purged_any = true
            else
                local se_chest = sim:object(camp.chest_id)
                if se_chest then
                    local pos = se_chest.position
                    local parent_smart = (camp.smart_name and SIMBOARD and SIMBOARD.smarts_by_names) and SIMBOARD.smarts_by_names[camp.smart_name]
                    local smart_y = parent_smart and parent_smart.position.y

                    -- the spot was picked on another level, untested: in a wall, a building or rubble the
                    -- chest has no AI node under it and may be out of the player's reach. Until the outpost
                    -- is snapped, such a chest steps toward its smart terrain to the first spot with a node,
                    -- or to the smart terrain's own, and the furniture moves with it
                    local shift_x, shift_z = 0, 0
                    local smart_lvid = parent_smart and parent_smart.m_level_vertex_id
                    if smart_lvid and smart_lvid < 4294967295 and not (camp.snapped and camp.ground_snapped_v4) then
                        local under = level.vertex_id(v_probe:set(pos.x, pos.y, pos.z))
                        if not (under and under < 4294967295) then
                            local sp = parent_smart.position
                            local to_x, to_z = sp.x - pos.x, sp.z - pos.z
                            local dist = msqrt(to_x * to_x + to_z * to_z)
                            local node = smart_lvid
                            for t = 0.5, dist, 0.5 do
                                local id = level.vertex_id(v_probe:set(pos.x + to_x * t / dist, pos.y, pos.z + to_z * t / dist))
                                if id and id < 4294967295 then
                                    node = id
                                    break
                                end
                            end
                            local np = level.vertex_position(node)
                            shift_x, shift_z = np.x - pos.x, np.z - pos.z
                        end
                    end

                    local clvid, cvpos, c_surface_y = find_ground_anchor(pos.x + shift_x, pos.z + shift_z, pos.y, smart_y)
                    local target_lvid = clvid or se_chest.m_level_vertex_id
                    if (not target_lvid or target_lvid >= 4294967295 or target_lvid == -1) and parent_smart then
                        target_lvid = parent_smart.m_level_vertex_id
                    end

                    local target_x = pos.x + shift_x
                    local target_z = pos.z + shift_z
                    if cvpos and ((target_x - cvpos.x)^2 + (target_z - cvpos.z)^2 > 9.0) then
                        target_x = cvpos.x
                        target_z = cvpos.z
                    end

                    local target_chest_y = c_surface_y + 0.08
                    local target_chest_pos = v_target_chest:set(target_x, target_chest_y, target_z)

                    local gvid = se_chest.m_game_vertex_id
                    if level.cross_table and level.cross_table() and target_lvid and target_lvid < 4294967295 and target_lvid ~= -1 then
                        pcall(function()
                            gvid = level.cross_table():vertex(target_lvid):game_vertex_id()
                        end)
                    end

                    local is_underground = (pos.y < (c_surface_y - 0.04))
                    local height_diff = math.abs(pos.y - target_chest_y)
                    local needs_snap = (not camp.ground_snapped_v4) or (not camp.snapped) or is_underground or (height_diff > 0.10)

                    if needs_snap then
                        se_chest.position = target_chest_pos
                        se_chest.m_level_vertex_id = target_lvid
                        se_chest.m_game_vertex_id = gvid

                        camp.position = { x = target_x, y = target_chest_y, z = target_z }
                        camp.level_vertex_id = target_lvid
                        camp.game_vertex_id = gvid
                    end

                    if camp.decorations then
                        local surviving = {}
                        for _, dec_id in ipairs(camp.decorations) do
                            local se_decor = sim:object(dec_id)
                            -- an id that no longer names outpost furniture is dropped, not moved
                            local is_decor = se_decor and sb.is_camp_decor(camp, dec_id, se_decor)
                            if is_decor then
                                local dpos = se_decor.position
                                local decor_x, decor_z = dpos.x + shift_x, dpos.z + shift_z
                                local dlvid, dvpos, d_surface_y, d_has_vis = find_ground_anchor(decor_x, decor_z, dpos.y, target_chest_y)
                                if not d_has_vis then
                                    local dlvid2, dvpos2, d_surface_y2, d_has_vis2 = find_ground_anchor(decor_x, decor_z, target_chest_y, target_chest_y)
                                    if d_has_vis2 then
                                        dlvid = dlvid2 or dlvid
                                        dvpos = dvpos2 or dvpos
                                        d_surface_y = d_surface_y2
                                        d_has_vis = true
                                    end
                                end
                                local final_dlvid = dlvid or target_lvid
                                if not final_dlvid or final_dlvid >= 4294967295 or final_dlvid == -1 then
                                    final_dlvid = target_lvid
                                end

                                local dgvid = gvid
                                if level.cross_table and level.cross_table() and final_dlvid and final_dlvid < 4294967295 and final_dlvid ~= -1 then
                                    pcall(function()
                                        dgvid = level.cross_table():vertex(final_dlvid):game_vertex_id()
                                    end)
                                end

                                local sec = se_decor:section_name() or ""
                                local clearance = 0.03
                                local final_decor_y = d_surface_y + clearance
                                local decor_is_underground = (dpos.y < (d_surface_y - 0.15))
                                local decor_is_floating = (dpos.y > (d_surface_y + 0.15))

                                local should_reanchor = needs_snap or decor_is_underground or decor_is_floating

                                if should_reanchor and sec ~= "" and ini_sys:section_exist(sec) then
                                    local new_dpos = v_new_decor:set(decor_x, final_decor_y, decor_z)
                                    se_decor.position = new_dpos
                                    se_decor.m_level_vertex_id = final_dlvid
                                    se_decor.m_game_vertex_id = dgvid
                                    surviving[#surviving + 1] = dec_id
                                    local cl_decor = level.object_by_id(dec_id)
                                    if cl_decor then
                                        pcall(function()
                                            local ps = cl_decor:get_physics_shell()
                                            if ps then ps:freeze() end
                                        end)
                                    end
                                else
                                    surviving[#surviving + 1] = dec_id
                                    local cl_decor = level.object_by_id(dec_id)
                                    if cl_decor then
                                        pcall(function()
                                            local ps = cl_decor:get_physics_shell()
                                            if ps then ps:freeze() end
                                        end)
                                    end
                                end
                            end
                        end
                        camp.decorations = surviving
                        if camp.decor_sections then
                            for dec_id, _ in pairs(camp.decor_sections) do
                                local still_in = false
                                for _, surviving_id in ipairs(surviving) do
                                    if surviving_id == dec_id then still_in = true; break end
                                end
                                if not still_in then camp.decor_sections[dec_id] = nil end
                            end
                        end
                    end

                    if camp.squad_id then
                        local squad = sim:object(camp.squad_id)
                        if squad and is_valid_camp_squad(camp, squad) then
                            sb.setup_rival_squad_positions(squad, camp, sim)
                        end
                    end

                    -- an inventory box takes its server position only when it spawns: while the chest
                    -- is online the camp stays marked unsnapped, so a later level entry snaps it again
                    if not level.object_by_id(camp.chest_id) then
                        camp.snapped = true
                        camp.ground_snapped_v2 = true
                        camp.ground_snapped_v4 = true
                    end
                end
            end
        end
    end

    if purged_any and sb.sync_all_camp_map_spots then
        sb.sync_all_camp_map_spots(true)
    end
end

-- force_respawn_all_rival_camps -- debug: dismantle all and re-spawn

-- get_rival_camp_theme_sections -- the placeable sections for a faction's camp, for its decor
-- and its tier upgrades (at file scope, so upgrade_rival_camp_tier can call it too)
local function get_rival_camp_theme_sections(faction)
    local fac = faction or "stalker"
    local walls = {"placeable_wall", "placeable_wall02"}
    local barricades = {"placeable_wall_divider", "placeable_wooden_board", "placeable_metal_plate"}
    local cover_prop = "placeable_barrel_metal"
    local stove_sec = "placeable_stove1"
    local seat_sec = "placeable_stool"
    local table_sec = "placeable_table1"
    local crate_sec = "placeable_box_wood"

    if fac == "bandit" or fac == "renegade" or fac == "greh" then
        walls = {"placeable_wall_metal", "placeable_wall02_metal", "placeable_wall"}
        barricades = {"placeable_wooden_board", "placeable_metal_plate", "placeable_wall_divider"}
        stove_sec = "placeable_stove1"
        seat_sec = "placeable_stool"
        table_sec = "placeable_table_2"
    elseif fac == "army" or fac == "dolg" or fac == "killer" or fac == "monolith" or fac == "isg" then
        walls = {"placeable_wall02_metal", "placeable_wall_metal", "placeable_wall_divider"}
        barricades = {"placeable_wall_divider", "placeable_metal_plate", "placeable_barrel_metal"}
        stove_sec = "placeable_stove2"
        seat_sec = "placeable_chair"
        table_sec = "placeable_metal_table1"
        crate_sec = "placeable_prop_ammo_box"
    else -- loner, csky, freedom, ecolog
        walls = {"placeable_wall", "placeable_wall02", "placeable_wall_metal"}
        barricades = {"placeable_wall_divider", "placeable_wooden_plank", "placeable_barrel_metal"}
        stove_sec = "placeable_stove1"
        seat_sec = "placeable_fchair"
        table_sec = "placeable_table1"
        crate_sec = "placeable_box_wood"
    end

    local function pick_existing(list, fallback)
        for _, s in ipairs(list) do
            if ini_sys:section_exist(s) then return s end
        end
        return ini_sys:section_exist(fallback) and fallback or nil
    end

    return {
        wall_main = pick_existing(walls, "placeable_wall"),
        wall_flank = pick_existing(barricades, "placeable_wall_divider"),
        cover = pick_existing({cover_prop, "placeable_box_wood"}, "placeable_barrel_metal"),
        stove = pick_existing({stove_sec, "placeable_stove1", "placeable_barrel_metal"}, "placeable_barrel_metal"),
        bed = pick_existing({"placeable_bed_1", "placeable_bed_2"}, "placeable_bed_1"),
        seat = pick_existing({seat_sec, "placeable_stool", "placeable_chair"}, "placeable_stool"),
        table = pick_existing({table_sec, "placeable_table1", "placeable_table_2"}, "placeable_table1"),
        crate = pick_existing({crate_sec, "placeable_box_wood"}, "placeable_box_wood"),
        ammo = pick_existing({"placeable_prop_ammo_box", "placeable_box_wood"}, "placeable_box_wood"),
        radio = pick_existing({"placeable_radio", "placeable_gas_lamp"}, "placeable_radio"),
        lamp = pick_existing({"placeable_gas_lamp", "placeable_metal_torch", "placeable_lamp1"}, "placeable_gas_lamp"),
        barrier_plate = pick_existing({"placeable_metal_plate", "placeable_wooden_board", "placeable_wooden_plank"}, "placeable_wooden_board"),
    }
end

-- is_rival_decor -- whether a server object is outpost furniture, i.e. its section is one the
-- themes above can spawn. Released ids are reused, so a stored decoration id is acted on only
-- while it still names one of these.
local rival_decor_sections = nil
function stalker_camp_builder.is_rival_decor(se_obj)
    if not rival_decor_sections then
        rival_decor_sections = {}
        for _, fac in ipairs({"stalker", "bandit", "renegade", "greh", "army", "dolg", "killer", "monolith",
                              "isg", "csky", "freedom", "ecolog", "zombied", "monster"}) do
            for _, sec in pairs(get_rival_camp_theme_sections(fac)) do
                rival_decor_sections[sec] = true
            end
        end
    end
    return se_obj ~= nil and rival_decor_sections[se_obj:section_name()] == true
end

-- is_camp_decor -- whether a stored decoration id still names this outpost's piece: the section
-- recorded when it was placed, or any outpost section for pieces placed before sections were kept
function stalker_camp_builder.is_camp_decor(camp, id, se_obj)
    if not se_obj then return false end
    local recorded = camp and camp.decor_sections and camp.decor_sections[id]
    if recorded then return se_obj:section_name() == recorded end
    return stalker_camp_builder.is_rival_decor(se_obj)
end

local function spawn_rival_camp_defenses_and_decor(camp_pos, lvid, gvid, target_level, occupant_faction)
    if not rival_decor_enabled() then return {}, mrandom() * math.pi * 2, {} end
    local sb = stalker_camp_builder
    local sim = alife()
    if not sim then return {}, 0, {} end

    local theme = get_rival_camp_theme_sections(occupant_faction)
    local camp_rot = mrandom() * math.pi * 2
    local cos_r = math.cos(camp_rot)
    local sin_r = math.sin(camp_rot)
    local level_name = level.name()
    local is_same_level = (target_level == level_name)

    -- Fortified tactical layout: perimeter defensive walls, chokepoint barricades, hearth & logistics
    local elements = {
        -- 1. DEFENSIVE PERIMETER WALLS & BARRICADES
        { section = theme.wall_main,    lx = 0.0,  lz = -3.2, yaw = 0.0 },              -- Main defensive rear wall
        { section = theme.wall_flank,   lx = -3.0, lz = -0.6, yaw = math.pi * 0.5 },     -- Left flank wall / barrier
        { section = theme.wall_flank,   lx = 3.0,  lz = -0.6, yaw = -math.pi * 0.5 },    -- Right flank wall / barrier
        
        -- 2. FRONT COMBAT COVER & BARRICADE (Chokepoint with entrance opening)
        { section = theme.cover,        lx = -1.6, lz = 2.8,  yaw = 0.0 },              -- Front left cover barrel
        { section = theme.barrier_plate,lx = -2.1, lz = 2.9,  yaw = math.pi * 0.1 },    -- Front left protective barrier
        { section = theme.cover,        lx = 1.6,  lz = 2.8,  yaw = 0.0 },              -- Front right cover barrel
        { section = theme.barrier_plate,lx = 2.1,  lz = 2.9,  yaw = -math.pi * 0.1 },   -- Front right protective barrier

        -- 3. HEARTH & LIVING (Inside the sheltered perimeter)
        { section = theme.stove,        lx = 0.0,  lz = 0.4,  yaw = 0.0 },              -- Central heating stove
        { section = theme.seat,         lx = 1.0,  lz = 0.5,  yaw = -math.pi * 0.6 },   -- Seat facing stove
        { section = theme.bed,          lx = -1.8, lz = -2.0, yaw = math.pi * 0.25 },   -- Sleeping cot tucked along back wall

        -- 4. SUPPLY & COMMAND DEPOT
        { section = theme.crate,        lx = 1.8,  lz = -2.0, yaw = -math.pi * 0.15 },  -- Large supply crate
        { section = theme.ammo,         lx = 2.1,  lz = -1.0, yaw = 0.0 },              -- Ammo crate
        { section = theme.table,        lx = -0.8, lz = -1.8, yaw = 0.0 },              -- Tactical planning table
        { section = theme.radio,        lx = -0.8, lz = -1.8, yaw = 0.0 },              -- Field radio
        { section = theme.lamp,         lx = 0.0,  lz = 1.2,  yaw = 0.0 },              -- Camp lighting
    }

    local decor_ids = {}
    local decor_sections = {}
    local spawned_positions = {}
    local MIN_DIST_SQ = 0.7 * 0.7
    local tolerance = sb.cfg.rival_camp_slope_tolerance or 2.5
    local clearance = 0.03

    local dpos = vector()
    local d_angle = vector()

    for _, elem in ipairs(elements) do
        local sec = elem.section
        if sec and sec ~= "" and ini_sys:section_exist(sec) then
            local wx = camp_pos.x + elem.lx * cos_r - elem.lz * sin_r
            local wz = camp_pos.z + elem.lx * sin_r + elem.lz * cos_r
            local wy = camp_pos.y
            local dec_lvid = lvid
            local valid = true

            if is_same_level then
                local found_lvid, dvpos, surface_y = find_ground_anchor(wx, wz, camp_pos.y, camp_pos.y)
                local final_y = surface_y or (dvpos and dvpos.y) or camp_pos.y
                if final_y and math.abs(final_y - camp_pos.y) <= (tolerance + 1.2) then
                    wy = final_y + clearance
                    dec_lvid = found_lvid or lvid
                else
                    valid = false
                end
            end

            if valid then
                for _, sp in ipairs(spawned_positions) do
                    local dx = wx - sp.x
                    local dz = wz - sp.z
                    if (dx * dx + dz * dz) < MIN_DIST_SQ and sec ~= theme.radio and sec ~= theme.lamp then
                        valid = false
                        break
                    end
                end
            end

            if valid then
                dpos:set(wx, wy, wz)
                local se_dec = sim:create(sec, dpos, dec_lvid, gvid)
                if se_dec then
                    local total_yaw = camp_rot + (elem.yaw or 0)
                    d_angle:set(0, total_yaw, 0)
                    se_dec.angle = d_angle
                    decor_ids[#decor_ids + 1] = se_dec.id
                    decor_sections[se_dec.id] = sec
                    spawned_positions[#spawned_positions + 1] = { x = wx, y = wy, z = wz }
                end
            end
        end
    end

    return decor_ids, camp_rot, decor_sections
end

-- spawn_single_rival_camp -- attempt to establish 1 rival camp on target_level
function stalker_camp_builder.spawn_single_rival_camp(target_level, specific_faction)
    local actor = db.actor
    local sim_alao = alife()
    local sb = stalker_camp_builder
    local level_name = level.name()
    if not sim_alao or not target_level or target_level == "" then return false end
    if sb.is_underground_level(target_level) then return false end
    -- DANZY EDIT: never spawn a new camp on the map the player is on (avoids the
    -- hitch of NPCs loading in nearby). Camps appear on other maps instead.
    if target_level == level_name then return false end

    local current_sec = sb.game_sec()

    local camps_here = 0
    for _, c in pairs_(sb.rival_camps) do
        if type_(c) == "table" and c.level == target_level and c.chest_id then
            camps_here = camps_here + 1
        end
    end

    local max_camps_per_map = sb.cfg.rival_camps_per_level_max or 3
    if camps_here >= max_camps_per_map then return false end

    local next_spawn_sec = sb.dismantled_levels[target_level]
    -- more than 4 game hours away can only be the old CTime:set wrap (~2e8 years): drop it
    if next_spawn_sec and next_spawn_sec > current_sec + 4 * 3600 then
        sb.dismantled_levels[target_level] = nil
        next_spawn_sec = nil
    end
    if next_spawn_sec and current_sec < next_spawn_sec then return false end

    local smarts = sb.get_smart_terrains_on_level(target_level)
    if not smarts or #smarts == 0 then return false end

    -- not at a smart terrain the game marks as inhabited by special characters (misc\smart_profiles.ltx
    -- [populated_smarts], loaded as simulation_objects.base_smarts)
    local populated = simulation_objects and simulation_objects.base_smarts or {}
    local shuffled_smarts = {}
    for _, s in ipairs_(smarts) do
        if populated[s.name] ~= true then
            shuffled_smarts[#shuffled_smarts+1] = s
        end
    end
    for i = #shuffled_smarts, 2, -1 do
        local j = mrandom(i)
        shuffled_smarts[i], shuffled_smarts[j] = shuffled_smarts[j], shuffled_smarts[i]
    end

    local pos = vector()
    local v_chest_angle = vector()
    local dpos = vector()
    local snapped_dpos = vector()
    local d_angle = vector()

    local level_facs_once = sb.get_level_factions(target_level)
    local smarts_tried = 0
    for _, smart_entry in ipairs_(shuffled_smarts) do
        local smart = smart_entry.obj
        local smart_name = smart_entry.name

        local smart_camp_count = 0
        for _, camp in pairs_(sb.rival_camps) do
            if type_(camp) == "table" and camp.smart_name == smart_name then
                smart_camp_count = smart_camp_count + 1
            end
        end

        if smart_camp_count < 1 and target_level == level_name then
            smarts_tried = smarts_tried + 1
            if smarts_tried > 4 then break end  -- DANZY EDIT: cap ground probing per spawn (stutter)
        end
        if smart_camp_count < 1 then
            local level_facs = level_facs_once
            local occupant_faction = specific_faction or level_facs[mrandom(#level_facs)]

            if occupant_faction then
                local attempts = 0
                local lvid, gvid
                local valid_pos = false
                local min_dist = sb.cfg.rival_camp_spawn_dist_min or 25
                local max_dist = sb.cfg.rival_camp_spawn_dist_max or 250
                local min_spacing_sqr = ((sb.cfg.rival_camp_min_spacing or 35) ^ 2)

                while attempts < 25 and not valid_pos do
                    attempts = attempts + 1
                    local angle = mrandom() * math.pi * 2

                    if target_level == level_name then
                        local dist = mrandom(25, math.min(max_dist, 55))
                        pos:set(
                            smart.position.x + dist * mcos(angle),
                            smart.position.y,
                            smart.position.z + dist * msin(angle)
                        )
                        local clvid, cvpos, c_surface_y = find_ground_anchor(pos.x, pos.z, smart.position.y, smart.position.y)
                        if clvid and c_surface_y then
                            pos.y = c_surface_y + 0.08
                            local actor_dist = db.actor and pos:distance_to(db.actor:position()) or 999
                            local req_dist = (attempts <= 15) and (sb.cfg.player_spawn_safety or 100) or 40
                            if actor_dist > req_dist and math.abs(c_surface_y - smart.position.y) <= 8.0 then
                                local far_from_player_camps = true
                                for hub_id, _ in pairs_(sb.active_camps) do
                                    local hub_obj = alife_object(hub_id)
                                    if hub_obj and hub_obj.position:distance_to_sqr(pos) < 1600 then
                                        far_from_player_camps = false
                                        break
                                    end
                                end
                                if far_from_player_camps then
                                    lvid = clvid
                                    gvid = smart.m_game_vertex_id
                                    if level.cross_table and level.cross_table() and lvid and lvid < 4294967295 and lvid ~= -1 then
                                        pcall(function()
                                            gvid = level.cross_table():vertex(lvid):game_vertex_id()
                                        end)
                                    end
                                    valid_pos = true
                                end
                            end
                        end
                    else
                        local dist = mrandom(20, 35)
                        pos:set(
                            smart.position.x + dist * mcos(angle),
                            smart.position.y,
                            smart.position.z + dist * msin(angle)
                        )
                        lvid = smart.m_level_vertex_id
                        gvid = smart.m_game_vertex_id
                        valid_pos = true
                    end

                    if valid_pos then
                        local far_from_rivals = true
                        local px, py, pz = pos.x, pos.y, pos.z
                        for _, rcamp in pairs_(sb.rival_camps) do
                            if type_(rcamp) == "table" and rcamp.position and rcamp.level == target_level then
                                local rpos = rcamp.position
                                local rx = (rpos.x or 0) - px
                                local ry = (rpos.y or 0) - py
                                local rz = (rpos.z or 0) - pz
                                if (rx * rx + ry * ry + rz * rz) < min_spacing_sqr then
                                    far_from_rivals = false
                                    break
                                end
                            end
                        end
                        if not far_from_rivals then
                            valid_pos = false
                        end
                        -- the settlement check above is in the same-level branch, which never runs
                        -- (new outposts go only to other levels): keep clear of the player's camps here
                        if valid_pos then
                            local clear_sqr = ((sb.cfg.boundary_dist or 50) + 15) ^ 2
                            for hub_id, pcamp in pairs_(sb.active_camps) do
                                local on_level = not pcamp.level or pcamp.level == "unknown" or pcamp.level == target_level
                                local hub_obj = on_level and alife_object(hub_id)
                                if hub_obj and hub_obj.position:distance_to_sqr(pos) < clear_sqr then
                                    valid_pos = false
                                    break
                                end
                            end
                        end
                    end
                end

                if valid_pos then
                    local chest_section = ini_sys:section_exist("placeable_blue_box") and "placeable_blue_box" or "inventory_box"
                    local se_chest = sim_alao:create(chest_section, pos, lvid, gvid)
                    if se_chest then
                        local rot = mrandom() * math.pi * 2
                        v_chest_angle:set(0, rot, 0)
                        se_chest.angle = v_chest_angle

                        local cpos = se_chest.position
                        local clvid = se_chest.m_level_vertex_id
                        local cgvi = se_chest.m_game_vertex_id
                        if treasure_manager and treasure_manager.set_random_stash then
                            treasure_manager.set_random_stash(true, "", nil, se_chest.id)
                            local is_gamma_mode = (stalker_camp_builder_gamma_flag ~= nil) or (grok_stashes_on_corpses ~= nil)
                            if not is_gamma_mode then
                                local items_str = treasure_manager.caches[se_chest.id]
                                if items_str and type_(items_str) == "string" then
                                    local spawned_items = str_explode(items_str, ",")
                                    for i = 1, #spawned_items do
                                        local item_sec = spawned_items[i]
                                        if item_sec and item_sec ~= "" and ini_sys:section_exist(item_sec) then
                                            sim_alao:create(item_sec, cpos, clvid, cgvi, se_chest.id)
                                        end
                                    end
                                end
                                treasure_manager.caches[se_chest.id] = nil
                            end
                        else
                            local initial_loot = {"medkit", "antirad", "conserva", "vodka", "ammo_9x18_fmj", "wpn_pm"}
                            for _, item in ipairs_(initial_loot) do
                                sim_alao:create(item, cpos, clvid, cgvi, se_chest.id)
                            end
                        end

                        if actor and actor.character_rank then
                            local rank = actor:character_rank() or 0
                            local bonus_count = math.min(3, math.floor(rank / 2000) + 1)
                            local high_level_loot = {
                                "ammo_5.45x39_fmj", "ammo_5.56x45_fmj", "ammo_7.62x39_fmj",
                                "medkit_army", "antirad", "specops_outfit",
                                "wpn_ak74", "wpn_l85", "wpn_lr300",
                                "grenade_rgd5", "grenade_f1",
                                "detector_elite", "vodka", "tushonka"
                            }
                            local mid_level_loot = {
                                "ammo_9x18_fmj", "ammo_9x19_fmj", "ammo_12x70_buck",
                                "medkit", "bandage", "antirad",
                                "wpn_pm", "wpn_fort", "wpn_bm16",
                                "conserva", "vodka", "bread"
                            }
                            local loot_table = (rank >= 5000) and high_level_loot or mid_level_loot
                            for i = 1, bonus_count do
                                local sec = loot_table[mrandom(#loot_table)]
                                if sec and ini_sys:section_exist(sec) then
                                    sim_alao:create(sec, cpos, clvid, cgvi, se_chest.id)
                                end
                            end
                        end

                        local translated_level = game.translate_string(target_level)
                        local garrison_roll = mrandom(100)
                        local is_stronghold = (garrison_roll <= 25)

                        local suffixes
                        if is_stronghold then
                            suffixes = {" Stronghold", " Fortress", " Command Post", " Garrison"}
                        elseif garrison_roll <= 65 then
                            suffixes = {" Outpost", " Camp", " Enclave"}
                        else
                            suffixes = {" Scout Post", " Patrol Camp", " Lookout"}
                        end
                        local name = translated_level .. suffixes[mrandom(#suffixes)] .. " #" .. tostring(mrandom(10, 99))

                        local actor_comm = actor and db.actor:character_community() or "stalker"
                        local rel = relation_registry.community_relation(occupant_faction, actor_comm)
                        local is_hostile = (rel <= -1000)
                        local faction_name = game.translate_string(occupant_faction)

                        local decor_ids, camp_rot, decor_secs = spawn_rival_camp_defenses_and_decor(pos, lvid, gvid, target_level, occupant_faction)

                        local squad_sec = sb.get_dynamic_squad_section_for_faction(occupant_faction)
                        local occupant_squad = sb.create_squad_at_pos(squad_sec, pos, lvid, gvid)
                        local squad_id_val = occupant_squad and occupant_squad.id or 0

                        local extra_squads = {}
                        if is_stronghold then
                            local sec_tier = (mrandom(100) <= 60) and "_novice" or "_advanced"
                            local sec_squad_sec = sb.get_dynamic_squad_section_for_faction(occupant_faction, sec_tier)
                            local sec_squad = sb.create_squad_at_pos(sec_squad_sec, pos, lvid, gvid)
                            if sec_squad then
                                extra_squads[#extra_squads + 1] = sec_squad.id
                            end
                        end

                        local camp_key = "rival_camp_" .. tostring(se_chest.id)
                        sb.rival_camps[camp_key] = {
                            chest_id = se_chest.id,
                            squad_id = squad_id_val,
                            extra_squad_ids = extra_squads,
                            faction = occupant_faction,
                            name = name,
                            smart_name = smart_name,
                            cleared = not is_hostile,
                            decorations = decor_ids,
                            decor_sections = decor_secs or {},
                            rotation = camp_rot,
                            level = target_level,
                            position = {x = pos.x, y = pos.y, z = pos.z},
                            level_vertex_id = lvid,
                            game_vertex_id = gvid,
                            snapped = (target_level == level_name),
                            ground_snapped_v2 = (target_level == level_name),
                            ground_snapped_v4 = (target_level == level_name),
                            setup_sec = current_sec,
                            setup_duration = mrandom(21600, 64800),
                            skirmish_cooldown_until = current_sec + 21600,
                            tier = 1
                        }

                        enforce_rival_camp_survivor_cap(sb.rival_camps[camp_key], true)

                        if occupant_squad then
                            sb.setup_rival_squad_positions(occupant_squad, sb.rival_camps[camp_key], sim_alao)
                        end
                        if is_stronghold and #extra_squads > 0 then
                            local sec_sq = alife_object(extra_squads[1])
                            if sec_sq then
                                sb.setup_rival_squad_positions(sec_sq, sb.rival_camps[camp_key], sim_alao)
                            end
                        end

                        sb.sync_rival_camp_map_spot(sb.rival_camps[camp_key])

                        if actor then
                            stalker_camp_builder.camp_send_tip(actor, sformat(game.translate_string("st_recon_new_camp_established"), translated_level, faction_name), nil, "general_stalker", 10000, nil, "general")
                        end
                        return true
                    end
                end
            end
        end
    end
    return false
end

-- force_respawn_all_rival_camps -- debug: dismantle all and re-spawn 1-4 camps
function stalker_camp_builder.force_respawn_all_rival_camps()
    local sb = stalker_camp_builder
    local sim = alife()
    if not sim then return end

    for key, camp in pairs(sb.rival_camps) do
        if type(camp) == "table" and camp.chest_id then
            sb.remove_all_rival_map_spots(camp.chest_id)

            if camp.squad_id then
                local squad = sim:object(camp.squad_id)
                if squad and is_valid_camp_squad(camp, squad) then
                    squad.get_script_target = nil
                    for k in sb.safe_squad_members(squad) do
                        if k.id then
                            if sb.camp_npc_released then sb.camp_npc_released[k.id] = nil end
                            if sb.settler_lookup then sb.settler_lookup[k.id] = nil end
                            local se_npc = sim:object(k.id)
                            if se_npc then alife_release(se_npc) end
                        end
                    end
                    alife_release(squad)
                end
            end
            if camp.extra_squad_ids then
                for _, ex_id in ipairs(camp.extra_squad_ids) do
                    local ex_sq = sim:object(ex_id)
                    if ex_sq and is_valid_camp_squad(camp, ex_sq) then
                        ex_sq.get_script_target = nil
                        for k in sb.safe_squad_members(ex_sq) do
                            if k.id then
                                if sb.camp_npc_released then sb.camp_npc_released[k.id] = nil end
                                if sb.settler_lookup then sb.settler_lookup[k.id] = nil end
                                local se_npc = sim:object(k.id)
                                if se_npc then alife_release(se_npc) end
                            end
                        end
                        alife_release(ex_sq)
                    end
                end
                camp.extra_squad_ids = nil
            end

            local se_chest = sim:object(camp.chest_id)
            if se_chest then
                alife_release(se_chest)
            end

            if m_data and m_data.player_created_stashes then
                m_data.player_created_stashes[camp.chest_id] = nil
            end

            sb.release_camp_decorations(camp)
            cleanup_camp_convoys(camp.chest_id)
        end
    end

    sb.rival_camps = {}
    sb.dismantled_levels = {}

    local target_count = math.random(2, 4)
    local spawned_count = 0
    local level_name = level.name()

    if level_name and level_name ~= "" and not sb.is_underground_level(level_name) then
        local current_smarts = sb.get_smart_terrains_on_level(level_name)
        if current_smarts and #current_smarts > 0 then
            if sb.spawn_single_rival_camp(level_name) then
                spawned_count = spawned_count + 1
            end
        end
    end

    local levels_list = sb.get_all_levels_with_smarts()
    if #levels_list > 0 then
        local shuffled_levels = {}
        for _, lvl in ipairs(levels_list) do
            if lvl ~= level_name then
                shuffled_levels[#shuffled_levels+1] = lvl
            end
        end
        for i = #shuffled_levels, 2, -1 do
            local j = math.random(i)
            shuffled_levels[i], shuffled_levels[j] = shuffled_levels[j], shuffled_levels[i]
        end

        for _, target_level in ipairs(shuffled_levels) do
            if spawned_count >= target_count then break end
            if sb.spawn_single_rival_camp(target_level) then
                spawned_count = spawned_count + 1
            end
        end
    end

    sb.snap_rival_camps_to_ground()
    sb.restrain_rival_squads()
    if sb.sync_all_camp_map_spots then sb.sync_all_camp_map_spots(true) end

    if db.actor then
        news_manager.send_tip(db.actor, string.format(game.translate_string("st_debug_refreshed_rival_camps"), spawned_count), nil, "general_stalker", 10000)
    end
end

-- 1. CAMP PROGRESSION & TIER EVOLUTION (Tier 1 -> Tier 2 -> Tier 3)
function stalker_camp_builder.upgrade_rival_camp_tier(camp, new_tier)
    local mrandom = math.random
    local sb = stalker_camp_builder
    local sim = alife()
    if not sim or not camp or not camp.chest_id then return end

    camp.tier = new_tier
    local chest_pos = vector():set(camp.position.x, camp.position.y, camp.position.z)
    local lvid = camp.level_vertex_id
    local gvid = camp.game_vertex_id
    local level_name = level.name()
    local same_level = (camp.level == level_name)

    camp.decorations = camp.decorations or {}

    if new_tier == 2 then
        local theme = get_rival_camp_theme_sections(camp.faction)
        local camp_rot = camp.rotation or 0
        local cos_r = math.cos(camp_rot)
        local sin_r = math.sin(camp_rot)

        -- Tier 2 Reinforced Outpost: extra defensive plates, ammo reserve, perimeter torch
        local t2_elements = {
            { section = theme.barrier_plate, lx = -2.8, lz = 2.0,  yaw = math.pi * 0.4 },
            { section = theme.barrier_plate, lx = 2.8,  lz = 2.0,  yaw = -math.pi * 0.4 },
            { section = theme.cover,         lx = 0.0,  lz = 3.6,  yaw = 0.0 },
            { section = theme.lamp,          lx = -1.6, lz = 2.8,  yaw = 0.0 },
            { section = theme.ammo,          lx = -1.8, lz = -1.2, yaw = 0.0 },
        }

        local dpos = vector()
        local d_angle = vector()
        local tolerance = sb.cfg.rival_camp_slope_tolerance or 2.5
        local clearance = 0.03

        if rival_decor_enabled() then
            for _, elem in ipairs(t2_elements) do
                local sec = elem.section
                if sec and ini_sys:section_exist(sec) then
                    local wx = chest_pos.x + elem.lx * cos_r - elem.lz * sin_r
                    local wz = chest_pos.z + elem.lx * sin_r + elem.lz * cos_r
                    local wy = chest_pos.y
                    local dec_lvid = lvid
                    local valid = true

                    if same_level then
                        local found_lvid, dvpos, d_surface_y = find_ground_anchor(wx, wz, chest_pos.y, chest_pos.y)
                        local final_y = d_surface_y or (dvpos and dvpos.y) or chest_pos.y
                        if final_y and math.abs(final_y - chest_pos.y) <= (tolerance + 1.2) then
                            wy = final_y + clearance
                            dec_lvid = found_lvid or lvid
                        else
                            valid = false
                        end
                    end

                    if valid then
                        dpos:set(wx, wy, wz)
                        local se_dec = sim:create(sec, dpos, dec_lvid, gvid)
                        if se_dec then
                            d_angle:set(0, camp_rot + (elem.yaw or 0), 0)
                            se_dec.angle = d_angle
                            camp.decorations[#camp.decorations + 1] = se_dec.id
                            if not camp.decor_sections then camp.decor_sections = {} end
                            camp.decor_sections[se_dec.id] = sec
                        end
                    end
                end
            end
        end

        -- offline too (upgrades wait until the player is away): into the chest's server object
        local box_obj = level.object_by_id(camp.chest_id) or alife_object(camp.chest_id)
        if box_obj then
            local t2_loot = {"medkit_army", "bandage", "antirad", "ammo_5.45x39_fmj", "ammo_5.56x45_fmj", "conserva", "vodka"}
            for _ = 1, mrandom(2, 4) do
                local itm = t2_loot[mrandom(#t2_loot)]
                if ini_sys:section_exist(itm) then
                    pcall(alife_create_item, itm, box_obj)
                end
            end
        end

        if not same_level then
            camp.snapped = false
            camp.ground_snapped_v4 = false
        end

        if db.actor and same_level then
            local fac_name = camp.faction and game.translate_string(camp.faction) or "Forces"
            stalker_camp_builder.camp_send_tip(db.actor, sformat(game.translate_string("st_recon_reinforced_outpost"), fac_name, camp.name), nil, "general_stalker", 10000, nil, "general")
        end

    elseif new_tier == 3 then
        local theme = get_rival_camp_theme_sections(camp.faction)
        local camp_rot = camp.rotation or 0
        local cos_r = math.cos(camp_rot)
        local sin_r = math.sin(camp_rot)

        -- Tier 3 Fortified Stronghold: heavy fortified rear wall, second shelter cot, heavy logistics
        -- The two rear segments meet the ends of the tier 1 wall, turned 18 degrees. Even More Hideout
        -- Furniture's walls are 2.35 m (wall02) or 4.7 m (wall, wall_metal) wide: at a fixed offset the
        -- wide ones cross the tier 1 wall and each other
        local wall_box = theme.wall_main and ini_sys:r_string_ex(theme.wall_main, "bounding_box_size")
        local wall_w = tonumber(wall_box and wall_box:match("^%s*([%d%.]+)")) or 2.35
        local wall_dx = wall_w * 0.5 * (1 + math.cos(math.pi * 0.1))
        local t3_elements = {
            { section = theme.wall_main,     lx = -wall_dx, lz = -3.2, yaw = math.pi * 0.1 },
            { section = theme.wall_main,     lx = wall_dx,  lz = -3.2, yaw = -math.pi * 0.1 },
            { section = theme.cover,         lx = -3.4, lz = 0.0,  yaw = 0.0 },
            { section = theme.cover,         lx = 3.4,  lz = 0.0,  yaw = 0.0 },
            { section = theme.bed,           lx = -2.2, lz = 0.8,  yaw = math.pi * 0.5 },
            { section = theme.crate,         lx = 0.8,  lz = -2.2, yaw = 0.0 },
        }

        local dpos = vector()
        local d_angle = vector()
        local tolerance = sb.cfg.rival_camp_slope_tolerance or 2.5
        local clearance = 0.03

        if rival_decor_enabled() then
            for _, elem in ipairs(t3_elements) do
                local sec = elem.section
                if sec and ini_sys:section_exist(sec) then
                    local wx = chest_pos.x + elem.lx * cos_r - elem.lz * sin_r
                    local wz = chest_pos.z + elem.lx * sin_r + elem.lz * cos_r
                    local wy = chest_pos.y
                    local dlvid = lvid
                    local valid = true

                    if same_level then
                        local dlvid_f, dvpos_f, d_surface_y_f = find_ground_anchor(wx, wz, chest_pos.y, chest_pos.y)
                        local final_y = d_surface_y_f or (dvpos_f and dvpos_f.y) or chest_pos.y
                        if final_y and math.abs(final_y - chest_pos.y) <= (tolerance + 1.2) then
                            wy = final_y + clearance
                            dlvid = dlvid_f or lvid
                        else
                            valid = false
                        end
                    end

                    if valid then
                        dpos:set(wx, wy, wz)
                        local se_dec = sim:create(sec, dpos, dlvid, gvid)
                        if se_dec then
                            d_angle:set(0, camp_rot + (elem.yaw or 0), 0)
                            se_dec.angle = d_angle
                            camp.decorations[#camp.decorations + 1] = se_dec.id
                            if not camp.decor_sections then camp.decor_sections = {} end
                            camp.decor_sections[se_dec.id] = sec
                        end
                    end
                end
            end
        end

        local box_obj = level.object_by_id(camp.chest_id) or alife_object(camp.chest_id)
        if box_obj then
            local t3_loot = {"medkit_scientic", "stimpack_army", "drug_psy_blockade", "ammo_7.62x54_7h1", "ammo_7.62x51_fmj", "af_iam", "cocaine"}
            for _ = 1, mrandom(3, 5) do
                local itm = t3_loot[mrandom(#t3_loot)]
                if ini_sys:section_exist(itm) then
                    pcall(alife_create_item, itm, box_obj)
                end
            end
        end

        local squad_sec = sb.get_dynamic_squad_section_for_faction(camp.faction or "stalker")
        local reinforce_squad = sb.create_squad_at_pos(squad_sec, chest_pos, lvid, gvid)
        if reinforce_squad then
            sb.setup_rival_squad_positions(reinforce_squad, camp, sim)
            -- tracked with the garrison, so it is counted, unpinned and released with it
            camp.extra_squad_ids = camp.extra_squad_ids or {}
            table.insert(camp.extra_squad_ids, reinforce_squad.id)
            enforce_rival_camp_survivor_cap(camp, true)
        end

        if not same_level then
            camp.snapped = false
            camp.ground_snapped_v4 = false
        end

        if db.actor then
            local fac_name = camp.faction and game.translate_string(camp.faction) or "Forces"
            local lvl_name = game.translate_string(camp.level or level_name)
            stalker_camp_builder.camp_send_tip(db.actor, sformat(game.translate_string("st_recon_expanded_stronghold"), fac_name, camp.name, lvl_name), nil, "general_stalker", 12000, nil, "general")
        end
    end
end

-- 2. SUPPLY CONVOYS & COURIER RUNS
stalker_camp_builder.active_convoys = stalker_camp_builder.active_convoys or {}

-- Note: is_player_near() is defined at top of file, dynamically respecting alife():switch_distance()

function stalker_camp_builder.dispatch_rival_camp_convoy(camp)
    local sb = stalker_camp_builder
    local sim = alife()
    if not sim or not camp or not camp.chest_id or not camp.level then return end
    if camp.status == "unoccupied" or camp.status == "mutant_nest" or camp.faction == "monster" then return end
    -- one courier at a time: a run that falls due while the last one is still out is skipped
    for _, conv in pairs(sb.active_convoys or {}) do
        if conv.target_camp_chest == camp.chest_id then return end
    end

    local smarts = sb.get_smart_terrains_on_level(camp.level)
    if not smarts or #smarts == 0 then return end

    local dest_smart = nil
    if camp.smart_name and SIMBOARD and SIMBOARD.smarts_by_names then
        dest_smart = SIMBOARD.smarts_by_names[camp.smart_name]
    end
    local cx = camp.position and camp.position.x or 0
    local cy = camp.position and camp.position.y or 0
    local cz = camp.position and camp.position.z or 0
    if not dest_smart then
        local min_d = math.huge
        for _, sm_entry in ipairs(smarts) do
            local sm = sm_entry.obj
            if sm and sm.position then
                local dx = sm.position.x - cx
                local dy = sm.position.y - cy
                local dz = sm.position.z - cz
                local d = dx*dx + dy*dy + dz*dz
                if d < min_d then
                    min_d = d
                    dest_smart = sm
                end
            end
        end
    end

    -- a courier waits at its smart terrain until it delivers: not one inside a settlement, and it
    -- doesn't set out from one either
    if dest_smart and in_player_settlement(camp.level, dest_smart.position) then return end

    local candidates = {}
    for _, sm_entry in ipairs(smarts) do
        local sm = sm_entry.obj
        if sm and sm.position and (not dest_smart or sm.id ~= dest_smart.id) then
            local dx = sm.position.x - cx
            local dy = sm.position.y - cy
            local dz = sm.position.z - cz
            if (dx*dx + dy*dy + dz*dz) >= 3600 and not is_player_near(camp.level, sm.position)
                and not in_player_settlement(camp.level, sm.position) then
                candidates[#candidates + 1] = sm
            end
        end
    end

    local start_smart = (#candidates > 0) and candidates[math.random(#candidates)] or smarts[math.random(#smarts)].obj
    if not start_smart or is_player_near(camp.level, start_smart.position)
        or in_player_settlement(camp.level, start_smart.position) then return end

    local squad_sec = sb.get_dynamic_squad_section_for_faction(camp.faction or "stalker")
    local start_pos = start_smart.position
    local start_lvid = start_smart.m_level_vertex_id
    local start_gvid = start_smart.m_game_vertex_id

    local courier_squad = sb.create_squad_at_pos(squad_sec, start_pos, start_lvid, start_gvid, true)
    if courier_squad then
        local target_smart_id = dest_smart and dest_smart.id
        if target_smart_id then
            -- kept in the squad's save, unlike a function; get_script_target looks the name up
            courier_squad.scripted_target = dest_smart:name()
            if SIMBOARD and SIMBOARD.assign_squad_to_smart then
                pcall(function() SIMBOARD:assign_squad_to_smart(courier_squad, target_smart_id) end)
            end
        end

        sb.active_convoys[courier_squad.id] = {
            squad_id = courier_squad.id,
            target_camp_chest = camp.chest_id,
            target_smart_id = target_smart_id,
            target_pos = {x = cx, y = cy, z = cz},
            target_lvid = camp.level_vertex_id,
            target_gvid = camp.game_vertex_id,
            faction = camp.faction,
            section = squad_sec,
            dispatch_time = sb.game_sec(),
            level = camp.level
        }
    end
end

function stalker_camp_builder.update_active_convoys()
    local sb = stalker_camp_builder
    local sim = alife()
    if not sim then return end

    local current_sec = sb.game_sec()

    for squad_id, convoy in pairs(sb.active_convoys) do
        local squad = sim:object(squad_id)
        if squad and courier_id_reused(sim, squad_id, convoy) then squad = nil end
        if not squad or not is_squad_alive(squad) then
            sb.active_convoys[squad_id] = nil
        elseif is_companion_squad(squad_id) then
            -- recruited by the player: theirs now, handed back rather than released
            squad.get_script_target = nil
            sb.active_convoys[squad_id] = nil
        else
            local se_chest = sim:object(convoy.target_camp_chest)
            local overdue = current_sec - (convoy.dispatch_time or current_sec) > 7200
            -- an offline squad isn't drawn: past its two-hour mark it finishes with the player near too
            if is_player_near(convoy.level, squad.position) and (squad.online or not overdue) then
                -- the courier neither delivers nor vanishes while the player can see it
            elseif not se_chest then
                -- Destination outpost was dismantled or destroyed; release courier
                squad.get_script_target = nil
                for k in sb.safe_squad_members(squad) do
                    if k.id then
                        local se_npc = sim:object(k.id)
                        if se_npc then alife_release(se_npc) end
                    end
                end
                alife_release(squad)
                sb.active_convoys[squad_id] = nil
            else
                local dx = squad.position.x - convoy.target_pos.x
                local dy = squad.position.y - convoy.target_pos.y
                local dz = squad.position.z - convoy.target_pos.z
                local dist_sqr = dx*dx + dy*dy + dz*dz

                local dist_to_smart_sqr = 999999
                if convoy.target_smart_id then
                    local sm = sim:object(convoy.target_smart_id)
                    if sm and sm.position then
                        local sx = squad.position.x - sm.position.x
                        local sy = squad.position.y - sm.position.y
                        local sz = squad.position.z - sm.position.z
                        dist_to_smart_sqr = sx*sx + sy*sy + sz*sz
                    end
                end

                if dist_sqr <= 1225.0 or dist_to_smart_sqr <= 1225.0 or overdue then
                    local target_chest = (level and level.object_by_id(convoy.target_camp_chest)) or se_chest
                    if target_chest then
                        local delivery_items = {"conserva", "kolbasa", "vodka", "bandage", "medkit", "ammo_5.45x39_fmj", "ammo_5.56x45_fmj"}
                        for _ = 1, math.random(3, 5) do
                            local itm = delivery_items[math.random(#delivery_items)]
                            if ini_sys:section_exist(itm) then
                                pcall(alife_create_item, itm, target_chest)
                            end
                        end
                    end

                    squad.get_script_target = nil
                    for k in sb.safe_squad_members(squad) do
                        if k.id then
                            local se_npc = sim:object(k.id)
                            if se_npc then alife_release(se_npc) end
                        end
                    end
                    alife_release(squad)
                    sb.active_convoys[squad_id] = nil
                end
            end
        end
    end
end

-- 3. SURGE ZOMBIFICATION & MUTANT NEST SYSTEM
function stalker_camp_builder.process_rival_camp_surge(is_peak)
    local sb = stalker_camp_builder
    local sim = alife()
    if not sim or sb.cfg.rival_camp_surge_effects == false then return end

    local current_sec = sb.game_sec()

    local actor = db.actor
    local actor_level = level.name()
    for key, camp in pairs(sb.rival_camps) do
        if type(camp) == "table" and camp.chest_id and camp.squad_id and camp.status ~= "unoccupied" and camp.status ~= "mutant_nest" and camp.faction ~= "zombied"
            and not is_companion_squad(camp.squad_id) then
            -- not in plain sight: the garrison is released and a zombie squad spawned at the chest
            local near = is_player_near(camp.level or actor_level, camp.position)
            if not near and math.random(100) <= 25 then
                sb.zombify_rival_camp(camp)
            end
        end
    end
end

function stalker_camp_builder.zombify_rival_camp(camp)
    local sb = stalker_camp_builder
    local sim = alife()
    if not sim or not camp or not camp.chest_id then return end

    -- only what is still a squad: a freed id may name another object by now
    if camp.squad_id then
        local old_squad = sim:object(camp.squad_id)
        if old_squad and is_valid_camp_squad(camp, old_squad) then
            for k in sb.safe_squad_members(old_squad) do
                if k.id then
                    if sb.camp_npc_released then sb.camp_npc_released[k.id] = nil end
                    if sb.settler_lookup then sb.settler_lookup[k.id] = nil end
                    local se_obj = sim:object(k.id)
                    if se_obj then alife_release(se_obj) end
                end
            end
            alife_release(old_squad)
        end
    end
    if camp.extra_squad_ids then
        for _, ex_id in ipairs(camp.extra_squad_ids) do
            local ex_sq = sim:object(ex_id)
            if ex_sq and is_valid_camp_squad(camp, ex_sq) then
                for k in sb.safe_squad_members(ex_sq) do
                    if k.id then
                        if sb.camp_npc_released then sb.camp_npc_released[k.id] = nil end
                        if sb.settler_lookup then sb.settler_lookup[k.id] = nil end
                        local se_obj = sim:object(k.id)
                        if se_obj then alife_release(se_obj) end
                    end
                end
                alife_release(ex_sq)
            end
        end
        camp.extra_squad_ids = nil
    end

    local squad_pos = vector():set(camp.position.x, camp.position.y, camp.position.z)
    local zomb_squad = sb.create_squad_at_pos("zombied_sim_squad_novice", squad_pos, camp.level_vertex_id, camp.game_vertex_id)
    if zomb_squad then
        camp.squad_id = zomb_squad.id
        camp.faction = "zombied"
        camp.cleared = false

        sb.sync_rival_camp_map_spot(camp)

        if db.actor then
            local lvl_name = game.translate_string(camp.level or level.name())
            stalker_camp_builder.camp_send_tip(db.actor, sformat(game.translate_string("st_recon_psy_surge_zombified"), camp.name, lvl_name), nil, "red_danger", 14000, nil, "general")
        end
    end
end

function stalker_camp_builder.transform_to_mutant_nest(camp, mutant_type)
    local sb = stalker_camp_builder
    local sim = alife()
    if not sim or not camp or not camp.chest_id then return end

    if camp.squad_id then
        local old_squad = sim:object(camp.squad_id)
        if old_squad and is_valid_camp_squad(camp, old_squad) then
            for k in sb.safe_squad_members(old_squad) do
                if k.id then
                    if sb.camp_npc_released then sb.camp_npc_released[k.id] = nil end
                    if sb.settler_lookup then sb.settler_lookup[k.id] = nil end
                    local se_obj = sim:object(k.id)
                    if se_obj then alife_release(se_obj) end
                end
            end
            alife_release(old_squad)
        end
    end
    if camp.extra_squad_ids then
        for _, ex_id in ipairs(camp.extra_squad_ids) do
            local ex_sq = sim:object(ex_id)
            if ex_sq and is_valid_camp_squad(camp, ex_sq) then
                for k in sb.safe_squad_members(ex_sq) do
                    if k.id then
                        if sb.camp_npc_released then sb.camp_npc_released[k.id] = nil end
                        if sb.settler_lookup then sb.settler_lookup[k.id] = nil end
                        local se_obj = sim:object(k.id)
                        if se_obj then alife_release(se_obj) end
                    end
                end
                alife_release(ex_sq)
            end
        end
        camp.extra_squad_ids = nil
    end

    mutant_type = mutant_type or "simulation_bloodsucker"

    camp.status = "mutant_nest"
    camp.faction = "monster"
    camp.cleared = false
    camp.unoccupied_time = nil
    camp.despawn_chest_when_empty = nil
    camp.pending_skirmish = nil
    camp.pending_skirmish_resolve_time = nil
    -- the pack's stay starts now; the lost garrison's timer doesn't carry over
    camp.setup_sec = sb.game_sec()
    camp.setup_duration = mrandom(21600, 64800) -- 6 to 18 in-game hours

    local squad_pos = vector():set(camp.position.x, camp.position.y, camp.position.z)
    local mutant_squad = sb.create_squad_at_pos(mutant_type, squad_pos, camp.level_vertex_id, camp.game_vertex_id)
    if mutant_squad then
        camp.squad_id = mutant_squad.id
    end

    sb.sync_rival_camp_map_spot(camp)

    if db.actor then
        local lvl_name = game.translate_string(camp.level or level.name())
        stalker_camp_builder.camp_send_tip(db.actor, sformat(game.translate_string("st_recon_mutant_overrun_den"), camp.name, lvl_name), nil, "red_danger", 12000, nil, "combat")
    end
end

-- 4. ALLIED REINFORCEMENTS & RETALIATION HIT SQUADS
function stalker_camp_builder.trigger_allied_reinforcement(defending_camp)
    local sb = stalker_camp_builder
    local sim = alife()
    if not sim or not defending_camp or not defending_camp.position then return end

    local def_pos = vector():set(defending_camp.position.x, defending_camp.position.y, defending_camp.position.z)
    for key, other_camp in pairs(sb.rival_camps) do
        if type(other_camp) == "table" and other_camp ~= defending_camp and other_camp.squad_id and other_camp.faction == defending_camp.faction and other_camp.level == defending_camp.level and other_camp.position then
            local dx = defending_camp.position.x - other_camp.position.x
            local dy = defending_camp.position.y - other_camp.position.y
            local dz = defending_camp.position.z - other_camp.position.z
            if (dx*dx + dy*dy + dz*dz) <= 30625 then
                local ally_squad = sim:object(other_camp.squad_id)
                if ally_squad and is_valid_camp_squad(other_camp, ally_squad) then
                    local tg = time_global()
                    local reinforce_until = tg + 120000 -- 2 minutes reinforcement mission duration
                    sb.rival_npc_patrol = sb.rival_npc_patrol or {}
                    for k in sb.safe_squad_members(ally_squad) do
                        if k.id then
                            local p_data = sb.rival_npc_patrol[k.id]
                            if not p_data then
                                p_data = { target_lvid = nil, wait_until = 0, last_move_tg = tg }
                                sb.rival_npc_patrol[k.id] = p_data
                            end
                            p_data.reinforce_until = reinforce_until
                            p_data.reinforce_pos = def_pos
                            p_data.reinforce_lvid = defending_camp.level_vertex_id
                            p_data.reinforce_camp = defending_camp
                            p_data.target_lvid = defending_camp.level_vertex_id
                            p_data.wait_until = 0
                            p_data.last_move_tg = tg
                            if level.object_by_id(k.id) then
                                sb.camp_npc_move_to(k.id, defending_camp.level_vertex_id, def_pos)
                            end
                        end
                    end
                    break
                end
            end
        end
    end
end

-- 5. SOS RESCUE REWARD & GRATITUDE
function stalker_camp_builder.check_sos_rescue_reward(actor)
    local sb = stalker_camp_builder
    if not actor then return end

    local actor_pos = actor:position()
    local current_sec = sb.game_sec()

    for key, camp in pairs(sb.rival_camps) do
        -- a call lapses two game hours after it went out, wherever the player is, and once the
        -- camp has changed hands
        if type(camp) == "table" and camp.sos_active
            and (current_sec - (camp.sos_time or current_sec) > 7200 or camp.faction ~= camp.sos_faction) then
            camp.sos_active = false
            camp.sos_broadcasted = false
            camp.pending_skirmish = nil
            camp.pending_skirmish_resolve_time = nil
        end
        if type(camp) == "table" and camp.sos_active and camp.chest_id and camp.position and camp.level == level.name() then
            local dx = actor_pos.x - camp.position.x
            local dy = actor_pos.y - camp.position.y
            local dz = actor_pos.z - camp.position.z
            local dist_sqr = dx*dx + dy*dy + dz*dz

            if dist_sqr <= 1600.0 and camp.squad_id then
                local squad = alife_object(camp.squad_id)
                if squad and is_squad_alive(squad) then
                    camp.sos_active = false
                    camp.sos_broadcasted = false
                    camp.pending_skirmish = nil
                    camp.pending_skirmish_resolve_time = nil

                    local reward_rubles = math.random(3000, 5500)
                    dialogs.relocate_money_to_actor(db.actor, nil, reward_rubles)

                    local faction_name = camp.faction and game.translate_string(camp.faction) or "Stalkers"
                    stalker_camp_builder.camp_send_tip(actor, string.format(game.translate_string("st_recon_rescue_complete"), faction_name, reward_rubles), nil, "general_stalker", 12000, nil, "general", true)
                end
            end
        end
    end
end
