-- stalker_camp_builder_events.script
-- Homestead camp raids and random camp events (split out of stalker_camp_builder.script).
-- Exposed on the main table: process_camp_random_events, trigger_random_camp_event,
-- process_camp_raids, spawn_camp_raid, check_completed_raids (end_camp_raid is defined here too).
-- Owns the raid / random-event cooldown timers; save_state and load_state reach them through
-- get_event_timers / set_event_timers.
-- Depends on stalker_camp_builder.cfg / defaults and the helpers it qualifies below.

local mrandom = math.random
local cfg = stalker_camp_builder.cfg
local defaults = stalker_camp_builder.defaults

local last_raid_game_sec = nil
local last_random_event_sec = nil

function stalker_camp_builder.get_event_timers()
    return last_raid_game_sec, last_random_event_sec
end

function stalker_camp_builder.set_event_timers(raid_sec, event_sec)
    last_raid_game_sec = raid_sec
    last_random_event_sec = event_sec
end

local process_camp_random_events, trigger_random_camp_event, process_camp_raids, spawn_camp_raid, check_completed_raids

function process_camp_random_events()
    local current_sec = stalker_camp_builder.game_sec()

    if last_random_event_sec then
        local elapsed = current_sec - last_random_event_sec
        if elapsed < cfg.event_cooldown then
            return
        end
    end

    local player_pos = db.actor:position()
    local cur_lvl = level.name()
    for hub_id, camp in pairs(stalker_camp_builder.active_camps) do
        if not camp.level or camp.level == cur_lvl then
            if stalker_camp_builder.sync_timer_scale then stalker_camp_builder.sync_timer_scale(camp) end
            local hub_obj = alife_object(hub_id)
            if hub_obj and hub_obj.position then
                local dist = hub_obj.position:distance_to(player_pos)
                if dist <= cfg.event_player_dist then
                    camp.last_event_check_time = camp.last_event_check_time or current_sec
                    local check_elapsed = current_sec - camp.last_event_check_time
                    if check_elapsed >= cfg.event_check_interval then -- check once every 2 game hours
                        camp.last_event_check_time = current_sec

                        if math.random(100) <= cfg.event_chance then
                            last_random_event_sec = current_sec
                            trigger_random_camp_event(hub_id, camp, hub_obj)
                            break
                        end
                    end
                end
            end
        end
    end
end

function trigger_random_camp_event(hub_id, camp, hub_obj)
    local mrandom = math.random
    local events = {"refugees", "migration"}
    -- a caravan still at the camp owns active_trader_id; a second one would strand it
    local trader = camp.active_trader_id and alife_object(camp.active_trader_id)
    if not (trader and IsStalker(trader) and trader:alive()) then
        events[#events+1] = "caravan"
    end

    local harvesters = {}
    for id, struct_type in pairs(camp.structures or {}) do
        local se_obj = alife_object(id)
        if se_obj and se_obj:section_name() == "placeable_artifact_harvester" then
            local h_data = hf_obj_manager.get_data(id)
            if h_data and h_data.artifact_section and h_data.artifact_section ~= "" and (h_data.artifact_condition or 1.0) > 0.01 then
                harvesters[#harvesters+1] = id
            end
        end
    end
    if #harvesters > 0 then
        events[#events+1] = "harvester_degrade"
    end

    local chosen_event = events[mrandom(#events)]

    if chosen_event == "refugees" then
        local spawn_lvid, spawn_pos = stalker_camp_builder.get_furniture_front_vertex_and_pos(hub_obj.position, 2.0)
        local pos = spawn_pos or vector():set(hub_obj.position.x + 1.5, hub_obj.position.y + 0.1, hub_obj.position.z)
        local lvi = spawn_lvid or hub_obj.m_level_vertex_id
        local se_refugee = alife():create("stalker_regular", pos, lvi, hub_obj.m_game_vertex_id)
        if se_refugee then
            -- stalker_regular is a Loner, an enemy of several factions the player and the settlers
            -- can belong to: once online, the refugee takes the camp's faction (refugee_on_net_spawn)
            local comm = stalker_camp_builder.get_camp_dominant_faction and stalker_camp_builder.get_camp_dominant_faction(camp)
                or get_actor_true_community and get_actor_true_community()
            stalker_camp_builder.refugee_ids[se_refugee.id] = { arrived_sec = stalker_camp_builder.game_sec(), pending_community = stalker_camp_builder.save_safe_faction and stalker_camp_builder.save_safe_faction(comm) or comm }
            stalker_camp_builder.camp_send_tip(db.actor, game.translate_string("st_event_refugees_arrived"), nil, "general_stalker", 12000)
        end
    elseif chosen_event == "migration" then
        -- a point with a level vertex under it: a squad created near the player comes online on its
        -- creation vertex, so the hub's vertex would bring the pack up inside the camp
        local spawn_pos, spawn_lvi
        for _ = 1, 8 do
            local angle = mrandom() * 2 * math.pi
            local r_dist = mrandom(70, 90)
            local lvid = level.vertex_id(vector():set(
                hub_obj.position.x + r_dist * math.cos(angle),
                hub_obj.position.y,
                hub_obj.position.z + r_dist * math.sin(angle)
            ))
            if lvid and lvid < 4294967295 and lvid ~= -1 then
                spawn_pos, spawn_lvi = level.vertex_position(lvid), lvid
                break
            end
        end
        local spawn_gvi = db.actor:game_vertex_id()
        if spawn_lvi and level.cross_table and level.cross_table() then
            spawn_gvi = level.cross_table():vertex(spawn_lvi):game_vertex_id()
        end

        local mutant_sections = {"simulation_dog", "simulation_boar", "simulation_tushkano"}
        local sec = mutant_sections[mrandom(#mutant_sections)]
        local squad = spawn_lvi and stalker_camp_builder.create_squad_at_pos(sec, spawn_pos, spawn_lvi, spawn_gvi, true)
        if squad then
            -- a squad can head only for a squad, a smart terrain or the player, and the hub is
            -- furniture: the pack comes at the player, who is at the camp when this fires
            squad.get_script_target = function(self)
                return AC_ID
            end
            stalker_camp_builder.camp_send_tip(db.actor, game.translate_string("st_event_mutant_migration"), nil, "red_danger", 15000, hub_id, "combat", true)
            local has_alarm = false
            local alarm_pos = hub_obj.position
            for id, struct_type in pairs(camp.structures) do
                if struct_type == "alarm" then
                    local se_alarm = alife_object(id)
                    if se_alarm then
                        alarm_pos = se_alarm.position
                        has_alarm = true
                        break
                    end
                end
            end
            if has_alarm then
                local snd = sound_object([[ambient\siren1]])
                if snd then snd:play_at_pos(db.actor, alarm_pos) end
            end
        end
    elseif chosen_event == "caravan" then
        local spawn_lvid, spawn_pos = stalker_camp_builder.get_furniture_front_vertex_and_pos(hub_obj.position, 2.2)
        local pos = spawn_pos or vector():set(hub_obj.position.x + 2, hub_obj.position.y + 0.1, hub_obj.position.z)
        local lvi = spawn_lvid or hub_obj.m_level_vertex_id
        local sec, comm = "stalker_regular", "stalker"
        if stalker_camp_builder.get_camp_trader_section then
            sec, comm = stalker_camp_builder.get_camp_trader_section(camp)
        end
        local se_trader = alife():create(sec, pos, lvi, hub_obj.m_game_vertex_id)
        if se_trader then
            camp.active_trader_id = se_trader.id
            camp.trader_spawn_time = stalker_camp_builder.game_sec()
            camp.trader_needs_stock = true
            camp.trader_community = stalker_camp_builder.save_safe_faction and stalker_camp_builder.save_safe_faction(comm) or comm
            stalker_camp_builder.guarded_call("prosper_on_trader_arrived", stalker_camp_builder.prosper_on_trader_arrived, hub_id, camp)

            CreateTimeEvent("homestead_trader_init", "init_" .. tostring(se_trader.id), 0.1, function()
                local trader_cl = level.object_by_id(se_trader.id)
                if trader_cl and trader_cl.alive and trader_cl:alive() then
                    pcall(function()
                        if trader_cl.set_character_community then
                            trader_cl:set_character_community(comm, 0, 0)
                        end
                        if trader_cl.set_relation and db.actor then
                            trader_cl:set_relation(game_object.friend, db.actor)
                        end
                    end)
                end
                return true
            end)

            stalker_camp_builder.camp_send_tip(db.actor, game.translate_string("st_event_caravan_arrived"), nil, "general_stalker", 12000)
        end
    elseif chosen_event == "harvester_degrade" then
        local harv_id = harvesters[mrandom(#harvesters)]
        local h_data = hf_obj_manager.get_data(harv_id) or {}
        local art_sec = h_data.artifact_section
        hf_obj_manager.update_data(harv_id, {
            artifact_condition = 0.01,
            progress_sec = 0
        })
        -- the harvester reads its artifact's own condition on every update and writes it over
        -- artifact_condition: damage the artifact (0 is a cleared slot, and object 0 the player)
        local art_id = tonumber(h_data.artifact_item_id)
        local art = art_id and art_id > 0 and level.object_by_id(art_id)
        if art then
            art:set_condition(0.01)
        end
        local obj = level.object_by_id(harv_id)
        local binder = obj and obj:binded_object()
        local wrapper = binder and binder.wrapper
        if wrapper then
            wrapper.artifact_condition = 0.01
            wrapper.progress_sec = 0
            if wrapper.refresh_sound_state then wrapper:refresh_sound_state() end
        end
        local art_name = game.translate_string(ini_sys:r_string_ex(art_sec, "inv_name") or art_sec)
        stalker_camp_builder.camp_send_tip(db.actor, string.format(game.translate_string("st_event_harvester_degraded"), camp.name or "camp"), nil, "general_stalker", 12000)
    end
end

function spawn_camp_raid(hub_id, camp, hub_obj, opts)
    opts = opts or {}
    local actor = db.actor
    local mrandom = math.random
    local hub_pos = hub_obj.position
    local boundary = cfg.boundary_dist or 50
    local min_spawn_dist = math.max(boundary + 15, 60)
    local max_spawn_dist = min_spawn_dist + 40

    local valid_spawn_pos, valid_spawn_lvi, valid_spawn_gvi = nil, nil, nil

    local ray_angles = {}
    for i = 1, 16 do ray_angles[i] = (i - 1) * (math.pi / 8) end
    for i = #ray_angles, 2, -1 do
        local j = mrandom(i)
        ray_angles[i], ray_angles[j] = ray_angles[j], ray_angles[i]
    end

    local test_p = vector()
    for _, angle in ipairs(ray_angles) do
        for test_dist = min_spawn_dist, max_spawn_dist, 10 do
            test_p:set(
                hub_pos.x + test_dist * math.cos(angle),
                hub_pos.y,
                hub_pos.z + test_dist * math.sin(angle)
            )
            local test_lvi, actual_p = stalker_camp_builder.get_ground_vertex_and_pos(test_p, hub_pos.y, 10.0)
            if test_lvi and actual_p and actual_p:distance_to(hub_pos) >= (boundary + 5) then
                valid_spawn_pos = actual_p
                valid_spawn_lvi = test_lvi
                if level.cross_table and level.cross_table() then
                    valid_spawn_gvi = level.cross_table():vertex(test_lvi):game_vertex_id()
                else
                    valid_spawn_gvi = actor and actor:game_vertex_id() or 0
                end
                break
            end
        end
        if valid_spawn_pos then break end
    end

    if not valid_spawn_pos then
        return
    end

    local spawn_pos = valid_spawn_pos
    local spawn_lvi = valid_spawn_lvi
    local spawn_gvi = valid_spawn_gvi

    local sb = stalker_camp_builder
    local actor_comm = actor and character_community(actor) or "stalker"
    -- a disguise changes character_community (gameplay_disguise): pick by the player's own faction
    local true_fac = actor and stalker_camp_builder.get_player_faction and stalker_camp_builder.get_player_faction()
    if true_fac then
        actor_comm = "actor_" .. true_fac
    end
    -- the player's community is "actor_<faction>"; the fallback below compares faction names
    local actor_fac = actor_comm:gsub("^actor_", "")

    local section = nil
    local raid_faction = nil
    if opts.faction then
        raid_faction = opts.faction
        local vet_sec = raid_faction .. "_sim_squad_veteran"
        local adv_sec = raid_faction .. "_sim_squad_advanced"
        if ini_sys and ini_sys:section_exist(vet_sec) then
            section = vet_sec
        elseif ini_sys and ini_sys:section_exist(adv_sec) then
            section = adv_sec
        elseif sb.get_dynamic_squad_section_for_faction then
            section = sb.get_dynamic_squad_section_for_faction(raid_faction)
        else
            section = adv_sec
        end
        if not (ini_sys and ini_sys:section_exist(section)) then
            section = "monolith_sim_squad_veteran"
            raid_faction = "monolith"
        end
    elseif mrandom(100) <= 35 then
        local mutant_squads = {
            "simulation_snork",
            "simulation_bloodsucker",
            "simulation_psy_dog",
            "zombied_sim_squad_veteran",
            "zombied_sim_squad_advanced"
        }
        section = mutant_squads[mrandom(#mutant_squads)]
    else
        local enemy_fac = sb.get_enemy_faction_for and sb.get_enemy_faction_for(actor_comm, level.name())
        if not enemy_fac or enemy_fac == actor_fac or enemy_fac == "stalker" or enemy_fac == "ecolog" then
            if actor_fac == "bandit" or actor_fac == "renegade" then
                enemy_fac = "stalker"
            elseif actor_fac == "dolg" or actor_fac == "army" then
                enemy_fac = "freedom"
            elseif actor_fac == "freedom" then
                enemy_fac = "dolg"
            else
                enemy_fac = "bandit"
            end
        end

        if sb.get_dynamic_squad_section_for_faction then
            section = sb.get_dynamic_squad_section_for_faction(enemy_fac)
        else
            section = enemy_fac .. "_sim_squad_advanced"
        end

        raid_faction = enemy_fac
        if not (ini_sys and ini_sys:section_exist(section)) then
            section = "monolith_sim_squad_veteran"
            raid_faction = "monolith"
        end
    end

    local squad = stalker_camp_builder.create_squad_at_pos(section, spawn_pos, spawn_lvi, spawn_gvi, true)
    if squad then
        -- kept in the squad's save, unlike a function: get_script_target reads "actor" as the player
        squad.scripted_target = "actor"
        squad.rush = true

        local function enforce_raid_hostility()
            for k in stalker_camp_builder.safe_squad_members(squad) do
                local npc_cl = k.id and level.object_by_id(k.id)
                if npc_cl and npc_cl.set_relation then
                    npc_cl:set_relation(game_object.enemy, actor)
                    if camp and camp.survivors then
                        for s_id, s_data in pairs(camp.survivors) do
                            local s_cl = level.object_by_id(s_id)
                            if s_cl and s_cl.set_relation then
                                npc_cl:set_relation(game_object.enemy, s_cl)
                                s_cl:set_relation(game_object.enemy, npc_cl)
                            end
                        end
                    end
                end
            end
        end

        enforce_raid_hostility()

        CreateTimeEvent("homestead_raid_hostile_1_" .. squad.id, "hostile", 0.5, function()
            enforce_raid_hostility()
            return true
        end)
        CreateTimeEvent("homestead_raid_hostile_2_" .. squad.id, "hostile", 2.0, function()
            enforce_raid_hostility()
            return true
        end)

        local squad_size = 0
        for k in stalker_camp_builder.safe_squad_members(squad) do
            squad_size = squad_size + 1
        end
        camp.active_raid = {
            squad_id = squad.id,
            start_sec = stalker_camp_builder.game_sec(),
            raiders_killed = 0,
            guards_lost = 0,
            faction = raid_faction,   -- nil for a mutant pack: no faction to blame
            settlers_lost = 0,
            original_squad_size = squad_size,
            remaining_count = squad_size,
            is_retaliation = opts.is_retaliation or false,
        }
        if opts.is_retaliation then
            local camp_name = camp.name or "Settlement"
            local fac_name = game.translate_string(raid_faction or "hostiles")
            stalker_camp_builder.camp_send_tip(actor, string.format(game.translate_string("st_event_camp_retaliation_attack"), camp_name, fac_name), nil, "red_danger", 15000, hub_id, "combat", true)
        else
            stalker_camp_builder.camp_send_tip(actor, string.format(game.translate_string("st_event_camp_under_attack"), game.translate_string(level.name()), game.translate_string("st_hostiles") or "hostiles"), nil, "red_danger", 15000, hub_id, "combat", true)
        end

        -- Raiders present in camp mobilize as defenders
        if camp and camp.survivors then
            for _, s_data in pairs(camp.survivors) do
                if s_data.job == "raider" then
                    s_data.raider = type(s_data.raider) == "table" and s_data.raider or {}
                    s_data.raider.defending = true
                end
            end
        end

        -- Guard ammo check (Living Needs Phase 5)
        if stalker_camp_builder.needs_process_guard_ammo then
            local stats = stalker_camp_builder.get_camp_stats(camp, hub_obj)
            local guards = (stats.guards or 0) + (stats.raider_guards or 0)
            if guards > 0 then
                stalker_camp_builder.needs_process_guard_ammo(hub_id, camp, guards)
            end
        end

        local has_alarm = false
        local alarm_pos = hub_obj.position
        for id, struct_type in pairs(camp.structures) do
            if struct_type == "alarm" then
                local se_alarm = alife_object(id)
                if se_alarm then
                    alarm_pos = se_alarm.position
                    has_alarm = true

                    if bind_alarm_system and bind_alarm_system.toggle_alarm_system then
                        local data = hf_obj_manager.get_data(id)
                        if data and not data.is_on then
                            bind_alarm_system.toggle_alarm_system(id)
                        end
                    end
                end
            end
        end
        if has_alarm then
            local snd = sound_object([[ambient\siren1]])
            if snd then
                snd:play_at_pos(db.actor, alarm_pos)
            end
        end
    end
end

-- has_active_alarm -- does this camp have a switched-on alarm siren
local function has_active_alarm(camp)
    for id, struct_type in pairs(camp.structures or {}) do
        if struct_type == "alarm" then
            local se = alife_object(id)
            if se then
                local data = hf_obj_manager and hf_obj_manager.get_data and hf_obj_manager.get_data(id)
                if data and data.is_on then
                    return true
                end
            end
        end
    end
    return false
end

function process_camp_raids()
    local current_sec = stalker_camp_builder.game_sec()

    if not last_raid_game_sec then
        last_raid_game_sec = current_sec
        return
    end

    local elapsed = current_sec - last_raid_game_sec
    if elapsed < cfg.raid_cooldown then
        check_completed_raids()
        return
    end

    local player_pos = db.actor:position()
    local cur_lvl = level.name()
    for hub_id, camp in pairs(stalker_camp_builder.active_camps) do
        -- perf: only whether the camp has a survivor matters, not how many (no full count per camp)
        if stalker_camp_builder.sync_timer_scale then stalker_camp_builder.sync_timer_scale(camp) end
        local has_survivor = camp.survivors and next(camp.survivors) ~= nil

        -- Pending faction retaliation strike check
        if camp.pending_retaliation and has_survivor then
            local pret = camp.pending_retaliation
            local hub_obj = alife_object(hub_id)
            if hub_obj and hub_obj.position then
                local on_same_level = (not camp.level or camp.level == cur_lvl)
                local dist = hub_obj.position:distance_to(player_pos)
                if on_same_level and dist <= cfg.event_player_dist then
                    if not camp.active_raid then
                        camp.pending_retaliation = nil
                        last_raid_game_sec = current_sec
                        spawn_camp_raid(hub_id, camp, hub_obj, { faction = pret.faction, is_retaliation = true })
                        break
                    end
                elseif (current_sec - (pret.due_sec or current_sec)) >= 86400 then
                    camp.pending_retaliation = nil
                    if stalker_camp_builder.resolve_offline_retaliation then
                        stalker_camp_builder.resolve_offline_retaliation(hub_id, camp, pret.faction)
                    end
                end
            end
        end

        -- a camp gets one raid cooldown of peace after it is founded
        local is_new = camp.created_time and (current_sec - camp.created_time) < cfg.raid_cooldown
        -- one raid at a time: a second would leave the first squad its "actor" target
        if has_survivor and not is_new and not camp.active_raid and (not camp.level or camp.level == cur_lvl) then
            local check_interval = cfg.raid_check_interval or defaults.raid_check_interval or 3600
            if not camp.last_raid_check_time or (current_sec - camp.last_raid_check_time) >= check_interval then
                camp.last_raid_check_time = current_sec
                local hub_obj = alife_object(hub_id)
                if hub_obj and hub_obj.position then
                    local dist = hub_obj.position:distance_to(player_pos)
                    if dist <= cfg.event_player_dist then
                        local stats = stalker_camp_builder.get_camp_stats(camp, hub_obj)
                        local defense_needed = stats.population * 3
                        local current_def = stats.defense
                        if has_active_alarm(camp) then
                            current_def = current_def + (cfg.alarm_defense_bonus or 15)
                        end
                        local defense_deficit = defense_needed - current_def
                        local raid_chance = cfg.raid_base_chance
                        if defense_deficit > 0 then
                            raid_chance = raid_chance + math.floor(defense_deficit * cfg.raid_deficit_mult)
                        end

                        if math.random(100) <= raid_chance then
                            last_raid_game_sec = current_sec
                            spawn_camp_raid(hub_id, camp, hub_obj)
                            break -- Process only one camp per tick
                        end
                    end
                end
            end
        end
    end

    check_completed_raids()
end

-- Reputation for settlers lost in a raid: the factions that are enemies of the raiders heard that you
-- could not hold your ground, and lose goodwill with you. Never the raiders (already hostile) or the
-- player's own faction. Counted at each settler death, paid once when the raid ends.
local RAID_REP_FALLBACK_FACTIONS = {
    "stalker", "bandit", "csky", "army", "freedom", "dolg", "ecolog", "killer", "monolith", "renegade", "greh", "isg",
}
local RAID_REP_SKIP = { monster = true, zombied = true, trader = true, none = true, arena_enemy = true, actor = true }

local function raid_rep_clean(comm)
    if type(comm) ~= "string" then return nil end
    return (string.gsub(comm, "^actor_", ""))
end

-- counts a settler killed by the raiders; called from npc_on_death_callback
function stalker_camp_builder.raid_note_settler_killed(camp, who)
    local raid = camp and camp.active_raid
    if not (raid and raid.faction and who and cfg.raid_rep_enabled) then return end
    local from_raid = false
    local wid = who:id()
    local se = wid and alife_object(wid)
    if se and se.group_id and se.group_id == raid.squad_id then
        from_raid = true
    elseif IsStalker(who) then
        from_raid = raid_rep_clean(who:character_community()) == raid.faction
    end
    if from_raid then
        raid.settlers_lost = (raid.settlers_lost or 0) + 1
    end
end

-- failed: the raiders were still standing when the raid ended; a raid that was beaten costs half
function stalker_camp_builder.raid_apply_reputation(raid, failed)
    local actor = db.actor
    if not (raid and actor and raid.faction and cfg.raid_rep_enabled) then return end
    local lost = raid.settlers_lost or 0
    if lost <= 0 then return end
    local pts = math.min(cfg.raid_rep_cap or 100, lost * (cfg.raid_rep_per_settler or 25))
    if not failed then pts = math.floor(pts / 2) end
    if pts <= 0 then return end

    local killer = raid.faction
    local own = raid_rep_clean(stalker_camp_builder.get_player_faction and stalker_camp_builder.get_player_faction())
    local list = RAID_REP_FALLBACK_FACTIONS
    pcall(function()
        local t = game_relations and game_relations.factions_table
        if type(t) == "table" and #t > 0 then list = t end
    end)

    local hit = {}
    for _, f in ipairs(list) do
        if type(f) == "string" and f ~= killer and f ~= own and not RAID_REP_SKIP[f] then
            local enemies = false
            pcall(function()
                if game_relations and game_relations.is_factions_enemies then
                    enemies = game_relations.is_factions_enemies(killer, f) and true or false
                else
                    local rel = relation_registry.community_relation(killer, f)
                    enemies = rel ~= nil and rel <= -500
                end
            end)
            if enemies and pcall(relation_registry.change_community_goodwill, f, actor:id(), -pts) then
                hit[#hit + 1] = f
            end
        end
    end
    if #hit > 0 then
        pcall(stalker_camp_builder.camp_send_tip, actor,
            string.format(game.translate_string("st_homestead_raid_rep_loss"), lost, killer, table.concat(hit, ", ")),
            nil, "general_stalker", 12000)
    end
end

-- a camp's raid ends with the camp: the raiders' saved "actor" target would otherwise keep them
-- following the player to every level, as check_completed_raids sees only camps that still exist
function stalker_camp_builder.end_camp_raid(camp)
    local raid = camp and camp.active_raid
    if not raid then return end
    local squad = raid.squad_id and alife_object(raid.squad_id)
    -- only while the id still names a squad sent at the player, not a companion squad that took it
    if squad and squad.squad_members and squad.scripted_target == "actor"
        and not (axr_companions and axr_companions.companion_squads and axr_companions.companion_squads[squad.id]) then
        squad.scripted_target = nil
    end
    camp.active_raid = nil
end

function check_completed_raids()
    for hub_id, camp in pairs(stalker_camp_builder.active_camps) do
        if camp.active_raid and camp.level and camp.level ~= level.name() then
            -- the player has left the camp's level: the raid ends there, and the raiders stop following
            local squad = camp.active_raid.squad_id and alife_object(camp.active_raid.squad_id)
            if squad and squad.scripted_target == "actor" then
                squad.scripted_target = nil
            end
            if camp and camp.survivors then
                for _, s_data in pairs(camp.survivors) do
                    if s_data.raider then s_data.raider.defending = nil end
                end
            end
            pcall(stalker_camp_builder.raid_apply_reputation, camp.active_raid, squad ~= nil)
            camp.active_raid = nil
        elseif camp.active_raid then
            local raid = camp.active_raid
            local squad = camp.active_raid.squad_id and alife_object(camp.active_raid.squad_id)
            local squad_alive = false
            if squad then
                local has_alive = false
                for k in stalker_camp_builder.safe_squad_members(squad) do
                    local is_alive = false
                    local online_obj = level.object_by_id(k.id)
                    if online_obj then
                        is_alive = online_obj:alive()
                    else
                        local sim = alife()
                        local se_obj = k.object or (k.id and sim:object(k.id))
                        if se_obj and se_obj:alive() then
                            is_alive = true
                        end
                    end
                    if is_alive then
                        has_alive = true
                        break
                    end
                end
                squad_alive = has_alive
                local alive_count = 0
                for k in stalker_camp_builder.safe_squad_members(squad) do
                    local is_alive = false
                    local online_obj = level.object_by_id(k.id)
                    if online_obj then
                        is_alive = online_obj:alive()
                    else
                        local sim2 = alife()
                        local se_obj2 = k.object or (k.id and sim2:object(k.id))
                        if se_obj2 and se_obj2:alive() then
                            is_alive = true
                        end
                    end
                    if is_alive then alive_count = alive_count + 1 end
                end
                raid.remaining_count = alive_count
            else
                -- the engine releases a squad as soon as its last member dies
                raid.remaining_count = 0
            end

            if not squad_alive then
                local camp_name = camp.name or "Camp"
                local raiders_killed = raid.raiders_killed or 0
                if raid.original_squad_size and raid.remaining_count then
                    raiders_killed = raid.original_squad_size - raid.remaining_count
                end
                if db.actor then
                    if raid.is_retaliation then
                        local fac_name = game.translate_string(raid.faction or "hostiles")
                        stalker_camp_builder.camp_send_tip(db.actor, string.format(game.translate_string("st_retaliation_raid_defended"), camp_name, fac_name), nil, "general_stalker", 12000, hub_id, "combat", true)
                    else
                        stalker_camp_builder.camp_send_tip(db.actor, string.format(game.translate_string("st_raid_summary"), camp_name, raiders_killed, raid.guards_lost or 0), nil, "general_stalker", 12000, hub_id, "combat", true)
                    end
                end
                -- Raiders stand down from defending
                if camp and camp.survivors then
                    for _, s_data in pairs(camp.survivors) do
                        if s_data.raider then s_data.raider.defending = nil end
                    end
                end
                if stalker_camp_builder.send_settler_callback then
                    stalker_camp_builder.send_settler_callback("homestead_on_raid_defended", hub_id, raiders_killed, raid.guards_lost or 0)
                end
                pcall(stalker_camp_builder.raid_apply_reputation, raid, false)
                camp.active_raid = nil
            end
        end
    end
end

-- Offline resolution when a pending retaliation raid matures while player is away for >= 1 in-game day
function stalker_camp_builder.resolve_offline_retaliation(hub_id, camp, retal_faction)
    local sb = stalker_camp_builder
    local hub_obj = alife_object and alife_object(hub_id)
    local stats = sb.get_camp_stats and sb.get_camp_stats(camp, hub_obj)
    local defense = stats and stats.defense or 0
    local needed = 25
    local camp_name = camp.name or "Settlement"
    local fac_name = game.translate_string(retal_faction or "hostiles")

    if defense >= needed then
        if db.actor and sb.camp_send_tip then
            sb.camp_send_tip(db.actor,
                string.format(game.translate_string("st_retaliation_offline_repelled"), camp_name, fac_name),
                nil, "general_stalker", 12000, hub_id, "combat", true)
        end
        if sb.find_and_consume_item then
            sb.find_and_consume_item(hub_id, camp, function(sec) return type(sec) == "string" and sec:find("^ammo_") and not sec:find("battery") end, nil)
            sb.find_and_consume_item(hub_id, camp, sb.needs_is_med or function(sec) return sec == "bandage" or sec:find("medkit") end, nil)
        end
    else
        if db.actor and sb.camp_send_tip then
            sb.camp_send_tip(db.actor,
                string.format(game.translate_string("st_retaliation_offline_breached"), camp_name, fac_name),
                nil, "red_danger", 15000, hub_id, "combat", true)
        end
        camp.happiness = math.max(0, (camp.happiness or 50) - 15)
        camp._stats_cache = nil
        if camp.survivors then
            for _, s in pairs(camp.survivors) do
                s.needs_hungry_until = sb.game_sec() + 86400
                break
            end
        end
    end
end

stalker_camp_builder.process_camp_random_events = process_camp_random_events
stalker_camp_builder.process_camp_raids = process_camp_raids
stalker_camp_builder.trigger_random_camp_event = trigger_random_camp_event
stalker_camp_builder.spawn_camp_raid = spawn_camp_raid
stalker_camp_builder.check_completed_raids = check_completed_raids

-- gives a refugee the faction the refugees event picked, and a friendly relation to the player, the
-- first time it is online; the server object keeps the community from then on
local function refugee_on_net_spawn(npc)
    local info = npc and stalker_camp_builder.refugee_ids[npc:id()]
    if not (type(info) == "table" and info.pending_community and db.actor) then return end
    pcall(function()
        npc:set_character_community(info.pending_community, 0, 0)
        npc:set_relation(game_object.friend, db.actor)
    end)
    info.pending_community = nil
end

function on_game_start()
    RegisterScriptCallback("npc_on_net_spawn", refugee_on_net_spawn)
end
