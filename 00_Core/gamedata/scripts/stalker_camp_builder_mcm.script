-- Homestead (Stalker Settlement Builder) Mod Configuration Menu
--
-- NOTE: Do NOT add 'stalker_camp_builder = stalker_camp_builder or {}' here.
-- In X-Ray, each .script file gets its own environment table. The MCM script's
-- env is stalker_camp_builder_mcm, NOT stalker_camp_builder. Writing
-- 'stalker_camp_builder = stalker_camp_builder or {}' creates a field
-- stalker_camp_builder_mcm.stalker_camp_builder (which is nil), then
-- overwrites _G.stalker_camp_builder with an empty table -- destroying the
-- real module. The main stalker_camp_builder.script creates the table.

local function prepare_group(items)
    for _, item in ipairs(items) do
        if item.id and item.type ~= "slide" and item.type ~= "desc" and item.type ~= "line" and not item.hint then
            item.hint = "stalker_camp_builder_" .. item.id
        end
    end
    return items
end

