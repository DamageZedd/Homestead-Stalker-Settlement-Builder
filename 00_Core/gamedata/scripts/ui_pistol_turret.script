local gc = game.translate_string
local ratio = utils_xml.screen_ratio()

local use_ingame_time = true
---@type ui_pistol_turret.UIPistolTurret
local GUI = nil -- instance, don't touch

-- Must match turret list (or a subset)
local AMMO_TYPES_9X19 = {
    "ammo_9x19_fmj",
    "ammo_9x19_ap",
    "ammo_9x19_pbp",
}
local CHANNEL_OFF = 0

class "UIPistolTurret" (CUIScriptWnd)

function UIPistolTurret:__init() super()
    self:InitCallbacks()
    self:InitControls()
    self.snd_reload = sound_object([[weapons\pm\pm_reload_empty]])
end

function UIPistolTurret:__finalize()
    GUI = nil
end

function UIPistolTurret:InitControls()
    self:SetWndRect(Frect():set(0,0,1024,768))
    self.wide = (device().width/device().height) > (1024/768 + 0.01)

    self:SetAutoDelete(true)

    local xml = CScriptXmlInit()
    xml:ParseFile("ui_pistol_turret_dialog.xml")

    self.back = xml:InitFrame("background", self)
	
	self.ammo_amount = xml:InitTextWnd("ammo_amount", self.back)

    self.icon = xml:InitStatic("icon", self.back)
    self.icon:SetWndSize(vector2():set(self.icon:GetWidth(), self.icon:GetWidth() / ratio))

    self.btn_pickup = xml:Init3tButton("btn_pickup", self.back)
    self:Register(self.btn_pickup, "btn_pickup")

    self.btn_close = xml:Init3tButton("btn_close", self.back)
    self:Register(self.btn_close, "btn_close")

    self.btn_reload = xml:Init3tButton("btn_reload", self.back)
    self:Register(self.btn_reload, "btn_reload")

    -- only the dialog in Homestead's G.A.M.M.A. pack (04) has the channel button; base Gadgets
    -- 0.7.2's has none, and Init3tButton asserts on a missing node
    local ok, has_channel = pcall(function() return xml:NodeExist("btn_channel", 0) end)
    if ok and has_channel then
        self.btn_channel = xml:Init3tButton("btn_channel", self.back)
        self:Register(self.btn_channel, "btn_channel")
    end
end

function UIPistolTurret:Pickup()
    local obj = level and level.object_by_id and level.object_by_id(self.pistol_turret_id)
    if not obj then
        self:Close()
        return
    end
    ---@type bind_hf_base.hf_binder_wrapper
    local wrapper = obj:binded_object() and obj:binded_object().wrapper
    if wrapper then
        wrapper:pickup()
    end
    self:Close()
end

-- Count all ammo in inventory for a single section
local function actor_ammo_count_one(section)
    local total = 0
    db.actor:inventory_for_each(function(item)
        if item:section() == section then
            total = total + (item:ammo_get_count() or 0)
        end
    end)
    return total
end

-- Remove up to N rounds of an ammo section across ALL stacks/boxes.
-- Returns the number of rounds actually removed.
local function actor_remove_ammo_rounds(section, n)
    n = tonumber(n) or 0
    if n <= 0 then return 0 end

    -- Snapshot all matching ammo items first (avoids inventory refresh issues mid-loop)
    local items = {}
    db.actor:inventory_for_each(function(item)
        if item and item:section() == section then
            items[#items + 1] = item
        end
    end)

    local removed = 0

    for _, item in ipairs(items) do
        if removed >= n then break end

        -- Item might already be gone if something else touched inventory; protect calls
        local ok_count, count = pcall(function() return item:ammo_get_count() or 0 end)
        if ok_count and count and count > 0 then
            local take = math.min(count, n - removed)

            if take >= count then
                -- consume whole box
                local ok_id, id = pcall(function() return item:id() end)
                if ok_id and id then
                    pcall(function() alife_release_id(id) end)
                end
                removed = removed + count
            else
                -- consume part of box
                pcall(function() item:ammo_set_count(count - take) end)
                removed = removed + take
            end
        end
    end

    return removed
end

function UIPistolTurret:Reload()
    local obj = level and level.object_by_id and level.object_by_id(self.pistol_turret_id)
    if not obj then
        self:Close()
        return
    end

    local wrapper = obj:binded_object() and obj:binded_object().wrapper
    if not wrapper then
        self:Close()
        return
    end

    local mag_size = wrapper.mag_size or 0
    local cur = 0

    if wrapper.get_mag_count then
        cur = wrapper:get_mag_count()
    else
        -- fallback: if old turret version
        cur = wrapper.ammo or 0
    end

    local need = mag_size - cur
    if need <= 0 then
        actor_menu.set_msg(1, gc("st_turret_already_loaded"), 3)
        self:Close()
        return
    end

    local loaded_total = 0

    -- Fill in priority order: FMJ first, then HP, etc.
    for _, ammo_sect in ipairs(AMMO_TYPES_9X19) do
        if loaded_total >= need then break end

        local have = actor_ammo_count_one(ammo_sect)
        if have > 0 then
            local to_load = math.min(need - loaded_total, have)

            -- remove from player
            local removed = actor_remove_ammo_rounds(ammo_sect, to_load)
            if removed > 0 then
				local added = wrapper:mag_push(ammo_sect, removed)
				loaded_total = loaded_total + added

				-- If for some reason added < removed (mag full), give back difference
				local overflow = removed - added
				if overflow > 0 then
					alife_create_item(ammo_sect, db.actor, { ammo = overflow })
				end
            end
        end
    end

    if loaded_total <= 0 then
        actor_menu.set_msg(1, gc("st_turret_no_ammo"), 3)
        self:Close()
        return
    end

    -- Play at the turret's world position (self.object is not valid on a CUIScriptWnd)
    if obj and self.snd_reload then
        self.snd_reload:play_no_feedback(obj, sound_object.s3d, 0, obj:position(), 1, 1)
    end

    if loaded_total >= need then
        actor_menu.set_msg(1, gc("st_turret_reloaded_full"), 3)
    else
        actor_menu.set_msg(1, string.format(gc("st_turret_reloaded_count"), loaded_total), 3)
    end

    self:Close()
end

local function channel_to_text(channel)
    if channel == CHANNEL_OFF then
        return gc("st_channel_off")
    end
    return tostring(channel)
end

function UIPistolTurret:CycleChannel()
    local wrapper = bind_hf_base.get_wrapper(self.pistol_turret_id)
    if not wrapper or not wrapper.cycle_channel then
        return
    end

    wrapper:cycle_channel()
end

function UIPistolTurret:InitCallbacks()
    self:AddCallback("btn_pickup", ui_events.BUTTON_CLICKED, self.Pickup, self)
    self:AddCallback("btn_reload", ui_events.BUTTON_CLICKED, self.Reload, self)
    self:AddCallback("btn_channel", ui_events.BUTTON_CLICKED, self.CycleChannel, self)
    self:AddCallback("btn_close", ui_events.BUTTON_CLICKED, self.Close, self)
end

function UIPistolTurret:Initialize()
    local obj = level and level.object_by_id and level.object_by_id(self.pistol_turret_id)
    local se_obj = alife_object(self.pistol_turret_id)
    self.section = (obj and obj:section()) or (se_obj and se_obj:section_name())
    if self.section then
        local icon = ini_sys:r_string_ex(self.section, "ui_texture")
        if icon then
            self.icon:InitTexture(icon)
        end
    end
end

function UIPistolTurret:TestAndShow(obj_id)
    self.pistol_turret_id = obj_id
    self:Initialize()
    self:ShowDialog(true)
    Register_UI("UIPistolTurret", "ui_sleep_dialog")
end

function UIPistolTurret:Update()
    CUIScriptWnd.Update(self)

    local wrapper = bind_hf_base.get_wrapper(self.pistol_turret_id)
    if not wrapper then return end

    local mag_count = wrapper:get_mag_count()
    local channel = CHANNEL_OFF
    if wrapper.get_channel then
        channel = wrapper:get_channel()
    end
    self.ammo_amount:SetText(
        gc("st_ammo_amount") .. ": " .. tostring(mag_count) .. "/40\\n - " .. gc("st_turret_channel") .. ": " .. channel_to_text(channel)
    )
end

function UIPistolTurret:OnTrackButton()
end

function UIPistolTurret:OnKeyboard(dik, keyboard_action)
    local res = CUIScriptWnd.OnKeyboard(self, dik, keyboard_action)
    if (res == false) then
        if keyboard_action == ui_events.WINDOW_KEY_PRESSED then
            if dik == DIK_keys.DIK_ESCAPE then
                self:Close()
            end
        end
    end
    return res
end

function UIPistolTurret:Close()
    if (self:IsShown()) then
        self:HideDialog()
    end
    Unregister_UI("UIPistolTurret")
end

function start_dialog(obj_id)
    if (GUI == nil) then
        GUI = UIPistolTurret()
    end
    GUI:TestAndShow(obj_id)
end
