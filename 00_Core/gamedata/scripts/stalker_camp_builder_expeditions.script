local function get_self_contained_obj_info(se_obj, fallback_level)
          local sim = alife()
    if not se_obj then return vector():set(0,0,0), 2, "l01_escape" end
    local pos = se_obj.position or vector():set(0,0,0)
    local lid = nil
    local lvl_name = nil

    if se_obj.m_game_vertex_id and game_graph then
        local gg = game_graph()
        if gg and gg:valid_vertex_id(se_obj.m_game_vertex_id) then
            local gv = gg:vertex(se_obj.m_game_vertex_id)
            if gv then
                lid = gv:level_id()
                if alife then
                    lvl_name = sim:level_name(lid)
                end
            end
        end
    end

    if not lid and fallback_level then
        local clean = string.lower(tostring(fallback_level))
        lid = tlra_name_to_lid[clean]
        lvl_name = clean
    end

    if not lid and level then
        lid = sim and sim:level_id()
        lvl_name = level.name()
    end

    lid = lid or 2
    lvl_name = lvl_name or "l01_escape"
    return pos, lid, lvl_name
end

local function get_self_contained_global_pos(pos, lid, lvl_name)
    local clean_name = lvl_name and string.lower(tostring(lvl_name))
    local id = lid or (clean_name and tlra_name_to_lid[clean_name]) or 2
    local off = tlra_level_offsets[id] or { 0.0, 0.0, 0.0 }
    local p = pos or vector():set(0,0,0)
    return vector():set(p.x + off[1], p.y + off[2], p.z + off[3])
end

local function get_self_contained_distance(pos1, lid1, lvl1, pos2, lid2, lvl2)
    if not pos1 or not pos2 then return 200 end

    if (lid1 and lid2 and lid1 == lid2) or (lvl1 and lvl2 and lvl1 == lvl2) then
        local dx = pos1.x - pos2.x
        local dy = pos1.y - pos2.y
        local dz = pos1.z - pos2.z
        return math.max(30, math.sqrt(dx*dx + dy*dy + dz*dz))
    end

    local g1 = get_self_contained_global_pos(pos1, lid1, lvl1)
    local g2 = get_self_contained_global_pos(pos2, lid2, lvl2)
    local dx = g1.x - g2.x
    local dz = g1.z - g2.z
    return math.max(100, math.sqrt(dx*dx + dz*dz))
end

local function get_self_contained_duration_sec(dist, is_same_level, survivor, search_time_sec)
    local mfloor = math.floor
    local d = dist or 100
    local tf = (level and level.get_time_factor and level.get_time_factor()) or 10
    if tf <= 0 then tf = 10 end

    local kmh = (stalker_camp_builder.cfg and stalker_camp_builder.cfg.scavenger_walk_speed_kmh) or 1.2
    if not kmh or kmh <= 0 then kmh = 1.2 end
    local speed_mps = (kmh * 1000) / 3600

    local walk_time_sec = mfloor(d / speed_mps)

    local tier = (survivor and survivor.tier) or 0
    local tier_reduc = tier * 0.10
    local final_walk_sec = math.max(1, mfloor(walk_time_sec * (1.0 - tier_reduc)))

    local total_game_sec = final_walk_sec + (search_time_sec or (60 * tf))

    local speed_mult = (stalker_camp_builder.cfg and stalker_camp_builder.cfg.scavenger_expedition_speed_mult) or 1.0
    if speed_mult <= 0 then speed_mult = 1.0 end

    local scaled_game_sec = mfloor(total_game_sec / speed_mult)
    local min_game_sec = is_same_level and (180 * tf) or (360 * tf)

    return math.max(min_game_sec, scaled_game_sec)
end

