-- stalker_camp_builder_expeditions.script
-- Homestead remote scavenger stash expeditions, PDA map-spot dispatch menu and the travel-time
-- engine (split out of stalker_camp_builder.script).
-- Exposed on the main table: process_stash_expeditions, dispatch_scavenger_to_stash,
-- dispatch_scavenger_regional_sweep, recall_scavenger_expedition(_by_npc), get_expedition_for_stash,
-- map_spot_menu_add_property, map_spot_menu_property_clicked and the stash helpers below.
local sformat = string.format
local pairs_ = pairs
local ipairs_ = ipairs
local tostr = tostring
local mfloor = math.floor

-- these stay in stalker_camp_builder.script; its module-level functions aren't globals here
local function game_sec() return stalker_camp_builder.game_sec() end
local function camp_send_tip(...) return stalker_camp_builder.camp_send_tip(...) end
local function add_radio_feed_entry(...) return stalker_camp_builder.add_radio_feed_entry(...) end

local function is_level_vertex(lvid)
    return lvid and lvid < 4294967295 and lvid ~= -1 and lvid >= 0
end

-- REMOTE SCAVENGER STASH EXPEDITION SYSTEM (v1.2.0)
stalker_camp_builder.active_stash_expeditions = stalker_camp_builder.active_stash_expeditions or {}

function stalker_camp_builder.get_expedition_for_stash(target_stash_id)
    local sb = stalker_camp_builder
    if not (sb and sb.active_stash_expeditions and target_stash_id) then return nil end
    local tid_num = tonumber(target_stash_id)
    local direct = sb.active_stash_expeditions[target_stash_id] or (tid_num and sb.active_stash_expeditions[tid_num])
    if direct then
        return direct, (sb.active_stash_expeditions[target_stash_id] and target_stash_id) or tid_num
    end

    for primary_id, exp in pairs(sb.active_stash_expeditions) do
        if exp and exp.all_stashes then
            for _, sid in ipairs(exp.all_stashes) do
                if sid == target_stash_id or (tid_num and tonumber(sid) == tid_num) then
                    return exp, primary_id
                end
            end
        end
    end
    return nil
end

-- PDA MAP SPOT CONTEXT MENU: SPECIFIC SCAVENGER DISPATCH & REGIONAL SWEEP
local current_spot_scavengers = {}

function stalker_camp_builder.restore_missing_settler(hub_id, npc_id, survivor)
    local sim = alife()
    if not sim then return nil end
    local hub_obj = sim:object(hub_id)
    if not hub_obj then return nil end

    local camp = stalker_camp_builder.active_camps[hub_id]
    if not camp then return nil end

    local sec = survivor.section or "sim_default_stalker_0"
    if not ini_sys:section_exist(sec) then
        sec = "sim_default_stalker_0"
    end
    local pos = hub_obj.position
    local lvid = hub_obj.m_level_vertex_id
    local gvid = hub_obj.m_game_vertex_id
    if level and camp.level and level.name() == camp.level then
        local f_lvid, f_pos = stalker_camp_builder.get_furniture_front_vertex_and_pos(pos, 1.5)
        if f_lvid and f_pos then
            lvid = f_lvid
            pos = f_pos
        end
    end

    local ok, new_se = pcall(function() return sim:create(sec, pos, lvid, gvid) end)
    if ok and new_se then
        local new_id = new_se.id
        camp.survivors[npc_id] = nil
        stalker_camp_builder.settler_lookup[npc_id] = nil

        camp.survivors[new_id] = survivor
        stalker_camp_builder.settler_lookup[new_id] = {
            hub_id = hub_id,
            camp = camp,
            survivor = survivor,
        }

        -- set_character_name belongs to the server object, which keeps the name in the save and
        -- passes it to the NPC online. The community needs the NPC online, whenever that is:
        -- game_object_on_net_spawn applies it
        if survivor.name then
            pcall(function() new_se:set_character_name(survivor.name) end)
        end
        survivor.pending_community = survivor.comm or survivor.community
        return new_id
    end
    return nil
end

function stalker_camp_builder.recall_scavenger_expedition_by_npc(npc_id)
    local sb = stalker_camp_builder
    local id_num = tonumber(npc_id)
    for stash_id, exp in pairs(sb.active_stash_expeditions or {}) do
        if exp.npc_id == npc_id or (id_num and tonumber(exp.npc_id) == id_num) then
            return sb.recall_scavenger_expedition(stash_id)
        end
    end
    for hub_id, camp in pairs(sb.active_camps or {}) do
        if camp.survivors and camp.survivors[npc_id] then
            local surv = camp.survivors[npc_id]
            if surv.job == "hunter" and surv.on_expedition then
                surv.on_expedition = nil
                return true
            end
        end
    end
    return false
end

function stalker_camp_builder.get_scavenger_expedition_for_survivor(survivor, npc_id)
    local tonum = tonumber
    local sb = stalker_camp_builder
    local n_id = tonum(npc_id) or (survivor and (tonum(survivor.npc_id) or tonum(survivor.id)))
    local s_name = survivor and survivor.name
    for stash_id, exp in pairs(sb.active_stash_expeditions or {}) do
        local e_id = tonum(exp.npc_id)
        if (n_id and e_id and n_id == e_id)
           or (s_name and exp.survivor_name and exp.survivor_name == s_name) then
            return exp
        end
    end
    return nil
end

function stalker_camp_builder.recall_scavenger_expedition(stash_id)
    local sb = stalker_camp_builder
    local exp = sb.active_stash_expeditions[stash_id]
    local primary_id = stash_id
    if not exp and sb.get_expedition_for_stash then
        exp, primary_id = sb.get_expedition_for_stash(stash_id)
    end
    if not exp then return false end

    sb.active_stash_expeditions[primary_id or stash_id] = nil
    local camp = sb.active_camps[exp.hub_id]
    -- the stashes looted so far are already emptied and unmarked: bring their items home, with
    -- the extra copies a finished expedition rolls (deposit_expedition_haul)
    if camp then
        local spec_mult = (sb.get_specialization_mult and sb.get_specialization_mult(camp, "scavenge")) or 1.0
        for _, itm in ipairs(exp.haul or {}) do
            local count = (spec_mult > 1.0 and math.random() < (spec_mult - 1.0)) and 2 or 1
            for c = 1, count do
                pcall(sb.deposit_item_to_camp, exp.hub_id, camp, itm.sec, itm.is_yellow, itm.map_tier, itm.cond, itm.parts, itm.uses)
            end
        end
    end
    if camp and camp.survivors and camp.survivors[exp.npc_id] then
        camp.survivors[exp.npc_id].on_expedition = nil
        local hub_obj = alife_object(exp.hub_id)
        local se_npc = alife_object(exp.npc_id)
        if hub_obj and se_npc then
            se_npc.position = hub_obj.position
            se_npc.m_level_vertex_id = hub_obj.m_level_vertex_id
            se_npc.m_game_vertex_id = hub_obj.m_game_vertex_id
        end
        -- set_switch_online on an id with no server object is an engine crash
        if se_npc then
            utils_obj.switch_online(exp.npc_id)
            if sb.allow_home_squad_online then
                sb.allow_home_squad_online(exp.npc_id, true)
            end
            if sb.teleport_settler_to_camp_level then
                sb.teleport_settler_to_camp_level(exp.npc_id, exp.hub_id, true)
            end
            if sb.pin_settler_home_squad then
                sb.pin_settler_home_squad(exp.npc_id)
            end
        end
    end

    local actor = db.actor
    if actor then
        local msg = string.format(game.translate_string("st_camp_recall_expedition"), exp.survivor_name or "Scavenger", camp and camp.name or "base")
        news_manager.send_tip(actor, msg, nil, "general_stalker", 8000)
    end
    return true
end

function stalker_camp_builder.get_available_scavengers()
    local sb = stalker_camp_builder
    local scavengers = {}
    local idle_settlers = {}

    for hub_id, camp in pairs(sb.active_camps or {}) do
        if camp and camp.survivors then
            for npc_id, surv in pairs(camp.survivors) do
                local n_id = tonumber(npc_id) or npc_id
                local j = surv.job and string.lower(string.gsub(tostring(surv.job), "%s+", "")) or "idle"
                local is_scav = (j:find("scav") ~= nil)

                local active_exp = sb.get_scavenger_expedition_for_survivor and sb.get_scavenger_expedition_for_survivor(surv, n_id)
                if surv.on_expedition and not active_exp then
                    surv.on_expedition = nil
                    local se_npc = alife_object(n_id)
                    local hub_obj = alife_object(hub_id)
                    if se_npc and hub_obj and not se_npc:can_switch_online() then
                        utils_obj.switch_online(n_id)
                        if sb.allow_home_squad_online then
                            sb.allow_home_squad_online(n_id, true)
                        end
                        se_npc.position = hub_obj.position
                        se_npc.m_level_vertex_id = hub_obj.m_level_vertex_id
                        se_npc.m_game_vertex_id = hub_obj.m_game_vertex_id
                        if sb.teleport_settler_to_camp_level then
                            sb.teleport_settler_to_camp_level(n_id, hub_id, true)
                        end
                        pcall(utils_obj.switch_online, n_id)
                    end
                end

                if not surv.on_expedition and sb.survivor_se(n_id, surv) then
                    local entry = {
                        npc_id = n_id,
                        hub_id = hub_id,
                        camp = camp,
                        survivor = surv,
                        name = surv.name or "Settler",
                        camp_name = camp.name or "Settlement",
                        tier = surv.tier or 0
                    }
                    if is_scav then
                        scavengers[#scavengers+1] = entry
                    elseif j == "idle" or j == "" then
                        idle_settlers[#idle_settlers+1] = entry
                    end
                end
            end
        end
    end

    if #scavengers == 0 and #idle_settlers > 0 then
        for _, idl in ipairs(idle_settlers) do
            idl.is_idle_promoted = true
            scavengers[#scavengers+1] = idl
        end
    end

    return scavengers
end

local quest_spot_types = {
    "primary_task_location", "secondary_task_location", "storyline_task_location",
    "ui_pda2_quest_location", "ui_pda2_quest_task", "ui_pda2_quest_story",
    "treasure_quest", "task_location", "treasure_task"
}

function stalker_camp_builder.is_quest_or_task_stash(id)
    if not id or id <= 0 then return false end

    if level and level.map_has_object_spot then
        for _, qspot in ipairs(quest_spot_types) do
            if level.map_has_object_spot(id, qspot) > 0 then
                return true
            end
        end
    end

    if task_manager and task_manager.get_task_manager then
        local tm = task_manager.get_task_manager()
        if tm and tm.task_info then
            for task_id, tsk in pairs(tm.task_info) do
                if tsk and (tsk.current_target == id or tsk.target == id) then
                    return true
                end
                -- or an item in the stash: New Tasks' stash quests target the documents or PDA they put there
                local target_id = tsk and tsk.current_target
                local se_target = type(target_id) == "number" and target_id < 65535 and alife_object(target_id)
                if se_target and se_target.parent_id == id then
                    return true
                end
            end
        end
    end

    local is_quest = false
    stalker_camp_builder.iterate_server_container(id, function(child_id, child_se)
        local sec = child_se:section_name()
        if sec and (ini_sys:line_exist(sec, "quest_item") and ini_sys:r_bool(sec, "quest_item")) then
            is_quest = true
            return true
        end
        -- most quest items have kind = i_quest and no quest_item key; IsItem("quest") lists both
        if sec and IsItem and IsItem("quest", sec) then
            is_quest = true
            return true
        end
    end)
    if is_quest then return true end

    -- and the items not spawned yet, which treasure_manager lists as "section" or "section__uses"
    local unspawned = treasure_manager and treasure_manager.caches and treasure_manager.caches[id]
    if type(unspawned) == "string" and str_explode then
        for _, entry in ipairs(str_explode(unspawned, ",")) do
            local sec = stalker_camp_builder.split_stash_entry(entry)
            if sec and IsItem and IsItem("quest", sec) then
                return true
            end
        end
    end

    return false
end

-- not treasure_player or ui_pda2_actor_box*: those mark the player's own stashes; not
-- ui_pda2_special_location: stalker_generic puts it on story NPCs (level_spot = special)
local stash_spot_types = {
    "treasure", "treasure_unique", "treasure_epic", "treasure_searched",
    "treasure_unsearched", "ui_pda2_stash_location",
    "ui_pda2_secret_location", "alife_presentation_stash"
}

-- a backpack stash the player dropped (item_backpack records each one)
local function is_player_stash(id)
    local m_data = alife_storage_manager and alife_storage_manager.get_state and alife_storage_manager.get_state()
    return (m_data and m_data.player_created_stashes and m_data.player_created_stashes[id] ~= nil) or false
end

-- a stash is an inventory box; a marker on anything else (an NPC) doesn't make one
local function is_stash_box(id)
    local se_obj = alife_object(id)
    local c = se_obj and se_obj:clsid()
    return c == clsid.inventory_box or c == clsid.inventory_box_s
end

local function has_marked_stash_spot(id)
    if not id or id <= 0 then return false end
    if is_player_stash(id) then return false end
    if not is_stash_box(id) then return false end
    for _, spot in ipairs(stash_spot_types) do
        if level.map_has_object_spot(id, spot) > 0 then
            return true
        end
    end
    if treasure_manager and treasure_manager.caches and treasure_manager.caches[id] then
        return true
    end
    return false
end

function stalker_camp_builder.is_settlement_structure_or_hub(id)
    if not id or id <= 0 then return false end
    local sb = stalker_camp_builder

    if sb.active_camps and sb.active_camps[id] then
        return true
    end

    if sb.active_camps then
        for hub_id, camp in pairs(sb.active_camps) do
            if camp.structures and camp.structures[id] then
                return true
            end
        end
    end

    local se = alife_object(id)
    if se then
        local sec = se:section_name() or ""
        local sec_l = string.lower(sec)
        if sec_l:find("hideout_furniture_") or sec_l:find("homestead_") or sec_l:find("camp_hub")
           or sec_l:find("turret") or sec_l:find("alarm") or sec_l:find("water_pump") then
            return true
        end
        if se_load_var and (se_load_var(id, nil, "is_camp_furniture") or se_load_var(id, nil, "camp_hub_id") or se_load_var(id, nil, "is_settlement_chest")) then
            return true
        end
    end

    return false
end

function stalker_camp_builder.is_stash_spot(id)
    if not id or id <= 0 then return false end
    local sb = stalker_camp_builder

    if sb.is_settlement_structure_or_hub and sb.is_settlement_structure_or_hub(id) then
        return false
    end

    if sb.is_quest_or_task_stash and sb.is_quest_or_task_stash(id) then
        return false
    end

    if has_marked_stash_spot(id) then
        return true
    end

    return false
end

function stalker_camp_builder.is_stash_yellow(s_id, target_level)
    if not s_id or s_id <= 0 then return false end

    if level and level.map_has_object_spot then
        if level.map_has_object_spot(s_id, "treasure_searched") > 0
        or level.map_has_object_spot(s_id, "treasure_unique") > 0
        or level.map_has_object_spot(s_id, "treasure_epic") > 0
        or level.map_has_object_spot(s_id, "ui_pda2_special_location") > 0
        or level.map_has_object_spot(s_id, "ui_pda2_secret_location") > 0
        or level.map_has_object_spot(s_id, "ui_pda2_actor_box_yellow") > 0 then
            return true
        end
    end

    if treasure_manager then
        if treasure_manager.is_rare_cache and treasure_manager.is_rare_cache(s_id) then
            return true
        end
        if treasure_manager.caches_rare then
            local se_stash = alife_object(s_id)
            if se_stash then
                local sname = nil
                pcall(function() sname = se_stash:name() end)
                sname = sname or (se_stash.section_name and se_stash:section_name()) or tostring(s_id)
                local sim = alife()
                local lvl = target_level
                if not lvl and sim and game_graph and se_stash.m_game_vertex_id then
                    local gv = game_graph():vertex(se_stash.m_game_vertex_id)
                    if gv then lvl = sim:level_name(gv:level_id()) end
                end
                lvl = lvl or (level and level.name()) or ""
                local pfx = string.find(sname, "level_prefix_inventory_box", 1, true) and (lvl .. "_") or ""
                if treasure_manager.caches_rare[pfx .. sname] or treasure_manager.caches_rare[sname] then
                    return true
                end
            end
        end
        if treasure_manager.caches and type(treasure_manager.caches[s_id]) == "string" then
            local c = treasure_manager.caches[s_id]
            if c:find("itm_basickit") or c:find("itm_advancedkit") or c:find("itm_expertkit") or c:find("itm_ammokit") or c:find("itm_drugkit") then
                return true
            end
        end
    end

    return false
end

function stalker_camp_builder.get_level_marked_stashes(target_level)
    local stashes = {}
    local sim = alife()
    if not sim then return stashes end
    target_level = target_level or level.name()
    local gg = game_graph()
    local sb = stalker_camp_builder

    local function evaluate_stash_candidate(id, se)
        if has_marked_stash_spot(id) then
            if not sb.is_settlement_structure_or_hub(id) and not sb.is_quest_or_task_stash(id) then
                if not (sb.get_expedition_for_stash and sb.get_expedition_for_stash(id)) then
                    if se and gg and se.m_game_vertex_id then
                        local gv = gg:vertex(se.m_game_vertex_id)
                        if gv then
                            local se_lvl = sim:level_name(gv:level_id())
                            if se_lvl == target_level then
                                stashes[#stashes+1] = id
                            end
                        end
                    end
                end
            end
        end
    end

    local registry = _G.server_objects_registry
    if registry then
        for id, se in pairs(registry) do
            evaluate_stash_candidate(id, se)
        end
    else
        local sim_ = alife()
        for id = 1, 65534 do
            local se = sim_ and sim_:object(id)
            if se then
                evaluate_stash_candidate(id, se)
            end
        end
    end
    return stashes
end

