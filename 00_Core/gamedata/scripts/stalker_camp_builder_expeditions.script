local function roll_gamma_toolkit(target_level)
    local mrand = math.random
    local tier_vec = gamma_tools_map_tiers[target_level] or {1, 2}
    local tier = tier_vec[mrand(#tier_vec)]
    local tool_type = nil

    local has_basic = has_alife_info and has_alife_info("actor_find_basic_kit")
    local has_adv = has_alife_info and has_alife_info("actor_find_advanced_kit")

    if tier == 1 then
        local t1 = { "itm_ammokit", "itm_drugkit" }
        tool_type = t1[mrand(#t1)]
    elseif tier == 2 then
        local t2 = { "itm_ammokit", "itm_drugkit", "itm_drugkit", "itm_basickit", "itm_basickit", "itm_basickit" }
        tool_type = t2[mrand(#t2)]
    elseif tier == 3 then
        local t3 = { "itm_ammokit", "itm_ammokit", "itm_ammokit", "itm_drugkit", "itm_basickit", "itm_basickit", "itm_basickit", "itm_basickit", "itm_basickit", "itm_advancedkit", "itm_advancedkit" }
        tool_type = t3[mrand(#t3)]
        if tool_type == "itm_advancedkit" and not has_basic then
            tool_type = "itm_basickit"
        end
    elseif tier == 4 then
        tool_type = "itm_advancedkit"
        if not has_basic then
            tool_type = "itm_basickit"
        end
    elseif tier >= 5 then
        tool_type = "itm_expertkit"
        if not has_basic then
            tool_type = "itm_basickit"
        elseif not has_adv then
            tool_type = "itm_advancedkit"
        end
    end

    return tool_type
end

