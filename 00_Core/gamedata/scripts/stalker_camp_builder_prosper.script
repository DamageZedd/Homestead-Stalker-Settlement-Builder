-- stalker_camp_builder_prosper.script
-- Settlers who prosper from the homestead (issue #378): a settler's cut of their work, kept on
-- the Homestead record; buying a better weapon from their faction's loadout with that cut; and
-- rank and reputation changes queued on the record until the NPC is online.
-- Every behaviour is behind an MCM option (jobs / general sections).

local sb = stalker_camp_builder
local mmin = math.min
local mmax = math.max
local mfloor = math.floor

-- weapons a settler of each faction may buy, cheapest first; a settler sees the first tier+2 of them
local PROSPER_LOADOUTS = {
    stalker  = { "wpn_ak74u", "wpn_val", "wpn_lr300", "wpn_svu" },
    bandit   = { "wpn_ak74u", "wpn_bizon", "wpn_val" },
    army     = { "wpn_sig550", "wpn_fn2000", "wpn_svd", "wpn_abakan" },
    dolg     = { "wpn_lr300", "wpn_groza", "wpn_svd" },
    freedom  = { "wpn_groza", "wpn_vintorez", "wpn_abakan" },
    ecolog   = { "wpn_val", "wpn_vintorez", "wpn_svu" },
    csky     = { "wpn_ak74", "wpn_g36", "wpn_sig550", "wpn_svu" },
    killer   = { "wpn_mp5", "wpn_ak74", "wpn_g36", "wpn_svd" },
    monolith = { "wpn_ak74", "wpn_l85", "wpn_abakan", "wpn_svd" },
    renegade = { "wpn_bizon", "wpn_ak74u", "wpn_lr300" },
    greh     = { "wpn_ak74", "wpn_lr300", "wpn_abakan", "wpn_svu" },
    isg      = { "wpn_g36", "wpn_fn2000", "wpn_sig550", "wpn_svd" },
}

-- rank and reputation a settler gains when promoted to each tier (1 Skilled, 2 Expert, 3 Master);
-- rank is in points (the recruit roll reads it against 12000), reputation in the engine's own units
local PROSPER_STANDING = {
    [1] = { rank = 1500, rep = 10 },
    [2] = { rank = 3000, rep = 20 },
    [3] = { rank = 6000, rep = 40 },
}

local PROSPER_BUY_AMMO = 2

-- callbacks for other mods (issue #380); arguments are noted at each send site
local PROSPER_CALLBACKS = {
    "homestead_on_settler_promoted",     -- npc_id, survivor, new_tier
    "homestead_on_settler_killed",       -- npc_id, survivor, killer_id (or nil)
    "homestead_on_raid_defended",        -- hub_id, raiders_killed, guards_lost
    "homestead_on_expedition_returned",  -- npc_id, survivor, haul table
    "homestead_on_before_settler_leave", -- npc_id, survivor, flags table (set flags.keep = true to keep them)
}
for _, name in ipairs(PROSPER_CALLBACKS) do
    AddScriptCallback(name)
end

-- send one of the callbacks; a failing listener must not break Homestead's own flow
function sb.send_settler_callback(name, ...)
    if not SendScriptCallback then return end
    pcall(SendScriptCallback, name, ...)
end

-- the NPC id a settler record belongs to, for events that only carry the record
function sb.settler_id_of_record(survivor)
    if not survivor then return nil end
    for id, info in pairs(sb.settler_lookup or {}) do
        if info.survivor == survivor then return id end
    end
    return nil
end

local function prosper_move_on_on()
    return sb.cfg.settler_move_on_enabled == true
end

local function prosper_cut_on()
    return sb.cfg.settler_cut_enabled ~= false
end

local function prosper_savings_cap()
    return sb.cfg.settler_savings_cap or 20000
end

-- credit a settler's cut, clamped so the real-time economy cannot run away
function sb.prosper_credit(survivor, amount)
    if not (survivor and amount and amount > 0 and prosper_cut_on()) then return 0 end
    local have = survivor.savings or 0
    local add = mmin(amount, mmax(0, prosper_savings_cap() - have))
    if add <= 0 then return 0 end
    survivor.savings = have + add
    return add
end

-- a completed work cycle pays the settler's cut, scaled by tier
function sb.prosper_on_work(survivor, job)
    if not (survivor and prosper_cut_on()) or job == "guard" then return end
    local per_cycle = sb.cfg.settler_cut_per_cycle or 2
    sb.prosper_credit(survivor, mfloor(per_cycle * sb.get_survivor_tier_mult(survivor)))
end

-- a job with no room for its output keeps earning its cut, instead of pausing, until the savings cap
function sb.prosper_overflow_allowed(survivor)
    return survivor ~= nil and prosper_cut_on() and (survivor.savings or 0) < prosper_savings_cap()
end

-- how many whole cycles are due for a job that is saving instead of running; at most 2 per tick
function sb.prosper_overflow_cycles(survivor, elapsed, interval)
    if not (interval and interval > 0) or elapsed < interval then return 0 end
    return mmin(2, mfloor(elapsed / interval))
end

function sb.prosper_overflow_credit(survivor, cycles)
    for _ = 1, cycles do
        sb.prosper_on_work(survivor)
    end
end

-- queue a rank and reputation change on the record; applied when the NPC is online
function sb.prosper_queue_standing(survivor, rank, rep)
    if not (survivor and (rank or rep) and sb.cfg.settler_standing_enabled ~= false) then return end
    survivor.standing_queue = survivor.standing_queue or {}
    survivor.standing_queue[#survivor.standing_queue + 1] = { rank = rank or 0, rep = rep or 0 }
end

function sb.prosper_on_promotion(survivor, tier)
    local step = PROSPER_STANDING[tier]
    if step then sb.prosper_queue_standing(survivor, step.rank, step.rep) end
end

-- apply the queued standing to a game object that is online; a failed apply stays queued
function sb.prosper_apply_standing(obj, survivor)
    local queue = survivor and survivor.standing_queue
    if not (obj and queue and #queue > 0 and sb.cfg.settler_standing_enabled ~= false) then return end
    if not (obj.alive and obj:alive()) then return end
    local ok = pcall(function()
        for _, step in ipairs(queue) do
            if step.rank ~= 0 then
                obj:set_character_rank(obj:character_rank() + step.rank)
            end
            if step.rep ~= 0 then
                obj:change_character_reputation(step.rep)
            end
        end
    end)
    if ok then survivor.standing_queue = nil end
end

local function prosper_is_firearm(sec)
    local ac = ini_sys:r_string_ex(sec, "ammo_class")
    return ac ~= nil and ac ~= "" and not sec:find("grenade")
end

local function prosper_ammo_for(sec)
    local ac = ini_sys:r_string_ex(sec, "ammo_class")
    if not (ac and str_explode) then return nil end
    local list = str_explode(ac, ",")
    local ammo = list and list[1]
    if ammo and ini_sys:section_exist(ammo) then return ammo end
    return nil
end

-- buy a better weapon from the faction's loadout with the settler's savings, once per promotion;
-- the ammo for it comes with it, so the settler's own needs are met first
function sb.prosper_try_buy(npc_id, survivor)
    if sb.cfg.settler_spending_enabled == false then return false end
    if not survivor then return false end
    local tier = survivor.tier or 0
    if tier <= (survivor.bought_tier or 0) then return false end
    local npc = level.object_by_id(npc_id)
    if not (npc and npc:alive() and alife_create_item) then return false end
    -- the record's own faction: another mod may change the NPC's live one
    local loadout = PROSPER_LOADOUTS[(string.gsub(survivor.community or npc:character_community() or "", "^actor_", ""))]
    if not loadout then return false end

    local current = npc:best_weapon()
    local current_cost = 0
    if current and prosper_is_firearm(current:section()) then
        current_cost = (ini_sys:r_float_ex(current:section(), "cost") or 1000) * (current:condition() or 1.0)
    end

    local savings = survivor.savings or 0
    local best_sec, best_ammo, best_total, best_cost = nil, nil, nil, nil
    for i = 1, mmin(#loadout, tier + 2) do
        local sec = loadout[i]
        if ini_sys:section_exist(sec) and prosper_is_firearm(sec) then
            local cost = ini_sys:r_float_ex(sec, "cost") or 0
            local ammo = prosper_ammo_for(sec)
            local ammo_cost = ammo and (ini_sys:r_float_ex(ammo, "cost") or 0) or 0
            local total = cost + ammo_cost * PROSPER_BUY_AMMO
            if ammo and cost > current_cost * 1.25 and total <= savings and (not best_cost or cost > best_cost) then
                best_sec, best_ammo, best_total, best_cost = sec, ammo, total, cost
            end
        end
    end
    if not best_sec then return false end

    -- the savings are spent only once the items are on their way; alife_create_item is asynchronous,
    -- so the settler may not switch to the new weapon until a later tick
    local ok = pcall(function()
        alife_create_item(best_sec, npc)
        for _ = 1, PROSPER_BUY_AMMO do
            alife_create_item(best_ammo, npc)
        end
    end)
    if not ok then return false end
    survivor.savings = savings - best_total
    survivor.bought_tier = tier

    if db.actor then
        local s_name = survivor.name or npc:character_name() or "Settler"
        local wpn_name = game.translate_string(ini_sys:r_string_ex(best_sec, "inv_name") or best_sec)
        sb.camp_send_tip(db.actor, string.format(game.translate_string("st_homestead_settler_bought_weapon"), s_name, wpn_name), nil, "general_stalker", 7000)
    end
    return true
end

-- once per equipment check: queue standing for any tier not yet queued (expeditions included),
-- then apply it when the NPC is online, then a purchase
function sb.prosper_tick(hub_id, camp, survivor, npc_id)
    if not (survivor and npc_id) then return end
    local tier = survivor.tier or 0
    for t = (survivor.standing_tier or 0) + 1, tier do
        sb.prosper_on_promotion(survivor, t)
    end
    if tier > (survivor.standing_tier or 0) then survivor.standing_tier = tier end
    if sb.is_companion and sb.is_companion(npc_id) then return end
    if survivor.on_expedition then return end
    local obj = level.object_by_id(npc_id)
    if obj then sb.prosper_apply_standing(obj, survivor) end
    sb.prosper_try_buy(npc_id, survivor)
end

-- the faction without the "actor_" prefix the player's own faction carries
local function prosper_clean_community(comm)
    if type(comm) ~= "string" then return nil end
    return (string.gsub(comm, "^actor_", ""))
end

-- Change a settler's faction (issue #380): updates the record, and the NPC now if it is online or at
-- net spawn otherwise (pending_community). Returns true when a settler record was found.
function sb.set_settler_community(npc_id, comm)
    if not (npc_id and type(comm) == "string" and comm ~= "") then return false end
    local info = sb.settler_lookup and (sb.settler_lookup[npc_id] or sb.settler_lookup[tonumber(npc_id)])
    local survivor = info and info.survivor
    if not survivor then return false end
    survivor.community = comm
    survivor.comm = comm
    survivor.pending_community = comm
    local obj = level.object_by_id(tonumber(npc_id))
    if obj and obj:alive() then
        if pcall(function() obj:set_character_community(comm, 0, 0) end) then
            survivor.pending_community = nil
        end
    end
    return true
end

-- a settler who has done well may move on and rejoin their faction as a veteran: the slot frees up,
-- the faction's goodwill with the player rises, and the player gets word of it
function sb.prosper_try_move_on(hub_id, camp, survivor, npc_id)
    if not (prosper_move_on_on() and survivor and camp and npc_id) then return false end
    if (survivor.tier or 0) < 3 or (survivor.bought_tier or 0) < 3 then return false end
    if (survivor.savings or 0) < (sb.cfg.settler_move_on_savings or 5000) then return false end
    local job = survivor.job
    if job == "companion" or survivor.is_companion or survivor.on_expedition then return false end
    if camp.active_raid or job == "guard" or job == "trader" then return false end
    if sb.is_companion and sb.is_companion(npc_id) then return false end
    local obj = level.object_by_id(npc_id)
    if not (obj and obj:alive()) then return false end
    if math.random(100) > (sb.cfg.settler_move_on_chance or 10) then return false end

    local flags = { keep = false }
    sb.send_settler_callback("homestead_on_before_settler_leave", npc_id, survivor, flags)
    if flags.keep then return false end

    local name = survivor.name or "Settler"
    local comm = prosper_clean_community(survivor.community) or prosper_clean_community(obj:character_community())
    if not pcall(sb.dismiss_survivor, db.actor, npc_id) then return false end

    if db.actor and comm then
        pcall(function()
            relation_registry.change_community_goodwill(comm, db.actor:id(), sb.cfg.settler_move_on_goodwill or 100)
        end)
        local msg = string.format(game.translate_string("st_homestead_settler_moved_on"), name, comm)
        sb.camp_send_tip(db.actor, msg, nil, "general_stalker", 10000)
        if sb.add_radio_feed_entry then sb.add_radio_feed_entry("settlement", msg) end
    end
    return true
end
