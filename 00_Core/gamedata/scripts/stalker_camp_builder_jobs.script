-- What jobs use up, by exact section. Substring tests also took gear and kits stored in the
-- camp: "wood" exo_wood_outfit, "water" itm_water_pump, "battery" the af_dummy_battery artefact.
local WOOD_PARTS = { prt_i_wood = true, prt_o_wood_1 = true, prt_o_wood_2 = true }
local CLEAN_WATER = { flask = true, water_drink = true, mineral_water = true }
local LAMP_BATTERIES = {
    batteries_dead = true, batteries = true, battery = true, battery_dead = true,
    ammo_battery = true, ammo_battery_d = true, prt_i_battery = true,
}
local GUNPOWDER_TIER = { powder_1 = 1, powder_2 = 2, powder_3 = 3, powder_4 = 3 }
local CRAFT_SCRAP = { prt_i_scrap = true }
local MEDIC_CLOTH = { prt_i_cloth = true }

local function is_wood_part(sec) return WOOD_PARTS[sec] == true end
local function is_clean_water(sec) return CLEAN_WATER[sec] == true end
local function is_lamp_battery(sec) return LAMP_BATTERIES[sec] == true end
local function is_gunpowder(sec) return GUNPOWDER_TIER[sec] ~= nil end
local function is_scrap(sec) return sec and CRAFT_SCRAP[sec:lower()] == true end
local function is_cloth(sec) return sec and MEDIC_CLOTH[sec:lower()] == true end

-- set_survivor_job -- assigns a job to a settler and re-syncs their
function stalker_camp_builder.set_survivor_job(npc_id, job)
    local sb = stalker_camp_builder
    local id_num = tonumber(npc_id)
    local id_str = tostring(npc_id)
    for hub_id, camp in pairs(sb.active_camps) do
        if camp.survivors then
            local matched_id = (camp.survivors[npc_id] and npc_id)
                or (id_num and camp.survivors[id_num] and id_num)
                or (camp.survivors[id_str] and id_str)
            if matched_id then
                local surv = camp.survivors[matched_id]
                local was_companion = (surv.job == "companion") or surv.is_companion or (sb.is_companion and sb.is_companion(id_num or matched_id))
                -- the current job again (its PDA button or dialog) keeps the cycle's progress;
                -- companions and scavengers on an expedition still need the handling below
                if surv.job == job and not was_companion and not surv.on_expedition then return end

                surv.job = job
                surv.job_start_time = sb.game_sec()
                surv.job_start_realtime = time_global()
                surv.paused_elapsed = nil
                surv._cached_paused_tg = nil
                surv._cached_paused_job = nil
                surv.assigned_furniture = {}
                surv.temp_target_lvid = nil
                surv.temp_target_time = 0

                if was_companion and job ~= "companion" then
                    surv.is_companion = nil
                    surv.paused_job = nil
                    local online_npc = level.object_by_id(id_num or matched_id)
                    if sb.purge_settler_companion_and_squad_state then
                        sb.purge_settler_companion_and_squad_state(id_num or matched_id, online_npc, false)
                    elseif online_npc then
                        if axr_companions and axr_companions.remove_from_actor_squad then
                            axr_companions.remove_from_actor_squad(online_npc)
                        end
                        online_npc:disable_info_portion("npcx_is_companion")
                        online_npc:disable_info_portion("npcx_beh_wait")
                        online_npc:disable_info_portion("npcx_beh_cannot_dismiss")
                        online_npc:disable_info_portion("homestead_settler_guard")
                        online_npc:disable_info_portion("homestead_settler_patrol")
                    end
                    sb.set_camp_settler_relations(hub_id, id_num or matched_id, true)
                    if sb.teleport_settler_to_camp_level then
                        sb.teleport_settler_to_camp_level(id_num or matched_id, hub_id, true)
                    end
                end

                -- taken off scavenging while away: end the expedition now (it brings home what it
                -- has looted), or it keeps looting and paying out and the settler can be sent again
                if job ~= "scavenge" and sb.recall_scavenger_expedition_by_npc then
                    sb.recall_scavenger_expedition_by_npc(matched_id)
                end
                local active_exp = sb.get_scavenger_expedition_for_survivor and sb.get_scavenger_expedition_for_survivor(surv, matched_id)
                if surv.job ~= "scavenge" or not active_exp then
                    surv.on_expedition = nil
                    local se_npc = alife_object(matched_id)
                    local hub_obj = alife_object(hub_id)
                    if se_npc and hub_obj and not se_npc:can_switch_online() then
                        utils_obj.switch_online(matched_id)
                        se_npc.position = hub_obj.position
                        se_npc.m_level_vertex_id = hub_obj.m_level_vertex_id
                        se_npc.m_game_vertex_id = hub_obj.m_game_vertex_id
                        if sb.teleport_settler_to_camp_level then
                            sb.teleport_settler_to_camp_level(matched_id, hub_id, true)
                        end
                        pcall(utils_obj.switch_online, matched_id)
                    end
                end
                if sb.non_settler_cache then
                    sb.non_settler_cache[matched_id] = nil
                    if id_num then sb.non_settler_cache[id_num] = nil end
                    if id_str then sb.non_settler_cache[id_str] = nil end
                end
                if sb.settler_lookup then
                    local entry = {
                        hub_id = hub_id,
                        camp = camp,
                        survivor = surv,
                    }
                    sb.settler_lookup[matched_id] = entry
                    if id_num then sb.settler_lookup[id_num] = entry end
                    if id_str then sb.settler_lookup[id_str] = entry end
                end
                camp._stats_cache_tick = nil
                camp._stats_cache = nil
                local npc = level.object_by_id(id_num or matched_id)
                if npc then
                    sb.camp_npc_arrive(npc)
                end
                break
            end
        end
    end
end

-- spawn_scavenged_loot -- scavenger finds a stash in the wilderness and uses
function stalker_camp_builder.spawn_scavenged_loot(box_id, multiplier, hub_id, camp, survivor)
    local ipairs_ = ipairs
    local pairs_ = pairs
           local sim = alife()
    local sb = stalker_camp_builder
    multiplier = multiplier or 1

    if not hub_id or not camp then
        if survivor then
            for hid, c in pairs_(sb.active_camps or {}) do
                if c.survivors then
                    for nid, s in pairs_(c.survivors) do
                        if s == survivor or (survivor.name and s.name == survivor.name) then
                            hub_id = hid
                            camp = c
                            break
                        end
                    end
                end
                if hub_id then break end
            end
        end
        if (not hub_id or not camp) and box_id then
            for hid, c in pairs_(sb.active_camps or {}) do
                if c.primary_chest_id == box_id or (c.structures and c.structures[box_id]) then
                    hub_id = hid
                    camp = c
                    break
                end
            end
        end
    end

    local target_box = box_id
    if (not target_box or (sb.is_valid_camp_box and not sb.is_valid_camp_box(target_box, hub_id, camp))) and camp and hub_id then
        target_box = sb.get_auto_sort_target_box(camp, hub_id, "stash")
    end
    if not target_box then return {}, false end

    local target_level = (camp and camp.level and camp.level ~= "unknown" and camp.level)
                      or (hub_id and alife_object(hub_id) and sim and game_graph() and sim:level_name(game_graph():vertex(alife_object(hub_id).m_game_vertex_id):level_id()))
                      or (level and level.name())
                      or "l01_escape"
    local map_tier = (sb.gamma_map_tiers and sb.gamma_map_tiers[target_level]) or 2

    local min_items = (sb.cfg and sb.cfg.scavenge_min_items) or (sb.defaults and sb.defaults.scavenge_min_items) or 1
    local max_items = (sb.cfg and sb.cfg.scavenge_max_items) or (sb.defaults and sb.defaults.scavenge_max_items) or 2
    if min_items > max_items then min_items, max_items = max_items, min_items end
    local base_count = math.random(min_items, max_items)

    local tier_mult = (sb.get_survivor_tier_mult and survivor and sb.get_survivor_tier_mult(survivor)) or 1.0
    local spec_mult = (sb.get_specialization_mult and camp and sb.get_specialization_mult(camp, "scavenge")) or 1.0
    local mult = multiplier or (tier_mult * spec_mult)
    local raw_count = base_count * mult
    local total_count = math.max(1, math.floor(raw_count) + (math.random() < (raw_count - math.floor(raw_count)) and 1 or 0))

    local fallback_list = nil
    if sb.generate_gamma_stash_loot then
        fallback_list = sb.generate_gamma_stash_loot(map_tier, false, target_level)
    end
    if not fallback_list or #fallback_list == 0 then
        fallback_list = sb.scavenge_loot_table or {"conserva", "bandage", "ammo_9x18_fmj", "prt_i_scrap"}
    end

    local items_to_deposit = {}
    for i = 1, total_count do
        local sec = fallback_list[math.random(#fallback_list)]
        if sec and ini_sys and ini_sys:section_exist(sec) then
            items_to_deposit[#items_to_deposit+1] = { sec = sec, is_yellow = false, map_tier = map_tier }
        end
    end

    local deposited_items = {}
    for _, itm in ipairs_(items_to_deposit) do
        local sec = itm.sec
        if camp and hub_id and sb.deposit_item_to_camp then
            local dep_box = sb.deposit_item_to_camp(hub_id, camp, sec, false, itm.map_tier, nil, nil, itm.uses)
            if dep_box then
                deposited_items[#deposited_items+1] = sec
            end
        else
            local dest_box = (sb.get_auto_sort_target_box and camp and hub_id and sb.get_auto_sort_target_box(camp, hub_id, sec)) or target_box
            local box_se = alife_object(dest_box)
            if box_se then
                local pos = box_se.position or STATIC_ZERO_VECTOR
                local lvid = box_se.m_level_vertex_id or 0
                local gvi = box_se.m_game_vertex_id or 0
                sim:create(sec, pos, lvid, gvi, dest_box)
                deposited_items[#deposited_items+1] = sec
            end
        end
    end

    return deposited_items, false
end

local function format_deposited_items_summary(item_secs, fallback)
    if not item_secs or #item_secs == 0 then return fallback or "items" end
    local counts = {}
    local order = {}
    for _, sec in ipairs(item_secs) do
        local name = (ui_item and ui_item.get_sec_name and ui_item.get_sec_name(sec)) or sec
        if not counts[name] then
            counts[name] = 0
            order[#order+1] = name
        end
        counts[name] = counts[name] + 1
    end
    local parts = {}
    for _, name in ipairs(order) do
        local count = counts[name]
        if count > 1 then
            parts[#parts+1] = name .. " (x" .. count .. ")"
        else
            parts[#parts+1] = name
        end
    end
    return table.concat(parts, ", ")
end
stalker_camp_builder.format_deposited_items_summary = format_deposited_items_summary

-- spawn_hunted_meat -- drop N random raw mutant meats into box_id
function stalker_camp_builder.spawn_hunted_meat(box_id, multiplier, hub_id, camp)
    local sb = stalker_camp_builder
    multiplier = multiplier or 1

    if (not hub_id or not camp) and box_id then
        for hid, c in pairs(sb.active_camps or {}) do
            if c.primary_chest_id == box_id or (c.structures and c.structures[box_id]) then
                hub_id = hid
                camp = c
                break
            end
        end
    end

    local min_m = sb.cfg.hunter_min_meat or 1
    local max_m = sb.cfg.hunter_max_meat or 2
    if min_m > max_m then min_m, max_m = max_m, min_m end
    local num_items = math.max(1, math.floor(math.random(min_m, max_m) * multiplier + 0.5))
    local deposited_meats = {}
    for i = 1, num_items do
        local sec = sb.hunter_meat_table[math.random(#sb.hunter_meat_table)]
        if sec and ini_sys and ini_sys.section_exist and ini_sys:section_exist(sec) then
            if camp and hub_id and sb.deposit_item_to_camp then
                local dep_box = sb.deposit_item_to_camp(hub_id, camp, sec)
                if dep_box then
                    deposited_meats[#deposited_meats+1] = sec
                end
            else
                local target_box = (sb.get_auto_sort_target_box and camp and hub_id and sb.get_auto_sort_target_box(camp, hub_id, sec)) or box_id
                if target_box and sb.is_valid_camp_box and not sb.is_valid_camp_box(target_box, hub_id, camp) and camp and hub_id then
                    target_box = sb.get_auto_sort_target_box(camp, hub_id, sec)
                end
                local box_se = alife_object(target_box)
                if box_se then
                    local pos = box_se.position or STATIC_ZERO_VECTOR
                    local lvid = box_se.m_level_vertex_id or 0
                    local gvi = box_se.m_game_vertex_id or 0
                    alife():create(sec, pos, lvid, gvi, target_box)
                    deposited_meats[#deposited_meats+1] = sec
                end
            end
        end
    end
    return deposited_meats
end

-- is_camp_supply_capped -- checks if camp already has an abundant stockpile
function stalker_camp_builder.is_camp_supply_capped(hub_id, camp, category, survivor_or_order)
    local sb = stalker_camp_builder
    if sb.cfg.enable_surplus_cap == false then
        return false
    end
    if not camp or not camp.structures then return false end

    local count = 0
    local cap = 15
    local check_func = nil

    if category == "food" then
        cap = 15
        check_func = function(sec)
            local s = sec:lower()
            -- prepared meat is meat_*_a / meat_*_b; glue_a, sewing_kit_b, guitar_a are not food
            if s:find("_cooked") or (s:sub(1, 5) == "meat_" and (s:sub(-2) == "_b" or s:sub(-2) == "_a")) then
                return true
            end
            -- kolbasa is the tier 3 meal (get_cooked_version)
            if s == "meat_tushkano" or s == "meat_dog" or s == "meat_pseudodog"
               or s == "meat_flesh" or s == "meat_boar" or s == "meat_bloodsucker"
               or s == "meat_snork" or s == "meat_chimera" or s == "meat_lurker"
               or s == "meat_psysucker" or s == "kolbasa" then
                return true
            end
            return false
        end
    elseif category == "meds" then
        local m_order = "auto"
        if type(survivor_or_order) == "table" then
            m_order = survivor_or_order.medic_order or "auto"
        elseif type(survivor_or_order) == "string" then
            m_order = survivor_or_order
        end

        if m_order == "akvatab" then
            cap = 8
            check_func = function(sec)
                local s = sec:lower()
                return s == "akvatab" or s == "drug_booster" or s:find("ibuprofen") ~= nil
            end
        elseif m_order == "kalium" then
            cap = 8
            check_func = function(sec)
                local s = sec:lower()
                return s == "antirad_kalium" or s == "antirad" or s:find("kalium") ~= nil
            end
        elseif m_order == "medkit" then
            cap = 8
            check_func = function(sec)
                local s = sec:lower()
                return s:find("medkit") ~= nil
            end
        elseif m_order == "bandage" then
            cap = 15
            check_func = function(sec)
                local s = sec:lower()
                return s:find("bandage") ~= nil
            end
        else -- "auto"
            cap = 15
            check_func = function(sec)
                local s = sec:lower()
                return s:find("medkit") or s:find("bandage") or s:find("antirad") or s:find("stimpack") or s:find("salve") or s == "akvatab" or s == "antirad_kalium" or s == "drug_booster" or s:find("ibuprofen") ~= nil
            end
        end
    elseif category == "ammo" then
        local c_order = "auto"
        if type(survivor_or_order) == "table" then
            c_order = survivor_or_order.craft_order or "auto"
        elseif type(survivor_or_order) == "string" then
            c_order = survivor_or_order
        end

        if c_order == "pistol" then
            cap = 8
            check_func = function(sec)
                local s = sec:lower()
                return s:find("ammo_9x18") or s:find("ammo_9x19") or s:find("ammo_11.43x23") or s:find("ammo_7.62x25") or s:find("ammo_357")
            end
        elseif c_order == "shotgun" then
            cap = 8
            check_func = function(sec)
                local s = sec:lower()
                return s:find("ammo_12x70") or s:find("ammo_12x76") or s:find("ammo_20x70") or s:find("ammo_23x75")
            end
        elseif c_order == "rifle_soviet" then
            cap = 6
            check_func = function(sec)
                local s = sec:lower()
                return s:find("ammo_5.45x39")
            end
        elseif c_order == "rifle_nato" then
            cap = 6
            check_func = function(sec)
                local s = sec:lower()
                return s:find("ammo_5.56x45")
            end
        elseif c_order == "rifle_heavy" then
            cap = 6
            check_func = function(sec)
                local s = sec:lower()
                return s:find("ammo_7.62x39")
            end
        elseif c_order == "sniper" then
            cap = 6
            check_func = function(sec)
                local s = sec:lower()
                return s:find("ammo_7.62x54") or s:find("ammo_7.62x51") or s:find("ammo_9x39") or s:find("ammo_magnum_338") or s:find("ammo_12.7x55")
            end
        elseif c_order == "turret" then
            cap = 10
            if camp and camp.structures then
                local total_turret_deficit = 0
                for id, stype in pairs(camp.structures) do
                    local se_t = alife_object(id)
                    local tsec = se_t and se_t:section_name()
                    if tsec and tsec:find("turret") and not tsec:find("table") then
                        local cur_rounds = (sb.get_turret_ammo_count and sb.get_turret_ammo_count(id)) or 0
                        if cur_rounds < 40 then
                            total_turret_deficit = total_turret_deficit + (40 - cur_rounds)
                        end
                    end
                end
                if total_turret_deficit > 0 then
                    local available_rounds = 0
                    if sb.camp_iterate_inventory then
                        sb.camp_iterate_inventory(hub_id, camp, function(item_id, sec, cond, uses, se_obj, cid, cl_item)
                            if sec and (sec:find("^ammo_9x19") or sec:find("^ammo_9x18")) then
                                local b_count = 20
                                if cl_item then
                                    pcall(function() b_count = cl_item:ammo_get_count() or 20 end)
                                elseif se_obj then
                                    local ok_b, b = pcall(function() return se_obj.elapsed or se_obj:ammo_get_count() end)
                                    if ok_b and b and b > 0 then b_count = b end
                                end
                                available_rounds = available_rounds + b_count
                                if available_rounds >= total_turret_deficit then return true end
                            end
                        end)
                    end
                    if available_rounds < total_turret_deficit then
                        return false
                    end
                end
            end
            check_func = function(sec)
                local s = sec:lower()
                return s:find("ammo_9x19") or s:find("ammo_9x18")
            end
        else -- "auto"
            cap = 15
            if camp and camp.structures then
                local total_turret_deficit = 0
                for id, stype in pairs(camp.structures) do
                    local se_t = alife_object(id)
                    local tsec = se_t and se_t:section_name()
                    if tsec and tsec:find("turret") and not tsec:find("table") then
                        local cur_rounds = (sb.get_turret_ammo_count and sb.get_turret_ammo_count(id)) or 0
                        if cur_rounds < 40 then
                            total_turret_deficit = total_turret_deficit + (40 - cur_rounds)
                        end
                    end
                end
                if total_turret_deficit > 0 then
                    local available_rounds = 0
                    if sb.camp_iterate_inventory then
                        sb.camp_iterate_inventory(hub_id, camp, function(item_id, sec, cond, uses, se_obj, cid, cl_item)
                            if sec and (sec:find("^ammo_9x19") or sec:find("^ammo_9x18")) then
                                local b_count = 20
                                if cl_item then
                                    pcall(function() b_count = cl_item:ammo_get_count() or 20 end)
                                elseif se_obj then
                                    local ok_b, b = pcall(function() return se_obj.elapsed or se_obj:ammo_get_count() end)
                                    if ok_b and b and b > 0 then b_count = b end
                                end
                                available_rounds = available_rounds + b_count
                                if available_rounds >= total_turret_deficit then return true end
                            end
                        end)
                    end
                    if available_rounds < total_turret_deficit then
                        return false
                    end
                end
            end
            check_func = function(sec)
                local s = sec:lower()
                return s:find("ammo_")
            end
        end
    end

    if not check_func then return false end

    if sb.camp_count_item then
        return sb.camp_count_item(hub_id, camp, check_func, cap) >= cap
    end
    return false
end

-- process_ammo_crafting -- consume gunpowder + scrap, produce ammo box
function stalker_camp_builder.process_ammo_crafting(npc_id, box_id, camp, survivor, fallback_box_id)
    local ipairs_ = ipairs
    local sb = stalker_camp_builder
    local hub_id = (camp and camp.hub_id) or fallback_box_id or box_id
    local craft_order = survivor and survivor.craft_order or "auto"

    if sb.is_camp_supply_capped and sb.is_camp_supply_capped(hub_id, camp, "ammo", craft_order) then
        local npc = level.object_by_id(npc_id)
        local npc_name = npc and npc:character_name() or (survivor and survivor.name or "Survivor")
        sb.camp_send_tip(db.actor, string.format(game.translate_string("st_job_ammo_stocked"), npc_name), nil, "general_stalker", 10000)
        if survivor then survivor.shortfall_reason = "Stockpile Full" end
        return false
    end

    local found_powders = {}
    local scrap_id = nil

    local function check_sec(sec, item_id)
        if not sec then return end
        local s = sec:lower()
        if is_gunpowder(s) then
            found_powders[#found_powders + 1] = { id = item_id, sec = s, tier = GUNPOWDER_TIER[s] }
        elseif is_scrap(s) then
            if not scrap_id then
                scrap_id = item_id
            end
        end
    end

    if sb.camp_iterate_inventory then
        sb.camp_iterate_inventory(hub_id, camp, function(item_id, sec, cond, uses, se_obj, cid)
            check_sec(sec, item_id)
        end, box_id or fallback_box_id)
    end

    if #found_powders > 0 and scrap_id then
        table.sort(found_powders, function(a, b) return a.tier < b.tier end)
        local chosen_pw = found_powders[1]
        local gunpowder_id = chosen_pw.id
        local gp_sec = chosen_pw.sec

        local has_turrets = false
        local turrets_need_ammo = false
        if camp and camp.structures then
            for id, stype in pairs(camp.structures) do
                if stype == "gadget" then
                    local se_t = alife_object(id)
                    local tsec = se_t and se_t:section_name()
                    if tsec and tsec:find("turret") and not tsec:find("table") then
                        has_turrets = true
                        local t_ammo = (sb.get_turret_ammo_count and sb.get_turret_ammo_count(id)) or 0
                        if t_ammo < 40 then
                            turrets_need_ammo = true
                        end
                    end
                end
            end
        end

        local prefer_turrets = (sb.cfg.craft_prefer_turret_ammo ~= false) and has_turrets and turrets_need_ammo

        local ammo_pool = {}
        if craft_order == "pistol" then
            ammo_pool = {"ammo_9x18_fmj", "ammo_9x19_fmj", "ammo_11.43x23_fmj"}
        elseif craft_order == "shotgun" then
            ammo_pool = {"ammo_12x70_buck", "ammo_20x70_buck"}
        elseif craft_order == "rifle_soviet" then
            ammo_pool = {"ammo_5.45x39_fmj"}
        elseif craft_order == "rifle_nato" then
            ammo_pool = {"ammo_5.56x45_fmj"}
        elseif craft_order == "rifle_heavy" then
            ammo_pool = {"ammo_7.62x39_fmj"}
        elseif craft_order == "sniper" then
            ammo_pool = {"ammo_7.62x54_7h1", "ammo_7.62x51_fmj", "ammo_9x39_ap"}
        elseif craft_order == "turret" or (craft_order == "auto" and prefer_turrets) then
            if chosen_pw.tier >= 3 then
                ammo_pool = {"ammo_9x19_ap", "ammo_9x19_pbp"}
            elseif chosen_pw.tier == 2 then
                ammo_pool = {"ammo_9x19_fmj", "ammo_9x19_pbp"}
            else
                ammo_pool = {"ammo_9x19_fmj", "ammo_9x18_fmj"}
            end
        else
            if chosen_pw.tier == 1 or gp_sec:find("pistol") or gp_sec:find("handgun") or gp_sec:find("powder_1") then
                ammo_pool = {"ammo_9x18_fmj", "ammo_9x19_fmj", "ammo_11.43x23_fmj", "ammo_12x70_buck"}
            elseif gp_sec:find("shotgun") or gp_sec:find("buck") then
                ammo_pool = {"ammo_12x70_buck", "ammo_20x70_buck"}
            elseif chosen_pw.tier == 2 or gp_sec:find("rifle") or gp_sec:find("powder_2") then
                ammo_pool = {"ammo_5.45x39_fmj", "ammo_5.56x45_fmj", "ammo_7.62x39_fmj"}
            elseif chosen_pw.tier == 3 or gp_sec:find("large") or gp_sec:find("heavy") or gp_sec:find("powder_3") or gp_sec:find("powder_4") then
                ammo_pool = {"ammo_7.62x54_7h1", "ammo_7.62x51_fmj", "ammo_9x39_ap"}
            else
                ammo_pool = {"ammo_9x18_fmj", "ammo_9x19_fmj", "ammo_11.43x23_fmj", "ammo_5.45x39_fmj", "ammo_5.56x45_fmj", "ammo_12x70_buck"}
            end
        end

        local valid_pool = {}
        for _, asec in ipairs_(ammo_pool) do
            if ini_sys and ini_sys.section_exist and ini_sys:section_exist(asec) then
                valid_pool[#valid_pool+1] = asec
            end
        end
        if #valid_pool == 0 then
            valid_pool = {"ammo_9x18_fmj", "ammo_9x19_fmj"}
        end

        -- DANZY EDIT (balance): settlers only make basic (non-AP) ammo
        local basic_pool = {}
        for _, asec in ipairs_(valid_pool) do
            if not asec:find("_ap") and not asec:find("9x39") then basic_pool[#basic_pool+1] = asec end
        end
        if #basic_pool > 0 then valid_pool = basic_pool end
        local spawned_ammo = valid_pool[math.random(#valid_pool)]

        consume_one_use(gunpowder_id)
        local se_scrap = alife_object(scrap_id)
        if se_scrap then
            alife_release(se_scrap)
        end

        local base_mult = math.max(1, math.floor(sb.cfg.craft_output_multiplier or 1))
        local spec_mult = (sb.get_specialization_mult and camp and sb.get_specialization_mult(camp, "craft")) or 1.0
        local total_craft = base_mult * spec_mult
        local mult = math.max(1, math.floor(total_craft) + (math.random() < (total_craft - math.floor(total_craft)) and 1 or 0))
        local h_id = (camp and camp.hub_id) or fallback_box_id or box_id
        if sb.deposit_item_to_camp and camp and h_id then
            for i = 1, mult do
                sb.deposit_item_to_camp(h_id, camp, spawned_ammo)
            end
        else
            local target_box_id = (sb.get_auto_sort_target_box and camp and sb.get_auto_sort_target_box(camp, h_id, spawned_ammo)) or box_id
            local box_se = alife_object(target_box_id)
            local pos = box_se and box_se.position or vector()
            local lvid = box_se and box_se.m_level_vertex_id or 0
            local gvi = box_se and box_se.m_game_vertex_id or 0
            for i = 1, mult do
                alife():create(spawned_ammo, pos, lvid, gvi, target_box_id)
            end
        end

        local npc = level.object_by_id(npc_id)
        local npc_name = npc and npc:character_name() or (survivor and survivor.name or "Survivor")
        sb.camp_send_tip(db.actor, string.format(game.translate_string("st_job_ammo_crafted"), npc_name, ui_item.get_sec_name(spawned_ammo)), nil, "general_stalker", 10000)
        if survivor then survivor.shortfall_reason = nil end
        return true
    end

    if #found_powders == 0 and not scrap_id then
        if survivor then survivor.shortfall_reason = "Need Powder & Scrap" end
    elseif #found_powders == 0 then
        if survivor then survivor.shortfall_reason = "Need Gunpowder" end
    elseif not scrap_id then
        if survivor then survivor.shortfall_reason = "Need Scrap Metal" end
    end

    return false
end

-- What a technician takes as payment; the paused check and the job must agree
local REPAIR_FEES = { vodka = true, conserva = true, tushonka = true }
local function is_repair_fee(sec) return REPAIR_FEES[sec] == true end

-- a gun with a part below 95%: G.A.M.M.A. holds a fired gun's condition at 0.83 and keeps its wear
-- in the WPO parts, which don't follow condition. Only the parts in its list count, the ones a
-- repair round raises.
local function gun_parts_worn(item_id, sec)
    if not (sec and sec:find("wpn_") and item_parts and item_parts.get_parts_con) then return false end
    local ini_parts = itms_manager and itms_manager.ini_parts
    local psec = ini_sys and ini_sys:r_string_ex(sec, "parent_section") or sec
    local list = ini_parts and ini_parts:r_string_ex("con_parts_list", psec)
    local parts = list and item_parts.get_parts_con(nil, item_id)
    if type_(parts) ~= "table" then return false end
    for _, p_name in ipairs_(str_explode(list, ",")) do
        local con = parts[p_name]
        if type_(con) == "number" and con < 95 then return true end
    end
    return false
end

-- process_gear_repair -- repair one or more damaged items in exchange for food
function stalker_camp_builder.process_gear_repair(npc_id, box_id, camp, survivor, fallback_box_id)
    local ipairs_ = ipairs
    local mfloor = math.floor
    local mmin = math.min
    local type_ = type
    local sb = stalker_camp_builder
    local hub_id = (camp and camp.hub_id) or fallback_box_id or box_id

    local function is_valid_box(bid)
        if not bid then return false end
        if sb.is_valid_camp_box then
            return sb.is_valid_camp_box(bid, hub_id, camp)
        end
        return sb.is_actual_container and sb.is_actual_container(bid)
    end

    local container_ids = {}
    local seen_boxes = {}
    local function add_box(bid)
        if bid and is_valid_box(bid) and not seen_boxes[bid] then
            seen_boxes[bid] = true
            container_ids[#container_ids + 1] = bid
        end
    end
    add_box(box_id)
    add_box(fallback_box_id)
    local all_c = (sb.get_camp_containers and sb.get_camp_containers(hub_id, camp)) or {}
    for _, bid in ipairs_(all_c) do
        add_box(bid)
    end

    if #container_ids == 0 then
        if survivor then survivor.shortfall_reason = "No Storage Container" end
        return false
    end

    local tier_mult = survivor and sb.get_survivor_tier_mult(survivor) or 1.0
    local spec_mult = camp and sb.get_specialization_mult(camp, "repair") or 1.0
    -- the tier sets the rounds; the specialization raises each round's repair (repair_inc)
    local total_repairs = tier_mult
    local items_to_repair = math.max(1, math.floor(total_repairs) + (math.random() < (total_repairs - math.floor(total_repairs)) and 1 or 0))

    -- DANZY EDIT: technicians only repair gear placed in a workbench, so loot in
    -- your stashes keeps its found condition.
    -- A Workshop keeps its gear in a hidden workshop_stash, the box camp_iterate_inventory
    -- reports, so the set holds that stash's id
    local m_data = alife_storage_manager and alife_storage_manager.get_state()
    local ws = m_data and m_data.workshop_stashes or {}
    local wb_set = {}
    local has_wb = false
    for sid, stype in pairs(camp and camp.structures or {}) do
        if stype == "workbench" or stype == "repair_bench" then wb_set[ws[sid] or sid] = true; has_wb = true end
    end
    -- the settlement's own Workshop (the hub) counts as a workbench too
    if hub_id and ws[hub_id] then wb_set[ws[hub_id]] = true; has_wb = true end
    if not has_wb then
        if survivor then survivor.shortfall_reason = "No Workbench" end
        return false
    end

    local repaired_any = false

    for repair_round = 1, items_to_repair do
        local repair_item_id = nil
        local repair_item_cond = 0.0
        local fee_item_id = nil
        local item_name = ""

        local function check_item_repair_and_fee(sec, item_id, get_cond_fn)
            if fee_item_id and repair_item_id then return end
            if not sec then return end

            if (sec == "vodka" or sec == "conserva" or sec == "tushonka") and not fee_item_id then
                fee_item_id = item_id
            else
                local is_gear = false
                if sec:find("wpn_") or sec:find("helm_") or sec:find("armor_") or sec:find("outfit") then
                    is_gear = true
                end

                local cond = get_cond_fn() or 1.0
                if is_gear and cond < 0.95 and not repair_item_id then
                    repair_item_id = item_id
                    repair_item_cond = cond
                    item_name = ui_item.get_sec_name(sec)
                end
            end
        end

        sb.camp_iterate_inventory(hub_id, camp, function(item_id, sec, cond, uses, se_obj, cid, cl_item)
            if not sec then return end
            if not fee_item_id and is_repair_fee(sec) then
                fee_item_id = item_id
            elseif not repair_item_id and wb_set[cid] then
                local is_gear = false
                if cl_item then
                    pcall(function() is_gear = IsWeapon(cl_item) or IsOutfit(cl_item) or IsHeadgear(cl_item) end)
                end
                if not is_gear and (sec:find("wpn_") or sec:find("helm_") or sec:find("armor_") or sec:find("outfit")) then
                    is_gear = true
                end
                -- an offline item's condition can't be written (server items export none); a gun's
                -- wear can be in its parts alone
                if is_gear and cl_item and (cond < 0.95 or gun_parts_worn(item_id, sec)) then
                    repair_item_id = item_id
                    repair_item_cond = cond
                    item_name = ui_item.get_sec_name(sec)
                end
            end
            if fee_item_id and repair_item_id then return true end
        end, box_id)

        if repair_item_id and fee_item_id then
            local se_rep = alife_object(repair_item_id)
            if se_rep then
                repaired_any = true
                local cl_rep = level.object_by_id(repair_item_id)
                local cur_cond = repair_item_cond
                if cl_rep then
                    pcall(function() cur_cond = cl_rep:condition() end)
                elseif se_rep.condition then
                    cur_cond = se_rep.condition
                end

                local repair_inc = ((sb.cfg.repair_percent_per_cycle or 25) / 100.0) * spec_mult
                local new_cond = mmin(1.0, cur_cond + repair_inc)

                pcall(function() se_rep.condition = new_cond end)

                if cl_rep and cl_rep.set_condition then
                    pcall(function() cl_rep:set_condition(new_cond) end)
                end

                pcall(function()
                    local mfloor = math.floor
                    local type_ = type
                    if item_parts then
                        local rep_sec = cl_rep and cl_rep:section() or se_rep:section_name()
                        local ini_parts = itms_manager and itms_manager.ini_parts
                        local sec = ini_sys and ini_sys:r_string_ex(rep_sec, "parent_section") or rep_sec
                        local parts_str = ini_parts and ini_parts:r_string_ex("con_parts_list", sec)
                        local parts_list = parts_str and str_explode(parts_str, ",") or {}

                        local parts = nil
                        if cl_rep and item_parts.get_parts_con then
                            parts = item_parts.get_parts_con(cl_rep, repair_item_id, false)
                        end
                        if type_(parts) ~= "table" then
                            local rep_name = (cl_rep and cl_rep:name()) or (se_rep and se_rep.section_name and se_rep:section_name() .. "_" .. tostring(repair_item_id)) or nil
                            parts = (rep_name and se_load_var(repair_item_id, rep_name, "parts")) or se_load_var(repair_item_id, nil, "parts")
                        end
                        if type_(parts) ~= "table" and cl_rep and item_parts.evaluate_parts then
                            item_parts.evaluate_parts(cl_rep)
                            parts = item_parts.get_parts_con(cl_rep, repair_item_id, false)
                        end
                        if type_(parts) ~= "table" then
                            parts = {}
                        end

                        local inc_pct = mfloor(repair_inc * 100)
                        for _, p_name in ipairs_(parts_list) do
                            local cur_p = parts[p_name] or mfloor(cur_cond * 100)
                            parts[p_name] = mmin(100, mfloor(cur_p + inc_pct))
                        end
                        parts[sec] = mmin(100, mfloor(new_cond * 100))

                        local rep_name = (cl_rep and cl_rep:name()) or (se_rep and se_rep.section_name and se_rep:section_name() .. "_" .. tostring(repair_item_id)) or nil
                        se_save_var(repair_item_id, nil, "parts", parts)
                        if rep_name then
                            se_save_var(repair_item_id, rep_name, "parts", parts)
                        end
                        if item_parts.set_parts_con then
                            item_parts.set_parts_con(repair_item_id, parts)
                        end
                    end
                end)

                consume_one_use(fee_item_id)

                if repair_round == 1 then
                    local npc = level.object_by_id(npc_id)
                    local npc_name = npc and npc:character_name() or (survivor and survivor.name or "Survivor")
                    local pct_str = tostring(mfloor(new_cond * 100))
                    sb.camp_send_tip(db.actor, string.format(game.translate_string("st_job_gear_repaired"), npc_name, item_name, pct_str), nil, "general_stalker", 10000)
                end
            end
        else
            break  -- no more items to repair
        end
    end

    if not repaired_any then
        if survivor and not survivor.shortfall_reason then
            survivor.shortfall_reason = "No Gear to Repair"
        end
    end
    return repaired_any
end

-- get_cooked_version -- convert raw meat section to its cooked equivalent
function stalker_camp_builder.get_cooked_version(sec, tier)
    local sb = stalker_camp_builder
    tier = tier or sb.cfg.cook_output_tier or 1

    if tier >= 3 then
        local t3_options = {"kolbasa", "ration_ru", "bread", "conserva"}
        for _, s in ipairs(t3_options) do
            if ini_sys and ini_sys.section_exist and ini_sys:section_exist(s) then
                return s
            end
        end
    end

    if tier == 2 then
        local base_meat = sb.meat_cooking_map[sec]
        if base_meat then
            local enhanced_sec = base_meat .. "_b"
            if ini_sys and ini_sys.section_exist and ini_sys:section_exist(enhanced_sec) then
                return enhanced_sec
            end
        end
        local t2_options = {"conserva", "tushonka"}
        for _, s in ipairs(t2_options) do
            if ini_sys and ini_sys.section_exist and ini_sys:section_exist(s) then
                return s
            end
        end
    end

    if sb.meat_cooking_map[sec] then
        if ini_sys and ini_sys.section_exist and ini_sys:section_exist(sb.meat_cooking_map[sec]) then
            return sb.meat_cooking_map[sec]
        end
    end

    local clean_name = sec:gsub("mutant_part_", "meat_")
    clean_name = clean_name:gsub("_meat", "")
    clean_name = clean_name:gsub("_chop", "")
    clean_name = clean_name:gsub("_hand", "")
    if ini_sys and ini_sys.section_exist and ini_sys:section_exist(clean_name) then
        return clean_name
    end
    local cooked_sec = sec .. "_cooked"
    if ini_sys and ini_sys.section_exist and ini_sys:section_exist(cooked_sec) then
        return cooked_sec
    end
    return "tushonka"
end

-- find_and_consume_item -- search camp containers, consume first match
function stalker_camp_builder.find_and_consume_item(hub_id, camp, section_check_func, priority_box_id)
    if stalker_camp_builder.camp_consume_item then
        return stalker_camp_builder.camp_consume_item(hub_id, camp, section_check_func, priority_box_id)
    end
    return nil
end

function stalker_camp_builder.camp_has_item(hub_id, camp, section_check_func, priority_box_id)
    if stalker_camp_builder.camp_find_item then
        return (stalker_camp_builder.camp_find_item(hub_id, camp, section_check_func, priority_box_id) ~= nil)
    end
    return false
end

-- camp_has_repairable_gear -- non-destructive check for damaged gear and fee
function stalker_camp_builder.camp_has_repairable_gear(hub_id, camp)
    local sb = stalker_camp_builder
    local sim = alife()
    if not sim or not camp then return false, false end

    local has_damaged = false
    local has_fee = false

    local function check_item(sec, cond, item_id)
        if not has_fee and is_repair_fee(sec) then
            has_fee = true
        end
        if not has_damaged and sec and cond and (cond < 0.95 or (item_id and gun_parts_worn(item_id, sec))) then
            if sec:find("wpn_") or sec:find("helm_") or sec:find("armor_") or sec:find("outfit") then
                has_damaged = true
            end
        end
    end

    -- a Workshop's gear is in its workshop_stash, the box id the callback below gets
    local m_data = alife_storage_manager and alife_storage_manager.get_state()
    local ws = m_data and m_data.workshop_stashes or {}
    local wb_only = {}
    if hub_id and ws[hub_id] then wb_only[ws[hub_id]] = true end
    for sid, stype in pairs(camp.structures or {}) do
        if stype == "workbench" or stype == "repair_bench" then wb_only[ws[sid] or sid] = true end
    end
    if hub_id then wb_only[hub_id] = true end
    if sb.camp_iterate_inventory then
        sb.camp_iterate_inventory(hub_id, camp, function(item_id, sec, cond, uses, se_obj, box_id, cl_item)
            -- only online gear counts: process_gear_repair can't repair the rest
            local in_bench = wb_only[box_id] and cl_item
            check_item(sec, in_bench and cond or 1.0, in_bench and item_id or nil)  -- DANZY EDIT: damaged gear only counts inside a workbench
            if has_damaged and has_fee then return true end
        end)
    end

    return has_damaged, has_fee
end

-- get_job_paused_status -- authoritative check for paused settlement jobs
function stalker_camp_builder._calc_job_paused_status(survivor, camp, hub_id, snap)
    local pairs_ = pairs
    local sb = stalker_camp_builder
    if not survivor then return false, nil, nil end
    local job = survivor.job or "idle"

    if job == "companion" or survivor.is_companion then
        return true, "Companion", "Settler is travelling with player companion squad"
    end

    if job == "idle" or job == "guard" then
        return false, nil, nil
    end

    if not camp or not hub_id then
        if survivor.hub_id and sb.active_camps and sb.active_camps[survivor.hub_id] then
            hub_id = survivor.hub_id
            camp = sb.active_camps[hub_id]
        elseif sb.settler_lookup then
            for nid, ent in pairs_(sb.settler_lookup) do
                if ent.survivor == survivor then
                    hub_id = ent.hub_id
                    camp = ent.camp
                    break
                end
            end
        end
        if not camp and sb.active_camps then
            for hid, c in pairs_(sb.active_camps) do
                if c.survivors then
                    for nid, s in pairs_(c.survivors) do
                        if s == survivor or (survivor.name and s.name == survivor.name) then
                            hub_id = hid
                            camp = c
                            break
                        end
                    end
                end
                if camp then break end
            end
        end
    end

    if not camp then
        return false, nil, nil
    end

    if not snap and sb.get_camp_inventory_snapshot and hub_id then
        snap = sb.get_camp_inventory_snapshot(hub_id, camp, false)
    end

    local function check_container(bid)
        if not bid then return false end
        if sb.is_actual_container then return sb.is_actual_container(bid) end
        return true
    end

    local is_producing_job = (job == "cook" or job == "craft" or job == "medic" or job == "hunter" or job == "scrapper" or job == "woodcutter" or job == "brewer")
    if is_producing_job then
        local has_room = (snap and snap.has_storage_room) or (sb.camp_has_storage_room and sb.camp_has_storage_room(camp, hub_id, 0.5))
        if not has_room then
            return true, "Storage Full", "All settlement storage containers are at maximum capacity"
        end
    end

    if job == "cook" then
        if snap then
            if sb.cfg and sb.cfg.enable_surplus_cap ~= false and snap.food_count >= 15 then
                return true, "Stockpile Full", "Food stockpile is full (15+ rations stored)"
            end
            local has_meat = (snap.fridge_id and snap.fridge_raw_meat_count > 0) or (not snap.fridge_id and snap.raw_meat_count > 0)
            if not has_meat then
                return true, "No Raw Meat", "No raw mutant meat in settlement storage"
            end
            return false, nil, nil
        end

        if sb.is_camp_supply_capped and sb.is_camp_supply_capped(hub_id, camp, "food") then
            return true, "Stockpile Full", "Food stockpile is full (15+ rations stored)"
        end
        local fridge_id = nil
        for struct_id, struct_type in pairs_(camp.structures or {}) do
            if struct_type == "fridge" and check_container(struct_id) then
                fridge_id = struct_id
                break
            end
        end
        local raw_meats = {
            ["mutant_part_tushkano_meat"]  = true,
            ["mutant_part_dog_meat"]       = true,
            ["mutant_part_psevdodog_meat"] = true,
            ["mutant_part_flesh_meat"]     = true,
            ["mutant_part_boar_chop"]      = true,
            ["mutant_part_snork_hand"]     = true,
            ["mutant_part_krovosos_meat"]  = true,
            ["mutant_part_psysucker_meat"] = true,
            ["mutant_part_lurker_meat"]    = true,
            ["mutant_part_chimera_meat"]   = true,
        }
        local has_meat = sb.camp_has_item and sb.camp_has_item(hub_id, camp, function(sec) return raw_meats[sec] == true end, fridge_id)
        if not has_meat then
            return true, "No Raw Meat", "No raw mutant meat in settlement storage"
        end
        return false, nil, nil

    elseif job == "craft" then
        local has_workbench = false
        for struct_id, struct_type in pairs_(camp.structures or {}) do
            if struct_type == "workbench" or check_container(struct_id) then
                has_workbench = true
                break
            end
        end
        if not has_workbench and (camp.hub_id or hub_id) then
            has_workbench = true
        end
        if not has_workbench then
            return true, "No Workbench", "Settlement requires an assembled Workbench"
        end

        if snap then
            if sb.cfg and sb.cfg.enable_surplus_cap ~= false then
                local c_order = survivor.craft_order or "auto"
                local cap = (c_order == "pistol" or c_order == "shotgun") and 8 or ((c_order == "turret" or c_order == "auto") and 10 or 6)
                if (snap.ammo_counts[c_order] or 0) >= cap then
                    return true, "Stockpile Full", "Target ammunition supplies are fully stocked (6+ boxes stored)"
                end
            end
            if not snap.has_powder and not snap.has_scrap then
                return true, "Need Powder & Scrap", "Missing gunpowder and scrap metal in settlement storage"
            elseif not snap.has_powder then
                return true, "Need Gunpowder", "Missing gunpowder in settlement storage"
            elseif not snap.has_scrap then
                return true, "Need Scrap Metal", "Missing scrap metal in settlement storage"
            end
            return false, nil, nil
        end

        if sb.is_camp_supply_capped and sb.is_camp_supply_capped(hub_id, camp, "ammo", survivor) then
            return true, "Stockpile Full", "Target ammunition supplies are fully stocked (6+ boxes stored)"
        end

        local has_powder = sb.camp_has_item and sb.camp_has_item(hub_id, camp, function(sec)
            return is_gunpowder(sec:lower())
        end)
        local has_scrap = sb.camp_has_item and sb.camp_has_item(hub_id, camp, function(sec)
            return is_scrap(sec)
        end)
        if not has_powder and not has_scrap then
            return true, "Need Powder & Scrap", "Missing gunpowder and scrap metal in settlement storage"
        elseif not has_powder then
            return true, "Need Gunpowder", "Missing gunpowder in settlement storage"
        elseif not has_scrap then
            return true, "Need Scrap Metal", "Missing scrap metal in settlement storage"
        end
        return false, nil, nil

    elseif job == "repair" then
        local has_workbench = false
        for struct_id, struct_type in pairs_(camp.structures or {}) do
            if struct_type == "workbench" or check_container(struct_id) then
                has_workbench = true
                break
            end
        end
        if not has_workbench and (camp.hub_id or hub_id) then
            has_workbench = true
        end
        if not has_workbench then
            return true, "No Workbench", "Settlement requires an assembled Workbench"
        end

        if snap then
            if not snap.has_damaged_gear then
                return true, "No Damaged Gear", "No damaged weapons or armor (<95%) to repair"
            end
            if not snap.has_repair_fee then
                return true, "Needs Vodka/Food", "Technician requires vodka or canned food provisions"
            end
            return false, nil, nil
        end

        -- both results ("x and f()" keeps only the first, which left has_fee nil)
        local has_damaged, has_fee = false, false
        if sb.camp_has_repairable_gear then
            has_damaged, has_fee = sb.camp_has_repairable_gear(hub_id, camp)
        end
        if not has_damaged then
            return true, "No Damaged Gear", "No damaged weapons or armor (<95%) to repair"
        end
        if has_fee == false then
            return true, "Needs Vodka/Food", "Technician requires vodka or canned food provisions"
        end
        return false, nil, nil

    elseif job == "medic" then
        local has_medstation = false
        for struct_id, struct_type in pairs_(camp.structures or {}) do
            if struct_type == "medstation" or struct_type == "workbench" then
                has_medstation = true
                break
            end
        end
        if not has_medstation then
            return true, "No Medstation", "Settlement requires a Medstation or Workbench"
        end

        local m_order = survivor and survivor.medic_order or "auto"
        local req_vodka = (m_order == "akvatab" and 5) or (m_order == "kalium" and 3) or (m_order == "medkit" and 4) or 1

        if snap then
            if sb.cfg and sb.cfg.enable_surplus_cap ~= false then
                local cap = (m_order == "auto" or m_order == "bandage") and 15 or 8
                if (snap.med_counts[m_order] or 0) >= cap then
                    return true, "Stockpile Full", "Target medical supplies are fully stocked (8+ stored)"
                end
            end
            if m_order == "bandage" or m_order == "auto" then
                if not snap.has_cloth and snap.total_ethanol < 1 then
                    return true, "No Materials", "Requires Vodka, Antiseptic, or Cloth to synthesize medical supplies"
                end
            else
                if snap.total_ethanol < req_vodka then
                    return true, string.format("Need %dx Vodka", req_vodka), string.format("Requires %dx Vodka in settlement storage to synthesize this medicine", req_vodka)
                end
                if m_order == "medkit" and not snap.has_bandage then
                    return true, "Need Bandage", "Requires a Bandage in settlement storage to make a Medkit"
                end
            end
            return false, nil, nil
        end

        if sb.is_camp_supply_capped and sb.is_camp_supply_capped(hub_id, camp, "meds", survivor) then
            return true, "Stockpile Full", "Target medical supplies are fully stocked (8+ stored)"
        end

        local total_ethanol = 0
        if sb.camp_iterate_inventory then
            sb.camp_iterate_inventory(hub_id, camp, function(item_id, sec, cond, uses, se_obj, cid, cl_item)
                if not sec then return end
                local s = sec:lower()
                if s:find("vodka") or s:find("antiseptic") or s == "alcohol" then
                    local u = uses or 1
                    if u < 1 then u = 1 end
                    total_ethanol = total_ethanol + u
                    if total_ethanol >= req_vodka then return true end
                end
            end)
        end

        if m_order == "bandage" then
            local has_cloth = sb.camp_has_item and sb.camp_has_item(hub_id, camp, is_cloth)
            if not has_cloth and total_ethanol < 1 then
                return true, "No Materials", "Requires Vodka, Antiseptic, or Cloth to craft Bandages"
            end
        elseif m_order == "auto" then
            local has_cloth = sb.camp_has_item and sb.camp_has_item(hub_id, camp, is_cloth)
            if not has_cloth and total_ethanol < 1 then
                return true, "No Materials", "Requires Vodka, Antiseptic, or Cloth to synthesize medical supplies"
            end
        else
            if total_ethanol < req_vodka then
                return true, string.format("Need %dx Vodka", req_vodka), string.format("Requires %dx Vodka in settlement storage to synthesize this medicine", req_vodka)
            end
            -- process_medic_job's medkit takes a bandage too
            if m_order == "medkit" and not (sb.camp_has_item and sb.camp_has_item(hub_id, camp, function(s) return s == "bandage" end)) then
                return true, "Need Bandage", "Requires a Bandage in settlement storage to make a Medkit"
            end
        end

        return false, nil, nil

    elseif job == "hunter" then
        local has_container = false
        for struct_id, struct_type in pairs_(camp.structures or {}) do
            if struct_type == "fridge" or struct_type == "stash" or struct_type == "box" or struct_type == "workbench" or check_container(struct_id) then
                has_container = true
                break
            end
        end
        if not has_container and (camp.primary_chest_id or hub_id) then
            has_container = true
        end
        if not has_container then
            return true, "No Storage", "No container in settlement to deposit meat"
        end
        return false, nil, nil

    elseif job == "scavenge" then
        if survivor.on_expedition then
            return false, nil, nil
        end
        local has_container = false
        for struct_id, struct_type in pairs_(camp.structures or {}) do
            if struct_type == "stash" or struct_type == "box" or struct_type == "workbench" or struct_type == "fridge" or check_container(struct_id) then
                has_container = true
                break
            end
        end
        if not has_container and (camp.primary_chest_id or hub_id) then
            has_container = true
        end
        if not has_container then
            return true, "No Storage", "No storage container to deposit loot"
        end
        local has_room = (snap and snap.has_storage_room) or (sb.camp_has_storage_room and sb.camp_has_storage_room(camp, hub_id, 0.5))
        if not has_room then
            return true, "Storage Full", "All settlement storage containers are at maximum capacity"
        end
        return false, nil, nil

    elseif job == "electrician" then
        local has_lights = false
        for struct_id, struct_type in pairs_(camp.structures or {}) do
            if struct_type == "light" then
                has_lights = true
                break
            end
        end
        if not has_lights then
            return true, "No Lamps", "Camp has no lamps or spotlights to power/maintain"
        end
        if snap then
            if not snap.has_battery then
                return true, "No Battery", "Camp storage has no batteries for electrician maintenance"
            end
            return false, nil, nil
        end
        local has_batt = sb.camp_has_item and sb.camp_has_item(hub_id, camp, is_lamp_battery)
        if not has_batt then
            return true, "No Battery", "Camp storage has no batteries for electrician maintenance"
        end
        return false, nil, nil

    elseif job == "woodcutter" then
        local mode = survivor.woodcutter_mode or "auto"
        if mode == "charcoal" then
            if snap then
                if snap.wood_count <= 0 then
                    return true, "No Wood", "Requires wood parts in camp storage to burn charcoal"
                end
                return false, nil, nil
            end
            local has_wood = sb.camp_has_item and sb.camp_has_item(hub_id, camp, is_wood_part)
            if not has_wood then
                return true, "No Wood", "Requires wood parts in camp storage to burn charcoal"
            end
        end
        return false, nil, nil

    elseif job == "brewer" then
        local has_still = false
        for struct_id, struct_type in pairs_(camp.structures or {}) do
            if struct_type == "stove" or struct_type == "bidon" or struct_type == "water_pump" or struct_type == "workbench" then
                has_still = true
                break
            end
        end
        if not has_still then
            return true, "No Still", "Camp requires a placed Milk Can (Bidon) or Stove"
        end
        if snap then
            if snap.clean_water_count <= 0 then
                return true, "No Water", "Requires clean water in camp storage to distill vodka"
            end
            if snap.wood_count < 10 then
                return true, "Need Wood", "Requires 10 wood parts in camp storage to distill vodka"
            end
            return false, nil, nil
        end
        local has_water = sb.camp_has_item and sb.camp_has_item(hub_id, camp, is_clean_water)
        if not has_water then
            return true, "No Water", "Requires clean water in camp storage to distill vodka"
        end
        -- process_brewer_job burns 10 wood parts a batch
        local wood = (sb.camp_count_item and sb.camp_count_item(hub_id, camp, is_wood_part, 10)) or 0
        if wood < 10 then
            return true, "Need Wood", "Requires 10 wood parts in camp storage to distill vodka"
        end
        return false, nil, nil

    elseif job == "scrapper" then
        local has_bench = false
        for struct_id, struct_type in pairs_(camp.structures or {}) do
            if struct_type == "workbench" or struct_type == "repair_bench" then
                has_bench = true
                break
            end
        end
        if not has_bench and not camp.hub_id then
            return true, "No Workbench", "Requires an assembled Workbench to process scrap"
        end
        return false, nil, nil
    end

    return false, nil, nil
end

function stalker_camp_builder.get_job_paused_status(survivor, camp, hub_id, max_age_ms)
    if not survivor then return false, nil, nil end
    local job = survivor.job or "idle"

    if job == "companion" or survivor.is_companion then
        return true, "Companion", "Settler is travelling with player companion squad"
    end

    if job == "idle" or job == "guard" then
        return false, nil, nil
    end

    local now_tg = time_global()
    local cache_ttl = max_age_ms or 10000 -- 10 seconds default matches master job update tick
    local c_tg = survivor._cached_paused_tg
    if c_tg and survivor._cached_paused_job == job and now_tg >= c_tg and (now_tg - c_tg) < cache_ttl then
        return survivor._cached_is_paused, survivor._cached_reason_short, survivor._cached_reason_detail
    end

    local is_p, r_short, r_detail = stalker_camp_builder._calc_job_paused_status(survivor, camp, hub_id)
    survivor._cached_paused_tg = now_tg
    survivor._cached_paused_job = job
    survivor._cached_is_paused = is_p
    survivor._cached_reason_short = r_short
    survivor._cached_reason_detail = r_detail
    return is_p, r_short, r_detail
end

-- process_cook_job -- consume raw meat + fuel, produce cooked meals
function stalker_camp_builder.process_cook_job(npc_id, hub_id, camp, survivor, box_id)
    local actor = db.actor
    local sb = stalker_camp_builder
    local fridge_id = nil
    local fridge_lvid = nil
    local stove_id = nil
    local stove_lvid = nil
    local is_actual_stove = false

    for struct_id, struct_type in pairs(camp.structures or {}) do
        if struct_type == "fridge" and sb.is_actual_container(struct_id) then
            fridge_id = struct_id
            local obj = alife_object(struct_id)
            if obj then fridge_lvid = obj.m_level_vertex_id end
        elseif struct_type == "stove" then
            stove_id = struct_id
            local obj = alife_object(struct_id)
            if obj then
                stove_lvid = obj.m_level_vertex_id
                local sec = obj:section_name()
                if sec:find("stove") then
                    is_actual_stove = true
                end
            end
        end
    end

    if box_id and not sb.is_actual_container(box_id) then
        box_id = nil
    end
    local meat_box_id = fridge_id or box_id
    if not meat_box_id then return end

    if sb.is_camp_supply_capped and sb.is_camp_supply_capped(hub_id, camp, "food") then
        local npc = level.object_by_id(npc_id)
        local npc_name = npc and npc:character_name() or (survivor and survivor.name or "Survivor")
        sb.camp_send_tip(actor, string.format(game.translate_string("st_job_food_stocked"), npc_name), nil, "general_stalker", 10000)
        return true
    end

    local raw_meats = {
        ["mutant_part_tushkano_meat"]  = true,
        ["mutant_part_dog_meat"]       = true,
        ["mutant_part_psevdodog_meat"] = true,
        ["mutant_part_flesh_meat"]     = true,
        ["mutant_part_boar_chop"]      = true,
        ["mutant_part_snork_hand"]     = true,
        ["mutant_part_krovosos_meat"]  = true,
        ["mutant_part_psysucker_meat"] = true,
        ["mutant_part_lurker_meat"]    = true,
        ["mutant_part_chimera_meat"]   = true,
    }

    local sim = alife()
    if not sim then return end

    -- meat first: catch-up cycles skip the paused check, and fuel, water or vodka taken for a
    -- meal that can't be cooked would be lost
    local function is_raw_meat(sec) return raw_meats[sec] == true end
    if not (sb.camp_has_item and sb.camp_has_item(hub_id, camp, is_raw_meat, fridge_id)) then
        if fridge_id then
            sb.camp_send_tip(actor, game.translate_string("st_job_cook_no_meat"), nil, "red_danger", 10000, hub_id, "work", true)
        end
        return false
    end

    local cooking_tier = 1
    local consumed_fuel = nil
    local consumed_water = nil
    local consumed_vodka = nil
    local cooking_method = game.translate_string("st_cooking_at_campfire")

    if is_actual_stove then
        local fuel_items = {
            ["charcoal"]            = true,
            ["kerosene"]            = true,
            ["gasoline"]            = true,
            ["gas_balloon"]         = true,
            ["gas_ballon"]          = true,
            ["gas_cylinder"]        = true,
            ["explo_balon_gas"]     = true,
            ["explo_jerrycan_fuel"] = true,
            ["jerrycan_fuel"]       = true,
        }
        -- with Cook Requires Fuel off, the stove cooks without burning anything
        local fired = (sb.cfg.cook_requires_fuel == false)
        if not fired then
            consumed_fuel = sb.find_and_consume_item(
                hub_id, camp,
                function(sec) return fuel_items[sec] == true end,
                stove_id
            )
            fired = consumed_fuel ~= nil
        end

        if fired then
            cooking_method = game.translate_string("st_cooking_on_stove")
            cooking_tier = 1

            local surv_tier = (survivor and survivor.tier) or 0
            local max_tier = math.max(sb.cfg.cook_output_tier or 1, surv_tier)

            if max_tier >= 3 then
                consumed_vodka = sb.find_and_consume_item(
                    hub_id, camp,
                    function(sec)
                        local s = sec:lower()
                        return s:find("vodka") or s == "vodka_quality" or s == "vodka_putinka"
                    end,
                    meat_box_id
                )
                if consumed_vodka then
                    cooking_tier = 3
                end
            end

            if cooking_tier < 3 and max_tier >= 2 then
                consumed_water = sb.find_and_consume_item(hub_id, camp, is_clean_water, meat_box_id)
                if consumed_water then
                    cooking_tier = 2
                end
            end
        else
            cooking_method = game.translate_string("st_cooking_at_campfire")
            cooking_tier = 1
        end
    end

    local consumed_meat = sb.find_and_consume_item(hub_id, camp, is_raw_meat, fridge_id)
    if not consumed_meat then
        return false
    end

    local cooked = sb.get_cooked_version(consumed_meat, cooking_tier)
    if not cooked then
        cooked = "tushonka"
    end

    local dest_box_id = (sb.get_auto_sort_target_box and sb.get_auto_sort_target_box(camp, hub_id, cooked)) or fridge_id or box_id
    if not dest_box_id then return false end

    local base_mult = math.max(1, math.floor(sb.cfg.craft_output_multiplier or 1))
    local spec_mult = (sb.get_specialization_mult and camp and sb.get_specialization_mult(camp, "food")) or 1.0
    local total_food = base_mult * spec_mult
    local mult = math.max(1, math.floor(total_food) + (math.random() < (total_food - math.floor(total_food)) and 1 or 0))
    if sb.deposit_item_to_camp and camp and hub_id then
        for i = 1, mult do
            sb.deposit_item_to_camp(hub_id, camp, cooked)
        end
    else
        local dest_se = alife_object(dest_box_id)
        local pos = dest_se and dest_se.position or vector()
        local lvid = dest_se and dest_se.m_level_vertex_id or 0
        local gvi = dest_se and dest_se.m_game_vertex_id or 0
        for i = 1, mult do
            sim:create(cooked, pos, lvid, gvi, dest_box_id)
        end
    end

    if fridge_id and fridge_lvid then
        survivor.temp_target_lvid = fridge_lvid
        survivor.temp_target_time = time_global() + 15000
    end

    local npc = level.object_by_id(npc_id)
    local npc_name = npc and npc:character_name() or (survivor.name or "Survivor")
    local meat_name = game.translate_string("st_" .. consumed_meat)
    if meat_name == "st_" .. consumed_meat then
        meat_name = consumed_meat
    end
    local meal_name = game.translate_string("st_" .. cooked)
    if meal_name == "st_" .. cooked then
        meal_name = cooked
    end

    local tip_msg = string.format(game.translate_string("st_job_cook_success_fridge"), npc_name, meat_name, cooking_method, cooking_tier, meal_name)
    if not fridge_id then
        tip_msg = string.format(game.translate_string("st_job_cook_success_campfire"), npc_name, meal_name, cooking_method, cooking_tier)
    end
    sb.camp_send_tip(actor, tip_msg, nil, "general_stalker", 10000)
    return true
end

-- process_medic_job -- produce medical supplies from the medstation
function stalker_camp_builder.process_medic_job(npc_id, box_id, camp, survivor)
    local actor = db.actor
    local sb = stalker_camp_builder
    local hub_id = (camp and camp.hub_id) or box_id
    local npc = level.object_by_id(npc_id)
    local npc_name = npc and npc:character_name() or (survivor and survivor.name or "Survivor")
    local sec_name_fn = (ui_item and ui_item.get_sec_name) or function(s) return s end

    local m_order = survivor and survivor.medic_order or "auto"

    if sb.is_camp_supply_capped and sb.is_camp_supply_capped(hub_id, camp, "meds", survivor) then
        sb.camp_send_tip(actor, string.format(game.translate_string("st_job_meds_stocked"), npc_name), nil, "general_stalker", 10000)
        if survivor then survivor.shortfall_reason = "Stockpile Full" end
        return false
    end

    local function is_medic_ethanol(sec)
        if not sec then return false end
        local s = sec:lower()
        return s == "vodka" or s == "vodka2" or s == "vodka_quality" or s == "vodka_putinka"
            or s:find("vodka") ~= nil or s:find("antiseptic") ~= nil or s == "alcohol" or s:find("spirit") ~= nil
    end

    local total_ethanol = 0
    if sb.camp_iterate_inventory then
        sb.camp_iterate_inventory(hub_id, camp, function(item_id, sec, cond, uses, se_obj, cid, cl_item)
            if is_medic_ethanol(sec) then
                local u = uses or 1
                if u < 1 then u = 1 end
                total_ethanol = total_ethanol + u
            end
        end)
    end

    local target_sec = nil
    local req_vodka = 0
    local use_cloth = false
    local req_bandage = false

    if m_order == "akvatab" then
        target_sec = (ini_sys and ini_sys:section_exist("akvatab") and "akvatab")
                  or (ini_sys and ini_sys:section_exist("drug_booster") and "drug_booster")
                  or "akvatab"
        req_vodka = 5
        if total_ethanol < req_vodka then
            if survivor then survivor.shortfall_reason = "Need 5x Vodka" end
            sb.camp_send_tip(actor, string.format(game.translate_string("st_job_meds_need_materials"), npc_name), nil, "general_stalker", 10000)
            return false
        end

    elseif m_order == "kalium" then
        target_sec = (ini_sys and ini_sys:section_exist("antirad_kalium") and "antirad_kalium")
                  or (ini_sys and ini_sys:section_exist("antirad") and "antirad")
                  or "antirad_kalium"
        req_vodka = 3
        if total_ethanol < req_vodka then
            if survivor then survivor.shortfall_reason = "Need 3x Vodka" end
            sb.camp_send_tip(actor, string.format(game.translate_string("st_job_meds_need_materials"), npc_name), nil, "general_stalker", 10000)
            return false
        end

    elseif m_order == "medkit" then
        target_sec = "medkit" -- DANZY: was medkit_ai2 (Army Medical Package, too OP for 2 vodka)
        req_vodka = 4  -- DANZY EDIT (balance): was 2, now also needs a bandage
        req_bandage = true
        local has_band = sb.camp_has_item and sb.camp_has_item(hub_id, camp, function(s) return s == "bandage" end)
        if total_ethanol < req_vodka or not has_band then
            if survivor then survivor.shortfall_reason = "Need 4x Vodka + Bandage" end
            sb.camp_send_tip(actor, string.format(game.translate_string("st_job_meds_need_materials"), npc_name), nil, "general_stalker", 10000)
            return false
        end

    elseif m_order == "bandage" then
        target_sec = "bandage"
        local has_cloth = sb.camp_has_item and sb.camp_has_item(hub_id, camp, is_cloth)
        if has_cloth then
            use_cloth = true
            req_vodka = 0
        elseif total_ethanol >= 1 then
            use_cloth = false
            req_vodka = 1
        else
            if survivor then survivor.shortfall_reason = "No Materials" end
            sb.camp_send_tip(actor, string.format(game.translate_string("st_job_meds_need_materials"), npc_name), nil, "general_stalker", 10000)
            return false
        end

    else -- "auto" (Auto-Balanced)
        local stock_bandage = (sb.camp_count_item and sb.camp_count_item(hub_id, camp, function(s) return s:find("bandage") ~= nil end, 20)) or 0
        local stock_medkit  = (sb.camp_count_item and sb.camp_count_item(hub_id, camp, function(s) return s:find("medkit") ~= nil end, 20)) or 0
        local stock_kalium  = (sb.camp_count_item and sb.camp_count_item(hub_id, camp, function(s) return s:find("kalium") ~= nil or s == "antirad" end, 20)) or 0
        local stock_akvatab = (sb.camp_count_item and sb.camp_count_item(hub_id, camp, function(s) return s == "akvatab" or s == "drug_booster" or s:find("ibuprofen") ~= nil end, 20)) or 0

        local candidates = {}
        local cap_enabled = (sb.cfg and sb.cfg.enable_surplus_cap ~= false)
        if total_ethanol >= 5 and (not cap_enabled or stock_akvatab < 8) then
            local sec_akv = (ini_sys and ini_sys:section_exist("akvatab") and "akvatab") or "drug_booster"
            candidates[#candidates+1] = { sec = sec_akv, count = stock_akvatab, req_vodka = 5, use_cloth = false }
        end
        if total_ethanol >= 3 and (not cap_enabled or stock_kalium < 8) then
            local sec_kal = (ini_sys and ini_sys:section_exist("antirad_kalium") and "antirad_kalium") or "antirad"
            candidates[#candidates+1] = { sec = sec_kal, count = stock_kalium, req_vodka = 3, use_cloth = false }
        end
        if total_ethanol >= 4 and (not cap_enabled or stock_medkit < 8) and sb.camp_has_item and sb.camp_has_item(hub_id, camp, function(s) return s == "bandage" end) then
            local sec_med = "medkit" -- DANZY: was medkit_ai2 (Army Medical Package)
            candidates[#candidates+1] = { sec = sec_med, count = stock_medkit, req_vodka = 4, use_cloth = false, req_bandage = true }
        end
        local has_cloth = sb.camp_has_item and sb.camp_has_item(hub_id, camp, is_cloth)
        if (has_cloth or total_ethanol >= 1) and (not cap_enabled or stock_bandage < 15) then
            candidates[#candidates+1] = { sec = "bandage", count = stock_bandage, req_vodka = (has_cloth and 0 or 1), use_cloth = has_cloth }
        end

        if #candidates > 0 then
            table.sort(candidates, function(a, b) return a.count < b.count end)
            local best = candidates[1]
            target_sec = best.sec
            req_vodka = best.req_vodka
            use_cloth = best.use_cloth
            req_bandage = best.req_bandage
        else
            local healed_any = false
            if camp and camp.survivors then
                for sid, surv in pairs(camp.survivors) do
                    local s_obj = level.object_by_id(sid)
                    if s_obj and s_obj.health and s_obj.health < 0.95 then
                        s_obj.health = 1.0
                        healed_any = true
                    end
                end
            end
            if healed_any then
                sb.camp_send_tip(actor, string.format(game.translate_string("st_job_medic_treated_wounded"), npc_name), nil, "general_stalker", 10000)
                if survivor then survivor.shortfall_reason = nil end
                return true
            else
                local is_stocked = (sb.is_camp_supply_capped and sb.is_camp_supply_capped(hub_id, camp, "meds", survivor))
                                   or (stock_akvatab >= 8 and stock_kalium >= 8 and stock_bandage >= 8)
                if is_stocked then
                    if survivor then survivor.shortfall_reason = "Stockpile Full" end
                    sb.camp_send_tip(actor, string.format(game.translate_string("st_job_meds_stocked"), npc_name), nil, "general_stalker", 10000)
                else
                    if survivor then survivor.shortfall_reason = "No Materials" end
                    sb.camp_send_tip(actor, string.format(game.translate_string("st_job_meds_need_materials"), npc_name), nil, "general_stalker", 10000)
                end
                return false
            end
        end
    end

    if not target_sec then return false end

    local consumed_desc = ""
    if req_bandage then
        local b_sec = sb.camp_consume_item and sb.camp_consume_item(hub_id, camp, function(s) return s == "bandage" end)
        if not b_sec then return false end
    end
    if use_cloth then
        local c_sec = sb.camp_consume_item and sb.camp_consume_item(hub_id, camp, is_cloth)
        if c_sec then
            consumed_desc = sec_name_fn(c_sec)
        elseif req_vodka > 0 then
            local v_sec = sb.camp_consume_item and sb.camp_consume_item(hub_id, camp, is_medic_ethanol)
            consumed_desc = v_sec and sec_name_fn(v_sec) or "Vodka"
        end
    else
        local last_v_sec = nil
        for i = 1, req_vodka do
            local v_sec = sb.camp_consume_item and sb.camp_consume_item(hub_id, camp, is_medic_ethanol)
            if v_sec then last_v_sec = v_sec end
        end
        consumed_desc = string.format("%dx %s", req_vodka, last_v_sec and sec_name_fn(last_v_sec) or "Vodka")
    end

    local mult = math.max(1, math.floor(sb.cfg.craft_output_multiplier or 1))
    -- DANZY: Drug-Making Kit bonus (was advertised but never implemented)
    if (camp and camp.has_drugkit) or (survivor and survivor.has_drugkit) then
        mult = mult * 2
    end
    local spec_mult = (sb.get_specialization_mult and camp and sb.get_specialization_mult(camp, "medic")) or 1.0
    local total_med = mult * spec_mult
    mult = math.max(1, math.floor(total_med) + (math.random() < (total_med - math.floor(total_med)) and 1 or 0))
    if sb.deposit_item_to_camp and camp and hub_id then
        for i = 1, mult do
            sb.deposit_item_to_camp(hub_id, camp, target_sec)
        end
    else
        local target_box_id = (sb.get_auto_sort_target_box and camp and sb.get_auto_sort_target_box(camp, hub_id, target_sec)) or box_id
        local box_se = alife_object(target_box_id)
        local pos = box_se and box_se.position or vector()
        local lvid = box_se and box_se.m_level_vertex_id or 0
        local gvi = box_se and box_se.m_game_vertex_id or 0
        for i = 1, mult do
            alife():create(target_sec, pos, lvid, gvi, target_box_id)
        end
    end

    if survivor then survivor.shortfall_reason = nil end
    local item_disp = sec_name_fn(target_sec)
    if mult > 1 then item_disp = string.format("%dx %s", mult, item_disp) end
    sb.camp_send_tip(actor, string.format(game.translate_string("st_job_meds_synthesized_from"), npc_name, item_disp, consumed_desc), nil, "general_stalker", 10000)
    return true
end

-- Electrician job: recharge lamp conditions using batteries/mechanical waste
function stalker_camp_builder.process_electrician_job(npc_id, hub_id, camp, survivor)
    local actor = db.actor
    local sformat = string.format
    local sb = stalker_camp_builder
    if not camp or not camp.structures then return end

    local lights = {}
    for struct_id, stype in pairs(camp.structures) do
        if stype == "light" then
            lights[#lights+1] = struct_id
        end
    end

    if #lights == 0 then
        local npc = level.object_by_id(npc_id)
        if npc then
            sb.camp_send_tip(db.actor, string.format(game.translate_string("st_job_electrician_no_lamps"), npc and npc:character_name() or "Survivor"), nil, "general_stalker", 8000)
        end
        return
    end

    local npc = level.object_by_id(npc_id)
    local name = npc and npc:character_name() or "Survivor"

    -- a lamp burns fuel only while it is online and switched on (its binder's update), so a
    -- battery goes only to lamps under half their fuel
    local low = {}
    if hf_obj_manager and hf_obj_manager.get_data and hf_obj_manager.update_data then
        for _, light_id in ipairs(lights) do
            local data = hf_obj_manager.get_data(light_id)
            if data and (tonumber(data.condition) or 1) < 0.5 then
                low[#low+1] = light_id
            end
        end
    end
    if #low == 0 then
        sb.camp_send_tip(actor, string.format(game.translate_string("st_job_electrician_all_powered"), name), nil, "general_stalker", 8000)
        return
    end

    local consumed = sb.find_and_consume_item(hub_id, camp, is_lamp_battery, nil)

    -- Fix: the recharge loop used to run UNCONDITIONALLY regardless of
    if not consumed then
        sb.camp_send_tip(actor, string.format(game.translate_string("st_job_electrician_no_battery"), name), nil, "general_stalker", 8000)
        return
    end

    local recharged = 0
    for _, light_id in ipairs(low) do
        if hf_obj_manager and hf_obj_manager.get_data and hf_obj_manager.update_data then
            local data = hf_obj_manager.get_data(light_id)
            if data then
                data.condition = 1.0
                hf_obj_manager.update_data(light_id, data)
                -- an online lamp's binder keeps its fuel and writes it back over the data on
                -- every update, so refuel the binder too
                local obj = level.object_by_id(light_id)
                local binder = obj and obj:binded_object()
                local wrapper = binder and binder.wrapper
                if wrapper and wrapper.fuel then
                    wrapper.fuel = 1.0
                end
                recharged = recharged + 1
            end
        end
    end

    if recharged > 0 then
        sb.camp_send_tip(actor, string.format(game.translate_string("st_job_electrician_recharged"), name, recharged), nil, "general_stalker", 10000)
    else
        sb.camp_send_tip(actor, string.format(game.translate_string("st_job_electrician_all_powered"), name), nil, "general_stalker", 8000)
    end
end

-- Woodcutter job: harvest timber (prt_i_wood) or burn charcoal (charcoal)
function stalker_camp_builder.process_woodcutter_job(npc_id, hub_id, camp, survivor, camp_box_id)
    local mrandom = math.random
    local sb = stalker_camp_builder
    local actor = db.actor
    local sformat = string.format
    local npc = level.object_by_id(npc_id)
    local name = (npc and npc:character_name()) or (survivor and survivor.name) or "Woodcutter"
    local mode = (survivor and survivor.woodcutter_mode) or "auto"

    local do_charcoal = false
    if mode == "charcoal" then
        do_charcoal = true
    elseif mode == "auto" then
        survivor._woodcutter_alt = survivor._woodcutter_alt ~= true
        do_charcoal = survivor._woodcutter_alt
    end

    -- If on Auto directive and the settlement has an active brewer, ensure the brewery's
    -- required 10-wood threshold before burning charcoal; harvest timber instead if wood < 10
    if mode == "auto" and do_charcoal then
        local has_camp_brewer = false
        if camp and camp.survivors then
            for _, s in pairs(camp.survivors) do
                if s and s.job == "brewer" and not s.on_expedition then
                    has_camp_brewer = true
                    break
                end
            end
        end
        if has_camp_brewer then
            local wood_avail = 0
            if camp and camp._inv_snapshot then
                wood_avail = camp._inv_snapshot.wood_count or 0
            elseif sb.camp_count_item then
                wood_avail = sb.camp_count_item(hub_id, camp, is_wood_part, 10) or 0
            end
            if wood_avail < 10 then
                do_charcoal = false
            end
        end
    end

    if do_charcoal then
        local consumed_count = 0
        local max_burn = 5 -- Burn a fixed batch of up to 5 wood scraps for 3-5 charcoal instead of wiping all storage
        for i = 1, max_burn do
            local consumed = sb.find_and_consume_item(hub_id, camp, is_wood_part, nil)
            if consumed then
                consumed_count = consumed_count + 1
            else
                break
            end
        end

        if consumed_count >= 1 then
            local count = mrandom(3, 5)
            if survivor and survivor.has_axe then count = count + 2 end
            local mult = math.max(1, math.floor(sb.cfg.craft_output_multiplier or 1))
            local total_charcoal = math.min(count * mult, 20)
            for i = 1, total_charcoal do
                sb.deposit_item_to_camp(hub_id, camp, "charcoal")
            end
            if survivor then survivor.shortfall_reason = nil end
            sb.camp_send_tip(actor, string.format(game.translate_string("st_job_woodcutter_charcoal"), name, consumed_count, total_charcoal), nil, "general_stalker", 10000)
            return true
        else
            if mode == "charcoal" then
                if survivor then survivor.shortfall_reason = "No Wood Scraps" end
                sb.camp_send_tip(actor, sformat(game.translate_string("st_job_woodcutter_need_wood"), name), nil, "general_stalker", 8000)
                return false
            end
        end
    end

    local min_w = sb.cfg.yield_wood_min or (sb.defaults and sb.defaults.yield_wood_min) or 4
    local max_w = sb.cfg.yield_wood_max or (sb.defaults and sb.defaults.yield_wood_max) or 8
    if min_w > max_w then min_w, max_w = max_w, min_w end
    min_w = math.max(1, min_w)
    max_w = math.max(min_w, max_w)
    local count = mrandom(min_w, max_w)
    if survivor and survivor.has_axe then
        local axe_min = math.floor(min_w * 2)
        local axe_max = math.max(axe_min, math.floor(max_w * 1.5 + 0.5))
        count = mrandom(axe_min, axe_max)
    end
    local mult = math.max(1, math.floor(sb.cfg.craft_output_multiplier or 1))
    local total_wood = math.min(count * mult, 30)
    for i = 1, total_wood do
        sb.deposit_item_to_camp(hub_id, camp, "prt_i_wood")
    end
    if survivor then survivor.shortfall_reason = nil end
    sb.camp_send_tip(actor, string.format(game.translate_string("st_job_woodcutter_harvested"), name, total_wood), nil, "general_stalker", 10000)
    return true
end

-- Brewer job: distill clean water + wood into Nemiroff Vodka
function stalker_camp_builder.process_brewer_job(npc_id, hub_id, camp, survivor, camp_box_id)
    local sb = stalker_camp_builder
    local actor = db.actor
    local sformat = string.format
    local npc = level.object_by_id(npc_id)
    local name = (npc and npc:character_name()) or (survivor and survivor.name) or "Brewer"

    local has_still = false
    for struct_id, struct_type in pairs_(camp.structures or {}) do
        if struct_type == "stove" or struct_type == "bidon" or struct_type == "water_pump" or struct_type == "workbench" then
            has_still = true
            break
        end
    end
    if not has_still then
        if survivor then survivor.shortfall_reason = "No Still" end
        local tmpl = game.translate_string("st_job_brewer_need_still")
        if tmpl == "st_job_brewer_need_still" then tmpl = "%s needs a Milk Can (Bidon) or Stove to distill vodka!" end
        sb.camp_send_tip(actor, sformat(tmpl, name), nil, "general_stalker", 8000)
        return false
    end

    -- a batch burns 10 wood parts: count them before the water is taken
    local wood = (sb.camp_count_item and sb.camp_count_item(hub_id, camp, is_wood_part, 10)) or 0
    if wood < 10 then
        if survivor then survivor.shortfall_reason = "Need Wood" end
        return false
    end

    local consumed_water = sb.find_and_consume_item(hub_id, camp, is_clean_water, nil)

    if not consumed_water then
        if survivor then survivor.shortfall_reason = "No Clean Water" end
        sb.camp_send_tip(actor, sformat(game.translate_string("st_job_brewer_need_water"), name), nil, "general_stalker", 8000)
        return false
    end

    for i = 1, 10 do
        sb.find_and_consume_item(hub_id, camp, is_wood_part, nil)
    end

    local count = 2  -- DANZY EDIT (balance): was 5 (10 with drug kit)
    if (survivor and survivor.has_drugkit) or (camp and camp.has_drugkit) then
        count = 4
    end
    local mult = math.max(1, math.floor(sb.cfg.craft_output_multiplier or 1))
    local total_vodka = math.min(count * mult, 12)
    for i = 1, total_vodka do
        sb.deposit_item_to_camp(hub_id, camp, "vodka")
    end
    if survivor then survivor.shortfall_reason = nil end
    sb.camp_send_tip(actor, string.format(game.translate_string("st_job_brewer_distilled"), name, total_vodka), nil, "general_stalker", 10000)
    return true
end

-- Scrapper job: salvage metal scrap and hardware from Zone ruins
function stalker_camp_builder.process_scrapper_job(npc_id, hub_id, camp, survivor, camp_box_id)
    local mrandom = math.random
    local sb = stalker_camp_builder
    local actor = db.actor
    local sformat = string.format
    local npc = level.object_by_id(npc_id)
    local name = (npc and npc:character_name()) or (survivor and survivor.name) or "Scrapper"

    local min_s = sb.cfg.yield_scrap_min or (sb.defaults and sb.defaults.yield_scrap_min) or 3
    local max_s = sb.cfg.yield_scrap_max or (sb.defaults and sb.defaults.yield_scrap_max) or 6
    if min_s > max_s then min_s, max_s = max_s, min_s end
    min_s = math.max(1, min_s)
    max_s = math.max(min_s, max_s)

    local min_f = sb.cfg.yield_fasteners_min or (sb.defaults and sb.defaults.yield_fasteners_min) or 1
    local max_f = sb.cfg.yield_fasteners_max or (sb.defaults and sb.defaults.yield_fasteners_max) or 3
    if min_f > max_f then min_f, max_f = max_f, min_f end
    min_f = math.max(1, min_f)
    max_f = math.max(min_f, max_f)

    local scrap_count = mrandom(min_s, max_s)
    local fastener_count = mrandom(min_f, max_f)
    if survivor and survivor.has_tools then
        local tool_s_min = math.floor(min_s * 2)
        local tool_s_max = math.max(tool_s_min, math.floor(max_s * 5 / 3 + 0.5))
        local tool_f_min = math.floor(min_f * 2)
        local tool_f_max = math.max(tool_f_min, math.floor(max_f * 5 / 3 + 0.5))
        scrap_count = mrandom(tool_s_min, tool_s_max)
        fastener_count = mrandom(tool_f_min, tool_f_max)
    end
    local mult = math.max(1, math.floor(sb.cfg.craft_output_multiplier or 1))
    local total_scrap = math.min(scrap_count * mult, 30)
    local total_fasteners = math.min(fastener_count * mult, 20)
    for i = 1, total_scrap do
        sb.deposit_item_to_camp(hub_id, camp, "prt_i_scrap")
    end
    for i = 1, total_fasteners do
        sb.deposit_item_to_camp(hub_id, camp, "prt_i_fasteners")
    end
    sb.camp_send_tip(actor, string.format(game.translate_string("st_job_scrapper_salvaged"), name, total_scrap, total_fasteners), nil, "general_stalker", 10000)
    return true
end

-- Camp follower eating: settlers consume 1 food item per game-day each
local FOOD_SECTIONS = {
    ["tushonka"] = true, ["conserva"] = true, ["kolbasa"] = true, ["bread"] = true,
    ["breadold"] = true, ["chocolate"] = true, ["chocolate_p"] = true, ["mre"] = true,
    ["protein"] = true, ["tomato"] = true, ["sausage"] = true, ["corn"] = true,
    ["beans"] = true, ["chili"] = true, ["salmon"] = true, ["raisins"] = true,
    ["nuts"] = true, ["mint"] = true, ["ration_ru"] = true, ["ration_ukr"] = true,

    ["vodka"] = true, ["vodka2"] = true, ["vodka_quality"] = true, ["beer"] = true,
    ["energy_drink"] = true, ["water_drink"] = true, ["mineral_water"] = true,
    ["bottle_metal"] = true, ["tea"] = true, ["flask"] = true, ["drink_crow"] = true,
}

local function is_food_section(sec)
    if not sec then return false end
    if FOOD_SECTIONS[sec] then
        return true
    end
    if string.sub(sec, 1, 5) == "meat_" then
        return true
    end
    return false
end

function stalker_camp_builder.process_settler_eating(hub_id, camp)
    local sb = stalker_camp_builder
    if not camp or not camp.survivors then return end

    local current_sec = sb.game_sec()
    camp.last_food_consumption_time = camp.last_food_consumption_time or current_sec
    local elapsed = current_sec - camp.last_food_consumption_time
    if elapsed < (sb.cfg.food_consumption_interval or 86400) then return end
    camp.last_food_consumption_time = current_sec

    local fed = 0
    local hungry = 0
    for npc_id, survivor in pairs(camp.survivors) do
        local consumed = sb.find_and_consume_item(hub_id, camp, is_food_section, nil)
        if consumed then
            fed = fed + 1
        else
            hungry = hungry + 1
        end
    end

    -- DANZY EDIT: going hungry now hurts morale until the next meal round.
    if hungry > 0 then
        camp.hungry_until = current_sec + (sb.cfg.food_consumption_interval or 86400)
        camp.hungry_count = hungry
        if db.actor then
            sb.camp_send_tip(db.actor, string.format("%s: %d settler(s) went hungry - no food in storage. Morale is dropping.",
                camp.name or "Settlement", hungry), nil, "general_stalker", 9000, hub_id, "work", true)
        end
    else
        camp.hungry_until = nil
        camp.hungry_count = nil
    end
end

-- Turret maintenance: get count + feed ammo
function stalker_camp_builder.get_turret_ammo_count(turret_id)
    local obj = level.object_by_id(turret_id)
    local binder = obj and obj:binded_object()
    local wrapper = binder and binder.wrapper
    if wrapper and type(wrapper.get_mag_count) == "function" then
        return wrapper:get_mag_count() or 0
    else
        local d = hf_obj_manager.get_data(turret_id) or {}
        local mag = d.mag or {}
        return #mag
    end
end

function stalker_camp_builder.feed_turret(turret_id, ammo_sec, count)
    local obj = level.object_by_id(turret_id)
    local binder = obj and obj:binded_object()
    local wrapper = binder and binder.wrapper
    if wrapper and type(wrapper.mag_push) == "function" then
        wrapper:mag_push(ammo_sec, count)
        if wrapper.get_channel and _G.hf_turret_channels then
            pcall(function()
                local ch = tonumber(wrapper:get_channel()) or 0
                local entry = ch > 0 and _G.hf_turret_channels[ch] or nil
                if entry and entry.turret_id == turret_id and type(wrapper.get_mag_count) == "function" then
                    entry.ammo = wrapper:get_mag_count() or entry.ammo
                end
            end)
        end
    else
        local d = hf_obj_manager.get_data(turret_id) or {}
        local mag = d.mag or {}
        local cap = 40
        local added = 0
        while added < count and #mag < cap do
            mag[#mag+1] = ammo_sec
            added = added + 1
        end
        hf_obj_manager.update_data(turret_id, { mag = mag })
    end
end

function stalker_camp_builder.process_turret_maintenance(npc_id, box_id, camp, fallback_box_id)
    local ipairs_ = ipairs
    local sb = stalker_camp_builder
    local turrets = {}
    for id, struct_type in pairs(camp.structures or {}) do
        local se_obj = alife_object(id)
        local sec = se_obj and se_obj:section_name()
        if sec and sec:find("turret") and not sec:find("table") then
            turrets[#turrets+1] = id
        end
    end

    if #turrets == 0 then return end

    local deficits = {}
    local total_deficit = 0
    for _, turret_id in ipairs_(turrets) do
        local current_ammo = sb.get_turret_ammo_count(turret_id)
        local bullets_needed = 40 - current_ammo
        if bullets_needed > 0 then
            deficits[#deficits + 1] = { turret_id = turret_id, need = bullets_needed }
            total_deficit = total_deficit + bullets_needed
        end
    end
    if total_deficit <= 0 then return end

    local hub_id = (camp and camp.hub_id) or fallback_box_id or box_id
    local snap = camp and camp._inv_snapshot
    if not snap and sb.get_camp_inventory_snapshot then
        snap = sb.get_camp_inventory_snapshot(hub_id, camp, false)
    end
    if snap and (snap.turret_9mm_rounds or 0) <= 0 then return end

    local container_ids = {}
    local seen_boxes = {}
    local function is_valid_box(bid)
        if not bid then return false end
        if sb.is_valid_camp_box then
            return sb.is_valid_camp_box(bid, hub_id, camp)
        end
        return sb.is_actual_container and sb.is_actual_container(bid)
    end
    local function add_box(bid)
        if bid and is_valid_box(bid) and not seen_boxes[bid] then
            seen_boxes[bid] = true
            container_ids[#container_ids + 1] = bid
        end
    end
    add_box(box_id)
    add_box(fallback_box_id)
    local all_c = (sb.get_camp_containers and sb.get_camp_containers(hub_id, camp)) or {}
    for _, bid in ipairs_(all_c) do
        add_box(bid)
    end

    if #container_ids == 0 then return end
    -- rounds come only from a pack's game object (below): with none of the camp's boxes online
    -- there is nothing to take, so don't walk its storage once per turret
    local box_online = false
    for _, bid in ipairs_(container_ids) do
        if level.object_by_id(bid) then
            box_online = true
            break
        end
    end
    if not box_online then return end

    local refilled_any = false
    local spent_ammo_boxes = {}
    local cur_idx = 1

    sb.camp_iterate_inventory(hub_id, camp, function(item_id, sec, cond, uses, se_obj, cid, cl_item)
        if cur_idx > #deficits then return true end
        if spent_ammo_boxes[item_id] then return end
        -- a pack without a game object is a cse_alife_item_ammo, which exports no round
        -- count: its rounds can be neither read nor taken
        if not cl_item then return end
        if sec and (sec:find("^ammo_9x19") or sec:find("^ammo_9x18")) then
            local box_bullets = 0
            pcall(function() box_bullets = cl_item:ammo_get_count() end)
            if box_bullets > 0 then
                while box_bullets > 0 and cur_idx <= #deficits do
                    local entry = deficits[cur_idx]
                    local take = math.min(entry.need, box_bullets)
                    entry.need = entry.need - take
                    box_bullets = box_bullets - take
                    sb.feed_turret(entry.turret_id, sec, take)
                    refilled_any = true
                    if entry.need <= 0 then
                        cur_idx = cur_idx + 1
                    end
                end
                pcall(function() cl_item:ammo_set_count(box_bullets) end)
                if box_bullets <= 0 then
                    spent_ammo_boxes[item_id] = true
                end
            end
        end
        if cur_idx > #deficits then return true end
    end)

    for id in pairs(spent_ammo_boxes) do
        local se_item = alife_object(id)
        if se_item then
            alife_release(se_item)
        end
    end

    if refilled_any then
        if sb.invalidate_camp_inventory_cache then
            sb.invalidate_camp_inventory_cache(hub_id, camp)
        end
        local npc = npc_id and level.object_by_id(npc_id)
        local npc_name = npc and npc:character_name() or (npc_id and "Survivor" or (camp.name or "Settlement Defense"))
        sb.camp_send_tip(db.actor, string.format(game.translate_string("st_job_turret_refilled"), npc_name), nil, "general_stalker", 10000)
    end
end

-- hub_id -> true while this session's restock event waits for the camp's caravan trader. Not
-- saved, like the time event it stands for.
local trader_stock_pending = {}

-- Is the camp's trader id still the live stalker spawned as its caravan trader? A dead
-- trader's id goes back into use once the body is released.
local function is_camp_trader(camp)
    local se = alife_object(camp.active_trader_id)
    if not (se and IsStalker(se) and se:alive()) then return false end
    if camp.trader_section_of ~= camp.active_trader_id then  -- a newly arrived trader
        camp.trader_section_of = camp.active_trader_id
        camp.trader_section = se:section_name()
    end
    return se:section_name() == camp.trader_section
end

-- update_camp_jobs -- master per-tick job driver. Runs every 10 real seconds
local MAX_GLOBAL_CYCLES_PER_TICK = 6
local last_round_robin_camp_idx = 1

function stalker_camp_builder.update_camp_jobs()
    local mmin = math.min
    local mmax = math.max
    local pairs_ = pairs
    local sformat = string.format
    local tostr = tostring
    local actor = db.actor
    local sb = stalker_camp_builder
    local current_sec = sb.game_sec()

    local camp_keys = {}
    for hid in pairs_(sb.active_camps or {}) do
        camp_keys[#camp_keys + 1] = hid
    end
    local num_camps = #camp_keys
    if num_camps == 0 then return end
    table.sort(camp_keys)

    if last_round_robin_camp_idx > num_camps then
        last_round_robin_camp_idx = 1
    end

    local global_cycles_budget = MAX_GLOBAL_CYCLES_PER_TICK
    local total_cycles_run_this_tick = 0

    for camp_loop_i = 1, num_camps do
        local c_idx = ((last_round_robin_camp_idx - 1 + (camp_loop_i - 1)) % num_camps) + 1
        local hub_id = camp_keys[c_idx]
        local camp = sb.active_camps[hub_id]
        if camp then
            local hub_obj = alife_object(hub_id)
            if not hub_obj then
            if camp and camp.survivors then
                for _, surv in pairs_(camp.survivors) do
                    surv.shortfall_reason = nil
                end
            end
        else
            local stats = sb.get_camp_stats and sb.get_camp_stats(camp, hub_obj)
            if stats then
                -- get_camp_stats has just set camp.happiness, which the marker's morale warning reads
                pcall(sb.refresh_settlement_map_spot, hub_id, camp)
            end

            if camp.active_trader_id and not is_camp_trader(camp) then
                camp.active_trader_id = nil
                camp.trader_spawn_time = nil
                camp.trader_needs_stock = nil
                camp.trader_section = nil
                camp.trader_section_of = nil
            end
            if camp.active_trader_id then
                camp.trader_spawn_time = camp.trader_spawn_time or current_sec

                if camp.trader_needs_stock and not trader_stock_pending[hub_id] then
                    trader_stock_pending[hub_id] = true
                    camp.trader_stock_pending = nil  -- saved by older versions
                    local trader_id = camp.active_trader_id
                    local hub_id_ref = hub_id

                    local dominant_faction = camp.trader_community or (sb.get_camp_dominant_faction and sb.get_camp_dominant_faction(camp))
                    if not dominant_faction and camp and camp.faction then
                        dominant_faction = camp.faction
                    end
                    if not dominant_faction and actor and actor.character_community then
                        local raw_comm = actor:character_community() or ""
                        dominant_faction = raw_comm:gsub("^actor_", "")
                    end
                    dominant_faction = dominant_faction or "stalker"

                    CreateTimeEvent("homestead_trader_stock", "trader_stock_" .. tostr(trader_id), 0.5, function()
                        local trader_cl = sb.safe_level_object(trader_id)
                        local trader_ready = false
                        if trader_cl and trader_cl.alive then
                            trader_ready = trader_cl:alive()
                        end
                        if trader_ready then
                            pcall(function()
                                if trader_cl.set_character_community then
                                    trader_cl:set_character_community(dominant_faction, 0, 0)
                                end
                                if trader_cl.set_relation and db.actor then
                                    trader_cl:set_relation(game_object.friend, db.actor)
                                end
                            end)

                            local trader_loot = (sb.defaults and sb.defaults.trader_loot_table) or {}
                            for i = 1, #trader_loot do
                                local ok = pcall(function()
                                    alife():create(trader_loot[i], trader_cl:position(), trader_cl:level_vertex_id(), trader_cl:game_vertex_id(), trader_id)
                                end)
                            end
                            local c = sb.active_camps[hub_id_ref]
                            if c then
                                c.trader_needs_stock = nil
                            end
                            trader_stock_pending[hub_id_ref] = nil
                            return true  -- one-shot: event complete
                        end
                        local c = sb.active_camps[hub_id_ref]
                        if not c or not c.trader_needs_stock then
                            trader_stock_pending[hub_id_ref] = nil
                            return true  -- camp removed or stock already handled, stop
                        end
                        return false  -- keep retrying
                    end)
                end

                local trader_elapsed = current_sec - camp.trader_spawn_time
                local se_trader = alife_object(camp.active_trader_id)
                -- the caravan leaves where the player can't see it go; until then it stays, and a later
                -- update tries again
                if trader_elapsed >= sb.cfg.trader_despawn_time
                    and not (se_trader and sb.in_player_range and sb.in_player_range(se_trader)) then
                    if se_trader then
                        -- the trader is in no squad, and alife_release removes stalkers only through their squad
                        safe_release_manager.release(se_trader)
                        sb.camp_send_tip(actor, game.translate_string("st_job_caravan_departed"), nil, "general_stalker", 10000)
                    end
                    camp.active_trader_id = nil
                    camp.trader_spawn_time = nil
                    camp.trader_needs_stock = nil
                    camp.trader_section = nil
                    camp.trader_section_of = nil
                end
            end

            local camp_box_id = nil
            local cached_box = sb.camp_box_id_cache[hub_id]
            local now_tg_box = time_global()
            local function is_valid_box(bid)
                if not bid then return false end
                if sb.is_valid_camp_box then
                    return sb.is_valid_camp_box(bid, hub_id, camp)
                end
                return sb.is_actual_container and sb.is_actual_container(bid)
            end

            if cached_box and now_tg_box < cached_box.expires_tg and is_valid_box(cached_box.box_id) then
                camp_box_id = cached_box.box_id
            else
                sb.camp_box_id_cache[hub_id] = nil

                if camp.primary_chest_id and is_valid_box(camp.primary_chest_id) then
                    camp_box_id = camp.primary_chest_id
                else
                    camp.primary_chest_id = nil
                end

                if not camp_box_id then
                    local min_dist = 99999
                    for struct_id, struct_type in pairs_(camp.structures or {}) do
                        if (struct_type == "stash" or struct_type == "fridge") and is_valid_box(struct_id) then
                            local struct_obj = alife_object(struct_id)
                            if struct_obj and struct_obj.position and hub_obj.position then
                                local dist = struct_obj.position:distance_to(hub_obj.position)
                                if dist < min_dist then
                                    min_dist = dist
                                    camp_box_id = struct_id
                                end
                            end
                        end
                    end
                end

                if not camp_box_id and sb.get_auto_sort_target_box then
                    camp_box_id = sb.get_auto_sort_target_box(camp, hub_id, "stash")
                end

                local used_hub_fallback = false
                if not camp_box_id then
                    camp_box_id = hub_id
                    used_hub_fallback = true
                end

                if not used_hub_fallback and camp_box_id then
                    sb.camp_box_id_cache[hub_id] = {
                        box_id = camp_box_id,
                        expires_tg = now_tg_box + sb.CAMP_BOX_ID_CACHE_TTL_MS
                    }
                end
            end

            local camp_snap = sb.get_camp_inventory_snapshot and sb.get_camp_inventory_snapshot(hub_id, camp, false)

            camp.last_water_time = camp.last_water_time or current_sec
            local water_elapsed = current_sec - camp.last_water_time
            if water_elapsed >= sb.cfg.water_interval then
                camp.last_water_time = current_sec
                local pumps_count = 0
                for id, struct_type in pairs_(camp.structures) do
                    if struct_type == "water_pump" then
                        pumps_count = pumps_count + 1
                    end
                end

                if pumps_count > 0 and camp_box_id then
                    local consumed_filter = sb.camp_consume_item(hub_id, camp, function(sec)
                        if not sec then return false end
                        local s = sec:lower()
                        return sb.cfg.water_filters and (sb.cfg.water_filters[sec] or sb.cfg.water_filters[s])
                    end, camp_box_id)

                    if consumed_filter then
                        local spec_mult = (sb.get_specialization_mult and sb.get_specialization_mult(camp, "water")) or 1.0
                        local total_flasks = pumps_count * spec_mult
                        local flasks_to_deposit = math.max(1, math.floor(total_flasks) + (math.random() < (total_flasks - math.floor(total_flasks)) and 1 or 0))

                        if sb.deposit_item_to_camp and camp and hub_id then
                            for i = 1, flasks_to_deposit do
                                sb.deposit_item_to_camp(hub_id, camp, "flask")
                            end
                        else
                            local dest_id = camp_box_id or hub_id
                            local dest_se = alife_object(dest_id)
                            local pos = dest_se and dest_se.position or STATIC_ZERO_VECTOR
                            local lvid = dest_se and dest_se.m_level_vertex_id or 0
                            local gvi = dest_se and dest_se.m_game_vertex_id or 0
                            for i = 1, flasks_to_deposit do
                                alife():create("flask", pos, lvid, gvi, dest_id)
                            end
                        end
                        sb.camp_send_tip(actor, game.translate_string("st_job_water_pumped"), nil, "general_stalker", 10000)
                    else
                        sb.camp_send_tip(actor, game.translate_string("st_job_water_no_filters"), nil, "red_danger", 10000, hub_id, "work", true)
                    end
                end
            end

            camp.last_fridge_time = camp.last_fridge_time or current_sec
            local fridge_elapsed = current_sec - camp.last_fridge_time
            if fridge_elapsed >= sb.cfg.fridge_interval then
                camp.last_fridge_time = current_sec
                local fridge_count = 0
                for id, struct_type in pairs_(camp.structures or {}) do
                    if struct_type == "fridge" then
                        fridge_count = fridge_count + 1
                    end
                end

                if fridge_count > 0 then
                    local preserved_count = 0
                    local restore_amt = sb.cfg.fridge_cond_restore or 0.25
                    sb.camp_iterate_inventory(hub_id, camp, function(item_id, sec, cond, uses, se_item, cid, cl_item)
                        if sec and ((sec:find("mutant_part") and (sec:find("meat") or sec:find("chop") or sec:find("hand"))) or sec == "kolbasa" or sec == "bread") then
                            if cond and cond < 1.0 then
                                local new_cond = mmin(1.0, cond + restore_amt)
                                if cl_item and cl_item.set_condition then
                                    pcall(function() cl_item:set_condition(new_cond) end)
                                end
                                if se_item then
                                    se_item.condition = new_cond
                                end
                                preserved_count = preserved_count + 1
                            end
                        end
                    end)

                    if preserved_count > 0 then
                        sb.camp_send_tip(actor, game.translate_string("st_job_fridge_chilled"), nil, "general_stalker", 10000)
                    end
                end
            end

            for npc_id, survivor in pairs_(camp.survivors) do
                local job = survivor.job or "idle"

                local rt_interval
                if     job == "scavenge" then
                    if survivor.on_expedition then
                        rt_interval = nil
                    else
                        rt_interval = sb.cfg.realtime_job_scavenge_interval or (sb.defaults and sb.defaults.realtime_job_scavenge_interval) or 900
                    end
                elseif job == "hunter"   then rt_interval = sb.cfg.realtime_job_hunter_interval
                elseif job == "craft"    then rt_interval = sb.cfg.realtime_job_craft_interval
                elseif job == "repair"   then rt_interval = sb.cfg.realtime_job_repair_interval
                elseif job == "cook"     then rt_interval = sb.cfg.realtime_job_cook_interval
                elseif job == "medic"    then rt_interval = sb.cfg.medic_job_interval or (sb.defaults and sb.defaults.medic_job_interval) or 1500
                elseif job == "electrician" then rt_interval = sb.cfg.electrician_job_interval or (sb.defaults and sb.defaults.electrician_job_interval) or 900
                elseif job == "woodcutter" then rt_interval = sb.cfg.realtime_job_woodcutter_interval or (sb.defaults and sb.defaults.realtime_job_woodcutter_interval) or 1200
                elseif job == "brewer"   then rt_interval = sb.cfg.realtime_job_brewer_interval or (sb.defaults and sb.defaults.realtime_job_brewer_interval) or 1200
                elseif job == "scrapper" then rt_interval = sb.cfg.realtime_job_scrapper_interval or (sb.defaults and sb.defaults.realtime_job_scrapper_interval) or 1200
                end
                if not rt_interval or rt_interval <= 0 then
                    -- no cycle runs while the settler is away (companion, expedition) or has none:
                    -- the job starts a fresh one when it resumes
                    survivor.job_start_time = nil
                    survivor.job_start_realtime = nil
                else
                    local tg = time_global()
                    local tf = (level and level.get_time_factor and level.get_time_factor()) or 10
                    if tf <= 0 then tf = 10 end

                    local tod_mult = sb.get_time_of_day_mult and sb.get_time_of_day_mult(job) or 1.0
                    local effective_interval = rt_interval / (tod_mult > 0 and tod_mult or 1.0)

                    if (not survivor.job_start_realtime) or (survivor.job_start_realtime > tg) then
                        local game_elapsed = current_sec - (survivor.job_start_time or current_sec)
                        local effective_sec = mmax(0, game_elapsed / tf)
                        survivor.job_start_realtime = tg - (mmin(effective_sec, effective_interval) * 1000)
                        if not survivor.job_start_time then
                            survivor.job_start_time = current_sec
                        end
                    end

                    local rt_elapsed_sec = mmax(0, (tg - survivor.job_start_realtime) / 1000)
                    local game_elapsed_sec = mmax(0, (current_sec - (survivor.job_start_time or current_sec)) / tf)
                    local effective_elapsed = mmax(rt_elapsed_sec, game_elapsed_sec)

                    -- Cap excessive backlog from long sleeps / absences (max 6 cycles backlog)
                    local max_backlog_sec = effective_interval * 6
                    if effective_elapsed > max_backlog_sec then
                        effective_elapsed = max_backlog_sec
                        survivor.job_start_realtime = tg - (max_backlog_sec * 1000)
                        survivor.job_start_time = current_sec - (max_backlog_sec * tf)
                    end

                    local is_paused, reason_short, reason_detail = sb.get_job_paused_status and sb.get_job_paused_status(survivor, camp, hub_id, 10000, camp_snap)
                    if is_paused then
                        if not survivor.paused_elapsed then
                            survivor.paused_elapsed = mmin(effective_interval - 1, effective_elapsed)
                        end
                        survivor.job_start_realtime = tg - (survivor.paused_elapsed * 1000)
                        survivor.job_start_time = current_sec - (survivor.paused_elapsed * tf)
                    else
                        if survivor.paused_elapsed then
                            survivor.job_start_realtime = tg - (survivor.paused_elapsed * 1000)
                            survivor.job_start_time = current_sec - (survivor.paused_elapsed * tf)
                            survivor.paused_elapsed = nil
                        end

                        if effective_elapsed >= effective_interval then
                            local cycles_accum = math.floor(effective_elapsed / effective_interval)
                            local max_catchup = 2 -- Cap per update tick to distribute CPU budget and prevent item spawn hitches
                            local remaining_budget = mmax(0, global_cycles_budget - total_cycles_run_this_tick)
                            local cycles_to_run = math.min(max_catchup, math.min(remaining_budget, math.max(1, cycles_accum)))

                            if cycles_to_run > 0 then
                                local cycles_completed = 0
                                local last_did_work = false

                                for cycle_idx = 1, cycles_to_run do
                                local is_catchup = (cycle_idx > 1)
                                local ok_cycle, dispatch_err = pcall(function()
                                local did_work = false

                                if job == "scavenge" then
                                    did_work = true
                                    local roll = math.random(100)
                                    if roll <= sb.cfg.scavenge_ambush_chance then
                                        if not is_catchup then
                                            sb.camp_send_tip(actor, string.format(game.translate_string("st_job_scavenger_ambushed"), survivor.name), nil, "red_danger", 12000, hub_id, "combat", true)
                                        end
                                    else
                                        local loot_box = sb.find_best_container(hub_id, camp, {"workbench"}, camp_box_id)
                                        if loot_box and not sb.is_actual_container(loot_box) then
                                            loot_box = camp_box_id
                                        end
                                        if loot_box and sb.is_actual_container(loot_box) then
                                            local tier_mult = sb.get_survivor_tier_mult(survivor)
                                            local spec_mult = sb.get_specialization_mult(camp, "scavenge")
                                            local scav_mult = tier_mult * spec_mult
                                            local scav_box = loot_box
                                            local scav_name = survivor.name or "Scavenger"
                                            local deposited, is_yellow = sb.spawn_scavenged_loot(scav_box, scav_mult, hub_id, camp, survivor)
                                            local num_items = (type(deposited) == "table") and #deposited or 0
                                            local type_desc = is_yellow and "Yellow (Rare) Stash" or "White (Common) Stash"
                                            if not is_catchup then
                                                sb.camp_send_tip(actor, string.format(game.translate_string("st_job_scavenger_returned"), scav_name, type_desc, num_items), nil, "general_stalker", 10000, nil, "expedition")
                                            end
                                            if sb.add_radio_feed_entry and camp then
                                                sb.add_radio_feed_entry("expedition", string.format(game.translate_string("st_job_scavenger_radio_feed"), scav_name, is_yellow and "Rare" or "Common", camp.name or "Camp", num_items))
                                            end
                                        else
                                            if not is_catchup then
                                                sb.camp_send_tip(actor, string.format(game.translate_string("st_job_scavenger_no_chest"), survivor.name), nil, "general_stalker", 10000, nil, "expedition")
                                            end
                                        end
                                    end
                                elseif job == "hunter" then
                                    did_work = true
                                    local roll = math.random(100)
                                    local ambush_chance = sb.cfg.hunter_ambush_chance or 20
                                    if roll <= ambush_chance then
                                        local ambush_msg = string.format(game.translate_string("st_job_hunter_ambushed"), survivor.name)
                                        if not is_catchup then
                                            sb.camp_send_tip(actor, ambush_msg, nil, "red_danger", 12000, hub_id, "combat", true)
                                        elseif sb.add_radio_feed_entry then
                                            sb.add_radio_feed_entry("combat", ambush_msg)
                                        end
                                    else
                                        local loot_box = sb.find_best_container(hub_id, camp, {"fridge", "box", "stash", "workbench"}, camp_box_id)
                                        local hunt_box = loot_box or camp_box_id or hub_id
                                        if hunt_box then
                                            local tier_mult = sb.get_survivor_tier_mult(survivor)
                                            local spec_mult = sb.get_specialization_mult(camp, "hunter")
                                            -- the tier counts up to 1.5, as spawn_hunted_meat's old cap had it;
                                            -- the Farm's and the Hideout's bonus apply on top
                                            local hunt_mult = mmin(1.5, tier_mult) * spec_mult
                                            local hunter_name = survivor.name or "Hunter"
                                            local deposited = sb.spawn_hunted_meat(hunt_box, hunt_mult, hub_id, camp)
                                            local meat_desc = format_deposited_items_summary(deposited, "fresh mutant meat")
                                            local meat_count = (type(deposited) == "table" and #deposited) or 1
                                            if not is_catchup then
                                                local tip_tmpl = game.translate_string("st_job_hunter_returned")
                                                local ok, tip_msg = pcall(string.format, tip_tmpl, hunter_name, meat_desc)
                                                if not ok then
                                                    local ok2, tip_msg2 = pcall(string.format, tip_tmpl, hunter_name, meat_count)
                                                    tip_msg = ok2 and tip_msg2 or (hunter_name .. " returned from hunting with " .. tostring(meat_desc) .. "!")
                                                end
                                                sb.camp_send_tip(actor, tip_msg, nil, "general_stalker", 10000)
                                            end
                                            if sb.add_radio_feed_entry then
                                                local radio_tmpl = game.translate_string("st_job_hunter_radio_feed")
                                                local ok_r, radio_msg = pcall(string.format, radio_tmpl, hunter_name, meat_desc, camp.name or "Camp")
                                                if not ok_r then
                                                    local ok_r2, radio_msg2 = pcall(string.format, radio_tmpl, hunter_name, meat_count, camp.name or "Camp")
                                                    radio_msg = ok_r2 and radio_msg2 or (hunter_name .. " brought back " .. tostring(meat_desc) .. " to " .. (camp.name or "Camp") .. ".")
                                                end
                                                sb.add_radio_feed_entry("work", radio_msg)
                                            end
                                        else
                                            if not is_catchup then
                                                sb.camp_send_tip(actor, string.format(game.translate_string("st_job_hunter_no_chest"), survivor.name), nil, "general_stalker", 10000)
                                            end
                                        end
                                    end
                                elseif job == "craft" then
                                    local craft_box = sb.find_best_container(hub_id, camp, {"workbench"}, camp_box_id) or camp_box_id or (is_valid_box(hub_id) and hub_id)
                                    did_work = sb.process_ammo_crafting(npc_id, craft_box, camp, survivor, camp_box_id)
                                    if sb.process_turret_maintenance then
                                        pcall(sb.process_turret_maintenance, npc_id, craft_box, camp, camp_box_id)
                                    end
                                elseif job == "repair" then
                                    local repair_box = sb.find_best_container(hub_id, camp, {"workbench"}, camp_box_id) or camp_box_id or (is_valid_box(hub_id) and hub_id)
                                    did_work = sb.process_gear_repair(npc_id, repair_box, camp, survivor, camp_box_id)
                                elseif job == "cook" then
                                    did_work = sb.process_cook_job(npc_id, hub_id, camp, survivor, camp_box_id)
                                elseif job == "medic" then
                                    local med_box = sb.find_best_container(hub_id, camp, {"medstation", "workbench"}, camp_box_id) or camp_box_id or (is_valid_box(hub_id) and hub_id)
                                    did_work = sb.process_medic_job(npc_id, med_box, camp, survivor)
                                elseif job == "electrician" or job == "guard" then
                                    did_work = true
                                    if job == "electrician" then
                                        sb.process_electrician_job(npc_id, hub_id, camp, survivor)
                                    elseif job == "guard" and sb.process_turret_maintenance then
                                        pcall(sb.process_turret_maintenance, npc_id, camp_box_id, camp, camp_box_id)
                                    end
                                elseif job == "woodcutter" then
                                    did_work = sb.process_woodcutter_job(npc_id, hub_id, camp, survivor, camp_box_id)
                                elseif job == "brewer" then
                                    did_work = sb.process_brewer_job(npc_id, hub_id, camp, survivor, camp_box_id)
                                elseif job == "scrapper" then
                                    did_work = sb.process_scrapper_job(npc_id, hub_id, camp, survivor, camp_box_id)
                                end

                                last_did_work = did_work
                                if did_work then
                                    cycles_completed = cycles_completed + 1
                                    survivor.paused_elapsed = nil
                                    survivor.shortfall_reason = nil
                                    sb.award_survivor_xp(survivor, job)
                                end
                            end)
                            total_cycles_run_this_tick = total_cycles_run_this_tick + 1
                            if not ok_cycle then
                                last_did_work = false
                                if survivor.shortfall_reason == nil then
                                    survivor.shortfall_reason = "Job Error"
                                end
                                if not survivor._dispatch_err_logged and sb.cfg and sb.cfg.debug_logging then
                                    survivor._dispatch_err_logged = true
                                    printf("[Homestead] job dispatch error (job=%s, npc=%s): %s", tostring(job), tostring(npc_id), tostring(dispatch_err))
                                end
                                break
                            end
                            if not last_did_work then
                                break
                            end
                            end

                            if cycles_completed > 0 then
                                local sec_advanced = cycles_completed * effective_interval
                                survivor.job_start_time = (survivor.job_start_time or current_sec) + (sec_advanced * tf)
                                if survivor.job_start_time > current_sec then
                                    survivor.job_start_time = current_sec
                                end
                                survivor.job_start_realtime = tg - math.max(0, (effective_elapsed - sec_advanced) * 1000)
                                if survivor.job_start_realtime > tg then
                                    survivor.job_start_realtime = tg
                                end
                                sb.play_job_complete_sound()
                            end

                            if not last_did_work then
                                survivor.paused_elapsed = math.max(0, effective_interval - 30)
                                survivor.job_start_realtime = tg - (survivor.paused_elapsed * 1000)
                                survivor.job_start_time = current_sec - (survivor.paused_elapsed * tf)
                                if not survivor.shortfall_reason then
                                    survivor.shortfall_reason = "Awaiting Supplies"
                                end
                            end
                            end
                        end
                    end
                end
            end

            if sb.process_turret_maintenance and camp and camp.structures and camp_box_id then
                pcall(sb.process_turret_maintenance, nil, camp_box_id, camp, camp_box_id)
            end
        end
        end
    end
    last_round_robin_camp_idx = (last_round_robin_camp_idx % num_camps) + 1
end

-- get_job_progress / get_job_time_remaining -- UI helpers used by the PDA
function stalker_camp_builder.get_job_progress(survivor, camp, hub_id)
    local mmax = math.max
    local mmin = math.min
    local sb = stalker_camp_builder
    if not survivor then return nil end

    if not camp and survivor and sb.active_camps then
        for hid, c in pairs(sb.active_camps) do
            if c.survivors and (c.survivors[survivor.npc_id] or c.survivors[survivor.id] or c.survivors[tostring(survivor.npc_id)] or c.survivors[tostring(survivor.id)]) then
                camp = c
                hub_id = hid
                break
            end
        end
    end

    local job = survivor.job or "idle"
    if job == "scavenge" then
        if survivor.on_expedition then
            local exp = sb.get_scavenger_expedition_for_survivor and sb.get_scavenger_expedition_for_survivor(survivor, survivor.npc_id or survivor.id)
            if exp then
                local current_sec = sb.game_sec()
                local game_elapsed = current_sec - exp.start_sec
                return mmin(1.0, mmax(0.0, game_elapsed / exp.duration))
            end
            return 0
        end
        -- Not on expedition: fall through to calculate local patrol cycle progress
    end

    local rt_interval
    if     job == "cook"     then rt_interval = sb.cfg.realtime_job_cook_interval
    elseif job == "craft"    then rt_interval = sb.cfg.realtime_job_craft_interval
    elseif job == "repair"   then rt_interval = sb.cfg.realtime_job_repair_interval
    elseif job == "hunter"   then rt_interval = sb.cfg.realtime_job_hunter_interval
    elseif job == "medic"    then rt_interval = sb.cfg.medic_job_interval or (sb.defaults and sb.defaults.medic_job_interval) or 1500
    elseif job == "electrician" then rt_interval = sb.cfg.electrician_job_interval or (sb.defaults and sb.defaults.electrician_job_interval) or 900
    elseif job == "woodcutter" then rt_interval = sb.cfg.realtime_job_woodcutter_interval or (sb.defaults and sb.defaults.realtime_job_woodcutter_interval) or 1200
    elseif job == "brewer"   then rt_interval = sb.cfg.realtime_job_brewer_interval or (sb.defaults and sb.defaults.realtime_job_brewer_interval) or 1200
    elseif job == "scrapper" then rt_interval = sb.cfg.realtime_job_scrapper_interval or (sb.defaults and sb.defaults.realtime_job_scrapper_interval) or 1200
    elseif job == "scavenge" then rt_interval = sb.cfg.realtime_job_scavenge_interval or (sb.defaults and sb.defaults.realtime_job_scavenge_interval) or 900
    else return nil  -- idle / guard have no cycle to display
    end
    if not rt_interval or rt_interval <= 0 then return 0 end

    local tg = time_global()
    local current_sec = sb.game_sec()
    local tf = (level and level.get_time_factor and level.get_time_factor()) or 10
    if tf <= 0 then tf = 10 end

    local tod_mult = sb.get_time_of_day_mult and sb.get_time_of_day_mult(job) or 1.0
    local effective_interval = rt_interval / (tod_mult > 0 and tod_mult or 1.0)

    if (not survivor.job_start_realtime) or (survivor.job_start_realtime > tg) then
        local game_elapsed = current_sec - (survivor.job_start_time or current_sec)
        local effective_sec = mmax(0, game_elapsed / tf)
        survivor.job_start_realtime = tg - (mmin(effective_sec, effective_interval) * 1000)
        if not survivor.job_start_time then
            survivor.job_start_time = current_sec
        end
    end

    local rt_elapsed_sec = mmax(0, (tg - survivor.job_start_realtime) / 1000)
    local game_elapsed_sec = mmax(0, (current_sec - (survivor.job_start_time or current_sec)) / tf)
    local effective_elapsed = mmax(rt_elapsed_sec, game_elapsed_sec)
    if survivor.paused_elapsed then
        local is_p = sb.get_job_paused_status and sb.get_job_paused_status(survivor, camp, hub_id)
        if not is_p then
            survivor.job_start_realtime = tg - (survivor.paused_elapsed * 1000)
            survivor.job_start_time = current_sec - (survivor.paused_elapsed * tf)
            survivor.paused_elapsed = nil
        else
            effective_elapsed = survivor.paused_elapsed
        end
    end

    return mmin(1.0, mmax(0.0, effective_elapsed / effective_interval))
end

function stalker_camp_builder.get_job_time_remaining(survivor, camp, hub_id)
    local mmax = math.max
    local sb = stalker_camp_builder
    if not survivor then return nil end

    if not camp and survivor and sb.active_camps then
        for hid, c in pairs(sb.active_camps) do
            if c.survivors and (c.survivors[survivor.npc_id] or c.survivors[survivor.id] or c.survivors[tostring(survivor.npc_id)] or c.survivors[tostring(survivor.id)]) then
                camp = c
                hub_id = hid
                break
            end
        end
    end

    local job = survivor.job or "idle"

    if job == "scavenge" then
        if survivor.on_expedition then
            local exp = sb.get_scavenger_expedition_for_survivor and sb.get_scavenger_expedition_for_survivor(survivor, survivor.npc_id or survivor.id)
            if exp then
                local current_sec = sb.game_sec()
                local game_elapsed = current_sec - exp.start_sec
                local tf = (level and level.get_time_factor and level.get_time_factor()) or 10
                if tf <= 0 then tf = 10 end
                local rem_game_sec = mmax(0, exp.duration - game_elapsed)
                return mmax(0, math.floor(rem_game_sec / tf))
            end
            return 0
        end
        -- Not on expedition: fall through to calculate local patrol time remaining
    end

    local rt_interval
    if     job == "cook"     then rt_interval = sb.cfg.realtime_job_cook_interval
    elseif job == "craft"    then rt_interval = sb.cfg.realtime_job_craft_interval
    elseif job == "repair"   then rt_interval = sb.cfg.realtime_job_repair_interval
    elseif job == "hunter"   then rt_interval = sb.cfg.realtime_job_hunter_interval
    elseif job == "medic"    then rt_interval = sb.cfg.medic_job_interval or (sb.defaults and sb.defaults.medic_job_interval) or 1500
    elseif job == "electrician" then rt_interval = sb.cfg.electrician_job_interval or (sb.defaults and sb.defaults.electrician_job_interval) or 900
    elseif job == "woodcutter" then rt_interval = sb.cfg.realtime_job_woodcutter_interval or (sb.defaults and sb.defaults.realtime_job_woodcutter_interval) or 1200
    elseif job == "brewer"   then rt_interval = sb.cfg.realtime_job_brewer_interval or (sb.defaults and sb.defaults.realtime_job_brewer_interval) or 1200
    elseif job == "scrapper" then rt_interval = sb.cfg.realtime_job_scrapper_interval or (sb.defaults and sb.defaults.realtime_job_scrapper_interval) or 1200
    elseif job == "scavenge" then rt_interval = sb.cfg.realtime_job_scavenge_interval or (sb.defaults and sb.defaults.realtime_job_scavenge_interval) or 900
    else return nil
    end
    if not rt_interval or rt_interval <= 0 then return 0 end

    local tod_mult = sb.get_time_of_day_mult and sb.get_time_of_day_mult(job) or 1.0
    local effective_interval = rt_interval / (tod_mult > 0 and tod_mult or 1.0)

    local progress = sb.get_job_progress(survivor, camp, hub_id) or 0
    return mmax(0, effective_interval * (1.0 - progress))
end
