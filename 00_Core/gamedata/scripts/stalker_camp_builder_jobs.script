-- stalker_camp_builder_jobs.script

-- consume_one_use -- decrement one use from a multi-use item, or release it
local function consume_one_use(item_id)
    if stalker_camp_builder and stalker_camp_builder.consume_one_use then
        return stalker_camp_builder.consume_one_use(item_id)
    end
    if not item_id then return false end
    local se_item = alife_object(item_id)
    if se_item then alife_release(se_item) end
    return true
end

