-- ============================================================================
-- WPO Weapon & Parts Overhaul System (v1.2.5 -- Type A/B/C/D Scaled Pricing)
-- ============================================================================
local function get_wpn_parts_table(wpn)
    local type_ = type
    if not wpn then return nil end
    local wpn_id = wpn:id()
    local parts = nil
    if item_parts and item_parts.get_parts_con then
        parts = item_parts.get_parts_con(wpn, wpn_id, false)
    end
    if type_(parts) ~= "table" then
        parts = se_load_var(wpn_id, wpn:name(), "parts") or se_load_var(wpn_id, nil, "parts")
    end
    if type_(parts) ~= "table" then
        if item_parts and item_parts.evaluate_parts then
            item_parts.evaluate_parts(wpn)
            parts = item_parts.get_parts_con(wpn, wpn_id, false)
        end
    end
    if type_(parts) ~= "table" then
        parts = {}
    end
    return parts
end

local function get_weapon_repair_tier(sec)
    local sfind = string.find
    if not sec then return "A", 45, 25000 end
    local parent_sec = ini_sys and ini_sys:r_string_ex(sec, "parent_section") or sec
    local rep_type = ini_sys and ini_sys:r_string_ex(parent_sec, "repair_type") or ""
    local cost = ini_sys and ini_sys:r_u32(parent_sec, "cost") or 10000
    local ammo_class = ini_sys and ini_sys:r_string_ex(parent_sec, "ammo_class") or ""

    -- Type D: Heavy Weapons, Gauss, Anti-Materiel, .338 Lapua, 12.7, PKM, RPG, or base cost > 110,000 RU
    if sfind(ammo_class, "ammo_gauss", 1, true) or sfind(ammo_class, "ammo_pkm", 1, true) or sfind(ammo_class, "ammo_12.7") or sfind(ammo_class, "ammo_magnum", 1, true) or sfind(ammo_class, "338", 1, true) or sfind(sec, "gauss", 1, true) or sfind(sec, "pkm", 1, true) or sfind(sec, "pkp", 1, true) or sfind(sec, "rpg", 1, true) or cost >= 110000 then
        return "D", 260, 200000
    end

    -- Type C: 7.62 Calibers, 9x39, DMRs, Sniper Rifles, or base cost >= 50,000 RU
    if rep_type == "rifle_7" or sfind(ammo_class, "7.62x54") or sfind(ammo_class, "7.62x51") or sfind(ammo_class, "7.62x39") or sfind(ammo_class, "9x39", 1, true) or cost >= 50000 then
        return "C", 175, 135000
    end

    -- Type B: 5.45/5.56 Rifles, Shotguns, SMGs with intermediate calibers, or base cost >= 22,000 RU
    if rep_type == "shotgun" or rep_type == "rifle_5" or sfind(ammo_class, "5.45x39") or sfind(ammo_class, "5.56x45") or sfind(ammo_class, "12x70", 1, true) or sfind(ammo_class, "12x76", 1, true) or cost >= 22000 then
        return "B", 95, 70000
    end

    -- Type A: Pistols, Sawn-offs, Basic SMGs (9x18, 9x19, .45 ACP, 7.62x25, .357)
    return "A", 45, 25000
end

function stalker_camp_builder.get_tech_overhaul_ask_text(actor, npc)
    local mfloor = math.floor
    local mmax = math.max
    local actor_obj = db.actor
    if not actor_obj then return game.translate_string("st_camp_tech_overhaul_ask") or "Overhaul equipped weapon and parts..." end

    local wpn = actor_obj:active_item()
    if not (wpn and IsWeapon(wpn)) then
        return game.translate_string("st_camp_tech_overhaul_no_wpn") or "Overhaul equipped weapon (No weapon in hands)"
    end

    local wpn_sec = wpn:section()
    local wpn_name = ui_item and ui_item.get_sec_name(wpn_sec) or wpn_sec
    local cur_cond = wpn:condition()
    local parts = get_wpn_parts_table(wpn)

    local base_deficit = mmax(0, mfloor((1.0 - cur_cond) * 100))
    local parts_deficit = 0
    local ini_parts = itms_manager and itms_manager.ini_parts
    local sec = ini_sys and ini_sys:r_string_ex(wpn_sec, "parent_section") or wpn_sec
    local parts_str = ini_parts and ini_parts:r_string_ex("con_parts_list", sec)
    local parts_list = parts_str and str_explode(parts_str, ",") or {}

    for _, p_name in ipairs(parts_list) do
        local p_con = parts[p_name] or mfloor(cur_cond * 100)
        parts_deficit = parts_deficit + mmax(0, 100 - p_con)
    end

    local total_deficit = base_deficit + parts_deficit
    if total_deficit <= 0 then
        return string.format(game.translate_string("st_camp_tech_overhaul_mint") or "Overhaul %s (Already 100%%)", wpn_name)
    end

    local tier_letter, tier_rate, tier_cap = get_weapon_repair_tier(wpn_sec)
    local raw_cost = total_deficit * tier_rate
    local renown_disc = (stalker_camp_builder.has_renown_perk and stalker_camp_builder.has_renown_perk("forge_master")) and 0.85 or 1.0
    local total_cost = mfloor(math.min(tier_cap, mmax(150, raw_cost)) * renown_disc)

    return string.format(game.translate_string("st_camp_tech_overhaul_cost") or "Overhaul %s [Type %s, %d parts] (%d RU)", wpn_name, tier_letter, #parts_list, total_cost)
end

function stalker_camp_builder.repair_equipped_weapon_and_parts(actor, npc)
    local mfloor = math.floor
    local mmax = math.max
    local sformat = string.format
    local actor_obj = db.actor
    if not actor_obj then return end

    local wpn = actor_obj:active_item()
    if not (wpn and IsWeapon(wpn)) then
        actor_menu.set_msg(1, game.translate_string("st_homestead_no_weapon_equipped") or "Equip a weapon in your hands first.", 4)
        return
    end

    local wpn_id = wpn:id()
    local wpn_sec = wpn:section()
    local wpn_name = ui_item and ui_item.get_sec_name(wpn_sec) or wpn_sec
    local cur_cond = wpn:condition()
    local parts = get_wpn_parts_table(wpn)

    local base_deficit = mmax(0, mfloor((1.0 - cur_cond) * 100))
    local parts_deficit = 0
    local ini_parts = itms_manager and itms_manager.ini_parts
    local sec = ini_sys and ini_sys:r_string_ex(wpn_sec, "parent_section") or wpn_sec
    local parts_str = ini_parts and ini_parts:r_string_ex("con_parts_list", sec)
    local parts_list = parts_str and str_explode(parts_str, ",") or {}

    for _, p_name in ipairs(parts_list) do
        local p_con = parts[p_name] or mfloor(cur_cond * 100)
        parts_deficit = parts_deficit + mmax(0, 100 - p_con)
    end

    local total_deficit = base_deficit + parts_deficit
    if total_deficit <= 0 then
        actor_menu.set_msg(1, sformat(game.translate_string("st_homestead_weapon_already_repaired") or "%s and all its parts are already in 100%% mint condition.", wpn_name), 4)
        return
    end

    local tier_letter, tier_rate, tier_cap = get_weapon_repair_tier(wpn_sec)
    local raw_cost = total_deficit * tier_rate
    local renown_disc = (stalker_camp_builder.has_renown_perk and stalker_camp_builder.has_renown_perk("forge_master")) and 0.85 or 1.0
    local total_cost = mfloor(math.min(tier_cap, mmax(150, raw_cost)) * renown_disc)

    local actor_money = actor_obj:money()
    if actor_money < total_cost then
        actor_menu.set_msg(1, sformat(game.translate_string("st_homestead_not_enough_money_tech") or "Not enough money. Overhaul cost: %d RU (you have %d RU).", total_cost, actor_money), 4)
        return
    end

    -- Charge money
    actor_obj:give_money(-total_cost)

    -- 1. Restore base weapon condition and clear C++ misfire
    wpn:set_condition(1.0)
    local se_wpn = alife_object(wpn_id)
    if se_wpn then
        pcall(function() se_wpn.condition = 1.0 end)
    end
    pcall(function()
        local c_wpn = wpn:cast_Weapon()
        if c_wpn then
            c_wpn:SetMisfire(false)
            if c_wpn.SetCondition then c_wpn:SetCondition(1.0) end
        end
    end)

    -- 2. Restore all WPO parts to 100%
    for _, p_name in ipairs(parts_list) do
        parts[p_name] = 100
    end
    parts[sec] = 100
    for k in pairs(parts) do
        parts[k] = 100
    end

    -- 3. Save to both nil and name keys in SE storage
    se_save_var(wpn_id, nil, "parts", parts)
    se_save_var(wpn_id, wpn:name(), "parts", parts)
    if item_parts and item_parts.set_parts_con then
        item_parts.set_parts_con(wpn_id, parts)
    end

    -- 4. Reset arti_jamming cache and clear jam state
    if arti_jamming then
        if arti_jamming.set_jam_status then
            arti_jamming.set_jam_status(wpn_id, nil)
        end
        if arti_jamming.reset_cgd then
            arti_jamming.reset_cgd()
        end
    end

    -- 5. Play confirmation sound and notification
    xr_sound.set_sound_play(actor_obj:id(), "pda_news")
    actor_menu.set_msg(1, sformat(game.translate_string("st_homestead_weapon_overhauled") or "Overhauled %s [Type %s] and all internal parts to 100%% for %d RU.", wpn_name, tier_letter, total_cost), 5)
end

-- ============================================================================
-- Settlement Medic Multi-Option Treatment System (v1.0.0)
-- ============================================================================
function stalker_camp_builder.is_actor_healthy(actor, npc)
    local a = db.actor
    if not a then return true end
    local health = a.health or 1.0
    local rad = a.radiation or 0.0
    local bleed = a.bleeding or 0.0
    return (health >= 0.98 and rad <= 0.01 and bleed <= 0.01)
end

function stalker_camp_builder.is_actor_not_healthy(actor, npc)
    local a = db.actor
    if not a then return false end
    local health = a.health or 1.0
    local rad = a.radiation or 0.0
    local bleed = a.bleeding or 0.0
    return (health < 0.98 or rad > 0.01 or bleed > 0.01)
end

function stalker_camp_builder.is_actor_injured(actor, npc)
    local a = db.actor
    if not a then return false end
    local health = a.health or 1.0
    local bleed = a.bleeding or 0.0
    return (health < 0.98 or bleed > 0.01)
end

function stalker_camp_builder.is_actor_irradiated(actor, npc)
    local a = db.actor
    if not a then return false end
    local rad = a.radiation or 0.0
    return (rad > 0.01)
end

function stalker_camp_builder.is_actor_injured_irradiated(actor, npc)
    local a = db.actor
    if not a then return false end
    local health = a.health or 1.0
    local bleed = a.bleeding or 0.0
    local rad = a.radiation or 0.0
    return ((health < 0.98 or bleed > 0.01) and (rad > 0.01))
end

-- the treatments' prices. Their dialog options are offered only when the player can pay: the
-- medic answers "All patched up" to each of them, paid or not. They are the base medic's prices,
-- which its actions charge (dialogs.heal_actor_injury, heal_actor_radiation and
-- heal_actor_injury_radiation)
local MEDIC_COSTS = { wounds = 1850, rad = 1480, full = 3350 }
local function can_pay_medic(cost)
    return db.actor ~= nil and db.actor:money() >= cost
end
function stalker_camp_builder.can_pay_medic_wounds() return can_pay_medic(MEDIC_COSTS.wounds) end
function stalker_camp_builder.can_pay_medic_rad() return can_pay_medic(MEDIC_COSTS.rad) end
function stalker_camp_builder.can_pay_medic_full() return can_pay_medic(MEDIC_COSTS.full) end

function stalker_camp_builder.medic_heal_wounds(actor, npc)
    local a = db.actor
    if not a then return end
    local cost = MEDIC_COSTS.wounds
    if a:money() < cost then
        actor_menu.set_msg(1, string.format(game.translate_string("st_medic_no_money") or "Not enough money (%d RU needed)", cost), 4)
        return
    end
    local _, medic = resolve_speakers(actor, npc)
    if not medic then return end
    -- the base medic's action: it pays the medic 1,850 RU and restores health, stamina and
    -- bleeding. G.A.M.M.A.'s body health system (zzz_player_injuries) wraps it to heal the limbs.
    dialogs.heal_actor_injury(a, medic)
    local snd = sound_object([[interface\inv_medkit]])
    if snd then snd:play(a, 0, sound_object.s2d) end
    level.add_pp_effector("blink.ppe", 2026, false)
    actor_menu.set_msg(1, game.translate_string("st_camp_medic_heal_done") or "Wounds patched and bleeding stopped.", 5)
end

function stalker_camp_builder.medic_cure_rad(actor, npc)
    local a = db.actor
    if not a then return end
    local cost = MEDIC_COSTS.rad
    if a:money() < cost then
        actor_menu.set_msg(1, string.format(game.translate_string("st_medic_no_money") or "Not enough money (%d RU needed)", cost), 4)
        return
    end
    local _, medic = resolve_speakers(actor, npc)
    if not medic then return end
    -- the base medic's action: it pays the medic 1,480 RU and clears the radiation
    dialogs.heal_actor_radiation(a, medic)
    local snd = sound_object([[interface\inv_drink_flask]])
    if snd then snd:play(a, 0, sound_object.s2d) end
    level.add_pp_effector("fade_in.ppe", 2027, false)
    actor_menu.set_msg(1, game.translate_string("st_camp_medic_heal_done") or "Radiation purged completely.", 5)
end

function stalker_camp_builder.medic_full_treat(actor, npc)
    local a = db.actor
    if not a then return end
    local cost = MEDIC_COSTS.full
    if a:money() < cost then
        actor_menu.set_msg(1, string.format(game.translate_string("st_medic_no_money") or "Not enough money (%d RU needed)", cost), 4)
        return
    end
    local _, medic = resolve_speakers(actor, npc)
    if not medic then return end
    -- the base medic's action: it pays the medic 3,350 RU and restores health, stamina, radiation
    -- and bleeding, and the limbs under G.A.M.M.A.'s body health system
    dialogs.heal_actor_injury_radiation(a, medic)
    a.psy_health = 1.0
    local snd = sound_object([[interface\inv_medkit]])
    if snd then snd:play(a, 0, sound_object.s2d) end
    level.add_pp_effector("blink.ppe", 2026, false)
    actor_menu.set_msg(1, game.translate_string("st_camp_medic_heal_done") or "Full physical and radiation treatment complete.", 5)
end

-- ============================================================================
-- Custom Station Positioning Dialogue Handlers (v1.0.0)
-- ============================================================================
function stalker_camp_builder.dialog_set_survivor_position_to_actor(actor, npc)
    local a, n = resolve_speakers(actor, npc)
    if not n then n = npc or (dialogs and dialogs.who_is_npc and dialogs.who_is_npc(actor, npc)) end
    if not n then return end
    local npc_id = n:id()
    local ok, res = stalker_camp_builder.set_survivor_position_to_actor(npc_id)
    if ok then
        -- set_survivor_position puts a settler on the post; a companion keeps following and takes the
        -- post on returning to the camp
        actor_menu.set_msg(1, game.translate_string("st_dialog_hold_position_done") or "Position anchored to current spot.", 4)
    elseif res == "too_far" then
        actor_menu.set_msg(1, game.translate_string("st_pda_position_too_far"), 4)
    end
end

function stalker_camp_builder.dialog_clear_survivor_position(actor, npc)
    local a, n = resolve_speakers(actor, npc)
    if not n then n = npc or (dialogs and dialogs.who_is_npc and dialogs.who_is_npc(actor, npc)) end
    if not n then return end
    local npc_id = n:id()
    stalker_camp_builder.clear_survivor_position(npc_id)
    actor_menu.set_msg(1, game.translate_string("st_dialog_clear_position_done") or "Station anchor cleared.", 4)
end

function stalker_camp_builder.survivor_has_custom_position(actor, npc)
    local a, n = resolve_speakers(actor, npc)
    if not n then n = npc or (dialogs and dialogs.who_is_npc and dialogs.who_is_npc(actor, npc)) end
    if not n then return false end
    local npc_id = n:id()
    for hub_id, camp in pairs(stalker_camp_builder.active_camps) do
        if camp.survivors and camp.survivors[npc_id] and camp.survivors[npc_id].assigned_pos then
            return true
        end
    end
    return false
end

-- A settler who joins the player through the vanilla companion dialog keeps their camp job, so
-- npc_on_update kept sending them back to their station: pause the job as recruit_back does
function stalker_camp_builder.mark_settler_companion(npc_id)
    local sb = stalker_camp_builder
    for hub_id, camp in pairs(sb.active_camps or {}) do
        local survivor = camp.survivors and camp.survivors[npc_id]
        if survivor then
            if survivor.job ~= "companion" then
                survivor.paused_job = survivor.job or "idle"
                survivor.paused_xp = survivor.xp or 0
                survivor.paused_tier = survivor.tier or 0
                survivor.paused_job_progress = sb.get_job_progress and sb.get_job_progress(survivor) or 0
                survivor.job = "companion"
                survivor.is_companion = true
                -- the station the settler beh scheme held them at
                local st = db.storage[npc_id]
                if st then
                    st.beh_homestead_active = nil
                    if type(st.beh) == "table" then
                        st.beh.rally_lvid = nil
                        st.beh.am_i_reached = nil
                    end
                end
                -- anchor_settler_to_smart's override on the squad would keep it from following
                local se_npc = alife_object(npc_id)
                local squad = se_npc and get_object_squad(se_npc)
                if squad then
                    squad.get_script_target = nil
                end
                -- the squad is the companion system's now (convert_settler_to_companion_squad drops the entry too)
                if sb.settler_home_squads then
                    sb.settler_home_squads[npc_id] = nil
                end
            end
            return
        end
    end
end

function on_game_start()
    hook_inventory_upgrades()
    -- dialogs_axr_companion.become_actor_companion calls add_to_actor_squad for each member
    if axr_companions and axr_companions.add_to_actor_squad and not axr_companions._homestead_hire_wrapped then
        axr_companions._homestead_hire_wrapped = true
        local add_to_actor_squad = axr_companions.add_to_actor_squad
        axr_companions.add_to_actor_squad = function(npc, ...)
            local ret = add_to_actor_squad(npc, ...)
            if npc and npc.id then
                stalker_camp_builder.mark_settler_companion(npc:id())
                -- hired on purpose: the ghost-companion sweep must not take them out of the party
                local m_data = alife_storage_manager and alife_storage_manager.get_state()
                local banished = m_data and m_data.stalker_camp_builder_banished_companions
                if banished then
                    banished[npc:id()] = nil
                end
                -- nor may their next spawn strip them as a freed settler (main's game_object_on_net_spawn
                -- takes the purge's mark and a wait order with it)
                local freed = m_data and m_data.stalker_camp_builder_freed_settlers
                if freed then freed[npc:id()] = nil end
            end
            return ret
        end
    end
    -- the companion dialog's "Leave" (dialogs_axr_companion.remove_companions_from_squad) and a paid
    -- escort's contract end (txr_paid_companions) call remove_from_actor_squad and leave a settler marked
    -- as a companion. Homestead's own callers set the job themselves, by the next tick.
    if axr_companions and axr_companions.remove_from_actor_squad and not axr_companions._homestead_dismiss_wrapped then
        axr_companions._homestead_dismiss_wrapped = true
        local remove_from_actor_squad = axr_companions.remove_from_actor_squad
        axr_companions.remove_from_actor_squad = function(npc, ...)
            local ret = remove_from_actor_squad(npc, ...)
            if npc and npc.id then
                local npc_id = npc:id()
                local find = stalker_camp_builder.find_companion_settler
                if find and find(npc_id) then
                    CreateTimeEvent("homestead_dismissed_" .. npc_id, "dismissed_" .. npc_id, 0, function()
                        stalker_camp_builder.return_dismissed_settler(npc_id)
                        return true
                    end)
                end
            end
            return ret
        end
    end
end
