function stalker_camp_builder.open_technician_workbench(actor, npc)
    local a, n = resolve_speakers(actor, npc)
    local sb = stalker_camp_builder
    if dialogs and dialogs.break_dialog then
        pcall(dialogs.break_dialog)
    end
    -- Find the camp this technician belongs to
    local target_hub_id = nil
    local n_id = n and n:id()
    if n_id then
        for hub_id, camp in pairs(sb.active_camps or {}) do
            if type(camp) == "table" and camp.survivors then
                if camp.survivors[n_id] or camp.survivors[tostring(n_id)] or camp.survivors[tonumber(n_id)] then
                    target_hub_id = hub_id
                    break
                end
            end
        end
    end
    target_hub_id = target_hub_id or (sb.get_current_camp_id and sb.get_current_camp_id())
    if not target_hub_id and sb.get_active_camp_near and db.actor then
        target_hub_id = sb.get_active_camp_near(db.actor:position())
    end
    if target_hub_id and ui_furniture_workshop and ui_furniture_workshop.start_dialog then
        -- Hideout Furniture's menu is a Workshop's: its Use Workshop and Access Stash give the piece
        -- a workshop_stash, which linked_stash_id puts before a Settlement Flag's own storage
        local bench_id = nil
        local se_hub = alife_object(target_hub_id)
        if se_hub and se_hub:section_name() == "placeable_workshop" then
            bench_id = target_hub_id
        else
            local camp = sb.active_camps and sb.active_camps[target_hub_id]
            for id in pairs(camp and camp.structures or {}) do
                local se = alife_object(id)
                if se and se:section_name() == "placeable_workshop" then
                    bench_id = id
                    break
                end
            end
        end
        if not bench_id then
            actor_menu.set_msg(1, game.translate_string("st_camp_tech_no_workbench"), 4)
            return
        end
        CreateTimeEvent("homestead_tech_wb", "open", 0.1, function()
            ui_furniture_workshop.start_dialog(bench_id)
            return true
        end)
    end
end

-- the camp a drug kit goes to: the medic's own, else the one the player stands in
local function get_drugkit_camp(actor, npc)
    local a, n = resolve_speakers(actor, npc)
    local n_id = n and n:id()
    for _, camp in pairs(stalker_camp_builder.active_camps or {}) do
        local surv = n_id and camp.survivors and (camp.survivors[n_id] or camp.survivors[tostring(n_id)])
        if surv and surv.job == "medic" then
            return camp
        end
    end
    if db.actor then
        local _, camp = stalker_camp_builder.get_active_camp_near(db.actor:position())
        return camp
    end
end

function stalker_camp_builder.actor_has_drugkit(actor, npc)
    if not (db.actor and (db.actor:object("itm_drugkit") or db.actor:object("drugkit"))) then return false end
    -- a camp takes one kit: once it has one, the offer goes
    local camp = get_drugkit_camp(actor, npc)
    return not (camp and camp.has_drugkit)
end

local function get_upgrade_tier(section)
    if not section then return 1 end
    if #section >= 14 then
        local indx = section:sub(14, 14):lower()
        -- G.A.M.M.A.'s Upgrades pricing overhaul gates the columns its own way: a/b need no
        -- toolkit (tier 0 always passes), d the basic one, c, e and f as in the base game
        if upgrade_rank_pricing ~= nil then
            if indx == "a" or indx == "b" then return 0 end
            if indx == "d" then return 1 end
        end
        if indx == "a" or indx == "b" then return 1 end
        if indx == "c" or indx == "d" then return 2 end
        if indx == "e" or indx == "f" then return 3 end
        if indx == "1" then return 1 end
        if indx == "2" then return 2 end
        if indx == "3" then return 3 end
    end
    local m = section:match("tier_?(%d)")
    if m then return tonumber(m) end
    return 1
end

local function get_technician_camp(victim)
    if not victim then
        if get_speaker then
            victim = get_speaker()
        end
        if not victim and inventory_upgrades and inventory_upgrades.victim_id then
            victim = level.object_by_id(inventory_upgrades.victim_id)
        end
    end
    if not victim then return nil end
    local v_id = victim:id()
    local sb = stalker_camp_builder
    if not sb then return nil end
    local lookup = sb.settler_lookup and (sb.settler_lookup[v_id] or sb.settler_lookup[tostring(v_id)])
    if lookup and lookup.camp and lookup.survivor and lookup.survivor.job == "repair" then
        return lookup.camp
    end
    if sb.active_camps then
        for hub_id, camp in pairs(sb.active_camps) do
            if camp.survivors then
                local surv = camp.survivors[v_id] or camp.survivors[tostring(v_id)]
                if surv and surv.job == "repair" then
                    return camp
                end
            end
        end
    end
    return nil
end

local function hook_inventory_upgrades()
    if inventory_upgrades and inventory_upgrades.get_global_precondition_functor and not inventory_upgrades._homestead_precond_wrapped then
        inventory_upgrades._homestead_precond_wrapped = true
        local orig_global_precond = inventory_upgrades.get_global_precondition_functor
        inventory_upgrades.get_global_precondition_functor = function(victim, section)
            local camp = get_technician_camp(victim)
            if camp then
                local req_tier = get_upgrade_tier(section)
                local camp_tech_tier = camp.tech_toolkit_tier or 0
                if camp.toolkits then
                    if camp.toolkits[3] then camp_tech_tier = math.max(camp_tech_tier, 3)
                    elseif camp.toolkits[2] then camp_tech_tier = math.max(camp_tech_tier, 2)
                    elseif camp.toolkits[1] then camp_tech_tier = math.max(camp_tech_tier, 1)
                    end
                end
                local has_tier = (camp.toolkits and camp.toolkits[req_tier]) or (camp_tech_tier >= req_tier)
                if not has_tier then
                    return 2 -- unavailable due to precondition (requires tools)
                end
            end
            return orig_global_precond(victim, section)
        end
    end

    if inventory_upgrades and inventory_upgrades.prereq_functor_a and not inventory_upgrades._homestead_prereq_wrapped then
        inventory_upgrades._homestead_prereq_wrapped = true
        local orig_prereq = inventory_upgrades.prereq_functor_a
        inventory_upgrades.prereq_functor_a = function(param3, section)
            local str = orig_prereq(param3, section) or ""
            local victim = get_speaker and get_speaker()
            local camp = get_technician_camp(victim)
            if camp then
                local req_tier = get_upgrade_tier(section)
                local camp_tech_tier = camp.tech_toolkit_tier or 0
                if camp.toolkits then
                    if camp.toolkits[3] then camp_tech_tier = math.max(camp_tech_tier, 3)
                    elseif camp.toolkits[2] then camp_tech_tier = math.max(camp_tech_tier, 2)
                    elseif camp.toolkits[1] then camp_tech_tier = math.max(camp_tech_tier, 1)
                    end
                end
                local has_tier = (camp.toolkits and camp.toolkits[req_tier]) or (camp_tech_tier >= req_tier)
                if not has_tier then
                    str = str .. "\\n - " .. game.translate_string("st_upgr_condlist")
                end
            end
            return str
        end
    end
end

-- the workbench kits only: toolkit_1..3 are story items (Zaton's zat_b103 spawns toolkit_2, and
-- Azot's jup_b217 dialog takes all three)
function stalker_camp_builder.actor_has_toolkit1(actor, npc)
    if not (db.actor and db.actor:object("itm_basickit")) then return false end
    local a, n = resolve_speakers(actor, npc)
    local camp = get_technician_camp(n)
    if not camp and db.actor and stalker_camp_builder.get_active_camp_near then
        local _, c = stalker_camp_builder.get_active_camp_near(db.actor:position())
        camp = c
    end
    if camp and ((camp.toolkits and camp.toolkits[1]) or ((camp.tech_toolkit_tier or 0) >= 1)) then
        return false
    end
    return true
end

function stalker_camp_builder.actor_has_toolkit2(actor, npc)
    if not (db.actor and db.actor:object("itm_advancedkit")) then return false end
    local a, n = resolve_speakers(actor, npc)
    local camp = get_technician_camp(n)
    if not camp and db.actor and stalker_camp_builder.get_active_camp_near then
        local _, c = stalker_camp_builder.get_active_camp_near(db.actor:position())
        camp = c
    end
    if camp and ((camp.toolkits and camp.toolkits[2]) or ((camp.tech_toolkit_tier or 0) >= 2)) then
        return false
    end
    return true
end

function stalker_camp_builder.actor_has_toolkit3(actor, npc)
    if not (db.actor and db.actor:object("itm_expertkit")) then return false end
    local a, n = resolve_speakers(actor, npc)
    local camp = get_technician_camp(n)
    if not camp and db.actor and stalker_camp_builder.get_active_camp_near then
        local _, c = stalker_camp_builder.get_active_camp_near(db.actor:position())
        camp = c
    end
    if camp and ((camp.toolkits and camp.toolkits[3]) or ((camp.tech_toolkit_tier or 0) >= 3)) then
        return false
    end
    return true
end

function stalker_camp_builder.medic_treat_actor(actor, npc)
    local actor_alao = db.actor
    if not actor_alao then return end
    local sb = stalker_camp_builder

    local hub_id, camp = sb.get_active_camp_near(actor_alao:position())
    local morale = camp and camp.morale or 50
    local is_free = (morale >= 80)
    local cost = is_free and 0 or 750

    if not is_free and actor_alao:money() < cost then
        news_manager.send_tip(actor_alao, game.translate_string("st_medic_no_money") .. " (" .. cost .. " RU)", nil, "general_stalker", 6000)
        return
    end

    if not is_free then
        actor_alao:give_money(-cost)
    end

    actor_alao.health = 1.0
    actor_alao.bleeding = 1.0
    actor_alao.radiation = 0.0
    actor_alao.psy_health = 1.0

    pcall(function()
        if z_body_health_system and z_body_health_system.heal_all_limbs then
            z_body_health_system.heal_all_limbs()
        elseif body_health_system and body_health_system.heal_all_limbs then
            body_health_system.heal_all_limbs()
        end
    end)

    local snd = sound_object([[interface\inv_medkit]])
    if snd then snd:play(actor_alao, 0, sound_object.s2d) end
    level.add_pp_effector("blink.ppe", 2026, false)
    news_manager.send_tip(actor_alao, game.translate_string("st_medic_treated"), nil, "general_stalker", 6000)
end

-- NOTE: start_camp_medic_trade is defined later (with resolve_speakers) -- do not define here

function stalker_camp_builder.give_medic_drugkit(actor, npc)
    local actor_alao = db.actor
    if not actor_alao then return end
    local itm = actor_alao:object("itm_drugkit") or actor_alao:object("drugkit")
    if itm then
        -- with no camp to record it in, or one that already has a kit, the player keeps it
        local camp = get_drugkit_camp(actor, npc)
        if not camp or camp.has_drugkit then return end

        alife_release(alife_object(itm:id()))
        if camp then
            camp.has_drugkit = true
            -- rescore rather than add: get_camp_morale counts the drug kit once
            stalker_camp_builder.get_camp_morale(camp)
        end
        news_manager.send_tip(actor_alao, game.translate_string("st_medic_drugkit_delivered"), nil, "general_stalker", 8000)
    end
end

function stalker_camp_builder.open_technician_upgrade_ui(actor, npc)
    local a, n = resolve_speakers(actor, npc)
    if not n then n = npc or (dialogs and dialogs.who_is_npc and dialogs.who_is_npc(actor, npc)) end
    if not n then return end

    hook_inventory_upgrades()

    if inventory_upgrades then
        inventory_upgrades.victim_id = n:id()
        if inventory_upgrades.mech_discount then
            local hub_id, camp = stalker_camp_builder.get_active_camp_near(n:position())
            local disc = 2.0
            if camp and camp.morale and camp.morale >= 80 then
                disc = 1.8
            end
            inventory_upgrades.mech_discount(disc)
        end
    end
    if dialogs and dialogs.hide_hud_inventory then
        dialogs.hide_hud_inventory()
    end
    if n.start_upgrade then
        n:start_upgrade(db.actor)
    elseif ui_inventory and ui_inventory.start then
        ui_inventory.start("repair", n)
    end
end

function stalker_camp_builder.start_camp_tech_trade(actor, npc)
    local a, n = resolve_speakers(actor, npc)
    if not n then n = npc or (dialogs and dialogs.who_is_npc and dialogs.who_is_npc(actor, npc)) end
    if not n then return end

    n:enable_trade()
    if dialogs and dialogs.hide_hud_inventory then
        dialogs.hide_hud_inventory()
    end
    if n.start_trade then
        n:start_trade(db.actor)
    end
end

function stalker_camp_builder.start_camp_medic_trade(actor, npc)
    local a, n = resolve_speakers(actor, npc)
    if not n then n = npc or (dialogs and dialogs.who_is_npc and dialogs.who_is_npc(actor, npc)) end
    if not n then return end

    n:enable_trade()
    if dialogs and dialogs.hide_hud_inventory then
        dialogs.hide_hud_inventory()
    end
    if n.start_trade then
        n:start_trade(db.actor)
    end
end

-- NOTE: start_camp_trader_trade is defined earlier (with trading computer support) -- do not redefine here

local function deliver_toolkit(kit_section, tier, actor, npc)
    local actor_alao = db.actor
    if not actor_alao then return end
    local itm = actor_alao:object(kit_section)
    if not itm then return end

    -- the camp the offer checked (actor_has_toolkit1..3): the technician's own, else the one the
    -- player stands in. With neither, the player keeps the kit.
    local a, n = resolve_speakers(actor, npc)
    local camp = get_technician_camp(n)
    if not camp then
        local _, c = stalker_camp_builder.get_active_camp_near(actor_alao:position())
        camp = c
    end
    if not camp then return end

    alife_release(alife_object(itm:id()))

    if camp then
        camp.tech_toolkit_tier = math.max(camp.tech_toolkit_tier or 0, tier)
        camp.toolkits = camp.toolkits or {}
        camp.toolkits[tier] = true
        -- rescore rather than add: get_camp_morale counts the toolkits once
        stalker_camp_builder.get_camp_morale(camp)
    end

    local tier_names = { [1] = "Basic", [2] = "Advanced", [3] = "Expert" }
    news_manager.send_tip(actor_alao, string.format(game.translate_string("st_tech_toolkit_delivered"), tier), nil, "general_stalker", 8000)
end

function stalker_camp_builder.give_tech_toolkit1(actor, npc) deliver_toolkit("itm_basickit", 1, actor, npc) end
function stalker_camp_builder.give_tech_toolkit2(actor, npc) deliver_toolkit("itm_advancedkit", 2, actor, npc) end
function stalker_camp_builder.give_tech_toolkit3(actor, npc) deliver_toolkit("itm_expertkit", 3, actor, npc) end

function stalker_camp_builder.dialog_auto_sort_supplies(actor, npc)
    stalker_camp_builder.smart_dump_to_camp_storage()
end

local function get_speaker_survivor_and_camp(p1, p2)
    local actor, npc = resolve_speakers(p1, p2)
    if not npc then return nil, nil, nil end
    local npc_id = npc:id()
    if not npc_id or npc_id == 0 or (actor and npc_id == actor:id()) then return nil, nil, nil end
    local sb = stalker_camp_builder
    if sb.settler_lookup and sb.settler_lookup[npc_id] then
        local entry = sb.settler_lookup[npc_id]
        if entry and entry.survivor and entry.camp then
            return entry.survivor, entry.camp, entry.hub_id
        end
    end
    for hub_id, camp in pairs(sb.active_camps or {}) do
        if type(camp) == "table" and camp.survivors then
            local surv = camp.survivors[npc_id] or camp.survivors[tostring(npc_id)] or camp.survivors[tonumber(npc_id)]
            if surv then
                return surv, camp, hub_id
            end
        end
    end
    return nil, nil, nil
end

-- no toolkit_1..3: they are quest items (kind = i_quest, can_trade = false), the instruments the
-- technicians' quests ask for (dialogs_zaton.give_toolkit_1..3)
local SCRAPPER_TOOL_SECTIONS = {
    "wpn_axe3", "wpn_sledgehammer", "crowbar", "itm_crowbar", "wpn_crowbar",
    "hammer", "ball_hammer",
    "itm_basickit", "itm_advancedkit", "itm_expertkit",
    "toolkit_p", "toolkit_s", "toolkit_r5", "toolkit_r7",
    "itm_repairkit_tier_1", "itm_repairkit_tier_2", "itm_repairkit_tier_3",
    "itm_gunsmith_toolkit", "itm_outfit_toolkit"
}

-- the tool the scrapper's hand-in takes: the first one on the list the player carries
local function get_scrapper_tool()
    local actor = db.actor
    if not actor then return nil end
    for _, sec in ipairs(SCRAPPER_TOOL_SECTIONS) do
        local itm = actor:object(sec)
        if itm then return itm, sec end
    end
    return nil
end

-- phrase 72's <script_text>, naming the tool that goes. The engine calls it with the NPC, the dialog
-- id and the phrase id (PhraseDialog.cpp 211-219); a Lua error or a nil there is fatal.
function stalker_camp_builder.get_scrapper_tools_text(npc, dialog_id, phrase_id)
    local _, sec = get_scrapper_tool()
    local name = sec and ui_item and ui_item.get_sec_name and ui_item.get_sec_name(sec)
    if not name or name == "" then
        return game.translate_string("st_camp_scrapper_tools_ask")
    end
    return string.format(game.translate_string("st_camp_scrapper_tools_offer"), name)
end

function stalker_camp_builder.actor_has_woodcutter_axe(p1, p2)
    local actor = db.actor
    if not actor then return false end
    local surv = get_speaker_survivor_and_camp(p1, p2)
    if not (surv and surv.job == "woodcutter" and not surv.has_axe) then return false end
    return (actor:object("wpn_axe") ~= nil)
        or (actor:object("wpn_axe2") ~= nil)
        or (actor:object("wpn_axe3") ~= nil)
end

function stalker_camp_builder.give_woodcutter_axe(p1, p2)
    local actor = db.actor
    if not actor then return end
    local surv, camp = get_speaker_survivor_and_camp(p1, p2)
    if not (surv and surv.job == "woodcutter" and not surv.has_axe) then return end
    local itm = actor:object("wpn_axe") or actor:object("wpn_axe2") or actor:object("wpn_axe3")
    if itm then
        alife_release(alife_object(itm:id()))
        surv.has_axe = true
        news_manager.send_tip(actor, game.translate_string("st_woodcutter_axe_delivered"), nil, "general_stalker", 8000)
    end
end

function stalker_camp_builder.actor_has_brewer_drugkit(p1, p2)
    local actor = db.actor
    if not actor then return false end
    local surv, camp = get_speaker_survivor_and_camp(p1, p2)
    -- process_brewer_job counts the camp's kit (the medic's, or another brewer's) as his own
    if not (surv and surv.job == "brewer" and not surv.has_drugkit and not (camp and camp.has_drugkit)) then return false end
    return (actor:object("itm_drugkit") ~= nil) or (actor:object("drugkit") ~= nil)
end

function stalker_camp_builder.give_brewer_drugkit(p1, p2)
    local actor = db.actor
    if not actor then return end
    local surv, camp = get_speaker_survivor_and_camp(p1, p2)
    if not (surv and surv.job == "brewer" and not surv.has_drugkit and not (camp and camp.has_drugkit)) then return end
    local itm = actor:object("itm_drugkit") or actor:object("drugkit")
    if itm then
        alife_release(alife_object(itm:id()))
        surv.has_drugkit = true
        if camp then
            camp.has_drugkit = true
            stalker_camp_builder.get_camp_morale(camp)
        end
