class "SurvivorListItem" (CUIListBoxItem)
-- one table row: icon, name, job status, tier, needs (living needs; "-" when they are off)
local SV_ROW_W = 353
function SurvivorListItem:__init(survivor_id, name, status_str, icon_sec, rank_str, xml, needs_str, needs_color)
    local mmax = math.max
    super()
    self.survivor_id = survivor_id
    if xml then
        self.card_bg = xml:InitStatic("survivor_card_bg", self)
        self.icon_bg = xml:InitStatic("survivor_card_icon_bg", self)
        self.icon = xml:InitStatic("survivor_card_icon", self)

        if icon_sec and icon_sec ~= "" then
            pcall(function() self.icon:InitTexture(icon_sec) end)
        else
            self.icon:InitTexture("ui\\ui_noise")
        end

        self.name_wnd = xml:InitTextWnd("survivor_row_name", self)
        self.name_wnd:SetText(name)
        self.name_wnd:AdjustHeightToText()
        local nh = mmax(16, self.name_wnd:GetHeight())

        self.status_wnd = xml:InitTextWnd("survivor_row_status", self)
        self.status_wnd:SetText(status_str or "")
        self.status_wnd:AdjustHeightToText()
        local sh = mmax(16, self.status_wnd:GetHeight())
        self.status_h = sh

        self.rank_wnd = xml:InitTextWnd("survivor_row_rank", self)
        self.rank_wnd:SetText(rank_str or "")

        self.needs_wnd = xml:InitTextWnd("survivor_row_needs", self)
        self.needs_wnd:SetText(needs_str or "")
        if needs_color then self.needs_wnd:SetTextColor(needs_color) end

        local card_h = mmax(24, nh + 6, sh + 6)
        self.total_item_height = card_h + 2
        self.card_bg:SetWndSize(vector2():set(SV_ROW_W, card_h))
        self:SetWndRect(Frect():set(0, 0, SV_ROW_W, self.total_item_height))
        self:SetWndSize(vector2():set(SV_ROW_W, self.total_item_height))
    else
        self.total_item_height = 26
        self.text_item = self:GetTextItem()
        self.text_item:SetText(name)
        self.text_item:SetFont(GetFontLetterica18Russian())
        self.text_item:SetTextColor(hs_theme.argb("heading"))
        self:SetWndRect(Frect():set(0, 0, SV_ROW_W, 26))
        self:SetWndSize(vector2():set(SV_ROW_W, 26))
    end
end

-- the needs column follows the camp's living-needs flags on the survivor
function SurvivorListItem:UpdateNeeds(needs_str, needs_color)
    if self.needs_wnd then
        self.needs_wnd:SetText(needs_str or "")
        if needs_color then self.needs_wnd:SetTextColor(needs_color) end
    end
end

function SurvivorListItem:SetSelected(is_sel)
    if self.card_bg and self.card_bg.InitTexture then
        if is_sel then
            self.card_bg:InitTexture("ui_homestead_card_selected")
            if self.name_wnd then
                self.name_wnd:SetTextColor(hs_theme.argb("heading"))
            end
        else
            self.card_bg:InitTexture("ui_homestead_card_bg")
            if self.name_wnd then
                self.name_wnd:SetTextColor(hs_theme.argb("heading"))
            end
        end
    end
end

-- returns true when the new status needs more lines than the card was laid out for (it would
-- run over the rank line under it)
function SurvivorListItem:UpdateStatus(status_str, color)
    if self.status_wnd then
        self.status_wnd:SetText(status_str or "")
        if color then
            self.status_wnd:SetTextColor(color)
        end
        self.status_wnd:AdjustHeightToText()
        return self.status_h ~= nil and self.status_wnd:GetHeight() > self.status_h
    end
end

