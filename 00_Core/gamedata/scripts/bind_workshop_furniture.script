-- bind_workshop_furniture.script
-- Homestead Settlement Builder & GAMMA Hideout Furniture compatibility
-- Enables native engine use callback on placeable workbenches and stashes.

function init(obj)
    obj:bind_object(hf_workshop_wrapper(obj).binder)
end

class "hf_workshop_wrapper" (bind_hf_base.hf_binder_wrapper)

-- no use override and no engine use callback: Hideout Furniture's own use_callback opens the
-- workshop from its radial menu, which calls it with no arguments
function hf_workshop_wrapper:__init(obj)
    super(obj)
end

function hf_workshop_wrapper:net_destroy()
    if self.object and self.object.set_callback then
        self.object:set_callback(callback.use_object, nil)
    end
    bind_hf_base.hf_binder_wrapper.net_destroy(self)
end

function hf_workshop_wrapper:pickup()
    -- the stash is released with the workbench: an offline one would take its contents with it,
    -- so bring it online and let the player pick the workbench up again in a moment
    local m_data = alife_storage_manager.get_state()
    local wid = self.object and self.object:id()
    local sid = wid and m_data.workshop_stashes and m_data.workshop_stashes[wid]
    if sid and alife_object(sid) and not (level and level.object_by_id and level.object_by_id(sid)) then
        alife():set_switch_online(sid, true)
        alife():set_switch_offline(sid, false)
        actor_menu.set_msg(1, game.translate_string("st_homestead_station_stash_busy"), 3)
        return false
    end

    local hub_id = self.object and self.object:id()
    local hub_pos = self.object and self.object:position()
    local sb = stalker_camp_builder
    if sb and sb.release_legacy_camp_stash then
        local camp = hub_id and sb.active_camps and sb.active_camps[hub_id]
        pcall(sb.release_legacy_camp_stash, camp, hub_pos)
    end

    -- If this workbench is a Homestead settlement hub, picking it up through
    -- the normal Hideout Furniture interaction must perform the same registry
    -- cleanup as the PDA "Dismantle Camp" button. Otherwise the physical
    -- hub disappears while active_camps keeps a ghost settlement entry.
    if hub_id and sb and sb.active_camps
        and sb.active_camps[hub_id]
        and sb.dismantle_camp then
        pcall(sb.dismantle_camp, hub_id)
    end

    if m_data.workshop_stashes then
        local id = m_data.workshop_stashes[self.object:id()]
        if id then
            local stash_obj = level and level.object_by_id and level.object_by_id(id)
            if stash_obj then
                stash_obj:iterate_inventory_box(function(temp, obj)
                    stash_obj:transfer_item(obj, db.actor)
                end, stash_obj)
            end
            m_data.workshop_stashes[self.object:id()] = nil
            alife_release_id(id)
        end
    end
    return bind_hf_base.hf_binder_wrapper.pickup(self)
end
