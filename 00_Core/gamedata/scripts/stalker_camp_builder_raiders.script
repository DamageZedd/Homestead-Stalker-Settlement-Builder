-- stalker_camp_builder_raiders.script
-- Raiders (docs/design/raiders.md): the pure rules for the Raider job (phase 1, no engine access, run by
-- tools/tests/test_raiders.lua) and, below the "runtime" banner, the abstract-mission layer (phase 2).
-- The feature is always on; the raiders_* MCM options only tune it.
--
-- Owner decisions built in (docs/design/raiders.md, "Decisions"): player-directed sends only, any rank
-- (rank only moves the odds) and one guard stays home, an idle raider at home is half a guard, a failed raid leaves the raiders
-- wounded and only a disaster kills, 60% of the chest / 15% cut, weapon and armor loot can be forbidden,
-- -60 goodwill per robbed camp and -100 more for a friendly faction with a daily cap of 150.

local sb = stalker_camp_builder
local mmin = math.min
local mmax = math.max
local mfloor = math.floor

-- the defaults the MCM group will carry later; cfg values (sb.cfg) win over these once they exist
local DEFAULTS = {
    raiders_min_guards = 1,
    raiders_idle_guard_weight = 50,        -- percent of a guard
    raiders_wounded_minutes = 40,          -- real minutes, whatever the time factor or Real Time Zones do
    raiders_rest_minutes = 20,
    raiders_disaster_death_chance = 50,    -- percent per raider
    raiders_loot_fraction = 60,            -- percent of the chest by count
    raiders_cut_percent = 15,
    raiders_forbid_weapon_armor = false,
    raiders_goodwill_loot = 60,
    raiders_goodwill_betrayal = 100,
    raiders_goodwill_daily_cap = 150,
    raiders_goodwill_enemy_bonus = 0,      -- optional, off
    raiders_bandit_mode = false,
    raiders_bandit_penalty_mult = 50,      -- percent of the normal goodwill loss in bandit mode
    raiders_bandit_rep = 20,
    raiders_bandit_loot_bonus = 25,        -- percent more cash and items in bandit mode
    raiders_max_per_day = 3,
    raiders_auto_recall = false,
}

-- cash bounty by camp tier, before the loot multiplier
local TIER_BOUNTY = { 500, 1500, 3000 }
-- garrison weight of one tier
local TIER_FACTOR = { 1.0, 1.4, 2.0 }
local ASSAULT_WINDOW_SEC = 1800
local MAX_MISSION_SEC = 4 * 3600
local WIN_MIN, WIN_MAX = 0.05, 0.90
local RECALL_DELAY_REAL_SEC = 20   -- real seconds a recalled band needs to reach camp (abstract teleport-back)
local FRIEND_GOODWILL = 500      -- goodwill with the player at or above this = a friendly faction

local BANDIT_FACTIONS = { bandit = true, renegade = true }
local NOT_A_FACTION = { monster = true, zombied = true, trader = true, none = true, arena_enemy = true, actor = true }

local function cfgv(key, cfg)
    if type(cfg) == "table" and cfg[key] ~= nil then return cfg[key] end
    local c = sb and sb.cfg
    if type(c) == "table" and c[key] ~= nil then return c[key] end
    return DEFAULTS[key]
end

local function num(v, fallback)
    v = tonumber(v)
    if v == nil or v ~= v then return fallback end
    return v
end

local function clamp(v, lo, hi) return mmin(hi, mmax(lo, v)) end

-- ---------------------------------------------------------------- guards and eligibility

-- guards a camp can count on: real guards, plus the idle raiders at home at their weight;
-- raiders on a mission or wounded count as none
function sb.raiders_effective_guards(guards, raiders_home_idle, cfg)
    local w = clamp(num(cfgv("raiders_idle_guard_weight", cfg), 50), 0, 100) / 100
    return mmax(0, num(guards, 0)) + mmax(0, num(raiders_home_idle, 0)) * w
end

-- what one raider adds to the camp's guard count: the idle weight when they are home and fit, else 0
function sb.raiders_defense_share(surv, now_sec, cfg)
    if type(surv) ~= "table" then return 0 end
    if surv.on_mission or sb.raiders_is_wounded(surv, now_sec or (sb.raiders_now and sb.raiders_now()) or 0) then return 0 end
    -- a raider called home to fight an attack is a full guard until the attack is over
    if type(surv.raider) == "table" and surv.raider.defending then return 1 end
    return sb.raiders_effective_guards(0, 1, cfg)
end

function sb.raiders_is_wounded(surv, now_sec)
    local r = type(surv) == "table" and surv.raider
    if type(r) ~= "table" then return false end
    return num(r.wounded_until, 0) > num(now_sec, 0)
end

-- can this survivor be put on a mission now? returns true, or false and a reason key
function sb.raiders_survivor_ready(surv, now_sec, cfg)
    if type(surv) ~= "table" then return false, "none" end
    if surv.on_mission or surv.on_expedition then return false, "busy" end
    if sb.raiders_is_wounded(surv, now_sec) then return false, "wounded" end
    if type(surv.raider) == "table" and surv.raider.defending then return false, "defending" end
    if surv.has_weapon == false then return false, "no_weapon" end
    if surv.has_ammo == false then return false, "no_ammo" end
    local r = type(surv.raider) == "table" and surv.raider
    if r and num(r.rest_until, 0) > num(now_sec, 0) then return false, "resting" end
    return true
end

-- the timer that holds a raider back and what is left of it: "wounded" or "resting", seconds on the mission clock
-- (wounded wins: the wounded time is the longer one); nil when no timer runs
function sb.raiders_survivor_timer(surv, now_sec)
    local r = type(surv) == "table" and surv.raider
    if type(r) ~= "table" then return nil end
    local now = num(now_sec, 0)
    local w = num(r.wounded_until, 0) - now
    if w > 0 then return "wounded", w end
    local c = num(r.rest_until, 0) - now
    if c > 0 then return "resting", c end
    return nil
end

-- mission seconds as the real-time countdown the PDA shows ("1h 05m", "12m 05s"); tf = mission seconds per real second.
-- Rounded up so a running timer never reads 0s
function sb.raiders_timer_text(left, tf)
    tf = num(tf, 10)
    if tf <= 0 then tf = 10 end
    return sb.raiders_eta_text(math.ceil(mmax(0, num(left, 0)) / tf))
end

-- Why each raider of a camp is not free right now, for the PDA: { { id, name, key, left }, ... } soonest first.
-- key is a raiders_survivor_ready reason; left (mission seconds) only for the two timers
function sb.raiders_blockers(survivors, now_sec, cfg)
    local out = {}
    for id, s in pairs(type(survivors) == "table" and survivors or {}) do
        if type(s) == "table" and s.job == "raider" then
            local ok, why = sb.raiders_survivor_ready(s, now_sec, cfg)
            if not ok then
                local kind, left = sb.raiders_survivor_timer(s, now_sec)
                out[#out + 1] = { id = id, name = s.name, key = why, left = (kind and kind == why) and left or nil }
            end
        end
    end
    table.sort(out, function(a, b)
        local la, lb = a.left or math.huge, b.left or math.huge
        if la ~= lb then return la < lb end
        return tostring(a.name or a.id) < tostring(b.name or b.id)
    end)
    return out
end

-- the PDA lines for a blocker list: one per raider, at most `max`, then "+N more" and when the first one is free again.
-- fmt = { wounded, resting, busy, defending, no_weapon, no_ammo (each "%s ... %s"), more ("%d"), next ("%s") }
function sb.raiders_blocker_lines(list, tf, fmt, max)
    local lines = {}
    if type(list) ~= "table" or type(fmt) ~= "table" then return lines end
    max = num(max, 3)
    local soonest
    for i, b in ipairs(list) do
        if b.left and (not soonest or b.left < soonest) then soonest = b.left end
        if i <= max then
            local f = fmt[b.key] or fmt.busy or "%s"
            local name = tostring(b.name or "Raider")
            if b.left then
                lines[#lines + 1] = string.format(f, name, sb.raiders_timer_text(b.left, tf))
            else
                lines[#lines + 1] = string.format(f, name)
            end
        end
    end
    if #list > max and fmt.more then lines[#lines + 1] = string.format(fmt.more, #list - max) end
    if soonest and fmt.next then lines[#lines + 1] = string.format(fmt.next, sb.raiders_timer_text(soonest, tf)) end
    return lines
end

-- Can this camp send raiders at this target? info = { guards, ready, missions_today, now }
-- target = { occupied, faction, story, nest, own, on_cooldown, busy }; a friendly faction is a valid target
-- (the PDA warns, the goodwill plan prices it)
-- returns true, or false and a reason key for the PDA
function sb.raiders_can_send(info, target, cfg)
    if type(info) ~= "table" or type(target) ~= "table" then return false, "none" end
    if target.own then return false, "own" end
    if target.story then return false, "story" end
    if target.nest then return false, "nest" end
    local f = target.faction
    if not target.occupied or type(f) ~= "string" or NOT_A_FACTION[f] then return false, "empty" end
    if target.busy then return false, "busy" end
    if info.raid_active then return false, "raid" end
    if target.on_cooldown then return false, "cooldown" end
    if num(info.ready, 0) < 1 then return false, "no_raider" end
    if num(info.guards, 0) < num(cfgv("raiders_min_guards", cfg), 1) then return false, "no_guard" end
    if num(info.missions_today, 0) >= num(cfgv("raiders_max_per_day", cfg), 3) then return false, "daily" end
    return true
end

-- ---------------------------------------------------------------- odds and outcome

-- one raider's strength: rank, weapon tier and armor tier (all small integers, 0 when unknown)
function sb.raiders_member_strength(m)
    m = type(m) == "table" and m or {}
    return (1 + 0.5 * mmax(0, num(m.rank, 0))) * (1 + 0.15 * mmax(0, num(m.weapon_tier, 0)))
        * (1 + 0.1 * mmax(0, num(m.armor_tier, 0)))
end

function sb.raiders_band_strength(band)
    local total = 0
    for _, m in ipairs(type(band) == "table" and band or {}) do
        total = total + sb.raiders_member_strength(m)
    end
    return total
end

-- the garrison: size x tier factor, plus half a point per defense piece (turrets, decor emplacements)
function sb.raiders_defender_strength(garrison, tier, defenses)
    local t = clamp(mfloor(num(tier, 1)), 1, 3)
    return mmax(0, num(garrison, 0)) * TIER_FACTOR[t] + 0.5 * mmax(0, num(defenses, 0))
end

-- chance the band takes the camp: 1 / (1 + (defense / attack)^2), clamped to 5%..90%
function sb.raid_odds(attack, defense)
    attack, defense = num(attack, 0), num(defense, 0)
    if attack <= 0 then return WIN_MIN end
    if defense <= 0 then return WIN_MAX end
    local ratio = defense / attack
    return clamp(1 / (1 + ratio * ratio), WIN_MIN, WIN_MAX)
end

-- result from two rolls in [0,1): roll decides win or loss; on a loss roll2 decides a disaster
-- (a clean rout) against a repulse. The worse the odds, the likelier the disaster: 15% to 60% of losses.
function sb.raid_outcome(win_chance, roll, roll2)
    local p = clamp(num(win_chance, WIN_MIN), 0, 1)
    if num(roll, 1) < p then return "success" end
    local disaster = clamp(0.15 + 0.45 * (1 - p), 0.15, 0.60)
    if num(roll2, 1) < disaster then return "disaster" end
    return "repulsed"
end

-- Who comes back. rolls = one number in [0,1) per raider. Returns
-- { dead = {index...}, wounded = {index...}, ok = {index...} }.
-- success: all fine; repulsed: all wounded, none dead; disaster: each has the death chance, the rest wounded.
function sb.raid_casualties(result, count, rolls, cfg)
    local out = { dead = {}, wounded = {}, ok = {} }
    count = mmax(0, mfloor(num(count, 0)))
    local death = clamp(num(cfgv("raiders_disaster_death_chance", cfg), 50), 0, 100) / 100
    for i = 1, count do
        if result == "success" then
            out.ok[#out.ok + 1] = i
        elseif result == "disaster" and num(type(rolls) == "table" and rolls[i], 1) < death then
            out.dead[#out.dead + 1] = i
        else
            out.wounded[#out.wounded + 1] = i
        end
    end
    return out
end

-- Wounded and rest times are REAL minutes: the mission clock runs tf mission seconds per real second (tf = the
-- settlement's nominal factor, default 10), so the wait and the countdown the PDA shows are the same real time
-- whatever the time factor or Real Time Zones do.
local function real_min_sec(minutes, tf)
    tf = num(tf, 10)
    if tf <= 0 then tf = 10 end
    return mmax(0, num(minutes, 0)) * 60 * tf
end

function sb.raiders_wounded_until(now_sec, cfg, tf)
    return num(now_sec, 0) + real_min_sec(cfgv("raiders_wounded_minutes", cfg), tf)
end

function sb.raiders_rest_until(now_sec, cfg, tf)
    return num(now_sec, 0) + real_min_sec(cfgv("raiders_rest_minutes", cfg), tf)
end

-- Old records (and a shortened MCM setting) may hold longer waits than the current ones: nobody waits longer than
-- the setting says. Returns true when something was clamped.
function sb.raiders_clamp_timers(r, now_sec, cfg, tf)
    if type(r) ~= "table" then return false end
    local now, changed = num(now_sec, 0), false
    local wmax = now + real_min_sec(cfgv("raiders_wounded_minutes", cfg), tf)
    local rmax = now + real_min_sec(cfgv("raiders_rest_minutes", cfg), tf)
    if num(r.wounded_until, 0) > wmax then r.wounded_until = wmax; changed = true end
    if num(r.rest_until, 0) > rmax then r.rest_until = rmax; changed = true end
    return changed
end

-- game seconds for a mission: travel plus the assault window, capped
function sb.raiders_mission_duration(dist_m, speed_mps)
    local speed = mmax(0.5, num(speed_mps, 3))
    return clamp(mmax(0, num(dist_m, 0)) / speed + ASSAULT_WINDOW_SEC, ASSAULT_WINDOW_SEC, MAX_MISSION_SEC)
end

-- ---------------------------------------------------------------- loot

-- item kinds in the order raiders prefer them
local KIND_ORDER = { ammo = 1, med = 2, food = 3, other = 4, weapon = 5, armor = 6 }

local function kind_of(item)
    local k = type(item) == "table" and item.kind
    return KIND_ORDER[k] and k or "other"
end

-- Split a chest's items. items = list of { sec, kind, value }. Takes loot_fraction of the item
-- count in preference order (ammo, meds, food, other, weapons, armor); weapons and armor are left out
-- when forbidden. Returns { taken = {...}, left = {...}, taken_value }.
function sb.raiders_loot_split(items, cfg)
    local fraction = clamp(num(cfgv("raiders_loot_fraction", cfg), 60), 0, 100) / 100
    if cfgv("raiders_bandit_mode", cfg) == true then
        fraction = mmin(1, fraction * (1 + num(cfgv("raiders_bandit_loot_bonus", cfg), 25) / 100))
    end
    local forbid = cfgv("raiders_forbid_weapon_armor", cfg) == true
    local pool, left = {}, {}
    for _, it in ipairs(type(items) == "table" and items or {}) do
        local k = kind_of(it)
        if forbid and (k == "weapon" or k == "armor") then
            left[#left + 1] = it
        else
            pool[#pool + 1] = { item = it, kind = k, order = #pool }
        end
    end
    table.sort(pool, function(a, b)
        if KIND_ORDER[a.kind] ~= KIND_ORDER[b.kind] then return KIND_ORDER[a.kind] < KIND_ORDER[b.kind] end
        return a.order < b.order
    end)
    local want = mfloor(#pool * fraction + 0.5)
    local taken, value = {}, 0
    for i, e in ipairs(pool) do
        if i <= want then
            taken[#taken + 1] = e.item
            value = value + mmax(0, num(e.item.value, 0))
        else
            left[#left + 1] = e.item
        end
    end
    return { taken = taken, left = left, taken_value = value }
end

-- the raiders' cut of the haul value (rubles), spread by the caller; Starving camps pay none
function sb.raiders_cut(haul_value, starving, cfg)
    if starving then return 0 end
    local pct = clamp(num(cfgv("raiders_cut_percent", cfg), 15), 0, 50) / 100
    return mfloor(mmax(0, num(haul_value, 0)) * pct)
end

-- cash bounty for clearing a camp of this tier
function sb.raiders_bounty(tier, cfg)
    local t = clamp(mfloor(num(tier, 1)), 1, 3)
    local v = TIER_BOUNTY[t]
    if cfgv("raiders_bandit_mode", cfg) == true then
        v = v * (1 + num(cfgv("raiders_bandit_loot_bonus", cfg), 25) / 100)
    end
    return mfloor(v)
end

-- ---------------------------------------------------------------- goodwill

-- Goodwill changes for a robbed camp. a = {
--   faction = robbed faction, own = the player's own faction, friendly = bool (friendly to the player),
--   allies = { faction... } (friends of the robbed faction), enemies = { faction... },
--   spent = { [faction] = goodwill lost today } }
-- Returns a list of { faction, delta } with losses capped so that spent + loss <= the daily cap.
-- The caller applies each delta (one helper, change_community_goodwill) and adds the loss to spent.
function sb.raiders_goodwill_plan(a, cfg)
    local plan = {}
    if type(a) ~= "table" or type(a.faction) ~= "string" or NOT_A_FACTION[a.faction] then return plan end
    local loot = mmax(0, num(cfgv("raiders_goodwill_loot", cfg), 60))
    local betrayal = mmax(0, num(cfgv("raiders_goodwill_betrayal", cfg), 100))
    local cap = mmax(0, num(cfgv("raiders_goodwill_daily_cap", cfg), 150))
    local bandit = cfgv("raiders_bandit_mode", cfg) == true
    local mult = bandit and clamp(num(cfgv("raiders_bandit_penalty_mult", cfg), 50), 0, 100) / 100 or 1
    local spent = type(a.spent) == "table" and a.spent or {}
    local seen, lost = {}, {}

    local function add(f, delta)
        if type(f) ~= "string" or NOT_A_FACTION[f] or f == a.own or delta == 0 then return end
        if delta < 0 then
            local room = mmax(0, cap - num(spent[f], 0) - (lost[f] or 0))
            delta = -mmin(-delta, room)
            lost[f] = (lost[f] or 0) - delta
            if delta == 0 then return end
        end
        if seen[f] then
            plan[seen[f]].delta = plan[seen[f]].delta + delta
        else
            plan[#plan + 1] = { faction = f, delta = delta }
            seen[f] = #plan
        end
    end

    -- the robbed faction: the loss, plus the betrayal penalty when it was friendly to the player
    local loss = loot + (a.friendly and betrayal or 0)
    add(a.faction, -mfloor(loss * mult + 0.5))
    -- its allies take half the base loss
    for _, f in ipairs(type(a.allies) == "table" and a.allies or {}) do
        if f ~= a.faction then add(f, -mfloor(loot * 0.5 * mult + 0.5)) end
    end
    -- its enemies may like it (optional, default 0)
    local bonus = num(cfgv("raiders_goodwill_enemy_bonus", cfg), 0)
    if bonus > 0 then
        for _, f in ipairs(type(a.enemies) == "table" and a.enemies or {}) do
            if f ~= a.faction then add(f, mfloor(bonus)) end
        end
    end
    -- bandit play: standing with the bandit-aligned factions, except the one just robbed
    if bandit then
        local rep = num(cfgv("raiders_bandit_rep", cfg), 20)
        for f in pairs(BANDIT_FACTIONS) do
            if f ~= a.faction then add(f, rep) end
        end
    end
    table.sort(plan, function(x, y) return x.faction < y.faction end)
    return plan
end

-- the goodwill the robbed faction itself loses, for the PDA preview: the base loss plus the betrayal
-- penalty for a friendly faction, bandit-mode reduced, held to what is left of the daily cap
function sb.raiders_faction_loss(faction, friendly, spent, own, cfg)
    for _, p in ipairs(sb.raiders_goodwill_plan({ faction = faction, own = own, friendly = friendly,
        spent = spent }, cfg)) do
        if p.faction == faction then return mmax(0, -p.delta) end
    end
    return 0
end

-- whole hours and minutes (rounded up) left on a timer in game seconds
-- real seconds as a countdown that visibly ticks: "1h 05m", "12m 05s", "42s"
function sb.raiders_eta_text(sec)
    local s = mfloor(mmax(0, num(sec, 0)))
    if s >= 3600 then return string.format("%dh %02dm", mfloor(s / 3600), mfloor(s % 3600 / 60)) end
    if s >= 60 then return string.format("%dm %02ds", mfloor(s / 60), s % 60) end
    return string.format("%ds", s)
end

function sb.raiders_is_friendly(goodwill_with_player)
    return num(goodwill_with_player, 0) >= FRIEND_GOODWILL
end

-- ---------------------------------------------------------------- mission clock

-- Missions run on their own clock so a countdown ticks the same real time whatever Real Time Zones does to the game
-- clock (0.1x while it catches up after a load, 1x otherwise). clock = game_sec + off. Without RTZ off stays put, so
-- the mission clock IS the game clock (old saves and plain games behave as before). With RTZ the clock moves by real
-- seconds x the nominal factor instead, and whatever the game clock does (slow, jumps, syncs) is cancelled out of off.
-- off: the stored offset; last_g: game_sec at the previous step (nil on first use); real_dt: real seconds since it
-- (0 when unknown, e.g. the first step after a load); nominal: mission seconds per real second. Returns the new off.
local MAX_STEP_REAL_SEC = 60
function sb.raiders_clock_advance(off, last_g, g, real_dt, nominal, rtz)
    off = num(off, 0)
    if not rtz or last_g == nil then return off end
    local dt = clamp(num(real_dt, 0), 0, MAX_STEP_REAL_SEC)
    local tf = num(nominal, 0)
    if tf <= 0 then tf = 10 end
    return off + dt * tf - (num(g, 0) - num(last_g, 0))
end

-- ---------------------------------------------------------------- mission record

-- the shared record of the design doc (5.1); plain numbers, strings and tables only
function sb.raiders_new_mission(id, target_key, target_level, faction, raider_ids, now_sec, duration, odds)
    local ids = {}
    for i, v in ipairs(type(raider_ids) == "table" and raider_ids or {}) do ids[i] = v end
    return {
        id = id, state = "away", mode = "abstract",
        target_key = target_key, target_level = target_level, faction = faction,
        raider_ids = ids,
        start_sec = num(now_sec, 0), duration = num(duration, ASSAULT_WINDOW_SEC),
        arrive_sec = num(now_sec, 0) + num(duration, ASSAULT_WINDOW_SEC),
        odds = num(odds, WIN_MIN),
        result = nil, loot_rolled = false, goodwill_paid = false,
    }
end

-- game seconds until the mission is back; nil without an away mission
function sb.raiders_mission_remaining(m, now_sec)
    if type(m) ~= "table" or (m.state ~= "away" and m.state ~= "returning" and m.state ~= "assault") then return nil end
    return mmax(0, num(m.arrive_sec, 0) - num(now_sec, 0))
end

function sb.raiders_mission_due(m, now_sec)
    return type(m) == "table" and m.state == "away" and num(now_sec, 0) >= num(m.arrive_sec, math.huge)
end

-- ---------------------------------------------------------------- recall (phase 4)

-- game seconds a recalled band needs to reach camp; tf = game seconds per real second
function sb.raiders_recall_delay(tf)
    tf = num(tf, 10)
    return RECALL_DELAY_REAL_SEC * (tf > 0 and tf or 10)
end

-- Can the player recall? away / returning = raiders counted on away / already recalled missions.
-- Returns true, or false and a reason key ("none": nobody away, "returning": a recall is already under way)
function sb.raiders_recall_check(away, returning)
    if num(away, 0) > 0 then return true end
    if num(returning, 0) > 0 then return false, "returning" end
    return false, "none"
end

-- Turns an away mission into a returning one that reaches camp after delay_sec. No loot, no goodwill, no
-- cooldown: the record only changes state, so it saves and loads like any other. False when not away.
function sb.raiders_mission_recall(m, now_sec, delay_sec)
    if type(m) ~= "table" or (m.state ~= "away" and m.state ~= "assault") then return false end
    m.state = "returning"
    m.mode = "abstract"
    m.real = nil
    m.recalled = true
    m.arrive_sec = num(now_sec, 0) + mmax(0, num(delay_sec, 0))
    return true
end

-- the delay as the player reads it (real time, the game clock only scales it)
function sb.raiders_recall_eta_text()
    return sb.raiders_eta_text(RECALL_DELAY_REAL_SEC)
end

function sb.raiders_recall_due(m, now_sec)
    return type(m) == "table" and m.state == "returning" and num(now_sec, 0) >= num(m.arrive_sec, math.huge)
end

-- the one-shot guards of finish_mission: true the first time for a step ("loot" or "goodwill"),
-- false after, so a mission that switched between abstract and real never pays twice
function sb.raiders_mission_claim(m, step)
    if type(m) ~= "table" then return false end
    if step == "loot" then
        if m.loot_rolled then return false end
        m.loot_rolled = true
        return true
    elseif step == "goodwill" then
        if m.goodwill_paid then return false end
        m.goodwill_paid = true
        return true
    end
    return false
end

-- abstract <-> real; real is allowed only while the mission is still away or in assault
function sb.raiders_mission_set_mode(m, mode)
    if type(m) ~= "table" or (mode ~= "abstract" and mode ~= "real") then return false end
    if m.state ~= "away" and m.state ~= "assault" then return false end
    m.mode = mode
    m.state = (mode == "real") and "assault" or "away"
    return true
end

function sb.raiders_mission_finish(m, result)
    if type(m) ~= "table" or m.result ~= nil then return false end
    if result ~= "success" and result ~= "repulsed" and result ~= "disaster" then return false end
    m.result = result
    m.state = "done"
    return true
end

-- ---------------------------------------------------------------- visible assault (phase 5, pure part)

local ASSAULT_STALL_REAL_SEC = 150     -- no change in either side's headcount for this long = a stalemate
local ASSAULT_HARD_REAL_SEC = 900      -- the longest a visible fight may run
local ASSAULT_RESET_REAL_SEC = 30      -- after a load the band is "away" again and may start over
local PROXY_LINGER_REAL_SEC = 90       -- a winning team stays this long before it is released

-- the travel part is over: the band reaches the outpost ASSAULT_WINDOW_SEC before the abstract deadline
function sb.raiders_assault_start_due(m, now_sec)
    if type(m) ~= "table" or m.state ~= "away" or m.mode == "real" or m.no_visible then return false end
    now_sec = num(now_sec, 0)
    return now_sec >= num(m.arrive_sec, math.huge) - ASSAULT_WINDOW_SEC and now_sec < num(m.arrive_sec, 0)
end

-- the record of a fight that has begun; tf = game seconds per real second
function sb.raiders_assault_begin(m, now_sec, tf, info)
    if not sb.raiders_mission_set_mode(m, "real") then return false end
    info = type(info) == "table" and info or {}
    tf = num(tf, 10) > 0 and num(tf, 10) or 10
    now_sec = num(now_sec, 0)
    m.real = {
        squad_id = info.squad_id, section = info.section, epoch = info.epoch,
        proxy_start = mmax(1, num(info.proxy, 1)), proxy_alive = mmax(1, num(info.proxy, 1)),
        garrison_start = mmax(1, num(info.garrison, 1)), garrison_alive = mmax(1, num(info.garrison, 1)),
        started_sec = now_sec, progress_sec = now_sec,
        stall_sec = ASSAULT_STALL_REAL_SEC * tf, hard_sec = now_sec + ASSAULT_HARD_REAL_SEC * tf,
        linger_sec = PROXY_LINGER_REAL_SEC * tf,
    }
    return true
end

-- the abstract odds for a fight cut short: the shown odds, scaled by what is left of each side
function sb.raiders_fallback_odds(m)
    local r = type(m) == "table" and m.real
    local p0 = clamp(num(m and m.odds, WIN_MIN), WIN_MIN, WIN_MAX)
    if type(r) ~= "table" then return p0 end
    local att = clamp(num(r.proxy_alive, 0) / mmax(1, num(r.proxy_start, 1)), 0, 1)
    local def = clamp(num(r.garrison_alive, 0) / mmax(1, num(r.garrison_start, 1)), 0, 1)
    if att <= 0 then return WIN_MIN end
    local ratio0 = math.sqrt(1 / p0 - 1)            -- defense / attack at the start
    return sb.raid_odds(att, ratio0 * def)
end

-- Back to a plain away mission (a load, or the fight could not go on); the abstract timer
-- resumes with `delay_sec` left. The runtime queues the proxy squad for release.
function sb.raiders_assault_reset(m, now_sec, delay_sec)
    if type(m) ~= "table" or m.mode ~= "real" then return false end
    m.mode, m.state, m.real = "abstract", "away", nil
    m.arrive_sec = num(now_sec, 0) + mmax(0, num(delay_sec, 0))
    return true
end

function sb.raiders_assault_reset_delay(tf)
    tf = num(tf, 10)
    return ASSAULT_RESET_REAL_SEC * (tf > 0 and tf or 10)
end

-- One decision for a running visible fight. obs = { epoch, player_near, proxy_alive, garrison_alive,
-- target_status ("gone" | "unoccupied" | nil) }. Returns { act = "wait" } | { act = "reset" } |
-- { act = "abstain" } | { act = "fallback", odds } | { act = "finish", result }; result "gone" is the target-vanished path.
-- Updates the progress marks on the record (plain numbers).
function sb.raiders_assault_step(m, obs, now_sec)
    if type(m) ~= "table" or m.state ~= "assault" or type(m.real) ~= "table" then return { act = "reset" } end
    obs = type(obs) == "table" and obs or {}
    local r = m.real
    now_sec = num(now_sec, 0)
    if obs.epoch ~= r.epoch then return { act = "reset" } end
    if obs.target_status == "gone" then return { act = "finish", result = "gone" } end
    local proxy, garrison = mmax(0, num(obs.proxy_alive, 0)), mmax(0, num(obs.garrison_alive, 0))
    if obs.target_status == "unoccupied" then
        -- the rival tick has eliminated the garrison; the band that did it wins, else it was someone else
        return { act = "finish", result = proxy > 0 and "success" or "gone" }
    end
    if proxy == 0 then return { act = "finish", result = "disaster" } end
    if not obs.player_near then
        r.proxy_alive, r.garrison_alive = proxy, garrison
        return { act = "fallback", odds = sb.raiders_fallback_odds(m) }
    end
    if proxy ~= num(r.proxy_alive, -1) or garrison ~= num(r.garrison_alive, -1) then
        r.proxy_alive, r.garrison_alive, r.progress_sec = proxy, garrison, now_sec
        r.engaged = true
    end
    if now_sec >= num(r.hard_sec, 0) or now_sec - num(r.progress_sec, now_sec) >= num(r.stall_sec, math.huge) then
        -- nobody ever fell: the fight never started (the squad could not reach or see the garrison). That is not
        -- the band's failure, so it is not punished: the abstract timer decides, and no second fight is tried
        if not r.engaged then return { act = "abstain" } end
        -- nothing visible is released while the garrison stands: a stalemate is a repulse
        return { act = "finish", result = garrison > 0 and "repulsed" or "success" }
    end
    return { act = "wait" }
end

-- ================================================================ runtime (phase 2)
-- Everything below talks to the game.
-- State: camp.raider_missions[id] (the shared mission record), camp.raider_state = { next_id, day,
-- spent = { [faction] = goodwill lost today, same in every camp }, missions_today, last = "text" }, and per survivor
-- surv.on_mission = mission id (+ surv.on_expedition = true, so the expedition guards keep the settler
-- away from jobs and healing), surv.raider = { wounded_until, rest_until, missions_done }.
-- Abstract missions only (design 5.2): the band is taken offline at the camp while the timer runs.

local DAY_SEC = 86400
local TICK_MS = 3000
local FALLBACK_FACTIONS = {
    "stalker", "bandit", "csky", "army", "freedom", "dolg", "ecolog", "killer", "monolith", "renegade", "greh", "isg",
}

-- the haul an outpost holds when its chest is not loaded: section, kind, value
local HAUL = {
    { "ammo_5.45x39_fmj", "ammo", 120 }, { "ammo_5.56x45_fmj", "ammo", 150 }, { "ammo_7.62x39_fmj", "ammo", 140 },
    { "medkit_army", "med", 300 }, { "bandage", "med", 40 }, { "antirad", "med", 120 },
    { "conserva", "food", 40 }, { "vodka", "food", 60 }, { "bread", "food", 25 },
    { "wpn_pm", "weapon", 900 },
}
local HAUL_TIER2 = { "wpn_ak74", "weapon", 2600 }

local function tr(id) return game.translate_string(id) end

local function tip(text, ms)
    local actor = db.actor
    if actor and sb.camp_send_tip then
        pcall(sb.camp_send_tip, actor, text, nil, "general_stalker", ms or 9000)
    end
    if sb.add_radio_feed_entry then pcall(sb.add_radio_feed_entry, "settlement", text) end
end

-- game_sec lives in the stalker_camp_builder namespace, not in _G (expeditions wrap it the same way)
local function raw_game_now() return num(sb.game_sec and sb.game_sec(), 0) end

-- the mission clock (see sb.raiders_clock_advance). MC lives in memory; its offset is saved on every camp's
-- raider_state (mc_off, mc_g) and read back from there after a load, before the first step.
local MC = { off = nil, g = nil, r = nil }
local function mc_load()
    if MC.off ~= nil then return end
    MC.off = 0
    for _, camp in pairs(sb.active_camps or {}) do
        local st = camp.raider_state
        if type(st) == "table" and st.mc_g ~= nil then MC.off, MC.g = num(st.mc_off, 0), num(st.mc_g, 0); break end
    end
end
local function game_now() mc_load(); return raw_game_now() + MC.off end
function sb.raiders_now() return game_now() end

local function rtz_on()
    return (rtz_mcm and rtz_mcm.get_config and rtz_mcm.get_config("enabled")) and true or false
end

local function mc_step()
    mc_load()
    local g = raw_game_now()
    local r = (time_global and time_global() or 0) / 1000
    local dt = MC.r and (r - MC.r) or 0
    MC.r = r
    MC.off = sb.raiders_clock_advance(MC.off, MC.g, g, dt, sb.time_factor and sb.time_factor() or 10, rtz_on())
    MC.g = g
    for _, camp in pairs(sb.active_camps or {}) do
        local st = type(camp.raider_state) == "table" and camp.raider_state or nil
        if not st then st = {}; camp.raider_state = st end
        st.mc_off, st.mc_g = MC.off, MC.g
    end
end

-- mission seconds per real second: the mission clock moves at the settlement's nominal factor (the floored one),
-- whatever Real Time Zones does to the game clock (see sb.raiders_clock_advance)
local function game_time_factor()
    local tf = sb.time_factor and sb.time_factor() or 10
    return tf > 0 and tf or 10
end

local function surv_of(camp, npc_id)
    local s = camp and camp.survivors
    if not s then return nil end
    return s[npc_id] or s[tonumber(npc_id) or -1] or s[tostring(npc_id)]
end

local function raider_state(camp)
    local st = camp.raider_state
    if type(st) ~= "table" then st = {}; camp.raider_state = st end
    local day = mfloor(raw_game_now() / DAY_SEC)
    if st.day ~= day then st.day = day; st.spent = {}; st.missions_today = 0 end
    st.spent = st.spent or {}
    st.next_id = st.next_id or 1
    return st
end

-- the pause line the PDA already has: why a raider is not available (label, detail) or nil
function sb.raiders_pause_reason(surv, camp)
    if type(surv) ~= "table" then return nil end
    if surv.on_mission then
        -- the time left is shown the way an expedition shows its own (game seconds shown as real time)
        local m = camp and camp.raider_missions and camp.raider_missions[surv.on_mission]
        local left = sb.raiders_mission_remaining(m, game_now())
        if left and sb.format_expedition_time and m.state ~= "assault" then
            local t = sb.format_expedition_time(left, game_time_factor())
            if m.state == "returning" then
                return string.format(tr("st_homestead_raider_recalling_left"), t), string.format(tr("st_homestead_raider_recalling_d"), t)
            end
            return string.format(tr("st_homestead_raider_on_mission_left"), t), string.format(tr("st_homestead_raider_on_mission_d2"), t)
        end
        if m and m.state == "returning" then
            return tr("st_homestead_raider_recalling"), tr("st_homestead_raider_recalling_d0")
        end
        if m and m.state == "assault" then
            return tr("st_homestead_raider_in_field"), tr("st_homestead_raider_in_field_d")
        end
        return tr("st_homestead_raider_on_mission"), tr("st_homestead_raider_on_mission_d")
    end
    -- wounded and cooling down both show a live countdown on the same clock as the raid timers
    local kind, left = sb.raiders_survivor_timer(surv, game_now())
    if kind == "wounded" then
        local t = sb.raiders_timer_text(left, game_time_factor())
        return string.format(tr("st_homestead_raider_wounded_left"), t), string.format(tr("st_homestead_raider_wounded_d2"), t)
    end
    if type(surv.raider) == "table" and surv.raider.defending then
        return tr("st_homestead_raider_defending"), tr("st_homestead_raider_defending_d")
    end
    if kind == "resting" then
        local t = sb.raiders_timer_text(left, game_time_factor())
        return string.format(tr("st_homestead_raider_resting_left"), t), string.format(tr("st_homestead_raider_resting_d2"), t)
    end
    return nil
end

local function bring_home(npc_id, surv)
    surv.on_mission = nil
    surv.on_expedition = nil
    local se = alife_object(npc_id)
    if se and not se:can_switch_online() then
        pcall(utils_obj.switch_online, npc_id)
        if sb.allow_home_squad_online then pcall(sb.allow_home_squad_online, npc_id, true) end
    end
end

local function take_away(npc_id, surv, mission_id)
    surv.on_mission = mission_id
    surv.on_expedition = true
    local sim = alife()
    if sim and alife_object(npc_id) then
        pcall(sim.set_switch_online, sim, npc_id, false)
        pcall(sim.set_switch_offline, sim, npc_id, true)
        if sb.allow_home_squad_online then pcall(sb.allow_home_squad_online, npc_id, false) end
    end
end

-- ---------------------------------------------------------------- targets

local function squad_alive_count(squad)
    local n = 0
    if squad and sb.safe_squad_members then
        for k in sb.safe_squad_members(squad) do
            local se = k.object or (k.id and alife_object(k.id))
            if se and se.alive and se:alive() then n = n + 1 end
        end
    end
    return n
end

local function faction_goodwill(faction)
    local ok, v = pcall(relation_registry.community_goodwill, faction, db.actor:id())
    return ok and num(v, 0) or 0
end

local function target_info(key, rc, now_sec)
    local squad = rc.squad_id and alife_object(rc.squad_id)
    local busy = false
    for _, c in pairs(sb.active_camps or {}) do
        for _, m in pairs(c.raider_missions or {}) do
            if m.target_key == key then busy = true end
        end
    end
    local story = false
    if squad and sb.squad_has_story_npc then story = sb.squad_has_story_npc(squad) and true or false end
    return {
        occupied = squad ~= nil and rc.status == nil and rc.faction ~= nil,
        faction = rc.faction,
        story = story,
        nest = rc.status == "mutant_nest",
        busy = busy,
        on_cooldown = num(rc.raid_cooldown_until, 0) > now_sec,
        cooldown_left = mmax(0, num(rc.raid_cooldown_until, 0) - now_sec),
        friendly = rc.faction ~= nil and sb.raiders_is_friendly(faction_goodwill(rc.faction)),
    }, squad
end

local function distance_to(hub_obj, rc)
    if not (hub_obj and rc.position) then return 1500 end
    local p = hub_obj.position
    local dx, dz = p.x - rc.position.x, p.z - rc.position.z
    local d = math.sqrt(dx * dx + dz * dz)
    if rc.level and rc.level ~= level.name() then d = d + 1500 end
    return d
end

-- the nearest rival camp this camp may raid now (temporary, until the Outposts tab picks one)
local function pick_target(hub_id, info, now_sec)
    local hub_obj = alife_object(hub_id)
    local best, best_d, best_squad, best_key
    for key, rc in pairs(sb.rival_camps or {}) do
        if type(rc) == "table" and rc.chest_id then
            local t, squad = target_info(key, rc, now_sec)
            if sb.raiders_can_send(info, t) then
                local d = distance_to(hub_obj, rc)
                if not best_d or d < best_d then best, best_d, best_squad, best_key = rc, d, squad, key end
            end
        end
    end
    return best, best_key, best_d, best_squad
end

-- ---------------------------------------------------------------- send

local BAND_MAX = 3

-- the free raiders of a camp (up to BAND_MAX, the lead first when given) as survivors and ids;
-- sorted so the PDA preview and the send pick the same band
local function ready_band(camp, lead_id, now_sec)
    local ids = {}
    for id, s in pairs(camp.survivors or {}) do
        local nid = tonumber(id) or id
        if nid ~= lead_id and s.job == "raider" and sb.raiders_survivor_ready(s, now_sec) then ids[#ids + 1] = nid end
    end
    table.sort(ids, function(a, b) return tostring(a) < tostring(b) end)
    local band, out = {}, {}
    if lead_id then band[1] = surv_of(camp, lead_id); out[1] = lead_id end
    for _, nid in ipairs(ids) do
        if #band < BAND_MAX then band[#band + 1] = surv_of(camp, nid); out[#out + 1] = nid end
    end
    return band, out
end

local function guard_count(camp)
    local n = 0
    for _, s in pairs(camp.survivors or {}) do
        if s.job == "guard" then n = n + 1 end
    end
    return n
end

local function band_odds(band, rc, squad)
    local members = {}
    for i, s in ipairs(band) do members[i] = { rank = s.tier or 0 } end
    return sb.raid_odds(sb.raiders_band_strength(members),
        sb.raiders_defender_strength(squad_alive_count(squad), rc.tier or 1, 0))
end

-- Player-directed send. npc_id = the raider picked on the Job page (nil: the first free raiders go);
-- key = the outpost chosen on the Outposts tab (nil: the nearest valid one). Up to three free raiders go.
function sb.raiders_send(hub_id, camp, npc_id, key)
    if not (camp and camp.survivors and db.actor) then return false end
    local now_sec = game_now()
    local st = raider_state(camp)
    local lead_id
    if npc_id ~= nil then
        local lead = surv_of(camp, npc_id)
        if not lead or lead.job ~= "raider" then return false end
        local ok, why = sb.raiders_survivor_ready(lead, now_sec)
        if not ok then
            local msg = tr("st_homestead_raider_cannot_" .. why)
            local kind, left = sb.raiders_survivor_timer(lead, now_sec)
            if kind == why then
                msg = msg .. " " .. string.format(tr("st_homestead_raider_time_left"), sb.raiders_timer_text(left, game_time_factor()))
            end
            tip(msg)
            return false
        end
        lead_id = tonumber(npc_id) or npc_id
    end
    local band, ids = ready_band(camp, lead_id, now_sec)
    local info = { guards = guard_count(camp), ready = #band, missions_today = st.missions_today or 0,
        raid_active = camp.active_raid ~= nil }
    local rc, dist, squad
    if key ~= nil then
        rc = sb.rival_camps and sb.rival_camps[key]
        if type(rc) ~= "table" then tip(tr("st_homestead_raider_no_target")); return false end
        local t
        t, squad = target_info(key, rc, now_sec)
        local ok, why = sb.raiders_can_send(info, t)
        if not ok then tip(tr("st_pda_raid_why_" .. why)); return false end
        dist = distance_to(alife_object(hub_id), rc)
    else
        rc, key, dist, squad = pick_target(hub_id, info, now_sec)
    end
    if not rc then
        -- say why: the camp's own limits first (no guard, daily cap), else there is simply nothing to hit
        local _, reason = sb.raiders_can_send(info, { occupied = true, faction = "stalker" })
        tip(tr(reason == "no_guard" and "st_homestead_raider_cannot_no_guard"
            or reason == "daily" and "st_homestead_raider_cannot_daily"
            or reason == "raid" and "st_homestead_raider_cannot_raid"
            or "st_homestead_raider_no_target"))
        return false
    end

    local odds = band_odds(band, rc, squad)
    local id = st.next_id; st.next_id = id + 1
    local m = sb.raiders_new_mission(id, key, rc.level, rc.faction, ids, now_sec, sb.raiders_mission_duration(dist), odds)
    camp.raider_missions = camp.raider_missions or {}
    camp.raider_missions[id] = m
    st.missions_today = info.missions_today + 1
    for i, s in ipairs(band) do take_away(ids[i], s, id) end
    tip(string.format(tr("st_homestead_raider_sent"), #band, tr(rc.faction), mfloor(odds * 100 + 0.5)))
    return true
end

-- the Job page sends a settler who already holds the Raider job; nil when they are not a raider
-- (the caller then assigns the job as usual), else whether a mission left
function sb.raiders_send_for(npc_id)
    for hub_id, camp in pairs(sb.active_camps or {}) do
        local s = surv_of(camp, npc_id)
        if s then
            if s.job ~= "raider" then return nil end
            if s.on_mission then return false end
            return sb.raiders_send(hub_id, camp, npc_id)
        end
    end
    return nil
end

-- ---------------------------------------------------------------- resolve

-- clearing a camp: release its garrison squads; the rival tick then runs the elimination itself
local function clear_garrison(rc)
    local ids = { rc.squad_id }
    for _, x in ipairs(rc.extra_squad_ids or {}) do ids[#ids + 1] = x end
    for _, sid in ipairs(ids) do
        local sq = alife_object(sid)
        if sq then pcall(sb.safe_alife_release or alife_release, sq) end
    end
end

local function haul_items(tier)
    local items = {}
    for _ = 1, 6 + 3 * tier do
        local h = HAUL[math.random(#HAUL)]
        items[#items + 1] = { sec = h[1], kind = h[2], value = h[3] }
    end
    if tier >= 2 then
        items[#items + 1] = { sec = HAUL_TIER2[1], kind = HAUL_TIER2[2], value = HAUL_TIER2[3] }
    end
    return items
end

-- the daily goodwill cap is per player, not per camp: every camp's record keeps the same running totals
-- (the largest seen), so several camps cannot each spend a full cap
local function spent_today()
    local merged = {}
    for _, c in pairs(sb.active_camps or {}) do
        for f, v in pairs(raider_state(c).spent) do merged[f] = mmax(merged[f] or 0, v) end
    end
    return merged
end

local function share_spent(merged)
    for _, c in pairs(sb.active_camps or {}) do
        local sp = raider_state(c).spent
        for f, v in pairs(merged) do sp[f] = v end
    end
end

local function own_faction()
    local own = sb.get_player_faction and sb.get_player_faction()
    return type(own) == "string" and (string.gsub(own, "^actor_", "")) or nil
end

-- the running mission against an outpost, and the camp it left from
function sb.raiders_mission_for(key)
    for hub_id, c in pairs(sb.active_camps or {}) do
        for _, m in pairs(c.raider_missions or {}) do
            if m.target_key == key then return m, hub_id end
        end
    end
    return nil
end

-- the PDA's explanation under a blocked Raid button: the reason, and for the reasons a timer or a list explains,
-- the lines saying who is held back and for how long (all times on the mission clock, shown as real time)
--   { state = "blocked", reason, lines = { text, ... } }
local function blocked_status(reason, camp, t, now_sec)
    local st = { state = "blocked", reason = reason, lines = {} }
    local tf = game_time_factor()
    if reason == "no_raider" and camp then
        local list = sb.raiders_blockers(camp.survivors, now_sec)
        if #list == 0 then
            st.lines[1] = tr("st_pda_raid_blk_none")
        else
            st.lines = sb.raiders_blocker_lines(list, tf, {
                wounded = tr("st_pda_raid_blk_wounded"), resting = tr("st_pda_raid_blk_resting"),
                busy = tr("st_pda_raid_blk_busy"), defending = tr("st_pda_raid_blk_defending"),
                no_weapon = tr("st_pda_raid_blk_no_weapon"), no_ammo = tr("st_pda_raid_blk_no_ammo"),
                more = tr("st_pda_raid_blk_more"), next = tr("st_pda_raid_blk_next"),
            }, 3)
        end
    elseif reason == "cooldown" and t and (t.cooldown_left or 0) > 0 then
        st.lines[1] = string.format(tr("st_pda_raid_blk_cooldown"), sb.raiders_timer_text(t.cooldown_left, tf))
    elseif reason == "daily" and camp then
        st.lines[1] = string.format(tr("st_pda_raid_blk_daily"), raider_state(camp).missions_today or 0,
            num(cfgv("raiders_max_per_day"), 3))
    elseif reason == "no_guard" then
        st.lines[1] = tr("st_pda_raid_blk_no_guard")
    end
    return st
end

-- What the Raid button on an outpost card shows. prefer_hub = the settlement selected in the PDA.
--   { state = "away", hub_id, band, odds, eta }  a raid against it is running
--   { state = "ready", hub_id, band, odds, faction, friendly, loss }  it can be sent; odds and loss are the preview
--   { state = "blocked", reason }  reason is a raiders_can_send key
function sb.raiders_outpost_status(key, prefer_hub)
    local rc = sb.rival_camps and sb.rival_camps[key]
    if type(rc) ~= "table" then return { state = "blocked", reason = "empty" } end
    local now_sec = game_now()
    local m, mhub = sb.raiders_mission_for(key)
    if m then
        return { state = "away", hub_id = mhub, band = #m.raider_ids, odds = m.odds,
            returning = m.state == "returning", field = m.state == "assault", raid = sb.active_camps[mhub].active_raid ~= nil,
            eta = mmax(0, m.arrive_sec - now_sec) / game_time_factor() }
    end
    local t, squad = target_info(key, rc, now_sec)
    local order = {}
    if prefer_hub and sb.active_camps and sb.active_camps[prefer_hub] then order[1] = prefer_hub end
    for hub_id in pairs(sb.active_camps or {}) do
        if hub_id ~= prefer_hub then order[#order + 1] = hub_id end
    end
    local first_why, first_camp
    for _, hub_id in ipairs(order) do
        local camp = sb.active_camps[hub_id]
        local band = ready_band(camp, nil, now_sec)
        local info = { guards = guard_count(camp), ready = #band,
            missions_today = raider_state(camp).missions_today or 0, raid_active = camp.active_raid ~= nil }
        local ok, why = sb.raiders_can_send(info, t)
        if ok then
            return { state = "ready", hub_id = hub_id, band = #band, odds = band_odds(band, rc, squad),
                faction = rc.faction, friendly = t.friendly,
                loss = sb.raiders_faction_loss(rc.faction, t.friendly, spent_today(), own_faction()) }
        end
        if not first_why then first_why, first_camp = why, camp end
    end
    return blocked_status(first_why or "no_raider", first_camp, t, now_sec)
end

local function apply_goodwill(faction, friendly)
    local own = own_faction()
    local list = FALLBACK_FACTIONS
    pcall(function()
        local t = game_relations and game_relations.factions_table
        if type(t) == "table" and #t > 0 then list = t end
    end)
    local allies = {}
    for _, f in ipairs(list) do
        local friends = false
        pcall(function()
            if game_relations and game_relations.is_factions_friends then
                friends = game_relations.is_factions_friends(faction, f) and true or false
            else
                local rel = relation_registry.community_relation(faction, f)
                friends = rel ~= nil and rel >= 500
            end
        end)
        if friends and f ~= faction then allies[#allies + 1] = f end
    end
    local spent = spent_today()
    local plan = sb.raiders_goodwill_plan({ faction = faction, own = own, friendly = friendly, allies = allies,
        spent = spent })
    local hit = {}
    for _, p in ipairs(plan) do
        if pcall(relation_registry.change_community_goodwill, p.faction, db.actor:id(), p.delta) then
            if p.delta < 0 then spent[p.faction] = (spent[p.faction] or 0) - p.delta end
            hit[#hit + 1] = p.faction
        end
    end
    share_spent(spent)
    return hit
end

local function remove_dead_raider(camp, npc_id)
    camp.survivors[npc_id] = nil
    camp.survivors[tonumber(npc_id) or -1] = nil
    if sb.settler_lookup then sb.settler_lookup[npc_id] = nil end
    local se = alife_object(npc_id)
    if se then pcall(sb.safe_alife_release or alife_release, se) end
end

-- returns the raiders home; wounded ones get the wounded timer, dead ones leave the camp
local function return_band(hub_id, camp, m, cas, now_sec)
    local home, dead, wounded = {}, {}, {}
    for _, i in ipairs(cas.dead) do dead[i] = true end
    for _, i in ipairs(cas.wounded) do wounded[i] = true end
    for i, npc_id in ipairs(m.raider_ids) do
        local s = surv_of(camp, npc_id)
        if s then
            if dead[i] then
                remove_dead_raider(camp, npc_id)
            else
                bring_home(npc_id, s)
                s.raider = type(s.raider) == "table" and s.raider or {}
                s.raider.missions_done = (s.raider.missions_done or 0) + 1
                s.raider.rest_until = sb.raiders_rest_until(now_sec, nil, game_time_factor())
                if wounded[i] then s.raider.wounded_until = sb.raiders_wounded_until(now_sec, nil, game_time_factor()) end
                home[#home + 1] = s
            end
        end
    end
    return home
end

local function pay_success(hub_id, camp, m, rc, home)
    local tier = rc.tier or 1
    clear_garrison(rc)
    local n, bounty = 0, 0
    -- once per mission: an abstract and a visible resolver share this path
    if sb.raiders_mission_claim(m, "loot") then
        local split = sb.raiders_loot_split(haul_items(tier))
        for _, it in ipairs(split.taken) do
            if sb.deposit_item_to_camp and pcall(sb.deposit_item_to_camp, hub_id, camp, it.sec, false, tier, nil, nil, nil, true) then
                n = n + 1
            end
        end
        bounty = sb.raiders_bounty(tier)
        if db.actor and bounty > 0 then pcall(db.actor.give_money, db.actor, bounty) end
        local cut = sb.raiders_cut(split.taken_value + bounty, false)
        if #home > 0 and cut > 0 and sb.prosper_credit then
            for _, s in ipairs(home) do sb.prosper_credit(s, mfloor(cut / #home)) end
        end
    end
    local hit = {}
    if sb.raiders_mission_claim(m, "goodwill") then
        hit = apply_goodwill(m.faction, sb.raiders_is_friendly(faction_goodwill(m.faction)))
    end
    local text = string.format(tr("st_homestead_raider_success"), tr(m.faction), n, bounty)
    if #hit > 0 then text = text .. " " .. string.format(tr("st_homestead_raider_goodwill"), table.concat(hit, ", ")) end
    return text
end

-- forced = the result a visible fight already decided ("success", "repulsed", "disaster" or "gone"); the abstract
-- roll and the live-target check are skipped, everything after (casualties, loot, goodwill) is the same path
local function resolve_mission(hub_id, camp, id, m, forced)
    local st = raider_state(camp)
    local now_sec = game_now()
    local rc = sb.rival_camps and sb.rival_camps[m.target_key]
    local squad = rc and rc.squad_id and alife_object(rc.squad_id)
    local target_ok = rc ~= nil and squad ~= nil and rc.faction == m.faction
    local result
    if forced then
        result = rc and forced or "gone"
    else
        result = target_ok and sb.raid_outcome(m.odds, math.random(), math.random()) or "gone"
    end

    local rolls = {}
    for i = 1, #m.raider_ids do rolls[i] = math.random() end
    local cas = sb.raid_casualties(result == "gone" and "success" or result, #m.raider_ids, rolls)
    local home = return_band(hub_id, camp, m, cas, now_sec)

    local text
    if result == "gone" then
        text = tr("st_homestead_raider_target_gone")
    elseif result == "success" then
        text = pay_success(hub_id, camp, m, rc, home)
    elseif result == "repulsed" then
        text = string.format(tr("st_homestead_raider_repulsed"), tr(m.faction))
    else
        text = string.format(tr("st_homestead_raider_disaster"), tr(m.faction), #cas.dead)
    end
    if rc and (target_ok or forced) and result ~= "success" and result ~= "gone" then
        rc.raid_cooldown_until = now_sec + 24 * 3600
    end
    sb.raiders_mission_finish(m, result == "gone" and "repulsed" or result)
    camp.raider_missions[id] = nil
    st.last = text
    tip(text, 12000)
end

-- ---------------------------------------------------------------- visible assault (phase 5, runtime)
-- The settlers stay offline as in an abstract mission; a proxy sim squad plays the band in front of the player
-- (docs/design/raiders.md, section 21). m.real holds plain numbers and the squad id, nothing else.

-- changes on every load (actor_on_first_update), so a fight found with another epoch is a fight from before it
local function new_epoch() return ((os.time and os.time() or 0) % 1000000) * 1000 + math.random(0, 999) end
sb.raiders_epoch = new_epoch()

local function garrison_ids(rc)
    local ids = {}
    if rc.squad_id then ids[1] = rc.squad_id end
    for _, x in ipairs(type(rc.extra_squad_ids) == "table" and rc.extra_squad_ids or {}) do ids[#ids + 1] = x end
    return ids
end

local function garrison_alive(rc)
    local n = 0
    for _, sid in ipairs(garrison_ids(rc)) do n = n + squad_alive_count(alife_object(sid)) end
    return n
end

-- the proxy squad, only when the id still names a squad of the recorded section (ids are reused)
local function proxy_squad(r)
    local se = type(r) == "table" and r.squad_id and alife_object(r.squad_id)
    if se and se.squad_members and se.section_name and se:section_name() == r.section then return se end
    return nil
end

local function release_proxy(r)
    local se = proxy_squad(r)
    if not se then return end
    local rel = sb.safe_alife_release or alife_release
    local ids = {}
    for k in sb.safe_squad_members(se) do if k.id then ids[#ids + 1] = k.id end end
    for _, nid in ipairs(ids) do
        local npc = alife_object(nid)
        if npc then pcall(rel, npc) end
    end
    pcall(rel, se)
end

-- queue a proxy squad for release; due_sec = earliest, it then waits for the player to look away, up to hard_sec
local function queue_proxy_release(camp, r, due_sec, hard_sec)
    if type(r) ~= "table" or not r.squad_id then return end
    local st = raider_state(camp)
    st.cleanup = st.cleanup or {}
    st.cleanup[#st.cleanup + 1] = { squad_id = r.squad_id, section = r.section, level = r.level,
        due_sec = due_sec, hard_sec = hard_sec }
end

local function queue_proxy_now(camp, r)
    local now_sec = game_now()
    queue_proxy_release(camp, r, now_sec, now_sec)
end

local function process_cleanup(camp, now_sec)
    local list = camp.raider_state and camp.raider_state.cleanup
    if type(list) ~= "table" then return end
    for i = #list, 1, -1 do
        local e = list[i]
        local se = proxy_squad(e)
        if not se then
            table.remove(list, i)
        elseif now_sec >= num(e.due_sec, 0) then
            local near = e.level == level.name() and sb.is_player_near and sb.is_player_near(e.level, se.position)
            if not near or now_sec >= num(e.hard_sec, 0) then
                -- gone next tick (the entry then leaves above); a release that keeps failing is given up on
                e.tries = (e.tries or 0) + 1
                pcall(release_proxy, e)
                if e.tries >= 5 then table.remove(list, i) end
            end
        end
    end
end

-- a mission leaves the camp's list: its proxy squad goes with it
local function drop_mission(camp, id, m)
    if m and m.real then queue_proxy_now(camp, m.real) end
    camp.raider_missions[id] = nil
end

local function proxy_faction(rc)
    local f = own_faction()
    if not f or NOT_A_FACTION[f] or f == rc.faction then f = (rc.faction == "stalker") and "dolg" or "stalker" end
    return f
end

local function proxy_section(faction, band)
    local sum = 0
    for _, s in ipairs(band) do sum = sum + num(s.tier, 0) end
    local avg = #band > 0 and sum / #band or 0
    local tier = avg < 1.5 and "_novice" or avg < 3 and "_advanced" or "_veteran"
    local sec = sb.get_dynamic_squad_section_for_faction(faction, tier)
    if not (ini_sys and sec and ini_sys:section_exist(sec)) then sec = sb.get_dynamic_squad_section_for_faction(faction) end
    return sec
end

-- a ground spot 65-105 m from the outpost on the player's side, at least 25 m from the player
local function assault_spawn_point(rc)
    local ap = db.actor:position()
    local base = math.atan2(ap.z - rc.position.z, ap.x - rc.position.x)
    local test_p = vector()
    for _, off in ipairs({ 0, 0.5, -0.5, 1.0, -1.0, 1.6, -1.6 }) do
        for _, d in ipairs({ 85, 65, 105 }) do
            local a = base + off
            test_p:set(rc.position.x + d * math.cos(a), rc.position.y, rc.position.z + d * math.sin(a))
            local lvi, p = sb.get_ground_vertex_and_pos(test_p, rc.position.y, 6.0)
            if lvi and p and p:distance_to(ap) >= 25 then
                local gvi = level.cross_table and level.cross_table() and level.cross_table():vertex(lvi):game_vertex_id()
                    or db.actor:game_vertex_id()
                return p, lvi, gvi
            end
        end
    end
    return nil
end

-- the band arrives while the player is at the outpost: play the fight. true when the squad is out
local function start_assault(camp, m, rc, now_sec)
    if not (rc.position and rc.smart_name and rc.status == nil and rc.faction == m.faction and db.actor
        and m.target_level == level.name() and sb.is_player_near and sb.is_player_near(m.target_level, rc.position)
        and SIMBOARD and SIMBOARD.smarts_by_names and SIMBOARD.smarts_by_names[rc.smart_name]) then
        return false
    end
    local g = garrison_alive(rc)
    if g < 1 then return false end
    local band = {}
    for _, nid in ipairs(m.raider_ids) do band[#band + 1] = surv_of(camp, nid) or {} end
    local pos, lvi, gvi = assault_spawn_point(rc)
    if not pos then return false end
    local sec = proxy_section(proxy_faction(rc), band)
    local squad = sec and sb.create_squad_at_pos(sec, pos, lvi, gvi, true)
    if not squad then return false end
    local ids = {}
    for k in sb.safe_squad_members(squad) do if k.id then ids[#ids + 1] = k.id end end
    -- on record at once: whatever fails below, the squad is known and gets released with the mission
    sb.raiders_assault_begin(m, now_sec, game_time_factor(), { squad_id = squad.id, section = sec,
        epoch = sb.raiders_epoch, proxy = mmin(#ids, #m.raider_ids), garrison = g })
    m.real.level = m.target_level
    if #ids == 0 then
        queue_proxy_now(camp, m.real)
        sb.raiders_assault_reset(m, now_sec, 0)
        return false
    end
    -- as many fighters as raiders: release the surplus members
    for i = #m.raider_ids + 1, #ids do
        local extra = alife_object(ids[i])
        if extra then pcall(sb.safe_alife_release or alife_release, extra) end
    end
    -- a saved string: the simulation sends a squad to a smart terrain, never to another squad
    squad.scripted_target = rc.smart_name
    tip(string.format(tr("st_homestead_raider_assault_start"), #m.raider_ids, tr(m.faction)), 12000)
    return true
end

-- both sides hostile to each other, for the members that are online right now
local function enforce_hostility(squad, rc)
    local mine, theirs = {}, {}
    for k in sb.safe_squad_members(squad) do
        local o = k.id and level.object_by_id(k.id)
        if o then mine[#mine + 1] = o end
    end
    for _, sid in ipairs(garrison_ids(rc)) do
        local gs = alife_object(sid)
        if gs then
            for k in sb.safe_squad_members(gs) do
                local o = k.id and level.object_by_id(k.id)
                if o then theirs[#theirs + 1] = o end
            end
        end
    end
    for _, a in ipairs(mine) do
        pcall(a.set_relation, a, game_object.friend, db.actor)
        for _, b in ipairs(theirs) do
            pcall(a.set_relation, a, game_object.enemy, b)
            pcall(b.set_relation, b, game_object.enemy, a)
        end
    end
end

local function target_status(rc, m)
    if type(rc) ~= "table" then return "gone" end
    if rc.status == "unoccupied" then return "unoccupied" end
    if rc.status ~= nil or rc.faction ~= m.faction then return "gone" end
    return nil
end

-- one look at a running fight; every exit goes through the pure step and the shared resolver
local function assault_tick(hub_id, camp, id, m, now_sec)
    local rc = sb.rival_camps and sb.rival_camps[m.target_key]
    local r = m.real
    local squad = proxy_squad(r)
    local act = sb.raiders_assault_step(m, {
        epoch = sb.raiders_epoch,
        target_status = target_status(rc, m),
        proxy_alive = squad and squad_alive_count(squad) or 0,
        garrison_alive = rc and garrison_alive(rc) or 0,
        player_near = rc and rc.position and sb.is_player_near and sb.is_player_near(m.target_level, rc.position) or false,
    }, now_sec)
    if act.act == "wait" then
        if squad and rc then enforce_hostility(squad, rc) end
    elseif act.act == "reset" then
        -- after a load, or with nothing to play: a plain away mission again, which may start over
        if r then queue_proxy_now(camp, r) end
        sb.raiders_assault_reset(m, now_sec, sb.raiders_assault_reset_delay(game_time_factor()))
    elseif act.act == "abstain" then
        queue_proxy_now(camp, r)
        sb.raiders_assault_reset(m, now_sec, sb.raiders_assault_reset_delay(game_time_factor()))
        m.no_visible = true
    elseif act.act == "fallback" then
        -- the player left: the abstract roll, with what is left of each side
        queue_proxy_now(camp, r)
        m.odds = act.odds
        sb.raiders_assault_reset(m, now_sec, 0)
        resolve_mission(hub_id, camp, id, m)
    else
        local won = act.result == "success"
        queue_proxy_release(camp, r, now_sec + (won and num(r.linger_sec, 0) or 0), now_sec + 600 * game_time_factor())
        m.real = nil
        resolve_mission(hub_id, camp, id, m, act.result)
    end
end

-- ---------------------------------------------------------------- recall (phase 4)

-- Raiders of the camp that are out on a raid, and those already on their way back after a recall.
function sb.raiders_recall_status(camp)
    local away, returning, eta = 0, 0, nil
    local now_sec = game_now()
    for _, m in pairs(camp and camp.raider_missions or {}) do
        if m.state == "away" or m.state == "assault" then
            away = away + #m.raider_ids
        elseif m.state == "returning" then
            returning = returning + #m.raider_ids
            local left = mmax(0, num(m.arrive_sec, now_sec) - now_sec) / game_time_factor()
            eta = eta and mmin(eta, left) or left
        end
    end
    local ok, why = sb.raiders_recall_check(away, returning)
    return { ok = ok, reason = why, away = away, returning = returning, eta = eta,
        raid = camp ~= nil and camp.active_raid ~= nil }
end

-- Ends away missions early: no loot, no goodwill, no cooldown. The band is flagged "returning" and reaches the
-- camp after RECALL_DELAY_REAL_SEC; the flag lives in the mission record, so a save/load in between loses nothing
-- (raiders_process finishes it). how = "auto" (the MCM option fired) or nil (the player); only_id limits it
-- to one mission. Returns the number of raiders recalled.
function sb.raiders_recall(hub_id, camp, how, only_id)
    if not (camp and camp.raider_missions) then return 0 end
    local now_sec = game_now()
    local delay = sb.raiders_recall_delay(game_time_factor())
    local n = 0
    for id, m in pairs(camp.raider_missions) do
        local real = m.real
        if (only_id == nil or id == only_id) and sb.raiders_mission_recall(m, now_sec, delay) then
            n = n + #m.raider_ids
            queue_proxy_now(camp, real)
        end
    end
    if n > 0 then
        if how == "auto" then
            tip(string.format(tr("st_homestead_raider_recall_auto"), n), 12000)
        else
            tip(string.format(tr(camp.active_raid and "st_homestead_raider_recall_sent_raid" or "st_homestead_raider_recall_sent"),
                n, sb.raiders_eta_text(delay / game_time_factor())), 12000)
        end
    end
    return n
end

-- the recall state of a raider on the Survivors tab: nil when they are not on a mission, else
-- { ok, reason, hub_id, camp, mission } for the mission they are on
function sb.raiders_recall_for(npc_id)
    for hub_id, camp in pairs(sb.active_camps or {}) do
        local s = surv_of(camp, npc_id)
        if s then
            local m = s.on_mission and camp.raider_missions and camp.raider_missions[s.on_mission]
            if not m then return nil end
            local away = m.state == "away" or m.state == "assault"
            return { ok = away, reason = not away and "returning" or nil, hub_id = hub_id, camp = camp, mission = m.id }
        end
    end
    return nil
end

-- the band of a recalled mission reaches camp; with an attack under way they arrive as defenders
local function finish_recall(camp, id, m)
    local raid = camp.active_raid ~= nil
    local n = 0
    for _, npc_id in ipairs(m.raider_ids) do
        local s = surv_of(camp, npc_id)
        if s then
            bring_home(tonumber(npc_id) or npc_id, s)
            if raid then
                s.raider = type(s.raider) == "table" and s.raider or {}
                s.raider.defending = true
            end
            n = n + 1
        end
    end
    camp.raider_missions[id] = nil
    if n > 0 then
        tip(string.format(tr(raid and "st_homestead_raider_recall_home" or "st_homestead_raider_recall_home_calm"), n), 12000)
    end
end

-- an attack that is over sends its defenders back to normal duty
local function stand_down(camp)
    local n = 0
    for _, s in pairs(camp.survivors or {}) do
        if type(s.raider) == "table" and s.raider.defending then
            s.raider.defending = nil
            n = n + 1
        end
    end
    if n > 0 then tip(tr("st_homestead_raider_stand_down")) end
end

-- a raider who changes job while away leaves the mission (no loot, no goodwill)
function sb.raiders_cancel_for(hub_id, npc_id)
    local camp = sb.active_camps and sb.active_camps[hub_id]
    local s = surv_of(camp, npc_id)
    if not s then return end
    local nid = tonumber(npc_id) or npc_id
    local m = camp.raider_missions and camp.raider_missions[s.on_mission]
    bring_home(nid, s)
    if m then
        for i = #m.raider_ids, 1, -1 do
            if m.raider_ids[i] == nid then table.remove(m.raider_ids, i) end
        end
        if #m.raider_ids == 0 then drop_mission(camp, m.id, m) end
    end
end

-- resolve due missions; free settlers whose mission record is gone (an old save, a cancelled mission)
function sb.raiders_process()
    local now_sec = game_now()
    for hub_id, camp in pairs(sb.active_camps or {}) do
        -- an attack on the camp with the option on: every band still away comes home to defend
        -- (recalling is idempotent: a recalled mission is no longer "away")
        if camp.active_raid and cfgv("raiders_auto_recall") == true then
            pcall(sb.raiders_recall, hub_id, camp, "auto")
        end
        for id, m in pairs(camp.raider_missions or {}) do
            if sb.raiders_recall_due(m, now_sec) then
                if not pcall(finish_recall, camp, id, m) then drop_mission(camp, id, m) end
            elseif m.state == "assault" then
                if not pcall(assault_tick, hub_id, camp, id, m, now_sec) then drop_mission(camp, id, m) end
            elseif sb.raiders_mission_due(m, now_sec) then
                if not pcall(resolve_mission, hub_id, camp, id, m) then drop_mission(camp, id, m) end
            elseif sb.raiders_assault_start_due(m, now_sec) then
                local rc = sb.rival_camps and sb.rival_camps[m.target_key]
                if rc and now_sec >= num(m.assault_retry_sec, 0) then
                    -- a start that does not happen (no spot, no smart terrain) is retried later, not every tick
                    m.assault_retry_sec = now_sec + 15 * game_time_factor()
                    pcall(start_assault, camp, m, rc, now_sec)
                end
            end
        end
        for _, s in pairs(camp.survivors or {}) do
            if type(s) == "table" and type(s.raider) == "table" then sb.raiders_clamp_timers(s.raider, now_sec, nil, game_time_factor()) end
        end
        process_cleanup(camp, now_sec)
        if not camp.active_raid then stand_down(camp) end
        for npc_id, s in pairs(camp.survivors or {}) do
            if s.on_mission and not (camp.raider_missions and camp.raider_missions[s.on_mission]) then
                bring_home(tonumber(npc_id) or npc_id, s)
            end
        end
    end
end

local next_tick_tg = 0
local function on_update()
    local tg = time_global()
    if tg < next_tick_tg then return end
    next_tick_tg = tg + TICK_MS
    pcall(mc_step)
    pcall(sb.raiders_process)
end

-- every load and level change: a fight still on record belongs to the session before
local function on_first_update()
    sb.raiders_epoch = new_epoch()
end

function on_game_start()
    RegisterScriptCallback("actor_on_update", on_update)
    RegisterScriptCallback("actor_on_first_update", on_first_update)
end
