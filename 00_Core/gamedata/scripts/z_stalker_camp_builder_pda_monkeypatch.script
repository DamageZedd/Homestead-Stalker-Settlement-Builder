-- Homestead: Settlement tab integration for Standard 2D and Interactive 3D PDA
-- Monkeypatches CustomPDAX to add slot 8 (Settlement) to the left-rail for non-MAC users.
-- When clicked, it redirects to the standalone Settlements subdialog.

local function _se_community(se_obj) return se_obj:community() end
local function _se_clsid(se_obj) return se_obj:clsid() end
local function _se_profile_name(se_obj) return se_obj:profile_name() end
local function _se_set_profile_name(se_obj, fallback) se_obj:set_profile_name(fallback) end

function on_game_start()
    -- Safely monkeypatch bind_hf_base's is_pickupable to prevent crashes on non-player placed furniture and protect rival camp decor
    if bind_hf_base and bind_hf_base.hf_binder_wrapper then
        bind_hf_base.hf_binder_wrapper.is_pickupable = function(self)
            if not (self and self.object) then return true end
            local obj_id = self.object:id()
            if stalker_camp_builder and stalker_camp_builder.is_rival_camp_object and stalker_camp_builder.is_rival_camp_object(obj_id) then
                return false
            end
            local data = hf_obj_manager and hf_obj_manager.get_data and hf_obj_manager.get_data(obj_id)
            if not data then
                return true
            end
            if data.is_world_obj then
                return false
            end
            return true
        end
    end

    -- Binders that subclass hf_binder_wrapper got their own copy of is_pickupable when they were
    -- declared (luabind copies a base's members into a subclass), before the override above ran;
    -- and the radio and lamp dialogs pick the piece up without asking. Outposts place both.
    local function outpost_piece(id)
        return id and stalker_camp_builder and stalker_camp_builder.is_rival_camp_object
            and stalker_camp_builder.is_rival_camp_object(id) or false
    end
    local function keep_outpost_piece(wrapper_class)
        local og = wrapper_class and wrapper_class.is_pickupable
        if not og then return end
        wrapper_class.is_pickupable = function(self, ...)
            if self and self.object and outpost_piece(self.object:id()) then return false end
            return og(self, ...)
        end
    end
    keep_outpost_piece(placeable_radio and placeable_radio.placeable_radio_wrapper)
    keep_outpost_piece(bind_light_furniture and bind_light_furniture.placeable_light_wrapper)
    local function keep_outpost_piece_in_dialog(dialog, id_field)
        if not (dialog and dialog.Pickup and dialog.TestAndShow) then return end
        local og_pickup, og_show = dialog.Pickup, dialog.TestAndShow
        dialog.Pickup = function(self, ...)
            if outpost_piece(self[id_field]) then return end
            return og_pickup(self, ...)
        end
        dialog.TestAndShow = function(self, obj_id, ...)
            if self.btn_pickup then self.btn_pickup:Enable(not outpost_piece(obj_id)) end
            return og_show(self, obj_id, ...)
        end
    end
    keep_outpost_piece_in_dialog(placeable_radio and placeable_radio.UIFurnitureRadio, "obj_id")
    keep_outpost_piece_in_dialog(ui_furniture_light and ui_furniture_light.UIFurnitureLight, "light_id")

    -- Protect player settlements, settlers, and Homestead roofs from Surge and Psi-Storm fatalities.
    -- Call the original cover check first and avoid closure allocations: Useful Idiots (SURGE.buildCovers)
    -- and NPC surge logic call pos_in_cover 15,000+ times on level load / surge start.
    if surge_manager and surge_manager.CSurgeManager then
        local og_pos_in_cover = surge_manager.CSurgeManager.pos_in_cover
        surge_manager.CSurgeManager.pos_in_cover = function(self, pos, by_name)
            if og_pos_in_cover then
                local ok, result = pcall(og_pos_in_cover, self, pos, by_name)
                if ok and result then return result end
            end
            local sb = stalker_camp_builder
            if pos and sb then
                if (sb.is_pos_in_active_camp and sb.is_pos_in_active_camp(pos))
                    or (sb.is_pos_under_homestead_roof and sb.is_pos_under_homestead_roof(pos)) then
                    return by_name and "homestead_settlement_cover" or true
                end
            end
            return false
        end
    end

    if psi_storm_manager and psi_storm_manager.CPsiStormManager then
        local og_psi_pos_in_cover = psi_storm_manager.CPsiStormManager.pos_in_cover
        if og_psi_pos_in_cover then
            psi_storm_manager.CPsiStormManager.pos_in_cover = function(self, pos, by_name)
                local ok, result = pcall(og_psi_pos_in_cover, self, pos, by_name)
                if ok and result then return result end
                local sb = stalker_camp_builder
                if pos and sb then
                    if (sb.is_pos_in_active_camp and sb.is_pos_in_active_camp(pos))
                        or (sb.is_pos_under_homestead_roof and sb.is_pos_under_homestead_roof(pos)) then
                        return by_name and "homestead_settlement_cover" or true
                    end
                end
                return false
            end
        end
    end

    -- Protect the player (db.actor) under placed Homestead roofs / upper floors during Emissions & Psi-Storms.
    -- Anomaly and G.A.M.M.A. check GetEvent("current_safe_cover"), which actor_status updates every 1s via
    -- scan_safe_zone / scan_safe_zone_old (returning 5 just like standing inside a placed tent).
    if actor_status then
        if actor_status.scan_safe_zone and not actor_status._homestead_safe_zone_patched then
            actor_status._homestead_safe_zone_patched = true
            local og_scan_safe_zone = actor_status.scan_safe_zone
            actor_status.scan_safe_zone = function(...)
                local curr, near, num = og_scan_safe_zone(...)
                if not curr and db.actor and stalker_camp_builder and stalker_camp_builder.is_pos_under_homestead_roof then
                    local apos = db.actor:position()
                    if apos and stalker_camp_builder.is_pos_under_homestead_roof(apos) then
                        return true, near, 5
                    end
                end
                return curr, near, num
            end
        end
        if actor_status.scan_safe_zone_old and not actor_status._homestead_safe_zone_old_patched then
            actor_status._homestead_safe_zone_old_patched = true
            local og_scan_safe_zone_old = actor_status.scan_safe_zone_old
            actor_status.scan_safe_zone_old = function(...)
                local curr, near, num = og_scan_safe_zone_old(...)
                if not curr and db.actor and stalker_camp_builder and stalker_camp_builder.is_pos_under_homestead_roof then
                    local apos = db.actor:position()
                    if apos and stalker_camp_builder.is_pos_under_homestead_roof(apos) then
                        return true, near, 5
                    end
                end
                return curr, near, num
            end
        end
    end

    -- Safely wrap tasks_guide guider companion checks to prevent crashes when NPCs have no squad
    if tasks_guide then
        if tasks_guide.is_guider_companion then
            local original_is_guider = tasks_guide.is_guider_companion
            tasks_guide.is_guider_companion = function(actor, npc)
                local real_npc = dialogs.who_is_npc(actor, npc)
                local squad = get_object_squad(real_npc)
                if not squad then
                    return false
                end
                return original_is_guider(actor, npc)
            end
        end
        if tasks_guide.is_not_guider_companion then
            local original_is_not_guider = tasks_guide.is_not_guider_companion
            tasks_guide.is_not_guider_companion = function(actor, npc)
                local real_npc = dialogs.who_is_npc(actor, npc)
                local squad = get_object_squad(real_npc)
                if not squad then
                    return true
                end
                return original_is_not_guider(actor, npc)
            end
        end
    end

    -- Engine Hardening: Safely wrap _G.get_object_by_id to handle offline objects cleanly
    -- In X-Ray, querying an offline object ID returns nil, which is standard engine behavior.
    -- Vanilla/modded _g.script prints '!ERROR get_object_by_id | no game object recieved from id',
    -- causing immense false alarm log spam whenever waypoint managers (PAW), companion monitors,
    -- or inventory scanners legitimately check an object that is currently offline.
    if _G.get_object_by_id then
        local og_get_object_by_id = _G.get_object_by_id
        _G.get_object_by_id = function(id)
            if not (id and type(id) == "number") then
                return nil
            end
            if id == AC_ID then
                return db.actor
            end
            local obj = (db.storage and db.storage[id] and db.storage[id].object) or (level and level.object_by_id and level.object_by_id(id))
            return obj
        end
    end

    -- Universal Map Marker / Waypoint Safety Wrapper (Catspaw PAW)
    -- Catspaw's safename() checks monsters via get_object_by_id(id), failing and logging errors when monsters are offline.
    -- Fall back to se_obj:section_name() so creature names are recognized and displayed properly without error spam.
    if tasks_placeable_waypoints and tasks_placeable_waypoints.safename then
        local og_safename = tasks_placeable_waypoints.safename
        local special_cases = {
            dog             = "blind_dog",
            bird            = "crow",
            giant           = "pseudogiant",
            SM_KARLIK       = "karlik",
            SM_LURKER       = "lurker",
            SM_POLTER_G     = "poltergeist",
            SM_PYRO_G       = "pyrogeist",
            SM_PSEUDO_G     = "pseudogeist",
            SM_PSYSUCKER    = "psysucker",
        }
        tasks_placeable_waypoints.safename = function(id)
            if not (id and type(id) == "number") then return og_safename(id) end
            local se_obj = alife_object(id)
            if se_obj then
                local cls = se_obj:clsid()
                if IsMonster and IsMonster(nil, cls) then
                    local obj = level and level.object_by_id and level.object_by_id(id)
                    local section = (obj and obj:section()) or (se_obj and se_obj:section_name())
                    if section then
                        local text
                        if string.find(section, "rotan", 1, true) then
                            text = "rat"
                        elseif string.find(section, "psy_dog", 1, true) then
                            text = "psydog"
                        else
                            local what = ini_sys:r_string_ex(section, "kind") or ini_sys:r_string_ex(section, "species") or nil
                            text = special_cases[what] or what
                        end
                        if text and game and game.translate_string then
                            return game.translate_string("encyclopedia_mutants_" .. text)
                        end
                    end
                end
            end
            return og_safename(id)
        end
    end

    -- Hook vanilla subdialog handler so eptSettlement is handled correctly.
    do
        local og_set_active_subdialog = pda.set_active_subdialog
        function pda.set_active_subdialog(section)
            local pda_menu = ActorMenu.get_pda_menu()
            if pda_menu and pda_menu:GetTabControl() and (section ~= "eptNPC") then
                pda_menu:GetTabControl():Show(true)
            end
            if section == "eptSettlement" then
                CreateTimeEvent("homestead_pda", "restore_tabs_subdialog", 0.05, function()
                    local menu = ActorMenu.get_pda_menu()
                    if menu and menu:GetTabControl() then
                        menu:GetTabControl():Show(true)
                    end
                    return true
                end)
                return ui_stalker_camp_builder_pda.get_ui()
            end
            if og_set_active_subdialog then
                return og_set_active_subdialog(section)
            end
        end
    end

    -- Engine Scheme Hardening: Ensure 'beh' scheme is registered across all stalker stypes
    -- Prevents "!ERROR: ... trying to use a scheme not intended for stype scheme=beh stype=nil"
    if schemes_by_stype then
        for s = 0, 4 do
            schemes_by_stype[s] = schemes_by_stype[s] or {}
            schemes_by_stype[s]["beh"] = true
        end
    end
    if schemes and not schemes["beh"] then
        schemes["beh"] = "axr_beh"
    end

    -- Safeguard xr_logic.activate_by_section against missing st.stype and missing loading flag
    if xr_logic and xr_logic.activate_by_section then
        local og_activate_by_section = xr_logic.activate_by_section
        xr_logic.activate_by_section = function(npc, ini, section, gulag_name, loading, ...)
            if npc and db.storage then
                local id = npc:id()
                if db.storage[id] and not db.storage[id].stype then
                    db.storage[id].stype = (modules and modules.stype_stalker) or 0
                end
            end
            if loading == nil then
                loading = false
            end
            return og_activate_by_section(npc, ini, section, gulag_name, loading, ...)
        end
    end

    -- Safeguard axr_companions.set_companion_squad_move_mode against non-table st.beh (Error 1048)
    if axr_companions and axr_companions.set_companion_squad_move_mode then
        local og_set_move_mode = axr_companions.set_companion_squad_move_mode
        axr_companions.set_companion_squad_move_mode = function(mode, npc, squad)
            if squad and squad.squad_members then
                pcall(function()
                    for k in squad:squad_members() do
                        if k and k.id and db.storage and db.storage[k.id] then
                            local s = db.storage[k.id]
                            if s.beh ~= nil and type(s.beh) ~= "table" then
                                s.beh = {}
                            end
                        end
                    end
                end)
            end
            local ok, err = pcall(og_set_move_mode, mode, npc, squad)
            if not ok then
                pcall(function()
                    squad = squad or (npc and get_object_squad(npc))
                    if squad and squad.squad_members then
                        local t = {"set_companion_to_wait_state", "set_companion_to_follow_state"}
                        local f = axr_companions[t[mode]]
                        if f then
                            for k in squad:squad_members() do
                                local s = db.storage and db.storage[k.id]
                                if s and type(s.beh) == "table" and k.id == squad:commander_id() then
                                    s.beh.rally_lvid = nil
                                end
                                local member = s and s.object
                                if member and member:alive() then
                                    pcall(f, member)
                                end
                            end
                        end
                    end
                end)
            end
        end
    end

    if axr_companions and axr_companions.cycle_companions_move_mode then
        local og_cycle = axr_companions.cycle_companions_move_mode
        local function pass_results(ok, ...)
            if ok then return ... end
        end
        axr_companions.cycle_companions_move_mode = function(...)
            if db.storage then
                for id, s in pairs(db.storage) do
                    if s and s.beh ~= nil and type(s.beh) ~= "table" then
                        s.beh = {}
                    end
                end
            end
            return pass_results(pcall(og_cycle, ...))
        end
    end

    -- Safeguard axr_beh action planner execution against broken/nil desired_target
    if axr_beh and axr_beh.action_beh and axr_beh.action_beh.execute then
        local og_beh_execute = axr_beh.action_beh.execute
        axr_beh.action_beh.execute = function(self)
            if self and self.st then
                if self.st.beh ~= nil and type(self.st.beh) ~= "table" then
                    self.st.beh = {}
                end
            end
            local ok, res = pcall(og_beh_execute, self)
            if ok then return res end
        end
    end

    -- =========================================================================
    -- Engine Hardening: Universal CCharacterInfo [(null)] Profile Shield
    -- Prevents fatal CTD in CXML_IdToIndex<CCharacterInfo>::GetById (xml_str_id_loader.h:115)
    -- "item not found, id [(null)]" which crashes when any stalker/corpse with an
    -- unassigned or stripped character_profile is queried by UICharacterInfo (looting
    -- corpses, trade, talking, inventory) or offline/online specific_character resolution.
    -- Uses static helper functions so zero closures are allocated per entity registration.
    -- =========================================================================
    local function get_safe_profile_for_se(se_obj)
        local comm = "stalker"
        if se_obj and se_obj.community then
            local ok, c = pcall(_se_community, se_obj)
            if ok and c then comm = c end
        end
        if not comm or comm == "" or comm == "unknown" then
            comm = "stalker"
        end
        local candidate = "sim_default_" .. comm .. "_0"
        if not (ini_sys and ini_sys:section_exist(candidate)) then
            candidate = "default"
        end
        return candidate
    end

    local function sanitize_se_profile(se_obj)
        if not se_obj then return end
        local ok_cls, cls = pcall(_se_clsid, se_obj)
        if not (ok_cls and cls) then return end
        if (IsStalker and IsStalker(nil, cls)) or cls == clsid.stalker or cls == clsid.script_stalker then
            local ok_prof, prof = pcall(_se_profile_name, se_obj)
            if (not ok_prof) or (not prof) or prof == "" or prof == "(null)" or prof == "nil" then
                local fallback = get_safe_profile_for_se(se_obj)
                if pcall(_se_set_profile_name, se_obj, fallback) then
                    printf("[Homestead Shield] Fixed missing character_profile on stalker id=%s sec=%s -> assigned '%s'", tostring(se_obj.id), tostring(se_obj:section_name()), tostring(fallback))
                end
            end
        end
    end

    -- 1. Sweep all ALife stalkers on game load / level load to sanitize existing broken profiles
    local function sanitize_all_stalker_profiles()
        local sim = alife()
        if not sim then return end
        local registry = _G.server_objects_registry
        if registry then
            for _, se_obj in pairs(registry) do
                if se_obj then
                    sanitize_se_profile(se_obj)
                end
            end
        else
            for id = 1, 65534 do
                local se_obj = sim:object(id)
                if se_obj then
                    sanitize_se_profile(se_obj)
                end
            end
        end
    end

    if RegisterScriptCallback then
        -- not load_state: it comes before the save's objects are read (CALifeStorageManager_load),
        -- so a sweep there walks 65534 empty ids; on_register and the first update cover a load
        RegisterScriptCallback("actor_on_first_update", sanitize_all_stalker_profiles)
        RegisterScriptCallback("server_entity_on_register", sanitize_se_profile)
    end

    -- 2. Intercept UI inventory / loot opening before CUICharacterInfo::InitCharacter queries the entity
    if ui_inventory and ui_inventory.start then
        local og_ui_inventory_start = ui_inventory.start
        ui_inventory.start = function(mode, obj)
            if obj and (mode == "loot" or mode == "trade" or mode == "repair") then
                local obj_id = (type(obj.id) == "function" and obj:id()) or obj.id
                if obj_id then
                    local se_obj = alife_object(obj_id)
                    if se_obj then
                        sanitize_se_profile(se_obj)
                    end
                end
            end
            return og_ui_inventory_start(mode, obj)
        end
    end

    -- 3. Intercept corpse loot generation in death_manager
    if death_manager and death_manager.create_release_item then
        local og_create_release_item = death_manager.create_release_item
        death_manager.create_release_item = function(npc)
            if npc then
                local npc_id = (type(npc.id) == "function" and npc:id()) or npc.id
                if npc_id then
                    local se_obj = alife_object(npc_id)
                    if se_obj then
                        sanitize_se_profile(se_obj)
                    end
                end
            end
            return og_create_release_item(npc)
        end
    end

    -- Guarantee homestead disconnect grace is engaged on level change and net destroy
    if RegisterScriptCallback then
        local function engage_homestead_disconnect_grace()
            if stalker_camp_builder then
                stalker_camp_builder.homestead_is_disconnecting = true
                stalker_camp_builder.homestead_teardown_grace_until = (time_global and time_global() or 0) + 600000
            end
        end
        RegisterScriptCallback("on_level_changing", engage_homestead_disconnect_grace)
        RegisterScriptCallback("actor_on_net_destroy", engage_homestead_disconnect_grace)
    end

    -- Add dedicated "Homestead" crafting category tab to Workshop Crafting UI (works on both G.A.M.M.A.
    -- and Vanilla Anomaly where craft.ltx only defines [1]..[6] and [7] does not exist).
    -- Force lazy-load of workshop_autoinject first if installed so its LoadRecipes wrapper runs before ours.
    local _ = workshop_autoinject
    local homestead_extra_sections = {
        workshop_item = true,
        alarm_system = true,
        alarm_system_pda = true,
        pistol_turret = true,
        turret_table = true,
        display_counter = true,
    }
    local function is_homestead_craft_sec(sec)
        if not sec then return false end
        if homestead_extra_sections[sec] then return true end
        return string.sub(sec, 1, 10) == "homestead_"
    end

    local function parse_craft_recipe_line(id, val, has_artificer)
        if not (id and val and id ~= "title") then return nil end
        local sec = string.sub(id, 3)
        if not (sec and sec ~= "" and ini_sys and ini_sys:section_exist(sec)) then
            return nil
        end
        local t = str_explode(val, ",")
        if not (t and (#t == 6 or #t == 8 or #t == 10)) then
            return nil
        end
        local r = {}
        r.sec = sec
        r.tool = tonumber(t[1]) or 1
        r.rsp = t[2]
        local k = 1
        for i = 3, #t, 2 do
            local itm = t[i]
            local amt = tonumber(t[i + 1])
            if itm and amt and ini_sys:section_exist(itm) then
                if has_artificer and (amt > 1) and string.find(itm, "^prt_i_") then
                    amt = amt - 1
                end
                r[k] = { itm, amt }
                k = k + 1
            else
                return nil
            end
        end
        return r
    end

    if ui_workshop and ui_workshop.UIWorkshopCraft and ui_workshop.UIWorkshopCraft.LoadRecipes and not ui_workshop.UIWorkshopCraft._homestead_craft_tab_patched then
        ui_workshop.UIWorkshopCraft._homestead_craft_tab_patched = true
        local og_load_recipes = ui_workshop.UIWorkshopCraft.LoadRecipes
        ui_workshop.UIWorkshopCraft.LoadRecipes = function(self, ...)
            og_load_recipes(self, ...)
            if not (self and self.recipes and self.recipes_type and self.list_menu and ui_workshop.list_element) then
                return
            end
            for i = 1, #self.recipes_type do
                if self.recipes_type[i] == "st_ui_craft_homestead" then
                    return
                end
            end
            local hs_recipes = {}
            local seen = {}
            for _, cat in pairs(self.recipes) do
                if type(cat) == "table" then
                    for _, r in pairs(cat) do
                        if type(r) == "table" and is_homestead_craft_sec(r.sec) and not seen[r.sec] then
                            seen[r.sec] = true
                            hs_recipes[#hs_recipes + 1] = r
                        end
                    end
                end
            end

            -- Fallback for Vanilla Anomaly / non-GAMMA modpacks where craft.ltx has no [7] section
            -- (so UIWorkshopCraft:LoadRecipes stopped at [6] and never read section [8]):
            local ini_craft = itms_manager and itms_manager.ini_craft
            if ini_craft and ini_craft:section_exist("8") then
                local has_artificer = game_achievements and game_achievements.has_achievement and game_achievements.has_achievement("artificer_eagerness")
                local n = ini_craft:line_count("8") or 0
                for i = 0, n - 1 do
                    local result, id, value = ini_craft:r_line_ex("8", i, "", "")
                    if id and value then
                        local sec = string.sub(id, 3)
                        if is_homestead_craft_sec(sec) and not seen[sec] then
                            local r = parse_craft_recipe_line(id, value, has_artificer)
                            if r then
                                seen[sec] = true
                                hs_recipes[#hs_recipes + 1] = r
                                if ui_workshop.workshop_craft_owner then
                                    ui_workshop.workshop_craft_owner[sec] = true
                                end
                            end
                        end
                    end
                end
            end

            if #hs_recipes > 0 then
                local new_idx = #self.recipes_type + 1
                self.recipes_type[new_idx] = "st_ui_craft_homestead"
                self.recipes[new_idx] = hs_recipes
                local _itm = ui_workshop.list_element(new_idx, "st_ui_craft_homestead")
                self.list_menu:AddExistingItem(_itm)
            end
        end
    end

    -- Also ensure recipe guidebooks (item_recipe.UIRecipe:LoadRecipes) include section [8] on Vanilla Anomaly
    -- when section [7] does not exist in craft.ltx.
    if item_recipe and item_recipe.UIRecipe and item_recipe.UIRecipe.LoadRecipes and not item_recipe.UIRecipe._homestead_recipe_patched then
        item_recipe.UIRecipe._homestead_recipe_patched = true
        local og_recipe_load = item_recipe.UIRecipe.LoadRecipes
        item_recipe.UIRecipe.LoadRecipes = function(self, ...)
            og_recipe_load(self, ...)
            local ini_craft = itms_manager and itms_manager.ini_craft
            if not (self and self.recipes and self.section and ini_craft) then return end
            if not ini_craft:section_exist("7") and ini_craft:section_exist("8") then
                local seen = {}
                for i = 1, #self.recipes do
                    if self.recipes[i] and self.recipes[i].sec then
                        seen[self.recipes[i].sec] = true
                    end
                end
                local n = ini_craft:line_count("8") or 0
                for i = 0, n - 1 do
                    local result, id, value = ini_craft:r_line_ex("8", i, "", "")
                    if id and value and id ~= "title" then
                        local t = str_explode(value, ",")
                        if t and t[2] == self.section then
                            local r = parse_craft_recipe_line(id, value, false)
                            if r and not seen[r.sec] then
                                seen[r.sec] = true
                                self.recipes[#self.recipes + 1] = r
                            end
                        end
                    end
                end
            end
        end
    end

    -- If Interactive PDA is not installed, or if Mod App Creator is active with our patch, we don't need to patch the left rail
    local enable_tab = true
    if ui_mcm and ui_mcm.get then
        local ok, value = pcall(ui_mcm.get, "stalker_camp_builder/qol_debug/enable_pda_tab")
        if ok and value ~= nil then enable_tab = value end
    end
    -- the MAC flag is a field of z_stalker_camp_builder_pda_mac's module, not a global
    local mac_flag = z_stalker_camp_builder_pda_mac and z_stalker_camp_builder_pda_mac.stalker_camp_builder_mac_flag
    if not (pda_inter_gui and pda_inter_gui.CustomPDAX) or (mac_mcm and mac_flag) or (not enable_tab) then
        return
    end

    local GUI_CLASS = pda_inter_gui.CustomPDAX
    local SLOT = 8

    local SLOT_TOP = 10
    local SLOT_STEP_MAX = 40

    local function slot_count()
        local n = 0
        for i = 1, pda_inter_gui.main_menu_btns or 7 do
            if pda_inter_gui.is_tab_enabled(i) then n = n + 1 end
        end
        if pda_inter_gui.pgc_compat_enabled and pda_inter_gui.pgc_compat_enabled() then
            n = n + 1
        end
        return n
    end

    -- 1. BuildMainMenu: init our button alongside slots 1-7
    local _orig_BuildMainMenu = GUI_CLASS.BuildMainMenu
    function GUI_CLASS:BuildMainMenu(xml)
        _orig_BuildMainMenu(self, xml)

        self.pda_t[SLOT] = {}
        self.pda_t[SLOT].btn = xml:Init3tButton("left_container:menu_btn_8", self.left_cont)
        self:Register(self.pda_t[SLOT].btn, "menu_btn_8")

        self.pda_t[SLOT].btn:Show(false)
        self.pda_t[SLOT].enabled = false
    end

    -- 2. InitCallBacks: wire our button click
    local _orig_InitCallBacks = GUI_CLASS.InitCallBacks
    function GUI_CLASS:InitCallBacks()
        _orig_InitCallBacks(self)
        GUI_CLASS["OnClickMainMenu_8"] = function(s) s:OnClickMainMenu(SLOT) end
        self:AddCallback("menu_btn_8", ui_events.BUTTON_CLICKED, GUI_CLASS.OnClickMainMenu_8, self)
    end

    -- 3. RefreshTabVisibility: position and show slot 8 below all others
    local _orig_RefreshTabVis = GUI_CLASS.RefreshTabVisibility
    function GUI_CLASS:RefreshTabVisibility()
        _orig_RefreshTabVis(self)
        local t8 = self.pda_t and self.pda_t[SLOT]
        if not (t8 and t8.btn) then return end

        local visual_slot = slot_count()
        local step = self.slot_step or SLOT_STEP_MAX

        t8.btn:SetWndPos(vector2():set(0, SLOT_TOP + visual_slot * step))
        t8.btn:Show(true)
        t8.enabled = true
        self.tab_visual_positions = self.tab_visual_positions or {}
        self.tab_visual_positions[SLOT] = visual_slot
    end

    -- 4. OnClickMainMenu: redirect slot 8 to eptSettlement subdialog
    local _orig_OnClickMainMenu = GUI_CLASS.OnClickMainMenu
    function GUI_CLASS:OnClickMainMenu(num)
        if num == SLOT then
            local pda_menu = ActorMenu.get_pda_menu()
            if pda_menu then
                pda_menu:SetActiveSubdialog("eptSettlement")
            end
            return
        end
        return _orig_OnClickMainMenu(self, num)
    end
end
