local monster_classes = {
    [clsid.bloodsucker_s]        = true,
    [clsid.boar_s]               = true,
    [clsid.dog_s]                = true,
    [clsid.flesh_s]              = true,
    [clsid.pseudodog_s]          = true,
    [clsid.burer_s]              = true,
    [clsid.cat_s]                = true,
    [clsid.chimera_s]            = true,
    [clsid.controller_s]         = true,
    [clsid.fracture_s]           = true,
    [clsid.poltergeist_s]        = true,
    [clsid.gigant_s]             = true,
    [clsid.zombie_s]             = true,
    [clsid.snork_s]              = true,
    [clsid.tushkano_s]           = true,
    [clsid.psy_dog_s]            = true,
    [clsid.psy_dog_phantom_s]    = true,
}

local ALARM_SCAN_INTERVAL = 0.15
local STATE_SYNC_INTERVAL = 2.0
local RAY_FLAGS = rq_target.rqtObject + rq_target.rqtStatic + rq_target.rqtObstacle
local alarm_system_pda_wrappers = {}

local v_bone_fwd
local v_target_center
local v_front_dir
local v_los_from
local v_los_dir

function toggle_alarm_system_pda(obj_id)
    local data = hf_obj_manager.get_data(obj_id) or {}
    local is_on = data.is_on or false
    local new_on = not is_on

    hf_obj_manager.update_data(obj_id, { is_on = new_on })
    local wrp = alarm_system_pda_wrappers[obj_id]
    if wrp then
        wrp.is_on = new_on
        wrp.state_sync_t = STATE_SYNC_INTERVAL
    end

    -- v1.1.7: localized (was hardcoded English despite the v1.1.6 pass)
    if is_on then
        news_manager.send_tip(db.actor, game.translate_string("st_alarm_pda_offline"), nil, nil, 20000)
    else
        news_manager.send_tip(db.actor, game.translate_string("st_alarm_pda_online"), nil, nil, 20000)
    end
end

--------------------------------------------------------------------------------
-- Init
--------------------------------------------------------------------------------
function init(obj)
    obj:bind_object(alarm_system_pda_wrapper(obj).binder)
end

--------------------------------------------------------------------------------
-- Helper: detect player / NPCs / monsters
--------------------------------------------------------------------------------

local function get_bone_forward(obj, bone_name)
    local bone_id = obj:bone_id(bone_name)
    if not bone_id then
        return nil
    end

    local m = obj:bone_transform(bone_id)
    if not m then
        return nil
    end

    v_bone_fwd = v_bone_fwd or vector()
    local forward = v_bone_fwd
    forward:set(m.j)
    forward:normalize()

    return forward
end

local function get_target_center(o, out_vec)
    local p = o:position()
    local center = out_vec or vector()
    center:set(p)

    if o:clsid() == clsid.script_stalker or o:clsid() == clsid.actor then
        center.y = center.y + 1.2
    else
        center.y = center.y + 0.5
    end

    return center
end

local function is_in_front_of_bone(obj, bone_name, target_pos_or_obj, min_dot)
    local forward = get_bone_forward(obj, bone_name)
    if not forward then
        return false
    end

    local target_pos = target_pos_or_obj
    if type(target_pos_or_obj.position) == "function" then
        v_target_center = v_target_center or vector()
        target_pos = get_target_center(target_pos_or_obj, v_target_center)
    end

    v_front_dir = v_front_dir or vector()
    local dir = v_front_dir
    dir:set(target_pos)
    dir:sub(obj:position())
    dir:normalize()

    return forward:dotproduct(dir) >= min_dot
end

-- the player's own settlers and companions: a raid reputation loss or a faction change can make them
-- read "enemy" to the player, and the turret already spares them (bind_pistol_turret is_own_resident)
local function is_own_resident(o, id)
    local sb = stalker_camp_builder
    if not sb then return false end
    local lookup = sb.settler_lookup and sb.settler_lookup[id]
    if type(lookup) == "table" and not lookup.is_rival then return true end
    if type(sb.is_companion) == "function" then
        local ok_c, comp = pcall(sb.is_companion, o)
        if ok_c and comp then return true end
    end
    return false
end

local function has_clear_los(alarm_obj, target_obj, target_pos, rp)
    if not alarm_obj or not target_obj or not target_pos or not rp then
        return false
    end

    v_los_from = v_los_from or vector()
    v_los_dir = v_los_dir or vector()

    local from = v_los_from
    from:set(alarm_obj:position())

    local dir = v_los_dir
    dir:set(target_pos)
    dir:sub(from)

    local dist = dir:magnitude()
    if dist < 0.05 then
        return true
    end
    dir:normalize()

    rp:set_position(from)
    rp:set_direction(dir)
    rp:set_range(dist)
    rp:set_flags(RAY_FLAGS)
    rp:set_ignore_object(alarm_obj)
    rp:query()

    local hit_obj = rp:get_object()
    if hit_obj then
        local ok1, hid = false, nil
        if hit_obj.id then
            ok1, hid = pcall(hit_obj.id, hit_obj)
        end
        local ok2, tid = false, nil
        if target_obj.id then
            ok2, tid = pcall(target_obj.id, target_obj)
        end
        return ok1 and ok2 and hid == tid
    end

    local hit_dist = rp:get_distance()
    return (not hit_dist) or hit_dist <= 0 or hit_dist >= (dist - 0.05)
end

local scan_alarm_obj, scan_pos, scan_radius, scan_rp, scan_min_dot, scan_actor_id, scan_found

local function alarm_pda_scan_cb(o)
    if scan_found then return true end
    local cls = o:clsid()
    -- perf: only stalkers and mutants can be threats; placed pieces and items around the alarm
    -- are skipped before their position (a new vector each) is read
    if cls ~= clsid.script_stalker and not monster_classes[cls] then return end
    local opos = o:position()

    if opos:distance_to(scan_pos) <= scan_radius then
        local is_threat = false
        local ok_oid, oid = false, nil
        if o.id then
            ok_oid, oid = pcall(o.id, o)
        end
        if ok_oid and o:alive() and oid ~= scan_actor_id then
            if monster_classes[cls] then
                is_threat = true
            elseif cls == clsid.script_stalker and not is_own_resident(o, oid) then
                local actor = db and db.actor
                if actor and o.relation then
                    local ok_rel, rel = pcall(o.relation, o, actor)
                    if ok_rel and rel == game_object.enemy then
                        is_threat = true
                    end
                end
            end
        end

        if is_threat then
            v_target_center = v_target_center or vector()
            local tpos = get_target_center(o, v_target_center)
            if is_in_front_of_bone(scan_alarm_obj, "bone_led", tpos, scan_min_dot) and has_clear_los(scan_alarm_obj, o, tpos, scan_rp) then
                scan_found = true
                return true    -- stops the iteration
            end
        end
    end
end

-- v1.1.7: bind_alarm_system.alarm_has_targets is the single canonical
-- implementation of this check (same 5m radius, facing cone, and LOS
-- raycast). Delegate at call time and keep the local body only as a fallback
-- in case bind_alarm_system is not loaded yet (X-Ray loads scripts lazily on first reference).
function alarm_has_targets(alarm_obj, radius, rp)
    if bind_alarm_system and bind_alarm_system.alarm_has_targets then
        return bind_alarm_system.alarm_has_targets(alarm_obj, radius, rp)
    end
    if not alarm_obj then return false end

    local pos = alarm_obj:position()
    local actor = db and db.actor
    local ok_aid, aid = false, nil
    if actor and actor.id then
        ok_aid, aid = pcall(actor.id, actor)
    end

    scan_alarm_obj = alarm_obj
    scan_pos = pos
    scan_radius = radius
    scan_rp = rp
    scan_min_dot = 0.2
    scan_actor_id = ok_aid and aid or nil
    scan_found = false

    -- only the objects around the alarm, not every online object in db.storage; the engine
    -- returns those whose bounding sphere reaches the radius, so the distance test stays
    level.iterate_nearest(pos, radius, alarm_pda_scan_cb)

    local res = scan_found
    scan_alarm_obj, scan_pos, scan_rp, scan_actor_id = nil, nil, nil, nil
    return res
end

--------------------------------------------------------------------------------
-- Class "alarm_system_pda_wrapper"
--------------------------------------------------------------------------------

class "alarm_system_pda_wrapper" (bind_hf_base.hf_binder_wrapper)

function alarm_system_pda_wrapper:__init(obj)
    super(obj)

    local obj_id = self.object:id()
    local data = hf_obj_manager.get_data(obj_id) or {}
    self.is_on = data.is_on or false
    self.state_sync_t = STATE_SYNC_INTERVAL
    self.last_led_state = nil

    self.first_update = true
    self.scan_t = 0
    self.alarm_detected = false
    self.rp = ray_pick()

    alarm_system_pda_wrappers[obj_id] = self

    -- Sound path selection: both base Hideout Gadgets 0.7.2 and Homestead's
    -- G.A.M.M.A. compatibility pack (04_HideoutGadgetsGammaPatch) ship alarm_system_sounds\*.
    local snd_base = [[alarm_system_sounds\]]
    self.snd_switch = sound_object(snd_base .. [[alarm_system_switch]])
end

--------------------------------------------------------------------------------
-- Update
--------------------------------------------------------------------------------
function alarm_system_pda_wrapper:update(delta)
    bind_hf_base.hf_binder_wrapper.update(self, delta)

    local dt = delta
    if dt > 1.0 then dt = dt / 1000.0 end

    self.state_sync_t = (self.state_sync_t or 0) - dt
    if self.is_on == nil or self.state_sync_t <= 0 then
        self.state_sync_t = STATE_SYNC_INTERVAL
        local data = hf_obj_manager.get_data(self.object:id()) or {}
        self.is_on = data.is_on or false
    end
    local is_on = self.is_on or false

    self.scan_t = (self.scan_t or 0) - dt
    if self.scan_t <= 0 then
        self.scan_t = ALARM_SCAN_INTERVAL
        self.alarm_detected = is_on and alarm_has_targets(self.object, 15, self.rp) or false
    end

    local alarm_detected = self.alarm_detected or false
    local alarm_active = is_on and alarm_detected

    if self.first_update then
        self.last_state         = is_on
        self.last_detected      = alarm_detected
        self.last_alarm_active  = alarm_active
        self.first_update       = false
        return
    end

    if self.last_state ~= is_on then
        -- perf: the position (a new vector) is read only when a sound starts, not every frame
        self.snd_switch:play_no_feedback(
            self.object,
            sound_object.s3d,
            0,
            self.object:position(),
            1,
            random_float(0.9, 1.1)
        )
    end

    if alarm_active and not self.last_alarm_active then
        if stalker_camp_builder and stalker_camp_builder.camp_send_tip then
            stalker_camp_builder.camp_send_tip(
                db.actor,
                game.translate_string("st_alarm_pda_triggered"),
                nil,
                "red_danger",
                20000,
                nil,
                "combat",
                true
            )
        else
            news_manager.send_tip(
                db.actor,
                game.translate_string("st_alarm_pda_triggered"),
                nil,
                nil,
                20000
            )
        end
    end

    if self.last_led_state ~= is_on then
        self.object:set_bone_visible("bone_led", is_on, false, false)
        self.last_led_state = is_on
    end

    self.last_state        = is_on
    self.last_detected     = alarm_detected
    self.last_alarm_active = alarm_active
end

function alarm_system_pda_wrapper:net_destroy()
    alarm_system_pda_wrappers[self.object:id()] = nil
    bind_hf_base.hf_binder_wrapper.net_destroy(self)
end
