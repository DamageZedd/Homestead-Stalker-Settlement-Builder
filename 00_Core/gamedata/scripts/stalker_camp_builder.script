-- the test modxml_stalker_camp_builder uses to inject the homestead_paw_* spots: Catspaw's
-- shared utils_catspaw_mapspots ships in mods without PAW, and without PAW's
-- map_spots_paw_pins.xml those spot types are never defined
local paw_pins_present = nil
local function has_paw_pins()
    if paw_pins_present == nil then
        local ok, found = pcall(function()
            return getFS():exist("$game_config$", "ui\\map_spots_paw_pins.xml")
        end)
        paw_pins_present = (ok and found) and true or false
    end
    return paw_pins_present
end
stalker_camp_builder.has_paw_pins = has_paw_pins

function get_settlement_map_spot_type()
    local style = (stalker_camp_builder.cfg and stalker_camp_builder.cfg.settlement_map_spot_style) or 0
    if style == 1 then
        if has_paw_pins() then
            return "homestead_paw_pin_stalker"
        end
        return "homestead_camp_hub"
    elseif style == 2 then
        return "green_location"
    else
        return "homestead_camp_hub"
    end
end
stalker_camp_builder.get_settlement_map_spot_type = get_settlement_map_spot_type

-- The settlement marker, on whatever spot type the MCM style gives the hub: the camp's name
-- (normalize_camps stores a missing one as "") and, below 40% morale, a warning. Adds the spot
-- when it is missing; otherwise only its text changes.
function refresh_settlement_map_spot(hub_id, camp)
    local name = camp and camp.name
    local hint = (name and name ~= "") and ("Settlement: " .. name) or "Settlement"
    local morale = camp and camp.happiness
    if morale and morale < 40 then
        hint = hint .. string.format(" [LOW MORALE: %d%%]", morale)
    end
    local spot = get_settlement_map_spot_type()
    if level.map_has_object_spot(hub_id, spot) == 0 then
        level.map_add_object_spot(hub_id, spot, hint)
    else
        level.map_change_spot_hint(hub_id, spot, hint)
    end
end
stalker_camp_builder.refresh_settlement_map_spot = refresh_settlement_map_spot

function get_outpost_map_spot_type(camp, is_hostile)
    local style = (stalker_camp_builder.cfg and stalker_camp_builder.cfg.outpost_map_spot_style) or 0

    if style == 3 then
        if camp.status == "mutant_nest" then
            return "red_location"
        elseif camp.status == "unoccupied" then
            return "blue_location"
        else
            return is_hostile and "red_location" or "green_location"
        end
    end

    if style == 2 and has_paw_pins() then
        if camp.status == "mutant_nest" then
            return "homestead_paw_pin_skull"
        elseif camp.status == "unoccupied" then
            return "homestead_paw_pin_abandoned"
        else
            return is_hostile and "homestead_paw_pin_hostile" or "homestead_paw_pin_friendly"
        end
    end

    if style == 1 then
        if camp.status == "mutant_nest" then
            return has_paw_pins() and "homestead_paw_pin_skull" or "homestead_outpost_mutant"
        elseif camp.status == "unoccupied" then
            return "homestead_outpost_abandoned"
        else
            return is_hostile and "homestead_outpost_hostile" or "homestead_outpost_friendly"
        end
    end

    -- Default (Style 0): Faction Badges & Insignias
    if camp.status == "mutant_nest" then
        return has_paw_pins() and "homestead_paw_pin_skull" or "homestead_outpost_mutant"
    elseif camp.status == "unoccupied" then
        return has_paw_pins() and "homestead_paw_pin_abandoned" or "homestead_outpost_abandoned"
    end

    local fac = camp.faction
    if fac and has_paw_pins() then
        local fac_paw_badge = "homestead_paw_badge_" .. fac
        if fac == "bandit" or fac == "monolith" or fac == "killer" or fac == "army"
           or fac == "stalker" or fac == "dolg" or fac == "freedom" or fac == "csky"
           or fac == "ecolog" or fac == "greh" or fac == "isg" or fac == "renegade" then
            return fac_paw_badge
        elseif fac == "zombied" then
            return "homestead_paw_pin_skull"
        end
    end

    return is_hostile and "homestead_outpost_hostile" or "homestead_outpost_friendly"
end
stalker_camp_builder.get_outpost_map_spot_type = get_outpost_map_spot_type

function remove_all_rival_map_spots(chest_id)
    if not chest_id then return end
    for _, spot in ipairs(KNOWN_RIVAL_MAP_SPOTS) do
        if level.map_has_object_spot(chest_id, spot) ~= 0 then
            pcall(function() level.map_remove_object_spot(chest_id, spot) end)
        end
    end
end
stalker_camp_builder.remove_all_rival_map_spots = remove_all_rival_map_spots

function remove_all_camp_map_spots(hub_id)
    if not hub_id then return end
    for _, spot in ipairs(KNOWN_CAMP_MAP_SPOTS) do
        if level.map_has_object_spot(hub_id, spot) ~= 0 then
            pcall(function() level.map_remove_object_spot(hub_id, spot) end)
        end
    end
end
stalker_camp_builder.remove_all_camp_map_spots = remove_all_camp_map_spots

function sync_rival_camp_map_spot(camp)
    if not (camp and camp.chest_id) then return end
    local sb = stalker_camp_builder
    local show_rival = (sb.cfg.show_rival_camp_map_spots ~= false)
    if not show_rival then
        remove_all_rival_map_spots(camp.chest_id)
        camp.map_spot_key = nil
        return
    end

    local actor = db.actor
    local actor_comm = actor and actor:character_community() or "stalker"
    local rel = camp.faction and relation_registry.community_relation(camp.faction, actor_comm) or -1000
    local is_hostile = (rel <= -1000)

    local spot_type = get_outpost_map_spot_type(camp, is_hostile)
    local target_label = "Abandoned Outpost: " .. (camp.name or "Outpost")

    if camp.status == "mutant_nest" then
        target_label = "Mutant Nest: " .. (camp.name or "Outpost")
    elseif camp.status ~= "unoccupied" and camp.faction then
        local fac_name = game.translate_string(camp.faction)
        target_label = (is_hostile and "Hostile Outpost (" or "Occupied Outpost (") .. fac_name .. "): " .. (camp.name or "Outpost")
    end

    -- unchanged and still on the map: leave it (every add fires map_location_added hooks)
    local key = spot_type .. "|" .. target_label
    if camp.map_spot_key == key and level.map_has_object_spot(camp.chest_id, spot_type) ~= 0 then return end
    remove_all_rival_map_spots(camp.chest_id)
    pcall(function()
        level.map_add_object_spot(camp.chest_id, spot_type, target_label)
    end)
    camp.map_spot_key = key
end
stalker_camp_builder.sync_rival_camp_map_spot = sync_rival_camp_map_spot

local last_sync_map_spots_tg = 0
function sync_all_camp_map_spots(force)
    local tg = time_global()
    if not force and (tg - last_sync_map_spots_tg) < 10000 then
        return
    end
    last_sync_map_spots_tg = tg

    local sb = stalker_camp_builder
    local sim = alife()
    if not sim then return end

    local camp_spot = get_settlement_map_spot_type()
    for hub_id, camp in pairs(sb.active_camps) do
        local se_hub = sim:object(hub_id)
        if se_hub then
            -- Remove obsolete/competing map spots on camp hub (strips legacy serialized spots too)
            if force then
                for _, spot in ipairs(KNOWN_CAMP_MAP_SPOTS) do
                    if level.map_has_object_spot(hub_id, spot) ~= 0 then
                        pcall(function() level.map_remove_object_spot(hub_id, spot) end)
                    end
                end
            else
                for _, spot in ipairs(KNOWN_CAMP_MAP_SPOTS) do
                    if spot ~= camp_spot and level.map_has_object_spot(hub_id, spot) ~= 0 then
                        pcall(function() level.map_remove_object_spot(hub_id, spot) end)
                    end
                end
            end
            pcall(refresh_settlement_map_spot, hub_id, camp)
            if camp.zone_id and level.map_has_object_spot(camp.zone_id, "ui_pda2_actor_sleep_location") ~= 0 then
                level.map_remove_object_spot(camp.zone_id, "ui_pda2_actor_sleep_location")
            end
        end
    end

    local show_rival = (sb.cfg.show_rival_camp_map_spots ~= false)
    for key, camp in pairs(sb.rival_camps) do
        if type(camp) == "table" and camp.chest_id then
            local se_chest = sim:object(camp.chest_id)
            if se_chest then
                local m_data = alife_storage_manager.get_state()
                if m_data then
                    if not m_data.player_created_stashes then
                        m_data.player_created_stashes = {}
                    end
                    if not m_data.player_created_stashes[camp.chest_id] then
                        m_data.player_created_stashes[camp.chest_id] = "blue_box_item"
                    end
                end
                if show_rival then
                    sync_rival_camp_map_spot(camp)
                else
                    remove_all_rival_map_spots(camp.chest_id)
                end
            end
        end
    end
end
stalker_camp_builder.sync_all_camp_map_spots = sync_all_camp_map_spots

-- actor_on_first_update helpers

local function show_camp_summary_toast(actor, current_level)
    local camps_on_level = {}
    for _, camp in pairs(stalker_camp_builder.active_camps) do
        if camp.level == current_level and camp.survivors then
            local count = 0
            for _ in pairs(camp.survivors) do count = count + 1 end
            if count > 0 then
                camps_on_level[#camps_on_level + 1] = string.format(
                    "%s (%d settlers, %d%% morale)",
                    camp.name or "Camp", count, camp.happiness or 50)
            end
        end
    end
    if #camps_on_level == 0 or not actor then return end
    CreateTimeEvent("homestead_camp_summary", "homestead_camp_summary", 2.0, function()
        camp_send_tip(actor,
            string.format(game.translate_string("st_event_settlements_on_level"),
                table.concat(camps_on_level, "; ")),
            nil, "general_stalker", 10000, nil, "general")
        return true
    end)
end

local function get_job_realtime_interval(job)
    if     job == "cook"        then return cfg.realtime_job_cook_interval
    elseif job == "craft"       then return cfg.realtime_job_craft_interval
    elseif job == "repair"      then return cfg.realtime_job_repair_interval
    elseif job == "scavenge"    then return cfg.realtime_job_scavenge_interval
    elseif job == "hunter"      then return cfg.realtime_job_hunter_interval
    elseif job == "medic"       then return cfg.medic_job_interval or defaults.medic_job_interval
    elseif job == "electrician" then return cfg.electrician_job_interval or defaults.electrician_job_interval
    elseif job == "woodcutter"  then return cfg.realtime_job_woodcutter_interval or defaults.realtime_job_woodcutter_interval
    elseif job == "brewer"      then return cfg.realtime_job_brewer_interval or defaults.realtime_job_brewer_interval
    elseif job == "scrapper"    then return cfg.realtime_job_scrapper_interval or defaults.realtime_job_scrapper_interval
    end
    return nil
end

local function rebase_one_survivor_job(survivor, cur_tg, cur_gsec, tf)
    if type(survivor) ~= "table" then return end
    if not (survivor.job and survivor.job ~= "idle" and survivor.job ~= "companion") then
        return
    end
    local rt_interval = get_job_realtime_interval(survivor.job)
    if not rt_interval or rt_interval <= 0 then return end

    local tod_mult = stalker_camp_builder.get_time_of_day_mult
        and stalker_camp_builder.get_time_of_day_mult(survivor.job) or 1.0
    local effective_interval = rt_interval / (tod_mult > 0 and tod_mult or 1.0)
    local game_elapsed = cur_gsec - (survivor.job_start_time or cur_gsec)
    local effective_sec = mmax(0, game_elapsed / tf)
    survivor.job_start_realtime = cur_tg - (mmin(effective_sec, effective_interval) * 1000)
    if not survivor.job_start_time then
        survivor.job_start_time = cur_gsec
    end
end

local function rebase_all_survivor_jobs(cur_tg, cur_gsec, tf)
    for _, camp in pairs(stalker_camp_builder.active_camps) do
        if camp.survivors then
            for _, survivor in pairs(camp.survivors) do
                rebase_one_survivor_job(survivor, cur_tg, cur_gsec, tf)
            end
        end
    end
end

local function clean_orphaned_camps(current_level)
    local to_remove = {}
    for hub_id, camp in pairs(stalker_camp_builder.active_camps) do
        if camp.level == current_level and not alife_object(hub_id) then
            to_remove[#to_remove + 1] = hub_id
        end
    end
    for _, hub_id in ipairs(to_remove) do
        level.map_remove_object_spot(hub_id, "ui_pda2_actor_sleep_location")
        stalker_camp_builder.end_camp_raid(stalker_camp_builder.active_camps[hub_id])
        stalker_camp_builder.active_camps[hub_id] = nil
    end
end

local function reestablish_settler_relations()
    if not (relation_registry and relation_registry.set_npcs_relation) then return end
    for _, camp in pairs(stalker_camp_builder.active_camps) do
        if camp.survivors then
            local ids = {}
            for npc_id in pairs(camp.survivors) do ids[#ids + 1] = npc_id end
            for i = 1, #ids do
                for j = i + 1, #ids do
                    relation_registry.set_npcs_relation(ids[i], ids[j], "friend")
                    relation_registry.set_npcs_relation(ids[j], ids[i], "friend")
                end
            end
        end
    end
end

local function migrate_ctime_fields()
    local function convert_if_needed(v)
        if v and type(v) ~= "number" then return get_time_sec(v) end
        return v
    end
    for _, camp in pairs(stalker_camp_builder.active_camps) do
        if type(camp) == "table" then
            camp.trader_spawn_time     = convert_if_needed(camp.trader_spawn_time)
            camp.last_water_time       = convert_if_needed(camp.last_water_time)
            camp.last_fridge_time      = convert_if_needed(camp.last_fridge_time)
            camp.last_event_check_time = convert_if_needed(camp.last_event_check_time)
            camp.last_raid_check_time  = convert_if_needed(camp.last_raid_check_time)
            if camp.survivors then
                for _, survivor in pairs(camp.survivors) do
                    if type(survivor) == "table" then
                        survivor.job_start_time = convert_if_needed(survivor.job_start_time)
                    end
                end
            end
        end
    end
end

local HF_REQUIREMENT_CHECKS = {
    { sections = {"placeable_workshop", "placeable_blue_box"},
      warning  = "st_hf_requirement_warning" },
    { sections = {"placeable_alarm_system", "placeable_pistol_turret"},
      warning  = "st_hg_requirement_warning" },
    { sections = {"placeable_stove2", "placeable_bed_1"},
      warning  = "st_hfe_requirement_warning" },
    { sections = {"placeable_stretcher", "placeable_clinic_equipments"},
      warning  = "st_emf_requirement_warning" },
}

local function check_hf_requirements(actor)
    for _, check in ipairs(HF_REQUIREMENT_CHECKS) do
        local present = false
        for _, sec in ipairs(check.sections) do
            if ini_sys:section_exist(sec) then present = true; break end
        end
        if not present then
            news_manager.send_tip(actor, game.translate_string(check.warning),
                                  nil, "red_danger", 20000)
        end
    end
end

local function validate_loaded_structures()
    for _, camp in pairs(stalker_camp_builder.active_camps) do
        local stale = {}
        for struct_id in pairs(camp.structures) do
            if not alife_object(struct_id) then stale[#stale + 1] = struct_id end
        end
        for _, struct_id in ipairs(stale) do
            camp.structures[struct_id] = nil
        end
    end
end

local function populate_gamma_rival_chests_on_load()
    local is_gamma_mode = (stalker_camp_builder_gamma_flag ~= nil)
        or (grok_stashes_on_corpses ~= nil)
    if not is_gamma_mode then return end
    pcall(function()
        for _, camp in pairs(stalker_camp_builder.rival_camps) do
            if type(camp) == "table" and camp.chest_id then
                forget_looted_outpost_chest(camp.chest_id)
                local box_obj = level.object_by_id(camp.chest_id)
                local has_cache = treasure_manager
                    and treasure_manager.caches
                    and type(treasure_manager.caches[camp.chest_id]) == "string"
                if box_obj and has_cache then
                    treasure_manager.try_spawn_treasure(box_obj)
                    safe_iterate_inventory_box(box_obj, function(_, item)
                        local ok_w = IsWeapon and IsWeapon(item)
                        local ok_o = IsOutfit and IsOutfit(item)
                        if (ok_w or ok_o) and item and item.set_condition then
                            pcall(function()
                                item:set_condition(math.random(10, 65) / 100)
                            end)
                        end
                    end)
                end
            end
        end
    end)
end

local function run_settler_self_heals()
    local helpers = {
        "heal_orphaned_settler_squads",
        "heal_corrupted_scripted_targets",
        "heal_stuck_companion_settlers",
        "heal_ghost_companion_squads",
    }
    for _, name in ipairs(helpers) do
        if stalker_camp_builder[name] then stalker_camp_builder[name]() end
    end
end

-- A survivor's NPC, or nil when its id holds no stalker (of the survivor's section, when one is given).
-- An NPC released without dying (another mod's despawner) keeps its camp entry until the next load,
-- and its id may be free or taken by another object; the engine's switch and squad calls crash on those.
function stalker_camp_builder.survivor_se(npc_id, survivor)
    local se = npc_id and alife_object(tonumber(npc_id) or npc_id)
    if not (se and IsStalker(nil, se:clsid())) then return nil end
    if survivor and survivor.section and se:section_name() ~= survivor.section then return nil end
    return se
end

local function verify_and_heal_settlers()
    for hub_id, camp in pairs(stalker_camp_builder.active_camps) do
        local hub_obj = alife_object(hub_id)
        local hub_pos = hub_obj and hub_obj.position or nil
        local stale = {}

        for npc_id, survivor in pairs(camp.survivors) do
            local id_num = tonumber(npc_id) or npc_id
            -- an id that holds no stalker (an item took it) counts as missing. No section check:
            -- restore_missing_settler uses sim_default_stalker_0 when the section is gone
            local se = stalker_camp_builder.survivor_se(id_num)
            if not se and stalker_camp_builder.restore_missing_settler then
                id_num = stalker_camp_builder.restore_missing_settler(hub_id, id_num, survivor) or id_num
                se = alife_object(id_num)
            end
            if not se then
                stale[#stale + 1] = npc_id
            elseif (survivor.job or "idle") ~= "scavenge" then
                if stalker_camp_builder.heal_settler_squad_membership then
                    stalker_camp_builder.heal_settler_squad_membership(id_num, camp.level, hub_pos)
                end
            end
            -- the pin that keeps a home squad at the camp is a function on the server object,
            -- which the save dropped
            if se and stalker_camp_builder.pin_settler_home_squad then
                stalker_camp_builder.pin_settler_home_squad(id_num)
            end
            -- the save keeps a squad's switch flags: lift an expedition's hold for a settler who is back
            if se and not survivor.on_expedition and stalker_camp_builder.allow_home_squad_online then
                stalker_camp_builder.allow_home_squad_online(id_num, true)
            end
        end

        for _, npc_id in ipairs(stale) do
            camp.survivors[npc_id] = nil
            stalker_camp_builder.settler_lookup[npc_id] = nil
        end

        -- an Invincible settler who died just before the save: the respawn's time event is gone
        for dead_id in pairs(camp.respawning or {}) do
            stalker_camp_builder.respawn_settler(hub_id, dead_id)
        end
    end
end

local function survivor_is_companion(survivor, npc_id)
    if survivor.is_companion or survivor.job == "companion" then return true end
    if stalker_camp_builder.is_companion then
        return stalker_camp_builder.is_companion(npc_id) and true or false
    end
    return false
end

local function restore_dismissed_companion_jobs(camp)
    if not stalker_camp_builder.is_companion then return end
    for npc_id, survivor in pairs(camp.survivors) do
        local id_num = tonumber(npc_id) or npc_id
        local was_comp = survivor.job == "companion" or survivor.is_companion
        if was_comp and not stalker_camp_builder.is_companion(id_num) then
            survivor.job = survivor.paused_job or "idle"
            survivor.paused_job = nil
            survivor.is_companion = nil
        end
    end
end

local function teleport_camp_settlers_home(camp, hub_id)
    local to_teleport = {}
    for npc_id, survivor in pairs(camp.survivors) do
        local id_num = tonumber(npc_id) or npc_id
        if not survivor.on_expedition and not survivor_is_companion(survivor, id_num) then
            to_teleport[#to_teleport + 1] = { npc_id = id_num, survivor = survivor }
        end
    end
    for _, entry in ipairs(to_teleport) do
        local cur_id = entry.npc_id
        if not alife_object(cur_id) and stalker_camp_builder.restore_missing_settler then
            cur_id = stalker_camp_builder.restore_missing_settler(hub_id, cur_id, entry.survivor)
                or cur_id
        end
        pcall(function()
            stalker_camp_builder.teleport_settler_to_camp_level(cur_id, hub_id, true)
        end)
    end
end

local function separation_sweep(camp, hub_id)
    local hub_obj = alife_object(hub_id)
    local hub_pos = hub_obj and hub_obj.position
    if not hub_pos then return end

    for npc_id, survivor in pairs(camp.survivors) do
        local id_num = tonumber(npc_id) or npc_id
        if not survivor.on_expedition and not survivor_is_companion(survivor, id_num) then
            local se_npc = alife_object(id_num)
            if se_npc and se_npc.position:distance_to_sqr(hub_pos) < 1.69 then
                local f_lvid, f_pos = stalker_camp_builder.get_furniture_front_vertex_and_pos(hub_pos, 1.5)
                if f_lvid and f_pos then
                    se_npc.position = f_pos
                    se_npc.m_level_vertex_id = f_lvid
                    -- moved only: assigned_pos is the post the player sets, and it would hold the
                    -- settler here for every job from now on
                    local online_npc = level.object_by_id(id_num)
                    if online_npc and IsStalker(online_npc) and (not IsMonster(online_npc))
                        and online_npc.set_npc_position then
                        pcall(function() online_npc:set_npc_position(f_pos) end)
                    end
                end
            end
        end
    end
end

local function cross_level_recall_and_health_check(current_level)
    for hub_id, camp in pairs(stalker_camp_builder.active_camps) do
        if camp.survivors and camp.level == current_level then
            restore_dismissed_companion_jobs(camp)
            teleport_camp_settlers_home(camp, hub_id)
            separation_sweep(camp, hub_id)
        end
    end
end

-- ============================================================================
-- sanitize_orphan_container_children (v1.2.0 Engine Stability Hardening)
-- ----------------------------------------------------------------------------
-- Scans ALife world objects for containers/stashes whose internal engine
-- children vector holds references to nonexistent/deleted child IDs.
-- When found, respawns the container cleanly with its valid contents,
-- permanently removing the dangling ID reference and preventing the fatal
-- engine crash: "xrServer::Perform_destroy -> child registered but not found [ID]".
-- ============================================================================
function stalker_camp_builder.sanitize_orphan_container_children()
    local sim = alife()
    if not sim or type(sim.get_children) ~= "function" then return end

    local fixed_count = 0
    local purged_orphans = 0

    for id = 0, 65534 do
        local se_obj = sim:object(id)
        if se_obj then
            local is_container = false
            pcall(function()
                local c = se_obj:clsid()
                if c == clsid.inventory_box or c == clsid.inventory_box_s then
                    is_container = true
                end
            end)

            if is_container then
                local bad_children = {}
                local valid_children = {}
                pcall(function()
                    for child_id in sim:get_children(se_obj) do
                        if child_id and child_id < 65535 then
                            local child_se = sim:object(child_id)
                            if child_se then
                                valid_children[#valid_children + 1] = child_id
                            else
                                bad_children[#bad_children + 1] = child_id
                            end
                        end
                    end
                end)

                if #bad_children > 0 then
                    purged_orphans = purged_orphans + #bad_children
                    fixed_count = fixed_count + 1

                    local sec = se_obj:section_name() or "inventory_box"
                    local pos = se_obj.position
                    local lvid = se_obj.m_level_vertex_id
                    local gvid = se_obj.m_game_vertex_id
                    local s_id = se_obj.m_story_id

                    printf("~ [HOMESTEAD] Container Sanitizer: repairing container [%s] (ID %s) with %s orphaned child IDs: %s",
                        sec, id, #bad_children, table.concat(bad_children, ", "))

                    -- 1. Create clean replacement container
                    local new_box = sim:create(sec, pos, lvid, gvid)
                    if new_box then
                        if s_id and s_id < 65535 and s_id > 0 then
                            new_box.m_story_id = s_id
                        end

                        -- 2. Teleport valid items to the new container location
                        for _, vid in ipairs(valid_children) do
                            pcall(function()
                                sim:teleport_object(vid, gvid, lvid, pos)
                            end)
                        end

                        -- 3. Update treasure_manager references if this was an active cache
                        if treasure_manager and treasure_manager.caches then
                            if treasure_manager.caches[id] then
                                treasure_manager.caches[new_box.id] = treasure_manager.caches[id]
                                treasure_manager.caches[id] = nil
                            end
                        end

                        -- 4. Update Homestead active camp stashes if registered
                        for _, camp in pairs(stalker_camp_builder.active_camps) do
                            if camp.stashes and camp.stashes[id] then
                                camp.stashes[new_box.id] = camp.stashes[id]
                                camp.stashes[id] = nil
                            end
                            if camp.workshop_id == id then
                                camp.workshop_id = new_box.id
                            end
                        end

                        -- CRITICAL: NEVER call sim:release(se_obj) on a container with orphaned children!
                        -- In X-Ray C++, sim:release(se_obj) calls xrServer::Perform_destroy(se_obj), which
                        -- traverses se_obj->children and immediately triggers a fatal abort:
                        -- "xrServer::Perform_destroy -> child registered but not found [ID]".
                        -- By transferring all valid items and updating all reference tables,
                        -- the original box is safely left as an inert empty shell.
                    end
                end
            end
        end
    end

    if fixed_count > 0 then
        printf(">>> [HOMESTEAD] Container Sanitizer: successfully repaired %s containers and purged %s orphaned children. Save game to persist fix.",
            fixed_count, purged_orphans)
    end
end

-- actor_on_first_update -- level-entry orchestrator
function actor_on_first_update()
    tg_update = 0
    homestead_teardown_grace_until = 0
    stalker_camp_builder.homestead_teardown_grace_until = 0
    actor_update_slot = 0
    pcall(stalker_camp_builder.load_pending_cond)
    homestead_is_disconnecting = false
    stalker_camp_builder.homestead_is_disconnecting = false
    local actor = db.actor
    local current_level = level.name()

    show_camp_summary_toast(actor, current_level)

    level_start_time = time_global()
    snap_done = true
    -- forced once per load: strips markers older versions saved with map_add_object_spot_ser
    -- from the hubs and, with the remembered keys cleared, from the outpost chests
    for _, rcamp in pairs(stalker_camp_builder.rival_camps) do
        if type(rcamp) == "table" then rcamp.map_spot_key = nil end
    end
    sync_all_camp_map_spots(true)

    local cur_tg = time_global()
    local cur_gsec = game_sec()
    local tf = (level and level.get_time_factor and level.get_time_factor()) or 10
    if tf <= 0 then tf = 10 end

    pcall(stalker_camp_builder.process_stash_expeditions)
    rebase_all_survivor_jobs(cur_tg, cur_gsec, tf)

    clean_orphaned_camps(current_level)
    reestablish_settler_relations()

    if hf_furniture_types then
        hf_furniture_types.add_type("camp_hub", function(obj_id) end)
    end

    migrate_ctime_fields()
    check_hf_requirements(actor)
    validate_loaded_structures()

    run_settler_self_heals()
    verify_and_heal_settlers()

    -- Delayed settler recall: Allow level geometry, pathing, and binders to fully settle
    CreateTimeEvent("homestead_level_entry", "recall_settlers", 2.0, function()
        pcall(cross_level_recall_and_health_check, current_level)
        return true
    end)

    -- Delayed rival camp ground snapping, squad restraint & chest populating:
    -- Defers ALife physics/squad adjustments until the level net_spawn and m_crows queues are 100% idle
    CreateTimeEvent("homestead_level_entry", "snap_rival_camps", 2.5, function()
        pcall(snap_rival_camps_to_ground)
        pcall(restrain_rival_squads)
        pcall(populate_gamma_rival_chests_on_load)
        pcall(sync_all_camp_map_spots)
        return true
    end)

    last_boundary_dist = cfg.boundary_dist
    local cur_level = current_level or (level and level.name and level.name())
    local camps_to_scan = {}
    for hub_id, camp in pairs(stalker_camp_builder.active_camps) do
        -- Furniture on other levels is offline, static, and loaded from save data. Only scan
        -- camps on the loaded level, or camps missing structures.
        if not camp.level or camp.level == cur_level or not camp.structures then
            camps_to_scan[#camps_to_scan + 1] = hub_id
        end
    end
    if #camps_to_scan == 1 then
        scan_camp_structures(camps_to_scan[1], true)
    elseif #camps_to_scan > 1 then
        scan_multiple_camp_structures(camps_to_scan, true)
    end
end

