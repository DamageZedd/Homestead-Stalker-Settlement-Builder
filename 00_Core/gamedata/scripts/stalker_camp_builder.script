function safe_squad_members(squad)
    if squad and squad.squad_members then
        return squad:squad_members()
    end
    return function() return nil end
end

local known_bad_inventory_boxes = {}

-- iterate_server_container -- robustly iterate items in an ALife container
local _server_container_cache = {}
local _server_container_cache_tg = 0

function stalker_camp_builder.invalidate_server_container_cache(box_id)
    -- Always force a full rebuild. Clearing only one box's list made that
    -- box read as empty until the next rebuild (false "no supplies").
    _server_container_cache = {}
    _server_container_cache_tg = 0
end

function stalker_camp_builder.get_server_container_items(target_box_id)
    if not target_box_id then return {} end
    local tg = time_global()
    if (tg - _server_container_cache_tg) > 3500 or not _server_container_cache[target_box_id] then
        _server_container_cache = {}
        _server_container_cache_tg = tg

        -- Check active camp stored items first
        local sb = stalker_camp_builder
        if sb and sb.active_camps then
            for _, camp in pairs(sb.active_camps) do
                if camp.stored_items then
                    for iid, it in pairs(camp.stored_items) do
                        local pid = it.box_id
                        if pid and pid > 0 and pid < 65535 then
                            local list = _server_container_cache[pid]
                            if not list then
                                list = {}
                                _server_container_cache[pid] = list
                            end
                            list[#list + 1] = iid
                        end
                    end
                end
            end
        end

        local registry = _G.server_objects_registry
        if registry then
            for id, se in pairs(registry) do
                if se and se.parent_id and se.parent_id > 0 and se.parent_id < 65535 then
                    local pid = se.parent_id
                    local list = _server_container_cache[pid]
                    if not list then
                        list = {}
                        _server_container_cache[pid] = list
                    end
                    list[#list + 1] = id
                end
            end
        elseif not _server_container_cache[target_box_id] then
            -- Fallback server object scan
            local sim = alife()
            if sim then
                for id = 1, 65534 do
                    local se = sim:object(id)
                    if se and se.parent_id and se.parent_id > 0 and se.parent_id < 65535 then
                        local pid = se.parent_id
                        local list = _server_container_cache[pid]
                        if not list then
                            list = {}
                            _server_container_cache[pid] = list
                        end
                        list[#list + 1] = id
                    end
                end
            end
        end
    end
    return _server_container_cache[target_box_id] or {}
end

function stalker_camp_builder.iterate_server_container(box_id_or_se, callback)
    local type_ = type
    if not (box_id_or_se and callback) then return end
    local sim = alife()
    if not sim then return end

    local se_box = nil
    local box_id = nil
    if type_(box_id_or_se) == "number" then
        box_id = box_id_or_se
        se_box = sim:object(box_id)
    elseif type_(box_id_or_se) == "userdata" and box_id_or_se.id then
        se_box = box_id_or_se
        box_id = se_box.id
    end
    if not se_box or not box_id then return end

    local m_data = alife_storage_manager and alife_storage_manager.get_state()
    if m_data and m_data.workshop_stashes and m_data.workshop_stashes[box_id] then
        local ws_id = m_data.workshop_stashes[box_id]
        local ws_se = sim:object(ws_id)
        if ws_se then
            se_box = ws_se
            box_id = ws_id
        end
    end

    local items_found = 0
    local stopped = false

    if sim.get_children then
        local listed = pcall(function()
            for child_id in sim:get_children(se_box) do
                if child_id and child_id < 65535 then
                    local se_item = sim:object(child_id)
                    -- a reused id in the list names an object that isn't in the box
                    if se_item and se_item.parent_id == se_box.id then
                        items_found = items_found + 1
                        local stop = callback(child_id, se_item)
                        if stop == true then
                            stopped = true
                            return
                        end
                    end
                end
            end
        end)
        -- a completed pass lists the whole box, even an empty one (falling through would
        -- sweep every id up to 65534 in get_server_container_items)
        if listed or stopped or items_found > 0 then return end
    end

    if type_(se_box.children) == "table" then
        pcall(function()
            for _, child_id in ipairs(se_box.children) do
                if child_id and child_id < 65535 then
                    local se_item = sim:object(child_id)
                    if se_item and se_item.parent_id == se_box.id then
                        items_found = items_found + 1
                        local stop = callback(child_id, se_item)
                        if stop == true then
                            stopped = true
                            return
                        end
                    end
                end
            end
        end)
        if stopped or items_found > 0 then return end
    end

    local item_ids = stalker_camp_builder.get_server_container_items(box_id)
    for _, item_id in ipairs(item_ids) do
        local se_item = sim:object(item_id)
        if se_item and se_item.parent_id == box_id then
            local stop = callback(item_id, se_item)
            if stop == true then return end
        end
    end
end
local iterate_server_container = stalker_camp_builder.iterate_server_container

function safe_iterate_inventory_box(box_obj, callback)
    local type_ = type
    if not (box_obj and callback) then return end
    local obj_id = nil
    if type_(box_obj) == "number" then
        obj_id = box_obj
        box_obj = level and level.object_by_id and level.object_by_id(obj_id)
    else
        pcall(function() obj_id = box_obj:id() end)
        if not obj_id and type_(box_obj) == "userdata" and box_obj.id then
            pcall(function() obj_id = box_obj.id end)
        end
    end

    if obj_id and known_bad_inventory_boxes[obj_id] then
        local se = alife_object(obj_id)
        if se then
            local sec = se:section_name() or ""
            local c = se:clsid()
            if c == clsid.inventory_box or c == clsid.inventory_box_s or sec:find("workshop_stash") then
                known_bad_inventory_boxes[obj_id] = nil
            else
                return
            end
        else
            return
        end
    end

    if box_obj and type_(box_obj) == "userdata" and box_obj.clsid then
        local is_native_box = false
        pcall(function()
            local c = box_obj:clsid()
            if c == clsid.inventory_box or c == clsid.inventory_box_s then
                is_native_box = true
            end
        end)

        if is_native_box and box_obj.iterate_inventory_box then
            local iter_ok = pcall(function() box_obj:iterate_inventory_box(callback) end)
            if iter_ok then
                return
            end
        end
    end

    if obj_id then
        local se_box = alife_object(obj_id)
        if se_box then
            stalker_camp_builder.iterate_server_container(se_box, function(cid, se_item)
                local item_obj = level and level.object_by_id and level.object_by_id(cid)
                if item_obj then
                    callback(nil, item_obj)
                else
                    local dummy_item = {
                        section = function() return se_item:section_name() end,
                        id = function() return cid end,
                        condition = function() return se_item.condition or 1.0 end,
                        get_remaining_uses = function()
                            local ok_u, u = pcall(function() return se_item:get_remaining_uses() end)
                            return (ok_u and u) or 1
                        end
                    }
                    callback(nil, dummy_item)
                end
            end)
        end
    end
end

function is_actual_container(box_id)
    if not box_id then return false end
    local se_obj = alife_object(box_id)
    if not se_obj then return false end

    local sec = se_obj:section_name()
    if not sec then return false end
    local s = sec:lower()

    if s == "workshop_stash" or s:find("workshop_stash") then
        known_bad_inventory_boxes[box_id] = nil
        return true
    end

    if known_bad_inventory_boxes[box_id] then
        local c = se_obj:clsid()
        if c == clsid.inventory_box or c == clsid.inventory_box_s then
            known_bad_inventory_boxes[box_id] = nil
        else
            return false
        end
    end

    if s:find("table") or s:find("chair") or s:find("bed") or s:find("lamp") or s:find("radio")
       or s:find("piano") or s:find("turret") or s:find("barricade") or s:find("harvester")
       or s:find("display") or s:find("weapon_rack") or s:find("counter") then
        known_bad_inventory_boxes[box_id] = true
        return false
    end

    if s == "placeable_stove1" or s == "placeable_stove2" or s == "decor_stove" then
        known_bad_inventory_boxes[box_id] = true
        return false
    end

    local c = se_obj:clsid()
    if c == clsid.inventory_box or c == clsid.inventory_box_s then
        return true
    end

    -- only an inventory box holds items: a prop with a box's name ignores an item handed to it,
    -- and an item (a sleeping bag, a lead box, a decor kit) holds none
    known_bad_inventory_boxes[box_id] = true
    return false
end
stalker_camp_builder.is_actual_container = is_actual_container

-- Vector pack/unpack -- prevents save corruption.
local function pack_vector(v)
    if not v then return nil end
    local t = type(v)
    if t ~= "table" and t ~= "userdata" then return nil end
    if t == "table" and v.__packed_vector then return v end
    local ok_x, x = pcall(function() return v.x end)
    local ok_y, y = pcall(function() return v.y end)
    local ok_z, z = pcall(function() return v.z end)
    if not (ok_x and ok_y and ok_z) then return nil end
    if x == nil or y == nil or z == nil then return nil end
    return { __packed_vector = true, x = x, y = y, z = z }
end

local function unpack_vector(v)
    if not v then return nil end
    if type(v) ~= "table" then return v end
    if not v.__packed_vector then return v end
    if vector then
        return vector():set(v.x or 0, v.y or 0, v.z or 0)
    end
    return { x = v.x or 0, y = v.y or 0, z = v.z or 0 }
end

local function pack_table_vectors(tbl)
    local type_ = type
    if type_(tbl) ~= "table" then return tbl end
    if tbl.__packed_vector then return tbl end  -- already packed
    if tbl.x ~= nil and tbl.y ~= nil and tbl.z ~= nil and not next(tbl, 'z') then
        local packed = pack_vector(tbl)
        if packed then return packed end
    end
    local result = {}
    for k, v in pairs(tbl) do
        if type_(v) == "userdata" then
            local packed = pack_vector(v)
            result[k] = packed or v
        elseif type_(v) == "table" then
            result[k] = pack_table_vectors(v)
        else
            result[k] = v
        end
    end
    return result
end

local function unpack_table_vectors(tbl)
    if type(tbl) ~= "table" then return tbl end
    if tbl.__packed_vector then
        return unpack_vector(tbl)
    end
    local result = {}
    for k, v in pairs(tbl) do
        if type(v) == "table" then
            if v.__packed_vector then
                result[k] = unpack_vector(v)
            else
                result[k] = unpack_table_vectors(v)
            end
        else
            result[k] = v
        end
    end
    return result
end

function safe_alife_object(id)
    if not id then return nil end
    local ok, obj = pcall(alife_object, id)
    if ok and obj then return obj end
    return nil
end

function safe_level_object(id)
    if not id then return nil end
    local ok, obj = pcall(level.object_by_id, id)
    if ok and obj then return obj end
    return nil
end

function safe_position(obj)
    if not obj then return nil end
    local ok_client, pos_client = pcall(function() return obj:position() end)
    if ok_client and pos_client and type(pos_client) == "userdata" then
        return pos_client
    end
    local ok_se, pos_se = pcall(function() return obj.position end)
    if ok_se and pos_se and type(pos_se) == "userdata" then
        return pos_se
    end
    return nil
end

local function safe_distance(obj1, obj2)
    local pos1 = safe_position(obj1)
    local pos2 = safe_position(obj2)
    if not pos1 or not pos2 then return math.huge end
    local ok, dist = pcall(pos1.distance_to, pos1, pos2)
    if ok and type(dist) == "number" then return dist end
    return math.huge
end

local function safe_distance_sqr(obj1, obj2)
    local pos1 = safe_position(obj1)
    local pos2 = safe_position(obj2)
    if not pos1 or not pos2 then return math.huge end
    local ok, dist = pcall(pos1.distance_to_sqr, pos1, pos2)
    if ok and type(dist) == "number" then return dist end
    return math.huge
end

function safe_alife_release(obj)
    if not obj then return false end
    local ok = pcall(alife_release, obj)
    return ok
end

function safe_deferred_release(id)
    if not id then return end
    CreateTimeEvent("homestead_release", "rel_" .. tostring(id), 0.25, function()
        if actor_menu and actor_menu.is_open and actor_menu.is_open() then
            ResetTimeEvent("homestead_release", "rel_" .. tostring(id), 0.25)
            return false
        end
        hide_hud_inventory()
        local se = safe_alife_object(id)
        if se then
            pcall(alife_release, se)
        end
        return true
    end)
end
stalker_camp_builder.safe_deferred_release = safe_deferred_release

-- the ids of every outpost's chest and furniture: they stay the outpost's, which releases them when
-- it decays and garrisons them again on a takeover. Kept for a second; fresh rebuilds at once.
local outpost_ids, outpost_ids_tg = {}, nil
local function outpost_piece_ids(fresh)
    local tg = time_global()
    if not fresh and outpost_ids_tg and tg >= outpost_ids_tg and tg - outpost_ids_tg < 1000 then
        return outpost_ids
    end
    outpost_ids, outpost_ids_tg = {}, tg
    for _, rcamp in pairs(stalker_camp_builder.rival_camps or {}) do
        if type(rcamp) == "table" then
            if rcamp.chest_id then outpost_ids[rcamp.chest_id] = true end
            for _, did in ipairs(rcamp.decorations or {}) do
                outpost_ids[did] = true
            end
        end
    end
    return outpost_ids
end

function is_valid_camp_box(box_id, hub_id, camp)
    local type_ = type
    local sim = alife()
    if not box_id or type_(box_id) ~= "number" or box_id <= 0 or box_id >= 65535 then
        return false
    end
    -- an outpost's chest or ammo crate near the hub is not camp storage
    if outpost_piece_ids()[box_id] then
        return false
    end
    if not is_actual_container(box_id) then
        return false
    end

    local se_box = safe_alife_object(box_id)
    if not se_box then return false end
    -- a backpack the player drops as a stash is an inv_backpack box; stash furniture has a
    -- placeable_* section (sometimes with inv_backpack as its parent) and stays camp storage
    if se_box:section_name() == "inv_backpack" then return false end

    local sb = stalker_camp_builder
    if type_(hub_id) == "table" and type_(camp) ~= "table" then
        local tmp = hub_id
        hub_id = camp
        camp = tmp
    end
    if not hub_id and camp and camp.hub_id then
        hub_id = camp.hub_id
    end
    if not camp and hub_id and sb.active_camps then
        camp = sb.active_camps[hub_id]
    end
    if not hub_id and camp and sb.active_camps then
        for hid, c in pairs(sb.active_camps) do
            if c == camp then
                hub_id = hid
                camp.hub_id = hid
                break
            end
        end
    end

    local hub_obj = hub_id and safe_alife_object(hub_id)
    local hub_pos = hub_obj and hub_obj.position
    local gg = game_graph()

    if hub_obj and hub_obj.m_game_vertex_id and se_box.m_game_vertex_id and gg then
        local hub_v = gg:vertex(hub_obj.m_game_vertex_id)
        local box_v = gg:vertex(se_box.m_game_vertex_id)
        if not hub_v or not box_v or hub_v:level_id() ~= box_v:level_id() then
            return false
        end
        if camp and camp.level and camp.level ~= "unknown" and sim and sim.level_name then
            local ok_l, b_lvl = pcall(function() return sim:level_name(box_v:level_id()) end)
            if ok_l and b_lvl and b_lvl ~= camp.level then
                return false
            end
        end
    elseif camp and camp.level and camp.level ~= "unknown" and se_box.m_game_vertex_id and gg and sim and sim.level_name then
        local box_v = gg:vertex(se_box.m_game_vertex_id)
        if box_v then
            local ok_l, b_lvl = pcall(function() return sim:level_name(box_v:level_id()) end)
            if ok_l and b_lvl and b_lvl ~= camp.level then
                return false
            end
        end
    end

    if hub_pos and se_box.position then
        local sec = se_box:section_name() and se_box:section_name():lower() or ""
        local is_ws = (sec == "workshop_stash" or sec:find("workshop_stash") ~= nil)
        local y_diff = math.abs(se_box.position.y - hub_pos.y)
        if not is_ws and y_diff > 15.0 then return false end
        local bdist = (sb.cfg and sb.cfg.boundary_dist) or 50
        local dx = se_box.position.x - hub_pos.x
        local dz = se_box.position.z - hub_pos.z
        if (dx*dx + dz*dz) > (bdist * bdist) then
            return false
        end
    end

    return true
end
stalker_camp_builder.is_valid_camp_box = is_valid_camp_box

-- get_camp_containers -- gathers all valid container IDs belonging to a camp
function stalker_camp_builder.get_camp_containers(hub_id, camp)
    local sb = stalker_camp_builder
    local sim = alife()
    if not sim then return {} end

    if type(hub_id) == "table" and type(camp) ~= "table" then
        local tmp = hub_id; hub_id = camp; camp = tmp
    end
    if not camp and hub_id and sb.active_camps then
        camp = sb.active_camps[hub_id]
    end
    if not hub_id and camp and camp.hub_id then
        hub_id = camp.hub_id
    end
    if not hub_id and camp and sb.active_camps then
        for hid, c in pairs(sb.active_camps) do
            if c == camp then hub_id = hid; camp.hub_id = hid; break end
        end
    end

    local tg = time_global()
    if camp and camp._cached_containers and camp._cached_containers_tg and (tg - camp._cached_containers_tg) < 60000 then
        return camp._cached_containers
    end

    local containers = {}
    local seen = {}

    local function add_box(bid)
        if not bid or type(bid) ~= "number" or seen[bid] then return end

        local m_data = alife_storage_manager and alife_storage_manager.get_state()
        if m_data and m_data.workshop_stashes and m_data.workshop_stashes[bid] then
            local ws_id = m_data.workshop_stashes[bid]
            if ws_id and not seen[ws_id] and sb.is_valid_camp_box(ws_id, hub_id, camp) then
                seen[ws_id] = true
                containers[#containers + 1] = ws_id
            end
            seen[bid] = true
            return
        end

        if sb.is_valid_camp_box(bid, hub_id, camp) then
            seen[bid] = true
            containers[#containers + 1] = bid
        end
    end

    if camp and camp.primary_chest_id then
        add_box(camp.primary_chest_id)
    end

    if camp and camp.structures then
        for struct_id, struct_type in pairs(camp.structures) do
            add_box(struct_id)
        end
    end

    if hub_id and sb.camp_box_id_cache and sb.camp_box_id_cache[hub_id] then
        add_box(sb.camp_box_id_cache[hub_id].box_id)
    end

    if hub_id then
        add_box(hub_id)
    end

    if camp then
        camp._cached_containers = containers
        camp._cached_containers_tg = tg
    end

    return containers
end
local get_camp_containers = stalker_camp_builder.get_camp_containers

function stalker_camp_builder.consume_one_use(item_id)
    if not item_id then return false end
    local sb = stalker_camp_builder
    local known_uses = nil
    if sb and sb.active_camps then
        for _, c in pairs(sb.active_camps) do
            if c.stored_items and c.stored_items[item_id] then
                local it = c.stored_items[item_id]
                known_uses = it.uses
                if it.uses and it.uses > 1 then
                    local old_uses = it.uses
                    it.uses = it.uses - 1
                    local sec = it.sec
                    local ini = ini_sys or sys_ini or system_ini()
                    if sec and ini and ini:section_exist(sec) and ini:r_bool_ex(sec, "use_condition", false) then
                        local max_u = it.max_uses or ini:r_float_ex(sec, "max_uses") or old_uses
                        local full_w = ini:r_float_ex(sec, "inv_weight") or (it.weight or 0.1)
                        local empty_w = ini:r_float_ex(sec, "empty_weight") or 0.0
                        if max_u and max_u > 0 and full_w > empty_w then
                            it.weight = empty_w + (full_w - empty_w) * (it.uses / max_u)
                        end
                    end
                else
                    c.stored_items[item_id] = nil
                end
                break
            end
        end
    end
    if sb and sb.invalidate_server_container_cache then
        sb.invalidate_server_container_cache()
    end

    local cl_item = level and level.object_by_id and level.object_by_id(item_id)
    if cl_item then
        local ok_uses, uses = pcall(function() return cl_item:get_remaining_uses() end)
        if ok_uses and uses and uses > 1 then
            pcall(function() cl_item:set_remaining_uses(uses - 1) end)
            return true
        end
    end

    local se_item = alife_object(item_id)
    if se_item then
        -- Server objects have no uses API, so for an offline item the camp's record holds the
        -- uses left. While it says more than one, keep the item and owe the use:
        -- apply_pending_cond takes it off when the item is next online.
        if not cl_item and known_uses and known_uses > 1 then
            local pend = sb.pending_item_cond or {}
            sb.pending_item_cond = pend
            local e = pend[item_id]
            if type(e) ~= "table" then
                e = { c = e }
                pend[item_id] = e
            end
            e.s = e.s or se_item:section_name()
            e.u = (e.u or 0) + 1
            sb.save_pending_cond()
            sb.start_pending_cond_timer()
            return true
        end
        if sb.pending_item_cond then sb.pending_item_cond[item_id] = nil end
        alife_release(se_item)
    end
    return true
end
local consume_one_use = stalker_camp_builder.consume_one_use

-- UNIFIED SETTLEMENT INVENTORY SIMULATION CONTRACT
function stalker_camp_builder.camp_iterate_inventory(hub_id, camp, callback, priority_box_id)
    if not callback then return false end
    local sb = stalker_camp_builder
    local sim = alife()
    if not sim then return false end

    if not camp and hub_id and sb.active_camps then
        camp = sb.active_camps[hub_id]
    end
    if not hub_id and camp and camp.hub_id then
        hub_id = camp.hub_id
    end

    local containers = sb.get_camp_containers(hub_id, camp) or {}
    if #containers == 0 then return false end

    local box_order = {}
    local seen_boxes = {}
    if priority_box_id and sb.is_valid_camp_box(priority_box_id, hub_id, camp) then
        box_order[1] = priority_box_id
        seen_boxes[priority_box_id] = true
    end
    for _, bid in ipairs(containers) do
        if not seen_boxes[bid] then
            seen_boxes[bid] = true
            box_order[#box_order + 1] = bid
        end
    end

    local any_box_online = false
    for _, cid in ipairs(box_order) do
        local box_obj = level and level.object_by_id and level.object_by_id(cid)
        if box_obj and box_obj.iterate_inventory_box then
            any_box_online = true
            break
        end
    end

    if any_box_online then
        if camp then camp.stored_items = camp.stored_items or {} end
        for _, cid in ipairs(box_order) do
            local box_obj = level and level.object_by_id and level.object_by_id(cid)
            if box_obj and box_obj.iterate_inventory_box then
                local stopped = false
                local seen_in_box = {}
                sb.safe_iterate_inventory_box(box_obj, function(temp, cl_item)
                    if not cl_item then return end
                    local iid = cl_item:id()
                    seen_in_box[iid] = true
                    -- An item released earlier in this update has no server object any more, but the
                    -- box lists it until the client handles the destroy event next frame: skip it, or
                    -- every later count and consume in this update finds it again
                    local se_obj = sim:object(iid)
                    if not se_obj then return end
                    -- uses owed from offline consumption come off before the uses are read
                    if type(cl_item) == "userdata" and sb.pending_item_cond and sb.pending_item_cond[iid] then
                        sb.apply_pending_cond(cl_item)
                    end
                    local sec = cl_item:section()
                    local cond = 1.0
                    local ok_c, c = pcall(function() return cl_item:condition() end)
                    if ok_c and c then cond = c end
                    local uses = 1
                    local ok_u, u = pcall(function() return cl_item:get_remaining_uses() end)
                    if ok_u and u then uses = u end
                    local item_w = (cl_item.weight and cl_item:weight()) or nil
                    local ini = ini_sys or sys_ini or system_ini()
                    local max_u = (cl_item.get_max_uses and cl_item:get_max_uses()) or (ini and ini:section_exist(sec) and ini:r_float_ex(sec, "max_uses")) or uses

                    if camp and camp.stored_items then
                        camp.stored_items[iid] = {
                            sec = sec,
                            cond = cond,
                            uses = uses,
                            max_uses = max_u,
                            box_id = cid,
                            weight = item_w,
                            verified = true
                        }
                    end

                    local stop = callback(iid, sec, cond, uses, se_obj, cid, cl_item)
                    if stop == true then
                        stopped = true
                        return true
                    end
                end)
                if camp and camp.stored_items then
                    for stored_iid, stored_it in pairs(camp.stored_items) do
                        if stored_it.box_id == cid and not seen_in_box[stored_iid] then
                            -- the listing misses what a stopped scan never reached, and what was spawned
                            -- into the box this update (the client lists it from the next frame)
                            local se_stored = sim:object(stored_iid)
                            if not (se_stored and se_stored.parent_id == cid) then
                                camp.stored_items[stored_iid] = nil
                            end
                        end
                    end
                end
                if stopped then return true end
            else
                local stopped = false
                sb.iterate_server_container(cid, function(child_id, se_item)
                    if not (child_id and se_item) then return end
                    local sec = se_item:section_name()
                    local cond = se_item.condition or 1.0
                    local ini = ini_sys or sys_ini or system_ini()
                    local uses = 1
                    local seen = camp and camp.stored_items and camp.stored_items[child_id]
                    if seen and seen.sec == sec and seen.uses then
                        uses = seen.uses
                    else
                        uses = 1
                    end

                    if camp and camp.stored_items then
                        local same_sec = seen and seen.sec == sec
                        local max_u = (same_sec and seen.max_uses) or (ini and ini:section_exist(sec) and ini:r_float_ex(sec, "max_uses")) or uses
                        camp.stored_items[child_id] = {
                            sec = sec,
                            cond = cond,
                            uses = uses,
                            max_uses = max_u,
                            box_id = cid,
                            weight = (same_sec and seen.weight) or nil,
                            verified = (same_sec and seen.verified) or false
                        }
                    end

                    local stop = callback(child_id, sec, cond, uses, se_item, cid, nil)
                    if stop == true then
                        stopped = true
                        return true
                    end
                end)
                if stopped then return true end
            end
        end
    else
        -- OFFLINE SETTLEMENT INVENTORY SIMULATION CONTRACT
        camp = camp or (hub_id and sb.active_camps and sb.active_camps[hub_id])
        if camp then
            camp.stored_items = camp.stored_items or {}
            local has_any = false
            for _ in pairs(camp.stored_items) do has_any = true; break end
            if not has_any then
                for _, cid in ipairs(box_order) do
                    sb.iterate_server_container(cid, function(child_id, se_item)
                        if child_id and se_item then
                            local sec = se_item:section_name()
                            local cond = se_item.condition or 1.0
                            local ini = ini_sys or sys_ini or system_ini()
                            local uses = 1
                            local max_u = (ini and ini:section_exist(sec) and ini:r_float_ex(sec, "max_uses")) or 1
                            camp.stored_items[child_id] = {
                                sec = sec,
                                cond = cond,
                                uses = uses,
                                max_uses = max_u,
                                box_id = cid
                            }
                        end
                    end)
                end
            end

            for iid, it in pairs(camp.stored_items) do
                local se_obj = sim:object(iid)
                -- only what is still in one of this camp's boxes, and still the same item
                if not se_obj or not seen_boxes[se_obj.parent_id] or se_obj:section_name() ~= it.sec then
                    camp.stored_items[iid] = nil
                else
                    local stop = callback(iid, it.sec, it.cond or 1.0, it.uses or 1, se_obj, it.box_id, nil)
                    if stop == true then return true end
                end
            end
        else
            for _, cid in ipairs(box_order) do
                local stopped = false
                sb.iterate_server_container(cid, function(child_id, se_item)
                    if not (child_id and se_item) then return end
                    local sec = se_item:section_name()
                    local cond = se_item.condition or 1.0
                    local uses = 1
                    local stop = callback(child_id, sec, cond, uses, se_item, cid, nil)
                    if stop == true then
                        stopped = true
                        return true
                    end
                end)
                if stopped then return true end
            end
        end
    end

    return false
end
local camp_iterate_inventory = stalker_camp_builder.camp_iterate_inventory

function stalker_camp_builder.invalidate_camp_inventory_cache(hub_id, camp)
    local sb = stalker_camp_builder
    if not camp and hub_id and sb.active_camps then
        camp = sb.active_camps[hub_id]
    end
    if camp then
        camp._inv_snapshot = nil
        camp._inv_snapshot_tg = nil
        camp._inv_snapshot_dirty = nil
        camp._cached_box_weights = nil
        camp._cached_chest_supplies_tg = nil
        camp._cached_storage_metrics_tg = nil
        if camp.survivors then
            for _, s in pairs(camp.survivors) do
                s._cached_paused_tg = nil
            end
        end
    end
end
local invalidate_camp_inventory_cache = stalker_camp_builder.invalidate_camp_inventory_cache

function stalker_camp_builder.on_actor_box_change(box_id, obj, is_put)
    if not box_id then return end
    local sb = stalker_camp_builder
    if not sb.active_camps then return end
    for hub_id, camp in pairs(sb.active_camps) do
        local is_camp_box = false
        if camp.primary_chest_id == box_id then
            is_camp_box = true
        elseif camp.structures and camp.structures[box_id] then
            is_camp_box = true
        elseif camp._cached_containers then
            for _, cid in ipairs(camp._cached_containers) do
                if cid == box_id then
                    is_camp_box = true
                    break
                end
            end
        end
        if is_camp_box then
            if obj and camp.stored_items then
                local iid = obj:id()
                if is_put == false then
                    camp.stored_items[iid] = nil
                elseif is_put == true then
                    local sec = obj:section()
                    local cond = 1.0
                    local ok_c, c = pcall(function() return obj:condition() end)
                    if ok_c and c then cond = c end
                    local uses = 1
                    local ok_u, u = pcall(function() return obj:get_remaining_uses() end)
                    if ok_u and u then uses = u end
                    local item_w = (obj.weight and obj:weight()) or nil
                    local ini = ini_sys or sys_ini or system_ini()
                    local max_u = (obj.get_max_uses and obj:get_max_uses()) or (ini and ini:section_exist(sec) and ini:r_float_ex(sec, "max_uses")) or uses
                    camp.stored_items[iid] = {
                        sec = sec,
                        cond = cond,
                        uses = uses,
                        max_uses = max_u,
                        box_id = box_id,
                        weight = item_w,
                        verified = true
                    }
                end
            end
            invalidate_camp_inventory_cache(hub_id, camp)
            break
        end
    end
end

function stalker_camp_builder.get_camp_inventory_snapshot(hub_id, camp, force)
    local sb = stalker_camp_builder
    if not camp and hub_id and sb.active_camps then
        camp = sb.active_camps[hub_id]
    end
    if not hub_id and camp and camp.hub_id then
        hub_id = camp.hub_id
    end
    if not camp then return nil end

    local now_tg = time_global()
    if not force and not camp._inv_snapshot_dirty and camp._inv_snapshot and camp._inv_snapshot_tg and (now_tg - camp._inv_snapshot_tg) < 10000 then
        return camp._inv_snapshot
    end

    local ini = ini_sys or sys_ini or system_ini()
    local boxes = (sb.get_camp_containers and sb.get_camp_containers(hub_id, camp)) or {}

    local fridge_id = nil
    for struct_id, struct_type in pairs(camp.structures or {}) do
        if struct_type == "fridge" and (sb.is_actual_container and sb.is_actual_container(struct_id)) then
            fridge_id = struct_id
            break
        end
    end

    local m_data = alife_storage_manager and alife_storage_manager.get_state and alife_storage_manager.get_state()
    local ws = m_data and m_data.workshop_stashes or {}
    local wb_only = {}
    if hub_id and ws[hub_id] then wb_only[ws[hub_id]] = true end
    for sid, stype in pairs(camp.structures or {}) do
        if stype == "workbench" or stype == "repair_bench" then
            wb_only[ws[sid] or sid] = true
        end
    end
    if hub_id then wb_only[hub_id] = true end

    local max_weight = 0
    for _, bid in ipairs(boxes) do
        max_weight = max_weight + (sb.get_box_capacity(bid) or 60)
    end
    if max_weight <= 0 then max_weight = 60 end

    local snapshot = {
        total_items = 0,
        total_weight = 0,
        max_weight = max_weight,
        food_count = 0,
        has_food = false,
        raw_meat_count = 0,
        fridge_raw_meat_count = 0,
        fridge_id = fridge_id,
        clean_water_count = 0,
        has_water = false,
        water_filter_count = 0,
        has_powder = false,
        has_scrap = false,
        ammo_counts = {
            pistol = 0,
            shotgun = 0,
            rifle_soviet = 0,
            rifle_nato = 0,
            rifle_heavy = 0,
            sniper = 0,
            turret = 0,
            auto = 0,
        },
        turret_9mm_rounds = 0,
        has_damaged_gear = false,
        has_repair_fee = false,
        med_counts = {
            akvatab = 0,
            kalium = 0,
            medkit = 0,
            bandage = 0,
            auto = 0,
        },
        total_ethanol = 0,
        has_cloth = false,
        has_bandage = false,
        has_battery = false,
        wood_count = 0,
        charcoal_count = 0,
        box_weights = {},
    }

    local raw_meats = {
        ["mutant_part_tushkano_meat"]  = true,
        ["mutant_part_dog_meat"]       = true,
        ["mutant_part_psevdodog_meat"] = true,
        ["mutant_part_flesh_meat"]     = true,
        ["mutant_part_boar_chop"]      = true,
        ["mutant_part_snork_hand"]     = true,
        ["mutant_part_krovosos_meat"]  = true,
        ["mutant_part_psysucker_meat"] = true,
        ["mutant_part_lurker_meat"]    = true,
        ["mutant_part_chimera_meat"]   = true,
    }

    if sb.camp_iterate_inventory then
        sb.camp_iterate_inventory(hub_id, camp, function(item_id, sec, cond, uses, se_obj, cid, cl_item)
            if not sec then return end
            snapshot.total_items = snapshot.total_items + 1

            local s = sec:lower()
            local u = uses or 1
            if u < 1 then u = 1 end

            local w = 0.1
            if cl_item and cl_item.weight then
                local ok_w, iw = pcall(function() return cl_item:weight() end)
                if ok_w and iw then w = iw end
            elseif ini and ini:section_exist(sec) then
                w = ini:r_float_ex(sec, "inv_weight") or 0.1
            end
            snapshot.total_weight = snapshot.total_weight + w

            if s:find("_cooked") or (s:sub(1, 5) == "meat_" and (s:sub(-2) == "_b" or s:sub(-2) == "_a"))
               or s == "meat_tushkano" or s == "meat_dog" or s == "meat_pseudodog"
               or s == "meat_flesh" or s == "meat_boar" or s == "meat_bloodsucker"
               or s == "meat_snork" or s == "meat_chimera" or s == "meat_lurker"
               or s == "meat_psysucker" or s == "kolbasa" then
                snapshot.food_count = snapshot.food_count + 1
            end

            if not snapshot.has_food then
                if s:find("conserva", 1, true) or s:find("tushonka", 1, true) or s:find("kolbasa", 1, true)
                   or s:find("bread", 1, true) or s:find("meat", 1, true) or s:find("sausage", 1, true)
                   or s:find("stew", 1, true) or s:find("ration", 1, true) or s == "vodka" or s == "beer"
                   or s == "chocolate" or s:find("mre", 1, true) or s:find("nuts", 1, true) then
                    snapshot.has_food = true
                end
            end

            if raw_meats[sec] or raw_meats[s] then
                snapshot.raw_meat_count = snapshot.raw_meat_count + 1
                if cid and fridge_id and cid == fridge_id then
                    snapshot.fridge_raw_meat_count = snapshot.fridge_raw_meat_count + 1
                end
            end

            if sb.is_clean_water and sb.is_clean_water(sec) then
                snapshot.clean_water_count = snapshot.clean_water_count + 1
            end

            if not snapshot.has_water then
                if s:find("water", 1, true) or s:find("bottle", 1, true) or s:find("flask", 1, true)
                   or s == "energy_drink" or s == "beer" or s:find("drink", 1, true) or s:find("canteen", 1, true)
                   or s == "mineral_water" then
                    snapshot.has_water = true
                end
            end

            if sb.cfg and sb.cfg.water_filters and (sb.cfg.water_filters[sec] or sb.cfg.water_filters[s]) then
                snapshot.water_filter_count = snapshot.water_filter_count + 1
            end

            if not snapshot.has_powder then
                if sb.is_gunpowder and sb.is_gunpowder(s) then
                    snapshot.has_powder = true
                end
            end

            if not snapshot.has_scrap then
                if sb.is_scrap and sb.is_scrap(sec) then
                    snapshot.has_scrap = true
                end
            end

            if s:find("^ammo_") then
                snapshot.ammo_counts.auto = snapshot.ammo_counts.auto + 1
                if s:find("ammo_9x18") or s:find("ammo_9x19") or s:find("ammo_11.43x23") or s:find("ammo_7.62x25") or s:find("ammo_357") then
                    snapshot.ammo_counts.pistol = snapshot.ammo_counts.pistol + 1
                end
                if s:find("ammo_12x70") or s:find("ammo_12x76") or s:find("ammo_20x70") or s:find("ammo_23x75") then
                    snapshot.ammo_counts.shotgun = snapshot.ammo_counts.shotgun + 1
                end
                if s:find("ammo_5.45x39") then
                    snapshot.ammo_counts.rifle_soviet = snapshot.ammo_counts.rifle_soviet + 1
                end
                if s:find("ammo_5.56x45") then
                    snapshot.ammo_counts.rifle_nato = snapshot.ammo_counts.rifle_nato + 1
                end
                if s:find("ammo_7.62x39") then
                    snapshot.ammo_counts.rifle_heavy = snapshot.ammo_counts.rifle_heavy + 1
                end
                if s:find("ammo_7.62x54") or s:find("ammo_7.62x51") or s:find("ammo_9x39") or s:find("ammo_magnum_338") or s:find("ammo_12.7x55") then
                    snapshot.ammo_counts.sniper = snapshot.ammo_counts.sniper + 1
                end
                if s:find("ammo_9x19") or s:find("ammo_9x18") then
                    snapshot.ammo_counts.turret = snapshot.ammo_counts.turret + 1
                    if cl_item then
                        local b_count = 20
                        pcall(function() b_count = cl_item:ammo_get_count() or 20 end)
                        snapshot.turret_9mm_rounds = snapshot.turret_9mm_rounds + b_count
                    end
                end
            end

            if not snapshot.has_repair_fee then
                if sb.is_repair_fee and sb.is_repair_fee(sec) then
                    snapshot.has_repair_fee = true
                end
            end
            if not snapshot.has_damaged_gear then
                local in_bench = wb_only[cid] and cl_item
                if in_bench and (s:find("wpn_") or s:find("helm_") or s:find("armor_") or s:find("outfit")) then
                    local c_val = cond or 1.0
                    local worn_parts = false
                    if item_id and sb.gun_parts_worn then
                        pcall(function() worn_parts = sb.gun_parts_worn(item_id, sec) end)
                    end
                    if c_val < 0.95 or worn_parts then
                        snapshot.has_damaged_gear = true
                    end
                end
            end

            if s:find("medkit") or s:find("bandage") or s:find("antirad") or s:find("stimpack") or s:find("salve") or s == "akvatab" or s == "antirad_kalium" or s == "drug_booster" or s:find("ibuprofen") ~= nil then
                snapshot.med_counts.auto = snapshot.med_counts.auto + 1
            end
            if s == "akvatab" or s == "drug_booster" or s:find("ibuprofen") ~= nil then
                snapshot.med_counts.akvatab = snapshot.med_counts.akvatab + 1
            end
            if s == "antirad_kalium" or s == "antirad" or s:find("kalium") ~= nil then
                snapshot.med_counts.kalium = snapshot.med_counts.kalium + 1
            end
            if s:find("medkit") ~= nil then
                snapshot.med_counts.medkit = snapshot.med_counts.medkit + 1
            end
            if s:find("bandage") ~= nil then
                snapshot.med_counts.bandage = snapshot.med_counts.bandage + 1
                snapshot.has_bandage = true
            end

            if s:find("vodka") or s:find("antiseptic") or s == "alcohol" then
                snapshot.total_ethanol = snapshot.total_ethanol + u
            end

            if not snapshot.has_cloth then
                if sb.is_cloth and sb.is_cloth(sec) then
                    snapshot.has_cloth = true
                end
            end

            if not snapshot.has_battery then
                if sb.is_lamp_battery and sb.is_lamp_battery(sec) then
                    snapshot.has_battery = true
                end
            end

            if cid then
                snapshot.box_weights[cid] = (snapshot.box_weights[cid] or 0) + w
            end

            if sec == "charcoal" or sec:find("charcoal") then
                snapshot.charcoal_count = snapshot.charcoal_count + u
            end

            if sb.is_wood_part and sb.is_wood_part(sec) then
                snapshot.wood_count = snapshot.wood_count + u
            end
        end)
    end

    snapshot.has_storage_room = (snapshot.total_weight + 0.5) <= snapshot.max_weight

    camp._inv_snapshot = snapshot
    camp._inv_snapshot_tg = now_tg
    camp._inv_snapshot_dirty = nil
    camp._cached_box_weights = snapshot.box_weights
    camp._cached_chest_supplies_tg = now_tg
    camp._cached_has_food = snapshot.has_food
    camp._cached_has_water = snapshot.has_water
    camp._cached_storage_metrics_tg = now_tg
    camp._cached_storage_metrics = {
        weight = math.floor(snapshot.total_weight),
        max_weight = snapshot.max_weight,
        total_items = snapshot.total_items,
        pct = math.min(100, math.floor((snapshot.total_weight / snapshot.max_weight) * 100))
    }

    return snapshot
end
local get_camp_inventory_snapshot = stalker_camp_builder.get_camp_inventory_snapshot

function stalker_camp_builder.camp_find_item(hub_id, camp, filter_fn, priority_box_id)
    if not filter_fn then return nil end
    local sb = stalker_camp_builder
    local res = nil
    sb.camp_iterate_inventory(hub_id, camp, function(item_id, sec, cond, uses, se_obj, cid, cl_item)
        if filter_fn(sec, cond, uses, se_obj, cl_item) then
            res = {
                sec = sec,
                id = item_id,
                box_id = cid,
                cond = cond,
                uses = uses,
                se = se_obj,
                cl = cl_item
            }
            return true
        end
    end, priority_box_id)

    if res then
        return res.sec, res.id, res.box_id, res.cond, res.uses, res.se
    end
    return nil
end
local camp_find_item = stalker_camp_builder.camp_find_item

function stalker_camp_builder.camp_consume_item(hub_id, camp, filter_fn, priority_box_id)
    local sb = stalker_camp_builder
    local sec, id, box_id = sb.camp_find_item(hub_id, camp, filter_fn, priority_box_id)
    if sec and id then
        sb.consume_one_use(id)
        if sb.invalidate_server_container_cache and box_id then
            sb.invalidate_server_container_cache(box_id)
        end
        if not camp and hub_id and sb.active_camps then
            camp = sb.active_camps[hub_id]
        end
        if camp then
            camp._inv_snapshot_dirty = true
            camp._cached_box_weights = nil
            camp._cached_chest_supplies_tg = nil
            camp._cached_storage_metrics_tg = nil
        end
        return sec, id, box_id
    end
    return nil
end
local camp_consume_item = stalker_camp_builder.camp_consume_item

function stalker_camp_builder.camp_count_item(hub_id, camp, filter_fn, stop_at_cap)
    local sb = stalker_camp_builder
    local count = 0
    sb.camp_iterate_inventory(hub_id, camp, function(item_id, sec, cond, uses, se_obj, cid, cl_item)
        if filter_fn(sec, cond, uses, se_obj) then
            count = count + 1
            if stop_at_cap and count >= stop_at_cap then
                return true
            end
        end
    end)
    return count
end
local camp_count_item = stalker_camp_builder.camp_count_item

local camp_has_item = stalker_camp_builder.camp_has_item

