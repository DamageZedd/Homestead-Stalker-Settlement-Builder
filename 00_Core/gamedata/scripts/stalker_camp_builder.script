local structure_type_substrings = {
    bed          = {"bed", "couch", "sleep", "tent", "cot"},
    stove        = {"stove", "campfire"},
    barricade    = {"barricade", "sandbag", "fence", "screen", "barrier", "board", "plank", "plate", "shield"},
    water_pump   = {"pump", "well", "water", "sink", "bidon"},
    alarm        = {"alarm"},
    gadget       = {"turret", "tesla", "mine", "claymore", "gadget"},
    fridge       = {"fridge"},
    workbench    = {"workbench", "anvil", "forge", "workshop"},
    repair_bench = {"repair_kit", "repair_bench", "exo_repair", "toolbox"},
    medstation   = {"med_", "medical", "medkit", "medstation", "firstaid", "first_aid", "medicine"},
    piano        = {"piano"},
    radio        = {"radio", "radiola", "reciever"},
    stash        = {"box", "crate", "chest", "cabinet", "stash", "container", "blue_box", "ammo_box", "locker"},
}

local structure_type_check_order = {
    "gadget", "fridge", "stove", "bed", "barricade", "water_pump",
    "alarm", "workbench", "repair_bench", "medstation", "piano", "radio",
    "stash",  -- broad catch-all always last
}

function resolve_structure_type(se_obj)
    local sec = se_obj:section_name()
    if structure_type_exact[sec] then return structure_type_exact[sec] end
    for _, stype in ipairs(structure_type_check_order) do
        local substrings = structure_type_substrings[stype]
        if substrings then
            for _, sub in ipairs(substrings) do
                if sec:find(sub, 1, true) then return stype end
            end
        end
    end
    local hf_type = hf_furniture_types and hf_furniture_types.get_type(se_obj)
    if hf_type then return hf_type end

    return "unknown"
end

-- The camp's "main chest" must be a general storage box. Older saves could
-- have remembered a fridge, medstation, workbench etc., which then received
-- every item. Forget such a choice so a proper stash gets picked.
local SPECIALIZED_CONTAINER_TYPES = {
    fridge = true, stove = true, medstation = true, workbench = true,
    repair_bench = true, water_pump = true, harvester = true,
    weapon_rack = true, display_counter = true,
}
function stalker_camp_builder.sanitize_primary_chest(camp)
    if not (camp and camp.primary_chest_id) then return end
    local t = camp.structures and camp.structures[camp.primary_chest_id]
    if t and SPECIALIZED_CONTAINER_TYPES[t] then
        camp.primary_chest_id = nil
    end
end

function find_best_container(hub_id, camp, preferred_types, fallback_box_id)
    local pairs_ = pairs
    local sb = stalker_camp_builder
    if type(hub_id) == "table" and type(camp) ~= "table" then
        local tmp = hub_id
        hub_id = camp
        camp = tmp
    end
    if not camp and hub_id and sb.active_camps then
        camp = sb.active_camps[hub_id]
    end
    if not hub_id and camp and camp.hub_id then
        hub_id = camp.hub_id
    end
    if not hub_id and camp and sb.active_camps then
        for hid, c in pairs(sb.active_camps) do
            if c == camp then hub_id = hid; camp.hub_id = hid; break end
        end
    end

    local hub_obj = hub_id and safe_alife_object(hub_id)
    if not hub_obj then
        if fallback_box_id and is_valid_camp_box(fallback_box_id, hub_id, camp) then
            return fallback_box_id
        end
        return nil
    end

    sb.sanitize_primary_chest(camp)
    if camp and camp.primary_chest_id and not is_valid_camp_box(camp.primary_chest_id, hub_id, camp) then
        camp.primary_chest_id = nil
    end

    local best_id = nil
    local min_dist = 99999
    preferred_types = preferred_types or {}

    for _, ptype in ipairs(preferred_types) do
        for struct_id, struct_type in pairs_(camp and camp.structures or {}) do
            if struct_type == ptype and is_valid_camp_box(struct_id, hub_id, camp) then
                local obj = safe_alife_object(struct_id)
                if obj and obj.position and hub_obj.position then
                    local dist = obj.position:distance_to(hub_obj.position)
                    if dist < min_dist then
                        min_dist = dist
                        best_id = struct_id
                    end
                end
            end
        end
        if best_id then break end
    end

    -- No container of the requested kind: use the camp's main chest.
    if not best_id and camp and camp.primary_chest_id then
        best_id = camp.primary_chest_id
    end

    -- General fallback: nearest plain stash; only use a fridge if no stash exists.
    for _, generic_type in ipairs({"stash", "fridge"}) do
        if best_id then break end
        for struct_id, struct_type in pairs_(camp and camp.structures or {}) do
            if struct_type == generic_type and is_valid_camp_box(struct_id, hub_id, camp) then
                local obj = safe_alife_object(struct_id)
                if obj and obj.position and hub_obj.position then
                    local dist = obj.position:distance_to(hub_obj.position)
                    if dist < min_dist then
                        min_dist = dist
                        best_id = struct_id
                    end
                end
            end
        end
    end

    if not best_id then
        for struct_id, _ in pairs_(camp and camp.structures or {}) do
            if is_valid_camp_box(struct_id, hub_id, camp) then
                best_id = struct_id
                break
            end
        end
    end

    if not best_id and fallback_box_id and is_valid_camp_box(fallback_box_id, hub_id, camp) then
        best_id = fallback_box_id
    end

    if not best_id and camp and hub_id and sb.get_auto_sort_target_box then
        best_id = sb.get_auto_sort_target_box(camp, hub_id, "stash")
    end

    -- Only remember general storage boxes as the main chest.
    if best_id and camp and not camp.primary_chest_id then
        local t = camp.structures and camp.structures[best_id]
        if not (t and SPECIALIZED_CONTAINER_TYPES[t]) then
            camp.primary_chest_id = best_id
        end
    end

    return best_id
end
stalker_camp_builder.find_best_container = find_best_container

local scan_camp_structures_last_run = {}

function scan_camp_structures(hub_id, force)
    local camp = stalker_camp_builder.active_camps[hub_id]
    if not camp then return end

    local hub_obj = alife_object(hub_id)
    if not hub_obj then return end

    local now_tg = time_global()
    local last_run = scan_camp_structures_last_run[hub_id] or 0

    if (now_tg - last_run) < 15000 and not force_instant_placement and not force then
        local cached = scan_camp_structures_cache[hub_id]
        if cached then
            camp.structures = cached.structures
            return
        end
    end

    if not force then
        local cached = scan_camp_structures_cache[hub_id]
        if cached and now_tg < cached.expires_tg then
            camp.structures = cached.structures
            return
        end
    end

    scan_camp_structures_last_run[hub_id] = now_tg

    local new_structures = {}
    local hub_pos = hub_obj.position

    local gg = game_graph()
    local sim = alife()
    if not (gg and sim and hub_obj.m_game_vertex_id) then return end
    local hub_vertex = gg:vertex(hub_obj.m_game_vertex_id)
    if not hub_vertex then return end
    local hub_level_id = hub_vertex:level_id()
    -- an outpost's pieces near the hub stay the outpost's
    local outposts = outpost_piece_ids(true)

    local function evaluate_furniture_candidate(id, se_obj)
        if id ~= hub_id and not outposts[id] and se_obj and se_obj.parent_id == 65535 and se_obj.m_game_vertex_id then
            local vertex = gg:vertex(se_obj.m_game_vertex_id)
            if vertex and vertex:level_id() == hub_level_id then
                local ok_sec, sec = pcall(function() return se_obj:section_name() end)
                if ok_sec and sec then
                    local s_sec_lower = sec:lower()
                    local c_id = se_obj.clsid and se_obj:clsid()
                    local is_real_box = (c_id == clsid.inventory_box or c_id == clsid.inventory_box_s or s_sec_lower:find("inventory_box") or s_sec_lower:find("backpack") or s_sec_lower:find("safe") or s_sec_lower:find("stash"))
                    local is_furniture = (not s_sec_lower:find("workshop_stash")) and (is_real_box or sec:find("placeable_") or sec:find("rival_") or sec:find("hg_") or sec:find("turret") or sec:find("alarm"))
                    if not is_furniture and hf_furniture_types and not s_sec_lower:find("workshop_stash") then
                        pcall(function() is_furniture = hf_furniture_types.get_type(se_obj) end)
                    end
                    if is_furniture and se_obj.position and hub_pos then
                        local y_diff = math.abs(se_obj.position.y - hub_pos.y)
                        if y_diff <= 12.0 then
                            local dist = se_obj.position:distance_to(hub_pos)
                            if is_real_box or sec:find("_stash") then
                                local dx = se_obj.position.x - hub_pos.x
                                local dz = se_obj.position.z - hub_pos.z
                                dist = math.sqrt(dx*dx + dz*dz)
                            end
                            if dist <= cfg.boundary_dist then
                                local ok_stype, stype = pcall(resolve_structure_type, se_obj)
                                if ok_stype and stype and stype ~= "unknown" then
                                    new_structures[id] = stype
                                elseif is_real_box and not s_sec_lower:find("workshop_stash") then
                                    new_structures[id] = "stash"
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    local registry = _G.server_objects_registry
    if registry then
        for id, se_obj in pairs(registry) do
            evaluate_furniture_candidate(id, se_obj)
        end
    else
        -- DANZY EDIT: direct lookups (no pcall wrapper) for this 65k-object sweep.
        for id = 1, 65534 do
            local se_obj = sim:object(id)
            if se_obj then
                evaluate_furniture_candidate(id, se_obj)
            end
        end
    end

    camp.structures = new_structures
    camp._cached_containers = nil
    camp._cached_containers_tg = nil
    camp._cached_categorized_boxes = nil
    camp._inv_snapshot = nil
    camp._inv_snapshot_tg = nil
    camp._cached_chest_supplies_tg = nil
    camp._cached_storage_metrics_tg = nil
    camp._stats_cache_tick = nil
    camp._stats_cache = nil
    scan_camp_structures_cache[hub_id] = {
        structures = camp.structures,
        expires_tg = now_tg + 600000,  -- DANZY EDIT: was 2 min; placing/removing furniture already forces a rescan
    }
end

function scan_multiple_camp_structures(hub_ids, force)
    if not hub_ids or #hub_ids == 0 then return end
    if #hub_ids == 1 then
        return scan_camp_structures(hub_ids[1], force)
    end

    local gg = game_graph()
    local sim = alife()
    if not (gg and sim) then return end

    local now_tg = time_global()
    local outposts = outpost_piece_ids(true)
    local camps_data = {}

    for _, hub_id in ipairs(hub_ids) do
        local camp = stalker_camp_builder.active_camps[hub_id]
        local hub_obj = camp and alife_object(hub_id)
        if camp and hub_obj and hub_obj.m_game_vertex_id then
            local hub_vertex = gg:vertex(hub_obj.m_game_vertex_id)
            if hub_vertex then
                camps_data[#camps_data + 1] = {
                    hub_id = hub_id,
                    camp = camp,
                    hub_pos = hub_obj.position,
                    hub_level_id = hub_vertex:level_id(),
                    new_structures = {},
                }
                scan_camp_structures_last_run[hub_id] = now_tg
            end
        end
    end

    if #camps_data == 0 then return end

    local function evaluate_multi(id, se_obj)
        if not (se_obj and se_obj.parent_id == 65535 and se_obj.m_game_vertex_id) then return end
        if outposts[id] then return end

        local vertex = gg:vertex(se_obj.m_game_vertex_id)
        if not vertex then return end
        local obj_level_id = vertex:level_id()

        local has_level_match = false
        for _, cdata in ipairs(camps_data) do
            if cdata.hub_level_id == obj_level_id and id ~= cdata.hub_id then
                has_level_match = true
                break
            end
        end
        if not has_level_match then return end

        local ok_sec, sec = pcall(function() return se_obj:section_name() end)
        if not (ok_sec and sec) then return end
        local s_sec_lower = sec:lower()
        local c_id = se_obj.clsid and se_obj:clsid()
        local is_real_box = (c_id == clsid.inventory_box or c_id == clsid.inventory_box_s or s_sec_lower:find("inventory_box") or s_sec_lower:find("backpack") or s_sec_lower:find("safe") or s_sec_lower:find("stash"))
        local is_furniture = (not s_sec_lower:find("workshop_stash")) and (is_real_box or sec:find("placeable_") or sec:find("rival_") or sec:find("hg_") or sec:find("turret") or sec:find("alarm"))
        if not is_furniture and hf_furniture_types and not s_sec_lower:find("workshop_stash") then
            pcall(function() is_furniture = hf_furniture_types.get_type(se_obj) end)
        end
        if not (is_furniture and se_obj.position) then return end

        for _, cdata in ipairs(camps_data) do
            if cdata.hub_level_id == obj_level_id and id ~= cdata.hub_id then
                local hub_pos = cdata.hub_pos
                local y_diff = math.abs(se_obj.position.y - hub_pos.y)
                if y_diff <= 12.0 then
                    local dist = se_obj.position:distance_to(hub_pos)
                    if is_real_box or sec:find("_stash") then
                        local dx = se_obj.position.x - hub_pos.x
                        local dz = se_obj.position.z - hub_pos.z
                        dist = math.sqrt(dx*dx + dz*dz)
                    end
                    if dist <= cfg.boundary_dist then
                        local ok_stype, stype = pcall(resolve_structure_type, se_obj)
                        if ok_stype and stype and stype ~= "unknown" then
                            cdata.new_structures[id] = stype
                        elseif is_real_box and not s_sec_lower:find("workshop_stash") then
                            cdata.new_structures[id] = "stash"
                        end
                    end
                end
            end
        end
    end

    local registry = _G.server_objects_registry
    if registry then
        for id, se_obj in pairs(registry) do
            evaluate_multi(id, se_obj)
        end
    else
        for id = 1, 65534 do
            local se_obj = sim:object(id)
            if se_obj then
                evaluate_multi(id, se_obj)
            end
        end
    end

    for _, cdata in ipairs(camps_data) do
        local camp = cdata.camp
        local hub_id = cdata.hub_id
        camp.structures = cdata.new_structures
        camp._cached_containers = nil
        camp._cached_containers_tg = nil
        camp._cached_categorized_boxes = nil
        camp._inv_snapshot = nil
        camp._inv_snapshot_tg = nil
        camp._cached_chest_supplies_tg = nil
        camp._cached_storage_metrics_tg = nil
        camp._stats_cache_tick = nil
        camp._stats_cache = nil
        scan_camp_structures_cache[hub_id] = {
            structures = camp.structures,
            expires_tg = now_tg + 600000,
        }
    end
end
stalker_camp_builder.scan_multiple_camp_structures = scan_multiple_camp_structures

function invalidate_scan_camp_structures_cache(hub_id)
    if hub_id then
        scan_camp_structures_cache[hub_id] = nil
        stalker_camp_builder.camp_box_id_cache[hub_id] = nil
        local c = stalker_camp_builder.active_camps and stalker_camp_builder.active_camps[hub_id]
        if c then
            c._cached_containers = nil
            c._cached_containers_tg = nil
            c._cached_categorized_boxes = nil
            c._inv_snapshot = nil
            c._inv_snapshot_tg = nil
            c._cached_chest_supplies_tg = nil
            c._cached_storage_metrics_tg = nil
        end
    else
        scan_camp_structures_cache = {}
        stalker_camp_builder.camp_box_id_cache = {}
        if stalker_camp_builder.active_camps then
            for _, c in pairs(stalker_camp_builder.active_camps) do
                c._cached_containers = nil
                c._cached_containers_tg = nil
                c._cached_categorized_boxes = nil
                c._inv_snapshot = nil
                c._inv_snapshot_tg = nil
                c._cached_chest_supplies_tg = nil
                c._cached_storage_metrics_tg = nil
            end
        end
    end
end

function get_camp_label(camp)
    local name = camp.name
    if not name or name == "" then
        -- the level's name, as the PDA's Overview header shows it ("Cordon Settlement"), not its id;
        -- with another unnamed camp on that level, a number in hub id order tells them apart
        name = game.translate_string(camp.level or "unknown") .. " Settlement"
        local n, shared = 1, false
        for hub_id, c in pairs(stalker_camp_builder.active_camps) do
            if c ~= camp and c.level == camp.level and (not c.name or c.name == "") then
                shared = true
                if camp.hub_id and hub_id < camp.hub_id then n = n + 1 end
            end
        end
        if shared then
            name = name .. " #" .. n
        end
    end
    return name
end

function get_recruitable_camps(npc_or_comm)
    local list = {}
    local npc_comm = nil
    if type(npc_or_comm) == "string" then
        npc_comm = npc_or_comm
    elseif type(npc_or_comm) == "userdata" and npc_or_comm.character_community then
        npc_comm = npc_or_comm:character_community()
    end

    for hub_id, camp in pairs(stalker_camp_builder.active_camps) do
        local hub_obj = alife_object(hub_id)
        if hub_obj then
            local capacity = get_camp_bed_capacity(camp)
            local survivor_count = 0
            for k, v in pairs(camp.survivors) do
                survivor_count = survivor_count + 1
            end
            if survivor_count < capacity then
                local safe = true
                if npc_comm and stalker_camp_builder.can_settler_safely_live_in_camp then
                    safe = stalker_camp_builder.can_settler_safely_live_in_camp(npc_comm, hub_id)
                end
                if safe then
                    list[#list+1] = { hub_id = hub_id, camp = camp }
                end
            end
        end
    end
    local actor = db.actor
    local actor_pos = actor and actor:position()
    local cur_lvl = level and level.name and level.name()
    local sim = alife()
    local gg = game_graph()

    local function get_camp_info(item)
        local camp = item.camp
        local hub_obj = alife_object(item.hub_id)
        local c_lvl = camp.level
        if (not c_lvl or c_lvl == "" or c_lvl == "unknown") and hub_obj and gg and sim then
            local gv = gg:vertex(hub_obj.m_game_vertex_id)
            if gv then c_lvl = sim:level_name(gv:level_id()) end
        end
        local is_same_lvl = (cur_lvl and c_lvl and cur_lvl == c_lvl)
        local dist = 999999
        if is_same_lvl and actor_pos and hub_obj and hub_obj.position then
            dist = actor_pos:distance_to(hub_obj.position)
        end
        return is_same_lvl, dist
    end

    table.sort(list, function(a, b)
        local a_same, a_dist = get_camp_info(a)
        local b_same, b_dist = get_camp_info(b)
        if a_same and not b_same then return true end
        if b_same and not a_same then return false end
        if a_same and b_same then
            if math.abs(a_dist - b_dist) > 1.0 then
                return a_dist < b_dist
            end
        end
        return a.hub_id < b.hub_id
    end)
    return list
end

