-- Sleep Bonus System

local last_sleep_check_sec = nil
local last_sleep_in_camp_hub = nil  -- hub_id actor was inside at the LAST update tick
function check_camp_sleep_bonus()
    local actor = db.actor
    if not actor then return end
    if cfg.camp_rest_bonus == false then return end

    local current_sec = game_sec()

    local actor_pos = db.actor:position()
    local current_hub_id = get_active_camp_near(actor_pos)

    if last_sleep_check_sec then
        local elapsed = current_sec - last_sleep_check_sec
        if elapsed >= 10800 and last_sleep_in_camp_hub and stalker_camp_builder.active_camps[last_sleep_in_camp_hub] then
            if current_hub_id then
                -- change_satiety and change_power clamp at full; actor_status_thirst keeps its
                -- counter in a local and has no setter, so thirst is left alone
                pcall(function() actor:change_satiety(1.0) end)
                pcall(function() actor:change_power(1.0) end)
                news_manager.send_tip(actor, game.translate_string("st_camp_rest_bonus_msg"), nil, "general_stalker", 10000)
                -- DANZY EDIT: sleeping at a happy settlement also grants the hospitality buff
                if stalker_camp_builder.check_hospitality_on_sleep then
                    pcall(stalker_camp_builder.check_hospitality_on_sleep, 6)
                end
            end
        end
    end
    last_sleep_check_sec = current_sec
    last_sleep_in_camp_hub = current_hub_id  -- record camp proximity for next check
end

-- Survivor XP / Skill System

function award_survivor_xp(survivor, job)
    if not survivor then return end
    survivor.xp = (survivor.xp or 0) + 1
    local xp = survivor.xp
    local old_tier = survivor.tier or 0
    local new_tier = 0
    if xp >= 50 then new_tier = 3  -- Master
    elseif xp >= 25 then new_tier = 2  -- Expert
    elseif xp >= 10 then new_tier = 1  -- Skilled
    end
    if new_tier > old_tier then
        survivor.tier = new_tier
        local tier_names = {"Novice", "Skilled", "Expert", "Master"}
        if db.actor then
            local job_display = {
                scavenge = "Scavenger", cook = "Cook", repair = "Repairer",
                craft = "Crafter", medic = "Medic", guard = "Guard",
                electrician = "Electrician", idle = "Settler"
            }
            local job_title = job_display[job] or job or ""
            camp_send_tip(db.actor, string.format(game.translate_string("st_event_settler_promoted"), survivor.name or "Survivor", tier_names[new_tier+1], job_title), nil, "general_stalker", 10000)
        end
    end
end

function get_survivor_tier_mult(survivor)
    local tier = survivor and survivor.tier or 0
    if tier >= 3 then return 3.0 end  -- Master
    if tier >= 2 then return 2.0 end  -- Expert
    if tier >= 1 then return 1.5 end  -- Skilled
    return 1.0  -- Novice
end

local camp_log = {}
local CAMP_LOG_MAX_ENTRIES = 50

function add_camp_log_entry(text, severity)
    camp_log[#camp_log+1] = {time=time_global(), text=text, severity=severity or "info"}
    if #camp_log > CAMP_LOG_MAX_ENTRIES then
        table.remove(camp_log, 1)
    end
end

local dashboard_cache = { data = nil, expires_tg = 0 }
local DASHBOARD_CACHE_TTL_MS = 15000  -- 15 real seconds

-- ============================================================================
-- Camp-to-Camp Resource Transfer System
-- ============================================================================

-- Transfer items from one camp's chest to another. Moves up to max_items
-- of the specified item section from source_hub to target_hub.
-- Returns: number of items actually transferred.
function transfer_supplies(source_hub_id, target_hub_id, item_section, max_items)
    max_items = max_items or 10
    local source_camp = stalker_camp_builder.active_camps[source_hub_id]
    local target_camp = stalker_camp_builder.active_camps[target_hub_id]
    if not source_camp or not target_camp then return 0, "no_camp" end

    -- Find source chest (nearest stash to source hub)
    local source_hub_obj = alife_object(source_hub_id)
    if not source_hub_obj then return 0, "no_source_hub" end
    local source_box_id = nil
    local min_dist = 99999
    for struct_id, struct_type in pairs(source_camp.structures or {}) do
        if struct_type == "stash" then
            local se = alife_object(struct_id)
            if se then
                local d = se.position:distance_to(source_hub_obj.position)
                if d < min_dist then min_dist = d; source_box_id = struct_id end
            end
        end
    end
    if not source_box_id then return 0, "no_source_box" end

    -- Find target chest
    local target_hub_obj = alife_object(target_hub_id)
    if not target_hub_obj then return 0, "no_target_hub" end
    local target_box_id = nil
    min_dist = 99999
    for struct_id, struct_type in pairs(target_camp.structures or {}) do
        if struct_type == "stash" then
            local se = alife_object(struct_id)
            if se then
                local d = se.position:distance_to(target_hub_obj.position)
                if d < min_dist then min_dist = d; target_box_id = struct_id end
            end
        end
    end
    if not target_box_id then return 0, "no_target_box" end

    -- Find and move items
    local transferred = 0
    local items_to_move = {}

    stalker_camp_builder.camp_iterate_inventory(source_hub_id, source_camp, function(item_id, sec, cond, uses, se_obj, cid, cl_item)
        if transferred >= max_items then return true end
        if sec == item_section then
            items_to_move[#items_to_move+1] = item_id
            transferred = transferred + 1
            if transferred >= max_items then return true end
        end
    end, source_box_id)

    if transferred <= 0 then return 0 end

    -- Actually move the items (release from source, create in target)
    local sim = alife()
    if not sim then return 0 end
    local dest_se = alife_object(target_box_id)
    if not dest_se then return 0, "no_dest_se" end
    local pos = dest_se.position or vector()
    local lvid = dest_se.m_level_vertex_id or 0
    local gvi = dest_se.m_game_vertex_id or 0
    for _, item_id in ipairs(items_to_move) do
        local se_item = alife_object(item_id)
        if se_item then
            alife_release(se_item)
            sim:create(item_section, pos, lvid, gvi, target_box_id)
        end
    end

    return transferred
end

-- Get a list of all item sections in a camp's chest (for the transfer UI).
-- Returns a table of {section = count, ...}.
function get_camp_inventory_summary(hub_id)
    local camp = stalker_camp_builder.active_camps[hub_id]
    if not camp then return {} end
    local hub_obj = alife_object(hub_id)
    if not hub_obj then return {} end

    local summary = {}
    stalker_camp_builder.camp_iterate_inventory(hub_id, camp, function(item_id, sec, cond, uses, se_obj, box_id)
        if sec then
            summary[sec] = (summary[sec] or 0) + 1
        end
    end)
    return summary
end

-- ============================================================================
-- Camp Trade Routes System
-- ============================================================================

-- Trade routes allow automatic item transfer between camps on a timer.
-- Each route has: source_hub, target_hub, item_section, quantity_per_run, interval_sec.
-- Routes are stored in camp.trade_routes and fire on actor_on_update.
-- v1.1.8: restored (kept for the future route-setup UI).

-- Establish a trade route between two camps.
function establish_trade_route(source_hub_id, target_hub_id, item_section, quantity, interval_sec)
    local source_camp = stalker_camp_builder.active_camps[source_hub_id]
    if not source_camp then return false, "no_source_camp" end
    source_camp.trade_routes = source_camp.trade_routes or {}
    local route = {
        target_hub_id = target_hub_id,
        item_section = item_section,
        quantity = quantity or 5,
        interval_sec = interval_sec or 3600,  -- default: 1 game hour
        last_run_sec = game_sec(),
    }
    source_camp.trade_routes[#source_camp.trade_routes+1] = route
    return true
end

-- Remove all trade routes from a camp (or a specific one by index).
function remove_trade_route(source_hub_id, route_index)
    local source_camp = stalker_camp_builder.active_camps[source_hub_id]
    if not source_camp or not source_camp.trade_routes then return false end
    if route_index then
        table.remove(source_camp.trade_routes, route_index)
    else
        source_camp.trade_routes = {}
    end
    return true
end

-- Process all trade routes for all camps. Called from the staggered
-- actor_on_update task table (slot 9, teardown-grace gated).
function process_trade_routes()
    local current_sec = game_sec()
    for source_hub_id, camp in pairs(stalker_camp_builder.active_camps) do
        if camp.trade_routes then
            for i, route in ipairs(camp.trade_routes) do
                local elapsed = current_sec - (route.last_run_sec or 0)
                if elapsed >= route.interval_sec then
                    route.last_run_sec = current_sec
                    local transferred = transfer_supplies(source_hub_id, route.target_hub_id, route.item_section, route.quantity)
                    if transferred > 0 then
                        -- printf(string.format("[Homestead] Trade route: %d %s moved from camp %d to camp %d", transferred, route.item_section, source_hub_id, route.target_hub_id))
                    end
                end
            end
        end
    end
end

function server_entity_on_unregister(se_obj, type_name)
    if not se_obj then return end

    local in_teardown_grace = homestead_is_disconnecting
        or (stalker_camp_builder.homestead_is_disconnecting)
        or (time_global and homestead_teardown_grace_until and time_global() < homestead_teardown_grace_until)
        or (time_global and stalker_camp_builder.homestead_teardown_grace_until and time_global() < stalker_camp_builder.homestead_teardown_grace_until)

    if in_teardown_grace then
        return
    end

    local obj_id = se_obj.id

    if stalker_camp_builder.active_camps[obj_id] then
        pcall(function()
            if level and level.map_remove_object_spot then
                level.map_remove_object_spot(obj_id, "ui_pda2_actor_sleep_location")
            end
        end)
        if stalker_camp_builder.active_camps[obj_id].zone_id then
            local zid = stalker_camp_builder.active_camps[obj_id].zone_id
            safe_deferred_release(zid)
        end
        invalidate_scan_camp_structures_cache(obj_id)
        stalker_camp_builder.end_camp_raid(stalker_camp_builder.active_camps[obj_id])
        stalker_camp_builder.active_camps[obj_id] = nil
        pcall(function()
            if actor_menu and actor_menu.set_msg and game and game.translate_string then
                actor_menu.set_msg(1, game.translate_string("st_hub_removed"), 3)
            end
        end)
        return
    end

    for hub_id, camp in pairs(stalker_camp_builder.active_camps) do
        if camp.structures and camp.structures[obj_id] then
            camp.structures[obj_id] = nil
            invalidate_scan_camp_structures_cache(hub_id)
        end
        if camp.survivors and camp.survivors[obj_id] then
            stalker_camp_builder.settler_lookup[obj_id] = nil
        end
    end

    local m_data = alife_storage_manager and alife_storage_manager.get_state and alife_storage_manager.get_state()
    if m_data and m_data.stalker_camp_builder_banished_companions and m_data.stalker_camp_builder_banished_companions[obj_id] then
        m_data.stalker_camp_builder_banished_companions[obj_id] = nil
    end
    if m_data and m_data.stalker_camp_builder_freed_settlers and m_data.stalker_camp_builder_freed_settlers[obj_id] then
        m_data.stalker_camp_builder_freed_settlers[obj_id] = nil
    end
    -- a courier whose squad is gone: its entry goes too, so the freed id is never taken for it
    if stalker_camp_builder.active_convoys then
        stalker_camp_builder.active_convoys[obj_id] = nil
    end
    -- the same for a refugee whose body is gone
    if stalker_camp_builder.refugee_ids then
        stalker_camp_builder.refugee_ids[obj_id] = nil
    end

    if stalker_camp_builder.rival_camps then
        for key, rcamp in pairs(stalker_camp_builder.rival_camps) do
            if type(rcamp) == "table" then
                if rcamp.chest_id == obj_id then
                    if stalker_camp_builder.remove_all_rival_map_spots then
                        pcall(stalker_camp_builder.remove_all_rival_map_spots, obj_id)
                    end
                    if stalker_camp_builder.release_camp_decorations then
                        pcall(stalker_camp_builder.release_camp_decorations, rcamp)
                    end
                    if stalker_camp_builder.cleanup_camp_convoys then
                        pcall(stalker_camp_builder.cleanup_camp_convoys, obj_id)
                    end
                    if stalker_camp_builder.release_rival_hold then
                        if rcamp.squad_id then
                            local sq = alife_object(rcamp.squad_id)
                            if sq then pcall(stalker_camp_builder.release_rival_hold, stalker_camp_builder, sq) end
                        end
                        if rcamp.extra_squad_ids then
                            for _, ex_id in ipairs(rcamp.extra_squad_ids) do
                                local ex_sq = alife_object(ex_id)
                                if ex_sq then pcall(stalker_camp_builder.release_rival_hold, stalker_camp_builder, ex_sq) end
                            end
                        end
                    end
                    if m_data and m_data.player_created_stashes then
                        m_data.player_created_stashes[obj_id] = nil
                    end
                    -- the outpost registered its chest as a treasure cache (G.A.M.M.A. mode keeps the
                    -- entry): a later object with this id must not read as a stash
                    if treasure_manager and treasure_manager.caches then
                        treasure_manager.caches[obj_id] = nil
                    end
                    stalker_camp_builder.rival_camps[key] = nil
                    break
                else
                    if rcamp.squad_id == obj_id then
                        rcamp.squad_id = nil
                        if rcamp.extra_squad_ids and #rcamp.extra_squad_ids > 0 then
                            rcamp.squad_id = table.remove(rcamp.extra_squad_ids, 1)
                        end
                    elseif rcamp.extra_squad_ids then
                        for i = #rcamp.extra_squad_ids, 1, -1 do
                            if rcamp.extra_squad_ids[i] == obj_id then
                                table.remove(rcamp.extra_squad_ids, i)
                                break
                            end
                        end
                    end
                    -- the same for the outpost's heat pack
                    if rcamp.heat_mutant_squad_id == obj_id then
                        rcamp.heat_mutant_squad_id = nil
                    end
                    if rcamp.decorations then
                        for i = #rcamp.decorations, 1, -1 do
                            if rcamp.decorations[i] == obj_id then
                                table.remove(rcamp.decorations, i)
                                break
                            end
                        end
                    end
                    if rcamp.decor_sections then
                        rcamp.decor_sections[obj_id] = nil
                    end
                end
            end
        end
    end
end

-- re-creates an Invincible settler who died (npc_on_death_callback) at the camp's hub
function stalker_camp_builder.respawn_settler(hub_id, dead_id)
    local camp = stalker_camp_builder.active_camps[hub_id]
    local entry = camp and camp.respawning and camp.respawning[dead_id]
    if not entry then return end
    camp.respawning[dead_id] = nil
    local survivor = entry.survivor
    local hub_obj = alife_object(hub_id)
    local sim = alife()
    if not (hub_obj and sim and survivor) then return end
    local new_se = sim:create(entry.sec or "sim_default_stalker_0", hub_obj.position,
        hub_obj.m_level_vertex_id, hub_obj.m_game_vertex_id)
    if not new_se then return end
    local new_id = new_se.id
    survivor.job = survivor.job or "idle"
    camp.survivors[new_id] = survivor
    stalker_camp_builder.settler_lookup[new_id] = {
        hub_id = hub_id,
        camp = camp,
        survivor = survivor,
        is_rival = false,
    }
    -- the server object keeps the name and passes it to the NPC online; the
    -- community needs the NPC online, so game_object_on_net_spawn applies it
    if survivor.name then
        pcall(function() new_se:set_character_name(survivor.name) end)
    end
    survivor.pending_community = stalker_camp_builder.get_camp_dominant_faction
        and stalker_camp_builder.get_camp_dominant_faction(camp) or nil
    camp_send_tip(db.actor, string.format(game.translate_string("st_event_settler_recovered"), survivor.name or "unknown"), nil, "general_stalker", 10000)
end

function npc_on_death_callback(npc, who)
    if not npc then return end
    local npc_id = npc:id()
    -- a dead refugee doesn't move on: its entry would pass to whatever gets the id next
    if stalker_camp_builder.refugee_ids then
        stalker_camp_builder.refugee_ids[npc_id] = nil
    end
    for hub_id, camp in pairs(stalker_camp_builder.active_camps) do
        if camp.survivors and camp.survivors[npc_id] then
            local survivor = camp.survivors[npc_id]
            local name = survivor.name or "unknown"
            local job  = survivor.job  or "unknown"

            if cfg.settler_invincible then
                local sec = npc:section()
                set_camp_settler_relations(hub_id, npc_id, false)
                camp.survivors[npc_id] = nil
                stalker_camp_builder.settler_lookup[npc_id] = nil
                -- held in the camp, which is saved, until the new settler exists: the time event is
                -- not, and verify_and_heal_settlers finishes the respawn after a load
                camp.respawning = camp.respawning or {}
                camp.respawning[npc_id] = { survivor = survivor, sec = sec }
                CreateTimeEvent("homestead_respawn_settler", tostring(npc_id), 0.5, function()
                    stalker_camp_builder.respawn_settler(hub_id, npc_id)
                    return true
                end)
            else
                if camp.active_raid and job == "guard" then
                    camp.active_raid.guards_lost = (camp.active_raid.guards_lost or 0) + 1
                end
                set_camp_settler_relations(hub_id, npc_id, false)
                camp.survivors[npc_id] = nil
                stalker_camp_builder.settler_lookup[npc_id] = nil
                actor_menu.set_msg(1, string.format(game.translate_string("st_event_settler_killed"), name), 5)
            end
            return
        end
    end
end

-- npc_on_hit_callback -- combat defense reaction and damage recovery for settlers
function npc_on_hit_callback(npc, amount, local_direction, who, bone_index)
    if not npc then return end
    if not npc:alive() then return end
    local npc_id = npc:id()
    local lookup = stalker_camp_builder.settler_lookup[npc_id]
    if not lookup or lookup.is_rival then return end

    -- Settler Defensive Readiness: when hit by hostile NPC or monster, drop rigid beh_wait standing lock
    if who and who:id() ~= npc_id and (IsStalker(who) or IsMonster(who)) then
        pcall(function()
            npc:disable_info_portion("npcx_beh_wait")
            npc:give_info_portion("npcx_beh_hide_in_cover")
        end)
    end

    if cfg.settler_invincible then
        pcall(function() npc:set_health_ex(1.0) end)
    end
end

local function safe_register_callback(name, func)
    if not func then return end
    if axr_main and axr_main.callbacks and axr_main.callbacks[name] == nil then
        return
    end
    pcall(RegisterScriptCallback, name, func)
end

-- Crash helper: when the engine hits a fatal script error it calls this first.
-- Writes the offender and a traceback to the log so crashes can be traced.
function homestead_luabind_fatal_diag(offender)
    printf("[Homestead] LUABIND FATAL offender: %s", tostring(offender))
    if debug and debug.traceback then
        printf("[Homestead] LUABIND FATAL trace: %s", debug.traceback("diag", 2))
    end
end

function on_game_start()
    local type_ = type
    patch_alife_storage_manager()
    -- v1.1.7: map_spot_menu_* callbacks are registered once at the end of
    pcall(function()
        local function get_weapon_repair_tier(sec)
            local sfind = string.find
            if not sec then return "A", 45, 25000 end
            local parent_sec = ini_sys and ini_sys:r_string_ex(sec, "parent_section") or sec
            local rep_type = ini_sys and ini_sys:r_string_ex(parent_sec, "repair_type") or ""
            local cost = ini_sys and ini_sys:r_u32(parent_sec, "cost") or 10000
            local ammo_class = ini_sys and ini_sys:r_string_ex(parent_sec, "ammo_class") or ""

            if sfind(ammo_class, "ammo_gauss", 1, true) or sfind(ammo_class, "ammo_pkm", 1, true) or sfind(ammo_class, "ammo_12.7") or sfind(ammo_class, "ammo_magnum", 1, true) or sfind(ammo_class, "338", 1, true) or sfind(sec, "gauss", 1, true) or sfind(sec, "pkm", 1, true) or sfind(sec, "pkp", 1, true) or sfind(sec, "rpg", 1, true) or cost >= 110000 then
                return "D", 260, 200000
            end

            if rep_type == "rifle_7" or sfind(ammo_class, "7.62x54") or sfind(ammo_class, "7.62x51") or sfind(ammo_class, "7.62x39") or sfind(ammo_class, "9x39", 1, true) or cost >= 50000 then
                return "C", 175, 135000
            end

            if rep_type == "shotgun" or rep_type == "rifle_5" or sfind(ammo_class, "5.45x39") or sfind(ammo_class, "5.56x45") or sfind(ammo_class, "12x70", 1, true) or sfind(ammo_class, "12x76", 1, true) or cost >= 22000 then
                return "B", 95, 70000
            end

            return "A", 45, 25000
        end

        function stalker_camp_builder.restore_wpo_weapon_parts(obj)
            if not (obj and IsWeapon and IsWeapon(obj)) then return end
            local obj_id = obj:id()
            local sec = ini_sys and ini_sys:r_string_ex(obj:section(), "parent_section") or obj:section()
            local ini_parts = itms_manager and itms_manager.ini_parts
            local parts_str = ini_parts and ini_parts:r_string_ex("con_parts_list", sec)
            local parts_list = parts_str and str_explode(parts_str, ",") or {}

            pcall(function() obj:set_condition(1.0) end)
            local se_obj = alife_object(obj_id)
            if se_obj then
                pcall(function() se_obj.condition = 1.0 end)
            end

            pcall(function()
                local c_wpn = obj:cast_Weapon()
                if c_wpn then
                    c_wpn:SetMisfire(false)
                    if c_wpn.SetCondition then c_wpn:SetCondition(1.0) end
                end
            end)

            local parts = {}
            for _, p_name in ipairs(parts_list) do
                parts[p_name] = 100
            end
            parts[sec] = 100
            for k in pairs(parts) do
                parts[k] = 100
            end

            se_save_var(obj_id, nil, "parts", parts)
            se_save_var(obj_id, obj:name(), "parts", parts)
            if item_parts and item_parts.set_parts_con then
                item_parts.set_parts_con(obj_id, parts)
            end

            if arti_jamming then
                if arti_jamming.set_jam_status then
                    arti_jamming.set_jam_status(obj_id, nil)
                end
                if arti_jamming.reset_cgd then
                    arti_jamming.reset_cgd()
                end
            end
        end

        -- G.A.M.M.A. prices repairs with inventory_upgrades_mp.how_much_repair, which addons wrap
        -- when they load; anything that isn't a weapon keeps that chain
        local orig_how_much_repair = (inventory_upgrades_mp and inventory_upgrades_mp.how_much_repair)
            or (inventory_upgrades and inventory_upgrades.how_much_repair)
        local function calc_wpo_repair_cost(item_name, item_condition)
            local mfloor = math.floor
            local mmax = math.max
            if ini_sys and ini_sys:section_exist(item_name) then
                local cls = ini_sys:r_string_ex(item_name, "class") or ""
                if string.find(cls, "WP_", 1, true) or string.find(cls, "W_", 1, true) then
                    local item_obj = nil
                    if ui_inventory and ui_inventory.GUI and ui_inventory.GUI.upgr and ui_inventory.GUI.upgr.id then
                        local cand = level.object_by_id(ui_inventory.GUI.upgr.id)
                        if cand and cand:section() == item_name then
                            item_obj = cand
                        end
                    end
                    if not item_obj and db.actor then
                        db.actor:iterate_inventory(function(actor, itm)
                            if itm and itm:section() == item_name and math.abs(itm:condition() - (item_condition or 1.0)) < 0.02 then
                                item_obj = itm
                                return true
                            end
                        end, db.actor)
                    end

                    local base_deficit = mmax(0, mfloor((1.0 - (item_condition or 1.0)) * 100))
                    local parts_deficit = 0
                    local sec = ini_sys:r_string_ex(item_name, "parent_section") or item_name
                    local ini_parts = itms_manager and itms_manager.ini_parts
                    local parts_str = ini_parts and ini_parts:r_string_ex("con_parts_list", sec)
                    local parts_list = parts_str and str_explode(parts_str, ",") or {}

                    local parts = nil
                    if item_obj then
                        local wpn_id = item_obj:id()
                        if item_parts and item_parts.get_parts_con then
                            parts = item_parts.get_parts_con(item_obj, wpn_id, false)
                        end
                        if type(parts) ~= "table" then
                            parts = se_load_var(wpn_id, item_obj:name(), "parts") or se_load_var(wpn_id, nil, "parts")
                        end
                    end
                    parts = (type(parts) == "table") and parts or {}

                    for _, p_name in ipairs(parts_list) do
                        local p_con = parts[p_name] or mfloor((item_condition or 1.0) * 100)
                        parts_deficit = parts_deficit + mmax(0, 100 - p_con)
                    end

                    local total_deficit = base_deficit + parts_deficit
                    if total_deficit <= 0 then
                        return 0
                    end

                    local tier_letter, tier_rate, tier_cap = get_weapon_repair_tier(sec)
                    local raw_cost = total_deficit * tier_rate
                    local renown_disc = (stalker_camp_builder.has_renown_perk and stalker_camp_builder.has_renown_perk("forge_master")) and 0.85 or 1.0
                    local total_cost = mfloor(math.min(tier_cap, mmax(150, raw_cost)) * renown_disc)

                    return total_cost
                end
            end
            if orig_how_much_repair then
                return orig_how_much_repair(item_name, item_condition)
            end
            local cost = ini_sys:r_u32(item_name, "cost") or 5000
            local cof = (game_difficulties and game_difficulties.get_eco_factor and game_difficulties.get_eco_factor("repair")) or 1.67
            return mfloor(cost * (1.0 - (item_condition or 1.0)) * cof)
        end

        if inventory_upgrades then
            inventory_upgrades.how_much_repair = calc_wpo_repair_cost
            if inventory_upgrades_mp then
                inventory_upgrades_mp.how_much_repair = calc_wpo_repair_cost
            end
        end

        function stalker_camp_builder.is_settler(npc_id)
            if not npc_id then return false end
            if type(npc_id) == "userdata" then
                npc_id = npc_id.id and ((type(npc_id.id) == "number") and npc_id.id or npc_id:id())
            end
            if not npc_id then return false end
            local sb = stalker_camp_builder
            if sb.settler_lookup and sb.settler_lookup[npc_id] then
                return true
            end
            for hub_id, camp in pairs(sb.active_camps or {}) do
                if camp.survivors and (camp.survivors[npc_id] or camp.survivors[tostring(npc_id)]) then
                    return true
                end
            end
            return false
        end

        function stalker_camp_builder.is_pos_in_active_camp(pos)
            if not pos or not stalker_camp_builder.active_camps then return false end
            local cur_lvl = level and level.name and level.name()
            for hub_id, camp in pairs(stalker_camp_builder.active_camps) do
                if camp and (not camp.level or camp.level == cur_lvl) then
                    local hub_obj = alife_object(hub_id)
                    if hub_obj and hub_obj.position then
                        local radius = camp.radius or 45
                        if pos:distance_to(hub_obj.position) <= radius then
                            return true
                        end
                    end
                end
            end
            return false
        end

        function stalker_camp_builder.is_settler_at_pos(pos)
            if not pos or not stalker_camp_builder.settler_lookup then return false end
            for id, data in pairs(stalker_camp_builder.settler_lookup) do
                local obj = level.object_by_id(id)
                if obj and obj.position and pos:distance_to_sqr(obj:position()) < 16 then
                    return true
                end
            end
            return false
        end

        function stalker_camp_builder.is_rival_camp_object(id)
            if not id or not stalker_camp_builder.rival_camps then return false end
            for _, rcamp in pairs(stalker_camp_builder.rival_camps) do
                if type(rcamp) == "table" then
                    if rcamp.chest_id == id then return true end
                    if rcamp.decorations then
                        for _, did in ipairs(rcamp.decorations) do
                            if did == id then return true end
                        end
                    end
                end
            end
            return false
        end

        pcall(function()
            if xr_conditions and xr_conditions.actor_has_weapon then
                local orig_actor_has_weapon = xr_conditions.actor_has_weapon
                xr_conditions.actor_has_weapon = function(actor, npc)
                    if not npc then return false end
                    local npc_id = (type_(npc.id) == "number") and npc.id or (npc.id and npc:id())
                    if npc_id and stalker_camp_builder.is_settler(npc_id) then
                        return false
                    end
                    if stalker_camp_builder.is_companion and stalker_camp_builder.is_companion(npc) then
                        return false
                    end
                    local sb = stalker_camp_builder
                    if sb and sb.get_active_camp_near and sb.get_active_camp_near(npc:position(), 60) then
                        return false
                    end
                    return orig_actor_has_weapon(actor, npc)
                end
            end

            if xr_conditions and xr_conditions.is_squad_commander then
                local orig_is_squad_commander = xr_conditions.is_squad_commander
                xr_conditions.is_squad_commander = function(actor, npc)
                    if npc then
                        local npc_id = (type_(npc.id) == "number") and npc.id or (npc.id and npc:id())
                        if npc_id and stalker_camp_builder.is_settler(npc_id) then
                            return true
                        end
                    end
                    return orig_is_squad_commander(actor, npc)
                end
            end
        end)
    end)

    local function on_dotmarks_manual_interact_release(id, mark, flags)
        if not id then return end
        local obj = level.object_by_id(id)
        local sec = obj and obj:section()
        local is_wb = (mark and mark.hf_workshop) or sec == "placeable_workshop" or sec == "itm_workshop"
        if not is_wb and stalker_camp_builder.active_camps and stalker_camp_builder.active_camps[id] then
            is_wb = true
        end
        if is_wb then
            if ui_furniture_workshop and ui_furniture_workshop.start_dialog then
                ui_furniture_workshop.start_dialog(id)
                if flags then flags.ret_value = false end
            end
        end
    end

