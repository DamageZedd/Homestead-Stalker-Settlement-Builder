-- Public Dialogue and Medic Forwarders (Direct Resolution)
function is_actor_healthy(actor, npc)
    local a = db.actor
    if not a then return true end
    local health = a.health or 1.0
    local rad = a.radiation or 0.0
    local bleed = a.bleeding or 0.0
    return (health >= 0.98 and rad <= 0.01 and bleed <= 0.01)
end

function is_actor_not_healthy(actor, npc)
    local a = db.actor
    if not a then return false end
    local health = a.health or 1.0
    local rad = a.radiation or 0.0
    local bleed = a.bleeding or 0.0
    return (health < 0.98 or rad > 0.01 or bleed > 0.01)
end

function is_actor_injured(actor, npc)
    local a = db.actor
    if not a then return false end
    local health = a.health or 1.0
    local bleed = a.bleeding or 0.0
    return (health < 0.98 or bleed > 0.01)
end

function is_actor_irradiated(actor, npc)
    local a = db.actor
    if not a then return false end
    local rad = a.radiation or 0.0
    return (rad > 0.01)
end

function is_actor_injured_irradiated(actor, npc)
    local a = db.actor
    if not a then return false end
    local health = a.health or 1.0
    local bleed = a.bleeding or 0.0
    local rad = a.radiation or 0.0
    return ((health < 0.98 or bleed > 0.01) and (rad > 0.01))
end

