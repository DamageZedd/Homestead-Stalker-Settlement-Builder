function check_camp_chest_supplies(camp, hub_obj)
    if time_global() < homestead_teardown_grace_until then
        return false, false
    end

    local tg = time_global()
    if camp and camp._inv_snapshot and camp._inv_snapshot_tg and (tg - camp._inv_snapshot_tg) < 10000 then
        return camp._inv_snapshot.has_food, camp._inv_snapshot.has_water
    end
    if camp and camp._cached_chest_supplies_tg and (tg - camp._cached_chest_supplies_tg) < 10000 then
        return camp._cached_has_food, camp._cached_has_water
    end

    local has_food = false
    local has_water = false

    local function check_sec(sec)
        if not sec then return end
        local s = tostring(sec):lower()
        if not has_food then
            if s:find("conserva", 1, true) or s:find("tushonka", 1, true) or s:find("kolbasa", 1, true) or s:find("bread", 1, true) or s:find("meat", 1, true) or s:find("sausage", 1, true) or s:find("stew", 1, true) or s:find("ration", 1, true) or s == "vodka" or s == "beer" or s == "chocolate" or s:find("mre", 1, true) or s:find("nuts", 1, true) then
                has_food = true
            end
        end
        if not has_water then
            if s:find("water", 1, true) or s:find("bottle", 1, true) or s:find("flask", 1, true) or s == "energy_drink" or s == "beer" or s:find("drink", 1, true) or s:find("canteen", 1, true) or s == "mineral_water" then
                has_water = true
            end
        end
    end

    local hub_id = (hub_obj and hub_obj.id) or (camp and camp.hub_id)
    stalker_camp_builder.camp_iterate_inventory(hub_id, camp, function(item_id, sec, cond, uses, se_obj, cid)
        check_sec(sec)
        if has_food and has_water then return true end
    end)

    if camp then
        camp._cached_has_food = has_food
        camp._cached_has_water = has_water
        camp._cached_chest_supplies_tg = tg
    end

    return has_food, has_water
end

function get_camp_stats(camp, hub_obj)
    if camp and (not camp._structures_scanned) and hub_obj then
        camp._structures_scanned = true
        scan_camp_structures(hub_obj.id, false)
    end

    local mmin = math.min
    if camp and camp._stats_cache_tick == tg_update and camp._stats_cache then
        return camp._stats_cache
    end

    local stats = {
        population = 0,
        beds = 0,
        barricades = 0,
        water_pumps = 0,
        gadgets = 0,
        guards = 0,
        scavengers = 0,
        crafters = 0,
        repairers = 0,
        cooks = 0,
        hunters = 0,
        medics = 0,
        electricians = 0,
        woodcutters = 0,
        brewers = 0,
        scrappers = 0,
        idlers = 0,
        defense = 0,
        happiness = 50,
        pianos = 0,
        radios = 0,
        alarms = 0,
        decors = 0
    }

    for id, survivor in pairs(camp.survivors or {}) do
        stats.population = stats.population + 1
        local j = survivor.job and tostring(survivor.job):lower():match("^%s*(.-)%s*$")
        if j == "guard" then
            stats.guards = stats.guards + 1
        elseif j == "scavenge" or j == "scavenger" then
            stats.scavengers = stats.scavengers + 1
        elseif j == "craft" then
            stats.crafters = stats.crafters + 1
        elseif j == "repair" then
            stats.repairers = stats.repairers + 1
        elseif j == "cook" then
            stats.cooks = stats.cooks + 1
        elseif j == "hunter" then
            stats.hunters = stats.hunters + 1
        elseif j == "medic" then
            stats.medics = stats.medics + 1
        elseif j == "electrician" then
            stats.electricians = stats.electricians + 1
        elseif j == "woodcutter" then
            stats.woodcutters = stats.woodcutters + 1
        elseif j == "brewer" then
            stats.brewers = stats.brewers + 1
        elseif j == "scrapper" then
            stats.scrappers = stats.scrappers + 1
        else
            stats.idlers = stats.idlers + 1
        end
    end

    local dead_structs = nil
    for id, struct_type in pairs(camp.structures or {}) do
        local se = alife_object(id)
        if se then
            if struct_type == "bed" then
                stats.beds = stats.beds + 1
            elseif struct_type == "barricade" then
                stats.barricades = stats.barricades + 1
            elseif struct_type == "water_pump" then
                stats.water_pumps = stats.water_pumps + 1
            elseif struct_type == "gadget" then
                stats.gadgets = stats.gadgets + 1
            elseif struct_type == "piano" then
                stats.pianos = stats.pianos + 1
            elseif struct_type == "radio" then
                stats.radios = stats.radios + 1
            elseif struct_type == "alarm" then
                stats.alarms = stats.alarms + 1
            elseif struct_type == "decor" then
                stats.decors = stats.decors + 1
            end
        else
            dead_structs = dead_structs or {}
            dead_structs[#dead_structs + 1] = id
        end
    end
    if dead_structs then
        for _, dead_id in ipairs(dead_structs) do
            camp.structures[dead_id] = nil
        end
    end

    stats.defense = mmin(cfg.defense_cap, ((stats.barricades * 2) + (stats.guards * 5) + (stats.gadgets * 15) + (stats.alarms * 10)) * get_specialization_mult(camp, "defense"))

    local score = 50
    if stats.population > 0 then
        if stats.beds >= stats.population then
            score = score + 20
        else
            score = score - 20
        end

        if stats.defense >= (stats.population * 3) then
            score = score + 20
        else
            score = score - 20
        end

        if stats.water_pumps * 3 >= stats.population then
            score = score + 10
        else
            score = score - 10
        end

        local has_food, has_water = check_camp_chest_supplies(camp, hub_obj)
        if has_food then
            score = score + 5
        else
            score = score - 5
        end
        if has_water then
            score = score + 5
        else
            score = score - 5
        end
    else
        score = 100 -- Empty camp is satisfied
    end

    score = score + (stats.pianos * 10) + (stats.radios * 10)

    local decor_bonus = (cfg.decor_happiness_bonus or 0.5) * stats.decors
    score = score + mmin(15, decor_bonus)

    -- DANZY EDIT: hungry settlers are unhappy (-5 per hungry settler, max -30)
    if camp.hungry_until and camp.hungry_count then
        local now_s = game_sec()
        if now_s < camp.hungry_until then
            score = score - mmin(30, camp.hungry_count * 5)
        end
    end

    stats.happiness = math.max(0, mmin(100, score))

    camp.happiness = stats.happiness

    if camp then
        camp._stats_cache_tick = tg_update
        camp._stats_cache = stats
    end

    return stats
end

function process_camp_morale()
    local pairs_ = pairs
    local now_sec = game_sec()

    for hub_id, camp in pairs_(stalker_camp_builder.active_camps) do
        local hub_obj = alife_object(hub_id)
        if hub_obj and get_camp_stats then
            get_camp_stats(camp, hub_obj)  -- writes camp.happiness as a side-effect
        end

        -- older versions counted 30-day months and 365.25-day years, some 408 days ahead
        if camp._last_abandon_time and camp._last_abandon_time > now_sec then
            camp._last_abandon_time = nil
        end
        if camp.happiness and camp.happiness < 20 then
            if camp._last_abandon_time and (now_sec - camp._last_abandon_time) < 7200 then
            elseif camp.survivors then
                local surv_count = 0
                for _ in pairs_(camp.survivors) do surv_count = surv_count + 1 end

                if surv_count >= 2 then
                    for npc_id, survivor in pairs_(camp.survivors) do
                        if math.random(100) <= 3 then
                            local sb = stalker_camp_builder
                            local id_num = tonumber(npc_id) or npc_id
                            local se_npc = alife_object(id_num)
                            if not (se_npc and IsStalker(nil, se_npc:clsid())
                                    and (not survivor.section or se_npc:section_name() == survivor.section)) then
                                -- killed and released while offline (the list is pruned at load), the id maybe
                                -- taken since: only drop the entry. set_switch_online on an id with no server
                                -- object is an engine crash.
                                camp.survivors[npc_id] = nil
                                sb.settler_lookup[npc_id] = nil
                                break
                            end
                            local name = survivor.name or "Survivor"
                            local camp_name = camp.name or "camp"
                            -- leave the way a banished settler does: end an expedition while the camp
                            -- exists, purge the settler state and give them a sim squad
                            if sb.recall_scavenger_expedition_by_npc then
                                sb.recall_scavenger_expedition_by_npc(id_num)
                            end
                            set_camp_settler_relations(hub_id, npc_id, false)
                            camp.survivors[npc_id] = nil
                            stalker_camp_builder.settler_lookup[npc_id] = nil  -- keep O(1) lookup in sync
                            stalker_camp_builder.camp_npc_released[npc_id] = nil
                            if sb.purge_settler_companion_and_squad_state then
                                -- only a companion goes on the banished list, as in a dismantle
                                local is_comp = (survivor.job == "companion" or survivor.is_companion) and true or false
                                sb.purge_settler_companion_and_squad_state(id_num, level.object_by_id(id_num), is_comp)
                            end
                            if sb.reassign_freed_settler_to_smart then
                                sb.reassign_freed_settler_to_smart(id_num)
                            end
                            if db.actor then
                                camp_send_tip(db.actor, string.format(game.translate_string("st_survivor_abandoned"), name, camp_name), nil, "red_danger", 12000, camp.hub_id, "general", true)
                            end
                            camp._last_abandon_time = now_sec
                            break  -- only one per check
                        end
                    end
                end
            end
        end
    end
end

-- manage_camp_dialog's <script_text> for phrase 77: the engine passes the NPC, the dialog id and the
-- phrase id (PhraseDialog.cpp 211-219). The status is that of the camp the player stands in.
function get_camp_status_text(npc, dialog_id, phrase_id)
    local hub_id, camp = get_active_camp_near(db.actor:position())
    if not camp then
        return game.translate_string("st_camp_status_not_near")
    end

    local hub_obj = alife_object(hub_id)
    if not hub_obj then
        return game.translate_string("st_camp_status_cant_access")
    end

    local stats = get_camp_stats(camp, hub_obj)
    local text = game.translate_string("st_camp_status_intro") .. " " .. level.name() .. ":\\n\\n"
    text = text .. game.translate_string("st_pda_settlement_pop_lbl") .. ": " .. stats.population .. " / " .. stats.beds .. " (" .. game.translate_string("st_camp_status_beds") .. ")\\n"
    text = text .. game.translate_string("st_pda_settlement_def_lbl") .. ": " .. stats.defense .. " (" .. game.translate_string("st_camp_status_barricades") .. ": " .. stats.barricades .. ", " .. game.translate_string("st_camp_status_guards") .. ": " .. stats.guards .. ", " .. game.translate_string("st_camp_status_turrets") .. ": " .. stats.gadgets .. ")\\n"
    text = text .. game.translate_string("st_camp_status_pumps") .. ": " .. stats.water_pumps .. " | " .. game.translate_string("st_camp_status_pianos") .. ": " .. stats.pianos .. " | " .. game.translate_string("st_camp_status_radios") .. ": " .. stats.radios .. "\\n"
    text = text .. game.translate_string("st_camp_status_morale") .. ": " .. stats.happiness .. "%\\n\\n"
    text = text .. game.translate_string("st_camp_status_jobs") .. ":\\n"
    text = text .. "- " .. game.translate_string("st_camp_status_guards") .. ": " .. stats.guards .. "\\n"
    text = text .. "- " .. game.translate_string("st_camp_status_scavengers") .. ": " .. stats.scavengers .. "\\n"
    text = text .. "- " .. game.translate_string("st_camp_status_crafters") .. ": " .. stats.crafters .. "\\n"
    text = text .. "- " .. game.translate_string("st_camp_status_repairers") .. ": " .. stats.repairers .. "\\n"
    text = text .. "- " .. game.translate_string("st_camp_status_cooks") .. ": " .. stats.cooks .. "\\n"
    text = text .. "- " .. game.translate_string("st_camp_status_idlers") .. ": " .. stats.idlers .. "\\n\\n"
    text = text .. game.translate_string("st_camp_status_outro")

    return text
end

function process_camp_random_events()
    local current_sec = game_sec()

    if last_random_event_sec then
        local elapsed = current_sec - last_random_event_sec
        if elapsed < cfg.event_cooldown then
            return
        end
    end

    local player_pos = db.actor:position()
    local cur_lvl = level.name()
    for hub_id, camp in pairs(stalker_camp_builder.active_camps) do
        if not camp.level or camp.level == cur_lvl then
            local hub_obj = alife_object(hub_id)
            if hub_obj and hub_obj.position then
                local dist = hub_obj.position:distance_to(player_pos)
                if dist <= cfg.event_player_dist then
                    camp.last_event_check_time = camp.last_event_check_time or current_sec
                    local check_elapsed = current_sec - camp.last_event_check_time
                    if check_elapsed >= cfg.event_check_interval then -- check once every 2 game hours
                        camp.last_event_check_time = current_sec

                        if math.random(100) <= cfg.event_chance then
                            last_random_event_sec = current_sec
                            trigger_random_camp_event(hub_id, camp, hub_obj)
                            break
                        end
                    end
                end
            end
        end
    end
end

function trigger_random_camp_event(hub_id, camp, hub_obj)
    local mrandom = math.random
    local events = {"refugees", "migration"}
    -- a caravan still at the camp owns active_trader_id; a second one would strand it
    local trader = camp.active_trader_id and alife_object(camp.active_trader_id)
    if not (trader and IsStalker(trader) and trader:alive()) then
        events[#events+1] = "caravan"
    end

    local harvesters = {}
    for id, struct_type in pairs(camp.structures or {}) do
        local se_obj = alife_object(id)
        if se_obj and se_obj:section_name() == "placeable_artifact_harvester" then
            local h_data = hf_obj_manager.get_data(id)
            if h_data and h_data.artifact_section and h_data.artifact_section ~= "" and (h_data.artifact_condition or 1.0) > 0.01 then
                harvesters[#harvesters+1] = id
            end
        end
    end
    if #harvesters > 0 then
        events[#events+1] = "harvester_degrade"
    end

    local chosen_event = events[mrandom(#events)]

    if chosen_event == "refugees" then
        local spawn_lvid, spawn_pos = stalker_camp_builder.get_furniture_front_vertex_and_pos(hub_obj.position, 2.0)
        local pos = spawn_pos or vector():set(hub_obj.position.x + 1.5, hub_obj.position.y + 0.1, hub_obj.position.z)
        local lvi = spawn_lvid or hub_obj.m_level_vertex_id
        local se_refugee = alife():create("stalker_regular", pos, lvi, hub_obj.m_game_vertex_id)
        if se_refugee then
            stalker_camp_builder.refugee_ids[se_refugee.id] = { arrived_sec = game_sec() }
            camp_send_tip(db.actor, game.translate_string("st_event_refugees_arrived"), nil, "general_stalker", 12000)
        end
    elseif chosen_event == "migration" then
        -- a point with a level vertex under it: a squad created near the player comes online on its
        -- creation vertex, so the hub's vertex would bring the pack up inside the camp
        local spawn_pos, spawn_lvi
        for _ = 1, 8 do
            local angle = mrandom() * 2 * math.pi
            local r_dist = mrandom(70, 90)
            local lvid = level.vertex_id(vector():set(
                hub_obj.position.x + r_dist * math.cos(angle),
                hub_obj.position.y,
                hub_obj.position.z + r_dist * math.sin(angle)
            ))
            if lvid and lvid < 4294967295 and lvid ~= -1 then
                spawn_pos, spawn_lvi = level.vertex_position(lvid), lvid
                break
            end
        end
        local spawn_gvi = db.actor:game_vertex_id()
        if spawn_lvi and level.cross_table and level.cross_table() then
            spawn_gvi = level.cross_table():vertex(spawn_lvi):game_vertex_id()
        end

        local mutant_sections = {"simulation_dog", "simulation_boar", "simulation_tushkano"}
        local sec = mutant_sections[mrandom(#mutant_sections)]
        local squad = spawn_lvi and create_squad_at_pos(sec, spawn_pos, spawn_lvi, spawn_gvi, true)
        if squad then
            -- a squad can head only for a squad, a smart terrain or the player, and the hub is
            -- furniture: the pack comes at the player, who is at the camp when this fires
            squad.get_script_target = function(self)
                return AC_ID
            end
            camp_send_tip(db.actor, game.translate_string("st_event_mutant_migration"), nil, "red_danger", 15000, hub_id, "combat", true)
            local has_alarm = false
            local alarm_pos = hub_obj.position
            for id, struct_type in pairs(camp.structures) do
                if struct_type == "alarm" then
                    local se_alarm = alife_object(id)
                    if se_alarm then
                        alarm_pos = se_alarm.position
                        has_alarm = true
                        break
                    end
                end
            end
            if has_alarm then
                local snd = sound_object([[ambient\siren1]])
                if snd then snd:play_at_pos(db.actor, alarm_pos) end
            end
        end
    elseif chosen_event == "caravan" then
        local spawn_lvid, spawn_pos = stalker_camp_builder.get_furniture_front_vertex_and_pos(hub_obj.position, 2.2)
        local pos = spawn_pos or vector():set(hub_obj.position.x + 2, hub_obj.position.y + 0.1, hub_obj.position.z)
        local lvi = spawn_lvid or hub_obj.m_level_vertex_id
        local sec, comm = "stalker_regular", "stalker"
        if stalker_camp_builder.get_camp_trader_section then
            sec, comm = stalker_camp_builder.get_camp_trader_section(camp)
        end
        local se_trader = alife():create(sec, pos, lvi, hub_obj.m_game_vertex_id)
        if se_trader then
            camp.active_trader_id = se_trader.id
            camp.trader_spawn_time = game_sec()
            camp.trader_needs_stock = true
            camp.trader_community = comm

            camp_send_tip(db.actor, game.translate_string("st_event_caravan_arrived"), nil, "general_stalker", 12000)
        end
    elseif chosen_event == "harvester_degrade" then
        local harv_id = harvesters[mrandom(#harvesters)]
        local h_data = hf_obj_manager.get_data(harv_id) or {}
        local art_sec = h_data.artifact_section
        hf_obj_manager.update_data(harv_id, {
            artifact_condition = 0.01,
            progress_sec = 0
        })
        local obj = level.object_by_id(harv_id)
        local binder = obj and obj:binded_object()
        local wrapper = binder and binder.wrapper
        if wrapper then
            wrapper.artifact_condition = 0.01
            wrapper.progress_sec = 0
            if wrapper.refresh_sound_state then wrapper:refresh_sound_state() end
        end
        local art_name = game.translate_string(ini_sys:r_string_ex(art_sec, "inv_name") or art_sec)
        camp_send_tip(db.actor, string.format(game.translate_string("st_event_harvester_degraded"), camp.name or "camp"), nil, "general_stalker", 12000)
    end
end

function spawn_camp_raid(hub_id, camp, hub_obj)
    local actor = db.actor
    local mrandom = math.random
    local hub_pos = hub_obj.position
    local boundary = cfg.boundary_dist or 50
    local min_spawn_dist = math.max(boundary + 15, 60)
    local max_spawn_dist = min_spawn_dist + 40

    local valid_spawn_pos, valid_spawn_lvi, valid_spawn_gvi = nil, nil, nil

    local ray_angles = {}
    for i = 1, 16 do ray_angles[i] = (i - 1) * (math.pi / 8) end
    for i = #ray_angles, 2, -1 do
        local j = mrandom(i)
        ray_angles[i], ray_angles[j] = ray_angles[j], ray_angles[i]
    end

    local test_p = vector()
    for _, angle in ipairs(ray_angles) do
        for test_dist = min_spawn_dist, max_spawn_dist, 10 do
            test_p:set(
                hub_pos.x + test_dist * math.cos(angle),
                hub_pos.y,
                hub_pos.z + test_dist * math.sin(angle)
            )
            local test_lvi, actual_p = stalker_camp_builder.get_ground_vertex_and_pos(test_p, hub_pos.y, 10.0)
            if test_lvi and actual_p and actual_p:distance_to(hub_pos) >= (boundary + 5) then
                valid_spawn_pos = actual_p
                valid_spawn_lvi = test_lvi
                if level.cross_table and level.cross_table() then
                    valid_spawn_gvi = level.cross_table():vertex(test_lvi):game_vertex_id()
                else
                    valid_spawn_gvi = actor and actor:game_vertex_id() or 0
                end
                break
            end
        end
        if valid_spawn_pos then break end
    end

    if not valid_spawn_pos then
        return
    end

    local spawn_pos = valid_spawn_pos
    local spawn_lvi = valid_spawn_lvi
    local spawn_gvi = valid_spawn_gvi

    local sb = stalker_camp_builder
    local actor_comm = actor and character_community(actor) or "stalker"
    -- the player's community is "actor_<faction>"; the fallback below compares faction names
    local actor_fac = actor_comm:gsub("^actor_", "")

    local section = nil
    if mrandom(100) <= 35 then
        local mutant_squads = {
            "simulation_snork",
            "simulation_bloodsucker",
            "simulation_psy_dog",
            "zombied_sim_squad_veteran",
            "zombied_sim_squad_advanced"
        }
        section = mutant_squads[mrandom(#mutant_squads)]
    else
        local enemy_fac = sb.get_enemy_faction_for and sb.get_enemy_faction_for(actor_comm, level.name())
        if not enemy_fac or enemy_fac == actor_fac or enemy_fac == "stalker" or enemy_fac == "ecolog" then
            if actor_fac == "bandit" or actor_fac == "renegade" then
                enemy_fac = "stalker"
            elseif actor_fac == "dolg" or actor_fac == "army" then
                enemy_fac = "freedom"
            elseif actor_fac == "freedom" then
                enemy_fac = "dolg"
            else
                enemy_fac = "bandit"
            end
        end

        if sb.get_dynamic_squad_section_for_faction then
            section = sb.get_dynamic_squad_section_for_faction(enemy_fac)
        else
            section = enemy_fac .. "_sim_squad_advanced"
        end

        if not (ini_sys and ini_sys:section_exist(section)) then
            section = "monolith_sim_squad_veteran"
        end
    end

    local squad = create_squad_at_pos(section, spawn_pos, spawn_lvi, spawn_gvi, true)
    if squad then
        -- kept in the squad's save, unlike a function: get_script_target reads "actor" as the player
        squad.scripted_target = "actor"
        squad.rush = true

        local function enforce_raid_hostility()
            for k in safe_squad_members(squad) do
                local npc_cl = k.id and level.object_by_id(k.id)
                if npc_cl and npc_cl.set_relation then
                    npc_cl:set_relation(game_object.enemy, actor)
                    if camp and camp.survivors then
                        for s_id, s_data in pairs(camp.survivors) do
                            local s_cl = level.object_by_id(s_id)
                            if s_cl and s_cl.set_relation then
                                npc_cl:set_relation(game_object.enemy, s_cl)
                                s_cl:set_relation(game_object.enemy, npc_cl)
                            end
                        end
                    end
                end
            end
        end

        enforce_raid_hostility()

        CreateTimeEvent("homestead_raid_hostile_1_" .. squad.id, "hostile", 0.5, function()
            enforce_raid_hostility()
            return true
        end)
        CreateTimeEvent("homestead_raid_hostile_2_" .. squad.id, "hostile", 2.0, function()
            enforce_raid_hostility()
            return true
        end)

        local squad_size = 0
        for k in safe_squad_members(squad) do
            squad_size = squad_size + 1
        end
        camp.active_raid = {
            squad_id = squad.id,
            start_sec = game_sec(),
            raiders_killed = 0,
            guards_lost = 0,
            original_squad_size = squad_size,
            remaining_count = squad_size,
        }
        camp_send_tip(actor, string.format(game.translate_string("st_event_camp_under_attack"), game.translate_string(level.name()), game.translate_string("st_hostiles") or "hostiles"), nil, "red_danger", 15000, hub_id, "combat", true)

        local has_alarm = false
        local alarm_pos = hub_obj.position
        for id, struct_type in pairs(camp.structures) do
            if struct_type == "alarm" then
                local se_alarm = alife_object(id)
                if se_alarm then
                    alarm_pos = se_alarm.position
                    has_alarm = true

                    if bind_alarm_system and bind_alarm_system.toggle_alarm_system then
                        local data = hf_obj_manager.get_data(id)
                        if data and not data.is_on then
                            bind_alarm_system.toggle_alarm_system(id)
                        end
                    end
                end
            end
        end
        if has_alarm then
            local snd = sound_object([[ambient\siren1]])
            if snd then
                snd:play_at_pos(db.actor, alarm_pos)
            end
        end
    end
end

-- has_active_alarm -- does this camp have a switched-on alarm siren
local function has_active_alarm(camp)
    for id, struct_type in pairs(camp.structures or {}) do
        if struct_type == "alarm" then
            local se = alife_object(id)
            if se then
                local data = hf_obj_manager and hf_obj_manager.get_data and hf_obj_manager.get_data(id)
                if data and data.is_on then
                    return true
                end
            end
        end
    end
    return false
end

function process_camp_raids()
    local current_sec = game_sec()

    if not last_raid_game_sec then
        last_raid_game_sec = current_sec
        return
    end

    local elapsed = current_sec - last_raid_game_sec
    if elapsed < cfg.raid_cooldown then
        check_completed_raids()
        return
    end

    local player_pos = db.actor:position()
    for hub_id, camp in pairs(stalker_camp_builder.active_camps) do
        local survivor_count = 0
        if camp.survivors then
            for _ in pairs(camp.survivors) do
                survivor_count = survivor_count + 1
            end
        end
        local cur_lvl = level.name()
        -- a camp gets one raid cooldown of peace after it is founded
        local is_new = camp.created_time and (current_sec - camp.created_time) < cfg.raid_cooldown
        -- one raid at a time: a second would leave the first squad its "actor" target
        if survivor_count > 0 and not is_new and not camp.active_raid and (not camp.level or camp.level == cur_lvl) then
            local hub_obj = alife_object(hub_id)
            if hub_obj and hub_obj.position then
                local dist = hub_obj.position:distance_to(player_pos)
                if dist <= cfg.event_player_dist then
                    local stats = get_camp_stats(camp, hub_obj)
                    local defense_needed = stats.population * 3
                    local current_def = stats.defense
                    if has_active_alarm(camp) then
                        current_def = current_def + (cfg.alarm_defense_bonus or 15)
                    end
                    local defense_deficit = defense_needed - current_def
                    local raid_chance = cfg.raid_base_chance
                    if defense_deficit > 0 then
                        raid_chance = raid_chance + math.floor(defense_deficit * cfg.raid_deficit_mult)
                    end

                    if math.random(100) <= raid_chance then
                        last_raid_game_sec = current_sec
                        spawn_camp_raid(hub_id, camp, hub_obj)
                        break -- Process only one camp per tick
                    end
                end
            end
        end
    end

    check_completed_raids()
end

-- a camp's raid ends with the camp: the raiders' saved "actor" target would otherwise keep them
-- following the player to every level, as check_completed_raids sees only camps that still exist
function stalker_camp_builder.end_camp_raid(camp)
    local raid = camp and camp.active_raid
    if not raid then return end
    local squad = raid.squad_id and alife_object(raid.squad_id)
    -- only while the id still names a squad sent at the player, not a companion squad that took it
    if squad and squad.squad_members and squad.scripted_target == "actor"
        and not (axr_companions and axr_companions.companion_squads and axr_companions.companion_squads[squad.id]) then
        squad.scripted_target = nil
    end
    camp.active_raid = nil
end

function check_completed_raids()
    for hub_id, camp in pairs(stalker_camp_builder.active_camps) do
        if camp.active_raid and camp.level and camp.level ~= level.name() then
            -- the player has left the camp's level: the raid ends there, and the raiders stop following
            local squad = camp.active_raid.squad_id and alife_object(camp.active_raid.squad_id)
            if squad and squad.scripted_target == "actor" then
                squad.scripted_target = nil
            end
            camp.active_raid = nil
        elseif camp.active_raid then
            local raid = camp.active_raid
            local squad = camp.active_raid.squad_id and alife_object(camp.active_raid.squad_id)
            local squad_alive = false
            if squad then
                local has_alive = false
                for k in safe_squad_members(squad) do
                    local is_alive = false
                    local online_obj = level.object_by_id(k.id)
                    if online_obj then
                        is_alive = online_obj:alive()
                    else
                        local sim = alife()
                        local se_obj = k.object or (k.id and sim:object(k.id))
                        if se_obj and se_obj:alive() then
                            is_alive = true
                        end
                    end
                    if is_alive then
                        has_alive = true
                        break
                    end
                end
                squad_alive = has_alive
                local alive_count = 0
                for k in safe_squad_members(squad) do
                    local is_alive = false
                    local online_obj = level.object_by_id(k.id)
                    if online_obj then
                        is_alive = online_obj:alive()
                    else
                        local sim2 = alife()
                        local se_obj2 = k.object or (k.id and sim2:object(k.id))
                        if se_obj2 and se_obj2:alive() then
                            is_alive = true
                        end
                    end
                    if is_alive then alive_count = alive_count + 1 end
                end
                raid.remaining_count = alive_count
            else
                -- the engine releases a squad as soon as its last member dies
                raid.remaining_count = 0
            end

            if not squad_alive then
                local camp_name = camp.name or "Camp"
                local raiders_killed = raid.raiders_killed or 0
                if raid.original_squad_size and raid.remaining_count then
                    raiders_killed = raid.original_squad_size - raid.remaining_count
                end
                if db.actor then
                    camp_send_tip(db.actor, string.format(game.translate_string("st_raid_summary"), camp_name, raiders_killed, raid.guards_lost or 0), nil, "general_stalker", 12000, hub_id, "combat", true)
                end
                camp.active_raid = nil
            end
        end
    end
end

