local invalidate_mcm_cache = stalker_camp_builder.invalidate_mcm_cache

local function get_mcm_setting(opt_name)
    if not ui_mcm then return nil end
    ensure_mcm_paths()
    local path = mcm_option_path[opt_name]
    if not path then return nil end
    if opt_name ~= "respawn_rival_camps" and opt_name ~= "uninstall_purge_rival_furniture" and opt_name ~= "purge_rival_furniture" then
        local now = time_global()
        local cached = mcm_value_cache[opt_name]
        if cached and now < cached.expires_tg then
            return cached.value
        end
        local ok, value = pcall(function() return ui_mcm and ui_mcm.get(path) end)
        if not ok then return nil end
        mcm_value_cache[opt_name] = { value = value, expires_tg = now + MCM_CACHE_TTL_MS }
        return value
    end
    local ok, value = pcall(function() return ui_mcm and ui_mcm.get(path) end)
    return ok and value or nil
end

local cfg = {}
stalker_camp_builder.cfg = cfg
setmetatable(cfg, {
    __index = function(t, key)
        if ui_mcm then
            if key == "job_cook_interval" or key == "realtime_job_cook_interval" then
                local min = get_mcm_setting("realtime_job_cook_interval_min")
                return min and (min * 60) or defaults.realtime_job_cook_interval
            elseif key == "job_craft_interval" or key == "realtime_job_craft_interval" then
                local min = get_mcm_setting("realtime_job_craft_interval_min")
                return min and (min * 60) or defaults.realtime_job_craft_interval
            elseif key == "job_repair_interval" or key == "realtime_job_repair_interval" then
                local min = get_mcm_setting("realtime_job_repair_interval_min")
                return min and (min * 60) or defaults.realtime_job_repair_interval
            elseif key == "job_scavenge_interval" or key == "realtime_job_scavenge_interval" then
                local min = get_mcm_setting("realtime_job_scavenge_interval_min")
                return min and (min * 60) or defaults.realtime_job_scavenge_interval
            elseif key == "job_hunter_interval" or key == "realtime_job_hunter_interval" then
                local min = get_mcm_setting("realtime_job_hunter_interval_min")
                return min and (min * 60) or defaults.realtime_job_hunter_interval
            elseif key == "job_woodcutter_interval" or key == "realtime_job_woodcutter_interval" then
                local min = get_mcm_setting("realtime_job_woodcutter_interval_min")
                return min and (min * 60) or defaults.realtime_job_woodcutter_interval
            elseif key == "job_brewer_interval" or key == "realtime_job_brewer_interval" then
                local min = get_mcm_setting("realtime_job_brewer_interval_min")
                return min and (min * 60) or defaults.realtime_job_brewer_interval
            elseif key == "job_scrapper_interval" or key == "realtime_job_scrapper_interval" then
                local min = get_mcm_setting("realtime_job_scrapper_interval_min")
                return min and (min * 60) or defaults.realtime_job_scrapper_interval
            elseif key == "job_update_interval" then
                local hr = get_mcm_setting("job_update_interval_hr")
                return hr and (hr * 3600) or defaults.job_update_interval
            elseif key == "fridge_interval" then
                local hr = get_mcm_setting("fridge_interval_hr")
                return hr and (hr * 3600) or defaults.fridge_interval
            elseif key == "water_interval" then
                local hr = get_mcm_setting("water_interval_hr")
                return hr and (hr * 3600) or defaults.water_interval
            elseif key == "food_consumption_interval" then
                local hr = get_mcm_setting("food_consumption_interval_hr")
                return hr and (hr * 3600) or defaults.food_consumption_interval
            elseif key == "trader_despawn_time" then
                local hr = get_mcm_setting("trader_despawn_time_hr")
                return hr and (hr * 3600) or defaults.trader_despawn_time
            elseif key == "raid_cooldown" then
                local hr = get_mcm_setting("raid_cooldown_hr")
                return hr and (hr * 3600) or defaults.raid_cooldown
            elseif key == "event_cooldown" then
                local hr = get_mcm_setting("event_cooldown_hr")
                return hr and (hr * 3600) or defaults.event_cooldown
            elseif key == "rival_camp_setup_duration" then
                local hr = get_mcm_setting("rival_camp_setup_duration_hr")
                return hr and (hr * 3600) or defaults.rival_camp_setup_duration
            elseif key == "medic_job_interval" then
                local min = get_mcm_setting("medic_job_interval_min")
                return min and (min * 60) or defaults.medic_job_interval
            elseif key == "electrician_job_interval" then
                local min = get_mcm_setting("electrician_job_interval_min")
                return min and (min * 60) or defaults.electrician_job_interval
            elseif key == "boundary_warn" then
                local boundary = get_mcm_setting("boundary_dist")
                return boundary and (boundary - 5) or defaults.boundary_warn
            elseif key == "max_survivors_player_camp" then
                local val = get_mcm_setting("max_survivors_player_camp")
                if val ~= nil then return val end
                val = get_mcm_setting("max_survivors_per_camp")
                return val or defaults.max_survivors_player_camp
            elseif key == "max_survivors_rival_camp" then
                local val = get_mcm_setting("max_survivors_rival_camp")
                return val or defaults.max_survivors_rival_camp
            elseif key == "max_survivors_per_camp" then
                local val = get_mcm_setting("max_survivors_player_camp")
                if val ~= nil then return val end
                val = get_mcm_setting("max_survivors_per_camp")
                return val or defaults.max_survivors_player_camp
            elseif key == "craft_output_multiplier" then
                -- the slider stops at 3; a value saved under its old maximum of 5 stays saved until
                -- the slider is moved, and ui_mcm.get returns it as it is
                local val = get_mcm_setting("craft_output_multiplier")
                return val and mmin(3, val) or defaults.craft_output_multiplier
            elseif key == "scavenge_ambush_chance" or key == "scavenger_ambush_chance" then
                local val = get_mcm_setting("scavenger_ambush_chance")
                if val ~= nil then return val end
                val = get_mcm_setting("scavenge_ambush_chance")
                return val or defaults.scavenger_ambush_chance or 20
            else
                local val = get_mcm_setting(key)
                if val ~= nil then
                    return val
                end
            end
        end
        return defaults[key]
    end
})

local scavenge_loot_table = {
    "conserva", "tushonka", "vodka", "beer", "kolbasa",
    "ammo_9x18_fmj", "ammo_9x19_fmj", "ammo_12x70_buck", "ammo_5.45x39_fmj",
    "bread", "energy_drink", "cigarettes", "matches", "bottle_metal"
}

function get_active_camp_near(pos, custom_dist, opt_level_name)
    if not pos then return nil, nil end
    local max_dist = custom_dist or cfg.boundary_dist or 50
    local cur_lvl = opt_level_name or (level and level.name and level.name())
    local gg = game_graph()

    for hub_id, camp in pairs(stalker_camp_builder.active_camps) do
        local hub_obj = alife_object(hub_id)
        if hub_obj and hub_obj.position then
            local same_lvl = false
            if cur_lvl and cur_lvl ~= "" and cur_lvl ~= "unknown" then
                if camp.level and camp.level ~= "unknown" then
                    same_lvl = (camp.level == cur_lvl)
                elseif hub_obj.m_game_vertex_id and gg and alife() then
                    local gv = gg:vertex(hub_obj.m_game_vertex_id)
                    if gv then
                        local hlvl = alife():level_name(gv:level_id())
                        same_lvl = (hlvl == cur_lvl)
                    end
                end
            else
                same_lvl = true
            end

            if same_lvl then
                local y_diff = math.abs(hub_obj.position.y - pos.y)
                if y_diff <= 15.0 then
                    local dist = hub_obj.position:distance_to(pos)
                    if dist <= max_dist then
                        return hub_id, camp
                    end
                end
            end
        end
    end
    return nil, nil
end
stalker_camp_builder.get_active_camp_near = get_active_camp_near

function stalker_camp_builder.get_nearby_smart_terrain_hazard(pos, check_dist, lvl_name)
    if not pos then return nil end
    local current_lvl = lvl_name or (level and level.name and level.name())
    if not current_lvl then return nil end

    check_dist = check_dist or ((stalker_camp_builder.cfg and stalker_camp_builder.cfg.boundary_dist or 50) + 15)

    local smarts = nil
    if stalker_camp_builder.get_smart_terrains_on_level then
        smarts = stalker_camp_builder.get_smart_terrains_on_level(current_lvl)
    end

    local nearest_name, nearest_dist, nearest_obj = nil, math.huge, nil

    if smarts and #smarts > 0 then
        for _, entry in ipairs(smarts) do
            local sm = entry.obj
            if sm and sm.position then
                local d = pos:distance_to(sm.position)
                if d <= check_dist and d < nearest_dist then
                    nearest_dist = d
                    nearest_name = entry.name or (sm.name and sm:name())
                    nearest_obj = sm
                end
            end
        end
    elseif SIMBOARD and SIMBOARD.smarts_by_names then
        local sim = alife()
        local gg = game_graph()
        if sim and gg then
            for name, smart in pairs(SIMBOARD.smarts_by_names) do
                if smart and smart.position and smart.m_game_vertex_id then
                    local ok, s_lvl = pcall(function()
                        return sim:level_name(gg:vertex(smart.m_game_vertex_id):level_id())
                    end)
                    if ok and s_lvl == current_lvl then
                        local d = pos:distance_to(smart.position)
                        if d <= check_dist and d < nearest_dist then
                            nearest_dist = d
                            nearest_name = name
                            nearest_obj = smart
                        end
                    end
                end
            end
        end
    end

    if nearest_name then
        return nearest_name, nearest_dist, nearest_obj
    end
    return nil
end
local get_nearby_smart_terrain_hazard = stalker_camp_builder.get_nearby_smart_terrain_hazard

function get_camp_bed_capacity(camp)
    local capacity = 0
    for id, struct_type in pairs(camp.structures) do
        if struct_type == "bed" then
            capacity = capacity + 1
        end
    end
    return math.max(1, capacity)
end

