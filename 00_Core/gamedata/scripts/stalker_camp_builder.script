    safe_register_callback("server_entity_on_unregister", server_entity_on_unregister)
    -- the modded exes add this callback; elsewhere safe_register_callback registers nothing
    safe_register_callback("server_object_on_unregister", server_object_on_unregister)
    init_hf_pickup_hook()

    safe_register_callback("game_object_on_net_spawn", function(obj)
        local pairs_ = pairs
        if not (obj and IsStalker and IsStalker(obj)) then return end
        local id = obj:id()

        local m_data = alife_storage_manager and alife_storage_manager.get_state and alife_storage_manager.get_state()
        if m_data and m_data.stalker_camp_builder_freed_settlers and m_data.stalker_camp_builder_freed_settlers[id] then
            m_data.stalker_camp_builder_freed_settlers[id] = nil
            -- This runs after the binder has loaded the NPC's saved logic and before its net_spawn
            -- applies it (CGameObject::net_Spawn). Drop a settler or companion beh scheme saved while
            -- they belonged to the camp, so they start on their own logic.
            local st = db.storage[id]
            local saved_ltx = st and st.loaded_ini_filename
            if saved_ltx == "scripts\\beh_settler.ltx" or saved_ltx == "scripts\\beh_companion.ltx" then
                st.loaded_ini_filename = nil
                st.loaded_section_logic = nil
                st.loaded_active_section = nil
                st.loaded_gulag_name = ""
            end
            if stalker_camp_builder.restore_settler_logic then
                pcall(stalker_camp_builder.restore_settler_logic, obj)
            end
            if xr_motivator and xr_motivator.script_release then
                pcall(xr_motivator.script_release, obj)
            end
            pcall(function()
                obj:disable_info_portion("npcx_beh_wait")
                obj:disable_info_portion("npcx_beh_cannot_dismiss")
                obj:disable_info_portion("homestead_settler_guard")
                obj:disable_info_portion("homestead_settler_patrol")
                obj:disable_info_portion("npcx_is_companion")
                obj:set_movement_type(move.stand)
                obj:set_body_state(move.standing)
                obj:set_mental_state(anim.free)
                if state_mgr and state_mgr.set_state then
                    state_mgr.set_state(obj, "idle", nil, nil, nil, { fast_set = true })
                end
            end)
        end
        for hub_id, camp in pairs_(stalker_camp_builder.active_camps) do
            if camp.survivors and camp.survivors[id] then
                stalker_camp_builder.settler_lookup[id] = {
                    hub_id = hub_id,
                    camp = camp,
                    survivor = camp.survivors[id],
                }

                for other_id, _ in pairs_(camp.survivors) do
                    if other_id ~= id then
                        local other_obj = level.object_by_id(other_id)
                        if other_obj then
                            obj:force_set_goodwill(1000, other_obj)
                            other_obj:force_set_goodwill(1000, obj)
                        end
                    end
                end

                local survivor = camp.survivors[id]
                local job = survivor.job or "idle"
                -- a settler re-created at the hub takes back its community (restore_missing_settler,
                -- the invincible respawn); the method takes the squad and group too
                if survivor.pending_community then
                    pcall(function() obj:set_character_community(survivor.pending_community, 0, 0) end)
                    survivor.pending_community = nil
                end
                break
            end
        end
        if not stalker_camp_builder.settler_lookup[id] then
            local squad = get_object_squad(obj)
            if squad then
                for key, rcamp in pairs_(stalker_camp_builder.rival_camps) do
                    if type_(rcamp) == "table" then
                        local is_in_squad = (rcamp.squad_id == squad.id)
                        if not is_in_squad and rcamp.extra_squad_ids then
                            for _, ex_id in ipairs(rcamp.extra_squad_ids) do
                                if ex_id == squad.id then
                                    is_in_squad = true
                                    break
                                end
                            end
                        end
                        if is_in_squad then
                            stalker_camp_builder.settler_lookup[id] = {
                                hub_id = nil,
                                camp = nil,
                                survivor = nil,
                                is_rival = true,
                                rival_camp = rcamp,
                            }
                            break
                        end
                    end
                end
            end
        end
    end)

    -- DANZY EDIT: apply scavenged/crafted item condition once the item is online, inspected, or taken
    safe_register_callback("actor_on_item_take", function(obj)
        stalker_camp_builder.apply_pending_cond(obj)
    end)
    safe_register_callback("actor_on_item_put_in_box", function(box, obj)
        if box and stalker_camp_builder.on_actor_box_change then
            stalker_camp_builder.on_actor_box_change(box:id(), obj, true)
        end
