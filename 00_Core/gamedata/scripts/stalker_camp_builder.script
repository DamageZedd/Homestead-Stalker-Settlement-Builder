-- get_furniture_front_vertex_and_pos -- returns valid level vertex and pos offset
function stalker_camp_builder.get_furniture_front_vertex_and_pos(struct_or_pos, offset_dist)
    local base_pos = nil
    if type(struct_or_pos) == "userdata" and struct_or_pos.x and struct_or_pos.y and struct_or_pos.z then
        base_pos = struct_or_pos
    elseif type(struct_or_pos) == "userdata" and struct_or_pos.position then
        base_pos = struct_or_pos.position
    elseif type(struct_or_pos) == "number" then
        local se = alife_object(struct_or_pos)
        base_pos = se and se.position
    elseif type(struct_or_pos) == "table" and struct_or_pos.position then
        base_pos = struct_or_pos.position
    elseif type(struct_or_pos) == "table" and struct_or_pos.x and struct_or_pos.y and struct_or_pos.z then
        base_pos = struct_or_pos
    end
    if not base_pos or not level then return nil, nil end

    local dist = offset_dist or 1.4
    local best_lvid = nil
    local best_pos = nil
    local best_score = math.huge
    local tp = vector()

    for _, dir in ipairs(STATIC_UNIT_STAND_DIRS) do
        tp:set(base_pos.x + dir[1] * dist, base_pos.y, base_pos.z + dir[2] * dist)
        local lvid = level.vertex_id(tp)
        if lvid and lvid < 4294967295 and lvid ~= -1 then
            local vp = level.vertex_position(lvid)
            if vp then
                local y_delta = math.abs(vp.y - base_pos.y)
                local h_dist = vp:distance_to(base_pos)
                if y_delta <= 0.55 and h_dist >= 0.8 and h_dist <= 2.5 then
                    local score = h_dist + (y_delta * 4.0)
                    if score < best_score then
                        best_score = score
                        best_lvid = lvid
                        best_pos = vp
                    end
                end
            end
        end
    end

    if best_lvid and best_pos then
        local safe_pos = vector():set(best_pos.x, best_pos.y + 0.1, best_pos.z)
        return best_lvid, safe_pos, base_pos
    end

    local fb_lvid = level.vertex_id(base_pos)
    if fb_lvid and fb_lvid < 4294967295 and fb_lvid ~= -1 then
        local fb_pos = level.vertex_position(fb_lvid)
        if fb_pos then
            local safe_fb = vector():set(fb_pos.x, fb_pos.y + 0.1, fb_pos.z)
            return fb_lvid, safe_fb, base_pos
        end
    end

    return nil, nil, base_pos
end
local get_furniture_front_vertex_and_pos = stalker_camp_builder.get_furniture_front_vertex_and_pos

