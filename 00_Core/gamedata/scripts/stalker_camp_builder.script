-- EXPEDITION SALVAGE STARS & CAMP STORAGE METRICS
function get_camp_storage_metrics(camp, hub_obj)
    if not camp then return 0, 100, 0, 0 end

    local tg = time_global()
    if camp._cached_storage_metrics_tg and (tg - camp._cached_storage_metrics_tg) < 15000 and camp._cached_storage_metrics then
        local c = camp._cached_storage_metrics
        return c.weight, c.max_weight, c.total_items, c.pct
    end

    local total_items = 0
    local total_weight = 0
    local max_weight = 200

    local hub_id = camp.hub_id or (hub_obj and hub_obj.id)
    if not hub_id then return 0, 100, 0, 0 end

    if stalker_camp_builder.get_camp_inventory_snapshot then
        local snap = stalker_camp_builder.get_camp_inventory_snapshot(hub_id, camp, false)
        if snap and camp._cached_storage_metrics then
            local c = camp._cached_storage_metrics
            return c.weight, c.max_weight, c.total_items, c.pct
        end
    end
    if (camp._structures_scanned == nil) and scan_camp_structures then
        scan_camp_structures(hub_id, false)
    end
    local boxes = (get_camp_containers and get_camp_containers(hub_id, camp)) or {}
    -- each box's own capacity, the one deposits stop at (box_has_room_for); a box without one
    -- counts the 60 kg Hideout Furniture gives a stash without one (stash_capacities.script)
    max_weight = 0
    for _, bid in ipairs(boxes) do
        max_weight = max_weight + (stalker_camp_builder.get_box_capacity(bid) or 60)
    end
    if max_weight <= 0 then max_weight = 60 end

    local sys_ini_obj = ini_sys or sys_ini or system_ini()
    stalker_camp_builder.camp_iterate_inventory(hub_id, camp, function(item_id, sec, cond, uses, se_obj, box_id, cl_item)
        total_items = total_items + 1
        local w = 0.1
        if cl_item and cl_item.weight then
            local ok_w, iw = pcall(function() return cl_item:weight() end)
            if ok_w and iw then w = iw end
        elseif sys_ini_obj and sys_ini_obj.r_float_ex and sec then
            w = sys_ini_obj:r_float_ex(sec, "inv_weight") or 0.1
        end
        total_weight = total_weight + w
    end)

    local pct = math.min(100, math.floor((total_weight / max_weight) * 100))
    local f_weight = math.floor(total_weight)
    camp._cached_storage_metrics_tg = tg
    camp._cached_storage_metrics = {
        weight = f_weight,
        max_weight = max_weight,
        total_items = total_items,
        pct = pct
    }
    return f_weight, max_weight, total_items, pct
end

-- SETTLEMENT RADIO & ACTIVITY LOG SYSTEM (v1.0.3)
stalker_camp_builder.radio_logs = stalker_camp_builder.radio_logs or {}
stalker_camp_builder.radio_logs["all"] = stalker_camp_builder.radio_logs["all"] or {}

-- trims a log to max entries: a Radio Scan's lines (flagged scan) go first, oldest first, then the
-- oldest reports. The next scan writes its lines again; a report pushed out is gone.
local function trim_radio_log(logs, max)
    for i = #logs, 1, -1 do
        if #logs <= max then return end
        if logs[i].scan then
            table.remove(logs, i)
        end
    end
    while #logs > max do
        table.remove(logs)
    end
end

function stalker_camp_builder.intercept_pda_news_message(raw_text, sender, sender_id)
    -- Deprecated in v1.2.4 (fixes #253): Homestead tips are dispatched directly via camp_send_tip
end

function add_camp_radio_log(hub_id, category, text)
    if not text or text == "" then return end
    stalker_camp_builder.radio_logs = stalker_camp_builder.radio_logs or {}

    local h = (level and level.get_time_hours and level.get_time_hours()) or 12
    local m = (level and level.get_time_minutes and level.get_time_minutes()) or 0
    local time_str = string.format("%02d:%02d", h, m)

    local all_logs = stalker_camp_builder.radio_logs["all"] or {}

    for i = 1, math.min(5, #all_logs) do
        if all_logs[i].text == text then
            if all_logs[i].category == "general" and category and category ~= "general" then
                all_logs[i].category = category
            end
            return
        end
    end

    table.insert(all_logs, 1, {
        time_str = time_str,
        category = category or "general",
        text = text
    })
    trim_radio_log(all_logs, 50)
    stalker_camp_builder.radio_logs["all"] = all_logs

    if hub_id then
        local camp_logs = stalker_camp_builder.radio_logs[hub_id] or {}
        local c_dup = false
        for i = 1, math.min(5, #camp_logs) do
            if camp_logs[i].text == text then
                c_dup = true
                break
            end
        end
        if not c_dup then
            table.insert(camp_logs, 1, {
                time_str = time_str,
                category = category or "general",
                text = text
            })
            while #camp_logs > 50 do
                table.remove(camp_logs)
            end
            stalker_camp_builder.radio_logs[hub_id] = camp_logs
        end
    end

    if ui_stalker_camp_builder_pda and ui_stalker_camp_builder_pda.get_singleton then
        local pda = ui_stalker_camp_builder_pda.get_singleton()
        if pda and pda:IsShown() and pda.current_tab == "radio" then
            pda:PopulateRadioFeed()
        end
    end
end

function add_radio_feed_entry(category, text)
    add_camp_radio_log(nil, category, text)
end

function clear_camp_radio_logs(hub_id)
    stalker_camp_builder.radio_logs = stalker_camp_builder.radio_logs or {}
    if hub_id then
        stalker_camp_builder.radio_logs[hub_id] = {}
    end
    stalker_camp_builder.radio_logs["all"] = {}
end

function hook_homestead_news_manager()
    -- Deprecated in v1.2.4 (fixes #253): removed global news_manager monkeypatch to prevent foreign mod tips from polluting settlement logs
end

function stalker_camp_builder.seed_initial_settlement_telemetry(force_refresh)
    local pairs_ = pairs
    local sformat = string.format
    stalker_camp_builder.radio_logs = stalker_camp_builder.radio_logs or {}
    stalker_camp_builder.radio_logs["all"] = stalker_camp_builder.radio_logs["all"] or {}

    local g_logs = stalker_camp_builder.radio_logs["all"]
    if not force_refresh and #g_logs >= 2 then
        return
    end
    -- a scan's lines replace the previous scan's (flagged at the end) instead of pushing the real
    -- reports out of the log, which add_camp_radio_log keeps to 50 entries
    for i = #g_logs, 1, -1 do
        if g_logs[i].scan then
            table.remove(g_logs, i)
        end
    end
    local kept = #g_logs

    local h = (level and level.get_time_hours and level.get_time_hours()) or 12
    local m = (level and level.get_time_minutes and level.get_time_minutes()) or 0
    local time_str = sformat("%02d:%02d", h, m)

    if #g_logs == 0 or force_refresh then
        table.insert(g_logs, 1, {
            time_str = time_str,
            category = "general",
            text = "Homestead Transceiver Online. Synced to 148.500 MHz Zone-wide frequency network."
        })
    end

    local active_camps = stalker_camp_builder.active_camps or {}
    local camp_count = 0
    for hid, c in pairs_(active_camps) do
        camp_count = camp_count + 1
        local c_name = c.name or "Settlement"
        local c_lvl = game.translate_string(c.level or "unknown")
        local survivors = c.survivors or {}
        local pop = 0
        for _ in pairs_(survivors) do pop = pop + 1 end
        local def, mor = 20, 75
        local ok_stats, camp_stats = pcall(get_camp_stats, c)
        if ok_stats and type(camp_stats) == "table" and camp_stats.defense then
            def = camp_stats.defense
            -- the morale the Overview, the map marker and abandonment use (get_camp_morale is
            -- the separate score behind the hospitality buff)
            mor = camp_stats.happiness or mor
        end

        table.insert(g_logs, 1, {
            time_str = time_str,
            category = "work",
            text = sformat("TRANSCEIVER [%s | %s]: Garrison online. Pop: %d, Defense Rating: %d, Morale: %d%%.", c_name, c_lvl, pop, def, mor)
        })

        for _, surv in pairs_(survivors) do
            local s_name = surv.name or "Settler"
            local s_job = surv.job or "idle"
            if s_job == "scavenge" then
                table.insert(g_logs, 1, {
                    time_str = time_str,
                    category = "expedition",
                    text = sformat("EXPEDITION: %s is currently deployed on field scavenging sweep (Target: %s).", s_name, surv.scavenge_target or "Zone Ruins")
                })
            elseif s_job == "craft" then
                table.insert(g_logs, 1, {
                    time_str = time_str,
                    category = "work",
                    text = sformat("WORKSHOP: %s is crafting ammunition and managing workbench tooling.", s_name)
                })
            elseif s_job == "repair" then
                table.insert(g_logs, 1, {
                    time_str = time_str,
                    category = "work",
                    text = sformat("MAINTENANCE: %s is inspecting settlement armory and condition repairs.", s_name)
                })
            elseif s_job == "medic" then
                table.insert(g_logs, 1, {
                    time_str = time_str,
                    category = "work",
                    text = sformat("INFIRMARY: %s is monitoring camp medical supplies and triage care.", s_name)
                })
            elseif s_job == "cook" then
                table.insert(g_logs, 1, {
                    time_str = time_str,
                    category = "work",
                    text = sformat("KITCHEN: %s is preparing hot rations and campfire meals.", s_name)
                })
            elseif s_job == "guard" then
                table.insert(g_logs, 1, {
                    time_str = time_str,
                    category = "combat",
                    text = sformat("SECURITY: %s is stationed on camp perimeter guard watch.", s_name)
                })
            end
        end
    end

    -- hostile as the Rivals tab judges it: occupied, not cleared, and at war with the player.
    -- Rival camps have no is_hostile field; abandoned and friendly outposts aren't reported.
    local rival_camps = stalker_camp_builder.rival_camps or {}
    for sm_id, rcamp in pairs_(rival_camps) do
        local r_name = rcamp.name or "Rival Camp"
        local r_lvl = game.translate_string(rcamp.level or "unknown")
        local fac = rcamp.faction
        local text
        if rcamp.status == "mutant_nest" or fac == "monster" then
            text = sformat("INTEL RECON: Mutant nest at %s (%s).", r_name, r_lvl)
        elseif fac and rcamp.status ~= "unoccupied" and not rcamp.cleared then
            local actor_comm = db.actor and db.actor:character_community() or "stalker"
            if relation_registry.community_relation(fac, actor_comm) <= -1000 then
                text = sformat("INTEL RECON: Active hostile outpost at %s (%s) operated by %s forces.", r_name, r_lvl, game.translate_string(fac):upper())
            end
        end
        if text then
            table.insert(g_logs, 1, {
                time_str = time_str,
                category = "combat",
                text = text
            })
        end
    end

    if camp_count == 0 and #g_logs <= 1 then
        table.insert(g_logs, 1, {
            time_str = time_str,
            category = "general",
            text = "Zone Radio Scan Complete: No active settlement hubs detected. Place a workbench to initialize telemetry."
        })
    end
    for i = 1, #g_logs - kept do
        g_logs[i].scan = true
    end

    trim_radio_log(g_logs, 100)
end
