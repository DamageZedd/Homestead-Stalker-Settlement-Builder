local function _obj_id(obj) return obj:id() end
local function _obj_section(obj) return obj:section() end
local function _se_sec_name(se_obj) return se_obj:section_name() end
local function _client_pos(obj) return obj:position() end
local function _se_pos(obj) return obj.position end

-- Monolith / Anomaly Engine Crash Guard: alife_storage_manager
function patch_alife_storage_manager()
    if alife_storage_manager then
        if alife_storage_manager.get_game_object_state and not alife_storage_manager._homestead_patched then
            local orig_get_game_object_state = alife_storage_manager.get_game_object_state
            alife_storage_manager.get_game_object_state = function(obj, create_if_dont_exist)
                if not obj then return nil end
                local ok, id = pcall(_obj_id, obj)
                if not (ok and id) then return nil end
                local ok_call, res = pcall(orig_get_game_object_state, obj, create_if_dont_exist)
                if ok_call then return res end
                return nil
            end
            alife_storage_manager._homestead_patched = true
        end
        if alife_storage_manager.get_se_obj_state and not alife_storage_manager._homestead_se_patched then
            local orig_get_se_obj_state = alife_storage_manager.get_se_obj_state
            alife_storage_manager.get_se_obj_state = function(se_obj, create_if_dont_exist)
                if not (se_obj and se_obj.id) then return nil end
                local ok_call, res = pcall(orig_get_se_obj_state, se_obj, create_if_dont_exist)
                if ok_call then return res end
                return nil
            end
            alife_storage_manager._homestead_se_patched = true
        end
    end

    if _G.se_save_var and not _G._homestead_se_save_var_patched then
        local orig_se_save_var = _G.se_save_var
        _G.se_save_var = function(id, name, varname, val)
            if not id then return end
            if val ~= nil and alife_storage_manager and alife_storage_manager.get_state then
                local m_data = alife_storage_manager.get_state()
                if m_data and m_data.se_object and not m_data.se_object[id] then
                    local se_obj = alife_object(id)
                    if se_obj then
                        m_data.se_object[id] = {}
                        local sname = name
                        if not sname and se_obj.section_name then
                            local ok_s, sec = pcall(_se_sec_name, se_obj)
                            if ok_s and sec then sname = sec .. "_" .. tostring(id) end
                        end
                        m_data.se_object[id].name = sname or ("obj_" .. tostring(id))
                    end
                end
            end
            pcall(orig_se_save_var, id, name, varname, val)
        end
        _G._homestead_se_save_var_patched = true
    end
end
patch_alife_storage_manager()

local function safe_register_callback(name, func)
    if not func then return end
    if not RegisterScriptCallback then return end
    if axr_main and axr_main.callbacks and axr_main.callbacks[name] == nil then
        return
    end
    pcall(RegisterScriptCallback, name, func)
end
stalker_camp_builder.safe_register_callback = safe_register_callback
_G.safe_register_callback = _G.safe_register_callback or safe_register_callback

-- Monolith / Anomaly Engine Crash Guard: item_artefact binder save protection
-- Prevents fatal crash in zz_item_artefact.script line 255: attempt to index field 'object' (a userdata value)
function patch_item_artefact_binder_save()
    if item_artefact and item_artefact.artefact_binder and item_artefact.artefact_binder.save then
        if not item_artefact.artefact_binder._homestead_save_patched then
            local orig_art_save = item_artefact.artefact_binder.save
            item_artefact.artefact_binder._homestead_save_patched = true
            item_artefact.artefact_binder.save = function(self, stpk)
                local ok, err = pcall(function()
                    if not self then return end
                    -- In Luabind, indexing non-existent properties on userdata throws uncatchable-unless-pcalled error
                    local has_obj, obj = pcall(function() return self.object end)
                    if not (has_obj and obj) then
                        if object_binder and object_binder.save then
                            pcall(object_binder.save, self, stpk)
                        end
                        return
                    end
                    orig_art_save(self, stpk)
                end)
                if not ok then
                    printf("! [Homestead] Protected item_artefact.artefact_binder.save: %s", tostring(err))
                    if object_binder and object_binder.save then
                        pcall(object_binder.save, self, stpk)
                    end
                end
            end
        end
    end
end
patch_item_artefact_binder_save()

-- Watchdog Lag Protection: prevents false-positive Busy Hands detection (a_rax_wd)
-- during heavy asset loading / synchronous decompression (e.g. 3.8MB OGFs, textures)
function patch_watchdog_lag_protection()
    local function grant_watchdog_immunity()
        if a_rax_wd and a_rax_wd.save_state then
            pcall(a_rax_wd.save_state)
        end
    end

    -- Hook alife_create_item globally to protect against spawn lag spikes
    if _G.alife_create_item and not _G._homestead_alife_create_hooked then
        _G._homestead_alife_create_hooked = true
        local orig_alife_create = _G.alife_create_item
        _G.alife_create_item = function(sec, ...)
            if sec and type(sec) == "string" and (string.find(sec, "homestead", 1, true) or string.find(sec, "placeable", 1, true)) then
                grant_watchdog_immunity()
            end
            return orig_alife_create(sec, ...)
        end
    end

    -- Hook Debug Spawner directly
    local function hook_debug_spawner()
        if ui_debug_launcher and ui_debug_launcher.UIDebug_ItemSpawn then
            if not ui_debug_launcher.UIDebug_ItemSpawn._homestead_spawn_hooked then
                ui_debug_launcher.UIDebug_ItemSpawn._homestead_spawn_hooked = true
                local orig_spawn = ui_debug_launcher.UIDebug_ItemSpawn.Spawn
                if orig_spawn then
                    ui_debug_launcher.UIDebug_ItemSpawn.Spawn = function(self, section, ...)
                        grant_watchdog_immunity()
                        return orig_spawn(self, section, ...)
                    end
                end
                local orig_action_spawn = ui_debug_launcher.UIDebug_ItemSpawn.Action_SpawnItem
                if orig_action_spawn then
                    ui_debug_launcher.UIDebug_ItemSpawn.Action_SpawnItem = function(self, ...)
                        grant_watchdog_immunity()
                        return orig_action_spawn(self, ...)
                    end
                end
            end
        end
    end
    hook_debug_spawner()
    safe_register_callback("actor_on_first_update", hook_debug_spawner)

    -- Also grant immunity when actor receives or registers any homestead or placeable item
    safe_register_callback("actor_on_item_take", function(obj)
        if obj and a_rax_wd and a_rax_wd.save_state then
            local ok, sec = pcall(_obj_section, obj)
            if ok and sec and (sfind(sec, "homestead", 1, true) or sfind(sec, "placeable", 1, true)) then
                grant_watchdog_immunity()
            end
        end
    end)
    safe_register_callback("server_entity_on_register", function(se_obj)
        if se_obj and a_rax_wd and a_rax_wd.save_state then
            local ok, sec = pcall(_se_sec_name, se_obj)
            if ok and sec and (sfind(sec, "homestead", 1, true) or sfind(sec, "placeable", 1, true)) then
                grant_watchdog_immunity()
            end
        end
    end)
end
patch_watchdog_lag_protection()

-- Do NOT replace third-party actor_on_update callbacks (detec_bone_hide, demonized_ledge_grabbing)
-- or bind_stalker.actor_binder.update with wrappers defined in this file: Lua GC profilers attribute
-- all allocations inside a wrapped callback to the wrapper's script file, and per-frame xpcall closures
-- generate unnecessary garbage.
function patch_detec_bone_hide_guard()
end

function patch_ledge_grabbing_guard()
end

-- Logs a guarded error with its full traceback, once per key per 30 s so a per-frame error
-- cannot flood the log.
local guard_log_last = {}
function homestead_guard_log(tag, key, err)
    local now = time_global and time_global() or 0
    local last = guard_log_last[key]
    if last and now >= last and (now - last) < 30000 then return end
    guard_log_last[key] = now
    printf("[Homestead %s] %s: %s", tag, key, tostring(err))
end

-- pcall that reports a failure through homestead_guard_log (once per 30s per tag) instead of dropping it
local function guarded_call(tag, fn, ...)
    local ok, err = pcall(fn, ...)
    if not ok then homestead_guard_log("guard", tag, err) end
    return ok, err
end
stalker_camp_builder.guarded_call = guarded_call

-- Task Manager Crash Guard: wrap CGeneralTask.check_task directly with a zero-allocation pcall
-- instead of replacing CRandomTask.update or allocating closures per task on every frame.
function patch_task_manager_guard()
    if task_objects and task_objects.CGeneralTask and task_objects.CGeneralTask.check_task and not task_objects.CGeneralTask._homestead_guarded then
        task_objects.CGeneralTask._homestead_guarded = true
        local orig_check_task = task_objects.CGeneralTask.check_task
        task_objects.CGeneralTask.check_task = function(self, ...)
            local ok, err = pcall(orig_check_task, self, ...)
            if not ok then
                homestead_guard_log("Task Guard", "task:" .. tostring(self and self.id), err)
            end
        end
    end
end
patch_task_manager_guard()
safe_register_callback("actor_on_first_update", patch_task_manager_guard)

function patch_actor_binder_guard()
end

function patch_meat_spoiling_fridges()
    if not meat_spoiling then return end
    if meat_spoiling._homestead_patched then return end
    meat_spoiling._homestead_patched = true

    if meat_spoiling.get_meat_is_frozen then
        local orig_get_meat_is_frozen = meat_spoiling.get_meat_is_frozen
        meat_spoiling.get_meat_is_frozen = function(se_obj)
            if not se_obj then return false end
            if orig_get_meat_is_frozen(se_obj) then return true end
            local pid = se_obj.parent_id
            if pid and pid < 65535 then
                local se_parent = alife_object(pid)
                if se_parent then
                    local psec = se_parent:section_name()
                    if psec:find("fridge") or psec:find("refrigerator") or psec:find("cooler") then
                        return true
                    end
                    for _, camp in pairs(stalker_camp_builder.active_camps or {}) do
                        if camp.structures and camp.structures[pid] == "fridge" then
                            return true
                        end
                    end
                end
            end
            return false
        end
    end

    -- get_meat_is_frozen_cell stays as it is: it asks get_meat_is_frozen (above) about the meat
    -- meat_spoiling tracks, and nothing else, so other items in a fridge get no frozen tint
end
safe_register_callback("actor_on_first_update", patch_meat_spoiling_fridges)

stalker_camp_builder.settler_lookup = stalker_camp_builder.settler_lookup or {}

-- Local references for fast local access inside this file
local SAVE_STATE_VERSION = 2

-- `level` has no valid_vertex_id (that is a game graph method); u32(-1) means no vertex
local function is_level_vertex(lvid)
    return lvid and lvid < 4294967295 and lvid ~= -1 and lvid >= 0
end

-- The game time in whole seconds from 1 January of year 1, the epoch of the engine's game clock
-- (date_time.cpp generate_time). CTime:diffSec returns a float, which holds today's ~6.4e10
-- seconds only to the nearest 4096; CTime:get returns the exact date and time.
local GAME_SEC_DAYS_BEFORE_MONTH = { 0, 31, 59, 90, 120, 151, 181, 212, 243, 273, 304, 334 }
function game_sec()
    local y, mo, d, h, mi, s = game.get_game_time():get(0, 0, 0, 0, 0, 0, 0)
    local p = y - 1
    local days = p * 365 + mfloor(p / 4) - mfloor(p / 100) + mfloor(p / 400)
        + GAME_SEC_DAYS_BEFORE_MONTH[mo] + d - 1
    if mo > 2 and y % 4 == 0 and (y % 100 ~= 0 or y % 400 == 0) then
        days = days + 1
    end
    return ((days * 24 + h) * 60 + mi) * 60 + s
end

