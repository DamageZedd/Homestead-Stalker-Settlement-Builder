    safe_register_callback("actor_on_item_take_from_box", function(box, obj)
        stalker_camp_builder.apply_pending_cond(obj)
        if box and stalker_camp_builder.on_actor_box_change then
            stalker_camp_builder.on_actor_box_change(box:id(), obj, false)
