function get_active_camp_near(pos, custom_dist, opt_level_name, max_y_diff)
    if not pos then return nil, nil end
    local max_dist = custom_dist or cfg.boundary_dist or 50
    local cur_lvl = opt_level_name or (level and level.name and level.name())
    local gg = game_graph()

    for hub_id, camp in pairs(stalker_camp_builder.active_camps) do
        local hub_obj = alife_object(hub_id)
        if hub_obj and hub_obj.position then
            local same_lvl = false
            if cur_lvl and cur_lvl ~= "" and cur_lvl ~= "unknown" then
                if camp.level and camp.level ~= "unknown" then
                    same_lvl = (camp.level == cur_lvl)
                elseif hub_obj.m_game_vertex_id and gg and alife() then
                    local gv = gg:vertex(hub_obj.m_game_vertex_id)
                    if gv then
                        local hlvl = alife():level_name(gv:level_id())
                        same_lvl = (hlvl == cur_lvl)
                    end
                end
            else
                same_lvl = true
            end

            if same_lvl then
                local y_diff = math.abs(hub_obj.position.y - pos.y)
                if y_diff <= (max_y_diff or 15.0) then
                    local dist = hub_obj.position:distance_to(pos)
                    if dist <= max_dist then
                        return hub_id, camp
                    end
                end
            end
        end
    end
    return nil, nil
end
stalker_camp_builder.get_active_camp_near = get_active_camp_near

function stalker_camp_builder.get_nearby_smart_terrain_hazard(pos, check_dist, lvl_name)
    if not pos then return nil end
    local current_lvl = lvl_name or (level and level.name and level.name())
    if not current_lvl then return nil end

    check_dist = check_dist or ((stalker_camp_builder.cfg and stalker_camp_builder.cfg.boundary_dist or 50) + 15)

    local smarts = nil
    if stalker_camp_builder.get_smart_terrains_on_level then
        smarts = stalker_camp_builder.get_smart_terrains_on_level(current_lvl)
    end

    local nearest_name, nearest_dist, nearest_obj = nil, math.huge, nil

    if smarts and #smarts > 0 then
        for _, entry in ipairs(smarts) do
            local sm = entry.obj
            if sm and sm.position then
                local d = pos:distance_to(sm.position)
                if d <= check_dist and d < nearest_dist then
                    nearest_dist = d
                    nearest_name = entry.name or (sm.name and sm:name())
                    nearest_obj = sm
                end
            end
        end
    elseif SIMBOARD and SIMBOARD.smarts_by_names then
        local sim = alife()
        local gg = game_graph()
        if sim and gg then
            for name, smart in pairs(SIMBOARD.smarts_by_names) do
                if smart and smart.position and smart.m_game_vertex_id then
                    local ok, s_lvl = pcall(function()
                        return sim:level_name(gg:vertex(smart.m_game_vertex_id):level_id())
                    end)
                    if ok and s_lvl == current_lvl then
                        local d = pos:distance_to(smart.position)
                        if d <= check_dist and d < nearest_dist then
                            nearest_dist = d
                            nearest_name = name
                            nearest_obj = smart
                        end
                    end
                end
            end
        end
    end

    if nearest_name then
        return nearest_name, nearest_dist, nearest_obj
    end
    return nil
end
local get_nearby_smart_terrain_hazard = stalker_camp_builder.get_nearby_smart_terrain_hazard

function stalker_camp_builder.is_smart_respawn_blocked_in_camp(smart)
    local sb = stalker_camp_builder
    if not (sb.cfg and sb.cfg.block_respawn_in_settlements) then return false end
    if not (smart and smart.position) then return false end

    local sim = alife()
    local gg = game_graph()
    local s_lvl = nil
    if smart.m_game_vertex_id and sim and gg then
        local ok, lvl = pcall(function()
            return sim:level_name(gg:vertex(smart.m_game_vertex_id):level_id())
        end)
        if ok then s_lvl = lvl end
    end
    if not s_lvl and smart.is_on_actor_level and level and level.name then
        s_lvl = level.name()
    end

    local boundary = (sb.cfg and sb.cfg.boundary_dist) or 50
    local b_sqr = boundary * boundary

    for hub_id, camp in pairs(sb.active_camps or {}) do
        local camp_lvl = camp.level
        local match_level = (not camp_lvl or camp_lvl == "unknown" or not s_lvl or camp_lvl == s_lvl)
        if match_level then
            local hub = alife_object(hub_id)
            local hp = (camp.position and vector():set(camp.position.x, camp.position.y, camp.position.z))
                or (hub and hub.position)
            if hp then
                local dx = smart.position.x - hp.x
                local dy = smart.position.y - hp.y
                local dz = smart.position.z - hp.z
                if (dx * dx + dy * dy + dz * dz) <= b_sqr then
                    if sb.cfg.debug_logging then
                        printf("[Homestead] Blocked natural respawn at smart terrain %s (inside settlement perimeter)", smart:name())
                    end
                    return true
                end
            end
        end
    end

    return false
end
local is_smart_respawn_blocked_in_camp = stalker_camp_builder.is_smart_respawn_blocked_in_camp

function get_camp_bed_capacity(camp)
    local capacity = 0
    for id, struct_type in pairs(camp.structures) do
        if struct_type == "bed" then
            capacity = capacity + 1
        end
    end
    return math.max(1, capacity)
end

