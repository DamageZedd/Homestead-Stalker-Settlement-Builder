local homestead_is_disconnecting = false
stalker_camp_builder.homestead_teardown_grace_until = 0
stalker_camp_builder.homestead_is_disconnecting = false
local last_boundary_dist = nil

local tg_watchdog_next = 0

local tg_expedition_tick = 0

-- actor_on_update helpers

local function run_expedition_tick(tg)
    if tg >= tg_expedition_tick then
        tg_expedition_tick = tg + 1000
        pcall(stalker_camp_builder.process_stash_expeditions)
    end
end

local function run_weapon_watchdog(actor, tg)
    if tg < tg_watchdog_next then return end
    tg_watchdog_next = tg + 500

    local act_item = actor and actor:active_item()
    if not (act_item and IsWeapon and IsWeapon(act_item) and act_item:condition() >= 0.99) then
        return
    end

    pcall(function()
        local c_wpn = act_item.cast_Weapon and act_item:cast_Weapon()
        if c_wpn and c_wpn.IsMisfire and c_wpn:IsMisfire() then
            c_wpn:SetMisfire(false)
            if arti_jamming then
                if arti_jamming.set_jam_status then
                    arti_jamming.set_jam_status(act_item:id(), nil)
                end
                if arti_jamming.reset_cgd then
                    arti_jamming.reset_cgd()
                end
            end
        end
    end)
end

local function process_debug_respawn()
    if not ui_mcm then return end
    local requested = get_mcm_setting("respawn_rival_camps")
        or (ui_mcm.get and ui_mcm.get("stalker_camp_builder/qol_debug/respawn_rival_camps"))
    if not requested then return end
    pcall(function()
        ui_mcm.set("stalker_camp_builder/qol_debug/respawn_rival_camps", false)
    end)
    force_respawn_all_rival_camps()
end

local function process_uninstall_prep()
    if not ui_mcm then return end
    local requested = get_mcm_setting("uninstall_purge_rival_furniture")
        or get_mcm_setting("purge_rival_furniture")
        or (ui_mcm.get and ui_mcm.get("stalker_camp_builder/qol_debug/uninstall_purge_rival_furniture"))
    if not requested then return end

    pcall(function()
        ui_mcm.set("stalker_camp_builder/qol_debug/uninstall_purge_rival_furniture", false)
    end)

    local released = 0
    for _, camp in pairs(stalker_camp_builder.rival_camps or {}) do
        if type(camp) == "table" and camp.decorations then
            local list = camp.decorations   -- off the camp first, as in release_camp_decorations
            camp.decorations = {}
            for _, id in ipairs(list) do
                local ok, se_obj = pcall(alife_object, id)
                -- a freed id may name another object by now: release only outpost furniture
                if ok and se_obj and stalker_camp_builder.is_camp_decor and stalker_camp_builder.is_camp_decor(camp, id, se_obj) then
                    pcall(alife_release, se_obj)
                    released = released + 1
                end
            end
        end
    end

    if stalker_camp_builder.save_rival_camps then
        pcall(stalker_camp_builder.save_rival_camps)
    end

    local actor = db and db.actor
    if actor then
        local fmt = game.translate_string("st_homestead_uninstall_purge_done")
        if not fmt or fmt == "st_homestead_uninstall_purge_done" then
            fmt = "Homestead uninstall prep complete. Rival camp furniture released: %d"
        end
        local ok, msg = pcall(string.format, fmt, released)
        camp_send_tip(actor, ok and msg or fmt, nil, "general_stalker", 8000, nil, "general")
    end
    if cfg.debug_logging then
        printf("[Homestead] Uninstall prep: purged %d rival decorations/structures.", released)
    end
    return released
end

function stalker_camp_builder.purge_all_rival_furniture()
    return process_uninstall_prep()
end

local function process_boundary_rescan(actor)
    local current_boundary = cfg.boundary_dist
    if last_boundary_dist and last_boundary_dist ~= current_boundary then
        local cur_level = level and level.name and level.name()
        local camps_to_scan = {}
        for hub_id, camp in pairs(stalker_camp_builder.active_camps) do
            if not camp.level or camp.level == cur_level then
                camps_to_scan[#camps_to_scan + 1] = hub_id
            end
        end
        if #camps_to_scan == 1 then
            scan_camp_structures(camps_to_scan[1])
        elseif #camps_to_scan > 1 then
            scan_multiple_camp_structures(camps_to_scan)
        end
        camp_send_tip(actor, game.translate_string("st_mcm_boundary_rescanned"),
                      nil, "general_stalker", 8000, nil, "general")
    end
    last_boundary_dist = current_boundary
end

local function process_proximity_structure_rescan(tg)
    if not (db.actor and db.actor:alive()) then return end
    local near_hub_id, near_camp = get_active_camp_near(db.actor:position())
    if not near_camp then return end
    if near_camp._last_periodic_scan and (tg - near_camp._last_periodic_scan) <= 600000 then  -- DANZY EDIT: was every 60s
        return
    end
    near_camp._last_periodic_scan = tg
    scan_camp_structures(near_hub_id)
end

-- An outpost chest's treasure-manager entry only lists its loot. Once the player has taken from the
-- chest it is false, which G.A.M.M.A. reads as an empty stash free for new loot: a reward or a fetch
-- task's item put there would go with the outpost's decay.
local function forget_looted_outpost_chest(chest_id)
    local caches = treasure_manager and treasure_manager.caches
    if caches and caches[chest_id] == false then
        caches[chest_id] = nil
    end
end

local function populate_gamma_rival_chests(in_teardown_grace)
    if in_teardown_grace then return end
    local is_gamma_mode = (stalker_camp_builder_gamma_flag ~= nil)
        or (grok_stashes_on_corpses ~= nil)
    if not is_gamma_mode then return end

    pcall(function()
        for _, camp in pairs(stalker_camp_builder.rival_camps) do
            if type(camp) == "table" and camp.chest_id then
                forget_looted_outpost_chest(camp.chest_id)
                local box_obj = level.object_by_id(camp.chest_id)
                local has_cache = treasure_manager
                    and treasure_manager.caches
                    and type(treasure_manager.caches[camp.chest_id]) == "string"
                if box_obj and has_cache then
                    treasure_manager.try_spawn_treasure(box_obj)
                    safe_iterate_inventory_box(box_obj, function(_, item)
                        local ok_w = IsWeapon and IsWeapon(item)
                        local ok_o = IsOutfit and IsOutfit(item)
                        if (ok_w or ok_o) and item and item.set_condition then
                            pcall(function()
                                item:set_condition(math.random(10, 65) / 100)
                            end)
                        end
                    end)
                end
            end
        end
    end)
end

local PERIODIC_ACTOR_TASKS = {
    { name = "update_camp_jobs",           skip_during_grace = true  },
    { name = "update_rival_camps",         skip_during_grace = false },
    { name = "process_camp_raids",         skip_during_grace = false, global = true },
    { name = "process_camp_random_events", skip_during_grace = false, global = true },
    { name = "process_refugee_despawns",   skip_during_grace = false, global = true },
    { name = "check_camp_sleep_bonus",     skip_during_grace = false, global = true },
    { name = "process_camp_morale",        skip_during_grace = false, global = true },
    -- v1.1.8: trade routes restored (kept for the future route-setup UI)
    { name = "process_trade_routes",       skip_during_grace = true  },
}

local function run_periodic_actor_tasks(in_teardown_grace, first, last)
    for i = first or 1, last or #PERIODIC_ACTOR_TASKS do
        local task = PERIODIC_ACTOR_TASKS[i]
        if not (task.skip_during_grace and in_teardown_grace) then
            local fn = stalker_camp_builder[task.name]
            if fn then pcall(fn) end
        end
    end
end

local function process_surge_reaction()
    -- one roll per emission or psi-storm, as it starts (is_killing_all only turns true once the
    -- wave has killed the player); unset until the first check, so a load mid-storm doesn't roll
    local storm = (surge_manager and surge_manager.is_started and surge_manager.is_started())
        or (psi_storm_manager and psi_storm_manager.is_started and psi_storm_manager.is_started())
        or false
    local was = stalker_camp_builder.rival_storm_active
    stalker_camp_builder.rival_storm_active = storm
    if storm and was == false and stalker_camp_builder.process_rival_camp_surge then
        pcall(stalker_camp_builder.process_rival_camp_surge, true)
    end
end

local function process_hospitality_buff(actor)
    if cfg.rival_camp_hospitality == false then return end
    if not (actor and actor:alive()) then return end

    pcall(function()
        local mmin = math.min
        local actor_pos = actor:position()
        local actor_comm = actor:character_community() or "stalker"
        local cur_lvl = level.name()

        for _, camp in pairs(stalker_camp_builder.rival_camps) do
            if type(camp) == "table"
                and camp.level == cur_lvl
                and camp.position
                and camp.status ~= "unoccupied"
                and camp.status ~= "mutant_nest"
            then
                local rel = relation_registry.community_relation(
                    camp.faction or "stalker", actor_comm)
                if rel > -1000 then
                    local cpos = camp.position
                    local dx = cpos.x - actor_pos.x
                    local dy = cpos.y - actor_pos.y
                    local dz = cpos.z - actor_pos.z
                    if (dx * dx + dy * dy + dz * dz) <= 400.0 then
                        if actor.health < 1.0 then
                            actor.health = mmin(1.0, actor.health + 0.005)
                        end
                        if actor.power < 1.0 then
                            actor.power = mmin(1.0, actor.power + 0.05)
                        end
                        if actor.psy_health and actor.psy_health < 1.0 then
                            actor.psy_health = mmin(1.0, actor.psy_health + 0.005)
                        end
                        return
                    end
                end
            end
        end
    end)
end

local function process_all_settler_eating(in_teardown_grace)
    if in_teardown_grace then return end
    if not stalker_camp_builder.process_settler_eating then return end
    for hub_id, camp in pairs(stalker_camp_builder.active_camps) do
        pcall(stalker_camp_builder.process_settler_eating, hub_id, camp)
    end
end

-- actor_on_update -- per-tick orchestrator
function actor_on_update()
    local actor = db.actor
    if not actor then return end

    local tg = time_global()
    run_expedition_tick(tg)
    run_weapon_watchdog(actor, tg)

    -- One slot per second; each slot's work therefore still runs every 10s,
    -- but the work is spread out instead of landing on a single frame.
    if tg < tg_update then
        if (tg_update - tg) > 5000 then
            tg_update = tg
        else
            return
        end
    end
    tg_update = tg + 1000
    actor_update_slot = (actor_update_slot % 10) + 1

    local in_teardown_grace = (tg < homestead_teardown_grace_until)
    local slot = actor_update_slot

    if slot == 1 then
        run_periodic_actor_tasks(in_teardown_grace, 1, 1)   -- camp jobs
    elseif slot == 2 then
        process_debug_respawn()
        process_uninstall_prep()
        process_boundary_rescan(actor)
        process_proximity_structure_rescan(tg)
    elseif slot == 3 then
        run_periodic_actor_tasks(in_teardown_grace, 2, 2)   -- rival camps
    elseif slot == 4 then
        populate_gamma_rival_chests(in_teardown_grace)
    elseif slot == 5 then
        run_periodic_actor_tasks(in_teardown_grace, 3, 4)   -- raids, events
    elseif slot == 6 then
        run_periodic_actor_tasks(in_teardown_grace, 7, 7)   -- morale
    elseif slot == 7 then
        run_periodic_actor_tasks(in_teardown_grace, 5, 6)   -- refugees, sleep bonus
    elseif slot == 8 then
        process_all_settler_eating(in_teardown_grace)
    elseif slot == 9 then
        process_surge_reaction()
        process_hospitality_buff(actor)
        pcall(stalker_camp_builder.tick_hospitality_buff, actor)
        run_periodic_actor_tasks(in_teardown_grace, 8, 8)   -- trade routes
    else
        if sync_all_camp_map_spots then pcall(sync_all_camp_map_spots) end
    end
end

local last_refugee_despawn_check_tg = 0
local REFUGEE_DESPAWN_CHECK_INTERVAL_MS = 60000  -- 60 real seconds

-- whether the player could see the NPC go: it is online, or on the player's level within the switch
-- distance (stalker_camp_builder_rivals' is_player_near)
function stalker_camp_builder.in_player_range(se_obj)
    if se_obj.online then return true end
    local is_player_near = stalker_camp_builder.is_player_near
    if not is_player_near then return false end
    local gv = game_graph():vertex(se_obj.m_game_vertex_id)
    return is_player_near(gv and alife():level_name(gv:level_id()), se_obj.position)
end

function process_refugee_despawns()
    local now_tg = time_global()
    if (now_tg - last_refugee_despawn_check_tg) < REFUGEE_DESPAWN_CHECK_INTERVAL_MS then
        return
    end
    last_refugee_despawn_check_tg = now_tg

    local current_sec = game_sec()
    local REFUGEE_DESPAWN_TIME = 172800  -- 2 game days
    local to_despawn = {}
    for npc_id, info in pairs(stalker_camp_builder.refugee_ids) do
        if type(info) == "table" and info.arrived_sec then
            local elapsed = current_sec - info.arrived_sec
            if elapsed >= REFUGEE_DESPAWN_TIME then
                to_despawn[#to_despawn+1] = npc_id
            end
        end
    end
    local departed = 0
    for _, npc_id in ipairs(to_despawn) do
        local se_obj = alife_object(npc_id)
        -- only the refugee itself: once a dead refugee's body is released, its id goes to a later object
        if se_obj and IsStalker(se_obj) and se_obj:alive() and se_obj:section_name() == "stalker_regular" then
            -- a refugee leaves where the player can't see it go; until then its entry stays for the next check
            if not (stalker_camp_builder.in_player_range and stalker_camp_builder.in_player_range(se_obj)) then
                -- a refugee is in no squad, and alife_release removes stalkers only through their squad
                safe_release_manager.release(se_obj)
                departed = departed + 1
                stalker_camp_builder.refugee_ids[npc_id] = nil
            end
        else
            stalker_camp_builder.refugee_ids[npc_id] = nil
        end
    end
    if departed > 0 and db.actor then
        camp_send_tip(db.actor, string.format(game.translate_string("st_event_refugees_departed"), departed), nil, "general_stalker", 8000)
    end
end

function camp_npc_move_to(npc, lvid, extra_lvid)
    return stalker_camp_builder.camp_npc_move_to(npc, lvid, extra_lvid)
end

function camp_npc_arrive(npc)
    return stalker_camp_builder.camp_npc_arrive(npc)
end

local settler_next_tick = {}
-- npc_on_update helpers

local function run_rival_npc_patrol(npc, npc_id, rival_info)
    local mrandom = math.random
    if not rival_info or not rival_info.position then return end
    if level and level.name and rival_info.level and level.name() ~= rival_info.level then
        return
    end

    -- In combat, immediately surrender script control to engine combat AI
    if npc:best_enemy() ~= nil then
        if stalker_camp_builder.rival_npc_patrol then
            local p_data = stalker_camp_builder.rival_npc_patrol[npc_id]
            if p_data then
                p_data.target_lvid = nil
                p_data.wait_until = 0
            end
        end
        return
    end

    if not stalker_camp_builder.camp_npc_released[npc_id] then
        if xr_motivator and xr_motivator.script_release then
            xr_motivator.script_release(npc)
        end
        stalker_camp_builder.camp_npc_released[npc_id] = true
    end

    local chest_pos = vector():set(rival_info.position.x,
                                   rival_info.position.y,
                                   rival_info.position.z)
    local tg = time_global()

    stalker_camp_builder.rival_npc_patrol = stalker_camp_builder.rival_npc_patrol or {}
    local p_data = stalker_camp_builder.rival_npc_patrol[npc_id]
    if not p_data then
        p_data = { target_lvid = nil, wait_until = 0, last_move_tg = tg }
        stalker_camp_builder.rival_npc_patrol[npc_id] = p_data
    end
    p_data.wait_until = p_data.wait_until or 0

    local npc_pos = npc:position()
    if not npc_pos then return end
    local npc_lvid = npc:level_vertex_id()
    if not is_level_vertex(npc_lvid) then
        return
    end

    local is_reinforcing = false
    if p_data.reinforce_until then
        local def_camp = p_data.reinforce_camp
        if tg >= p_data.reinforce_until
            or not def_camp
            or def_camp.status == "unoccupied"
            or def_camp.status == "mutant_nest"
            or def_camp.faction ~= rival_info.faction then
            p_data.reinforce_until = nil
            p_data.reinforce_pos = nil
            p_data.reinforce_lvid = nil
            p_data.reinforce_camp = nil
            p_data.target_lvid = nil
            p_data.wait_until = 0
        else
            is_reinforcing = true
        end
    end

    local active_center_pos = is_reinforcing and p_data.reinforce_pos or chest_pos
    local active_center_lvid = is_reinforcing and p_data.reinforce_lvid or rival_info.level_vertex_id
    local dist_to_center = npc_pos:distance_to(active_center_pos)

    -- DISLODGE FIX: If NPC is stuck right on top of the blue box or perched on its collision mesh
    local y_diff = npc_pos.y - active_center_pos.y
    if dist_to_center < 1.0 and y_diff > 0.25 then
        local camp_rot = is_reinforcing and (p_data.reinforce_camp and p_data.reinforce_camp.rotation or 0) or (rival_info.rotation or 0)
        local nudge_ang = camp_rot + (mrandom(1, 4) * (math.pi * 0.5))
        local nudge_x = active_center_pos.x + 3.2 * math.cos(nudge_ang)
        local nudge_z = active_center_pos.z + 3.2 * math.sin(nudge_ang)
        local nudge_lvid = level.vertex_id(vector():set(nudge_x, active_center_pos.y, nudge_z))
        if is_level_vertex(nudge_lvid) and npc:accessible(nudge_lvid) then
            local nudge_vpos = level.vertex_position(nudge_lvid)
            if nudge_vpos and npc.set_npc_position then
                pcall(function()
                    npc:set_npc_position(nudge_vpos)
                    p_data.target_lvid = nudge_lvid
                    p_data.wait_until = tg + math.random(5000, 10000)
                    if camp_npc_arrive then camp_npc_arrive(npc) end
                end)
                return
            end
        end
    end

    -- Leash: If too far from active camp (e.g. wandered > 16m), return to perimeter
    if dist_to_center > 16 then
        local safe_lvid = (active_center_lvid and is_level_vertex(active_center_lvid) and npc:accessible(active_center_lvid)) and active_center_lvid or npc_lvid
        p_data.target_lvid = safe_lvid
        p_data.wait_until = 0
    end

    local at_target = false
    if dist_to_center > 16 then
        -- En route to camp perimeter: keep moving towards perimeter, do not pause or idle
        at_target = false
    else
        if p_data.target_lvid then
            if not (is_level_vertex(p_data.target_lvid) and npc:accessible(p_data.target_lvid)) then
                p_data.target_lvid = npc_lvid
                at_target = true
            else
                local t_pos = level.vertex_position(p_data.target_lvid)
                if t_pos and npc_pos:distance_to_sqr(t_pos) < 2.25 then
                    at_target = true
                end
            end
        else
            at_target = true
        end

        -- Timeout safety: if an NPC has been trying to walk to target for > 12 seconds, arrive
        if p_data.last_move_tg and (tg - p_data.last_move_tg) > 12000 then
            at_target = true
        end
    end

    if at_target or (npc:path_completed() and tg > p_data.wait_until) then
        if tg > p_data.wait_until then
            p_data.wait_until = tg + mrandom(7000, 15000)
            p_data.last_move_tg = tg

            -- Tactical guard/patrol stations around camp barricades and hearth
            local camp_rot = is_reinforcing and (p_data.reinforce_camp and p_data.reinforce_camp.rotation or 0) or (rival_info.rotation or 0)
            local cos_r = math.cos(camp_rot)
            local sin_r = math.sin(camp_rot)
            local patrol_offsets = {
                { lx = 0.0,  lz = 3.5 },  -- Front entrance / barricade
                { lx = -2.8, lz = 1.0 },  -- Left flank wall
                { lx = 2.8,  lz = 1.0 },  -- Right flank wall
                { lx = 0.6,  lz = -1.5 }, -- Camp hearth / bivouac
                { lx = -1.8, lz = 2.6 },  -- Left perimeter cover
                { lx = 1.8,  lz = 2.6 },  -- Right perimeter cover
            }

            local found_lvid = nil
            local attempts = 0
            local test_p = vector()

            local shuffled_indices = { 1, 2, 3, 4, 5, 6 }
            for i = #shuffled_indices, 2, -1 do
                local j = mrandom(i)
                shuffled_indices[i], shuffled_indices[j] = shuffled_indices[j], shuffled_indices[i]
            end

            for _, idx in ipairs(shuffled_indices) do
                local off = patrol_offsets[idx]
                local wx = active_center_pos.x + off.lx * cos_r - off.lz * sin_r
                local wz = active_center_pos.z + off.lx * sin_r + off.lz * cos_r
                test_p:set(wx, active_center_pos.y, wz)
                local test_lvid = level.vertex_id(test_p)
                if test_lvid and test_lvid < 4294967295 and test_lvid ~= -1 and npc:accessible(test_lvid) then
                    if utils_obj and utils_obj.send_to_nearest_accessible_vertex then
                        test_lvid = utils_obj.send_to_nearest_accessible_vertex(npc, test_lvid)
                    end
                    if test_lvid then
                        found_lvid = test_lvid
                        break
                    end
                end
            end

            -- Fallback: random radial search 2.5m - 5.5m away (never closer than 2.0m to chest)
            if not found_lvid then
                while attempts < 12 do
                    attempts = attempts + 1
                    local angle = mrandom() * math.pi * 2
                    local r = mrandom() * 3.0 + 2.5
                    test_p:set(
                        active_center_pos.x + r * math.cos(angle),
                        active_center_pos.y,
                        active_center_pos.z + r * math.sin(angle))
                    local test_lvid = level.vertex_id(test_p)
                    if test_lvid and test_lvid < 4294967295 and test_lvid ~= -1 and npc:accessible(test_lvid) then
                        if utils_obj and utils_obj.send_to_nearest_accessible_vertex then
                            test_lvid = utils_obj.send_to_nearest_accessible_vertex(npc, test_lvid)
                        end
                        if test_lvid then
                            found_lvid = test_lvid
                            break
                        end
                    end
                end
            end

            local safe_fallback = (active_center_lvid and is_level_vertex(active_center_lvid) and npc:accessible(active_center_lvid)) and active_center_lvid or npc_lvid
            p_data.target_lvid = found_lvid or safe_fallback
        else
            -- At target: play alert, guard, and patrol idle animations looking outwards
            local cur_state = state_mgr.get_state(npc)
            local valid_states = {
                ["guard"] = true,
                ["threat_na"] = true,
                ["wait_na"] = true,
                ["caution"] = true,
                ["smoking_stand"] = true,
                ["sit_knee"] = true,
            }
            if not valid_states[cur_state] then
                local idles = { "guard", "threat_na", "wait_na", "caution", "smoking_stand", "sit_knee" }
                local chosen_idle = idles[mrandom(#idles)]
                local look_pos = vector():set(
                    npc_pos.x + (npc_pos.x - active_center_pos.x) * 2.0,
                    npc_pos.y,
                    npc_pos.z + (npc_pos.z - active_center_pos.z) * 2.0
                )
                state_mgr.set_state(npc, chosen_idle, nil, nil, { look_position = look_pos }, { fast_set = true })
            end
            return
        end
    end

    if p_data.target_lvid and p_data.target_lvid ~= npc_lvid then
        camp_npc_move_to(npc, p_data.target_lvid)
        if is_reinforcing and dist_to_center > 16 then
            pcall(function()
                npc:set_movement_type(move.run)
                npc:set_mental_state(anim.danger)
                if state_mgr then
                    state_mgr.set_state(npc, "rush", nil, nil, nil, { fast_set = true })
                end
            end)
        end
    end
end

local function refresh_settler_goodwill(npc, npc_id, my_camp, now_tg)
    local cache = camp_npc_furniture_cache[npc_id]
    local last_refresh = cache and cache.relation_refresh_tg or 0
    if (now_tg - last_refresh) <= 10000 then return end

    camp_npc_furniture_cache[npc_id] = cache or {}
    camp_npc_furniture_cache[npc_id].relation_refresh_tg = now_tg

    for other_id in pairs(my_camp.survivors) do
        if other_id ~= npc_id then
            local other_obj = level.object_by_id(other_id)
            if other_obj and other_obj.alive and other_obj:alive() then
                npc:force_set_goodwill(1000, other_obj)
            end
        end
    end
end

local function handle_refugee_ai(npc, dist, hub_obj)
    if dist > 4 then
        -- the hub's vertex is under the workbench, and a refugee runs no scheme, so the sit
        -- below doesn't stop the walk: walk to the spot in front of the hub refugees spawn at
        local front_lvid = get_furniture_front_vertex_and_pos(hub_obj.position, 2.0)
        camp_npc_move_to(npc, front_lvid or hub_obj.m_level_vertex_id)
        return
    end
    camp_npc_arrive(npc)
    local state = state_mgr.get_state(npc)
    if state ~= "sit_knee" and state ~= "wait_na" then
        if math.random(100) < 50 then
            state_mgr.set_state(npc, "sit_knee")
        else
            state_mgr.set_state(npc, "wait_na")
        end
    end
end

local function enforce_settler_leash(npc, npc_id, my_survivor, my_hub_id, hub_obj, dist, max_boundary)
    if dist > (max_boundary * 1.25) then
        pcall(function()
            stalker_camp_builder.teleport_settler_to_camp_level(npc_id, my_hub_id, true)
        end)
        return "teleported"
    end

    -- a settler with a post goes back to it in the job code, not toward the hub
    if my_survivor and my_survivor.assigned_pos then return "ok" end

    local leash = max_boundary
    if my_survivor and (my_survivor.job == "idle" or not my_survivor.job) then
        leash = math.min(max_boundary, math.max(3, cfg.npc_leash_radius or 10))
    end

    if dist > leash then
        -- in a fight the engine's combat actions move the settler; a walk would override them
        if npc:best_enemy() ~= nil then return "in_combat" end
        camp_npc_move_to(npc, hub_obj.m_level_vertex_id)
        return "soft_leashed"
    end
    return "ok"
end

local pairs_ = pairs

-- npc_on_update -- settler per-tick AI orchestrator
function npc_on_update(npc)
    if not npc then return end
    local npc_id = npc:id()

    local sb = stalker_camp_builder
    local lookup = sb.settler_lookup and sb.settler_lookup[npc_id]
    -- DANZY EDIT: ordinary NPCs (not settlers/rivals) were re-checked against every
    -- camp on every update. Remember "not a settler" and only re-check every 5s.
    if not lookup then
        local ns = sb.non_settler_cache and sb.non_settler_cache[npc_id]
        if type(ns) == "number" and time_global() < ns then return end
    end
    if not npc:alive() then return end
    if not lookup then
        local found = false
        for hub_id, camp in pairs_(sb.active_camps) do
            if camp.survivors and camp.survivors[npc_id] then
                sb.settler_lookup[npc_id] = {
                    hub_id   = hub_id,
                    camp     = camp,
                    survivor = camp.survivors[npc_id],
                }
                lookup = sb.settler_lookup[npc_id]
                found = true
                if sb.non_settler_cache then sb.non_settler_cache[npc_id] = nil end
                break
            end
        end
        if not found and sb.rival_camps then
            local squad = get_object_squad(npc)
            local squad_id = squad and squad.id
            if squad_id then
                for key, rcamp in pairs_(sb.rival_camps) do
                    if type(rcamp) == "table" then
                        local is_in_squad = (rcamp.squad_id == squad_id)
                        if not is_in_squad and rcamp.extra_squad_ids then
                            for _, ex_id in ipairs(rcamp.extra_squad_ids) do
                                if ex_id == squad_id then
                                    is_in_squad = true
                                    break
                                end
                            end
                        end
                        if is_in_squad then
                            sb.settler_lookup[npc_id] = {
                                hub_id = nil,
                                camp = nil,
                                survivor = nil,
                                is_rival = true,
                                rival_camp = rcamp,
                            }
                            lookup = sb.settler_lookup[npc_id]
                            found = true
                            if sb.non_settler_cache then sb.non_settler_cache[npc_id] = nil end
                            break
                        end
                    end
                end
            end
        end
        if not found and sb.refugee_ids[npc_id] then
            -- a refugee is in no camp's survivors; the refugee branch below finds its camp
            sb.settler_lookup[npc_id] = { is_refugee = true }
            lookup = sb.settler_lookup[npc_id]
            found = true
        end
        if not found then
            sb.non_settler_cache = sb.non_settler_cache or {}
            sb.non_settler_cache[npc_id] = time_global() + 5000
            return
        end
    end

    local tg = time_global()
    local next_t = settler_next_tick[npc_id] or 0
    if tg < next_t then return end
    settler_next_tick[npc_id] = tg + 1000 + (npc_id % 200)  -- DANZY EDIT: about once a second (was 150ms, ~6x/sec)

    if cfg.settler_invincible and not lookup.is_rival then
        pcall(function() npc:set_health_ex(1.0) end)
    end

    if lookup.is_rival then
        run_rival_npc_patrol(npc, npc_id, lookup.rival_camp)
        return
    end

    local my_camp      = lookup.camp
    local my_survivor  = lookup.survivor
    local my_hub_id    = lookup.hub_id

    if not my_camp then
        for hub_id, camp in pairs_(sb.active_camps) do
            if camp.survivors and camp.survivors[npc_id] then
                my_camp     = camp
                my_survivor = camp.survivors[npc_id]
                my_hub_id   = hub_id
                sb.settler_lookup[npc_id] = {
                    hub_id = hub_id, camp = camp, survivor = my_survivor,
                }
                break
            end
        end
    end

    local is_refugee = sb.refugee_ids[npc_id]
    if is_refugee and not my_camp then
        local hub_id, camp = get_active_camp_near(npc:position())
        if hub_id and camp then
            my_camp    = camp
            my_hub_id  = hub_id
        end
    end
    if not my_camp then return end

    -- DANZY EDIT: re-apply "can talk" every 10s instead of every think.
    sb.settler_talk_tg = sb.settler_talk_tg or {}
    if tg >= (sb.settler_talk_tg[npc_id] or 0) then
        sb.settler_talk_tg[npc_id] = tg + 10000
        pcall(function()
            if npc.enable_talk then npc:enable_talk() end
            local st = db.storage[npc_id]
            if st and st.meet and st.meet.meet_manager then
                st.meet.meet_manager.use = "true"
                st.meet.commander_threat = nil
            end
        end)
    end

    -- a settler following the player as a companion belongs to the companion system
    if my_survivor and (my_survivor.job == "companion" or my_survivor.is_companion) then return end
    -- one hired with the vanilla dialog under an older version still has their camp job: pause it as
    -- the add_to_actor_squad wrap (on_game_start) does
    if my_survivor and npc:has_info("npcx_is_companion") then
        if sb.mark_settler_companion then sb.mark_settler_companion(npc_id) end
        return
    end
    if my_survivor and my_survivor.job == "scavenge" and my_survivor.on_expedition then return end

    local hub_obj = alife_object(my_hub_id)
    if not hub_obj then return end
    local dist = safe_distance(npc, hub_obj)

    local max_boundary = cfg.boundary_dist or 50
    if enforce_settler_leash(npc, npc_id, my_survivor, my_hub_id,
                             hub_obj, dist, max_boundary) ~= "ok" then
        return
    end

    if npc:best_enemy() ~= nil then return end

    if not sb.camp_npc_released[npc_id] then  -- DANZY EDIT: only once per spawn
        pcall(function()
            if xr_motivator and xr_motivator.script_release then
                xr_motivator.script_release(npc)
            end
        end)
        sb.camp_npc_released[npc_id] = true
    end

    local now_tg = time_global()
    if not my_survivor then my_survivor = {} end
    refresh_settler_goodwill(npc, npc_id, my_camp, now_tg)

    if is_refugee then
        handle_refugee_ai(npc, dist, hub_obj)
        return
    end

    -- Nested helpers used by the job-dispatch block below.

    local function find_struct_lvid(struct_type_name)
        local pairs_ = pairs
        local tsort = table.sort
        if my_survivor and my_survivor.assigned_pos then
            return my_survivor.assigned_pos.lvid, nil
        end

        if my_survivor then
            my_survivor.assigned_furniture = my_survivor.assigned_furniture or {}
            local assigned_id = my_survivor.assigned_furniture[struct_type_name]
            if assigned_id then
                -- the claim holds only while the camp still lists that furniture (as in get_settler_job_target)
                local se_assigned = my_camp.structures[assigned_id] == struct_type_name and alife_object(assigned_id)
                if se_assigned then
                    return se_assigned.m_level_vertex_id, assigned_id
                else
                    my_survivor.assigned_furniture[struct_type_name] = nil
                end
            end
        end

        local found_structs = {}
        for struct_id, stype in pairs_(my_camp.structures) do
            if stype == struct_type_name then
                found_structs[#found_structs + 1] = struct_id
            end
        end

        if #found_structs > 0 then
            local assigned_to_others = {}
            for other_id, other_survivor in pairs_(my_camp.survivors or {}) do
                if other_id ~= npc_id and other_survivor.assigned_furniture then
                    local oa = other_survivor.assigned_furniture[struct_type_name]
                    if oa then assigned_to_others[oa] = true end
                end
            end

            tsort(found_structs)

            local npc_pos = npc:position()
            local best_lvid, best_dist, best_id = nil, math.huge, nil
            for _, struct_id in ipairs(found_structs) do
                if not assigned_to_others[struct_id] then
                    local se_struct = alife_object(struct_id)
                    if se_struct then
                        local d = se_struct.position:distance_to(npc_pos)
                        if d < best_dist then
                            best_dist = d
                            best_lvid = se_struct.m_level_vertex_id
                            best_id   = struct_id
                        end
                    end
                end
            end

            if not best_lvid then
                local index = (npc_id % #found_structs) + 1
                best_id = found_structs[index]
                local se_struct = alife_object(best_id)
                if se_struct then best_lvid = se_struct.m_level_vertex_id end
            end

            if best_id and my_survivor then
                my_survivor.assigned_furniture = my_survivor.assigned_furniture or {}
                my_survivor.assigned_furniture[struct_type_name] = best_id
            end

            return best_lvid, best_id
        end

        local cache_key = npc_id .. "_" .. struct_type_name
        local cached = camp_npc_furniture_cache[cache_key]
        local now_tg = time_global()
        if cached and now_tg < cached.expires_tg then
            return cached.lvid, cached.id
        end

        for struct_id, stype in pairs_(my_camp.structures or {}) do
            if stype == struct_type_name then
                found_structs[#found_structs + 1] = struct_id
            end
        end

        local found_lvid, assigned_id = nil, nil
        if #found_structs > 0 then
            tsort(found_structs)
            local index = (npc_id % #found_structs) + 1
            assigned_id = found_structs[index]
            local se_struct = alife_object(assigned_id)
            if se_struct then
                found_lvid = se_struct.m_level_vertex_id
                if my_survivor then
                    my_survivor.assigned_furniture = my_survivor.assigned_furniture or {}
                    my_survivor.assigned_furniture[struct_type_name] = assigned_id
                end
            end
        end

        camp_npc_furniture_cache[cache_key] = {
            lvid = found_lvid, id = assigned_id, expires_tg = now_tg + 10000,
        }
        return found_lvid, assigned_id
    end

    local function get_job_target_lvid(job_name, struct_type_name)
        local struct_lvid, struct_id = find_struct_lvid(struct_type_name)
        if struct_lvid then return struct_lvid, false, struct_id end

        local hub_pos = hub_obj.position
        local dist_fb = 2.0
        local angle_deg = 0

        if job_name == "guard" then
            dist_fb = 8.0
            local slot = npc_id % 4
            angle_deg = slot * 90 + 45
        elseif job_name == "cook" then
            dist_fb = 5.0
            angle_deg = 0
        elseif job_name == "craft" then
            dist_fb = 4.0
            angle_deg = 90
        elseif job_name == "repair" then
            dist_fb = 5.0
            angle_deg = 180
        elseif job_name == "medic" then
            dist_fb = 5.0
            angle_deg = 270
        elseif job_name == "scavenge" or job_name == "scavenger" then
            dist_fb = 2.5
            angle_deg = 315
        end

        local angle_rad = math.rad(angle_deg)
        local dx = math.cos(angle_rad) * dist_fb
        local dz = math.sin(angle_rad) * dist_fb
        local offset_pos = vector():set(hub_pos.x + dx, hub_pos.y, hub_pos.z + dz)
        local fallback_lvid = level.vertex_id(offset_pos)

        if fallback_lvid and fallback_lvid < 4294967295 then
            return fallback_lvid, true, nil
        end
        return hub_obj.m_level_vertex_id, true, nil
    end

    local function move_to_job_furniture(target_lvid, arrive_dist, idle_states, is_fallback, struct_id)
        local ipairs_ = ipairs
        if not target_lvid then return end

        local look_pos = nil
        local acc_lvid = target_lvid

        if struct_id and not is_fallback then
            local cache_k = npc_id .. "_stand_" .. struct_id
            local cached = camp_npc_furniture_cache[cache_k]
            if cached and cached.expires_tg and now_tg < cached.expires_tg then
                acc_lvid = cached.acc_lvid
                look_pos = cached.look_pos
            else
                local se_struct = alife_object(struct_id)
                if se_struct and se_struct.position then
                    look_pos = vector():set(se_struct.position.x,
                                            se_struct.position.y,
                                            se_struct.position.z)
                    local furn_pos = se_struct.position
                    local best_stand_lvid = nil
                    local best_stand_dist = math.huge
                    local hub_p = hub_obj and hub_obj.position or npc:position()
                    local v_test_p = vector()
                    for _, dir in ipairs_(STATIC_WORKSTATION_STAND_OFFSETS) do
                        v_test_p:set(furn_pos.x + dir[1], furn_pos.y, furn_pos.z + dir[2])
                        local test_lvid = level.vertex_id(v_test_p)
                        if test_lvid and test_lvid < 4294967295 and test_lvid ~= -1
                            and npc:accessible(test_lvid) then
                            local d = v_test_p:distance_to(hub_p)
                            if d < best_stand_dist then
                                best_stand_dist = d
                                best_stand_lvid = test_lvid
                            end
                        end
                    end
                    if best_stand_lvid then
                        acc_lvid = best_stand_lvid
                    end
                    if utils_obj and utils_obj.send_to_nearest_accessible_vertex then
                        acc_lvid = utils_obj.send_to_nearest_accessible_vertex(npc, acc_lvid) or acc_lvid
                    end
                    camp_npc_furniture_cache[cache_k] = {
                        acc_lvid = acc_lvid, look_pos = look_pos,
                        expires_tg = now_tg + 60000,
                    }
                end
            end
        end
        if not acc_lvid then acc_lvid = target_lvid end

        local target_pos = level.vertex_position(acc_lvid)
        if not look_pos then look_pos = target_pos end

        local st = db.storage[npc_id]
        if st then
            if st.corpse_detection then st.corpse_detection.enabled = false end
            if st.gather_items then st.gather_items.gather_items_enabled = false end
            if st.help_wounded then st.help_wounded.help_wounded_enabled = false end
        end

        local npc_p = npc:position()
        local npc_dist = npc_p:distance_to(target_pos)

        local cur_state = state_mgr and state_mgr.get_state(npc)
        local is_already_idling = false
        for _, s in ipairs_(idle_states) do
            if cur_state == s then is_already_idling = true; break end
        end

        local in_station_range = (is_already_idling and npc_dist <= 3.2)
            or (npc_dist <= (arrive_dist or 2.0))

        if in_station_range then
            local chosen_anim = is_already_idling and cur_state
                or idle_states[math.random(#idle_states)]
            if sb.setup_settler_beh_logic then
                sb.setup_settler_beh_logic(npc, acc_lvid, look_pos, chosen_anim)
            else
                npc:set_dest_level_vertex_id(acc_lvid)
                npc:set_movement_type(move.stand)
                npc:set_body_state(move.standing)
                npc:set_mental_state(anim.free)
                if not is_already_idling then
                    camp_npc_arrive(npc)
                    state_mgr.set_state(npc, chosen_anim, nil, nil,
                        { look_position = look_pos }, { fast_set = true })
                end
            end
        else
            pcall(function() npc:disable_info_portion("npcx_beh_wait") end)
            if npc_dist > 6.0 then
                pcall(function()
                    if IsStalker(npc) and (not IsMonster(npc)) and npc.set_npc_position then
                        npc:set_npc_position(target_pos)
                    end
                    local se_obj = alife_object(npc_id)
                    if se_obj then
                        se_obj.position = target_pos
                        se_obj.m_level_vertex_id = acc_lvid
                    end
                    npc:set_dest_level_vertex_id(acc_lvid)
                    npc:set_movement_type(move.stand)
                    npc:set_body_state(move.standing)
                    if state_mgr then
                        local chosen_anim = idle_states[math.random(#idle_states)]
                        state_mgr.set_state(npc, chosen_anim, nil, nil,
                            { look_position = look_pos }, { fast_set = true })
                    end
                end)
            else
                camp_npc_move_to(npc, acc_lvid)
            end
        end
    end

    -- JOB DISPATCH

    if my_survivor.temp_target_lvid and time_global() < my_survivor.temp_target_time then
        move_to_job_furniture(my_survivor.temp_target_lvid, 2, {"sit_knee", "wait_na"}, true, nil)
        return
    end

    local job_cfg = JOB_DISPATCH[my_survivor.job]
    if job_cfg then
        local target_lvid, is_fb, sid = get_job_target_lvid(my_survivor.job, job_cfg.try[1])
        if is_fb then
            for i = 2, #job_cfg.try do
                local alt, alt_sid = find_struct_lvid(job_cfg.try[i])
                if alt then
                    target_lvid, is_fb, sid = alt, false, alt_sid
                    break
                end
            end
        end
        move_to_job_furniture(target_lvid, 1.3, job_cfg.anims, is_fb, sid)
        return
    end

    if my_survivor.job == "scavenge" or my_survivor.job == "scavenger" then
        if my_survivor.on_expedition then
            utils_obj.switch_offline(npc_id)
            return
        end
        if my_survivor.assigned_pos then
            move_to_job_furniture(my_survivor.assigned_pos.lvid, 1.3,
                {"sit_knee", "wait_na", "guard"}, true, nil)
            return
        end
        local target_lvid, is_fb, sid = get_job_target_lvid("scavenge", "stash")
        if is_fb then
            local alt, alt_sid = find_struct_lvid("workbench")
            if alt then target_lvid, is_fb, sid = alt, false, alt_sid end
        end
        move_to_job_furniture(target_lvid, 1.3,
            {"sit_knee", "ward", "wait_na", "guard"}, is_fb, sid)
        return
    end

    if my_survivor.job == "hunter" then
        if my_survivor.assigned_pos then
            move_to_job_furniture(my_survivor.assigned_pos.lvid, 1.3,
                {"sit_knee", "wait_na", "guard"}, true, nil)
            return
        end
        local target_lvid, is_fb, sid = get_job_target_lvid("hunter", "fridge")
        if is_fb then
            local alt, alt_sid = find_struct_lvid("box")
            if alt then
                target_lvid, is_fb, sid = alt, false, alt_sid
            else
                alt, alt_sid = find_struct_lvid("stash")
                if alt then
                    target_lvid, is_fb, sid = alt, false, alt_sid
                else
                    alt, alt_sid = find_struct_lvid("workbench")
                    if alt then target_lvid, is_fb, sid = alt, false, alt_sid end
                end
            end
        end
        move_to_job_furniture(target_lvid, 1.3,
            {"sit_knee", "ward", "wait_na", "guard"}, is_fb, sid)
        return
    end

    if my_survivor.assigned_pos then
        move_to_job_furniture(my_survivor.assigned_pos.lvid, 1.3,
            {"guard", "wait_na", "threat_na"}, true, nil)
        return
    end

    -- IDLE WANDER: unstructured settlers scatter around the hub and pick an
    local target_lvid

    local wander_target_lvid = nil
    -- the radio or piano corner is chosen for a whole idle period, not re-rolled every update
    local wander = camp_npc_furniture_cache[npc_id] or {}
    camp_npc_furniture_cache[npc_id] = wander
    if now_tg > (wander.wander_pick_tg or 0) then
        wander.wander_pick_tg = now_tg + math.random(20000, 35000)
        wander.wander_music = math.random(100) <= 30
    end
    if wander.wander_music then
        for struct_id, struct_type in pairs_(my_camp.structures) do
            if struct_type == "piano" or struct_type == "radio" then
                local se_struct = alife_object(struct_id)
                if se_struct then
                    local struct_dist = se_struct.position:distance_to(hub_obj.position)
                    if struct_dist <= (cfg.npc_leash_radius or 10) then
                        wander_target_lvid = se_struct.m_level_vertex_id
                    end
                    break
                end
            end
        end
    end

    local campfire_lvid = wander_target_lvid
    if not campfire_lvid then
        for struct_id, struct_type in pairs_(my_camp.structures) do
            if struct_type == "stove" then
                local se_struct = alife_object(struct_id)
                if se_struct then
                    local struct_dist = se_struct.position:distance_to(hub_obj.position)
                    if struct_dist <= (cfg.npc_leash_radius or 10) then
                        campfire_lvid = se_struct.m_level_vertex_id
                    end
                    break
                end
            end
        end
    end

    if not campfire_lvid then
        local slot = npc_id % 6
        local angle_rad = math.rad(slot * 60)
        local wander_dist = 3.0 + (npc_id % 3)
        local scatter_pos = vector():set(
            hub_obj.position.x + math.cos(angle_rad) * wander_dist,
            hub_obj.position.y,
            hub_obj.position.z + math.sin(angle_rad) * wander_dist)
        local scatter_lvid = level.vertex_id(scatter_pos)
        if scatter_lvid and scatter_lvid < 4294967295 then
            campfire_lvid = scatter_lvid
        end
    end
    target_lvid = campfire_lvid or hub_obj.m_level_vertex_id

    local target_pos = level.vertex_position(target_lvid)
    local npc_dist = npc:position():distance_to(target_pos)

    if npc_dist < 4 then
        camp_npc_arrive(npc)
        local cur_state = state_mgr and state_mgr.get_state(npc)
        local cache = camp_npc_furniture_cache[npc_id]
        if not cache then
            camp_npc_furniture_cache[npc_id] = {}
            cache = camp_npc_furniture_cache[npc_id]
        end
        local safe_idle_states = {
            ["wait_na"] = true,
            ["guard"] = true,
            ["caution"] = true,
            ["smoking_stand"] = true,
            ["sit_knee"] = true,
            ["threat_na"] = true,
            ["ward"] = true,
        }
        local need_new_anim = (not safe_idle_states[cur_state]) or (now_tg > (cache.idle_anim_tg or 0))
        if need_new_anim then
            cache.idle_anim_tg = now_tg + math.random(20000, 35000)
            local idle_choices = { "wait_na", "guard", "caution", "smoking_stand", "sit_knee", "threat_na", "ward" }
            local chosen_idle = idle_choices[math.random(#idle_choices)]
            local look_pos = vector():set(
                target_pos.x + (target_pos.x - hub_obj.position.x) * 2.0,
                target_pos.y,
                target_pos.z + (target_pos.z - hub_obj.position.z) * 2.0
            )
            if sb.setup_settler_beh_logic then
                sb.setup_settler_beh_logic(npc, target_lvid, look_pos, chosen_idle)
            else
                npc:set_dest_level_vertex_id(target_lvid)
                npc:set_movement_type(move.stand)
                npc:set_body_state(move.standing)
                npc:set_mental_state(anim.free)
                if state_mgr then
                    state_mgr.set_state(npc, chosen_idle, nil, nil, { look_position = look_pos }, { fast_set = true })
                end
            end
        end
    else
        pcall(function() npc:disable_info_portion("npcx_beh_wait") end)
        camp_npc_move_to(npc, target_lvid)
    end
end

function hf_on_furniture_place(obj_id)
  local level_name = level.name()
    local se_obj = alife_object(obj_id)
    if not se_obj then return end

    local cur_lvl = level_name

    for hub_id, camp in pairs(stalker_camp_builder.active_camps) do
        if not camp.level or camp.level == cur_lvl then
            local hub_se = alife_object(hub_id)
            if hub_se and hub_se.position and se_obj.position and hub_se.position:distance_to(se_obj.position) <= cfg.boundary_dist then
                invalidate_scan_camp_structures_cache(hub_id)
            end
        end
    end

    local sec = se_obj:section_name()
    if sec == "placeable_workshop" then
        local inside_camp_id = nil
        local too_close_hub_id = nil

        for other_id, camp in pairs(stalker_camp_builder.active_camps) do
            if other_id ~= obj_id and (not camp.level or camp.level == cur_lvl) then
                local other_se = alife_object(other_id)
                if other_se and other_se.position and se_obj.position then
                    local dist = other_se.position:distance_to(se_obj.position)
                    if dist <= cfg.boundary_dist then
                        inside_camp_id = other_id
                        break
                    elseif dist < cfg.hub_min_dist then
                        too_close_hub_id = other_id
                        break
                    end
                end
            end
        end

        if inside_camp_id then
            local camp = stalker_camp_builder.active_camps[inside_camp_id]
            if camp then
                camp.structures = camp.structures or {}
                camp.structures[obj_id] = "workbench"
                invalidate_scan_camp_structures_cache(inside_camp_id)
            end
            actor_menu.set_msg(1, game.translate_string("st_hub_workbench_added"), 3)
            return
        end

        if too_close_hub_id then
            actor_menu.set_msg(1, game.translate_string("st_hub_too_close"), 3)
            alife_release(se_obj)
            local inv_sec = ini_sys:r_string_ex(sec, "item_section") or "itm_workshop"
            if db.actor then
                alife():create(inv_sec, db.actor:position(), db.actor:level_vertex_id(), db.actor:game_vertex_id(), db.actor:id())
            else
                alife():create(inv_sec, se_obj.position, se_obj.m_level_vertex_id, se_obj.m_game_vertex_id)
            end
            return
        end

        if not stalker_camp_builder.active_camps[obj_id] then
            local cur_sec = game_sec()
            stalker_camp_builder.active_camps[obj_id] = {
                hub_id = obj_id,
                pos = {x = se_obj.position.x, y = se_obj.position.y, z = se_obj.position.z},
                lvid = se_obj.m_level_vertex_id,
                gvi = se_obj.m_game_vertex_id,
                level = level_name,
                structures = {},
                survivors = {},
                created_time = cur_sec,
                last_raid_check_time = cur_sec
            }
            refresh_settlement_map_spot(obj_id, stalker_camp_builder.active_camps[obj_id])  -- runtime camp marker, not serialized

            local ok_zone, se_zone = pcall(function()
                return alife():create("script_zone", se_obj.position, se_obj.m_level_vertex_id, se_obj.m_game_vertex_id)
            end)
            if ok_zone and se_zone then
                local boundary = cfg.boundary_dist or 50
                if se_zone.set_enter_radius then
                    se_zone:set_enter_radius(boundary)
                end
                stalker_camp_builder.active_camps[obj_id].zone_id = se_zone.id
                -- DANZY EDIT: omit sleep location boundary marker clutter
            else
            end

            actor_menu.set_msg(1, game.translate_string("st_hub_established"), 3)

            -- Proactive sweep for natural Zone smart terrain spawn points within camp boundary
            if stalker_camp_builder.get_nearby_smart_terrain_hazard then
                local s_name, s_dist = stalker_camp_builder.get_nearby_smart_terrain_hazard(se_obj.position)
                if s_name and s_dist then
                    local new_camp = stalker_camp_builder.active_camps[obj_id]
                    if new_camp then
                        new_camp.near_smart = s_name
                        new_camp.near_smart_dist = math.floor(s_dist)
                    end
                    local s_disp = game.translate_string(s_name)
                    if not s_disp or s_disp == "" or s_disp == s_name then s_disp = s_name end
                    local warn_txt = string.format(game.translate_string("st_hub_spawn_hazard_warn"), s_disp, math.floor(s_dist))
                    CreateTimeEvent("homestead_smart_warn_" .. tostring(obj_id), "warn", 1.5, function()
                        if db.actor then
                            camp_send_tip(db.actor, warn_txt, nil, "red_danger", 14000, obj_id, "combat", true)
                        end
                        return true
                    end)
                end
            end

            scan_camp_structures(obj_id)
        end
        return
    end

    local hub_id, camp = get_active_camp_near(se_obj.position)
    if camp then
        local struct_type = resolve_structure_type(se_obj)
        camp.structures[obj_id] = struct_type

        local display_name = ui_item.get_sec_name(sec)
        local camp_name = "Camp"
        local hub_obj = alife_object(hub_id)
        if hub_obj then
            camp_name = "Camp in " .. level_name
        end

        local dist = nil
        if hub_obj and hub_obj.position then
            dist = se_obj.position:distance_to(hub_obj.position)
        end
        if dist and dist > cfg.boundary_warn then
            actor_menu.set_msg(1, string.format(game.translate_string("st_hub_furniture_joined_warn"), display_name, camp_name, cfg.boundary_dist), 4)
        else
            actor_menu.set_msg(1, string.format(game.translate_string("st_hub_furniture_joined"), display_name, camp_name), 3)
        end
    else
        local display_name = ui_item.get_sec_name(sec)
        actor_menu.set_msg(1, string.format(game.translate_string("st_hub_furniture_outside"), display_name), 3)
    end
end

-- a camp's caravan trader leaves with the camp: update_camp_jobs only sends away traders of camps
-- that still exist
function stalker_camp_builder.release_camp_trader(camp)
    local trader = camp.active_trader_id and alife_object(camp.active_trader_id)
    -- only while it is the live stalker that came as the caravan (is_camp_trader's test)
    if trader and IsStalker(trader) and trader:alive()
        and (camp.trader_section_of ~= camp.active_trader_id or trader:section_name() == camp.trader_section) then
        -- the trader is in no squad, and alife_release removes stalkers only through their squad
        safe_release_manager.release(trader)
    end
end

function hf_on_before_furniture_release(obj_id)
    local pairs_ = pairs
    if stalker_camp_builder.active_camps[obj_id] then
        stalker_camp_builder.release_camp_trader(stalker_camp_builder.active_camps[obj_id])
        stalker_camp_builder.end_camp_raid(stalker_camp_builder.active_camps[obj_id])
        level.map_remove_object_spot(obj_id, "ui_pda2_actor_sleep_location")
        invalidate_scan_camp_structures_cache(obj_id)
        stalker_camp_builder.active_camps[obj_id] = nil
        actor_menu.set_msg(1, game.translate_string("st_hub_removed"), 3)
        return
    end

    for hub_id, camp in pairs_(stalker_camp_builder.active_camps) do
        if camp.structures and camp.structures[obj_id] then
            camp.structures[obj_id] = nil
            invalidate_scan_camp_structures_cache(hub_id)
            if camp.survivors then
                for _, survivor in pairs_(camp.survivors) do
                    if survivor.assigned_furniture then
                        for job_key, aid in pairs_(survivor.assigned_furniture) do
                            if aid == obj_id then
                                survivor.assigned_furniture[job_key] = nil
                            end
                        end
                    end
                end
            end
        end
    end
end

function init_hf_pickup_hook()
    if bind_hf_base and bind_hf_base.hf_binder_wrapper and not bind_hf_base._homestead_pickup_wrapped then
        bind_hf_base._homestead_pickup_wrapped = true
        local orig_pickup = bind_hf_base.hf_binder_wrapper.pickup
        bind_hf_base.hf_binder_wrapper.pickup = function(self)
            if self and self.object then
                local obj_id = self.object:id()
                if hf_obj_manager and hf_obj_manager.cleanup_data then
                    pcall(hf_obj_manager.cleanup_data, obj_id)
                else
                    SendScriptCallback("hf_on_before_furniture_release", obj_id)
                end
            end
            if orig_pickup then
                return orig_pickup(self)
            end
            return true
        end
    end
end
init_hf_pickup_hook()

-- server_object_on_unregister -- sent by the modded exes for every server object they release.
-- Physic objects (most furniture) have no Lua server class and never send
-- server_entity_on_unregister, and pickups through binder classes declared before
-- init_hf_pickup_hook skip hf_on_before_furniture_release: drop such a piece here.
function server_object_on_unregister(se_obj)
    local obj_id = se_obj and se_obj.id
    if not obj_id then return end
    local in_teardown_grace = homestead_is_disconnecting
        or (stalker_camp_builder.homestead_is_disconnecting)
        or (time_global and homestead_teardown_grace_until and time_global() < homestead_teardown_grace_until)
        or (time_global and stalker_camp_builder.homestead_teardown_grace_until and time_global() < stalker_camp_builder.homestead_teardown_grace_until)
    if in_teardown_grace then return end

    for hub_id, camp in pairs(stalker_camp_builder.active_camps) do
        if camp.structures and camp.structures[obj_id] then
            camp.structures[obj_id] = nil
            invalidate_scan_camp_structures_cache(hub_id)
            for _, survivor in pairs(camp.survivors or {}) do
                for stype, aid in pairs(survivor.assigned_furniture or {}) do
                    if aid == obj_id then
                        survivor.assigned_furniture[stype] = nil
                    end
                end
            end
        end
    end
    for _, rcamp in pairs(stalker_camp_builder.rival_camps or {}) do
        if type(rcamp) == "table" and rcamp.decorations then
            for i = #rcamp.decorations, 1, -1 do
                if rcamp.decorations[i] == obj_id then
                    table.remove(rcamp.decorations, i)
                    if rcamp.decor_sections then rcamp.decor_sections[obj_id] = nil end
                    break
                end
            end
        end
    end
end

local function get_time_sec(time_val)
    local type_ = type
    if not time_val then return nil end
    if type_(time_val) == "number" then
        return time_val
    end
    if type_(time_val) == "userdata" or (type_(time_val) == "table" and time_val.diffSec) then
        return time_val:diffSec(game.CTime())
    end
    return nil
end

function can_banish(actor, npc)
    if not npc then return false end
    return stalker_camp_builder.can_banish and stalker_camp_builder.can_banish(actor, npc)
end

function banish_npc(actor, npc)
    if stalker_camp_builder.banish_npc then
        return stalker_camp_builder.banish_npc(actor, npc)
    end
end

function get_job_progress(survivor)
    return stalker_camp_builder.get_job_progress(survivor)
end

function get_job_time_remaining(survivor)
    return stalker_camp_builder.get_job_time_remaining(survivor)
end

function get_job_paused_status(survivor, camp, hub_id)
    return stalker_camp_builder.get_job_paused_status and stalker_camp_builder.get_job_paused_status(survivor, camp, hub_id)
end

function camp_has_item(hub_id, camp, section_check_func, priority_box_id)
    return stalker_camp_builder.camp_has_item and stalker_camp_builder.camp_has_item(hub_id, camp, section_check_func, priority_box_id)
end

function camp_has_repairable_gear(hub_id, camp)
    return stalker_camp_builder.camp_has_repairable_gear and stalker_camp_builder.camp_has_repairable_gear(hub_id, camp)
end

function save_state(m_data)
    pcall(function()
        m_data.stalker_camp_builder_version = SAVE_STATE_VERSION
        m_data.stalker_camp_builder_active_camps = pack_table_vectors(stalker_camp_builder.active_camps)
        m_data.stalker_camp_builder_rival_camps = pack_table_vectors(stalker_camp_builder.rival_camps)
        m_data.stalker_camp_builder_last_raid_time = last_raid_game_sec
        m_data.stalker_camp_builder_last_event_time = last_random_event_sec
        m_data.stalker_camp_builder_refugee_ids = pack_table_vectors(stalker_camp_builder.refugee_ids)
        m_data.stalker_camp_builder_dismantled_levels = stalker_camp_builder.dismantled_levels
        m_data.stalker_camp_builder_last_rival_spawn_sec = stalker_camp_builder.last_rival_spawn_attempt_sec
        m_data.stalker_camp_builder_radio_logs = stalker_camp_builder.radio_logs or {}
        m_data.stalker_camp_builder_active_stash_expeditions = pack_table_vectors(stalker_camp_builder.active_stash_expeditions or {})
        m_data.stalker_camp_builder_active_convoys = pack_table_vectors(stalker_camp_builder.active_convoys or {})
        m_data.stalker_camp_builder_hospitality_end_sec = stalker_camp_builder.hospitality_buff_end_sec
    end)
end

local function keys_to_numbers(tbl)
    if type(tbl) ~= "table" then return tbl end
    local new_tbl = {}
    for k, v in pairs(tbl) do
        local num_k = tonumber(k)
        local key = num_k or k
        if type(v) == "table" then
            new_tbl[key] = keys_to_numbers(v)
        else
            new_tbl[key] = v
        end
    end
    return new_tbl
end

function load_state(m_data)
    local pairs_ = pairs
    local type_ = type
    local sformat = string.format
    local save_version = m_data.stalker_camp_builder_version or 0

    stalker_camp_builder.active_camps = keys_to_numbers(unpack_table_vectors(m_data.stalker_camp_builder_active_camps or {}))
    -- time_global() stamps count from game launch: after a restart they lie in the future
    for hub_id, camp in pairs_(stalker_camp_builder.active_camps) do
        camp._cached_storage_metrics_tg = nil
        camp._last_periodic_scan = nil
        camp._inv_snapshot = nil
        camp._inv_snapshot_tg = nil
        camp._cached_box_weights = nil
        if camp.survivors then
            for nid, surv in pairs_(camp.survivors) do
                surv.job_start_realtime = nil
                surv.temp_target_lvid = nil
                surv.temp_target_time = nil
            end
        end
    end
    stalker_camp_builder.rival_camps = keys_to_numbers(unpack_table_vectors(m_data.stalker_camp_builder_rival_camps or {}))
    local raw_raid = m_data.stalker_camp_builder_last_raid_time
    last_raid_game_sec = (type_(raw_raid) == "number") and raw_raid or nil
    local raw_event = m_data.stalker_camp_builder_last_event_time
    last_random_event_sec = (type_(raw_event) == "number") and raw_event or nil
    stalker_camp_builder.refugee_ids = keys_to_numbers(unpack_table_vectors(m_data.stalker_camp_builder_refugee_ids or {}))
        local raw_radio = m_data.stalker_camp_builder_radio_logs or {}
    stalker_camp_builder.radio_logs = {}
    for k, v in pairs(raw_radio) do
        local num_k = tonumber(k)
        if num_k then
            stalker_camp_builder.radio_logs[num_k] = v
        else
            stalker_camp_builder.radio_logs[k] = v
        end
    end
    stalker_camp_builder.radio_logs["all"] = stalker_camp_builder.radio_logs["all"] or {}
    if #stalker_camp_builder.radio_logs["all"] > 0 then
        local cleaned = {}
        for _, entry in ipairs(stalker_camp_builder.radio_logs["all"]) do
            if type(entry) == "table" and entry.text then
                local dup_idx = nil
                for i = 1, math.min(5, #cleaned) do
                    if cleaned[i].text == entry.text then
                        dup_idx = i
                        break
                    end
                end
                if dup_idx then
                    if cleaned[dup_idx].category == "general" and entry.category and entry.category ~= "general" then
                        cleaned[dup_idx].category = entry.category
                    end
                else
                    cleaned[#cleaned + 1] = entry
                end
            end
        end
        stalker_camp_builder.radio_logs["all"] = cleaned
    end
    if #stalker_camp_builder.radio_logs["all"] == 0 then
        stalker_camp_builder.radio_logs["all"][#stalker_camp_builder.radio_logs["all"]+1] = {
            time_str = string.format("%02d:%02d", level and level.get_time_hours and level.get_time_hours() or 12, level and level.get_time_minutes and level.get_time_minutes() or 0),
            category = "general",
            text = game.translate_string("st_pda_radio_init_msg")
        }
    end
    stalker_camp_builder.dismantled_levels = keys_to_numbers(m_data.stalker_camp_builder_dismantled_levels or {})
    stalker_camp_builder.last_rival_spawn_attempt_sec = m_data.stalker_camp_builder_last_rival_spawn_sec or 0
    stalker_camp_builder.active_stash_expeditions = keys_to_numbers(unpack_table_vectors(m_data.stalker_camp_builder_active_stash_expeditions or {}))
    stalker_camp_builder.active_convoys = keys_to_numbers(unpack_table_vectors(m_data.stalker_camp_builder_active_convoys or {}))
    local raw_hosp = m_data.stalker_camp_builder_hospitality_end_sec
    stalker_camp_builder.hospitality_buff_end_sec = (type_(raw_hosp) == "number") and raw_hosp or nil

    if save_version < 2 then
        for hub_id, camp in pairs_(stalker_camp_builder.active_camps) do
            invalidate_scan_camp_structures_cache(hub_id)
        end
    end

    -- versions before 1.1.7 also saved a copy of the camps here; nothing has written it since, so
    -- it holds camps and outposts from that time. Dropped, so the next save leaves it out.
    m_data.homestead_backup = nil

    normalize_camps()

    local camp_count = 0
    for hub_id, camp in pairs_(stalker_camp_builder.active_camps) do
        camp_count = camp_count + 1
        local survivor_count = 0
        for npc_id, survivor in pairs_(camp.survivors or {}) do
            survivor_count = survivor_count + 1

            if type_(survivor) == "table" and survivor.job and survivor.job ~= "idle" and survivor.job ~= "companion" then
                local job = survivor.job
                local rt_interval
                if     job == "cook"     then rt_interval = cfg.realtime_job_cook_interval
                elseif job == "craft"    then rt_interval = cfg.realtime_job_craft_interval
                elseif job == "repair"   then rt_interval = cfg.realtime_job_repair_interval
                elseif job == "scavenge" then rt_interval = cfg.realtime_job_scavenge_interval
                elseif job == "hunter"   then rt_interval = cfg.realtime_job_hunter_interval
                elseif job == "medic"    then rt_interval = cfg.medic_job_interval or defaults.medic_job_interval
                elseif job == "electrician" then rt_interval = cfg.electrician_job_interval or defaults.electrician_job_interval
                elseif job == "woodcutter" then rt_interval = cfg.realtime_job_woodcutter_interval or defaults.realtime_job_woodcutter_interval
                elseif job == "brewer"   then rt_interval = cfg.realtime_job_brewer_interval or defaults.realtime_job_brewer_interval
                elseif job == "scrapper" then rt_interval = cfg.realtime_job_scrapper_interval or defaults.realtime_job_scrapper_interval
                end
                if rt_interval and rt_interval > 0 then
                    local current_sec = game_sec()
                    local tf = (level and level.get_time_factor and level.get_time_factor()) or 10
                    if tf <= 0 then tf = 10 end
                    local tod_mult = stalker_camp_builder.get_time_of_day_mult and stalker_camp_builder.get_time_of_day_mult(job) or 1.0
                    local effective_interval = rt_interval / (tod_mult > 0 and tod_mult or 1.0)
                    local game_elapsed = current_sec - (survivor.job_start_time or current_sec)
                    local effective_sec = math.max(0, game_elapsed / tf)
                    survivor.job_start_realtime = time_global() - (math.min(effective_sec, effective_interval) * 1000)
                    -- a missing job_start_time waits for the first update's rebase: the engine loads the
                    -- save's game time after load_state, so game_sec() still reads the start date here
                else
                    survivor.job_start_realtime = time_global()
                end
            else
                if type_(survivor) == "table" then
                    -- idle, or away as a companion: a job taken up later starts its own cycle
                    survivor.job_start_time = nil
                    survivor.job_start_realtime = nil
                end
            end
        end
    end
end

-- State Normalization / Migration
function normalize_camps()
    local mabs = math.abs
    local pairs_ = pairs
    local type_ = type
    for hub_id, camp in pairs_(stalker_camp_builder.active_camps) do
        if type_(camp) ~= "table" then
            stalker_camp_builder.active_camps[hub_id] = nil
        else
            -- an unnamed camp keeps no name, as when it was placed: "" would defeat the
            -- camp.name or "Camp" fallbacks in the messages
            if camp.name == "" then camp.name = nil end
            camp.level = camp.level or "unknown"
            camp.survivors = camp.survivors or {}
            camp.structures = camp.structures or {}
            camp.specialization = camp.specialization or "none"
            camp.happiness = camp.happiness or 50
            camp.trade_routes = camp.trade_routes or {}
            camp.active_trader_id = camp.active_trader_id or nil
            camp.active_raid = camp.active_raid or nil

            if camp.position and type_(camp.position) == "table" then
                if camp.position.__packed_vector then
                    camp.position = unpack_vector(camp.position)
                elseif camp.position.x and camp.position.y and camp.position.z then
                    camp.position = vector():set(camp.position.x, camp.position.y, camp.position.z)
                end
            end

            for npc_id, survivor in pairs_(camp.survivors) do
                if type_(survivor) ~= "table" then
                    camp.survivors[npc_id] = nil
                else
                    survivor.name = survivor.name or "Survivor"
                    survivor.job = survivor.job or "idle"
                    survivor.job_start_time = survivor.job_start_time or nil
                    survivor.job_start_realtime = survivor.job_start_realtime or nil
                    survivor.xp = survivor.xp or 0
                    survivor.tier = survivor.tier or 0
                    survivor.assigned_pos = survivor.assigned_pos or nil
                    survivor.was_companion = survivor.was_companion or false
                end
            end
        end
    end

    for hub_id, camp in pairs_(stalker_camp_builder.active_camps) do
        camp.hub_id = hub_id
        local hub_obj = safe_alife_object(hub_id)
        local hub_pos = hub_obj and hub_obj.position

        -- the box itself is checked where the chest is used: this runs from load_state, before the
        -- save's objects are loaded, when every box looks missing
        stalker_camp_builder.sanitize_primary_chest(camp)

    end

    for key, camp in pairs_(stalker_camp_builder.rival_camps) do
        if type_(camp) == "table" then
            camp.name = camp.name or "Unknown Camp"
            camp.cleared = camp.cleared or false
            camp.structures = camp.structures or {}
            camp.position = camp.position or {x=0, y=0, z=0}
        end
    end
end

local _ground_probe_ray = nil
function stalker_camp_builder.get_surface_y(x, z, ref_y, probe_up, probe_down)
    if not x or not z then return nil end
    local base_y = ref_y or 0
    local up = probe_up or 2.5
    local down = probe_down or 6.0

    if ray_pick then
        _ground_probe_ray = _ground_probe_ray or ray_pick()
        if _ground_probe_ray then
            _ground_probe_ray:set_flags(2) -- Statics: visual level geometry, terrain, and floor meshes
            local origin = vector():set(x, base_y + up, z)
            _ground_probe_ray:set_position(origin)
            _ground_probe_ray:set_direction(vector():set(0, -1, 0))
            local range1 = up + down
            _ground_probe_ray:set_range(range1)

            local hit1 = false
            local ok1 = pcall(function() hit1 = _ground_probe_ray:query() end)
            if ok1 and (hit1 or (_ground_probe_ray.get_result and _ground_probe_ray:get_result() ~= nil)) then
                local dist = _ground_probe_ray:get_distance()
                if dist and dist > 0.05 and dist < (range1 - 0.05) then
                    local ground_y = origin.y - dist
                    if math.abs(ground_y - base_y) <= (down + 1.5) then
                        return ground_y
                    end
                end
            end

            local up2 = up + 3.0
            local down2 = down + 6.0
            local origin2 = vector():set(x, base_y + up2, z)
            _ground_probe_ray:set_position(origin2)
            local range2 = up2 + down2
            _ground_probe_ray:set_range(range2)
            local hit2 = false
            local ok2 = pcall(function() hit2 = _ground_probe_ray:query() end)
            if ok2 and (hit2 or (_ground_probe_ray.get_result and _ground_probe_ray:get_result() ~= nil)) then
                local dist2 = _ground_probe_ray:get_distance()
                if dist2 and dist2 > 0.05 and dist2 < (range2 - 0.05) then
                    local ground_y2 = origin2.y - dist2
                    if math.abs(ground_y2 - base_y) <= (down2 + 2.0) then
                        return ground_y2
                    end
                end
            end
        end
    end
    return nil
end

function stalker_camp_builder.get_ground_vertex_and_pos(pos, ref_y, max_allowed_y_delta)
    local mabs = math.abs
    if not pos then return nil, nil end
    local base_y = ref_y or pos.y
    local max_delta = max_allowed_y_delta or 5.0

    local surface_y = stalker_camp_builder.get_surface_y(pos.x, pos.z, base_y, 1.8, max_delta)
    local target_y = surface_y or base_y

    local target_pos = vector():set(pos.x, target_y, pos.z)
    local lvid = level.vertex_id(target_pos)
    if lvid and lvid < 4294967295 and lvid ~= -1 then
        local vpos = level.vertex_position(lvid)
        if surface_y then
            if mabs(surface_y - base_y) <= max_delta then
                return lvid, vector():set(pos.x, surface_y, pos.z)
            end
        else
            if mabs(vpos.y - base_y) <= max_delta then
                return lvid, vpos
            end
        end
    end

    local dy_offsets = {
        0.5, -0.5, 1.0, -1.0, 2.0, -2.0, 3.5, -3.5
    }

    local test_pos = vector()
    local found_dy_lvid = nil
    for _, dy in ipairs(dy_offsets) do
        if mabs(dy) <= max_delta then
            test_pos:set(pos.x, target_y + dy, pos.z)
            local tlvid = level.vertex_id(test_pos)
            if tlvid and tlvid < 4294967295 and tlvid ~= -1 then
                local tvpos = level.vertex_position(tlvid)
                if surface_y then
                    found_dy_lvid = tlvid
                    break
                else
                    if mabs(tvpos.y - base_y) <= max_delta then
                        return tlvid, tvpos
                    end
                end
            end
        end
    end
    if found_dy_lvid then
        return found_dy_lvid, vector():set(pos.x, surface_y, pos.z)
    end

    local h_pos = vector()
    local found_spiral_lvid = nil
    for dist = 1, 4 do
        for _, dir in ipairs(STATIC_SPIRAL_SCAN_DIRS) do
            h_pos:set(pos.x + dir[1] * dist, target_y, pos.z + dir[2] * dist)
            local hlvid = level.vertex_id(h_pos)
            if hlvid and hlvid < 4294967295 and hlvid ~= -1 then
                local hvpos = level.vertex_position(hlvid)
                if surface_y then
                    found_spiral_lvid = hlvid
                    break
                else
                    if mabs(hvpos.y - base_y) <= max_delta then
                        return hlvid, hvpos
                    end
                end
            end
        end
        if found_spiral_lvid then break end
    end
    if found_spiral_lvid then
        return found_spiral_lvid, vector():set(pos.x, surface_y, pos.z)
    end

    if surface_y and mabs(surface_y - base_y) <= max_delta then
        local raw_lvid = level.vertex_id(pos)
        if raw_lvid and raw_lvid < 4294967295 and raw_lvid ~= -1 then
            return raw_lvid, vector():set(pos.x, surface_y, pos.z)
        end
    end

    return nil, nil
end

