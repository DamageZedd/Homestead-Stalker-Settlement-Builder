local function generate_gamma_stash_loot(tier, is_yellow, target_level)
    tier = math.min(5, math.max(1, tier or 2))
    local loot_list = {}
    local mrand = math.random

    if is_yellow then
        local tk = roll_gamma_toolkit(target_level)
        if tk and ini_sys:section_exist(tk) then
            loot_list[#loot_list+1] = tk
        end

        local ypool = gamma_yellow_loot[tier] or gamma_yellow_loot[2]
        loot_list[#loot_list+1] = ypool[mrand(#ypool)]
        if mrand(100) <= 65 then
            loot_list[#loot_list+1] = ypool[mrand(#ypool)]
        end

        local wpool = gamma_white_loot[tier] or gamma_white_loot[2]
        for i = 1, mrand(3, 5) do
            loot_list[#loot_list+1] = wpool[mrand(#wpool)]
        end

        if mrand(100) <= 60 then
            local powders = { "powder_1", "powder_2", "powder_3" }
            loot_list[#loot_list+1] = powders[mrand(#powders)]
        end
        if mrand(100) <= 60 then
            local casings = { "casing_p", "casing_s", "casing_r5", "casing_r7" }
            loot_list[#loot_list+1] = casings[mrand(#casings)]
        end
    else
        local wpool = gamma_white_loot[tier] or gamma_white_loot[2]
        for i = 1, mrand(3, 6) do
            loot_list[#loot_list+1] = wpool[mrand(#wpool)]
        end

        if mrand(100) <= 50 then
            local powders = { "powder_1", "powder_2", "powder_3" }
            loot_list[#loot_list+1] = powders[mrand(#powders)]
        end
        if mrand(100) <= 46 then
            local casings = { "casing_p", "casing_s", "casing_r5", "casing_r7" }
            loot_list[#loot_list+1] = casings[mrand(#casings)]
        end
        if mrand(100) <= 35 then
            local bullets = { "bullet_pistol", "bullet_shotgun", "bullet_r5", "bullet_r7" }
            loot_list[#loot_list+1] = bullets[mrand(#bullets)]
        end
    end

    return loot_list
end

stalker_camp_builder.gamma_map_tiers = gamma_map_tiers
stalker_camp_builder.gamma_tools_map_tiers = gamma_tools_map_tiers
stalker_camp_builder.roll_gamma_toolkit = roll_gamma_toolkit
stalker_camp_builder.generate_gamma_stash_loot = generate_gamma_stash_loot

-- a stash list names a partly used item "section__uses" (mineral_water__2): itms_manager's
-- Extract_Uses splits it the same way when the player opens the stash
local function split_stash_entry(entry)
    local sec, uses = string.match(entry, "(.*)__(%d)")
    if sec and ini_sys:section_exist(sec) then
        return sec, tonumber(uses)
    end
    return entry, nil
end
stalker_camp_builder.split_stash_entry = split_stash_entry

local function loot_and_clear_stash(s_id, exp)
    local ipairs_ = ipairs
    if not exp or not s_id then return end
    exp.looted_stashes = exp.looted_stashes or {}
    if exp.looted_stashes[s_id] then return end
    exp.looted_stashes[s_id] = true
    if is_player_stash(s_id) then return end
    -- the list was made at dispatch, and a save can hold one that names an NPC: loot only a box
    if alife_object(s_id) and not is_stash_box(s_id) then return end

    local sb = stalker_camp_builder
    if sb and sb.active_stash_expeditions then
        for other_id, other_exp in pairs(sb.active_stash_expeditions) do
            if other_exp ~= exp and other_exp.looted_stashes and other_exp.looted_stashes[s_id] then
                return
            end
        end
    end

    exp.haul = exp.haul or {}

    local is_yellow = false
    if exp.stash_types and exp.stash_types[s_id] ~= nil then
        is_yellow = exp.stash_types[s_id]
    elseif exp.target_is_yellow ~= nil then
        is_yellow = exp.target_is_yellow
    else
        is_yellow = stalker_camp_builder.is_stash_yellow(s_id, exp.target_level)
    end

    local sim = alife()
    local se_stash = sim and sim:object(s_id)
    local target_level = exp.target_level
    if not target_level and se_stash and game_graph then
        local gv = game_graph():vertex(se_stash.m_game_vertex_id)
        if gv and sim then
            target_level = sim:level_name(gv:level_id())
        end
    end
    target_level = target_level or (level and level.name()) or "l01_escape"

    local map_tier = gamma_map_tiers[target_level] or 2
    if is_yellow then map_tier = math.min(5, map_tier + 1) end

    local stash_items = {}

    if treasure_manager and treasure_manager.caches and type(treasure_manager.caches[s_id]) == "string" then
        local raw_str = treasure_manager.caches[s_id]
        local parts = str_explode and str_explode(raw_str, ",")
        if parts then
            for _, entry in ipairs_(parts) do
                local sec, uses = split_stash_entry(entry)
                if sec and sec ~= "" and ini_sys:section_exist(sec) then
                    if sec:find("itm_basickit") or sec:find("itm_advancedkit") or sec:find("itm_expertkit") or sec:find("itm_ammokit") or sec:find("itm_drugkit") then
                        is_yellow = true
                    end
                    stash_items[#stash_items+1] = { sec = sec, uses = uses, is_yellow = is_yellow, map_tier = map_tier }
                end
            end
        end
        treasure_manager.caches[s_id] = nil
    end

    if se_stash and sim and sim.get_children then
        local to_release = {}
        pcall(function()
            for child_id in sim:get_children(se_stash) do
                local child_se = sim:object(child_id)
                -- only what is in the stash: a reused id would release an unrelated object
                if child_se and child_se.parent_id == se_stash.id then
                    local sec = child_se:section_name()
                    if sec and ini_sys:section_exist(sec) then
                        local child_cond = nil
                        local child_parts = nil
                        local is_wpn_child = ini_sys:r_string_ex(sec, "ammo_class") ~= nil and not sec:find("knife")
                        if is_wpn_child and utils_stpk and utils_stpk.get_weapon_data then
                            local ok, d = pcall(utils_stpk.get_weapon_data, child_se)
                            if ok and d and d.condition and d.condition < 0.99 then child_cond = d.condition end
                        elseif utils_stpk and utils_stpk.get_item_data then
                            local ok, d = pcall(utils_stpk.get_item_data, child_se)
                            if ok and d and d.condition and d.condition < 0.99 then child_cond = d.condition end
                        end
                        -- DANZY EDIT: only carry parts over if the stash item was actually
                        -- damaged. For untouched items this returned brand-new default parts,
                        -- which made scavenged guns/armour come home at 100%.
                        if child_cond and item_parts and item_parts.get_parts_con then
                            local ok, p = pcall(item_parts.get_parts_con, nil, child_id)
                            if ok and p then child_parts = p end
                        end
                        if sec:find("itm_basickit") or sec:find("itm_advancedkit") or sec:find("itm_expertkit") or sec:find("itm_ammokit") or sec:find("itm_drugkit") then
                            is_yellow = true
                        end
                        stash_items[#stash_items+1] = { sec = sec, cond = child_cond, parts = child_parts, is_yellow = is_yellow, map_tier = map_tier }
                    end
                    to_release[#to_release + 1] = child_se
                end
            end
        end)
        for _, rel_se in ipairs(to_release) do
            pcall(function()
                alife_release(rel_se, true)
            end)
        end
    end

    if #stash_items == 0 then
        if treasure_manager and treasure_manager.set_random_stash and se_stash then
            pcall(treasure_manager.set_random_stash, true, nil, nil, s_id)
            if treasure_manager.caches and type(treasure_manager.caches[s_id]) == "string" then
                local raw_str = treasure_manager.caches[s_id]
                local parts = str_explode and str_explode(raw_str, ",")
                if parts then
                    for _, entry in ipairs_(parts) do
                        local sec, uses = split_stash_entry(entry)
                        if sec and sec ~= "" and ini_sys:section_exist(sec) then
                            if sec:find("itm_basickit") or sec:find("itm_advancedkit") or sec:find("itm_expertkit") or sec:find("itm_ammokit") or sec:find("itm_drugkit") then
                                is_yellow = true
                            end
                            stash_items[#stash_items+1] = { sec = sec, uses = uses, is_yellow = is_yellow, map_tier = map_tier }
                        end
                    end
                end
                treasure_manager.caches[s_id] = nil
            end
        end
        if #stash_items == 0 then
            local generated = generate_gamma_stash_loot(map_tier, is_yellow, target_level)
            for _, sec in ipairs_(generated) do
                stash_items[#stash_items+1] = { sec = sec, is_yellow = is_yellow, map_tier = map_tier }
            end
        end
    end

    if is_yellow then
        exp.stash_types = exp.stash_types or {}
        exp.stash_types[s_id] = true
        if not exp.is_sweep then
            exp.target_is_yellow = true
        end
    end

    for _, itm in ipairs_(stash_items) do
        exp.haul[#exp.haul+1] = itm
    end

    pcall(function()
        if treasure_manager and treasure_manager.caches then
            treasure_manager.caches[s_id] = nil
        end
        if level and level.map_remove_object_spot then
            level.map_remove_object_spot(s_id, "treasure")
            level.map_remove_object_spot(s_id, "treasure_player")
            level.map_remove_object_spot(s_id, "treasure_unique")
            level.map_remove_object_spot(s_id, "treasure_epic")
            level.map_remove_object_spot(s_id, "treasure_searched")
            level.map_remove_object_spot(s_id, "treasure_unsearched")
            level.map_remove_object_spot(s_id, "ui_pda2_stash_location")
            level.map_remove_object_spot(s_id, "ui_pda2_special_location")
            level.map_remove_object_spot(s_id, "ui_pda2_secret_location")
            level.map_remove_object_spot(s_id, "ui_pda2_actor_box_yellow")
            level.map_remove_object_spot(s_id, "alife_presentation_stash")
        end
        if game_statistics and game_statistics.increment_statistic then
            game_statistics.increment_statistic("stashes_found")
        end
        if item_radio and item_radio.clear_stash and target_level then
            pcall(item_radio.clear_stash, target_level, s_id)
        end
    end)
end

function stalker_camp_builder.calculate_single_stash_duration(hub_id, stash_id, target_lvl, survivor)
    local hub_obj = alife_object(hub_id)
    local stash_obj = alife_object(stash_id)
    local p1, lid1, lvl1 = get_self_contained_obj_info(hub_obj)
    local p2, lid2, lvl2 = get_self_contained_obj_info(stash_obj, target_lvl)

    local is_same_level = (lid1 == lid2) or (lvl1 == lvl2)
    local one_way_dist = get_self_contained_distance(p1, lid1, lvl1, p2, lid2, lvl2)
    local round_trip_dist = one_way_dist * 2

    local tf = (level and level.get_time_factor and level.get_time_factor()) or 10
    if tf <= 0 then tf = 10 end
    return get_self_contained_duration_sec(round_trip_dist, is_same_level, survivor, 60 * tf)
end

function stalker_camp_builder.calculate_regional_sweep_duration(hub_id, all_stashes, target_lvl, survivor)
    local ipairs_ = ipairs
    local hub_obj = alife_object(hub_id)
    local hub_pos, hub_lid, hub_lvl = get_self_contained_obj_info(hub_obj)

    local count = all_stashes and #all_stashes or 1
    if count == 0 then count = 1 end

    local stash_items = {}
    for _, sid in ipairs_(all_stashes) do
        local obj = alife_object(sid)
        if obj then
            local pos, lid, lvl = get_self_contained_obj_info(obj, target_lvl)
            stash_items[#stash_items+1] = { obj = obj, pos = pos, lid = lid, lvl = lvl }
        end
    end

    local total_sweep_dist = 0
    local is_same_level = true

    if #stash_items > 0 and hub_pos then
        local first_stash = stash_items[1]
        is_same_level = (hub_lid == first_stash.lid) or (hub_lvl == first_stash.lvl)

        local remaining = {}
        for _, s in ipairs_(stash_items) do remaining[#remaining+1] = s end

        local curr_pos = hub_pos
        local curr_lid = hub_lid
        local curr_lvl = hub_lvl

        while #remaining > 0 do
            local best_idx, min_d = 1, math.huge
            for i, item in ipairs_(remaining) do
                local d = get_self_contained_distance(curr_pos, curr_lid, curr_lvl, item.pos, item.lid, item.lvl)
                if d < min_d then
                    min_d = d
                    best_idx = i
                end
            end
            total_sweep_dist = total_sweep_dist + min_d
            curr_pos = remaining[best_idx].pos
            curr_lid = remaining[best_idx].lid
            curr_lvl = remaining[best_idx].lvl
            table.remove(remaining, best_idx)
        end
        total_sweep_dist = total_sweep_dist + get_self_contained_distance(curr_pos, curr_lid, curr_lvl, hub_pos, hub_lid, hub_lvl)
    else
        total_sweep_dist = count * 350
    end

    local tf = (level and level.get_time_factor and level.get_time_factor()) or 10
    if tf <= 0 then tf = 10 end
    local total_search_sec = count * (45 * tf) -- 45 real sec search per stash
    return get_self_contained_duration_sec(total_sweep_dist, is_same_level, survivor, total_search_sec)
end

function stalker_camp_builder.format_expedition_time(game_sec)
    local mfloor = math.floor
    if not game_sec or game_sec <= 0 then return "0m" end
    local tf = (level and level.get_time_factor and level.get_time_factor()) or 10
    if tf <= 0 then tf = 10 end

    local real_sec = mfloor(game_sec / tf)
    local real_mins = mfloor(real_sec / 60)
    local real_rem_s = real_sec % 60

    if real_mins >= 60 then
        local real_hrs = mfloor(real_mins / 60)
        local rm = real_mins % 60
        return string.format("%dh %02dm", real_hrs, rm)
    elseif real_mins > 0 then
        return string.format("%dm %02ds", real_mins, real_rem_s)
    else
        return string.format("%ds", real_rem_s)
    end
end

function stalker_camp_builder.format_expedition_real_mins(game_sec)
    if not game_sec or game_sec <= 0 then return "1 min" end
    local tf = (level and level.get_time_factor and level.get_time_factor()) or 10
    if tf <= 0 then tf = 10 end
    local real_mins = math.ceil(game_sec / (tf * 60))
    return string.format("%d min%s", real_mins, real_mins == 1 and "" or "s")
end

stalker_camp_builder.current_spot_scavengers = {}

local last_menu_id = nil
local last_menu_tg = 0

function map_spot_menu_add_property(property_ui, id, level_name)
    local ipairs_ = ipairs
    local sformat = string.format
    if not property_ui or not id then return end
    local tg = time_global()
    if last_menu_id == id and (tg - last_menu_tg) < 350 then
        return
    end
    last_menu_id = id
    last_menu_tg = tg

    local sb = stalker_camp_builder
    if sb.is_stash_spot(id) then
        sb.current_spot_scavengers = {}
        local exp, primary_id = sb.get_expedition_for_stash and sb.get_expedition_for_stash(id)
        if not exp then
            exp = sb.active_stash_expeditions[id]
            primary_id = id
        end
        if exp then
            local current_sec = game_sec()
            local elapsed = current_sec - exp.start_sec
            local pct = math.floor(math.min(100, (elapsed / exp.duration) * 100))
            local rem_sec = math.max(0, exp.duration - elapsed)
            local time_str = sb.format_expedition_time(rem_sec)

            local status_str = sformat("Scavenger in Transit: %s (%d%% - %s left)", exp.survivor_name, pct, time_str)
            property_ui:AddItem(status_str)

            local recall_str = sformat("Recall Scavenger (%s)", exp.survivor_name)
            property_ui:AddItem(recall_str)
            sb.current_spot_scavengers[recall_str] = { action = "recall", stash_id = primary_id or id, npc_id = exp.npc_id, hub_id = exp.hub_id }
            return
        end

        local available = sb.get_available_scavengers()
        if #available == 0 then
            property_ui:AddItem("Dispatch Scavenger (No scavengers available)")
            return
        end

        local target_lvl = level_name or level.name()
        local lvl_disp = game.translate_string(target_lvl)
        local all_stashes = (sb.get_level_marked_stashes and sb.get_level_marked_stashes(target_lvl)) or {}
        local is_yellow = sb.is_stash_yellow(id, target_lvl)
        local type_badge = is_yellow and " [Yellow Stash]" or " [White Stash]"

        local send_prefix = game.translate_string("st_pda_send_scavenger_prefix") or "Dispatch Scavenger: "
        for _, sc in ipairs_(available) do
            local est_sec = sb.calculate_single_stash_duration(sc.hub_id, id, target_lvl, sc.survivor)
            local est_str = sb.format_expedition_real_mins(est_sec)

            local tier_str = (sc.tier and sc.tier > 0) and (" [T" .. sc.tier .. "]") or ""
            local menu_str = sformat("%s%s (%s%s - Est. %s)%s", send_prefix, sc.name, sc.camp_name, tier_str, est_str, type_badge)
            property_ui:AddItem(menu_str)
            sb.current_spot_scavengers[menu_str] = { action = "dispatch", stash_id = id, npc_id = sc.npc_id, hub_id = sc.hub_id, target_level = target_lvl, duration = est_sec, is_yellow = is_yellow }
        end

        if #all_stashes > 1 then
            local count = #all_stashes
            local sweep_types = {}
            local y_count = 0
            for _, sid in ipairs_(all_stashes) do
                local y = sb.is_stash_yellow(sid, target_lvl)
                sweep_types[sid] = y
                if y then y_count = y_count + 1 end
            end
            local w_count = count - y_count
            local sweep_badge = ""
            if y_count > 0 and w_count > 0 then
                sweep_badge = sformat(" [%d Yellow / %d White]", y_count, w_count)
            elseif y_count > 0 then
                sweep_badge = sformat(" [%d Yellow]", y_count)
            else
                sweep_badge = sformat(" [%d White]", w_count)
            end

            for _, sc in ipairs_(available) do
                local est_sec = sb.calculate_regional_sweep_duration(sc.hub_id, all_stashes, target_lvl, sc.survivor)
                local est_str = sb.format_expedition_real_mins(est_sec)

                local sweep_str = sformat("Sweep All %s Stashes (%d Stashes%s): %s (Est. %s)", lvl_disp, count, sweep_badge, sc.name, est_str)
                property_ui:AddItem(sweep_str)
                sb.current_spot_scavengers[sweep_str] = { action = "sweep", stash_id = id, all_stashes = all_stashes, npc_id = sc.npc_id, hub_id = sc.hub_id, target_level = target_lvl, duration = est_sec, stash_types = sweep_types }
            end
        end
    end
end

function map_spot_menu_property_clicked(property_ui, id, level_name, prop)
    if not id or not prop then return end
    local sb = stalker_camp_builder
    local item_data = sb.current_spot_scavengers[prop]
    if item_data then
        if item_data.action == "recall" then
            sb.recall_scavenger_expedition(item_data.stash_id)
        elseif item_data.action == "dispatch" then
            sb.dispatch_scavenger_to_stash(id, item_data.target_level or level_name, item_data.npc_id, item_data.hub_id, item_data.is_yellow)
        elseif item_data.action == "sweep" then
            sb.dispatch_scavenger_regional_sweep(item_data.all_stashes, item_data.target_level or level_name, item_data.npc_id, item_data.hub_id, item_data.stash_types)
        end
    elseif prop == game.translate_string("st_pda_send_scavenger_stash") then
        sb.dispatch_scavenger_to_stash(id, level_name)
    end
end

-- A settler's home squad brings him online and takes him offline, whatever his own switch flags say,
-- and the save keeps its flags. An expedition holds it offline; every way back must allow it online
-- again (the engine's default: online and offline both allowed), or it never comes online, nor he
-- with it. Only his own squad, as pin_settler_home_squad takes it: a shared squad's other members
-- would go with him. Returns it.
function stalker_camp_builder.allow_home_squad_online(npc_id, allow)
    local sim = alife()
    local se_npc = sim and alife_object(npc_id)
    local squad = se_npc and get_object_squad(se_npc)
    if not (squad and squad:section_name() == "online_offline_group" and squad:npc_count() == 1) then return end
    if axr_companions and axr_companions.companion_squads and axr_companions.companion_squads[squad.id] ~= nil then
        return
    end
    sim:set_switch_online(squad.id, allow)
    sim:set_switch_offline(squad.id, true)
    return squad
end

local function teleport_scavenger_on_departure(npc_id, stash_id, target_level)
    local sim = alife()
    if not (sim and npc_id) then return end
    local se_npc = alife_object(npc_id)
    if not se_npc then return end

    local dest_gvid, dest_lvid, dest_pos = nil, nil, nil
    if stash_id then
        local se_stash = alife_object(stash_id)
        if se_stash and se_stash.m_game_vertex_id then
            dest_gvid = se_stash.m_game_vertex_id
            dest_lvid = se_stash.m_level_vertex_id
            dest_pos = se_stash.position
        end
    end

    if not dest_gvid and target_level then
        local smarts = stalker_camp_builder.get_smart_terrains_on_level and stalker_camp_builder.get_smart_terrains_on_level(target_level)
        if smarts and #smarts > 0 and smarts[1].obj then
            local sm = smarts[1].obj
            dest_gvid = sm.m_game_vertex_id
            dest_lvid = sm.m_level_vertex_id
            dest_pos = sm.position
        end
    end

    -- Switch the NPC and home squad offline
    sim:set_switch_online(npc_id, false)
    sim:set_switch_offline(npc_id, true)

    local squad = stalker_camp_builder.allow_home_squad_online and stalker_camp_builder.allow_home_squad_online(npc_id, false)

    if dest_gvid and dest_lvid and dest_pos then
        pcall(sim.teleport_object, sim, npc_id, dest_gvid, dest_lvid, dest_pos)
        if squad then
            pcall(sim.teleport_object, sim, squad.id, dest_gvid, dest_lvid, dest_pos)
        end
    end
end

function stalker_camp_builder.dispatch_scavenger_to_stash(stash_id, target_level, specific_npc_id, specific_hub_id, is_yellow)
    local pairs_ = pairs
    local sb = stalker_camp_builder
    local actor = db.actor
    if not actor then return false end

    if (sb.get_expedition_for_stash and sb.get_expedition_for_stash(stash_id)) or sb.active_stash_expeditions[stash_id] then
        news_manager.send_tip(actor, game.translate_string("st_scavenger_already_dispatched"), nil, "general_stalker", 6000)
        return false
    end

    local best_surv, best_hub_id, best_camp = nil, nil, nil
    local current_lvl = level.name()
    target_level = target_level or current_lvl

    if specific_npc_id and specific_hub_id then
        local camp = sb.active_camps[specific_hub_id]
        if camp and camp.survivors and camp.survivors[specific_npc_id] then
            local surv = camp.survivors[specific_npc_id]
            local j = surv.job and string.lower(tostring(surv.job)) or "idle"
            if not surv.on_expedition and sb.survivor_se(specific_npc_id, surv) then
                if j:find("scav") == nil and j == "idle" then
                    surv.job = "scavenge"
                end
                best_surv = surv
                best_hub_id = specific_hub_id
                best_camp = camp
                best_surv.npc_id = specific_npc_id
            end
        end
    end

    if not best_surv then
        for hub_id, camp in pairs_(sb.active_camps) do
            if camp.level == target_level and camp.survivors then
                for npc_id, surv in pairs_(camp.survivors) do
                    if (surv.job == "scavenge" or surv.job == "scavenger") and not surv.on_expedition
                        and sb.survivor_se(npc_id, surv) then
                        best_surv = surv
                        best_hub_id = hub_id
                        best_camp = camp
                        best_surv.npc_id = npc_id
                        break
                    end
                end
            end
            if best_surv then break end
        end
    end

    if not best_surv then
        for hub_id, camp in pairs_(sb.active_camps) do
            if camp.survivors then
                for npc_id, surv in pairs_(camp.survivors) do
                    if (surv.job == "scavenge" or surv.job == "scavenger") and not surv.on_expedition
                        and sb.survivor_se(npc_id, surv) then
                        best_surv = surv
                        best_hub_id = hub_id
                        best_camp = camp
                        best_surv.npc_id = npc_id
                        break
                    end
                end
            end
            if best_surv then break end
        end
    end

    if not best_surv then
        news_manager.send_tip(actor, game.translate_string("st_no_available_scavengers"), nil, "general_stalker", 8000)
        return false
    end

    if is_yellow == nil then
        is_yellow = sb.is_stash_yellow(stash_id, target_level)
    end

    local final_duration_sec = sb.calculate_single_stash_duration(best_hub_id, stash_id, target_level, best_surv)
    local current_sec = game_sec()

    best_surv.on_expedition = true
    sb.active_stash_expeditions[stash_id] = {
        stash_id = stash_id,
        all_stashes = { stash_id },
        is_sweep = false,
        target_level = target_level,
        target_is_yellow = is_yellow,
        stash_types = { [stash_id] = is_yellow },
        hub_id = best_hub_id,
        npc_id = best_surv.npc_id,
        survivor_name = best_surv.name or "Scavenger",
        survivor_tier = best_surv.tier or 0,
        start_sec = current_sec,
        duration = final_duration_sec,
        chatter = {}
    }

    local real_est = sb.format_expedition_real_mins(final_duration_sec)

    local disp_lvl = game.translate_string(target_level)
    local type_str = is_yellow and " [Yellow Rare]" or " [White Common]"
    local msg = string.format(game.translate_string("st_scavenger_expedition_departed"), best_surv.name or "Scavenger", best_camp.name or "Camp", disp_lvl, type_str, real_est)
    camp_send_tip(actor, msg, nil, "general_stalker", 10000, best_hub_id, "expedition", true)

    teleport_scavenger_on_departure(best_surv.npc_id, stash_id, target_level)
    return true
end

function stalker_camp_builder.dispatch_scavenger_regional_sweep(all_stashes, target_level, specific_npc_id, specific_hub_id, stash_types)
    local sb = stalker_camp_builder
    local actor = db.actor
    if not actor or not all_stashes or #all_stashes == 0 then return false end

    local available_stashes = {}
    for _, sid in ipairs(all_stashes) do
        if not (sb.get_expedition_for_stash and sb.get_expedition_for_stash(sid)) then
            available_stashes[#available_stashes + 1] = sid
        end
    end

    if #available_stashes == 0 then
        news_manager.send_tip(actor, game.translate_string("st_scavenger_already_dispatched"), nil, "general_stalker", 6000)
        return false
    end
    all_stashes = available_stashes

    local primary_stash_id = all_stashes[1]
    if sb.active_stash_expeditions[primary_stash_id] then
        news_manager.send_tip(actor, game.translate_string("st_scavenger_already_dispatched"), nil, "general_stalker", 6000)
        return false
    end

    local best_surv, best_hub_id, best_camp = nil, nil, nil
    local current_lvl = level.name()
    target_level = target_level or current_lvl

    if specific_npc_id and specific_hub_id then
        local camp = sb.active_camps[specific_hub_id]
        if camp and camp.survivors and camp.survivors[specific_npc_id] then
            local surv = camp.survivors[specific_npc_id]
            local j = surv.job and string.lower(tostring(surv.job)) or "idle"
            if not surv.on_expedition and sb.survivor_se(specific_npc_id, surv) then
                if j:find("scav") == nil and j == "idle" then
                    surv.job = "scavenge"
                end
                best_surv = surv
                best_hub_id = specific_hub_id
                best_camp = camp
                best_surv.npc_id = specific_npc_id
            end
        end
    end

    if not best_surv then
        news_manager.send_tip(actor, game.translate_string("st_no_available_scavengers"), nil, "general_stalker", 8000)
        return false
    end

    stash_types = stash_types or {}
    for _, sid in ipairs(all_stashes) do
        if stash_types[sid] == nil then
            stash_types[sid] = sb.is_stash_yellow(sid, target_level)
        end
    end
    local primary_is_yellow = stash_types[primary_stash_id] or false

    local count = #all_stashes
    local final_duration_sec = sb.calculate_regional_sweep_duration(best_hub_id, all_stashes, target_level, best_surv)
    local current_sec = game_sec()

    best_surv.on_expedition = true
    sb.active_stash_expeditions[primary_stash_id] = {
        stash_id = primary_stash_id,
        all_stashes = all_stashes,
        is_sweep = true,
        target_level = target_level,
        target_is_yellow = primary_is_yellow,
        stash_types = stash_types,
        hub_id = best_hub_id,
        npc_id = best_surv.npc_id,
        survivor_name = best_surv.name or "Scavenger",
        survivor_tier = best_surv.tier or 0,
        start_sec = current_sec,
        duration = final_duration_sec,
        chatter = {}
    }

    local real_est = sb.format_expedition_real_mins(final_duration_sec)

    local disp_lvl = game.translate_string(target_level)
    local msg = string.format(game.translate_string("st_scavenger_sweep_departed"), best_surv.name or "Scavenger", best_camp.name or "Camp", count, disp_lvl, real_est)
    camp_send_tip(actor, msg, nil, "general_stalker", 11000, best_hub_id, "expedition", true)

    teleport_scavenger_on_departure(best_surv.npc_id, primary_stash_id, target_level)
    return true
end

local function get_item_display_name(sec)
    local ini = ini_sys or sys_ini or system_ini()
    if ini and ini:section_exist(sec) then
        local name_id = ini:r_string_ex(sec, "inv_name")
        if name_id then
            local tr = game.translate_string(name_id)
            if tr and tr ~= "" and tr ~= name_id then
                return tr
            end
        end
    end
    return sec
end

-- Expedition helpers (extracted from process_stash_expeditions)
local tonum = tonumber  -- file-local alias used by the lookup helpers below

-- game time alone: it counts sleep, and runs at the faster pace of emissions and psi storms
local function get_expedition_progress(exp, current_sec)
    local elapsed = current_sec - (exp.start_sec or current_sec)
    local dur = math.max(1, exp.duration or 1)
    return elapsed, dur, elapsed / dur
end

local function emit_expedition_chatter(actor, exp, progress, target_lvl_name, camp_name)
    local name = exp.survivor_name or "Scavenger"
    if progress >= 0.25 and not exp.chatter[25] then
        exp.chatter[25] = true
        camp_send_tip(actor,
            sformat(game.translate_string("st_scavenger_radio_25"), name, target_lvl_name),
            nil, "general_stalker", 8000, exp.hub_id, "expedition")
    end
    if progress >= 0.50 and not exp.chatter[50] then
        exp.chatter[50] = true
        camp_send_tip(actor,
            sformat(game.translate_string("st_scavenger_radio_50"), name, target_lvl_name, camp_name),
            nil, "general_stalker", 8000, exp.hub_id, "expedition")
    end
    if progress >= 0.75 and not exp.chatter[75] then
        exp.chatter[75] = true
        camp_send_tip(actor,
            sformat(game.translate_string("st_scavenger_radio_75"), name, camp_name),
            nil, "general_stalker", 8000, exp.hub_id, "expedition")
    end
end

local function loot_due_stashes(exp, stash_id, progress)
    local stashes = exp.all_stashes or { stash_id }
    if exp.is_sweep and #stashes > 1 then
        for i, s_id in ipairs_(stashes) do
            local threshold = 0.25 + (0.50 * (i / #stashes))
            if progress >= threshold and not exp.looted_stashes[s_id] then
                pcall(loot_and_clear_stash, s_id, exp)
            end
        end
    elseif progress >= 0.50 and not exp.looted_stashes[stash_id] then
        pcall(loot_and_clear_stash, stash_id, exp)
    end
end

local function find_expedition_camp(exp)
    local camps = stalker_camp_builder.active_camps
    if not camps then return nil end
    local camp = camps[exp.hub_id]
        or (tonum(exp.hub_id) and camps[tonum(exp.hub_id)])
        or camps[tostr(exp.hub_id)]
    if camp then return camp end

    for hid, c in pairs_(camps) do
        if c.survivors then
            local hit = c.survivors[exp.npc_id]
                or c.survivors[tonum(exp.npc_id)]
                or c.survivors[tostr(exp.npc_id)]
            if hit then
                exp.hub_id = hid
                return c
            end
        end
    end
    return nil
end

local function find_expedition_survivor(camp, exp)
    if not (camp and camp.survivors) then return nil end
    local surv = camp.survivors[exp.npc_id]
        or camp.survivors[tonum(exp.npc_id)]
        or camp.survivors[tostr(exp.npc_id)]
    if surv then return surv end

    if exp.survivor_name then
        for _, s in pairs_(camp.survivors) do
            if s.name == exp.survivor_name then return s end
        end
    end
    return nil
end

-- `level` has no valid_vertex_id (that is a game graph method); u32(-1) means no vertex
local function is_level_vertex(lvid)
    return lvid and lvid < 4294967295 and lvid ~= -1
end

local function reposition_survivor_at_camp(exp, camp, hub_obj, box_se, surv)
    local sim_alao = alife()
    if surv then surv.on_expedition = nil end

    local se_npc = alife_object(exp.npc_id)
    local hub_pos  = hub_obj and hub_obj.position
    local hub_lvid = hub_obj and hub_obj.m_level_vertex_id
    local hub_gvid = hub_obj and hub_obj.m_game_vertex_id

    local spawn_pos, spawn_lvid, spawn_gvid = hub_pos, hub_lvid, hub_gvid

    if box_se and hub_pos then
        local bsec = box_se:section_name():lower()
        local y_diff = math.abs(box_se.position.y - hub_pos.y)
        if not (bsec:find("workshop_stash") or y_diff > 12.0) then
            spawn_pos  = box_se.position
            spawn_lvid = box_se.m_level_vertex_id
            spawn_gvid = box_se.m_game_vertex_id
        end
    end

    local camp_lvl = camp and camp.level
    if (not camp_lvl or camp_lvl == "" or camp_lvl == "unknown")
        and hub_obj and game_graph and sim_alao then
        local gv = game_graph():vertex(hub_obj.m_game_vertex_id)
        if gv then camp_lvl = sim_alao:level_name(gv:level_id()) end
    end
    local current_lvl = level and level.name and level.name()
    local is_same_level = (camp_lvl and current_lvl and camp_lvl == current_lvl)

    local stand_lvid, stand_pos
    if is_same_level and stalker_camp_builder.get_furniture_front_vertex_and_pos and spawn_pos then
        stand_lvid, stand_pos =
            stalker_camp_builder.get_furniture_front_vertex_and_pos(spawn_pos, 1.4)
    end
    local final_pos  = stand_pos  or spawn_pos
    local final_lvid = stand_lvid or spawn_lvid

    if is_same_level and level then
        if final_lvid and not is_level_vertex(final_lvid) then
            final_lvid = (is_level_vertex(hub_lvid) and hub_lvid)
                or (is_level_vertex(spawn_lvid) and spawn_lvid)
                or (final_pos and level.vertex_id(final_pos))
        end
        if is_level_vertex(final_lvid) then
            final_pos = level.vertex_position(final_lvid)
        end
    end

    if se_npc and final_pos then
        sim_alao:set_switch_online(se_npc.id, true)
        sim_alao:set_switch_offline(se_npc.id, true)
        if stalker_camp_builder.allow_home_squad_online then
            stalker_camp_builder.allow_home_squad_online(se_npc.id, true)
        end
        se_npc.position           = final_pos
        if final_lvid then se_npc.m_level_vertex_id = final_lvid end
        if spawn_gvid then se_npc.m_game_vertex_id  = spawn_gvid end
    end

    if stalker_camp_builder.teleport_settler_to_camp_level then
        stalker_camp_builder.teleport_settler_to_camp_level(exp.npc_id, exp.hub_id, true)
    end
    if stalker_camp_builder.pin_settler_home_squad then
        stalker_camp_builder.pin_settler_home_squad(exp.npc_id)
    end

    if is_same_level then
        local wait_lvid = final_lvid or spawn_lvid or (hub_obj and hub_obj.m_level_vertex_id)
        if wait_lvid and not is_level_vertex(wait_lvid) then
            wait_lvid = (is_level_vertex(hub_lvid) and hub_lvid) or nil
        end
        local look_pos  = spawn_pos  or (hub_obj and hub_obj.position)
        local npc_id    = exp.npc_id

        local online_npc = level.object_by_id(npc_id)
        if online_npc then
            pcall(function()
                if IsStalker(online_npc) and online_npc.set_npc_position and final_pos then
                    online_npc:set_npc_position(final_pos)
                end
                if stalker_camp_builder.setup_settler_beh_logic and wait_lvid then
                    stalker_camp_builder.setup_settler_beh_logic(online_npc, wait_lvid, look_pos, "guard")
                end
            end)
        elseif se_npc then  -- set_switch_online on an id with no server object is an engine crash
            if utils_obj and utils_obj.switch_online then
                pcall(utils_obj.switch_online, npc_id)
            else
                local sim = sim_alao
                if sim and npc_id and npc_id < 65535 then
                    pcall(sim.set_switch_online, sim, npc_id, true)
                    pcall(sim.set_switch_offline, sim, npc_id, false)
                end
            end

            CreateTimeEvent("homestead_exp_return", "ret_" .. tostring(npc_id), 1.0, function()
                pcall(function()
                    local obj = level.object_by_id(npc_id)
                    if obj then
                        if IsStalker(obj) and obj.set_npc_position and final_pos then
                            obj:set_npc_position(final_pos)
                        end
                        if stalker_camp_builder.setup_settler_beh_logic and is_level_vertex(wait_lvid) then
                            stalker_camp_builder.setup_settler_beh_logic(obj, wait_lvid, look_pos, "guard")
                        end
                    end
                end)
                return true
            end)
        end
    end
end

local function roll_expedition_ambush(actor, exp)
    local sb = stalker_camp_builder
    local chance = (sb.cfg and sb.cfg.scavenger_ambush_chance) or 20
    local name = exp.survivor_name or "Scavenger"

    if math.random(100) > chance then
        return {}, 75, "Safe Expedition"
    end

    if (exp.survivor_tier or 0) >= 2 or math.random(100) <= 60 then
        if actor then
            camp_send_tip(actor,
                sformat(game.translate_string("st_scavenger_ambush_win"), name),
                nil, "general_stalker", 10000, exp.hub_id, "expedition")
        end
        return {"ammo_5.45x39_fmj", "mutant_part_dog_tail", "bandage",
                "conserva", "prt_i_scrap"},
               135, "Repelled Ambush (+Bonus Salvage)"
    end

    if actor then
        camp_send_tip(actor,
            sformat(game.translate_string("st_scavenger_ambush_fled"), name),
            nil, "red_danger", 10000, exp.hub_id, "combat", true)
    end
    return {}, 45, "Evaded Enemy Ambush"
end

local function deposit_expedition_haul(exp, camp, bonus_loot)
    local sb = stalker_camp_builder
    local items_recovered = 0
    local deposited_names = {}
    local item_counts     = {}

    local function record(sec)
        local dname = get_item_display_name(sec)
        if not item_counts[dname] then
            item_counts[dname] = 0
            deposited_names[#deposited_names + 1] = dname
        end
        item_counts[dname] = item_counts[dname] + 1
    end

    local spec_mult = (sb.get_specialization_mult and camp and sb.get_specialization_mult(camp, "scavenge")) or 1.0
    for _, itm in ipairs_(exp.haul or {}) do
        local count = 1
        if spec_mult > 1.0 then
            count = count + (math.random() < (spec_mult - 1.0) and 1 or 0)
        end
        for c = 1, count do
            local dep_box = nil
            pcall(function()
                dep_box = sb.deposit_item_to_camp(exp.hub_id, camp, itm.sec,
                    itm.is_yellow, itm.map_tier, itm.cond, itm.parts, itm.uses)
            end)
            if dep_box then
                items_recovered = items_recovered + 1
                record(itm.sec)
            end
        end
    end

    for _, bsec in ipairs_(bonus_loot) do
        local count = 1
        if spec_mult > 1.0 then
            count = count + (math.random() < (spec_mult - 1.0) and 1 or 0)
        end
        for c = 1, count do
            local dep_box = nil
            pcall(function()
                dep_box = sb.deposit_item_to_camp(exp.hub_id, camp, bsec,
                    false, exp.survivor_tier or 0)
            end)
            if dep_box then
                items_recovered = items_recovered + 1
                record(bsec)
            end
        end
    end

    return items_recovered, deposited_names, item_counts
end

local function award_expedition_xp(surv, xp_earned)
    if not surv then
        return xp_earned, 0
    end
    surv.xp = (surv.xp or 0) + xp_earned
    if surv.xp >= 300 and (surv.tier or 0) < 1 then
        surv.tier = 1
    elseif surv.xp >= 700 and (surv.tier or 0) < 2 then
        surv.tier = 2
    elseif surv.xp >= 1500 and (surv.tier or 0) < 3 then
        surv.tier = 3
    end
    return surv.xp, surv.tier or 0
end

local function format_expedition_receipt(exp, camp, stash_id, ambush_note,
                                          items_recovered, deposited_names, item_counts,
                                          xp_earned, total_xp, cur_tier)
    local stashes = exp.all_stashes or { stash_id }

    local item_lines = {}
    for _, dname in ipairs_(deposited_names) do
        local cnt = item_counts[dname] or 1
        if cnt > 1 then
            item_lines[#item_lines + 1] = sformat(" - %s (x%d)", dname, cnt)
        else
            item_lines[#item_lines + 1] = sformat(" - %s", dname)
        end
    end
    local items_list_str = (#item_lines > 0)
        and table.concat(item_lines, "\n")
        or " - (No items / storage full)"

    local disp_lvl = game.translate_string(exp.target_level or "unknown")
    local stash_desc
    if exp.is_sweep then
        local yellow_cnt, white_cnt = 0, 0
        for _, s_id in ipairs_(stashes) do
            if exp.stash_types and exp.stash_types[s_id] then
                yellow_cnt = yellow_cnt + 1
            else
                white_cnt = white_cnt + 1
            end
        end
        if yellow_cnt > 0 and white_cnt > 0 then
            stash_desc = sformat("%d Stashes in %s (%d Yellow Rare / %d White Common)",
                #stashes, disp_lvl, yellow_cnt, white_cnt)
        elseif yellow_cnt > 0 then
            stash_desc = sformat("%d Yellow (Rare) Stashes in %s", #stashes, disp_lvl)
        else
            stash_desc = sformat("%d White (Common) Stashes in %s", #stashes, disp_lvl)
        end
    else
        local is_yellow = exp.target_is_yellow
            or (exp.stash_types and exp.stash_types[stashes[1]])
        if is_yellow then
            stash_desc = sformat("Yellow (Rare) Stash in %s", disp_lvl)
        else
            stash_desc = sformat("White (Common) Stash in %s", disp_lvl)
        end
    end

    local camp_label = camp and camp.name or "Settlement Storage"
    local r_items = tonumber(items_recovered) or 0
    local r_xp_earned = tonumber(xp_earned) or 0
    local r_total_xp = tonumber(total_xp) or 0
    local r_cur_tier = tonumber(cur_tier) or 0

    local ok, res = pcall(sformat,
        game.translate_string("st_scavenger_receipt_body_full"),
        exp.survivor_name or "Scavenger",
        camp_label,
        stash_desc or "Stash",
        ambush_note or "",
        r_items,
        items_list_str or "(No items)",
        r_xp_earned,
        r_total_xp,
        r_cur_tier)
    if ok and res then return res end

    return string.format("EXPEDITION REPORT: %s returned to %s! Deposited %d items.",
        exp.survivor_name or "Scavenger", camp_label, r_items)
end

-- Per-expedition completion (was the ~180-line pcall'd body)
local function cleanup_expedition(stash_id)
    local sb = stalker_camp_builder
    local exp = sb.active_stash_expeditions and sb.active_stash_expeditions[stash_id]
    local npc_id = exp and exp.npc_id
    local surv_name = exp and exp.survivor_name

    if sb.active_camps then
        for _, c in pairs_(sb.active_camps) do
            if c.survivors then
                if npc_id then
                    local s = c.survivors[npc_id]
                        or c.survivors[tonum(npc_id)]
                        or c.survivors[tostr(npc_id)]
                    if s then s.on_expedition = nil end
                end
                if surv_name then
                    for _, s in pairs_(c.survivors) do
                        if s.name == surv_name then
                            s.on_expedition = nil
                        end
                    end
                end
            end
        end
    end
    if sb.active_stash_expeditions then
        sb.active_stash_expeditions[stash_id] = nil
    end
end

local function complete_expedition(stash_id)
    local sb = stalker_camp_builder
    local actor = db.actor
    local exp = sb.active_stash_expeditions and sb.active_stash_expeditions[stash_id]
    if not exp then return end

    for _, s_id in ipairs_(exp.all_stashes or { stash_id }) do
        if not exp.looted_stashes or not exp.looted_stashes[s_id] then
            pcall(loot_and_clear_stash, s_id, exp)
        end
    end

    local camp    = find_expedition_camp(exp)
    local hub_obj = alife_object(exp.hub_id)
    local target_box = sb.get_auto_sort_target_box(camp, exp.hub_id, "conserva")
        or exp.hub_id
    local box_se  = alife_object(target_box) or hub_obj
    local surv    = find_expedition_survivor(camp, exp)

    reposition_survivor_at_camp(exp, camp, hub_obj, box_se, surv)

    local bonus_loot, xp_earned, ambush_note = roll_expedition_ambush(actor, exp)
    local items_recovered, deposited_names, item_counts =
        deposit_expedition_haul(exp, camp, bonus_loot)
    local total_xp, cur_tier = award_expedition_xp(surv, xp_earned)

    if actor then
        local ok, receipt = pcall(format_expedition_receipt, exp, camp, stash_id, ambush_note,
            items_recovered, deposited_names, item_counts,
            xp_earned, total_xp, cur_tier)
        if ok and receipt then
            camp_send_tip(actor, receipt, nil, "general_stalker", 16000, exp.hub_id, "expedition")
        end
    end

    cleanup_expedition(stash_id)
end

-- process_stash_expeditions -- orchestrator
function stalker_camp_builder.process_stash_expeditions()
    local sb = stalker_camp_builder
    local actor = db.actor
    if not actor then return end

    local current_sec = game_sec()

    local completed = {}

    for stash_id, exp in pairs_(sb.active_stash_expeditions or {}) do
        local elapsed, dur, progress = get_expedition_progress(exp, current_sec)

        exp.chatter        = exp.chatter or {}
        exp.looted_stashes = exp.looted_stashes or {}
        exp.haul           = exp.haul or {}

        local target_lvl_name = game.translate_string(exp.target_level or "unknown")
        local home_camp = sb.active_camps and sb.active_camps[exp.hub_id]
        local camp_name = (home_camp and home_camp.name) or "Camp"

        emit_expedition_chatter(actor, exp, progress, target_lvl_name, camp_name)
        loot_due_stashes(exp, stash_id, progress)

        if elapsed >= dur then
            completed[#completed + 1] = stash_id
        end
    end

    for _, stash_id in ipairs_(completed) do
        pcall(complete_expedition, stash_id)
        cleanup_expedition(stash_id)
    end
end

-- SETTLEMENT HOSPITALITY FEAST BUFF & POWER GRID (v1.1.2)
-- DANZY EDIT: the buff used to only set a timer nothing read. While active it now
-- slowly restores health and stamina (same rate as friendly rival camps).
function stalker_camp_builder.apply_hospitality_buff(hours)
    local actor = db.actor
    if not actor then return end
    local sb = stalker_camp_builder
    local current_sec = game_sec()
    local was_active = current_sec < (sb.hospitality_buff_end_sec or 0)
    sb.hospitality_buff_end_sec = math.max(sb.hospitality_buff_end_sec or 0, current_sec + ((hours or 4) * 3600))
    if was_active then return end  -- already fed/rested: just extend it quietly

    local snd = sound_object([[interface\inv_drink_flask]])
    if snd then snd:play(actor, 0, sound_object.s2d) end
    news_manager.send_tip(actor, game.translate_string("st_buff_hospitality_applied"), nil, "general_stalker", 7000)
end

function stalker_camp_builder.tick_hospitality_buff(actor)
    local sb = stalker_camp_builder
    if not (actor and actor:alive()) then return end
    local current_sec = game_sec()
    if current_sec >= (sb.hospitality_buff_end_sec or 0) then return end
    if actor.health < 1.0 then actor.health = math.min(1.0, actor.health + 0.005) end
    if actor.power < 1.0 then actor.power = math.min(1.0, actor.power + 0.05) end
end

function stalker_camp_builder.check_hospitality_on_item_use(item)
    if not item then return end
    local actor = db.actor
    if not actor then return end

    local sec = item:section():lower()
    if sec:find("meat_") or sec:find("cooked") or sec:find("tushonka") or sec:find("conserva") then
        local hub_id, camp = stalker_camp_builder.get_active_camp_near(actor:position())
        if camp and hub_id then
            local morale = stalker_camp_builder.get_camp_morale(camp, alife_object(hub_id))
            if morale >= 50 then
                stalker_camp_builder.apply_hospitality_buff(4)
            end
        end
    end
end

function stalker_camp_builder.check_hospitality_on_sleep(hours)
    local actor = db.actor
    if not actor then return end
    local hub_id, camp = stalker_camp_builder.get_active_camp_near(actor:position())
    if camp and hub_id then
        local morale = stalker_camp_builder.get_camp_morale(camp, alife_object(hub_id))
        if morale >= 60 then
            stalker_camp_builder.apply_hospitality_buff(hours or 6)
        end
    end
end

