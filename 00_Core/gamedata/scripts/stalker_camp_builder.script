-- Sleep Bonus System

local last_sleep_check_sec = nil
local last_sleep_in_camp_hub = nil  -- hub_id actor was inside at the LAST update tick
function check_camp_sleep_bonus()
    local actor = db.actor
    if not actor then return end
    if cfg.camp_rest_bonus == false then return end

    local current_sec = game_sec()

    local actor_pos = db.actor:position()
    local current_hub_id = get_active_camp_near(actor_pos)

    if last_sleep_check_sec then
        local elapsed = current_sec - last_sleep_check_sec
        if elapsed >= 10800 and last_sleep_in_camp_hub and stalker_camp_builder.active_camps[last_sleep_in_camp_hub] then
            if current_hub_id then
                -- change_satiety and change_power clamp at full; actor_status_thirst keeps its
                -- counter in a local and has no setter, so thirst is left alone
                pcall(function() actor:change_satiety(1.0) end)
                pcall(function() actor:change_power(1.0) end)
                news_manager.send_tip(actor, game.translate_string("st_camp_rest_bonus_msg"), nil, "general_stalker", 10000)
                -- DANZY EDIT: sleeping at a happy settlement also grants the hospitality buff
                if stalker_camp_builder.check_hospitality_on_sleep then
                    guarded_call("check_hospitality_on_sleep", stalker_camp_builder.check_hospitality_on_sleep, 6)
                end
            end
        end
    end
    last_sleep_check_sec = current_sec
    last_sleep_in_camp_hub = current_hub_id  -- record camp proximity for next check
end

-- Survivor XP / Skill System

function award_survivor_xp(survivor, job, amount)
    if not survivor then return end
    amount = amount or 10
    survivor.xp = (survivor.xp or 0) + amount
    local xp = survivor.xp
    local old_tier = survivor.tier or 0
    local new_tier = 0
    if xp >= 500 then new_tier = 3  -- Master
    elseif xp >= 250 then new_tier = 2  -- Expert
    elseif xp >= 100 then new_tier = 1  -- Skilled
    end
    if new_tier > old_tier then
        survivor.tier = new_tier
        local tier_names = {"st_settler_tier_novice", "st_settler_tier_skilled", "st_settler_tier_expert", "st_settler_tier_master"}
        if db.actor then
            -- the job's title as the PDA shows it; an idle settler is a Settler, not an Idle
            local title_id = job == "idle" and "st_settler_title_idle" or ("st_pda_settlement_job_" .. tostring(job))
            local job_title = game.translate_string(title_id)
            if job_title == title_id then job_title = job or "" end
            local msg = string.format(game.translate_string("st_event_settler_promoted"), survivor.name or "Survivor",
                game.translate_string(tier_names[new_tier+1]), job_title)
            camp_send_tip(db.actor, msg, nil, "general_stalker", 10000)
            if stalker_camp_builder.add_radio_feed_entry then
                stalker_camp_builder.add_radio_feed_entry("settlement", msg)
            end
        end
    end
end

function get_survivor_tier_mult(survivor)
    local tier = survivor and survivor.tier or 0
    if tier >= 3 then return 3.0 end  -- Master
    if tier >= 2 then return 2.0 end  -- Expert
    if tier >= 1 then return 1.5 end  -- Skilled
    return 1.0  -- Novice
end

local camp_log = {}
local CAMP_LOG_MAX_ENTRIES = 50

function add_camp_log_entry(text, severity)
    camp_log[#camp_log+1] = {time=time_global(), text=text, severity=severity or "info"}
    if #camp_log > CAMP_LOG_MAX_ENTRIES then
        table.remove(camp_log, 1)
    end
end

local dashboard_cache = { data = nil, expires_tg = 0 }
local DASHBOARD_CACHE_TTL_MS = 15000  -- 15 real seconds

-- ============================================================================
-- Camp-to-Camp Resource Transfer System
-- ============================================================================

-- Transfer items from one camp's chest to another. Moves up to max_items
-- of the specified item section from source_hub to target_hub.
-- Returns: number of items actually transferred.
function transfer_supplies(source_hub_id, target_hub_id, item_section, max_items)
    max_items = max_items or 10
    local source_camp = stalker_camp_builder.active_camps[source_hub_id]
    local target_camp = stalker_camp_builder.active_camps[target_hub_id]
    if not source_camp or not target_camp then return 0, "no_camp" end

    -- Find source chest (nearest stash to source hub)
    local source_hub_obj = alife_object(source_hub_id)
    if not source_hub_obj then return 0, "no_source_hub" end
    local source_box_id = nil
    local min_dist = 99999
    for struct_id, struct_type in pairs(source_camp.structures or {}) do
        if struct_type == "stash" then
            local se = alife_object(struct_id)
            if se then
                local d = se.position:distance_to(source_hub_obj.position)
                if d < min_dist then min_dist = d; source_box_id = struct_id end
            end
        end
    end
    if not source_box_id then return 0, "no_source_box" end

    -- Find target chest
    local target_hub_obj = alife_object(target_hub_id)
    if not target_hub_obj then return 0, "no_target_hub" end
    local target_box_id = nil
    min_dist = 99999
    for struct_id, struct_type in pairs(target_camp.structures or {}) do
        if struct_type == "stash" then
            local se = alife_object(struct_id)
            if se then
                local d = se.position:distance_to(target_hub_obj.position)
                if d < min_dist then min_dist = d; target_box_id = struct_id end
            end
        end
    end
    if not target_box_id then return 0, "no_target_box" end

    -- Find and move items
    local transferred = 0
    local items_to_move = {}

    stalker_camp_builder.camp_iterate_inventory(source_hub_id, source_camp, function(item_id, sec, cond, uses, se_obj, cid, cl_item)
        if transferred >= max_items then return true end
        if sec == item_section then
            items_to_move[#items_to_move+1] = item_id
            transferred = transferred + 1
            if transferred >= max_items then return true end
        end
    end, source_box_id)

    if transferred <= 0 then return 0 end

    -- Actually move the items (release from source, create in target)
    local sim = alife()
    if not sim then return 0 end
    local dest_se = alife_object(target_box_id)
    if not dest_se then return 0, "no_dest_se" end
    local pos = dest_se.position or vector()
    local lvid = dest_se.m_level_vertex_id or 0
    local gvi = dest_se.m_game_vertex_id or 0
    for _, item_id in ipairs(items_to_move) do
        local se_item = alife_object(item_id)
        if se_item then
            alife_release(se_item)
            sim:create(item_section, pos, lvid, gvi, target_box_id)
        end
    end

    return transferred
end

-- Get a list of all item sections in a camp's chest (for the transfer UI).
-- Returns a table of {section = count, ...}.
function get_camp_inventory_summary(hub_id)
    local camp = stalker_camp_builder.active_camps[hub_id]
    if not camp then return {} end
    local hub_obj = alife_object(hub_id)
    if not hub_obj then return {} end

    local summary = {}
    stalker_camp_builder.camp_iterate_inventory(hub_id, camp, function(item_id, sec, cond, uses, se_obj, box_id)
        if sec then
            summary[sec] = (summary[sec] or 0) + 1
        end
    end)
    return summary
end

-- ============================================================================
-- Camp Trade Routes System
-- ============================================================================

-- Trade routes allow automatic item transfer between camps on a timer.
-- Each route has: source_hub, target_hub, item_section, quantity_per_run, interval_sec.
-- Routes are stored in camp.trade_routes and fire on actor_on_update.
-- v1.1.8: restored (kept for the future route-setup UI).

-- Establish a trade route between two camps.
function establish_trade_route(source_hub_id, target_hub_id, item_section, quantity, interval_sec)
    local source_camp = stalker_camp_builder.active_camps[source_hub_id]
    if not source_camp then return false, "no_source_camp" end
    source_camp.trade_routes = source_camp.trade_routes or {}
    local route = {
        target_hub_id = target_hub_id,
        item_section = item_section,
        quantity = quantity or 5,
        interval_sec = interval_sec or 3600,  -- default: 1 game hour
        last_run_sec = game_sec(),
    }
    source_camp.trade_routes[#source_camp.trade_routes+1] = route
    return true
end

-- Remove all trade routes from a camp (or a specific one by index).
function remove_trade_route(source_hub_id, route_index)
    local source_camp = stalker_camp_builder.active_camps[source_hub_id]
    if not source_camp or not source_camp.trade_routes then return false end
    if route_index then
        table.remove(source_camp.trade_routes, route_index)
    else
        source_camp.trade_routes = {}
    end
    return true
end

-- Process all trade routes for all camps. Called from the staggered
-- actor_on_update task table (slot 9, teardown-grace gated).
function process_trade_routes()
    local current_sec = game_sec()
    for source_hub_id, camp in pairs(stalker_camp_builder.active_camps) do
        if camp.trade_routes then
            for i, route in ipairs(camp.trade_routes) do
                local elapsed = current_sec - (route.last_run_sec or 0)
                if elapsed >= route.interval_sec then
                    route.last_run_sec = current_sec
                    local transferred = transfer_supplies(source_hub_id, route.target_hub_id, route.item_section, route.quantity)
                    if transferred > 0 then
                        -- printf(string.format("[Homestead] Trade route: %d %s moved from camp %d to camp %d", transferred, route.item_section, source_hub_id, route.target_hub_id))
                    end
                end
            end
        end
    end
end

function server_entity_on_unregister(se_obj, type_name)
    if not se_obj then return end

    local in_teardown_grace = homestead_is_disconnecting
        or (stalker_camp_builder.homestead_is_disconnecting)
        or (time_global and homestead_teardown_grace_until and time_global() < homestead_teardown_grace_until)
        or (time_global and stalker_camp_builder.homestead_teardown_grace_until and time_global() < stalker_camp_builder.homestead_teardown_grace_until)

    if in_teardown_grace then
        return
    end

    local obj_id = se_obj.id

    if stalker_camp_builder.active_camps[obj_id] then
        local camp = stalker_camp_builder.active_camps[obj_id]
        if stalker_camp_builder.release_legacy_camp_stash then
            stalker_camp_builder.release_legacy_camp_stash(camp, se_obj.position)
        end
        pcall(function()
            if level and level.map_remove_object_spot then
                level.map_remove_object_spot(obj_id, "ui_pda2_actor_sleep_location")
            end
        end)
        if camp.zone_id then
            local zid = camp.zone_id
            safe_deferred_release(zid)
        end
        invalidate_scan_camp_structures_cache(obj_id)
        stalker_camp_builder.end_camp_raid(camp)
        stalker_camp_builder.active_camps[obj_id] = nil
        pcall(function()
            if actor_menu and actor_menu.set_msg and game and game.translate_string then
                actor_menu.set_msg(1, game.translate_string("st_hub_removed"), 3)
            end
        end)
        return
    end

    for hub_id, camp in pairs(stalker_camp_builder.active_camps) do
        if camp.structures and camp.structures[obj_id] then
            camp.structures[obj_id] = nil
            invalidate_scan_camp_structures_cache(hub_id)
        end
        if camp.survivors and camp.survivors[obj_id] then
            stalker_camp_builder.settler_lookup[obj_id] = nil
            -- released without dying (another mod's despawner): the record stays until the next
            -- load re-creates the settler, and the NPC that gets this id meanwhile is someone else
            camp.survivors[obj_id].released_id = obj_id
        end
    end

    local m_data = alife_storage_manager and alife_storage_manager.get_state and alife_storage_manager.get_state()
    if m_data and m_data.stalker_camp_builder_banished_companions and m_data.stalker_camp_builder_banished_companions[obj_id] then
        m_data.stalker_camp_builder_banished_companions[obj_id] = nil
    end
    if m_data and m_data.stalker_camp_builder_freed_settlers and m_data.stalker_camp_builder_freed_settlers[obj_id] then
        m_data.stalker_camp_builder_freed_settlers[obj_id] = nil
    end
    -- a courier whose squad is gone: its entry goes too, so the freed id is never taken for it
    if stalker_camp_builder.active_convoys then
        stalker_camp_builder.active_convoys[obj_id] = nil
    end
    -- the same for a refugee whose body is gone
    if stalker_camp_builder.refugee_ids then
        stalker_camp_builder.refugee_ids[obj_id] = nil
    end

    if stalker_camp_builder.rival_camps then
        for key, rcamp in pairs(stalker_camp_builder.rival_camps) do
            if type(rcamp) == "table" then
                if rcamp.chest_id == obj_id then
                    if stalker_camp_builder.remove_all_rival_map_spots then
                        pcall(stalker_camp_builder.remove_all_rival_map_spots, obj_id)
                    end
                    if stalker_camp_builder.release_camp_decorations then
                        pcall(stalker_camp_builder.release_camp_decorations, rcamp)
                    end
                    if stalker_camp_builder.cleanup_camp_convoys then
                        pcall(stalker_camp_builder.cleanup_camp_convoys, obj_id)
                    end
                    if stalker_camp_builder.release_rival_hold then
                        if rcamp.squad_id then
                            local sq = alife_object(rcamp.squad_id)
                            if sq then pcall(stalker_camp_builder.release_rival_hold, stalker_camp_builder, sq) end
                        end
                        if rcamp.extra_squad_ids then
                            for _, ex_id in ipairs(rcamp.extra_squad_ids) do
                                local ex_sq = alife_object(ex_id)
                                if ex_sq then pcall(stalker_camp_builder.release_rival_hold, stalker_camp_builder, ex_sq) end
                            end
                        end
                    end
                    if m_data and m_data.player_created_stashes then
                        m_data.player_created_stashes[obj_id] = nil
                    end
                    -- the outpost registered its chest as a treasure cache (G.A.M.M.A. mode keeps the
                    -- entry): a later object with this id must not read as a stash
                    if treasure_manager and treasure_manager.caches then
                        treasure_manager.caches[obj_id] = nil
                    end
                    stalker_camp_builder.rival_camps[key] = nil
                    break
                else
                    if rcamp.squad_id == obj_id then
                        rcamp.squad_id = nil
                        if rcamp.extra_squad_ids and #rcamp.extra_squad_ids > 0 then
                            rcamp.squad_id = table.remove(rcamp.extra_squad_ids, 1)
                        end
                    elseif rcamp.extra_squad_ids then
                        for i = #rcamp.extra_squad_ids, 1, -1 do
                            if rcamp.extra_squad_ids[i] == obj_id then
                                table.remove(rcamp.extra_squad_ids, i)
                                break
                            end
                        end
                    end
                    -- the same for the outpost's heat pack
                    if rcamp.heat_mutant_squad_id == obj_id then
                        rcamp.heat_mutant_squad_id = nil
                    end
                    if rcamp.decorations then
                        for i = #rcamp.decorations, 1, -1 do
                            if rcamp.decorations[i] == obj_id then
                                table.remove(rcamp.decorations, i)
                                break
                            end
                        end
                    end
                    if rcamp.decor_sections then
                        rcamp.decor_sections[obj_id] = nil
                    end
                end
            end
        end
    end
end

-- re-creates an Invincible settler who died (npc_on_death_callback) at the camp's hub
function stalker_camp_builder.respawn_settler(hub_id, dead_id)
    local camp = stalker_camp_builder.active_camps[hub_id]
    local entry = camp and camp.respawning and camp.respawning[dead_id]
    if not entry then return end
    camp.respawning[dead_id] = nil
    local survivor = entry.survivor
    local hub_obj = alife_object(hub_id)
    local sim = alife()
    if not (hub_obj and sim and survivor) then return end
    local new_se = sim:create(entry.sec or "sim_default_stalker_0", hub_obj.position,
        hub_obj.m_level_vertex_id, hub_obj.m_game_vertex_id)
    if not new_se then return end
    local new_id = new_se.id
    survivor.job = survivor.job or "idle"
    camp.survivors[new_id] = survivor
    stalker_camp_builder.settler_lookup[new_id] = {
        hub_id = hub_id,
        camp = camp,
        survivor = survivor,
        is_rival = false,
    }
    -- the server object keeps the name and passes it to the NPC online; the
    -- community needs the NPC online, so game_object_on_net_spawn applies it
    if survivor.name then
        pcall(function() new_se:set_character_name(survivor.name) end)
    end
    survivor.pending_community = stalker_camp_builder.get_camp_dominant_faction
        and stalker_camp_builder.get_camp_dominant_faction(camp) or nil
    camp_send_tip(db.actor, string.format(game.translate_string("st_event_settler_recovered"), survivor.name or "unknown"), nil, "general_stalker", 10000)
end

function npc_on_death_callback(npc, who)
    if not npc then return end
    local npc_id = npc:id()
    -- a dead refugee doesn't move on: its entry would pass to whatever gets the id next
    if stalker_camp_builder.refugee_ids then
        stalker_camp_builder.refugee_ids[npc_id] = nil
    end
    for hub_id, camp in pairs(stalker_camp_builder.active_camps) do
        if camp.survivors and camp.survivors[npc_id] and camp.survivors[npc_id].released_id ~= npc_id then
            local survivor = camp.survivors[npc_id]
            local name = survivor.name or "unknown"
            local job  = survivor.job  or "unknown"

            if cfg.settler_invincible then
                local sec = npc:section()
                set_camp_settler_relations(hub_id, npc_id, false)
                camp.survivors[npc_id] = nil
                stalker_camp_builder.settler_lookup[npc_id] = nil
                -- held in the camp, which is saved, until the new settler exists: the time event is
                -- not, and verify_and_heal_settlers finishes the respawn after a load
                camp.respawning = camp.respawning or {}
                camp.respawning[npc_id] = { survivor = survivor, sec = sec }
                CreateTimeEvent("homestead_respawn_settler", tostring(npc_id), 0.5, function()
                    stalker_camp_builder.respawn_settler(hub_id, npc_id)
                    return true
                end)
            else
                if camp.active_raid and job == "guard" then
                    camp.active_raid.guards_lost = (camp.active_raid.guards_lost or 0) + 1
                end
                set_camp_settler_relations(hub_id, npc_id, false)
                camp.survivors[npc_id] = nil
                stalker_camp_builder.settler_lookup[npc_id] = nil
                actor_menu.set_msg(1, string.format(game.translate_string("st_event_settler_killed"), name), 5)
            end
            return
        end
    end
end

-- npc_on_hit_callback -- combat defense reaction and damage recovery for settlers
function npc_on_hit_callback(npc, amount, local_direction, who, bone_index)
    if not npc then return end
    if not npc:alive() then return end
    local npc_id = npc:id()
    local lookup = stalker_camp_builder.settler_lookup[npc_id]
    if not lookup or lookup.is_rival then return end

    -- Settler Defensive Readiness: when hit by hostile NPC or monster, drop rigid beh_wait standing lock
    if who and who:id() ~= npc_id and (IsStalker(who) or IsMonster(who)) then
        pcall(function()
            npc:disable_info_portion("npcx_beh_wait")
            npc:give_info_portion("npcx_beh_hide_in_cover")
        end)
    end

    if cfg.settler_invincible then
        pcall(function() npc:set_health_ex(1.0) end)
    end
end
-- safe_register_callback is defined at top of file

-- Crash helper: when the engine hits a fatal script error it calls this first.
-- Writes the offender and a traceback to the log so crashes can be traced.
function homestead_luabind_fatal_diag(offender)
    pcall(function()
        printf("[Homestead] LUABIND FATAL offender: %s", tostring(offender))
        if debug and debug.traceback then
            printf("[Homestead] LUABIND FATAL trace: %s", tostring(debug.traceback("diag", 2)))
        end
    end)
end

-- True when a camp holds the squad as its garrison, a reinforcement, or a heat-mutant.
local function camp_holds_squad(camp, id)
    if type(camp) ~= "table" then return false end
    if camp.squad_id == id or camp.heat_mutant_squad_id == id then return true end
    local extra = camp.extra_squad_ids
    if not extra then return false end
    for _, ex_id in ipairs(extra) do
        if ex_id == id then return true end
    end
    return false
end

-- AlifePlus ownership predicate: owned while Homestead tracks the squad in its own registries.
function stalker_camp_builder.is_held_squad(squad)
    if not squad then return false end
    local id = squad.id
    if not id then return false end

    local convoys = stalker_camp_builder.active_convoys
    if convoys and convoys[id] then return true end

    if squad.get_script_target == stalker_camp_builder.home_squad_target then return true end

    local camps = stalker_camp_builder.active_camps
    if not camps then return false end
    for _, camp in pairs(camps) do
        if camp_holds_squad(camp, id) then return true end
    end
    -- an outpost's garrison, reinforcements and heat pack are on its rival_camps entry
    for _, camp in pairs(stalker_camp_builder.rival_camps or {}) do
        if camp_holds_squad(camp, id) then return true end
    end
    return false
end

function on_game_start()
    local type_ = type

    -- AlifePlus integration: register Homestead so AlifePlus leaves its squads alone (no-op if absent).
    if ap_api and ap_api.register_owner then
        ap_api.register_owner("homestead", stalker_camp_builder.is_held_squad)
        printf("[Homestead] registered with AlifePlus ownership API")
    end

    -- make sure the split-out modules are loaded (they define scan_camp_structures, the camp inventory helpers, expeditions, ...)
    local _ = stalker_camp_builder_scan
    local _ = stalker_camp_builder_containers
    local _ = stalker_camp_builder_inventory
    local _ = stalker_camp_builder_expeditions
    local _ = stalker_camp_builder_events
    local _ = stalker_camp_builder_storage
    local _ = stalker_camp_builder_radio

    patch_alife_storage_manager()
    patch_item_artefact_binder_save()
    patch_watchdog_lag_protection()
    patch_detec_bone_hide_guard()
    patch_task_manager_guard()
    patch_actor_binder_guard()
    patch_meat_spoiling_fridges()
    -- v1.1.7: map_spot_menu_* callbacks are registered once at the end of
    pcall(function()
        local function get_weapon_repair_tier(sec)
            local sfind = string.find
            if not sec then return "A", 45, 25000 end
            local parent_sec = ini_sys and ini_sys:r_string_ex(sec, "parent_section") or sec
            local rep_type = ini_sys and ini_sys:r_string_ex(parent_sec, "repair_type") or ""
            local cost = ini_sys and ini_sys:r_u32(parent_sec, "cost") or 10000
            local ammo_class = ini_sys and ini_sys:r_string_ex(parent_sec, "ammo_class") or ""

            if sfind(ammo_class, "ammo_gauss", 1, true) or sfind(ammo_class, "ammo_pkm", 1, true) or sfind(ammo_class, "ammo_12.7") or sfind(ammo_class, "ammo_magnum", 1, true) or sfind(ammo_class, "338", 1, true) or sfind(sec, "gauss", 1, true) or sfind(sec, "pkm", 1, true) or sfind(sec, "pkp", 1, true) or sfind(sec, "rpg", 1, true) or cost >= 110000 then
                return "D", 260, 200000
            end

            if rep_type == "rifle_7" or sfind(ammo_class, "7.62x54") or sfind(ammo_class, "7.62x51") or sfind(ammo_class, "7.62x39") or sfind(ammo_class, "9x39", 1, true) or cost >= 50000 then
                return "C", 175, 135000
            end

            if rep_type == "shotgun" or rep_type == "rifle_5" or sfind(ammo_class, "5.45x39") or sfind(ammo_class, "5.56x45") or sfind(ammo_class, "12x70", 1, true) or sfind(ammo_class, "12x76", 1, true) or cost >= 22000 then
                return "B", 95, 70000
            end

            return "A", 45, 25000
        end

        function stalker_camp_builder.restore_wpo_weapon_parts(obj)
            if not (obj and IsWeapon and IsWeapon(obj)) then return end
            local obj_id = obj:id()
            local sec = ini_sys and ini_sys:r_string_ex(obj:section(), "parent_section") or obj:section()
            local ini_parts = itms_manager and itms_manager.ini_parts
            local parts_str = ini_parts and ini_parts:r_string_ex("con_parts_list", sec)
            local parts_list = parts_str and str_explode(parts_str, ",") or {}

            pcall(function() obj:set_condition(1.0) end)
            local se_obj = alife_object(obj_id)
            if se_obj then
                pcall(function() se_obj.condition = 1.0 end)
            end

            pcall(function()
                local c_wpn = obj:cast_Weapon()
                if c_wpn then
                    c_wpn:SetMisfire(false)
                    if c_wpn.SetCondition then c_wpn:SetCondition(1.0) end
                end
            end)

            local parts = {}
            for _, p_name in ipairs(parts_list) do
                parts[p_name] = 100
            end
            parts[sec] = 100
            for k in pairs(parts) do
                parts[k] = 100
            end

            se_save_var(obj_id, nil, "parts", parts)
            se_save_var(obj_id, obj:name(), "parts", parts)
            if item_parts and item_parts.set_parts_con then
                item_parts.set_parts_con(obj_id, parts)
            end

            if arti_jamming then
                if arti_jamming.set_jam_status then
                    arti_jamming.set_jam_status(obj_id, nil)
                end
                if arti_jamming.reset_cgd then
                    arti_jamming.reset_cgd()
                end
            end
        end

        -- G.A.M.M.A. prices repairs with inventory_upgrades_mp.how_much_repair, which addons wrap
        -- when they load; anything that isn't a weapon keeps that chain
        local orig_how_much_repair = (inventory_upgrades_mp and inventory_upgrades_mp.how_much_repair)
            or (inventory_upgrades and inventory_upgrades.how_much_repair)
        local function calc_wpo_repair_cost(item_name, item_condition)
            local mfloor = math.floor
            local mmax = math.max
            if ini_sys and ini_sys:section_exist(item_name) then
                local cls = ini_sys:r_string_ex(item_name, "class") or ""
                if string.find(cls, "WP_", 1, true) or string.find(cls, "W_", 1, true) then
                    local item_obj = nil
                    if ui_inventory and ui_inventory.GUI and ui_inventory.GUI.upgr and ui_inventory.GUI.upgr.id then
                        local cand = level.object_by_id(ui_inventory.GUI.upgr.id)
                        if cand and cand:section() == item_name then
                            item_obj = cand
                        end
                    end
                    if not item_obj and db.actor then
                        db.actor:iterate_inventory(function(actor, itm)
                            if itm and itm:section() == item_name and math.abs(itm:condition() - (item_condition or 1.0)) < 0.02 then
                                item_obj = itm
                                return true
                            end
                        end, db.actor)
                    end

                    local base_deficit = mmax(0, mfloor((1.0 - (item_condition or 1.0)) * 100))
                    local parts_deficit = 0
                    local sec = ini_sys:r_string_ex(item_name, "parent_section") or item_name
                    local ini_parts = itms_manager and itms_manager.ini_parts
                    local parts_str = ini_parts and ini_parts:r_string_ex("con_parts_list", sec)
                    local parts_list = parts_str and str_explode(parts_str, ",") or {}

                    local parts = nil
                    if item_obj then
                        local wpn_id = item_obj:id()
                        if item_parts and item_parts.get_parts_con then
                            parts = item_parts.get_parts_con(item_obj, wpn_id, false)
                        end
                        if type(parts) ~= "table" then
                            parts = se_load_var(wpn_id, item_obj:name(), "parts") or se_load_var(wpn_id, nil, "parts")
                        end
                    end
                    parts = (type(parts) == "table") and parts or {}

                    for _, p_name in ipairs(parts_list) do
                        local p_con = parts[p_name] or mfloor((item_condition or 1.0) * 100)
                        parts_deficit = parts_deficit + mmax(0, 100 - p_con)
                    end

                    local total_deficit = base_deficit + parts_deficit
                    if total_deficit <= 0 then
                        return 0
                    end

                    local tier_letter, tier_rate, tier_cap = get_weapon_repair_tier(sec)
                    local raw_cost = total_deficit * tier_rate
                    local renown_disc = (stalker_camp_builder.has_renown_perk and stalker_camp_builder.has_renown_perk("forge_master")) and 0.85 or 1.0
                    local total_cost = mfloor(math.min(tier_cap, mmax(150, raw_cost)) * renown_disc)

                    return total_cost
                end
            end
            if orig_how_much_repair then
                return orig_how_much_repair(item_name, item_condition)
            end
            local cost = ini_sys:r_u32(item_name, "cost") or 5000
            local cof = (game_difficulties and game_difficulties.get_eco_factor and game_difficulties.get_eco_factor("repair")) or 1.67
            return mfloor(cost * (1.0 - (item_condition or 1.0)) * cof)
        end

        if inventory_upgrades then
            inventory_upgrades.how_much_repair = calc_wpo_repair_cost
            if inventory_upgrades_mp then
                inventory_upgrades_mp.how_much_repair = calc_wpo_repair_cost
            end
        end

        function stalker_camp_builder.is_settler(npc_id)
            if not npc_id then return false end
            if type(npc_id) == "userdata" then
                npc_id = (type(npc_id.id) == "number") and npc_id.id or (npc_id.id and npc_id:id())
            end
            if not npc_id then return false end
            local sb = stalker_camp_builder
            local lookup = sb.settler_lookup and sb.settler_lookup[npc_id]
            if lookup then
                return not lookup.is_rival and not lookup.is_refugee
            end
            if sb.non_settler_cache and sb.non_settler_cache[npc_id] then
                return false
            end
            local camps = sb.active_camps
            if camps and next(camps) then
                for hub_id, camp in pairs(camps) do
                    if camp.survivors and (camp.survivors[npc_id] or camp.survivors[tostring(npc_id)]) then
                        return true
                    end
                end
            end
            if sb.non_settler_cache then
                sb.non_settler_cache[npc_id] = true
            end
            return false
        end

        local _cached_lvl_name = nil
        local _cached_lvl_tg = -1
        local function get_cached_level_name()
            local tg = time_global and time_global() or 0
            if not _cached_lvl_name or tg >= _cached_lvl_tg then
                _cached_lvl_name = level and level.name and level.name() or nil
                _cached_lvl_tg = tg + 2000
            end
            return _cached_lvl_name
        end

        -- max_dist: how near a hub counts (45 m when left out, as the emission cover asks)
        function stalker_camp_builder.is_pos_in_active_camp(pos, max_dist)
            local camps = stalker_camp_builder.active_camps
            if not pos or not camps or not next(camps) then return false end
            local cur_lvl = get_cached_level_name()
            local px, py, pz = pos.x, pos.y, pos.z
            for hub_id, camp in pairs(camps) do
                if camp and (not camp.level or camp.level == cur_lvl) then
                    local cpos = camp.pos
                    if not cpos then
                        local hub_obj = safe_alife_object(hub_id)
                        if hub_obj and hub_obj.position then
                            cpos = { x = hub_obj.position.x, y = hub_obj.position.y, z = hub_obj.position.z }
                            camp.pos = cpos
                        end
                    end
                    if cpos and cpos.x then
                        local radius = max_dist or camp.radius or 45
                        local dx = px - cpos.x
                        local dy = py - cpos.y
                        local dz = pz - cpos.z
                        if (dx * dx + dy * dy + dz * dz) <= (radius * radius) then
                            return true
                        end
                    end
                end
            end
            return false
        end

        local HOMESTEAD_ROOF_SECTIONS = {
            ["placeable_hs_roof_flat"]    = "roof",
            ["placeable_hs_roof_slope"]   = "roof",
            ["placeable_hs_roof_hip"]     = "roof",
            ["placeable_hs_roof_valley"]  = "roof",
            ["placeable_hs_roof_pyramid"] = "roof",
            ["placeable_hs_floor"]        = "floor",
        }
        local _roof_cover_cache = nil
        local _roof_cover_cache_tg = -1
        local _roof_cover_cache_lvl = nil

        function stalker_camp_builder.invalidate_roof_cover_cache()
            _roof_cover_cache_tg = -1
        end

        -- Ids of the roof and floor pieces: one pass over the server objects the first time
        -- they are needed, then kept current as pieces register and release
        local _roof_ids = nil

        local function find_roof_ids()
            local ids = {}
            local registry = _G.server_objects_registry
            if registry then
                for id, se_obj in pairs(registry) do
                    local sec = se_obj and se_obj.section_name and se_obj:section_name()
                    if sec and HOMESTEAD_ROOF_SECTIONS[sec] then ids[id] = true end
                end
            else
                local sim = alife()
                if sim then
                    for id = 1, 65534 do
                        local se_obj = sim:object(id)
                        local sec = se_obj and se_obj.section_name and se_obj:section_name()
                        if sec and HOMESTEAD_ROOF_SECTIONS[sec] then ids[id] = true end
                    end
                end
            end
            return ids
        end

        -- a server object registered (placed) or released: a roof or floor piece updates the list
        function stalker_camp_builder.note_roof_piece(se_obj, placed)
            local sec = se_obj and se_obj.section_name and se_obj:section_name()
            if not (sec and HOMESTEAD_ROOF_SECTIONS[sec]) then return end
            if _roof_ids then _roof_ids[se_obj.id] = placed or nil end
            _roof_cover_cache_tg = -1
        end

        local function rebuild_roof_cover_cache(cur_lvl, tg)
            local list = {}
            local count = 0
            local seen = {}
            local sim = alife()
            local gg = game_graph and game_graph()

            -- 1. Check all structures registered to active camps on this level
            local camps = stalker_camp_builder.active_camps
            if camps then
                for _, camp in pairs(camps) do
                    if camp and (not camp.level or camp.level == cur_lvl) and camp.structures then
                        for sid, _ in pairs(camp.structures) do
                            seen[sid] = true
                            local se_obj = safe_alife_object(sid)
                            local sec = se_obj and se_obj.section_name and se_obj:section_name()
                            local kind = sec and HOMESTEAD_ROOF_SECTIONS[sec]
                            if kind and se_obj.position then
                                count = count + 1
                                list[count] = {
                                    x = se_obj.position.x,
                                    y = se_obj.position.y,
                                    z = se_obj.position.z,
                                    is_floor = (kind == "floor"),
                                }
                            end
                        end
                    end
                end
            end

            -- 2. Also check any standalone placed Homestead roofs via hf_obj_manager / online db.storage
            if db and db.storage then
                for id, st in pairs(db.storage) do
                    if not seen[id] then
                        local obj = st and st.object
                        if obj and obj.section then
                            local ok_s, sec = pcall(obj.section, obj)
                            local kind = ok_s and sec and HOMESTEAD_ROOF_SECTIONS[sec]
                            if kind then
                                local ok_p, opos = pcall(obj.position, obj)
                                if ok_p and opos then
                                    seen[id] = true
                                    count = count + 1
                                    list[count] = {
                                        x = opos.x,
                                        y = opos.y,
                                        z = opos.z,
                                        is_floor = (kind == "floor"),
                                    }
                                end
                            end
                        end
                    end
                end
            end

            -- 3. Every other roof and floor piece on this level, standalone ones included
            if not _roof_ids then _roof_ids = find_roof_ids() end
            if sim and gg then
                for id in pairs(_roof_ids) do
                    if not seen[id] then
                        local se_obj = sim:object(id)
                        if not se_obj then
                            _roof_ids[id] = nil
                        else
                            local sec = se_obj.section_name and se_obj:section_name()
                            local kind = sec and HOMESTEAD_ROOF_SECTIONS[sec]
                            local gvid = se_obj.m_game_vertex_id
                            if kind and se_obj.position and gvid and gg:valid_vertex_id(gvid)
                                    and sim:level_name(gg:vertex(gvid):level_id()) == cur_lvl then
                                count = count + 1
                                list[count] = {
                                    x = se_obj.position.x,
                                    y = se_obj.position.y,
                                    z = se_obj.position.z,
                                    is_floor = (kind == "floor"),
                                }
                            end
                        end
                    end
                end
            end

            _roof_cover_cache = list
            _roof_cover_cache_lvl = cur_lvl
            _roof_cover_cache_tg = tg + 2500
            return list
        end

        -- Returns true when `pos` (player or NPC) is underneath a placed Homestead roof or upper-story floor tile.
        -- Tile footprint is 4.70895m x 4.70895m (half-tile = 2.3545m; 2.65m includes eaves/snap tolerance).
        function stalker_camp_builder.is_pos_under_homestead_roof(pos)
            if not pos then return false end
            local cur_lvl = get_cached_level_name()
            local tg = time_global and time_global() or 0
            local roofs = _roof_cover_cache
            if not roofs or _roof_cover_cache_lvl ~= cur_lvl or tg >= _roof_cover_cache_tg then
                roofs = rebuild_roof_cover_cache(cur_lvl, tg)
            end
            local n = roofs and #roofs or 0
            if n == 0 then return false end

            local px, py, pz = pos.x, pos.y, pos.z
            local mabs = math.abs
            for i = 1, n do
                local r = roofs[i]
                if mabs(px - r.x) <= 2.65 and mabs(pz - r.z) <= 2.65 then
                    local dy = r.y - py
                    if r.is_floor then
                        -- Upper-story floor acting as a ceiling above the character
                        if dy >= 1.2 and dy <= 9.5 then
                            return true
                        end
                    else
                        -- Roof piece overhead (or sloped roof placed directly on ground as a shelter)
                        if dy >= -0.35 and dy <= 9.5 then
                            return true
                        end
                    end
                end
            end
            return false
        end

        function stalker_camp_builder.is_settler_at_pos(pos)
            local lookup = stalker_camp_builder.settler_lookup
            if not pos or not lookup or not next(lookup) then return false end
            local px, py, pz = pos.x, pos.y, pos.z
            for id, data in pairs(lookup) do
                if data and not data.is_rival and not data.is_refugee then
                    local obj = level.object_by_id(id)
                    if obj and obj.position then
                        local opos = obj:position()
                        if opos then
                            local dx = px - opos.x
                            local dy = py - opos.y
                            local dz = pz - opos.z
                            if (dx * dx + dy * dy + dz * dz) < 16 then
                                return true
                            end
                        end
                    end
                end
            end
            return false
        end

        function stalker_camp_builder.is_rival_camp_object(id)
            if not id or not stalker_camp_builder.rival_camps then return false end
            for _, rcamp in pairs(stalker_camp_builder.rival_camps) do
                if type(rcamp) == "table" then
                    if rcamp.chest_id == id then return true end
                    if rcamp.decorations then
                        for _, did in ipairs(rcamp.decorations) do
                            if did == id then return true end
                        end
                    end
                end
            end
            return false
        end

        pcall(function()
            if xr_conditions and xr_conditions.actor_has_weapon then
                local orig_actor_has_weapon = xr_conditions.actor_has_weapon
                xr_conditions.actor_has_weapon = function(actor, npc)
                    if not npc then return false end
                    if not orig_actor_has_weapon(actor, npc) then
                        return false
                    end
                    local npc_id = (type_(npc.id) == "number") and npc.id or (npc.id and npc:id())
                    if npc_id and stalker_camp_builder.is_settler(npc_id) then
                        return false
                    end
                    if stalker_camp_builder.is_companion and stalker_camp_builder.is_companion(npc) then
                        return false
                    end
                    local sb = stalker_camp_builder
                    if sb and sb.is_pos_in_active_camp and sb.is_pos_in_active_camp(npc:position(), 60) then
                        return false
                    end
                    return true
                end
            end

            if xr_conditions and xr_conditions.is_squad_commander then
                local orig_is_squad_commander = xr_conditions.is_squad_commander
                xr_conditions.is_squad_commander = function(actor, npc)
                    if npc then
                        local npc_id = (type_(npc.id) == "number") and npc.id or (npc.id and npc:id())
                        if npc_id and stalker_camp_builder.is_settler(npc_id) then
                            return true
                        end
                    end
                    return orig_is_squad_commander(actor, npc)
                end
            end
        end)
    end)

    local function on_dotmarks_manual_interact_release(id, mark, flags)
        if not id then return end
        local obj = level.object_by_id(id)
        local sec = obj and obj:section()
        local is_wb = (mark and mark.hf_workshop) or sec == "placeable_workshop" or sec == "itm_workshop"
        -- a Settlement Flag hub has no workshop: its own use opens its storage
        local is_flag = sec and ini_sys:r_bool_ex(sec, "homestead_hub", false)
        if not is_wb and not is_flag and stalker_camp_builder.active_camps and stalker_camp_builder.active_camps[id] then
            is_wb = true
        end
        if is_wb then
            if ui_furniture_workshop and ui_furniture_workshop.start_dialog then
                ui_furniture_workshop.start_dialog(id)
                if flags then flags.ret_value = false end
            end
        end
    end

    safe_register_callback("dotmarks_on_manual_interact_release", on_dotmarks_manual_interact_release)
    safe_register_callback("save_state", save_state)
    safe_register_callback("load_state", load_state)
    safe_register_callback("actor_on_first_update", actor_on_first_update)
    safe_register_callback("actor_on_update", actor_on_update)
    safe_register_callback("npc_on_update", npc_on_update)
    safe_register_callback("npc_on_hit_callback", npc_on_hit_callback)
    safe_register_callback("npc_on_death_callback", npc_on_death_callback)
    -- DANZY EDIT: eating cooked food at a happy settlement grants the hospitality buff
    safe_register_callback("actor_on_item_use", function(obj)
        if stalker_camp_builder.check_hospitality_on_item_use then
            guarded_call("check_hospitality_on_item_use", stalker_camp_builder.check_hospitality_on_item_use, obj)
        end
    end)
    if RegisterScriptCallback then
        pcall(RegisterScriptCallback, "map_spot_menu_add_property", stalker_camp_builder.map_spot_menu_add_property)
        pcall(RegisterScriptCallback, "map_spot_menu_property_clicked", stalker_camp_builder.map_spot_menu_property_clicked)
        pcall(RegisterScriptCallback, "on_luabind_fatal_error", homestead_luabind_fatal_diag)
        pcall(RegisterScriptCallback, "on_try_respawn", function(smart, flags)
            if is_smart_respawn_blocked_in_camp(smart) then
                if flags then flags.disabled = true end
            end
        end)
    end
    local st_class = se_smart_terrain or (smart_terrain and smart_terrain.se_smart_terrain)
    if st_class and st_class.try_respawn then
        local orig_smart_try_respawn = st_class.try_respawn
        st_class.try_respawn = function(self)
            if is_smart_respawn_blocked_in_camp(self) then
                return
            end
            return orig_smart_try_respawn(self)
        end
    end
    safe_register_callback("actor_on_net_destroy", function()
        homestead_is_disconnecting = true
        stalker_camp_builder.homestead_is_disconnecting = true
        homestead_teardown_grace_until = (time_global and time_global() or 0) + 600000
        stalker_camp_builder.homestead_teardown_grace_until = (time_global and time_global() or 0) + 600000
    end)

    safe_register_callback("hf_on_furniture_place", hf_on_furniture_place)
    safe_register_callback("hf_on_before_furniture_release", hf_on_before_furniture_release)
    safe_register_callback("server_entity_on_unregister", server_entity_on_unregister)
    -- the modded exes add this callback; elsewhere safe_register_callback registers nothing
    safe_register_callback("server_object_on_unregister", server_object_on_unregister)
    safe_register_callback("server_object_on_register", function(se_obj)
        if stalker_camp_builder.note_roof_piece then
            stalker_camp_builder.note_roof_piece(se_obj, true)
        end
    end)
    init_hf_pickup_hook()
    -- outpost pieces stay: Take All on an empty stash box (Hideout Furniture's remove_stash) and
    -- DotMarks' Pick up release the box, which ends the outpost, and hand out a Blue Box for its chest
    safe_register_callback("actor_on_stash_remove", function(data)
        local is_outpost_piece = stalker_camp_builder.is_rival_camp_object
        if data and data.stash_id and is_outpost_piece and is_outpost_piece(data.stash_id) then
            data.cancel = true
        end
    end)

    safe_register_callback("game_object_on_net_spawn", function(obj)
        local pairs_ = pairs
        if not (obj and IsStalker and IsStalker(obj)) then return end
        local id = obj:id()

        local m_data = alife_storage_manager and alife_storage_manager.get_state and alife_storage_manager.get_state()
        if m_data and m_data.stalker_camp_builder_freed_settlers and m_data.stalker_camp_builder_freed_settlers[id] then
            m_data.stalker_camp_builder_freed_settlers[id] = nil
            -- This runs after the binder has loaded the NPC's saved logic and before its net_spawn
            -- applies it (CGameObject::net_Spawn). Drop a settler or companion beh scheme saved while
            -- they belonged to the camp, so they start on their own logic.
            local st = db.storage[id]
            local saved_ltx = st and st.loaded_ini_filename
            if saved_ltx == "scripts\\beh_settler.ltx" or saved_ltx == "scripts\\beh_companion.ltx" then
                st.loaded_ini_filename = nil
                st.loaded_section_logic = nil
                st.loaded_active_section = nil
                st.loaded_gulag_name = ""
            end
            if stalker_camp_builder.restore_settler_logic then
                pcall(stalker_camp_builder.restore_settler_logic, obj)
            end
            if xr_motivator and xr_motivator.script_release then
                pcall(xr_motivator.script_release, obj)
            end
            pcall(function()
                obj:disable_info_portion("npcx_beh_wait")
                obj:disable_info_portion("npcx_beh_cannot_dismiss")
                obj:disable_info_portion("homestead_settler_guard")
                obj:disable_info_portion("homestead_settler_patrol")
                obj:disable_info_portion("npcx_is_companion")
                obj:set_movement_type(move.stand)
                obj:set_body_state(move.standing)
                obj:set_mental_state(anim.free)
                if state_mgr and state_mgr.set_state then
                    state_mgr.set_state(obj, "idle", nil, nil, nil, { fast_set = true })
                end
            end)
        end
        for hub_id, camp in pairs_(stalker_camp_builder.active_camps) do
            if camp.survivors and camp.survivors[id] and camp.survivors[id].released_id ~= id then
                stalker_camp_builder.settler_lookup[id] = {
                    hub_id = hub_id,
                    camp = camp,
                    survivor = camp.survivors[id],
                }

                for other_id, other in pairs_(camp.survivors) do
                    if other_id ~= id and other.released_id ~= other_id then
                        local other_obj = level.object_by_id(other_id)
                        if other_obj then
                            obj:force_set_goodwill(1000, other_obj)
                            other_obj:force_set_goodwill(1000, obj)
                        end
                    end
                end

                local survivor = camp.survivors[id]
                local job = survivor.job or "idle"
                -- a settler re-created at the hub takes back its community (restore_missing_settler,
                -- the invincible respawn); the method takes the squad and group too
                if survivor.pending_community then
                    pcall(function() obj:set_character_community(survivor.pending_community, 0, 0) end)
                    survivor.pending_community = nil
                end
                if stalker_camp_builder.prosper_apply_standing then stalker_camp_builder.prosper_apply_standing(obj, survivor) end
                break
            end
        end
        if not stalker_camp_builder.settler_lookup[id] then
            local squad = get_object_squad(obj)
            if squad then
                for key, rcamp in pairs_(stalker_camp_builder.rival_camps) do
                    if type_(rcamp) == "table" then
                        local is_in_squad = (rcamp.squad_id == squad.id)
                        if not is_in_squad and rcamp.extra_squad_ids then
                            for _, ex_id in ipairs(rcamp.extra_squad_ids) do
                                if ex_id == squad.id then
                                    is_in_squad = true
                                    break
                                end
                            end
                        end
                        if is_in_squad then
                            stalker_camp_builder.settler_lookup[id] = {
                                hub_id = nil,
                                camp = nil,
                                survivor = nil,
                                is_rival = true,
                                rival_camp = rcamp,
                            }
                            break
                        end
                    end
                end
            end
        end
    end)

    -- DANZY EDIT: apply scavenged/crafted item condition once the item is online, inspected, or taken
    safe_register_callback("actor_on_item_take", function(obj)
        stalker_camp_builder.apply_pending_cond(obj)
    end)
    safe_register_callback("actor_on_item_put_in_box", function(box, obj)
        if box and stalker_camp_builder.on_actor_box_change then
            stalker_camp_builder.on_actor_box_change(box:id(), obj, true)
        end
    end)
    safe_register_callback("actor_on_item_take_from_box", function(box, obj)
        stalker_camp_builder.apply_pending_cond(obj)
        if box and stalker_camp_builder.on_actor_box_change then
            stalker_camp_builder.on_actor_box_change(box:id(), obj, false)
        end
    end)
    safe_register_callback("ActorMenu_on_mode_changed", function(mode, last_mode)
        stalker_camp_builder.pending_cond_tick()
    end)
    safe_register_callback("ActorMenu_on_item_focus_receive", function(obj)
        stalker_camp_builder.apply_pending_cond(obj)
    end)

    safe_register_callback("game_object_on_net_destroy", function(obj)
        pcall(function()
            if not (obj and IsStalker and IsStalker(obj)) then return end
            local id = obj:id()
            if stalker_camp_builder.settler_lookup then
                stalker_camp_builder.settler_lookup[id] = nil
            end
            if stalker_camp_builder.camp_npc_released then
                stalker_camp_builder.camp_npc_released[id] = nil  -- re-release when it comes back online
            end
            if stalker_camp_builder.settler_home_squad_cache then
                stalker_camp_builder.settler_home_squad_cache[id] = nil
            end
            if stalker_camp_builder.camp_npc_furniture_cache then
                stalker_camp_builder.camp_npc_furniture_cache[id] = nil
                for key in pairs(stalker_camp_builder.camp_npc_furniture_cache) do
                    if type_(key) == "string" and key:find("^" .. id .. "_") then
                        stalker_camp_builder.camp_npc_furniture_cache[key] = nil
                    end
                end
            end
        end)
    end)

    -- on_level_changing, not on_before_level_changing: the area-transition prompt sends that
    -- before a same-level teleport too, and nothing would clear the flags until the next load
    safe_register_callback("on_level_changing", function()
        pcall(function()
            homestead_is_disconnecting = true
            stalker_camp_builder.homestead_is_disconnecting = true
            homestead_teardown_grace_until = (time_global and time_global() or 0) + 600000
            stalker_camp_builder.homestead_teardown_grace_until = (time_global and time_global() or 0) + 600000

            local current_level = level and level.name and level.name()
            if not current_level then return end

            local pairs_ = pairs
            local sformat = string.format
            for hub_id, camp in pairs_(stalker_camp_builder.active_camps) do
                if camp.level and camp.level == current_level then
                    local warnings = {}
                    if camp.happiness and camp.happiness < 20 then
                        warnings[#warnings+1] = "low morale"
                    end
                    if camp.active_raid then
                        warnings[#warnings+1] = "under raid"
                    end
                    if #warnings > 0 and db.actor then
                        camp_send_tip(db.actor, sformat(game.translate_string("st_event_camp_warning"), camp.name or "Camp", table.concat(warnings, " and ")), nil, "red_danger", 10000, camp.hub_id, "combat", true)
                    end
                end
            end
        end)
    end)

    if hf_obj_manager and hf_obj_manager.get_data then
        local original_get_data = hf_obj_manager.get_data
        hf_obj_manager.get_data = function(id)
            local data = original_get_data(id)
            if not data then
                return { is_on = false, condition = 1, is_world_obj = false }
            end
            return data
        end
    end

    if utils_ui and utils_ui.UICellContainer and utils_ui.UICellContainer.game_object_on_net_destroy then
        local orig_destroy = utils_ui.UICellContainer.game_object_on_net_destroy
        utils_ui.UICellContainer.game_object_on_net_destroy = function(self, obj)
            pcall(orig_destroy, self, obj)
        end
    end

    safe_register_callback("on_option_change", stalker_camp_builder.invalidate_mcm_cache)
end

-- get_camp_morale -- compute dynamic 0-100% morale based on living conditions
function stalker_camp_builder.get_camp_morale(camp, hub_obj)
    local pairs_ = pairs
    if not camp then return 50 end
    local morale = 40 -- base baseline

    local has_water = false
    for id, stype in pairs_(camp.structures or {}) do
        -- by type, as get_camp_stats counts water: barrels, sinks and bidons don't name a pump
        if stype == "water_pump" and alife_object(id) then
            has_water = true; break
        end
    end
    if has_water then morale = morale + 15 end

    local guard_count = 0
    for _, surv in pairs_(camp.survivors or {}) do
        if surv.job == "guard" then guard_count = guard_count + 1 end
    end
    if guard_count > 0 then morale = morale + 15 end

    local has_radio = false
    for id, stype in pairs_(camp.structures or {}) do
        -- by type, as get_camp_stats counts radios: the guitar doesn't name a radio
        if stype == "radio" and alife_object(id) then
            has_radio = true; break
        end
    end
    if has_radio then morale = morale + 15 end

    if camp.has_drugkit then morale = morale + 10 end
    if (camp.toolkits and (camp.toolkits[1] or camp.toolkits[2] or camp.toolkits[3])) or ((camp.tech_toolkit_tier or 0) > 0) then
        morale = morale + 10
    end

    camp.morale = math.min(100, math.max(10, morale))
    return camp.morale
end

-- SETTLEMENT HOSPITALITY FEAST BUFF & POWER GRID (v1.1.2)
-- DANZY EDIT: the buff used to only set a timer nothing read. While active it now
-- slowly restores health and stamina (same rate as friendly rival camps).
function stalker_camp_builder.apply_hospitality_buff(hours)
    local actor = db.actor
    if not actor then return end
    local sb = stalker_camp_builder
    local current_sec = game_sec()
    local was_active = current_sec < (sb.hospitality_buff_end_sec or 0)
    sb.hospitality_buff_end_sec = math.max(sb.hospitality_buff_end_sec or 0, current_sec + ((hours or 4) * 3600))
    if was_active then return end  -- already fed/rested: just extend it quietly

    local snd = sound_object([[interface\inv_drink_flask]])
    if snd then snd:play(actor, 0, sound_object.s2d) end
    news_manager.send_tip(actor, game.translate_string("st_buff_hospitality_applied"), nil, "general_stalker", 7000)
end

function stalker_camp_builder.tick_hospitality_buff(actor)
    local sb = stalker_camp_builder
    if not (actor and actor:alive()) then return end
    local current_sec = game_sec()
    if current_sec >= (sb.hospitality_buff_end_sec or 0) then return end
    if actor.health < 1.0 then actor.health = math.min(1.0, actor.health + 0.005) end
    if actor.power < 1.0 then actor.power = math.min(1.0, actor.power + 0.05) end
end

function stalker_camp_builder.check_hospitality_on_item_use(item)
    if not item then return end
    local actor = db.actor
    if not actor then return end

    local sec = item:section():lower()
    if sec:find("meat_") or sec:find("cooked") or sec:find("tushonka") or sec:find("conserva") then
        local hub_id, camp = stalker_camp_builder.get_active_camp_near(actor:position())
        if camp and hub_id then
            local morale = stalker_camp_builder.get_camp_morale(camp, alife_object(hub_id))
            if morale >= 50 then
                stalker_camp_builder.apply_hospitality_buff(4)
            end
        end
    end
end

function stalker_camp_builder.check_hospitality_on_sleep(hours)
    local actor = db.actor
    if not actor then return end
    local hub_id, camp = stalker_camp_builder.get_active_camp_near(actor:position())
    if camp and hub_id then
        local morale = stalker_camp_builder.get_camp_morale(camp, alife_object(hub_id))
        if morale >= 60 then
            stalker_camp_builder.apply_hospitality_buff(hours or 6)
        end
    end
end

