-- category is the news icon; radio_category is the radio feed's filter for the report:
-- "work" (the default), "expedition", "combat" or "general". Verbose Notifications off
-- holds back a routine report's toast; an alert (always) shows either way.
function camp_send_tip(actor, text, snd_type, category, duration, hub_id, radio_category, always)
    if always or cfg.verbose_notifications ~= false then
        pcall(news_manager.send_tip, actor, text, snd_type, category, duration)
    end
    add_camp_log_entry(text, "info")
    if radio_category ~= false and stalker_camp_builder.add_camp_radio_log then
        stalker_camp_builder.add_camp_radio_log(hub_id, radio_category or "work", text)
    end
end

function play_job_complete_sound()
end

function get_time_of_day_mult(job)
    -- the hour of the game clock (CTime has no getH)
    local hour = (level and level.get_time_hours and level.get_time_hours()) or 12
    local is_night = (hour >= 22 or hour < 5)
    if not is_night then return 1.0 end
    if job == "scavenge" then return 1.2 end
    if job == "cook" then return 0.8 end
    if job == "medic" then return 1.2 end
    return 1.0
end


